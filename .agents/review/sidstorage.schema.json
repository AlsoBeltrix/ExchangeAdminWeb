{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "capability_ok", "reviewed_sha", "base_sha", "findings"],
  "properties": {
    "verdict": { "type": "string", "enum": ["clean", "findings"] },
    "capability_ok": { "type": "boolean" },
    "reviewed_sha": { "type": "string" },
    "base_sha": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "evidence", "predicted_failure", "severity"],
        "properties": {
          "title": { "type": "string" },
          "evidence": { "type": "string" },
          "predicted_failure": { "type": "string" },
          "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] }
        }
      }
    }
  }
}

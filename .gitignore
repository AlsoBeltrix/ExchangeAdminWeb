# Claude Code & Agents
.claude/settings.local.json
.antigravitycli/
.playwright-mcp/
# Reviewer-harness incantations + tier pins: machine-specific (CLI paths, versions,
# model routes), self-authored by the codereview playbook, never hand-maintained.
.agents/review/*.local.json
# Scratch dispatch artifacts for a single review run: the prompt sent, the JSON schema
# pinned, and the raw verdict. The durable record is the finding doc plus the index row,
# which quote whatever mattered; keeping the scratch would be a second copy that drifts.
# Ignored rather than merely deleted because leaving them untracked blocks a prod deploy -
# deploy-pipeline.ps1 refuses a dirty tree, and it is right to.
.agents/review/*.prompt.txt
.agents/review/*.schema.json
.agents/review/*.result.json

# Local/private cleanup archive
_not_for_github/

# Screenshots
*.PNG
*.png
!docs/images/*.png
!docs/images/*.PNG
# App icons are shipped assets, not screenshots. wwwroot/favicon.png predates this rule and is
# tracked; apple-touch-icon.png is its 180px sibling and must ship the same way.
!wwwroot/*.png

docs/ArchitectureDesignReview*
docs/CodeReview-*.md
docs/NOTIFICATIONS_SECURITY.md
docs/SectionPermissions-Plan.md
examplescripts/

# GM-3 discovery output — contains live directory SIDs/usernames, never commit
GroupMembershipDelegation-*.csv
.tokensave/
 
 .serena/
.claude/.headroom_wrap_marker.json
.serena/**

# Coverage/test output (written by dotnet test --collect)
TestResults/
testResults.xml
# Captured `dotnet test` console output. TestResults/ above only covers the collector's own
# directory, so a redirected run log at the repo root was showing up as untracked.
TestResults-*.txt

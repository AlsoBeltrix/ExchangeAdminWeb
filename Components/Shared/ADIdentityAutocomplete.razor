@implements IDisposable
@inject ExchangeAdminWeb.Services.ADDirectorySearchService ADSearch

<div class="position-relative">
    <input type="text"
           class="form-control"
           value="@Value"
           @oninput="OnInput"
           @onfocus="OnFocus"
           @onblur="OnBlur"
           @onkeydown="OnKeyDown"
           placeholder="@Placeholder"
           disabled="@Disabled"
           autocomplete="off" />

    @if (_showDropdown && _results.Count > 0)
    {
        @* min-width 100% rather than w-100: the dropdown may be WIDER than its input, which
           matters in narrow admin panes where the input is a few characters across. max-width
           keeps it inside the viewport. *@
        <ul class="list-group position-absolute shadow-sm"
            style="z-index: 1050; max-height: 300px; overflow-y: auto; top: 100%; min-width: 100%; max-width: min(46rem, 90vw); width: max-content;">
            @for (int i = 0; i < _results.Count; i++)
            {
                var result = _results[i];
                var index = i;
                <li class="list-group-item list-group-item-action py-1 px-2 @(index == _highlightedIndex ? "active" : "")"
                    style="cursor: pointer; font-size: 0.9rem;"
                    title="@RowTitle(result)"
                    @onmousedown="() => SelectResult(result)"
                    @onmousedown:preventDefault>
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div class="flex-grow-1" style="min-width: 0;">
                            @* The identity WRAPS instead of truncating. This is the whole fix: the
                               row used to be one text-truncate box holding domain + name +
                               secondary text, end-truncated at a fixed width. Families sharing a
                               prefix - ExchangeWebAdmins, ExchangeWebPerms - therefore died at the
                               same character and rendered identically, and the picker writes a SID
                               that grants module access, so the operator could not tell which row
                               they were about to authorize. *@
                            <div style="overflow-wrap: anywhere;">
                                @if (!string.IsNullOrEmpty(result.NetBiosDomain))
                                {
                                    @* A forest-wide search returns several domains, so a bare group
                                       name does not identify which one grants access. *@
                                    <span class="text-muted">@result.NetBiosDomain\</span>
                                }
                                <span class="fw-semibold">@result.DisplayName</span>
                            </div>
                            @* Secondary text is now the part that truncates: losing a UPN is
                               recoverable, losing the identity is not. *@
                            @if (!string.IsNullOrWhiteSpace(GetSecondaryText(result)))
                            {
                                <div class="text-muted text-truncate" style="font-size: 0.8rem;">
                                    @GetSecondaryText(result)
                                </div>
                            }
                        </div>
                        @* Only when the results can actually differ. A picker restricted to one
                           kind renders the same word on every row, spending width that the names
                           need on a field carrying no information. *@
                        @if (ShowTypeBadge)
                        {
                            <span class="badge @BadgeClass(result.ObjectType) flex-shrink-0"
                                  style="font-size: 0.7rem;">
                                @result.ObjectType
                            </span>
                        }
                    </div>
                </li>
            }
        </ul>
    }

    @if (_isSearching)
    {
        <div class="position-absolute" style="right: 0.5rem; top: 0.5rem;">
            <span class="spinner-border spinner-border-sm text-muted"></span>
        </div>
    }
</div>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string ObjectKind { get; set; } = "Any";
    [Parameter] public string ReturnValueKind { get; set; } = "SAM";
    [Parameter] public string Placeholder { get; set; } = "";
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Raised with the whole selected object, for callers that need more than the return value -
    /// e.g. a SID to store plus a name to show. Not raised on typed input, which resolves to no
    /// directory object.
    /// </summary>
    [Parameter] public EventCallback<ExchangeAdminWeb.Services.ADSearchResult> OnResultSelected { get; set; }

    private List<ExchangeAdminWeb.Services.ADSearchResult> _results = [];
    private bool _showDropdown;
    private bool _isSearching;
    private int _highlightedIndex = -1;
    private System.Threading.Timer? _debounceTimer;
    private string _lastSearchTerm = "";

    private async Task OnInput(ChangeEventArgs e)
    {
        var newValue = e.Value?.ToString() ?? "";
        Value = newValue;
        await ValueChanged.InvokeAsync(newValue);

        _highlightedIndex = -1;

        // Debounce the search
        _debounceTimer?.Dispose();

        if (!ADSearch.IsAvailable || newValue.Trim().Length < 3)
        {
            _results = [];
            _showDropdown = false;
            StateHasChanged();
            return;
        }

        _debounceTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(() => PerformSearch(newValue.Trim()));
        }, null, 300, Timeout.Infinite);
    }

    private async Task PerformSearch(string term)
    {
        if (term == _lastSearchTerm && _results.Count > 0)
            return;

        _lastSearchTerm = term;
        _isSearching = true;
        StateHasChanged();

        try
        {
            _results = await Task.Run(() => ADSearch.Search(term, ObjectKind));
            _showDropdown = _results.Count > 0;
        }
        catch
        {
            _results = [];
            _showDropdown = false;
        }
        finally
        {
            _isSearching = false;
            StateHasChanged();
        }
    }

    private async Task SelectResult(ExchangeAdminWeb.Services.ADSearchResult result)
    {
        var selectedValue = GetReturnValue(result);
        Value = selectedValue;
        _showDropdown = false;
        _results = [];
        _highlightedIndex = -1;
        await ValueChanged.InvokeAsync(selectedValue);
        if (OnResultSelected.HasDelegate)
            await OnResultSelected.InvokeAsync(result);
    }

    private string GetReturnValue(ExchangeAdminWeb.Services.ADSearchResult result)
    {
        return ReturnValueKind switch
        {
            "UPN" => result.UserPrincipalName ?? result.DisplayName,
            "SAM" => result.SamAccountName ?? result.DisplayName,
            "DN" => result.DistinguishedName,
            "DisplayName" => result.DisplayName,
            // No name fallback. Every other kind degrades to a display name when its attribute is
            // missing, which is right for a hint but wrong for an identity: a caller that asked
            // for a SID and silently got a name would store an ambiguous value in an
            // authorization field. Empty is refused by the caller; a wrong-shaped value is not.
            "SID" => result.ObjectSid ?? string.Empty,
            _ => result.SamAccountName ?? result.DisplayName
        };
    }

    private static string BadgeClass(string objectType) => objectType switch
    {
        "User" => "bg-primary",
        "OU" => "bg-info text-dark",
        _ => "bg-secondary"
    };

    /// <summary>
    /// Whether the object-type badge carries information for this picker.
    /// </summary>
    /// <remarks>
    /// Only an unrestricted ("Any") search can return mixed types. A picker filtered to one kind
    /// renders the identical word on every row, and that width belongs to the names - which is
    /// what the reported defect was about.
    /// </remarks>
    private bool ShowTypeBadge => ShouldShowTypeBadge(ObjectKind);

    internal static bool ShouldShowTypeBadge(string? objectKind) =>
        string.IsNullOrWhiteSpace(objectKind) ||
        string.Equals(objectKind, "Any", StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// The hover text for a row: everything about the entry, unabbreviated.
    /// </summary>
    /// <remarks>
    /// The safety net. The identity itself wraps rather than truncating, but the secondary line
    /// still truncates and an OU's DN can be very long, so hovering must always be able to
    /// disclose the full value.
    /// </remarks>
    private string RowTitle(ExchangeAdminWeb.Services.ADSearchResult result) =>
        BuildRowTitle(result.NetBiosDomain, result.DisplayName, GetSecondaryText(result));

    internal static string BuildRowTitle(string? netBiosDomain, string? displayName, string? secondary)
    {
        var qualified = string.IsNullOrEmpty(netBiosDomain)
            ? displayName ?? ""
            : $"{netBiosDomain}\\{displayName}";

        return string.IsNullOrWhiteSpace(secondary) || string.Equals(secondary, qualified, StringComparison.Ordinal)
            ? qualified
            : $"{qualified}\n{secondary}";
    }

    private string GetSecondaryText(ExchangeAdminWeb.Services.ADSearchResult result)
    {
        if (result.ObjectType == "User")
        {
            if (!string.IsNullOrEmpty(result.UserPrincipalName))
                return result.UserPrincipalName;
            if (!string.IsNullOrEmpty(result.SamAccountName))
                return result.SamAccountName;
        }
        else if (result.ObjectType == "OU")
        {
            // The DN IS the useful detail for an OU - two OUs can share a name at different
            // points in the tree, and the DN is what gets stored and matched.
            return result.DistinguishedName;
        }
        else
        {
            if (!string.IsNullOrEmpty(result.SamAccountName))
                return result.SamAccountName;
            if (!string.IsNullOrEmpty(result.Email))
                return result.Email;
        }

        return result.DistinguishedName;
    }

    private void OnFocus()
    {
        if (_results.Count > 0)
            _showDropdown = true;
    }

    private void OnBlur()
    {
        // Delay hiding to allow click events on dropdown items to fire
        _ = Task.Delay(200).ContinueWith(_ =>
        {
            if (_disposed) return;
            InvokeAsync(() =>
            {
                if (_disposed) return;
                _showDropdown = false;
                StateHasChanged();
            });
        });
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (!_showDropdown || _results.Count == 0)
            return;

        switch (e.Key)
        {
            case "ArrowDown":
                _highlightedIndex = (_highlightedIndex + 1) % _results.Count;
                break;
            case "ArrowUp":
                _highlightedIndex = _highlightedIndex <= 0 ? _results.Count - 1 : _highlightedIndex - 1;
                break;
            case "Enter":
                if (_highlightedIndex >= 0 && _highlightedIndex < _results.Count)
                    await SelectResult(_results[_highlightedIndex]);
                break;
            case "Escape":
                _showDropdown = false;
                _highlightedIndex = -1;
                break;
        }
    }

    private bool _disposed;

    public void Dispose()
    {
        _disposed = true;
        _debounceTimer?.Dispose();
    }
}

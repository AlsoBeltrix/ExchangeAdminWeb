@using ExchangeAdminWeb.Services.Jobs
@using ExchangeAdminWeb.Services.Progress
@implements IDisposable
@inject IActivityProgress Progress
@inject BulkJobService BulkJobs
@inject AuthenticationStateProvider AuthStateProvider

@*
    The app's status frame. Always present along the bottom of the window, reading "Idle" when
    nothing is running and a live status readout when something is (owner, 2026-10-01:
    "bottom status frame. shows progress bar with status or idle when nothing is running").

    Always-visible is the owner's call and it is the point: a frame that only appears when
    something happens is a frame the operator has not learned to read. One that is always there,
    saying Idle, is one they already know where to look at.

    It renders a STATUS READOUT, not a timer. Every line says what is happening in words, and
    carries a count whenever the module supplied one. An indeterminate activity says so rather
    than animating a number it invented.

    Lives in Components/Shared and is rendered by MainLayout, so it sits outside
    Components/Pages and cannot shift any of ClickGateRegistry's line keys.

    #gp-nav-slot is deliberately empty here and is owned by wwwroot/nav-progress.js. During a
    page navigation the server is busy producing the next page, so this component cannot render
    anything - the only thing that can report a navigation in progress is JS already running in
    the browser. It writes into that slot. Blazor's enhanced-navigation DOM patch clears the
    injected node when the new page lands, which is exactly when it should go.
*@

@* The expanded list renders BEFORE the frame so it opens upward, into the page, rather than
   off the bottom of the window. *@
@if (expanded && Lines.Count > 1)
{
    <div class="gp-list">
        @foreach (var line in Lines)
        {
            <div class="gp-list-row">
                <span class="gp-list-module">@line.ModuleId</span>
                <span class="gp-list-label">@line.Label</span>
                <div class="gp-bar gp-bar-sm">
                    @if (line.Percent is int linePercent)
                    {
                        <div class="gp-bar-fill" style="width:@(linePercent)%"></div>
                    }
                    else
                    {
                        <div class="gp-bar-fill gp-bar-indeterminate"></div>
                    }
                </div>
                <span class="gp-status">@line.Status</span>
                @if (line.Background)
                {
                    <span class="gp-safe">background - safe to leave</span>
                }
            </div>
        }
    </div>
}

<div id="gp-frame" class="gp-frame @(IsBusy ? "gp-frame-busy" : "gp-frame-idle")"
     role="status" aria-live="polite">

    <div id="gp-nav-slot" class="gp-nav-slot"></div>

    @if (Primary is null)
    {
        <span class="gp-dot gp-dot-idle" aria-hidden="true"></span>
        <span class="gp-idle">Idle</span>
    }
    else
    {
        <span class="spinner-border spinner-border-sm gp-spin" aria-hidden="true"></span>
        <span class="gp-label">@Primary.Label</span>
        <div class="gp-bar" title="@Primary.Status">
            @if (Primary.Percent is int percent)
            {
                <div class="gp-bar-fill" style="width:@(percent)%"></div>
            }
            else
            {
                <div class="gp-bar-fill gp-bar-indeterminate"></div>
            }
        </div>
        <span class="gp-status">@Primary.Status</span>

        @if (OtherCount > 0)
        {
            <button type="button" class="gp-more" @onclick="ToggleExpanded">
                @(expanded ? "hide" : $"+{OtherCount} more")
            </button>
        }
    }

    @if (LatestOutcome is not null)
    {
        <span class="gp-outcome @(LatestOutcome.Success ? "gp-ok" : "gp-bad")">
            @LatestOutcome.Text
        </span>
        <button type="button" class="gp-dismiss" title="Dismiss" @onclick="DismissLatest">x</button>
    }
</div>

@code {
    /// <summary>One readable row in the frame, from either source.</summary>
    private sealed record Line(string ModuleId, string Label, string Status, int? Percent, bool Background);

    private sealed record Outcome(string Id, string Text, bool Success, bool FromJob);

    private readonly DateTime arrivedUtc = DateTime.UtcNow;

    private string currentUser = "";
    private bool expanded;
    private bool disposed;
    private bool subscribed;
    private readonly HashSet<string> dismissedJobs = new(StringComparer.Ordinal);

    private IReadOnlyList<Activity> activities = Array.Empty<Activity>();
    private IReadOnlyList<ActivityOutcome> outcomes = Array.Empty<ActivityOutcome>();
    private IReadOnlyList<BulkJob> activeJobs = Array.Empty<BulkJob>();
    private IReadOnlyList<BulkJob> recentJobs = Array.Empty<BulkJob>();

    private List<Line> Lines
    {
        get
        {
            var lines = activities
                .Select(a => new Line(a.ModuleId, a.Label, ActivityStatus(a), a.PercentComplete, false))
                .ToList();

            lines.AddRange(activeJobs.Select(j =>
                new Line(j.ModuleId, JobLabel(j), JobStatus(j), JobPercent(j), true)));

            return lines;
        }
    }

    private Line? Primary => Lines.FirstOrDefault();

    private int OtherCount => Math.Max(0, Lines.Count - 1);

    private bool IsBusy => Lines.Count > 0;

    private Outcome? LatestOutcome
    {
        get
        {
            var fromActivity = outcomes.FirstOrDefault();
            if (fromActivity is not null)
            {
                var verb = fromActivity.Success ? "finished" : "failed";
                var text = string.IsNullOrWhiteSpace(fromActivity.Message)
                    ? $"{fromActivity.Label} {verb}"
                    : $"{fromActivity.Label} {verb} - {fromActivity.Message}";
                return new Outcome(fromActivity.Id, text, fromActivity.Success, false);
            }

            var job = FinishedSinceArrival().FirstOrDefault();
            return job is null
                ? null
                : new Outcome(job.Id, $"{JobLabel(job)} {JobEndedText(job)}", JobSucceeded(job), true);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // SubmittedBy is written from user.Identity.Name verbatim at enqueue time by the three
        // enqueueing pages, so the scoped query matches on that same unnormalised value.
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUser = authState.User.Identity?.Name ?? "";

        // Dispose can run DURING the await above, on a circuit that went away while
        // authentication was still resolving. It would find subscribed == false, unsubscribe
        // nothing, and return - and then this continuation would subscribe a dead component to
        // a SINGLETON event, where it stays reachable for the life of the process. Checking
        // here is the only place that closes it, because Dispose has already been and gone.
        if (disposed)
            return;

        Progress.Changed += OnProgressChanged;
        BulkJobs.JobChanged += OnJobChanged;
        subscribed = true;

        Reload();
    }

    private void Reload()
    {
        activities = Progress.Active;
        outcomes = Progress.RecentOutcomes;

        // NEVER GetActiveJobs() here. This frame renders on every page for every operator, and
        // the unscoped accessor spans every module and every submitter - BulkJobService says so
        // itself. Guarded by GlobalProgressWiringTests.
        activeJobs = string.IsNullOrWhiteSpace(currentUser)
            ? Array.Empty<BulkJob>()
            : BulkJobs.GetActiveJobsBySubmitter(currentUser);

        recentJobs = string.IsNullOrWhiteSpace(currentUser)
            ? Array.Empty<BulkJob>()
            : BulkJobs.GetRecentJobsBySubmitter(currentUser);
    }

    // Only jobs that ENDED while this operator was here are announced, and only until dismissed.
    // Without the cutoff the frame would re-announce every job in the retention window on every
    // page load, which teaches the operator to ignore the one place that is meant to mean
    // something.
    private IReadOnlyList<BulkJob> FinishedSinceArrival() =>
        recentJobs
            .Where(j => j.FinishedAtUtc is DateTime finished
                && finished >= arrivedUtc
                && !dismissedJobs.Contains(j.Id))
            .ToList();

    private void ToggleExpanded() => expanded = !expanded;

    private void DismissLatest()
    {
        var latest = LatestOutcome;
        if (latest is null)
            return;

        if (latest.FromJob)
            dismissedJobs.Add(latest.Id);
        else
            Progress.DismissOutcome(latest.Id);

        Reload();
    }

    // Raised from the job pump's thread, not the renderer's, so it MUST be marshalled.
    private async void OnJobChanged(string jobId) => await Refresh();

    // Raised by whatever thread the reporting module is on, for the same reason.
    private async void OnProgressChanged() => await Refresh();

    private async Task Refresh()
    {
        if (disposed)
            return;

        try
        {
            await InvokeAsync(() =>
            {
                if (disposed)
                    return;

                Reload();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // The circuit went away between the guard and the dispatch. Nothing to update.
        }
        catch (Exception)
        {
            // These handlers are `async void`, so nothing above them can observe a fault: the
            // event source already returned successfully and there is no Task to carry it.
            // Reload() reads the jobs SQLite store, so a locked or unreadable database here
            // would surface as an unhandled exception and tear down the operator's whole
            // circuit - losing the page they were working on because a STATUS BAR could not
            // refresh. The frame is chrome; it must never be able to take the app down with
            // it. The existing job pages catch broadly around the same pattern.
            //
            // Swallowed rather than surfaced: the next JobChanged or Changed repaints, and a
            // frame that is briefly stale is the correct trade against a dead circuit.
        }
    }

    private static string ActivityStatus(Activity activity)
    {
        var counted = activity.Shape switch
        {
            ActivityShape.Steps => $"step {activity.Done} of {activity.Total}",
            ActivityShape.Items => $"{activity.Done:N0} of {activity.Total:N0}",
            _ => "working",
        };

        return string.IsNullOrWhiteSpace(activity.Detail) ? counted : $"{counted} - {activity.Detail}";
    }

    private static string JobLabel(BulkJob job) => job.JobType.Replace('_', ' ');

    // Null until the runner has stamped a row count, so a queued job shows an indeterminate bar
    // rather than a confident 0%.
    private static int? JobPercent(BulkJob job) =>
        job.TotalRows > 0
            ? (int)Math.Clamp(job.ProcessedRows * 100L / job.TotalRows, 0L, 100L)
            : null;

    private string JobStatus(BulkJob job)
    {
        var status = BulkJobs.DisplayStatus(job, DateTime.UtcNow);
        if (job.TotalRows <= 0)
            return status;

        var text = $"{status} - {job.ProcessedRows:N0} of {job.TotalRows:N0}";
        if (job.FailedCount > 0 || job.PartialCount > 0)
            text += $" ({job.SuccessCount:N0} ok, {job.PartialCount:N0} partial, {job.FailedCount:N0} failed)";

        return text;
    }

    // Completed with no failed rows is the only unambiguous success. Cancelled and Interrupted
    // are not successes, and a Completed job holding failed rows did not do what was asked.
    private static bool JobSucceeded(BulkJob job) =>
        job.Status == BulkJobStatus.Completed && job.FailedCount == 0;

    private static string JobEndedText(BulkJob job) => job.Status switch
    {
        BulkJobStatus.Completed when job.FailedCount == 0 => "finished",
        BulkJobStatus.Completed => "finished with failures",
        BulkJobStatus.Cancelled => "cancelled",
        BulkJobStatus.Interrupted => "interrupted",
        _ => job.Status.ToString().ToLowerInvariant(),
    };

    public void Dispose()
    {
        disposed = true;

        // This frame lives in the layout and outlives every page, so a leaked handler persists
        // for the life of the process and keeps a dead circuit's component reachable.
        if (!subscribed)
            return;

        Progress.Changed -= OnProgressChanged;
        BulkJobs.JobChanged -= OnJobChanged;
        subscribed = false;
    }
}

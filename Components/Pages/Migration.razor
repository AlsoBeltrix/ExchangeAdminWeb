    /// <summary>
    /// Runs one action over many batches, aggregating per-batch outcomes.
    /// </summary>
    /// <remarks>
    /// The single bulk executor: Clear Completed and both selection actions route through here, so
    /// the aggregation rules exist once. Extracted from ClearCompletedBatches, which already had
    /// them right.
    ///
    /// The rules, each load-bearing:
    /// - Authorization is re-checked here, once, and a denial is audited. Hiding the checkbox
    ///   column is not a security control.
    /// - ONE audit event per batch, inside the loop. A run-level event cannot answer which batch
    ///   was removed, which is the question the audit log exists to answer.
    /// - Audit-write failures are WARNINGS, never operation failures: an audit failure must not
    ///   make an already-completed removal look failed.
    /// - Per-item failures are aggregated; a loop over N items never reports blanket success.
    /// - Skipped batches (owner ruling D2(a)) are reported but are NOT failures and are NOT
    ///   audited - no write was attempted, so there is no security event to record.
    /// - ONE summary admin notification per run. Fifty emails for one operator action is a
    ///   self-inflicted denial of the mailbox.
    /// </remarks>
    private async Task ExecuteBulkBatchAction(
        IReadOnlyList<string> batchNames,
        IReadOnlyList<MigrationBatchSkip> skipped,
        Func<string, Task<PermissionResult>> action,
        string auditAction,
        string notificationAction,
        string verb,
        string ticket)
    {
        // Set before the first await - see CreateSingleMigrationBatch for why. The guards moved
        // inside the try so the existing finally clears both flags on every early return.
        actionInProgress = "clearing";
        isLoadingStatus = true;
        batchActionResult = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (!(await AuthorizationService.AuthorizeAsync(authState.User, "MigrationManage")).Succeeded)
            {
                batchActionResult = PermissionResult.Fail("Authorization denied.");
                try
                {
                    Audit.LogMigrationAction(currentUser, clientIpAddress, $"{auditAction}_Denied", notificationAction, false, ticket, errorDetail: "MigrationManage authorization denied");
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to write audit for {Action} denial", auditAction);
                }
                return;
            }

            if (migrationBatches == null) return;

            // The skipped rows are annotated before the early return, so "nothing to do" still
            // explains itself on the rows rather than in the banner.
            foreach (var earlySkip in skipped)
                actionOutcomes[earlySkip.BatchName] = $"Skipped ("+"{earlySkip.Status}"+")";

            // Nothing eligible is "nothing to do", not an error (D2(a)). Report the skips and stop
            // without touching Exchange, writing an audit event, or notifying anyone.
            if (batchNames.Count == 0)
            {
                batchActionResult = new PermissionResult
                {
                    Success = true,
                    Message = $"Nothing to do: none of {skipped.Count} selected batches is eligible.",
                    Detail = "Why each one was skipped is on its row."
                };
                return;
            }

            var succeeded = 0;
            // Names Exchange accepted the request for, so they can be deselected after the run.
            var accepted = new List<string>();
            var errors = new List<string>();
            // Audit-write failures are warnings, never operation failures: an audit
            // failure must not make an already-completed removal look failed.
            var auditWarnings = new List<string>();
            foreach (var batchName in batchNames)
            {
                var result = await action(batchName);
                try
                {
                    Audit.LogMigrationAction(currentUser, clientIpAddress, auditAction, batchName,
                        result.Success, ticket, errorDetail: result.Success ? null : result.Message);
                }
                catch (Exception ex)
                {
                    auditWarnings.Add($"{batchName}: audit logging failed: {ex.Message}");
                }

                if (result.Success)
                {
                    succeeded++;
                    accepted.Add(batchName);
                    actionOutcomes[batchName] = "Queued";
                }
                else
                {
                    errors.Add($"{batchName}: {result.Message}");

                    // R25: the reason lands ON THE ROW, not in the banner. The operator sees
                    // which batch refused and why by looking at it, instead of matching names
                    // out of a semicolon-joined list.
                    actionOutcomes[batchName] = result.Message ?? "Refused";
                    actionFailures.Add(batchName);
                }
            }

            foreach (var skip in skipped)
                actionOutcomes[skip.BatchName] = $"Skipped ("+"{skip.Status}"+")";

            // Every batch Exchange ACCEPTED is deselected, whatever happens next: leaving it ticked
            // invites a second click on work already in flight, and the row stays visible for
            // several refreshes because removal is asynchronous. Batches that FAILED stay ticked -
            // nothing was queued for them, and retrying is the likely next move. Skipped rows also
            // stay ticked (D2(a)), so the operator can pick a different action for exactly them.
            foreach (var name in accepted)
                selectedBatches.Remove(name);

            // R25. ONE GLANCEABLE LINE. Counts only - which batch refused and why is written on
            // that batch's row. The audit warnings are logged rather than appended: an audit
            // failure is real but it is not what the operator is deciding about in this second,
            // and it used to arrive as a parenthetical after an already-overlong sentence.
            foreach (var warning in auditWarnings)
                Logger.LogWarning("Audit warning during {Action}: {Detail}", auditAction, warning);

            var parts = new List<string> { $"{verb} {succeeded}" };
            if (errors.Count > 0) parts.Add($"{errors.Count} refused");
            if (skipped.Count > 0) parts.Add($"{skipped.Count} skipped");
            if (auditWarnings.Count > 0) parts.Add($"{auditWarnings.Count} audit warning(s)");

            var summary = string.Join(", ", parts) + " of " + (batchNames.Count + skipped.Count) + " batches.";
            batchActionResult = errors.Count == 0
                ? new PermissionResult { Success = true, Message = summary, Detail = "Exchange works in the background - use Refresh to follow it. Per-batch results are on the rows." }
                : PermissionResult.Fail(summary, "Per-batch results are on the rows.");

            try
            {
                await Email.SendAdminNotificationAsync(
                    currentUser, clientIpAddress, notificationAction,
                    $"{succeeded} batch(es)", "N/A", "Migration",
                    errors.Count == 0, ticket, errors.Any() ? string.Join("; ", errors) : null);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to send admin notification for {Action}", notificationAction);
            }

            var savedResult = batchActionResult;
            await LoadMigrationStatus();
            batchActionResult = batchActionResult ?? savedResult;
        }
        catch (Exception ex)
        {
            batchActionResult = PermissionResult.Fail(ex.Message);
        }
        finally
        {
            actionInProgress = null;
            isLoadingStatus = false;
        }
    }

    // The mailbox twin of ExecuteBulkBatchAction, and deliberately the same shape rather than a
    // shared generic: R12 says both bars behave identically, and every rule below is one this page
    // learned the hard way, so they are restated where they apply rather than abstracted into a
    // place where a later change to one silently changes the other.
    //
    // Known Failure Class 2 (success aggregation) is answered the same way: per-item results,
    // never a blanket banner; audit failures are warnings and cannot make a completed action read
    // as failed; nothing eligible is "nothing to do" and touches Exchange not at all.
    private async Task ExecuteBulkMailboxAction(
        MigrationUserActionPlan plan,
        Func<string, Task<PermissionResult>> action,
        string auditAction,
        string notificationAction,
        string verb,
        string ticket)
    {
        // Set before the first await - see CreateSingleMigrationBatch for why.
        actionInProgress = "mailboxes";
        batchActionResult = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (!(await AuthorizationService.AuthorizeAsync(authState.User, "MigrationManage")).Succeeded)
            {
                batchActionResult = PermissionResult.Fail("Authorization denied.");
                try
                {
                    Audit.LogMigrationAction(currentUser, clientIpAddress, $"{auditAction}_Denied",
                        notificationAction, false, ticket,
                        errorDetail: "MigrationManage authorization denied");
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to write audit for {Action} denial", auditAction);
                }
                return;
            }

            if (batchUsers == null) return;

            foreach (var earlySkip in plan.Skipped)
                actionOutcomes[earlySkip.EmailAddress] = $"Skipped ("+"{earlySkip.Status}"+")";

            if (plan.Eligible.Count == 0)
            {
                batchActionResult = new PermissionResult
                {
                    Success = true,
                    Message = $"Nothing to do: none of {plan.Skipped.Count} selected mailboxes is eligible.",
                    Detail = "Why each one was skipped is on its row."
                };
                return;
            }

            var succeeded = 0;
            var accepted = new List<string>();
            var errors = new List<string>();
            var auditWarnings = new List<string>();

            foreach (var email in plan.Eligible)
            {
                var result = await action(email);
                try
                {
                    Audit.LogMigrationAction(currentUser, clientIpAddress, auditAction, email,
                        result.Success, ticket, errorDetail: result.Success ? null : result.Message);
                }
                catch (Exception ex)
                {
                    auditWarnings.Add($"{email}: audit logging failed: {ex.Message}");
                }

                if (result.Success)
                {
                    succeeded++;
                    accepted.Add(email);
                    actionOutcomes[email] = "Queued";
                }
                else
                {
                    errors.Add($"{email}: {result.Message}");
                    actionOutcomes[email] = result.Message ?? "Refused";
                    actionFailures.Add(email);
                }
            }

            foreach (var skip in plan.Skipped)
                actionOutcomes[skip.EmailAddress] = $"Skipped ("+"{skip.Status}"+")";

            // Same rule as the batch executor: everything Exchange ACCEPTED is unticked, because
            // leaving it ticked invites a second click on work already in flight and the row stays
            // visible for several refreshes. Failures and skips stay ticked - nothing was queued
            // for them, and retrying or picking a different action is the likely next move.
            foreach (var email in accepted)
                selectedMailboxes.Remove(email);

            // R25, same as the batch executor: counts in the banner, detail on the rows.
            foreach (var warning in auditWarnings)
                Logger.LogWarning("Audit warning during {Action}: {Detail}", auditAction, warning);

            var parts = new List<string> { $"{verb} {succeeded}" };
            if (errors.Count > 0) parts.Add($"{errors.Count} refused");
            if (plan.Skipped.Count > 0) parts.Add($"{plan.Skipped.Count} skipped");
            if (auditWarnings.Count > 0) parts.Add($"{auditWarnings.Count} audit warning(s)");

            var summary = string.Join(", ", parts) + " of "
                + (plan.Eligible.Count + plan.Skipped.Count) + " mailboxes.";
            batchActionResult = errors.Count == 0
                ? new PermissionResult { Success = true, Message = summary, Detail = "Exchange works in the background - use Refresh to follow it. Per-mailbox results are on the rows." }
                : PermissionResult.Fail(summary, "Per-mailbox results are on the rows.");

            try
            {
                await Email.SendAdminNotificationAsync(
                    currentUser, clientIpAddress, notificationAction,
                    $"{succeeded} mailbox(es)", "N/A", "Migration",
                    errors.Count == 0, ticket, errors.Any() ? string.Join("; ", errors) : null);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to send admin notification for {Action}", notificationAction);
            }

            // Refresh THIS pane only (R30). The catalogue has not changed - these actions move
            // mailboxes inside one batch - so reloading it would be the batch pane silently doing
            // the mailbox pane's work.
            var savedResult = batchActionResult;
            if (expandedBatch != null)
                await LoadMailboxesFor(expandedBatch);
            batchActionResult ??= savedResult;

            ClampMailboxPages();
        }
        catch (Exception ex)
        {
            batchActionResult = PermissionResult.Fail(ex.Message);
        }
        finally
        {
            actionInProgress = null;
        }
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(searchQuery))
            await SearchUser();
    }

    private void ClearSearch()
    {
        searchQuery = "";
        highlightedUser = null;
        batchActionResult = null;
    }

    private async Task SearchUser()
    {
        if (string.IsNullOrWhiteSpace(searchQuery) || migrationBatches == null) return;

        var query = searchQuery.Trim();
        isSearching = true;
        highlightedUser = null;
        batchActionResult = null;

        try
        {
            var matchedBatch = migrationBatches.FirstOrDefault(b =>
                b.BatchName.Contains(query, StringComparison.OrdinalIgnoreCase));

            if (matchedBatch != null)
            {
                // R9 and R26. Finding takes the operator TO the batch, and arriving at a batch is
                // selecting it - there is no third state where the pane shows one thing and the
                // tick boxes another. Adopt navigates and loads, so nothing is fetched here.
                selectedBatches.Clear();
                selectedBatches.Add(matchedBatch.BatchName);
                batchUsers = null;
                InvalidateStoredReports();
                StateHasChanged();

                await AdoptSelectionAsOpenBatch();
                return;
            }

            var searchResult = await MigrationSvc.FindMigrationUserBatchAsync(query);

            if (searchResult.Error != null)
            {
                batchActionResult = PermissionResult.Fail($"Search failed: {searchResult.Error}");
                return;
            }

            if (searchResult.MatchCount == 0)
            {
                batchActionResult = PermissionResult.Fail($"No batch or user found matching \"{query}\".");
                return;
            }

            if (searchResult.MatchCount > 1)
            {
                batchActionResult = PermissionResult.Fail($"Multiple users ({searchResult.MatchCount}) match \"{query}\". Use a more specific search term.");
                return;
            }

            highlightedUser = searchResult.Email;
            selectedBatches.Clear();
            selectedBatches.Add(searchResult.BatchId!);
            batchUsers = null;
            InvalidateStoredReports();
            StateHasChanged();

            await AdoptSelectionAsOpenBatch();
        }
        catch (Exception ex)
        {
            batchActionResult = PermissionResult.Fail($"Search failed: {ex.Message}");
        }
        finally
        {
            // Both of the branches above set loadingBatchUsers before an await and the catch
            // swallows the exception, so clearing it on the success path only left it stuck for
            // the life of the circuit whenever Exchange failed. SelectOnlyBatch and
            // RefreshBatchUsers already clear it here; this method now matches them.
            isSearching = false;
            loadingBatchUsers = null;
        }
    }

    // The open report is a snapshot fetched once. Any reload of batchUsers can change which
    // migration a row refers to - a batch deleted and recreated under the same name is a different
    // migration with the same key - so the snapshot must not survive the reload. Never render
    // report text that was not just fetched. Every site that reloads or discards batchUsers calls
    // this; the generation bump also invalidates a fetch that is still in flight.
    // R24e. DISMISSING the dialog and INVALIDATING the report are two different operations, and
    // until S6 they were one method. Reusing the invalidating one for the Close button makes R24a
    // impossible: every close would guarantee a re-fetch, and a re-fetch is twenty minutes of
    // Get-MigrationUserStatistics.
    //
    // This one hides the dialog and touches nothing else. The stored copy survives, so reopening
    // is instant.
    private void DismissReportModal()
    {
        reportUser = null;
        userReport = null;
        reportFetchedAtUtc = null;
    }

    // The other one. Bumps the generation, so a fetch still in flight discards its own result,
    // and deletes the stored copies - because the rows this report describes are being replaced.
    //
    // R24b, and it is a regression guard for queue item 3: a report open while its batch was
    // removed and recreated under the same name kept showing the PREVIOUS migration's report. The
    // batch name is the same, so nothing else distinguishes them. Every site that reloads or
    // discards batchUsers calls this, never DismissReportModal.
    private void InvalidateStoredReports()
    {
        reportGeneration++;
        reportUser = null;
        userReport = null;
        reportFetchedAtUtc = null;
        loadingReport = null;

        // Fail-soft: a store that cannot be swept must not break a row reload. A report that
        // survives deletion is still refused on read once it expires, and its generation is gone.
        try
        {
            ReportStore.DeleteAll();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Stored migration reports could not be discarded");
        }
    }

    // Every replacement of the rendered rows goes through here, and the close happens AFTER the
    // await that produced them. Closing before the await is not enough: the paths that refresh in
    // place leave the old rows - and their enabled Report button - rendered for the whole Exchange
    // call, so a report opened inside that window captures the already-bumped generation and would
    // survive the swap. Bumping again here discards it. Assigning batchUsers directly anywhere else
    // reopens that hole; a test enforces that no such assignment exists.
    private void ReplaceBatchUsers(int generation, List<MigrationUserInfo> users)
    {
        // mir-1. The caller captured `generation` before its await; if the open batch has changed
        // since, these rows belong to a batch the operator has already left and publishing them
        // would render one batch's name over another batch's mailboxes - whose per-mailbox action
        // buttons would then act on the wrong batch, silently.
        //
        // The guard is HERE rather than at the call sites because this is the one place rows may be
        // assigned, so every path is covered by construction and a seventh load path added later
        // cannot forget it. The two the openreview cited are reachable from browser Back; the other
        // four are not today, and that is exactly the kind of fact that stops being true one slice
        // later.
        if (generation != batchUsersGeneration)
            return;

        InvalidateStoredReports();
        batchUsers = users;

        // S5. The rows just changed under the pager. Clamp rather than reset: a refresh of the
        // same batch should leave the operator where they were, and only a shrink that puts them
        // past the end moves them - onto the last page, never onto a blank one that reads as an
        // empty batch.
        mailboxPage = ListWindow.ClampPage(mailboxPage, MailboxTotalCount, MailboxPageSize);
    }

    // R24a. A fetched report is KEPT, and re-fetching is a deliberate act.
    // Get-MigrationUserStatistics can take twenty minutes or more on a long or problematic
    // migration, so opening the dialog a second time must never run it again. That is a
    // correctness requirement about operator time, not a caching optimisation.
    private async Task LoadUserReport(string emailAddress)
    {
        if (IsBusy || expandedBatch == null) return;

        // Same row clicked twice: just hide the dialog. The stored copy stays, so the next click
        // is instant - this is the whole point of splitting dismiss from invalidate.
        if (reportUser == emailAddress)
        {
            DismissReportModal();
            return;
        }

        // Already held? Show it without touching Exchange, and say when it was taken so the
        // operator can judge whether it is worth the twenty minutes to refresh.
        var stored = ReportStore.TryRead(expandedBatch, emailAddress, DateTime.UtcNow);
        if (stored != null)
        {
            userReport = stored.Text;
            reportFetchedAtUtc = stored.FetchedAtUtc;
            reportUser = emailAddress;
            return;
        }

        await FetchUserReport(emailAddress);
    }

    // R24a's other half: "Fetch again" is its own control and says what it costs. Reached only
    // from the dialog, never from opening it.
    private async Task RefetchUserReport(string emailAddress)
    {
        if (IsBusy || expandedBatch == null) return;

        ReportStore.Delete(expandedBatch, emailAddress);
        await FetchUserReport(emailAddress);
    }

    private async Task FetchUserReport(string emailAddress)
    {
        var batch = expandedBatch;
        if (batch == null) return;

        var generation = reportGeneration;
        loadingReport = emailAddress;
        var takenAtUtc = DateTime.UtcNow;

        try
        {
            var text = await MigrationSvc.GetMigrationUserReportAsync(emailAddress);
            if (generation != reportGeneration) return;

            // Stored before it is rendered, so the modal and any later consumer read the same
            // bytes (R24c, and R31e depends on it). A store failure must not lose the report the
            // operator just waited twenty minutes for - it is shown either way, just not kept.
            try
            {
                ReportStore.Write(batch, emailAddress, text, takenAtUtc);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Migration report for {Email} could not be stored", emailAddress);
            }

            userReport = text;
            reportFetchedAtUtc = takenAtUtc;
            reportUser = emailAddress;
        }
        catch (Exception ex)
        {
            if (generation != reportGeneration) return;

            // NOT stored. An error string is not a report, and keeping it would serve the failure
            // back on the next open as though it were the answer.
            userReport = $"Error: {ex.Message}";
            reportFetchedAtUtc = null;
            reportUser = emailAddress;
        }
        finally
        {
            // A superseded continuation leaves loadingReport alone: whatever superseded it already
            // nulled it, and a late write would resurrect a spinner for a fetch nobody awaits.
            if (generation == reportGeneration)
                loadingReport = null;
        }
    }

    // S2 replaced seven clickable table headers with one select and one direction toggle. Two
    // controls that set the same two values is the ambiguity R19 says to fix by structure rather
    // than by labelling, and the batch row now shows the four columns R16 names - so clickable
    // headers could only have reached four of the seven keys. Every key the old header row
    // carried is still here.
    private void OnBatchSortColumnChanged(ChangeEventArgs e)
    {
        var column = e.Value?.ToString();
        if (string.IsNullOrEmpty(column) || column == batchSortColumn)
            return;

        batchSortColumn = column;

        // Text ascending, magnitudes and dates descending: the same defaults the old header
        // click applied when it moved to a new column.
        batchSortAsc = column is "Name" or "Status" or "Direction";
        ResetBatchPage();
    }

    private void ToggleBatchSortDirection()
    {
        batchSortAsc = !batchSortAsc;
        ResetBatchPage();
    }

    // Page 9 of a 3-page result renders nothing and looks like an empty catalogue, so every
    // change to the ordering or the membership of the list goes back to the first page.
    private void ResetBatchPage() => batchPage = 0;

    // R20. The catalogue pages; the whole set is still what sorts, what select-all ticks and what
    // the CSV exports. Blazor Server pushes a render diff per row over the circuit, and rendering
    // 2000 of them is how the Defender page died - so no view may render the full set, with no
    // exception, including a select-all of every batch.
    // The windowing itself lives in ListWindow, where it is a pure function that tests can run
    // against 2000 batches. Nothing in this repo can render a Blazor component, so a test here
    // could only have anchored the markup; the count that R20 is about is proved there instead.
    private IEnumerable<MigrationBatchInfo> GetPagedBatches() =>
        ListWindow.Slice(GetSortedBatches(), batchPage, BatchPageSize);

    // The FILTERED count, so the pager says "1-40 of 12 batches" while a filter is narrowing 800
    // down. Reporting the catalogue size there would describe a list the operator is not looking
    // at.
    private int BatchTotalCount => GetSortedBatches().Count();

    private int BatchPageCount => ListWindow.PageCount(BatchTotalCount, BatchPageSize);

    private string BatchPagerLabel =>
        ListWindow.Label(batchPage, BatchTotalCount, BatchPageSize, "batches", "No batches");

    private void StepBatchPage(int delta) =>
        batchPage = ListWindow.ClampPage(batchPage + delta, BatchTotalCount, BatchPageSize);

    // R21 and R26. Filter and sort over the WHOLE catalogue, never the rendered page - and the
    // filter is the batch-NAME one, which is a different control from the person search above
    // both panes. That search finds a mailbox anywhere and jumps to its batch; this narrows what
    // is listed.
    private IEnumerable<MigrationBatchInfo> GetSortedBatches()
    {
        if (migrationBatches == null) return Enumerable.Empty<MigrationBatchInfo>();

        IEnumerable<MigrationBatchInfo> rows = migrationBatches;

        var filter = batchFilter.Trim();
        if (filter.Length > 0)
            rows = rows.Where(b => b.BatchName?.Contains(filter, StringComparison.OrdinalIgnoreCase) == true);

        return batchSortColumn switch
        {
            "Name" => batchSortAsc ? rows.OrderBy(b => b.BatchName) : rows.OrderByDescending(b => b.BatchName),
            "Status" => batchSortAsc ? rows.OrderBy(b => b.Status) : rows.OrderByDescending(b => b.Status),
            "Direction" => batchSortAsc ? rows.OrderBy(b => b.Direction) : rows.OrderByDescending(b => b.Direction),
            "Total" => batchSortAsc ? rows.OrderBy(b => b.TotalCount) : rows.OrderByDescending(b => b.TotalCount),
            "Synced" => batchSortAsc ? rows.OrderBy(b => b.SyncedCount) : rows.OrderByDescending(b => b.SyncedCount),
            "Failed" => batchSortAsc ? rows.OrderBy(b => b.FailedCount) : rows.OrderByDescending(b => b.FailedCount),
            _ => batchSortAsc ? rows.OrderBy(b => b.CreatedDateTime) : rows.OrderByDescending(b => b.CreatedDateTime),
        };
    }

    private void OnBatchFilterChanged(ChangeEventArgs e)
    {
        batchFilter = e.Value?.ToString() ?? "";
        ResetBatchPage();
    }

    /// <summary>
    /// Docs/ModuleCsvExport-Plan.md AC3: BatchName,Status,Direction,Created,Started,
    /// Completed,Total,Synced,Finalized,Failed,TargetEndpoint, in that order. Batch-level
    /// only (plan section 2 non-goal: no per-user rows). Nullable dates map to an empty
    /// cell; populated dates use the same "MMM dd, yyyy HH:mm" local format the batch
    /// details view already renders for Created/Started/Completed. Static and
    /// argument-fed so tests call it directly without a page instance.
    /// </summary>
    internal static string BuildCsv(IReadOnlyList<MigrationBatchInfo> rows)
    {
        var header = new List<string>
        {
            "BatchName", "Status", "Direction", "Created", "Started", "Completed",
            "Total", "Synced", "Finalized", "Failed", "TargetEndpoint"
        };
        var csvRows = rows.Select(r => (IReadOnlyList<string>)new List<string>
        {
            r.BatchName,
            r.Status,
            r.Direction.ToString(),
            FormatBatchDate(r.CreatedDateTime),
            r.StartDateTime.HasValue ? FormatBatchDate(r.StartDateTime.Value) : string.Empty,
            r.CompletedDateTime.HasValue ? FormatBatchDate(r.CompletedDateTime.Value) : string.Empty,
            r.TotalCount.ToString(),
            r.SyncedCount.ToString(),
            r.FinalizedCount.ToString(),
            r.FailedCount.ToString(),
            r.TargetEndpoint ?? string.Empty,
        });
        return CsvExport.Write(header, csvRows);
    }

    private static string FormatBatchDate(DateTime value) => value.ToLocalTime().ToString("MMM dd, yyyy HH:mm");

    private async Task DownloadCsvAsync()
    {
        if (migrationBatches is not { Count: > 0 })
            return;

        // Set before the first await so the page-wide gate closes for the whole round-trip;
        // cleared in a finally so a failed interop cannot leave the page dead.
        isDownloadingCsv = true;

        try
        {
            var rows = GetSortedBatches().ToList();
            var csv = BuildCsv(rows);
            var bytes = System.Text.Encoding.UTF8.GetBytes(csv);
            var base64 = Convert.ToBase64String(bytes);
            var timestamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
            await JS.InvokeVoidAsync("downloadFile", $"Migration_{timestamp}.csv", "text/csv", base64);

            try
            {
                Audit.LogModuleAction(currentUser, clientIpAddress, "ExportCsv", "Migration",
                    $"{rows.Count} rows", true);
            }
            catch (Exception auditEx)
            {
                Logger.LogError(auditEx, "Audit failed for Migration status CSV export");
            }
        }
        finally
        {
            isDownloadingCsv = false;
        }
    }

    // R24. Export writes the whole report to a file rather than making anyone select tens of
    // thousands of lines out of a scroll box. It writes the bytes ON SCREEN, which are the bytes
    // the store holds (R24c) - so the file and the dialog cannot disagree, and neither can the
    // file and the zip that S7 will build from the same store.
    //
    // Audited as a read of migration data: this puts a copy of a mailbox's migration diagnostics
    // on someone's workstation, and who did that is worth knowing.
    private async Task ExportOpenReportAsync()
    {
        if (reportUser == null || userReport == null)
            return;

        // Same flag the CSV download uses, set before the first await so the page-wide gate
        // closes for the whole interop round-trip, cleared in a finally so a failed interop
        // cannot leave the page dead.
        isDownloadingCsv = true;

        try
        {
            var bytes = System.Text.Encoding.UTF8.GetBytes(userReport);
            var base64 = Convert.ToBase64String(bytes);

            // The address is operator-supplied text and this becomes a filename, so everything
            // outside a known-safe set is replaced rather than trusted.
            var safeName = new string(reportUser.Select(c =>
                char.IsLetterOrDigit(c) || c is '-' or '_' or '.' ? c : '_').ToArray());
            var timestamp = (reportFetchedAtUtc ?? DateTime.UtcNow).ToLocalTime().ToString("yyyyMMdd_HHmmss");

            await JS.InvokeVoidAsync(
                "downloadFile", $"MigrationReport_{safeName}_{timestamp}.txt", "text/plain", base64);

            try
            {
                Audit.LogModuleAction(currentUser, clientIpAddress, "ExportUserReport", "Migration",
                    reportUser, true);
            }
            catch (Exception auditEx)
            {
                Logger.LogError(auditEx, "Audit failed for Migration user report export");
            }
        }
        finally
        {
            isDownloadingCsv = false;
        }
    }

    private string GetStatusColor(string status)
    {
        return status.ToLowerInvariant() switch
        {
            "completed" => "success",
            "syncing" or "synced" => "primary",
            "stopped" or "stopping" => "warning",
            "failed" => "danger",
            "corrupted" => "danger",
            "needsapproval" => "warning",
            _ => "secondary"
        };
    }

    private string GetUserStatusColor(string status)
    {
        return status.ToLowerInvariant() switch
        {
            "completed" => "success",
            "synced" => "info",
            "syncing" => "primary",
            "failed" => "danger",
            "stopped" => "warning",
            "needsapproval" => "warning",
            "queued" => "secondary",
            _ => "secondary"
        };
    }

    private async Task DownloadSampleCsv()
    {
        var content = "EmailAddress\nuser@company.com\n";
        var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(content));
        await JS.InvokeVoidAsync("downloadFile", "migration_check_sample.csv", "text/csv", base64);
    }
}

@page "/migration"
@using ExchangeAdminWeb.Models
@using ExchangeAdminWeb.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "MigrationCheck")]
@inject MigrationService MigrationSvc
@inject AuditService Audit
@inject EmailService Email
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager Navigation
@inject ClientInfoService ClientInfo
@inject IJSRuntime JS
@inject ILogger<ExchangeAdminWeb.Components.Pages.Migration> Logger
@inject MigrationReportStore ReportStore
@rendermode InteractiveServer

<PageTitle>Exchange Migration</PageTitle>

<div class="container-fluid mt-4">
    <div class="alert alert-info py-2 mb-3"><small>Migration actions are logged for audit purposes, including eligibility checks, batch creation, and status changes.</small></div>
    <h2>Exchange Migration<ModuleVersion /></h2>
    <p class="text-muted">Check migration eligibility and create migration batches to/from Exchange Online</p>

    @* The tab strip is anchors, and an <a> ignores the disabled attribute entirely, so the gate
       has to live in the handler. The disabled class is styling only - it greys the link and
       tells the operator why nothing happens; SelectTab and SelectStatusTab do the actual
       refusing. Switching tabs mid-operation discards a running report or user reload. *@
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link @(tabIndex == 0 ? "active" : "") @(IsBusy ? "disabled" : "")" @onclick="() => SelectTab(0)" href="javascript:void(0)">Single User Check</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(tabIndex == 1 ? "active" : "") @(IsBusy ? "disabled" : "")" @onclick="() => SelectTab(1)" href="javascript:void(0)">Bulk CSV Check</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(tabIndex == 2 ? "active" : "") @(IsBusy ? "disabled" : "")" @onclick="SelectStatusTab" href="javascript:void(0)">Migration Status</a>
        </li>
    </ul>

    @if (tabIndex == 0)
    {
        <!-- Single User Check -->
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Check Single User Migration Eligibility</h5>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Email Address</label>
                        <input type="email" class="form-control" @bind="singleEmail" placeholder="user@example.com" disabled="@isLoading" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Migration Direction</label>
                        <select class="form-select" @bind="singleMigrationDirection" disabled="@isLoading">
                            <option value="@MigrationDirection.ToCloud">To Exchange Online</option>
                            <option value="@MigrationDirection.ToOnPrem">To On-Premises</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Ticket Number</label>
                        <input type="text" class="form-control" @bind="singleTicketNumber" placeholder="INC0000000" disabled="@isLoading" required />
                    </div>
                </div>

                <button class="btn btn-primary" @onclick="CheckSingleEligibility" disabled="@(IsBusy || string.IsNullOrWhiteSpace(singleEmail) || string.IsNullOrWhiteSpace(singleTicketNumber))">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    Check Eligibility
                </button>

                @if (singleResult != null)
                {
                    <div class="alert @(singleResult.Status == MigrationStatus.Eligible && !singleResult.IsProtected ? "alert-success" : "alert-danger") mt-3">
                        @if (singleResult.Status == MigrationStatus.Eligible)
                        {
                            @if (singleResult.IsProtected)
                            {
                                <p class="mb-0"><strong>@singleResult.EmailAddress is eligible to migrate @(singleMigrationDirection == MigrationDirection.ToCloud ? "to Exchange Online" : "to On-Premises") from an Exchange/AD standpoint, but is a protected principal and cannot be migrated from this tool.</strong></p>
                            }
                            else
                            {
                                <p class="mb-0"><strong>@singleResult.EmailAddress IS eligible to migrate @(singleMigrationDirection == MigrationDirection.ToCloud ? "to Exchange Online" : "to On-Premises"). :)</strong></p>
                            }
                        }
                        else
                        {
                            <p class="mb-0"><strong>@singleResult.EmailAddress IS NOT eligible to migrate @(singleMigrationDirection == MigrationDirection.ToCloud ? "to Exchange Online" : "to On-Premises")</strong></p>
                            @if (singleResult.IneligibilityReasons.Any())
                            {
                                <hr />
                                <strong>Reasons:</strong>
                                <ul class="mb-0">
                                    @foreach (var reason in singleResult.IneligibilityReasons)
                                    {
                                        <li>@reason</li>
                                    }
                                </ul>
                            }
                        }
                        @if (singleResult.IsProtected)
                        {
                            <hr />
                            <p class="mb-1"><strong>⚠ Protected principal — must be escalated.</strong></p>
                            @if (!string.IsNullOrWhiteSpace(singleResult.ProtectionNote))
                            {
                                <p class="mb-1">@singleResult.ProtectionNote</p>
                            }
                            <p class="mb-0">Migrating a protected principal is not permitted in this tool. Escalate to an administrator outside this tool if migration is required.</p>
                        }
                        @if (singleResult.Warnings.Any())
                        {
                            <hr />
                            <strong>Warnings:</strong>
                            <ul class="mb-0">
                                @foreach (var warning in singleResult.Warnings)
                                {
                                    <li class="text-warning">@warning</li>
                                }
                            </ul>
                        }
                        @if (singleResult.MailboxSizeGB > 0 || singleResult.ArchiveSizeGB > 0)
                        {
                            <p class="mb-1">
                                <strong>Mailbox:</strong> @singleResult.MailboxSizeGB.ToString("F2") GB
                                @if (singleResult.ArchiveSizeGB > 0)
                                {
                                    <text> | <strong>Archive:</strong> @singleResult.ArchiveSizeGB.ToString("F2") GB</text>
                                }
                                | <strong>Total:</strong> @singleResult.TotalSizeGB.ToString("F2") GB
                            </p>
                        }
                        @if (singleResult.MailboxExceedsQuota)
                        {
                            <p class="mb-0 text-warning"><strong>Mailbox (@singleResult.MailboxSizeGB.ToString("F2") GB) exceeds the @singleResult.CloudQuotaGB GB per-mailbox limit</strong></p>
                        }
                        @if (singleResult.ArchiveExceedsQuota)
                        {
                            <p class="mb-0 text-warning"><strong>Archive (@singleResult.ArchiveSizeGB.ToString("F2") GB) exceeds the @singleResult.CloudQuotaGB GB per-mailbox limit</strong></p>
                        }
                    </div>

                    @if (singleResult.Status == MigrationStatus.Eligible && !singleResult.IsProtected)
                    {
                        <div class="card mt-3 border-success">
                            <div class="card-body">
                                <h6>Create Migration Batch</h6>
                                <p class="text-muted">User is eligible to migrate @(singleMigrationDirection == MigrationDirection.ToCloud ? "to Exchange Online" : "to On-Premises")</p>

                                <div class="row g-3 mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Batch Name (optional)</label>
                                        <input type="text" class="form-control" @bind="singleBatchName" placeholder="@singleResult.EmailAddress" disabled="@isCreating" />
                                        <small class="text-muted">Leave empty to use email address as batch name</small>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Options</label>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" @bind="singleAutoStart" disabled="@isCreating" id="singleAutoStartCheck" />
                                            <label class="form-check-label" for="singleAutoStartCheck">Auto-start migration immediately</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" @bind="singleAutoComplete" disabled="@isCreating" id="singleAutoCompleteCheck" />
                                            <label class="form-check-label" for="singleAutoCompleteCheck">Auto-complete migration when synced</label>
                                        </div>
                                    </div>
                                </div>

                                @if (canCreate)
                                {
                                    <button class="btn btn-success" @onclick="CreateSingleMigrationBatch" disabled="@IsBusy">
                                        @if (isCreating)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                        }
                                        Create Migration Batch
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    @if (singleCreateResult != null)
                    {
                        <div class="alert @(singleCreateResult.Success ? "alert-success" : "alert-danger") mt-3">
                            <strong>@(singleCreateResult.Success ? "✓" : "✗") @singleCreateResult.Message</strong>
                            @if (!string.IsNullOrWhiteSpace(singleCreateResult.Detail))
                            {
                                <p class="mb-0 mt-2">@singleCreateResult.Detail</p>
                            }
                        </div>
                        @if (singleCreateResult.ExcludedTargets is { Count: > 0 } singleExcluded)
                        {
                            <div class="alert alert-warning mt-3">
                                <strong>⚠ @singleExcluded.Count protected principal(s) were excluded and NOT migrated.</strong>
                                <ul class="mb-2 mt-2">
                                    @foreach (var item in singleExcluded)
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                                <p class="mb-0">Migrating a protected principal is not permitted in this tool. Escalate to an administrator outside this tool if migration is required.</p>
                            </div>
                        }
                    }
                }
            </div>
        </div>
    }
    else if (tabIndex == 1)
    {
        <!-- Bulk CSV Check -->
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Bulk Migration Eligibility Check</h5>
                <p class="text-muted">Upload a CSV file with EmailAddress column to check migration eligibility for multiple users.</p>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label">CSV File (EmailAddress column required)</label>
                        <InputFile class="form-control" OnChange="HandleCsvUpload" disabled="@isLoading" accept=".csv" />
                        <button type="button" class="btn btn-outline-secondary btn-sm mt-1" @onclick="DownloadSampleCsv">Sample CSV</button>
                        <small class="text-muted d-block mt-1">Format: EmailAddress<br />user1@example.com<br />user2@example.com</small>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Migration Direction</label>
                        <select class="form-select" @bind="migrationDirection" disabled="@isLoading">
                            <option value="@MigrationDirection.ToCloud">To Exchange Online</option>
                            <option value="@MigrationDirection.ToOnPrem">To On-Premises</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Ticket Number</label>
                        <input type="text" class="form-control" @bind="bulkTicketNumber" placeholder="INC0000000" disabled="@isLoading" required />
                    </div>
                </div>

                <button class="btn btn-primary" @onclick="CheckBulkEligibility" disabled="@(IsBusy || csvFile == null || string.IsNullOrWhiteSpace(bulkTicketNumber))">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    Check All
                </button>

                @if (bulkResult != null)
                {
                    <div class="alert alert-info mt-3">
                        <h6>Eligibility Check Results</h6>
                        <p class="mb-0">
                            <strong>Total Users:</strong> @bulkResult.TotalUsers |
                            <strong>Eligible:</strong> <span class="text-success">@bulkResult.EligibleUsers</span> |
                            <strong>Ineligible:</strong> <span class="text-danger">@bulkResult.IneligibleUsers</span>
                        </p>
                    </div>

                    <div class="table-responsive mt-3">
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th style="width: 280px;">Email Address</th>
                                    <th style="width: 90px;">Status</th>
                                    <th>Reasons / Notes</th>
                                    <th style="width: 120px; text-align: right;">Size (GB)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in bulkResult.EligibilityResults)
                                {
                                    <tr class="@(item.Status == MigrationStatus.Eligible && !item.IsProtected ? "table-success" : "table-danger")">
                                        <td>@item.EmailAddress</td>
                                        <td><strong>@item.Status</strong></td>
                                        <td>
                                            @if (item.IneligibilityReasons.Any())
                                            {
                                                <ul class="mb-0">
                                                    @foreach (var reason in item.IneligibilityReasons)
                                                    {
                                                        <li>@reason</li>
                                                    }
                                                </ul>
                                            }
                                            else
                                            {
                                                <span class="text-success">✓ Ready to migrate</span>
                                            }
                                            @if (item.IsProtected)
                                            {
                                                <div class="text-danger mt-1"><strong>⚠ Protected principal — will be excluded from the batch; escalate outside this tool.</strong></div>
                                            }
                                        </td>
                                        <td style="text-align: right;">
                                            @if (item.MailboxSizeGB > 0 || item.ArchiveSizeGB > 0)
                                            {
                                                <span class="@(item.MailboxExceedsQuota ? "text-warning" : null)">@item.MailboxSizeGB.ToString("F2")</span>
                                                @if (item.ArchiveSizeGB > 0)
                                                {
                                                    <text> + </text>
                                                    <span class="@(item.ArchiveExceedsQuota ? "text-warning" : null)">@item.ArchiveSizeGB.ToString("F2") archive</span>
                                                }
                                                @if (item.ExceedsQuota)
                                                {
                                                    <text> (exceeds limit)</text>
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (bulkResult.EligibleUsers > 0)
                    {
                        <div class="card mt-3 border-success">
                            <div class="card-body">
                                <h6>Create Migration Batch</h6>
                                <p class="text-muted">@bulkResult.EligibleUsers user(s) eligible to migrate @(migrationDirection == MigrationDirection.ToCloud ? "to Exchange Online" : "to On-Premises")</p>

                                <div class="row g-3 mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Batch Name (optional)</label>
                                        <input type="text" class="form-control" @bind="bulkBatchName" placeholder="@($"{DateTime.Now:yyyy-MM-dd}_{(migrationDirection == MigrationDirection.ToCloud ? "Move" : "MoveBack")}")" disabled="@isCreating" />
                                        <small class="text-muted">Leave empty to use date and direction (e.g., @($"{DateTime.Now:yyyy-MM-dd}_{(migrationDirection == MigrationDirection.ToCloud ? "Move" : "MoveBack")}"))</small>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Options</label>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" @bind="bulkAutoStart" disabled="@isCreating" id="bulkAutoStartCheck" />
                                            <label class="form-check-label" for="bulkAutoStartCheck">Auto-start migration immediately</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" @bind="bulkAutoComplete" disabled="@isCreating" id="bulkAutoCompleteCheck" />
                                            <label class="form-check-label" for="bulkAutoCompleteCheck">Auto-complete migration when synced</label>
                                        </div>
                                    </div>
                                </div>

                                @if (canCreate)
                                {
                                    <button class="btn btn-success" @onclick="CreateMigrationBatch" disabled="@IsBusy">
                                        @if (isCreating)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                        }
                                        Create Migration Batch
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    @if (createResult != null)
                    {
                        <div class="alert @(createResult.Success ? "alert-success" : "alert-danger") mt-3">
                            <strong>@(createResult.Success ? "✓" : "✗") @createResult.Message</strong>
                            @if (!string.IsNullOrWhiteSpace(createResult.Detail))
                            {
                                <p class="mb-0 mt-2">@createResult.Detail</p>
                            }
                        </div>
                        @if (createResult.ExcludedTargets is { Count: > 0 } bulkExcluded)
                        {
                            <div class="alert alert-warning mt-3">
                                <strong>⚠ @bulkExcluded.Count protected principal(s) were excluded and NOT migrated.</strong>
                                <ul class="mb-2 mt-2">
                                    @foreach (var item in bulkExcluded)
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                                <p class="mb-0">Migrating a protected principal is not permitted in this tool. Escalate to an administrator outside this tool if migration is required.</p>
                            </div>
                        }
                    }
                }
            </div>
        </div>
    }
    else if (tabIndex == 2)
    {
        <!-- Migration Status -->
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="card-title mb-0">Migration Batches</h5>
                    @* R26: finding a person searches every batch, so it sits above both panes
                       rather than inside the one that lists batch names. Splitting it from a
                       batch-name filter is S6; today this control is the only search there is. *@
                    <div class="d-flex align-items-center gap-2">
                        <div class="input-group input-group-sm" style="width: 280px;">
                            <input type="text" class="form-control" placeholder="Search batch or user email..."
                                   @bind="searchQuery" @bind:event="oninput"
                                   @onkeydown="HandleSearchKeyDown" disabled="@IsBusy" />
                            @if (!string.IsNullOrWhiteSpace(searchQuery))
                            {
                                <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch" title="Clear"
                                        disabled="@IsBusy">
                                    &times;
                                </button>
                            }
                            <button class="btn btn-outline-primary" type="button" @onclick="SearchUser"
                                    disabled="@(IsBusy || string.IsNullOrWhiteSpace(searchQuery))">
                                @if (isSearching)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                else
                                {
                                    <span>Find</span>
                                }
                            </button>
                        </div>
                    </div>
                    @* Docs/ModuleCsvExport-Plan.md S6: rendered only once the status view has
                       loaded rows - no control before then (the plan's failure-behavior table). *@
                    @if (migrationBatches is { Count: > 0 })
                    {
                        @* R29. Export says WHAT it exports. "Download CSV" was ambiguous the
                           moment a selection and a filter existed: all batches, the ticked ones,
                           or the open batch's mailboxes? It writes the batch list as currently
                           filtered and sorted, and the label and tooltip both say so. *@
                        <button class="btn btn-outline-secondary btn-sm" @onclick="DownloadCsvAsync" disabled="@IsBusy"
                                title="Writes the batch list exactly as filtered and sorted here - not the selection, and not any batch's mailboxes.">
                            Export batch list (@BatchTotalCount)
                        </button>
                    }
                    @* The standalone "Clear Completed" sweep was REMOVED (D6): it acted on every
                       completed batch in the table regardless of selection, and it sat beside
                       "Clear selection" sharing a word - one irreversible, one harmless. Its job is
                       now "Remove Completed" in the selection toolbar. *@
                    <div>
                        <button class="btn btn-sm btn-primary" @onclick="LoadMigrationStatus" disabled="@IsBusy">
                            @if (isLoadingStatus)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Refresh
                        </button>
                    </div>
                </div>

                @if (batchActionResult != null)
                {
                    <div class="alert alert-@(batchActionResult.Success ? "success" : "danger") alert-dismissible fade show">
                        @batchActionResult.Message
                        @if (!string.IsNullOrEmpty(batchActionResult.Detail))
                        {
                            <div class="mt-1"><small>@batchActionResult.Detail</small></div>
                        }
                        <button type="button" class="btn-close" @onclick="() => batchActionResult = null"></button>
                    </div>
                }

                @* The top-of-panes confirm bar, for pending actions that name no rendered row: the
                   bulk selection actions, whose target is "N batch(es)". A per-ROW action - batch
                   or mailbox - renders this same fragment beneath its own row instead; see
                   PendingActionNamesALoadedRow. *@
                @if (pendingActionLabel != null && !PendingActionNamesALoadedRow)
                {
                    @PendingActionConfirm
                }


                @if (isLoadingStatus)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2 text-muted">@(actionInProgress == "clearing" ? "Removing completed batches and reloading..." : "Loading migration batches...")</p>
                    </div>
                }
                else if (!batchesLoaded)
                {
                    <div class="text-center py-5">
                        <button class="btn btn-primary" @onclick="LoadMigrationStatus" disabled="@IsBusy">
                            Load Migration Batches
                        </button>
                    </div>
                }
                else if ((migrationBatches == null || !migrationBatches.Any()) && batchActionResult == null)
                {
                    @* R28. Three distinct empty states, and this is the first: no batches AT ALL.
                       The other two are "no batch matches the filter" (in the left pane, below)
                       and "no mailbox matches the filter" (in the right pane). One message for
                       all three would hide whether the filter or the data is the problem, and
                       the operator's next move differs in each case. *@
                    <div class="alert alert-info">
                        <strong>No migration batches found</strong>
                        <p class="mb-0 mt-2">There are currently no migration batches. Create one using the Single User Check or Bulk CSV Check tabs.</p>
                    </div>
                }
                else
                {
                    @* R1: batches left, the open batch's mailboxes right. Each pane owns its own
                       scroll region, so neither list can push the other's controls off the screen
                       (R11) and opening a batch no longer moves everything below it down the page. *@
                    <div class="mig-split">

                        <div class="mig-pane mig-pane-left">
                            <div class="mig-pane-head d-flex align-items-center gap-2">
                                @if (canManage)
                                {
                                    <input type="checkbox" class="form-check-input mt-0 flex-shrink-0"
                                           title="Select all loaded batches"
                                           checked="@AllBatchesSelected" @onchange="ToggleSelectAllBatches" />
                                }
                                @* R26. FILTERING batch names and FINDING a person are different
                                   controls doing different jobs, and conflating them is the defect.
                                   This narrows the list in place. The box above both panes searches
                                   every batch for a mailbox and takes the operator TO it - it does
                                   not narrow anything. Over the whole catalogue, never the rendered
                                   page (R21). *@
                                <input type="text" class="form-control form-control-sm" style="width: 11rem;"
                                       placeholder="Filter batch names"
                                       value="@batchFilter" @oninput="OnBatchFilterChanged"
                                       disabled="@IsBusy" />
                                @* ONE sort control, not clickable headers as well (R18, R19): two
                                   ways to set one value is the ambiguity R19 says to fix by
                                   structure. It carries all seven keys the old table header
                                   carried, so no sort is lost even though the row now shows the
                                   four columns R16 names. Sorting is over the whole set, never the
                                   rendered page (R21). *@
                                <label class="small text-muted mb-0 flex-shrink-0" for="batchSortColumn">Sort</label>
                                <select id="batchSortColumn" class="form-select form-select-sm"
                                        value="@batchSortColumn" @onchange="OnBatchSortColumnChanged" disabled="@IsBusy">
                                    <option value="Name">Batch name</option>
                                    <option value="Status">Status</option>
                                    <option value="Direction">Direction</option>
                                    <option value="Created">Created</option>
                                    <option value="Total">Total</option>
                                    <option value="Synced">Synced</option>
                                    <option value="Failed">Failed</option>
                                </select>
                                <button class="btn btn-sm btn-outline-secondary flex-shrink-0" type="button"
                                        disabled="@IsBusy" @onclick="ToggleBatchSortDirection"
                                        title="@(batchSortAsc ? "Ascending. Click for descending." : "Descending. Click for ascending.")">
                                    @((MarkupString)(batchSortAsc ? "&#x25B2;" : "&#x25BC;"))
                                </button>
                            </div>

                            @* R3 and R6: batch operations live in the batch pane, whether one batch
                               is ticked or eight hundred, and they sit at the TOP of the list they
                               act on rather than in a footer. This is where the per-row Complete,
                               Stop, Resume and Delete buttons went when R14 gave the row one line.
                               The buttons are enabled whenever anything is ticked and never
                               conditioned on eligibility: under owner ruling D2(a) a mixed or
                               wholly-ineligible selection has a defined, useful outcome, and
                               disabling would be the D2(b) that was rejected. Every one of them
                               stages a ticket and reads MigrationBatchActionPlanner for its
                               eligible/skipped split. *@
                            @if (canManage && selectedBatches.Count > 0)
                            {
                                <div class="mig-pane-actions d-flex align-items-center flex-wrap gap-1">
                                    <strong class="small me-1">@selectedBatches.Count selected</strong>
                                    @* The second sentence is the owner's, 2026-09-25. Operators were
                                       ticking a batch with failures, pressing Complete and seeing
                                       it skipped with no hint of what to do next. One line on the
                                       control, not a banner: the per-batch answer is already in
                                       the confirm step, which names every skipped batch with the
                                       status that skipped it. *@
                                    <button class="@BatchActionButtonClass(MigrationBatchAction.Complete, "success")" disabled="@(IsBusy || pendingActionLabel != null)"
                                            title="Completes selected batches that have finished syncing. A batch with errors cannot complete until they are fixed or removed."
                                            @onclick="StageCompleteSelected">
                                        Complete
                                    </button>
                                    <button class="@BatchActionButtonClass(MigrationBatchAction.Stop, "warning")" disabled="@(IsBusy || pendingActionLabel != null)"
                                            title="Stops the selected batches that are still moving"
                                            @onclick="StageStopSelected">
                                        Stop
                                    </button>
                                    <button class="@BatchActionButtonClass(MigrationBatchAction.Resume, "success")" disabled="@(IsBusy || pendingActionLabel != null)"
                                            title="Restarts the selected batches that are idle but restartable"
                                            @onclick="StageResumeSelected">
                                        Resume/Retry
                                    </button>
                                    <button class="@BatchActionButtonClass(MigrationBatchAction.RemoveCompleted, "danger")" disabled="@(IsBusy || pendingActionLabel != null)"
                                            title="Removes only the selected batches whose status is Completed"
                                            @onclick="StageRemoveCompletedSelected">
                                        Remove Completed
                                    </button>
                                    <button class="@BatchActionButtonClass(MigrationBatchAction.Delete, "danger")" disabled="@(IsBusy || pendingActionLabel != null)"
                                            title="Removes every selected batch, whatever its status"
                                            @onclick="StageDeleteSelected">
                                        Delete
                                    </button>
                                    @* R10. "Untick all" here, where the tick boxes are; the right
                                       pane says "Clear selection" for the same operation because
                                       there is nothing to untick there. Named "Untick", not
                                       "Clear ...": the word "Clear" beside two destructive buttons
                                       is the adjacency the owner rejected. *@
                                    <button class="btn btn-sm btn-outline-secondary ms-auto" disabled="@IsBusy"
                                            @onclick="ClearBatchSelection">
                                        Untick all
                                    </button>
                                </div>
                            }

                            <div class="mig-pane-scroll">
                                @* R16: the header row is inside the scrolling box, so the scrollbar
                                   narrows it by exactly as much as it narrows the rows. R17: every
                                   number below has a name here. *@
                                <div class="mig-batch-row mig-batch-head">
                                    <span></span>
                                    <span>Batch</span>
                                    <span>Status</span>
                                    <span class="mig-count">Synced</span>
                                    <span class="mig-count">Failed</span>
                                </div>

                                @* R28, the second of the three empty states: the catalogue has
                                   batches, this filter matches none of them. Distinct from "no
                                   batches at all", because the next move is to clear the filter
                                   rather than to go and find out why nothing exists. *@
                                @if (BatchTotalCount == 0)
                                {
                                    <p class="text-muted text-center my-4 px-3">
                                        No batch name matches <strong>@batchFilter</strong>.
                                    </p>
                                }

                                @foreach (var batch in GetPagedBatches())
                                {
                                    @* Captured per iteration: the lambdas below must close over
                                       THIS row's name. *@
                                    var batchName = batch.BatchName;
                                    <div class="mig-batch-row mig-clickable @(expandedBatch == batchName ? "mig-open" : "")"
                                         @onclick="() => SelectOnlyBatch(batchName)">
                                        @if (canManage)
                                        {
                                            @* stopPropagation: ticking a batch must not also open
                                               it. They are different acts until R9 merges them in
                                               S3, and merging them here by accident would be a
                                               behaviour change this slice is not allowed. *@
                                            <input type="checkbox" class="form-check-input mt-0"
                                                   title="Select for a bulk action"
                                                   checked="@IsBatchSelected(batchName)"
                                                   @onclick:stopPropagation="true"
                                                   @onchange="e => ToggleBatchSelected(batchName, e.Value is bool v && v)" />
                                        }
                                        else
                                        {
                                            <span></span>
                                        }
                                        <span class="mig-batch-name" title="@batchName">
                                            @batchName
                                            @* S4, R12. A per-row outcome written against every
                                               affected row, BEFORE the ticket is typed. Only rows
                                               in the staged plan are annotated: an unticked row is
                                               not part of this action and saying nothing about it
                                               is the honest answer. Rendered only while an action
                                               is staged, so the row is one clean line the rest of
                                               the time (R14). *@
                                            @{ var outcome = StagedOutcomeFor(batchName); }
                                            @if (outcome != null)
                                            {
                                                <span class="mig-outcome @(StagedOutcomeIsGo(batchName) ? "mig-outcome-go" : "mig-outcome-skip")">@outcome</span>
                                            }
                                            @* R25. What actually HAPPENED to this row, after the
                                               fact. Same surface as the preview above, because an
                                               operator should read the result where they read the
                                               prediction - and because the banner is for a glance,
                                               not for a log of refusal reasons. *@
                                            @{ var done = OutcomeFor(batchName); }
                                            @if (done != null)
                                            {
                                                <span class="mig-outcome @(OutcomeIsFailure(batchName) ? "mig-outcome-bad" : "mig-outcome-go")"
                                                      title="@done">@done</span>
                                            }
                                        </span>
                                        <span><span class="badge bg-@GetStatusColor(batch.Status)" title="@batch.Status">@batch.Status</span></span>
                                        <span class="mig-count text-success fw-bold">@batch.SyncedCount</span>
                                        <span class="mig-count">
                                            @if (batch.FailedCount > 0)
                                            {
                                                <span class="text-danger fw-bold">@batch.FailedCount</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">0</span>
                                            }
                                        </span>
                                    </div>
                                    @* The ticket field for THIS row's action, directly beneath it.
                                       It used to live above the table: with 50+ batches in flight,
                                       acting on a row near the bottom put the input off-screen
                                       while every button in the row went disabled, so the only
                                       visible feedback was that the buttons had stopped working. *@
                                    @if (pendingActionTarget == batchName && pendingActionLabel != null)
                                    {
                                        <div class="border-bottom px-3 py-2 bg-warning-subtle">
                                            @PendingActionConfirm
                                        </div>
                                    }
                                }
                            </div>

                            @* R20: the catalogue pages, and the pager states the whole size so the
                               operator can see that page 1 of 40 is not the whole story. Never a
                               footer for ACTIONS (R6) - this is a position indicator. *@
                            <div class="mig-pane-foot d-flex align-items-center gap-2">
                                <button class="btn btn-sm btn-outline-secondary" type="button"
                                        disabled="@(IsBusy || batchPage <= 0)"
                                        title="Previous page of batches" @onclick="() => StepBatchPage(-1)">
                                    @((MarkupString)"&lsaquo;")
                                </button>
                                <span class="small text-muted">@BatchPagerLabel</span>
                                <button class="btn btn-sm btn-outline-secondary" type="button"
                                        disabled="@(IsBusy || batchPage >= BatchPageCount - 1)"
                                        title="Next page of batches" @onclick="() => StepBatchPage(1)">
                                    @((MarkupString)"&rsaquo;")
                                </button>
                            </div>
                        </div>

                        <div class="mig-pane mig-pane-right">
                            @* R2. This pane is about the SELECTION. Exactly one ticked batch means
                               it is entirely and only that batch's mailboxes; more than one means
                               it lists exactly the ticked batches; none means nothing is chosen.
                               No batch-scoped OPERATION appears here in any of the three - those
                               live in the batch pane (R3), which is why there is no action bar
                               below. *@
                            @if (selectedBatches.Count > 1)
                            {
                                <div class="mig-pane-head d-flex align-items-center gap-2">
                                    <strong>@selectedBatches.Count batches selected</strong>
                                    @* R10. No tick boxes in this pane, so it never says "untick". *@
                                    <button class="btn btn-sm btn-outline-secondary ms-auto" disabled="@IsBusy"
                                            @onclick="ClearBatchSelection">
                                        Clear selection
                                    </button>
                                </div>

                                <div class="mig-pane-scroll">
                                    <div class="mig-batch-row mig-batch-head">
                                        <span></span>
                                        <span>Batch</span>
                                        <span>Status</span>
                                        <span class="mig-count">Synced</span>
                                        <span class="mig-count">Failed</span>
                                    </div>
                                    @foreach (var batch in GetSelectedBatchesPage())
                                    {
                                        var selectedName = batch.BatchName;
                                        <div class="mig-batch-row">
                                            @* R9. Open narrows the selection to this one batch, and
                                               the pane becomes its mailboxes. *@
                                            <button class="btn btn-link btn-sm p-0" disabled="@IsBusy"
                                                    title="Show only this batch" @onclick="() => SelectOnlyBatch(selectedName)">
                                                Open
                                            </button>
                                            <span class="mig-batch-name" title="@selectedName">@selectedName</span>
                                            <span><span class="badge bg-@GetStatusColor(batch.Status)">@batch.Status</span></span>
                                            <span class="mig-count text-success fw-bold">@batch.SyncedCount</span>
                                            <span class="mig-count">
                                                <button class="btn btn-link btn-sm p-0 text-danger" disabled="@IsBusy"
                                                        title="Remove this batch from the selection"
                                                        @onclick="() => RemoveFromSelection(selectedName)">
                                                    Remove
                                                </button>
                                            </span>
                                        </div>
                                    }
                                </div>

                                @* R4. Its own pager, labelled so it is unmistakable that it pages
                                   the selection and not the catalogue. R5b's reasoning applied to
                                   batches: the selection has to have a visible home of bounded
                                   size, or a select-all of 2000 renders 2000 rows here. *@
                                <div class="mig-pane-foot d-flex align-items-center gap-2">
                                    <button class="btn btn-sm btn-outline-secondary" type="button"
                                            disabled="@(IsBusy || selectionPage <= 0)"
                                            title="Previous page of selected batches" @onclick="() => StepSelectionPage(-1)">
                                        @((MarkupString)"&lsaquo;")
                                    </button>
                                    <span class="small text-muted">@SelectionPagerLabel</span>
                                    <button class="btn btn-sm btn-outline-secondary" type="button"
                                            disabled="@(IsBusy || selectionPage >= SelectionPageCount - 1)"
                                            title="Next page of selected batches" @onclick="() => StepSelectionPage(1)">
                                        @((MarkupString)"&rsaquo;")
                                    </button>
                                </div>
                            }
                            else if (expandedBatch == null)
                            {
                                <div class="mig-pane-head"><strong>Mailboxes</strong></div>
                                <div class="mig-pane-scroll d-flex align-items-center justify-content-center">
                                    <p class="text-muted my-5">Select a batch on the left to see its mailboxes.</p>
                                </div>
                            }
                            else
                            {
                                @* R2: this pane is about the selection. The batch's own identifying
                                   facts are here because they describe what you are looking at;
                                   batch OPERATIONS stay in the batch pane (R3). *@
                                var openBatch = migrationBatches?.FirstOrDefault(b => b.BatchName == expandedBatch);
                                <div class="mig-pane-head d-flex align-items-center gap-2 flex-wrap">
                                    <strong class="text-truncate" title="@expandedBatch">@expandedBatch</strong>
                                    @if (openBatch != null)
                                    {
                                        <span class="badge bg-@GetStatusColor(openBatch.Status)">@openBatch.Status</span>
                                        <span class="badge bg-secondary">@openBatch.Direction</span>
                                        <small class="text-muted">
                                            <strong>Total:</strong> @openBatch.TotalCount
                                            <span class="ms-2"><strong>Created:</strong> @openBatch.CreatedDateTime.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span>
                                            @if (openBatch.StartDateTime.HasValue)
                                            {
                                                <span class="ms-2"><strong>Started:</strong> @openBatch.StartDateTime.Value.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span>
                                            }
                                            @if (openBatch.CompletedDateTime.HasValue)
                                            {
                                                <span class="ms-2"><strong>Completed:</strong> @openBatch.CompletedDateTime.Value.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span>
                                            }
                                        </small>
                                    }
                                    @* R30: refreshing this pane's mailboxes is a different act from
                                       refreshing the batch catalogue, and each button does only
                                       its own. *@
                                    <button class="btn btn-sm btn-outline-secondary ms-auto flex-shrink-0"
                                            title="Refresh these mailboxes" disabled="@IsBusy"
                                            @onclick="() => RefreshBatchUsers(expandedBatch!)">
                                        @if (loadingBatchUsers == expandedBatch)
                                        {
                                            <span class="spinner-border spinner-border-sm"></span>
                                        }
                                        else
                                        {
                                            @((MarkupString)"&#x21bb;")
                                        }
                                    </button>
                                </div>

                                @* R21. Filter and sort over the WHOLE set, never the rendered page.
                                   The mailbox table had neither before S5; the batch table had sort
                                   only. Same shape as the batch pane's controls so the two panes do
                                   not teach different habits. *@
                                @* R12. The mailbox action bar, identical in look and behaviour to
                                   the batch bar: outline buttons with the picked one filled, a
                                   ticket required, Confirm carrying the eligible count, and every
                                   ineligible row named as skipped with nothing sent for it. It
                                   reaches MigrationUserActionPlanner exactly as the batch bar
                                   reaches its own planner. R6: at the top of the list it acts on. *@
                                @if (canManage && selectedMailboxes.Count > 0)
                                {
                                    <div class="mig-pane-actions d-flex align-items-center flex-wrap gap-1">
                                        <strong class="small me-1">@selectedMailboxes.Count selected</strong>
                                        <button class="@MailboxActionButtonClass(MigrationUserAction.Complete, "success")"
                                                disabled="@(IsBusy || pendingActionLabel != null)"
                                                title="Completes the selected mailboxes that have finished syncing"
                                                @onclick="StageCompleteMailboxes">
                                            Complete
                                        </button>
                                        <button class="@MailboxActionButtonClass(MigrationUserAction.Approve, "warning")"
                                                disabled="@(IsBusy || pendingActionLabel != null)"
                                                title="Approves the selected mailboxes that are waiting for it"
                                                @onclick="StageApproveMailboxes">
                                            Approve
                                        </button>
                                        <button class="@MailboxActionButtonClass(MigrationUserAction.Pause, "warning")"
                                                disabled="@(IsBusy || pendingActionLabel != null)"
                                                title="Stops the selected mailboxes that are still moving"
                                                @onclick="StagePauseMailboxes">
                                            Pause
                                        </button>
                                        <button class="@MailboxActionButtonClass(MigrationUserAction.Resume, "success")"
                                                disabled="@(IsBusy || pendingActionLabel != null)"
                                                title="Restarts the selected mailboxes that are stopped or failed"
                                                @onclick="StageResumeMailboxes">
                                            Resume
                                        </button>
                                        <button class="@MailboxActionButtonClass(MigrationUserAction.Clear, "danger")"
                                                disabled="@(IsBusy || pendingActionLabel != null)"
                                                title="Removes the selected mailboxes that have completed from the batch"
                                                @onclick="StageRemoveMailboxes">
                                            Remove
                                        </button>
                                        @* R10. "Untick all" here, where the tick boxes are. *@
                                        <button class="btn btn-sm btn-outline-secondary ms-auto" disabled="@IsBusy"
                                                @onclick="ClearMailboxSelection">
                                            Untick all
                                        </button>
                                    </div>
                                }

                                @if (batchUsers is { Count: > 0 })
                                {
                                    <div class="mig-pane-actions d-flex align-items-center gap-2 flex-wrap">
                                        @if (canManage)
                                        {
                                            <input type="checkbox" class="form-check-input mt-0 flex-shrink-0"
                                                   title="Tick every mailbox matching the filter, not just this page"
                                                   checked="@AllMailboxesSelected"
                                                   @onchange="ToggleSelectAllMailboxes" />
                                        }
                                        <input type="text" class="form-control form-control-sm" style="width: 14rem;"
                                               placeholder="Filter these mailboxes"
                                               value="@mailboxFilter" @oninput="OnMailboxFilterChanged"
                                               disabled="@IsBusy" />
                                        <label class="small text-muted mb-0 flex-shrink-0" for="mailboxSortColumn">Sort</label>
                                        <select id="mailboxSortColumn" class="form-select form-select-sm" style="width: 9rem;"
                                                value="@mailboxSortColumn" @onchange="OnMailboxSortColumnChanged"
                                                disabled="@IsBusy">
                                            <option value="Email">Email</option>
                                            <option value="Status">Status</option>
                                            <option value="Synced">Synced</option>
                                            <option value="LastSync">Last sync</option>
                                        </select>
                                        <button class="btn btn-sm btn-outline-secondary flex-shrink-0" type="button"
                                                disabled="@IsBusy" @onclick="ToggleMailboxSortDirection"
                                                title="@(mailboxSortAsc ? "Ascending. Click for descending." : "Descending. Click for ascending.")">
                                            @((MarkupString)(mailboxSortAsc ? "&#x25B2;" : "&#x25BC;"))
                                        </button>
                                    </div>
                                }

                                <div class="mig-pane-scroll">
                                    @if (loadingBatchUsers == expandedBatch && batchUsers == null)
                                    {
                                        @* R27: the pane that is loading says so, rather than the
                                           whole page freezing. *@
                                        <div class="text-center py-5">
                                            <div class="spinner-border text-primary" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                            <p class="mt-2 text-muted">Loading mailboxes...</p>
                                        </div>
                                    }
                                    else if (batchUsers == null)
                                    {
                                        <p class="text-muted text-center my-5">No mailbox details available.</p>
                                    }
                                    else if (!batchUsers.Any())
                                    {
                                        <p class="text-muted text-center my-5">This batch contains no mailboxes.</p>
                                    }
                                    else if (MailboxTotalCount == 0)
                                    {
                                        @* R28. Distinct empty states. "No mailbox matches the
                                           filter" and "this batch has no mailboxes" are different
                                           facts, and one message for both hides whether the filter
                                           or the data is the problem. *@
                                        <p class="text-muted text-center my-5">
                                            No mailbox in this batch matches <strong>@mailboxFilter</strong>.
                                        </p>
                                    }
                                    else
                                    {
                                        <table class="table table-sm table-hover mig-mailboxes mb-0">
                                            <thead>
                                                <tr>
                                                    @if (canManage)
                                                    {
                                                        <th style="width: 2.5rem;"></th>
                                                    }
                                                    <th>Email</th>
                                                    <th>Status</th>
                                                    <th>Synced</th>
                                                    <th>Last Sync</th>
                                                    <th>Error</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @* R5a. Ticked mailboxes are PINNED above an
                                                   "OTHER MAILBOXES" divider. R5 forbids this for
                                                   batches because the selection has its own pane
                                                   there; mailboxes have no second surface, so
                                                   pinning is how R11 is met for them - a ticked
                                                   mailbox is never hidden by the filter or by a
                                                   page change. *@
                                                @if (selectedMailboxes.Count > 0)
                                                {
                                                    foreach (var user in GetPinnedMailboxesPage())
                                                    {
                                                        @MailboxRow(user)
                                                    }

                                                    @* R5b. The pinned block pages too, or ticking
                                                       2000 mailboxes pins 2000 rows and the
                                                       Defender failure is back. *@
                                                    <tr class="mig-divider">
                                                        <td colspan="7">
                                                            <div class="d-flex align-items-center gap-2">
                                                                <button class="btn btn-sm btn-outline-secondary py-0" type="button"
                                                                        disabled="@(IsBusy || pinnedMailboxPage <= 0)"
                                                                        title="Previous page of ticked mailboxes"
                                                                        @onclick="() => StepPinnedMailboxPage(-1)">
                                                                    @((MarkupString)"&lsaquo;")
                                                                </button>
                                                                <span>@PinnedMailboxPagerLabel</span>
                                                                <button class="btn btn-sm btn-outline-secondary py-0" type="button"
                                                                        disabled="@(IsBusy || pinnedMailboxPage >= PinnedMailboxPageCount - 1)"
                                                                        title="Next page of ticked mailboxes"
                                                                        @onclick="() => StepPinnedMailboxPage(1)">
                                                                    @((MarkupString)"&rsaquo;")
                                                                </button>
                                                                <span class="ms-auto">OTHER MAILBOXES</span>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }

                                                @foreach (var user in GetPagedMailboxes())
                                                {
                                                    @MailboxRow(user)
                                                }
                                            </tbody>
                                        </table>
                                    }
                                </div>

                                @* R20. The mailbox list pages too. 2000 mailboxes in a batch is the
                                   magnitude the plan names, and Blazor Server pushes a render diff
                                   per row over the circuit - rendering all of them is how the
                                   Defender page died. Same ListWindow as the two batch lists, so
                                   the off-by-one exists once. *@
                                @if (batchUsers is { Count: > 0 } && MailboxTotalCount > 0)
                                {
                                    <div class="mig-pane-foot d-flex align-items-center gap-2">
                                        <button class="btn btn-sm btn-outline-secondary" type="button"
                                                disabled="@(IsBusy || mailboxPage <= 0)"
                                                title="Previous page of mailboxes" @onclick="() => StepMailboxPage(-1)">
                                            @((MarkupString)"&lsaquo;")
                                        </button>
                                        <span class="small text-muted">@MailboxPagerLabel</span>
                                        <button class="btn btn-sm btn-outline-secondary" type="button"
                                                disabled="@(IsBusy || mailboxPage >= MailboxPageCount - 1)"
                                                title="Next page of mailboxes" @onclick="() => StepMailboxPage(1)">
                                            @((MarkupString)"&rsaquo;")
                                        </button>
                                    </div>
                                }
                            }
                        </div>

                    </div>
                }
            </div>
        </div>
    }
</div>

@* R24. The per-mailbox report is a MODAL DIALOG with an Export button. A drill-down, a panel
   under the table, a third pane and a new tab were each rejected by the owner (2026-09-24), and
   the drawer under the row that production used until S6 is out: it replaced the mailbox table's
   own space and pushed every row below it down the page.

   Rendered OUTSIDE the two panes, at the end of the page, so it cannot be clipped by a pane's
   scroll region or hidden behind it. It carries the mailbox's status and its row action in the
   header, so the operator can act on what the report says without dismissing it first.

   Only Close dismisses it - no backdrop click, no Escape. The report may have cost twenty
   minutes and the operator is reading it; a stray click outside must not be able to take it
   away. It survives the dismiss anyway (R24a), but the interruption is the cost. *@
@if (reportUser != null && userReport != null)
{
    var reportRow = batchUsers?.FirstOrDefault(u =>
        string.Equals(u.EmailAddress, reportUser, StringComparison.OrdinalIgnoreCase));

    <div class="mig-modal-backdrop">
        <div class="mig-modal card shadow">
            <div class="card-header d-flex align-items-center gap-2 flex-wrap">
                <strong class="text-truncate" title="@reportUser">@reportUser</strong>
                @if (reportRow != null)
                {
                    <span class="badge bg-@GetUserStatusColor(reportRow.Status)">@reportRow.Status</span>
                }
                @if (reportFetchedAtUtc.HasValue)
                {
                    @* R24a: the operator has to be able to tell how old this is before deciding
                       whether another twenty minutes is worth it. *@
                    <small class="text-muted">
                        Taken @reportFetchedAtUtc.Value.ToLocalTime().ToString("MMM dd HH:mm")
                    </small>
                }
                <div class="ms-auto d-flex gap-2">
                    @* Export writes the whole report to a file rather than making anyone select
                       tens of thousands of lines out of a scroll box. *@
                    <button class="btn btn-sm btn-outline-secondary" disabled="@IsBusy"
                            @onclick="ExportOpenReportAsync">Export</button>
                    @if (reportFetchedAtUtc.HasValue)
                    {
                        <button class="btn btn-sm btn-outline-warning" disabled="@IsBusy"
                                title="Runs Get-MigrationUserStatistics again. On a long or problematic migration this can take twenty minutes or more."
                                @onclick="() => RefetchUserReport(reportUser)">
                            @if (loadingReport == reportUser)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            else
                            {
                                <span>Fetch again</span>
                            }
                        </button>
                    }
                    <button class="btn btn-sm btn-secondary" @onclick="DismissReportModal">Close</button>
                </div>
            </div>
            <div class="card-body p-0">
                <pre class="mig-report-text mb-0">@userReport</pre>
            </div>
        </div>
    </div>
}

@code {

    // R12 and the repo's own lesson about two copies of one control: the mailbox row is defined
    // ONCE and rendered in two places - the pinned block above the divider (R5a) and the list
    // below it. Two copies would drift, and the row carries the tick box, five gated actions, the
    // per-row ticket confirmation and the report drawer.
    private RenderFragment<MigrationUserInfo> MailboxRow => user =>
    @<text>
    <tr class="@(highlightedUser != null && user.EmailAddress.Contains(highlightedUser, StringComparison.OrdinalIgnoreCase) ? "table-warning" : "")">
        @if (canManage)
        {
            @* R7. Checkboxes on mailboxes as well as batches. Keyed on the address, never a row
               index: this table now filters, sorts and pages, so an index would retarget to
               whoever occupies that position after the next keystroke. *@
            <td style="width: 2.5rem;">
                <input type="checkbox" class="form-check-input" title="Select for a bulk action"
                       checked="@IsMailboxSelected(user.EmailAddress)"
                       @onchange="e => ToggleMailboxSelected(user.EmailAddress, e.Value is bool v && v)" />
            </td>
        }
        <td>
            @user.EmailAddress
            @* S4's outcome preview, applied to the mailbox bar (R12). *@
            @{ var mailboxOutcome = StagedMailboxOutcomeFor(user.EmailAddress); }
            @if (mailboxOutcome != null)
            {
                <span class="mig-outcome @(StagedMailboxOutcomeIsGo(user.EmailAddress) ? "mig-outcome-go" : "mig-outcome-skip")">@mailboxOutcome</span>
            }
            @* R25, the mailbox half. *@
            @{ var mailboxDone = OutcomeFor(user.EmailAddress); }
            @if (mailboxDone != null)
            {
                <span class="mig-outcome @(OutcomeIsFailure(user.EmailAddress) ? "mig-outcome-bad" : "mig-outcome-go")"
                      title="@mailboxDone">@mailboxDone</span>
            }
        </td>
        <td><span class="badge bg-@GetUserStatusColor(user.Status)">@user.Status</span></td>
        <td>@user.ItemsSynced.ToString("N0")</td>
        <td><small>@(user.LastSyncDateTime?.ToLocalTime().ToString("MMM dd HH:mm") ?? "-")</small></td>
        <td>
            @if (!string.IsNullOrEmpty(user.ErrorSummary))
            {
                <small class="text-danger">@user.ErrorSummary</small>
            }
            else
            {
                <small class="text-muted">-</small>
            }
        </td>
        <td class="text-end text-nowrap">
            @{ var s = user.Status; var e = user.EmailAddress; }
            @if (canManage)
            {
                @if (s.Equals("Synced", StringComparison.OrdinalIgnoreCase))
                {
                    <button class="btn btn-sm btn-success me-1" disabled="@(IsBusy || pendingActionLabel != null)"
                            @onclick="() => CompleteUser(e)">Complete</button>
                }
                @if (s.Equals("NeedsApproval", StringComparison.OrdinalIgnoreCase))
                {
                    <button class="btn btn-sm btn-warning me-1" disabled="@(IsBusy || pendingActionLabel != null)"
                            @onclick="() => ApproveUser(e)">Approve</button>
                }
                @if (s.Equals("Syncing", StringComparison.OrdinalIgnoreCase))
                {
                    <button class="btn btn-sm btn-outline-warning me-1" disabled="@(IsBusy || pendingActionLabel != null)"
                            @onclick="() => PauseUser(e)">Pause</button>
                }
                @if (s.Equals("Stopped", StringComparison.OrdinalIgnoreCase)
                    || s.Equals("Failed", StringComparison.OrdinalIgnoreCase))
                {
                    <button class="btn btn-sm btn-primary me-1" disabled="@(IsBusy || pendingActionLabel != null)"
                            @onclick="() => ResumeUser(e)">Resume</button>
                }
                @if (s.Equals("Completed", StringComparison.OrdinalIgnoreCase))
                {
                    <button class="btn btn-sm btn-outline-secondary me-1" disabled="@(IsBusy || pendingActionLabel != null)"
                            @onclick="() => ClearUser(e)">Clear</button>
                }
            }
            @* Report is offered on EVERY user row. It was gated on Failed /
               NeedsApproval / a non-empty ErrorSummary, so it appeared only on rows
               that already looked broken - and a CompletedWithErrors user, whose
               report is the one worth reading, often matched none of those. It is a
               read-only diagnostic: nothing is gained by hiding it, and the third
               status allowlist on this page to hide something the operator wanted. *@
            <button class="btn btn-sm btn-outline-danger"
                    disabled="@IsBusy"
                    @onclick="() => LoadUserReport(e)">
                @if (loadingReport == e)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                }
                else
                {
                    <span>Report</span>
                }
            </button>
            @if (actionInProgress == e)
            {
                <span class="spinner-border spinner-border-sm ms-1"></span>
            }
        </td>
    </tr>
    @* The ticket field for THIS mailbox's action, beneath its row - the
       same placement the batch rows get. Missing until mbs-1, which left
       every per-user action prompting at the top of the OUTER table. *@
    @if (pendingActionTarget == user.EmailAddress && pendingActionLabel != null)
    {
        <tr class="table-warning">
            <td colspan="@(canManage ? 7 : 6)" class="py-2">
                @PendingActionConfirm
            </td>
        </tr>
    }
    </text>;

    // The ticket-entry confirmation, defined once and rendered in one of two places: beneath the
    // row whose button was clicked, or above the table for an action that names no single row. Two
    // copies would drift, and this is the control the operator has to find.
    private RenderFragment PendingActionConfirm =>
    @<div class="d-flex align-items-center gap-2 flex-wrap">
        <strong>@pendingActionLabel</strong> <span class="text-muted">@pendingActionTarget</span>
        <div class="input-group input-group-sm" style="width: 220px;">
            <input type="text" class="form-control" placeholder="Ticket # (required)"
                   @bind="pendingActionTicket" @bind:event="oninput"
                   @onkeydown="HandleConfirmKeyDown" disabled="@IsBusy" />
        </div>
        <button class="btn btn-sm btn-primary" @onclick="ConfirmPendingAction"
                disabled="@(IsBusy || string.IsNullOrWhiteSpace(pendingActionTicket))">
            @if (actionInProgress != null)
            {
                <span class="spinner-border spinner-border-sm"></span>
            }
            else if (pendingActionPlan != null)
            {
                @* R12: Confirm carries the eligible count, so the number the operator agrees to is
                   on the button they press rather than somewhere above it. It counts the ELIGIBLE
                   rows, not the ticked ones - agreeing to "12 batches" and having 3 run is the
                   surprise this removes. *@
                <span>Confirm @pendingActionPlan.Eligible.Count batch@(pendingActionPlan.Eligible.Count == 1 ? "" : "es")</span>
            }
            else
            {
                <span>Confirm</span>
            }
        </button>
        @if (pendingActionPlan is { Skipped.Count: > 0 })
        {
            @* R12: ineligible rows are listed as skipped and nothing is sent for them. Named
               individually, because a bare count cannot be acted on - the operator needs to know
               WHICH batch and why before deciding whether to go ahead. *@
            <span class="text-muted small">@MigrationBatchActionPlanner.DescribeSkipped(pendingActionPlan.Skipped).Trim()</span>
        }
        <button class="btn btn-sm btn-outline-secondary" @onclick="CancelPendingAction"
                disabled="@(actionInProgress != null)">Cancel</button>
    </div>;

    private int tabIndex = 0;
    private bool isLoading = false;
    private bool isCreating = false;
    private bool canCreate = false;
    private bool canManage = false;
    private string currentUser = "Unknown";
    private string clientIpAddress = "Unknown";

    // Single check
    private string singleEmail = "";
    private MigrationEligibilityResult? singleResult;
    private MigrationDirection singleMigrationDirection = MigrationDirection.ToCloud;
    private string singleBatchName = "";
    private string singleTicketNumber = "";
    private bool singleAutoStart = false;
    private bool singleAutoComplete = false;
    private PermissionResult? singleCreateResult;

    // Bulk check
    private IBrowserFile? csvFile;
    private MigrationBatchResult? bulkResult;
    private MigrationDirection migrationDirection = MigrationDirection.ToCloud;
    private string bulkBatchName = "";
    private string bulkTicketNumber = "";
    private bool bulkAutoStart = false;
    private bool bulkAutoComplete = false;
    private PermissionResult? createResult;

    // Migration status
    private List<MigrationBatchInfo>? migrationBatches;
    private bool isLoadingStatus = false;
    private bool batchesLoaded = false;
    private bool accessDenied = false;
    // The open batch is addressable: it lives in the URL as ?batch=<name>, so browser Back, a
    // refresh and a circuit reconnect restore it instead of silently collapsing the page.
    //
    // A QUERY PARAMETER, never a path segment. Components/Shared/ModuleVersion.razor and
    // Components/Layout/UsageTracker.razor both identify the running module with
    // Catalog.GetByRoute() over the path with the query string cut off, and this module's route
    // is the exact string "migration" (Modules/ModuleCatalog.cs). A /migration/batch/<name> form
    // would stop resolving and would silently kill the version badge and the usage telemetry.
    // A query parameter also keeps operator-supplied batch names out of the path, where they
    // would need encoding rules of their own.
    private const string BatchQueryParameter = "batch";

    [SupplyParameterFromQuery(Name = BatchQueryParameter)]
    public string? OpenBatchParameter { get; set; }

    // Mirrors the query parameter above, and is what the markup renders against. Exactly two
    // places may write it: OpenBatch, which moves the address in the same breath, and
    // SyncOpenBatchFromUrl, which adopts an address the operator moved. Assigning it anywhere
    // else puts the page and the URL out of step, and the URL is the one that survives a
    // reconnect; a test enforces that no such assignment exists.
    private string? expandedBatch;

    // mir-1. Bumped by both writers of expandedBatch above, so it counts changes of open batch.
    // A batch-user load captures it before its await and ReplaceBatchUsers refuses any result whose
    // capture has since been overtaken.
    //
    // The race this closes exists because S1 made the URL an entry point. Before that, every way
    // into a batch-user load was a control carrying disabled="@IsBusy", so two loads could not
    // overlap; the browser's Back button is not a control this page can disable. Open A, open B,
    // press Back before B's Exchange call returns, and B's result would otherwise land on top of A.
    //
    // Distinct from reportGeneration, which counts discards of the REPORT. The two are bumped by
    // overlapping but not identical events - ReplaceBatchUsers bumps the report generation without
    // changing the open batch - so sharing one counter would make every row refresh look like a
    // batch change.
    private int batchUsersGeneration;
    private List<MigrationUserInfo>? batchUsers;
    private string? loadingBatchUsers;
    private string? actionInProgress;
    private string? loadingReport;
    private string? reportUser;
    private string? userReport;

    // R24a. When the report on screen was taken, so the dialog can say so and the operator can
    // judge whether refreshing is worth twenty minutes. Null for an error, which is not a report.
    private DateTime? reportFetchedAtUtc;
    // Bumped on every close. An in-flight LoadUserReport captures the value it started under and
    // drops its result if the generation has moved on, so a slow fetch cannot repopulate a panel
    // that a reload just cleared.
    private int reportGeneration;
    private PermissionResult? batchActionResult;
    private string searchQuery = "";
    private bool isSearching = false;
    private string? highlightedUser;
    private string batchSortColumn = "Created";
    private bool batchSortAsc = false;

    // R20. Zero-based page into the SORTED catalogue. 40 rows matches the size the owner settled
    // against the mockup; the pane is sized so a full page fills it without the window scrolling.
    private const int BatchPageSize = 40;
    private int batchPage;

    // R26. The batch-NAME filter, which is not the person search above both panes. That one finds
    // a mailbox in any batch and takes the operator to it; this narrows what the left pane lists.
    // Both must exist, and conflating them was the defect.
    private string batchFilter = "";

    // R4. The selection pane's own page, independent of the catalogue's: paging the list you are
    // choosing from and paging what you have chosen are different movements, and sharing one index
    // would jump the other pane every time.
    private const int SelectionPageSize = 40;
    private int selectionPage;

    // S5, R21. The mailbox table had no filter and no sort at all before this slice, and no paging
    // - so a 2000-mailbox batch rendered 2000 rows, which is the Defender hazard R20 names. 50 a
    // page matches the size the owner settled against the mockup. Its own page index for the same
    // reason the selection pane has one: these are three different lists.
    private const int MailboxPageSize = 50;
    private int mailboxPage;
    private string mailboxFilter = "";
    private string mailboxSortColumn = "Email";
    private bool mailboxSortAsc = true;

    // R7. Checkboxes on mailboxes as well as batches. Keyed on the address, NEVER a row index: the
    // table now filters, sorts and pages, so an index-keyed selection retargets to whoever happens
    // to occupy that position after the next keystroke. Same rule, and the same reason, as
    // selectedBatches.
    private readonly HashSet<string> selectedMailboxes = new(StringComparer.OrdinalIgnoreCase);

    // R5b. The pinned block's own page, separate from the list below it.
    private const int PinnedMailboxPageSize = 40;
    private int pinnedMailboxPage;
    // Download CSV had no flag of its own. Without one the predicate below cannot see the
    // JS interop round-trip, and every other control stays live while the file is built.
    private bool isDownloadingCsv = false;

    // True whenever an async operation is running whose result could invalidate, or be
    // invalidated by, another click. Every control on this page consults it, so a click is
    // never accepted unless it will definitively execute.
    //
    // pendingActionLabel is deliberately NOT here. It means "waiting for the operator to type
    // a ticket", not "busy": including it would disable the Confirm button at the only moment
    // it is ever rendered, and no destructive action could be executed again. The per-button
    // pendingActionLabel conditions already stop other actions from being staged on top of a
    // staged one, and they stay.
    private bool IsBusy =>
        isLoading || isCreating || isLoadingStatus || isSearching
        || loadingBatchUsers != null || actionInProgress != null
        || loadingReport != null || isDownloadingCsv;

    // Per-action ticket confirmation
    private string pendingActionTicket = "";
    private string? pendingActionLabel;
    private string? pendingActionTarget;
    private Func<string, Task>? pendingActionCallback;

    // S4. The outcome preview: which action is staged, and the eligible/skipped split it will act
    // on. Both are null unless a SELECTION action is staged - a per-mailbox action annotates no
    // batch row.
    //
    // A PREVIEW, never the authority. The callback re-plans at execution time because the operator
    // can sit at the ticket field indefinitely while the table reloads underneath them; this pair
    // exists so they can see the split before typing, which is Known Failure Class 2 (success
    // aggregation) answered before the fact rather than only after it.
    //
    // Excluded from IsBusy for the same reason pendingActionLabel is: they mean "waiting for a
    // ticket", not "busy", and folding them in would disable Confirm at the only moment it is
    // rendered.
    private MigrationBatchAction? pendingBatchAction;
    private MigrationBatchActionPlan? pendingActionPlan;

    // S5 step 2b. The mailbox twins. Separate rather than a shared abstraction because the two
    // planners key on different things - a batch name and an address - and one nullable pair that
    // could hold either would make "which list is this preview about" a runtime question on a page
    // that renders both lists at once.
    private MigrationUserAction? pendingUserAction;
    private MigrationUserActionPlan? pendingUserActionPlan;

    // R25. What happened to each row, keyed by batch name or mailbox address.
    //
    // A BANNER IS FOR A GLANCE, NOT A LOG. The result used to be one alert carrying every refusal
    // reason and every skipped row joined with semicolons - over fifty batches that is an error
    // log wedged into an alert box, unreadable at the moment the operator most needs to read it.
    // Owner, 2026-09-28: "banners are for quick, 10ft info, not for error logs."
    //
    // So the banner states counts and the DETAIL lives on the rows, which is what R25 asks for and
    // is the same surface S4's preview uses before the action. The operator reads one line, then
    // looks at the rows that are marked.
    private readonly Dictionary<string, string> actionOutcomes = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> actionFailures = new(StringComparer.OrdinalIgnoreCase);

    private void ClearActionOutcomes()
    {
        actionOutcomes.Clear();
        actionFailures.Clear();
    }

    private string? OutcomeFor(string key) => actionOutcomes.GetValueOrDefault(key);

    private bool OutcomeIsFailure(string key) => actionFailures.Contains(key);

    // Bulk selection on the batches table. Keyed on BatchName, NEVER row index: the table
    // re-sorts on every header click and reloads after every action, so an index-keyed
    // selection silently retargets to whatever now occupies that position.
    private readonly HashSet<string> selectedBatches = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUser = user.Identity?.Name ?? "Unknown";

        var authResult = await AuthorizationService.AuthorizeAsync(user, "MigrationCheck");
        if (!authResult.Succeeded)
        {
            // Latched before the bounce, not inferred from it. The bounce is a full-page load, so
            // this component still finishes its lifecycle here, and OnParametersSetAsync runs
            // immediately afterwards - a ?batch= in the address would otherwise send an
            // unauthorized visitor's request straight to Exchange on the way out.
            accessDenied = true;
            Navigation.NavigateTo("access-denied", forceLoad: true);
            return;
        }

        canCreate = (await AuthorizationService.AuthorizeAsync(user, "MigrationCreate")).Succeeded;
        canManage = (await AuthorizationService.AuthorizeAsync(user, "MigrationManage")).Succeeded;

        // Try scoped instance first, then fall back to cached value
        clientIpAddress = ClientInfo.IpAddress != "Unknown"
            ? ClientInfo.IpAddress
            : ClientInfo.GetIpForUser(currentUser);
    }

    // Deliberately a one-line delegation with no logic of its own. Everything it does happens in
    // a private method so the in-flight-flag sweeps in MigrationStatusPageTests, which attribute
    // a setter to the nearest enclosing PRIVATE signature, read the right method body.
    protected override Task OnParametersSetAsync() => SyncOpenBatchFromUrl();

    // The outbound half of the address, and under R9 the only place the open batch is decided.
    //
    // R9 collapses two concepts into one: there is no "open" state beside the selection. The open
    // batch IS the selection when the selection has exactly one member, and nothing otherwise
    // (R2) - so every control that changes the selection ends here rather than setting the open
    // batch itself, and the two can no longer disagree about which batch the operator is looking
    // at. Changing it is a navigation, so the URL moves with it; the URI guard keeps a no-op
    // change from stacking a history entry the operator would have to press Back through twice.
    private async Task AdoptSelectionAsOpenBatch()
    {
        var open = selectedBatches.Count == 1 ? selectedBatches.First() : null;
        if (string.Equals(open, expandedBatch, StringComparison.Ordinal))
            return;

        expandedBatch = open;
        batchUsersGeneration++;
        batchUsers = null;
        InvalidateStoredReports();

        // S5. A different batch is a different list. Carrying the previous batch's filter over
        // would show "no mailbox matches" for a batch the operator has only just opened, and
        // carrying its page would open them at row 350 of a batch with 40 rows.
        mailboxFilter = "";
        ResetMailboxPage();

        var uri = Navigation.GetUriWithQueryParameter(BatchQueryParameter, open);
        if (!string.Equals(uri, Navigation.Uri, StringComparison.Ordinal))
            Navigation.NavigateTo(uri);

        if (open != null)
            await LoadMailboxesFor(open);
    }

    // Every batch-user load goes through here, so the mir-1 guard exists once instead of once per
    // caller. The generation is captured before the await and handed to ReplaceBatchUsers, which
    // discards a result whose open batch has moved on; the flag is cleared only if this load still
    // owns it, so a superseded load does not un-busy the page while its successor runs.
    private async Task LoadMailboxesFor(string batchName)
    {
        loadingBatchUsers = batchName;
        var generation = batchUsersGeneration;

        try
        {
            ReplaceBatchUsers(generation, await MigrationSvc.GetMigrationBatchUsersAsync(batchName));
        }
        catch
        {
            ReplaceBatchUsers(generation, new List<MigrationUserInfo>());
        }
        finally
        {
            if (loadingBatchUsers == batchName)
                loadingBatchUsers = null;
        }
    }

    // The inbound half. Browser Back, a refresh, a circuit reconnect and a pasted link all arrive
    // here with the address already changed and, in the last three cases, no component state at
    // all. An operator click reaches this too, because AdoptSelectionAsOpenBatch navigates - but
    // that method has already put expandedBatch in step, so those re-entries fall out at the
    // equality check and nothing is fetched twice.
    private async Task SyncOpenBatchFromUrl()
    {
        // Prerendering runs a whole lifecycle on the server before the circuit exists, and the
        // interactive render then runs it again on a fresh instance. Without this the batch named
        // in a pasted link would be pulled from Exchange twice and the first result discarded.
        if (!RendererInfo.IsInteractive || accessDenied)
            return;

        var requested = string.IsNullOrWhiteSpace(OpenBatchParameter) ? null : OpenBatchParameter.Trim();
        if (string.Equals(requested, expandedBatch, StringComparison.Ordinal))
            return;

        expandedBatch = requested;
        batchUsersGeneration++;
        batchUsers = null;
        InvalidateStoredReports();

        // R9: the address names the SELECTION, not a second concept sitting beside it. Without
        // this, pressing Back would move the pane to another batch while the tick boxes still
        // showed the old one, which is exactly the tick-versus-open confusion R9 abolishes.
        selectedBatches.Clear();
        if (requested != null)
            selectedBatches.Add(requested);

        if (requested == null)
            return;

        // Set before the first await - see CreateSingleMigrationBatch for why - and it covers the
        // batch-list load below as well, because a pasted link lands with no list behind it.
        loadingBatchUsers = requested;
        var generation = batchUsersGeneration;

        try
        {
            if (!batchesLoaded)
                await LoadBatchList();

            ReplaceBatchUsers(generation, await MigrationSvc.GetMigrationBatchUsersAsync(requested));
        }
        catch
        {
            ReplaceBatchUsers(generation, new List<MigrationUserInfo>());
        }
        finally
        {
            if (loadingBatchUsers == requested)
                loadingBatchUsers = null;
        }
    }

    private async Task CheckSingleEligibility()
    {
        if (string.IsNullOrWhiteSpace(singleEmail))
            return;

        isLoading = true;
        singleResult = null;
        singleCreateResult = null;
        await Task.Yield();

        try
        {
            singleResult = await MigrationSvc.CheckMigrationEligibilityAsync(singleEmail.Trim(), singleMigrationDirection);

            var ipAddress = clientIpAddress;

            var checkDetail = singleResult.IneligibilityReasons.Any()
                ? string.Join("; ", singleResult.IneligibilityReasons)
                : null;
            if (singleResult.IsProtected)
            {
                var protectedNote = $"PROTECTED PRINCIPAL — escalate (not migrated){(string.IsNullOrWhiteSpace(singleResult.ProtectionNote) ? "" : $": {singleResult.ProtectionNote}")}";
                checkDetail = string.IsNullOrWhiteSpace(checkDetail) ? protectedNote : $"{checkDetail}; {protectedNote}";
            }

            Audit.LogMigrationCheck(currentUser, ipAddress, singleEmail, singleResult.Status.ToString(),
                singleTicketNumber, checkDetail);

            // Send admin notification
            await Email.SendAdminNotificationAsync(
                currentUser, ipAddress, $"CheckMigrationEligibility_{singleMigrationDirection}", singleEmail, "N/A",
                singleResult.Status.ToString(), singleResult.Status == MigrationStatus.Eligible, singleTicketNumber,
                checkDetail);
        }
        catch (Exception ex)
        {
            singleResult = new MigrationEligibilityResult
            {
                EmailAddress = singleEmail,
                Status = MigrationStatus.Ineligible
            };
            singleResult.IneligibilityReasons.Add($"Error: {ex.Message}");

            Audit.LogMigrationCheck(currentUser, clientIpAddress, singleEmail.Trim(),
                "Error", singleTicketNumber, ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateSingleMigrationBatch()
    {
        // Set before the first await, not after the authorization round-trip. Until the flag is
        // set the page's busy predicate reads false, so the circuit stays interactive across the
        // authorization await and the operator can click this again, or anything else. The
        // guards moved inside the try so the existing finally clears the flag on their returns.
        isCreating = true;
        singleCreateResult = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (!(await AuthorizationService.AuthorizeAsync(authState.User, "MigrationCreate")).Succeeded)
                return;

            if (singleResult == null || singleResult.Status != MigrationStatus.Eligible || string.IsNullOrWhiteSpace(singleTicketNumber))
                return;

            await Task.Yield();

            var finalBatchName = string.IsNullOrWhiteSpace(singleBatchName)
                ? singleResult.EmailAddress
                : singleBatchName.Trim();

            singleCreateResult = await MigrationSvc.CreateMigrationBatchAsync(
                singleMigrationDirection, new List<string> { singleResult.EmailAddress }, finalBatchName, singleAutoStart, singleAutoComplete, authState.User);

            var ipAddress = clientIpAddress;
            var singleExcluded = singleCreateResult.ExcludedTargets ?? Array.Empty<string>();
            var singleCreatedCount = 1 - singleExcluded.Count;

            try
            {
                // A serviced override succeeded, so it cannot ride errorDetail - that field is
                // written as null on success and the record of who permitted it would vanish.
                Audit.LogMigrationBatch(currentUser, ipAddress, finalBatchName, singleMigrationDirection.ToString(),
                    singleCreatedCount, singleAutoStart, singleAutoComplete, singleTicketNumber, singleCreateResult.Success, singleCreateResult.Message,
                    ProtectedPrincipalServicing.Extra(singleCreateResult.ServicedNote));

                // Audit every protected-principal exclusion as its own denial row, never silent.
                foreach (var excluded in singleExcluded)
                {
                    Audit.LogMigrationAction(currentUser, ipAddress,
                        $"CreateMigrationBatch_{singleMigrationDirection}_ProtectedExclusion", excluded,
                        false, singleTicketNumber, "Excluded — protected principal, not migrated");
                }
            }
            catch (Exception ex)
            {
                singleCreateResult = new PermissionResult
                {
                    Success = singleCreateResult.Success,
                    Message = singleCreateResult.Message,
                    Detail = $"Audit logging failed: {ex.Message}",
                    ServicedNote = singleCreateResult.ServicedNote,
                    ExcludedTargets = singleCreateResult.ExcludedTargets
                };
            }

            var singleExclusionNote = singleExcluded.Count > 0
                ? $" | EXCLUDED protected principals (not migrated): {string.Join("; ", singleExcluded)}"
                : "";

            await Email.SendAdminNotificationAsync(
                currentUser, ipAddress, $"CreateMigrationBatch_{singleMigrationDirection}", finalBatchName,
                singleResult.EmailAddress, $"AutoStart:{singleAutoStart} AutoComplete:{singleAutoComplete}{singleExclusionNote}",
                singleCreateResult.Success, singleTicketNumber, singleCreateResult.Success ? null : singleCreateResult.Message);
        }
        catch (Exception ex)
        {
            singleCreateResult = PermissionResult.Fail(ex.Message);
        }
        finally
        {
            isCreating = false;
        }
    }

    private Task HandleCsvUpload(InputFileChangeEventArgs e)
    {
        csvFile = e.File;
        bulkResult = null;
        createResult = null;
        return Task.CompletedTask;
    }

    private async Task CheckBulkEligibility()
    {
        if (csvFile == null)
            return;

        isLoading = true;
        bulkResult = null;
        createResult = null;
        await Task.Yield();

        try
        {
            await using var stream = csvFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            await using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            bulkResult = await MigrationSvc.CheckBulkMigrationEligibilityAsync(memoryStream, migrationDirection);

            var ipAddress = clientIpAddress;

            Audit.LogMigrationAction(currentUser, ipAddress,
                $"BulkEligibilityCheck_{migrationDirection}", csvFile.Name, true, bulkTicketNumber,
                $"{bulkResult.EligibleUsers}/{bulkResult.TotalUsers} eligible");

            try
            {
                await Email.SendAdminNotificationAsync(
                    currentUser, ipAddress, $"BulkMigrationEligibilityCheck_{migrationDirection}", "Bulk Operation", csvFile.Name,
                    $"{bulkResult.EligibleUsers}/{bulkResult.TotalUsers} eligible", true, bulkTicketNumber, null);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to send admin notification for bulk eligibility check");
            }
        }
        catch (Exception ex)
        {
            bulkResult = new MigrationBatchResult
            {
                BatchName = "Error",
                Success = false,
                Message = ex.Message,
                Direction = migrationDirection
            };

            Audit.LogMigrationAction(currentUser, clientIpAddress,
                $"BulkEligibilityCheck_{migrationDirection}", csvFile?.Name ?? "Unknown", false, bulkTicketNumber, ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateMigrationBatch()
    {
        // Set before the first await - see CreateSingleMigrationBatch for why.
        isCreating = true;
        createResult = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (!(await AuthorizationService.AuthorizeAsync(authState.User, "MigrationCreate")).Succeeded)
                return;

            if (bulkResult == null || bulkResult.EligibleUsers == 0 || string.IsNullOrWhiteSpace(bulkTicketNumber))
                return;

            await Task.Yield();

            var eligibleEmails = bulkResult.EligibilityResults
                .Where(r => r.Status == MigrationStatus.Eligible)
                .Select(r => r.EmailAddress)
                .ToList();

            var finalBatchName = string.IsNullOrWhiteSpace(bulkBatchName)
                ? $"{DateTime.Now:yyyy-MM-dd}_{(migrationDirection == MigrationDirection.ToCloud ? "Move" : "MoveBack")}"
                : bulkBatchName.Trim();

            createResult = await MigrationSvc.CreateMigrationBatchAsync(
                migrationDirection, eligibleEmails, finalBatchName, bulkAutoStart, bulkAutoComplete, authState.User);

            var ipAddress = clientIpAddress;
            var bulkExcluded = createResult.ExcludedTargets ?? Array.Empty<string>();
            var createdCount = eligibleEmails.Count - bulkExcluded.Count;

            try
            {
                // A serviced override succeeded, so it cannot ride errorDetail - that field is
                // written as null on success and the record of who permitted it would vanish.
                Audit.LogMigrationBatch(currentUser, ipAddress, finalBatchName, migrationDirection.ToString(),
                    createdCount, bulkAutoStart, bulkAutoComplete, bulkTicketNumber, createResult.Success, createResult.Message,
                    ProtectedPrincipalServicing.Extra(createResult.ServicedNote));

                // Audit every protected-principal exclusion as its own denial row, never silent.
                foreach (var excluded in bulkExcluded)
                {
                    Audit.LogMigrationAction(currentUser, ipAddress,
                        $"CreateMigrationBatch_{migrationDirection}_ProtectedExclusion", excluded,
                        false, bulkTicketNumber, "Excluded — protected principal, not migrated");
                }
            }
            catch (Exception ex)
            {
                createResult = new PermissionResult
                {
                    Success = createResult.Success,
                    Message = createResult.Message,
                    Detail = $"Audit logging failed: {ex.Message}",
                    ServicedNote = createResult.ServicedNote,
                    ExcludedTargets = createResult.ExcludedTargets
                };
            }

            var bulkExclusionNote = bulkExcluded.Count > 0
                ? $" | EXCLUDED {bulkExcluded.Count} protected principal(s) (not migrated): {string.Join("; ", bulkExcluded)}"
                : "";

            await Email.SendAdminNotificationAsync(
                currentUser, ipAddress, $"CreateMigrationBatch_{migrationDirection}", finalBatchName,
                $"{createdCount} users", $"AutoStart:{bulkAutoStart} AutoComplete:{bulkAutoComplete}{bulkExclusionNote}",
                createResult.Success, bulkTicketNumber, createResult.Success ? null : createResult.Message);
        }
        catch (Exception ex)
        {
            createResult = PermissionResult.Fail(ex.Message);
        }
        finally
        {
            isCreating = false;
        }
    }

    // The tab-strip gate. It lives here rather than in LoadMigrationStatus because
    // ExecuteBulkBatchAction calls LoadMigrationStatus to refresh the table while it is itself
    // still busy - guarding the loader would silently skip that refresh.
    private void SelectTab(int index)
    {
        if (IsBusy) return;
        tabIndex = index;
    }

    private async Task SelectStatusTab()
    {
        if (IsBusy) return;
        await LoadMigrationStatus();
    }

    // What the Refresh buttons, the tab and the bulk executor call: reloading the catalogue
    // collapses the open batch, exactly as it did before the address carried it. The rows are
    // discarded here rather than left to SyncOpenBatchFromUrl, which runs on the renderer's own
    // schedule: leaving the clearing to it would let the reload below land on top of the previous
    // batch's rows and only then wipe them.
    // What the Refresh buttons, the tab and the bulk executor call.
    //
    // Under R9 a catalogue refresh is NOT a selection act, so it no longer collapses the open
    // batch the way it did before S3: the selection survives the reload, minus whatever
    // PruneSelection drops because the batch is gone. AdoptSelectionAsOpenBatch then closes the
    // pane if the open batch was one of those, and otherwise its mailboxes are refetched, because
    // the reload may well have changed them.
    private async Task LoadMigrationStatus()
    {
        await LoadBatchList();

        var openBefore = expandedBatch;
        await AdoptSelectionAsOpenBatch();

        // Only when Adopt left it alone; Adopt loads the pane itself when it changes it.
        if (expandedBatch != null && string.Equals(expandedBatch, openBefore, StringComparison.Ordinal))
            await LoadMailboxesFor(expandedBatch);
    }

    // The catalogue reload on its own, with no opinion about which batch is open. Split out so a
    // pasted ?batch= link can load the list it needs without collapsing the batch it came for.
    private async Task LoadBatchList()
    {
        tabIndex = 2;
        isLoadingStatus = true;
        ResetBatchPage();

        try
        {
            migrationBatches = await MigrationSvc.GetMigrationBatchesAsync();
            batchActionResult = null;
        }
        catch (Exception ex)
        {
            migrationBatches ??= new List<MigrationBatchInfo>();
            batchActionResult = PermissionResult.Fail($"Failed to load migration batches: {ex.Message}");
        }
        finally
        {
            PruneSelection();
            isLoadingStatus = false;
            batchesLoaded = true;
        }
    }

    // A batch that is no longer listed must not stay ticked: acting on a name Exchange no longer
    // knows produces a failure that reads as a bug in this app. Runs on every reload, including
    // the failed one - a load that threw leaves migrationBatches as whatever it last held.
    private void PruneSelection()
    {
        var kept = MigrationBatchActionPlanner.PruneSelection(migrationBatches, selectedBatches);
        selectedBatches.Clear();
        foreach (var name in kept)
            selectedBatches.Add(name);
    }

    // True when the pending action targets one row that is currently rendered - a batch row, or a
    // user row inside the expanded batch - so its confirm bar belongs under that row. False for
    // Clear Completed and the bulk selection actions, whose target is a count, and false when the
    // named row is no longer listed: the bar must never become unreachable because the row it was
    // attached to disappeared.
    //
    // The user half was missing until mbs-1: StageUserAction sets the target to an EMAIL, which
    // never equals a batch name, so every per-user action fell through to the top-of-table bar -
    // the same off-screen prompt this work stream exists to remove, one level down.
    private bool PendingActionNamesALoadedRow =>
        pendingActionTarget != null
        && (migrationBatches?.Any(b => b.BatchName == pendingActionTarget) == true
            || batchUsers?.Any(u => u.EmailAddress == pendingActionTarget) == true);

    private bool IsBatchSelected(string batchName) => selectedBatches.Contains(batchName);

    private async Task ToggleBatchSelected(string batchName, bool selected)
    {
        if (IsBusy) return;

        if (selected)
            selectedBatches.Add(batchName);
        else
            selectedBatches.Remove(batchName);

        batchActionResult = null;

        // R9. Ticking is not a second act beside opening: the pane follows the selection, so
        // ticking down to one batch opens it and ticking a second one turns the pane into the
        // list of what is ticked.
        await AdoptSelectionAsOpenBatch();
    }

    // R9. The row click sets the selection to exactly this batch, which is what opens it. There is
    // no separate "details" state to fall out of step with the tick boxes.
    private async Task SelectOnlyBatch(string batchName)
    {
        // The gate is in the handler because the control is a div, and a div ignores the disabled
        // attribute exactly as the tab-strip anchors do - see SelectTab, here for the same reason.
        // The greying is styling only and must never be mistaken for the guard.
        if (IsBusy) return;

        selectedBatches.Clear();
        selectedBatches.Add(batchName);
        batchActionResult = null;

        await AdoptSelectionAsOpenBatch();
    }

    // R10. Said only in the right pane, where there are no tick boxes to "untick".
    private async Task RemoveFromSelection(string batchName)
    {
        if (IsBusy) return;

        selectedBatches.Remove(batchName);
        batchActionResult = null;

        await AdoptSelectionAsOpenBatch();
    }

    private bool AllBatchesSelected
    {
        get
        {
            var visible = GetSortedBatches().ToList();
            return visible.Count > 0 && visible.All(b => selectedBatches.Contains(b.BatchName));
        }
    }

    private async Task ToggleSelectAllBatches(ChangeEventArgs e)
    {
        if (IsBusy) return;

        selectedBatches.Clear();

        if (e.Value is bool check && check && migrationBatches != null)
        {
            // R8. Select-all means every batch in the catalogue, with NO cap - "select up to the
            // cap" is not select-all. That is safe alongside R20 only because selection and
            // rendering are different things: ListWindow bounds what is drawn by the page index
            // alone and knows nothing about what is ticked, which ListWindowTests asserts.
            // Every batch MATCHING THE FILTER, not every batch in the catalogue. A tick box above
            // a filtered list that silently swept up the hidden 760 would be the worst kind of
            // select-all: it acts on rows the operator cannot see.
            foreach (var batch in GetSortedBatches())
                selectedBatches.Add(batch.BatchName);
        }

        batchActionResult = null;

        await AdoptSelectionAsOpenBatch();
    }

    // R10. "Untick all" in the batch pane, where the tick boxes are; the right pane says "Clear
    // selection" for the same operation, because there is nothing to untick there.
    private async Task ClearBatchSelection()
    {
        if (IsBusy) return;

        selectedBatches.Clear();
        batchActionResult = null;

        await AdoptSelectionAsOpenBatch();
    }

    // R4. The selection gets its own pager so the right pane never renders 2000 ticked batches -
    // R5 forbids pinning them into the left list, so this pane is where the selection is visible,
    // and a pane with no bound is the Defender failure again. Ordered by the catalogue, not by the
    // set, so it reads in the same order as the list beside it.
    private IEnumerable<MigrationBatchInfo> GetSelectedBatchesPage() =>
        ListWindow.Slice(SelectedBatchesInListOrder(), selectionPage, SelectionPageSize);

    private IEnumerable<MigrationBatchInfo> SelectedBatchesInListOrder() =>
        GetSortedBatches().Where(b => selectedBatches.Contains(b.BatchName));

    private int SelectionTotalCount => SelectedBatchesInListOrder().Count();

    private int SelectionPageCount => ListWindow.PageCount(SelectionTotalCount, SelectionPageSize);

    // Labelled so it is unmistakable that it pages the SELECTION and not the catalogue (R4).
    private string SelectionPagerLabel =>
        ListWindow.Label(selectionPage, SelectionTotalCount, SelectionPageSize,
            "selected batches", "No batches selected");

    private void StepSelectionPage(int delta) =>
        selectionPage = ListWindow.ClampPage(selectionPage + delta, SelectionTotalCount, SelectionPageSize);

    // ---- S5: the mailbox table's filter, sort and paging (R21, R20) -----------------------------

    // R21: over the WHOLE set, not the rendered page. Filtering a page would mean a mailbox the
    // operator is looking for is missing because it happens to be on page 7, which is the failure
    // that makes a filter worse than no filter.
    private IEnumerable<MigrationUserInfo> FilteredSortedMailboxes()
    {
        if (batchUsers == null)
            return Enumerable.Empty<MigrationUserInfo>();

        IEnumerable<MigrationUserInfo> rows = batchUsers;

        var filter = mailboxFilter.Trim();
        if (filter.Length > 0)
        {
            // The address is what an operator has in hand - a ticket names a person, not a status.
            rows = rows.Where(u =>
                u.EmailAddress?.Contains(filter, StringComparison.OrdinalIgnoreCase) == true);
        }

        return SortMailboxes(rows);
    }

    // Split out so the pinned block can sort without filtering (R11). One ordering definition, or
    // the pinned rows and the rows below them would sort by different rules and read as two lists.
    private IEnumerable<MigrationUserInfo> SortMailboxes(IEnumerable<MigrationUserInfo> rows)
    {
        return mailboxSortColumn switch
        {
            "Status" => mailboxSortAsc
                ? rows.OrderBy(u => u.Status, StringComparer.OrdinalIgnoreCase)
                : rows.OrderByDescending(u => u.Status, StringComparer.OrdinalIgnoreCase),
            "Synced" => mailboxSortAsc
                ? rows.OrderBy(u => u.ItemsSynced)
                : rows.OrderByDescending(u => u.ItemsSynced),
            // Nulls last in both directions: a mailbox that has never synced is not "earliest",
            // it is unknown, and sorting it to the top of an ascending list reads as a fact.
            "LastSync" => mailboxSortAsc
                ? rows.OrderBy(u => u.LastSyncDateTime == null).ThenBy(u => u.LastSyncDateTime)
                : rows.OrderBy(u => u.LastSyncDateTime == null).ThenByDescending(u => u.LastSyncDateTime),
            _ => mailboxSortAsc
                ? rows.OrderBy(u => u.EmailAddress, StringComparer.OrdinalIgnoreCase)
                : rows.OrderByDescending(u => u.EmailAddress, StringComparer.OrdinalIgnoreCase),
        };
    }

    // R5a. Ticked mailboxes are PINNED above an "OTHER MAILBOXES" divider. R5 forbids this for
    // batches because the selection has its own pane there; mailboxes have no equivalent second
    // surface, so pinning is how R11 is met for them.
    //
    // NOT filtered. R11 says no selected item may be hidden by a filter or a page change, and a
    // ticked mailbox that vanishes when the operator types is exactly that - they would act on a
    // selection they can no longer see. Sorted, so the pinned block reads in the same order as
    // the list below it.
    private IEnumerable<MigrationUserInfo> PinnedMailboxes()
    {
        if (batchUsers == null || selectedMailboxes.Count == 0)
            return Enumerable.Empty<MigrationUserInfo>();

        return SortMailboxes(batchUsers.Where(u => selectedMailboxes.Contains(u.EmailAddress)));
    }

    // Everything else: filtered, sorted, and with the pinned rows removed so a ticked mailbox is
    // not rendered twice.
    private IEnumerable<MigrationUserInfo> OtherMailboxes() =>
        FilteredSortedMailboxes().Where(u => !selectedMailboxes.Contains(u.EmailAddress));

    // R5b. The pinned block pages too, or R5a, R8 and R20 cannot all hold at once: select-all has
    // no cap, every ticked mailbox is pinned, and no view may render the full set - so ticking all
    // 2000 would pin 2000 rows and reproduce the Defender failure exactly. Its own pager, the way
    // the batch selection got one in R4.
    private IEnumerable<MigrationUserInfo> GetPinnedMailboxesPage() =>
        ListWindow.Slice(PinnedMailboxes(), pinnedMailboxPage, PinnedMailboxPageSize);

    private int PinnedMailboxTotalCount => selectedMailboxes.Count;

    private int PinnedMailboxPageCount =>
        ListWindow.PageCount(PinnedMailboxTotalCount, PinnedMailboxPageSize);

    private string PinnedMailboxPagerLabel =>
        ListWindow.Label(pinnedMailboxPage, PinnedMailboxTotalCount, PinnedMailboxPageSize,
            "ticked", "None ticked");

    private void StepPinnedMailboxPage(int delta) =>
        pinnedMailboxPage = ListWindow.ClampPage(
            pinnedMailboxPage + delta, PinnedMailboxTotalCount, PinnedMailboxPageSize);

    private IEnumerable<MigrationUserInfo> GetPagedMailboxes() =>
        ListWindow.Slice(OtherMailboxes(), mailboxPage, MailboxPageSize);

    private int MailboxTotalCount => OtherMailboxes().Count();

    private int MailboxPageCount => ListWindow.PageCount(MailboxTotalCount, MailboxPageSize);

    // Says "of 340 mailboxes" when a filter is narrowing 2000 down, because the number that matters
    // is the size of what the operator is paging through, not the size of the batch.
    private string MailboxPagerLabel =>
        ListWindow.Label(mailboxPage, MailboxTotalCount, MailboxPageSize, "mailboxes", "No mailboxes");

    private void StepMailboxPage(int delta) =>
        mailboxPage = ListWindow.ClampPage(mailboxPage + delta, MailboxTotalCount, MailboxPageSize);

    // Every change to the ordering or the membership goes back to page one, or the operator is
    // left on page 9 of a 3-page result staring at nothing and reading it as an empty batch.
    private void ResetMailboxPage() => mailboxPage = 0;

    private void OnMailboxFilterChanged(ChangeEventArgs e)
    {
        mailboxFilter = e.Value?.ToString() ?? "";
        ResetMailboxPage();
    }

    private void OnMailboxSortColumnChanged(ChangeEventArgs e)
    {
        var column = e.Value?.ToString();
        if (string.IsNullOrEmpty(column) || column == mailboxSortColumn)
            return;

        mailboxSortColumn = column;
        mailboxSortAsc = column is "Email" or "Status";
        ResetMailboxPage();
    }

    private void ToggleMailboxSortDirection()
    {
        mailboxSortAsc = !mailboxSortAsc;
        ResetMailboxPage();
    }

    // ---- S5 step 2b: the mailbox selection (R7, R8, R10) ----------------------------------------

    private bool IsMailboxSelected(string email) => selectedMailboxes.Contains(email);

    // NO handler guard and NO disabled attribute, matching the batch tick boxes and for the same
    // reason (D2(a)): a tick box is an input to the confirm step, not a value in flight. Both
    // refusals would be wrong here - the registry's rule is that a handler guard on a DOM-synced
    // control corrupts data, because the browser keeps a tick the server refused.
    //
    // Safe because this writes only to selectedMailboxes and clamps two pagers. It calls nothing
    // and awaits nothing, which is precisely the condition that stops being true the moment a
    // selection change starts a fetch - see the note on ToggleBatchSelected.
    private void ToggleMailboxSelected(string email, bool selected)
    {
        if (selected)
            selectedMailboxes.Add(email);
        else
            selectedMailboxes.Remove(email);

        batchActionResult = null;
        ClearStagedPreview();

        // The row moves between the pinned block and the list below it, so both pagers can now be
        // pointing past their end.
        ClampMailboxPages();
    }

    // R8 applied to mailboxes: every mailbox matching the FILTER, not just the rendered page, and
    // no cap. Safe alongside R20 only because the pinned block pages (R5b) - ticking 2000 pins
    // 2000, and without its own pager that is the Defender failure again.
    private void ToggleSelectAllMailboxes(ChangeEventArgs e)
    {
        selectedMailboxes.Clear();

        if (e.Value is bool check && check)
        {
            foreach (var user in FilteredSortedMailboxes())
                selectedMailboxes.Add(user.EmailAddress);
        }

        batchActionResult = null;
        ClearStagedPreview();
        ClampMailboxPages();
    }

    // Matching the filter, not matching the page: the tick box above a filtered list that only
    // took the visible 50 would quietly do less than it says.
    private bool AllMailboxesSelected
    {
        get
        {
            var visible = FilteredSortedMailboxes().ToList();
            return visible.Count > 0 && visible.All(u => selectedMailboxes.Contains(u.EmailAddress));
        }
    }

    // R10. "Untick all" where the tick boxes are.
    private void ClearMailboxSelection()
    {
        selectedMailboxes.Clear();
        batchActionResult = null;
        ClearStagedPreview();
        ClampMailboxPages();
    }

    private void ClampMailboxPages()
    {
        mailboxPage = ListWindow.ClampPage(mailboxPage, MailboxTotalCount, MailboxPageSize);
        pinnedMailboxPage = ListWindow.ClampPage(
            pinnedMailboxPage, PinnedMailboxTotalCount, PinnedMailboxPageSize);
    }

    // R12. The mailbox bar reaches the planner exactly as the batch bar does - same staged ticket,
    // same eligible/skipped split, same preview. Five actions, matching the five per-row buttons
    // they replace.
    private void StageCompleteMailboxes() => StageMailboxAction(
        MigrationUserAction.Complete, "Complete", e => MigrationSvc.CompleteMigrationUserAsync(e),
        "CompleteMigrationUser", "Migration_CompleteMailboxes", "Queued completion of");

    private void StageApproveMailboxes() => StageMailboxAction(
        MigrationUserAction.Approve, "Approve", e => MigrationSvc.ApproveMigrationUserAsync(e),
        "ApproveMigrationUser", "Migration_ApproveMailboxes", "Queued approval of");

    private void StagePauseMailboxes() => StageMailboxAction(
        MigrationUserAction.Pause, "Pause", e => MigrationSvc.StopMigrationUserAsync(e),
        "StopMigrationUser", "Migration_PauseMailboxes", "Queued pause of");

    private void StageResumeMailboxes() => StageMailboxAction(
        MigrationUserAction.Resume, "Resume", e => MigrationSvc.ResumeMigrationUserAsync(e),
        "ResumeMigrationUser", "Migration_ResumeMailboxes", "Queued resume of");

    private void StageRemoveMailboxes() => StageMailboxAction(
        MigrationUserAction.Clear, "Remove", e => MigrationSvc.RemoveMigrationUserAsync(e),
        "RemoveMigrationUser", "Migration_RemoveMailboxes", "Queued removal of");

    private void StageMailboxAction(
        MigrationUserAction action,
        string label,
        Func<string, Task<PermissionResult>> call,
        string auditAction,
        string notifyAction,
        string verb)
    {
        var staged = MigrationUserActionPlanner.Plan(batchUsers, selectedMailboxes, action);

        StageBatchAction(label, $"{staged.Eligible.Count} mailbox(es)", ticket =>
        {
            // Re-planned at execution time for the same reason the batch bar re-plans: the
            // operator can sit at the ticket field while the rows reload underneath them.
            var current = MigrationUserActionPlanner.Plan(batchUsers, selectedMailboxes, action);
            return ExecuteBulkMailboxAction(current, call, auditAction, notifyAction, verb, ticket);
        });

        pendingUserAction = action;
        pendingUserActionPlan = staged;
    }

    private string MailboxActionButtonClass(MigrationUserAction action, string tone) =>
        pendingUserAction == action ? $"btn btn-sm btn-{tone}" : $"btn btn-sm btn-outline-{tone}";

    // The preview for one mailbox row, the mailbox twin of StagedOutcomeFor.
    private string? StagedMailboxOutcomeFor(string email)
    {
        if (pendingUserActionPlan == null)
            return null;

        if (pendingUserActionPlan.Eligible.Contains(email, StringComparer.OrdinalIgnoreCase))
            return "Will run";

        var skip = pendingUserActionPlan.Skipped
            .FirstOrDefault(s => string.Equals(s.EmailAddress, email, StringComparison.OrdinalIgnoreCase));

        return skip == null ? null : $"Skipped ({skip.Status})";
    }

    private bool StagedMailboxOutcomeIsGo(string email) =>
        pendingUserActionPlan?.Eligible.Contains(email, StringComparer.OrdinalIgnoreCase) == true;

    // Delete's staged target carries the per-status breakdown (D5): it is the only action that
    // accepts in-progress batches, so the operator must see how many of those they are about to
    // destroy before typing a ticket. The other two have a single, obvious target class.
    private void StageDeleteSelected() => StageSelectionAction(
        MigrationBatchAction.Delete,
        "DELETE",
        DeleteSelectedBatches,
        staged => $"This will remove {staged.Eligible.Count} batch(es): "
                  + MigrationBatchActionPlanner.DescribeSelectionByStatus(migrationBatches, selectedBatches));

    private void StageRemoveCompletedSelected() => StageSelectionAction(
        MigrationBatchAction.RemoveCompleted, "Remove Completed", RemoveCompletedSelectedBatches);

    private void StageResumeSelected() => StageSelectionAction(
        MigrationBatchAction.Resume, "Resume/Retry", ResumeSelectedBatches);

    // S3. The two that used to be per-row buttons. They reach the same planner, the same ticket
    // step and the same aggregating executor as the other three - R12 says both action bars are
    // identical, and that starts with them not having their own private paths.
    private void StageCompleteSelected() => StageSelectionAction(
        MigrationBatchAction.Complete, "Complete", CompleteSelectedBatches);

    private void StageStopSelected() => StageSelectionAction(
        MigrationBatchAction.Stop, "Stop", StopSelectedBatches);

    // The plan is computed at STAGING time so the confirm bar can say how many batches the ticket
    // is about to cover, and re-computed at execution time inside the callback - the operator can
    // sit at the ticket field indefinitely, and the table reloads underneath them.
    private void StageSelectionAction(
        MigrationBatchAction action,
        string label,
        Func<MigrationBatchActionPlan, string, Task> execute,
        Func<MigrationBatchActionPlan, string>? describeTarget = null)
    {
        var staged = MigrationBatchActionPlanner.Plan(migrationBatches, selectedBatches, action);
        var target = describeTarget?.Invoke(staged) ?? $"{staged.Eligible.Count} batch(es)";

        StageBatchAction(label, target, ticket =>
        {
            var current = MigrationBatchActionPlanner.Plan(migrationBatches, selectedBatches, action);
            return execute(current, ticket);
        });

        // S4. StageBatchAction clears these, so they are set after it. The preview is what the
        // operator reads before typing a ticket; the callback above re-plans at execution time
        // because they can sit at that field while the table reloads underneath them, so this is
        // a preview and never the authority on what runs.
        pendingBatchAction = action;
        pendingActionPlan = staged;
    }

    // R30. Refreshing this pane's mailboxes and refreshing the batch catalogue are different acts;
    // neither silently does the other. The report closes first because it describes the rows about
    // to be replaced, and LoadMailboxesFor closes it again after the fetch lands - see
    // ReplaceBatchUsers for why closing before the await is not enough.
    private async Task RefreshBatchUsers(string batchName)
    {
        if (IsBusy) return;

        InvalidateStoredReports();
        await LoadMailboxesFor(batchName);
    }

    private void CompleteBatch(string name) => StageBatchAction("Complete Batch", name, t => ExecuteBatchAction(() => MigrationSvc.CompleteMigrationBatchAsync(name), "CompleteMigrationBatch", name, t));
    private void StopBatch(string name) => StageBatchAction("Stop Batch", name, t => ExecuteBatchAction(() => MigrationSvc.StopMigrationBatchAsync(name), "StopMigrationBatch", name, t));
    private void ResumeBatch(string name) => StageBatchAction("Resume Batch", name, t => ExecuteBatchAction(() => MigrationSvc.StartMigrationBatchAsync(name), "StartMigrationBatch", name, t));
    private void DeleteBatch(string name) => StageBatchAction("Delete Batch", name, t => ExecuteBatchAction(() => MigrationSvc.RemoveMigrationBatchAsync(name), "RemoveMigrationBatch", name, t));
    private void CompleteUser(string email) => StageUserAction("Complete User", email, t => ExecuteUserAction(() => MigrationSvc.CompleteMigrationUserAsync(email), "CompleteMigrationUser", email, t));
    private void ApproveUser(string email) => StageUserAction("Approve User", email, t => ExecuteUserAction(() => MigrationSvc.ApproveMigrationUserAsync(email), "ApproveMigrationUser", email, t));
    private void PauseUser(string email) => StageUserAction("Pause User", email, t => ExecuteUserAction(() => MigrationSvc.StopMigrationUserAsync(email), "StopMigrationUser", email, t));
    private void ResumeUser(string email) => StageUserAction("Resume User", email, t => ExecuteUserAction(() => MigrationSvc.ResumeMigrationUserAsync(email), "ResumeMigrationUser", email, t));
    private void ClearUser(string email) => StageUserAction("Clear User", email, t => ExecuteUserAction(() => MigrationSvc.RemoveMigrationUserAsync(email), "RemoveMigrationUser", email, t));

    private void StageBatchAction(string label, string target, Func<string, Task> callback)
    {
        pendingActionLabel = label;
        pendingActionTarget = target;
        pendingActionTicket = "";
        pendingActionCallback = callback;
        batchActionResult = null;
        ClearStagedPreview();

        // Last run's per-row outcomes go when a new action is staged: leaving them would let an
        // operator read "Refused" from the previous attempt as the result of this one.
        ClearActionOutcomes();
    }

    private void StageUserAction(string label, string email, Func<string, Task> callback)
    {
        pendingActionLabel = label;
        pendingActionTarget = email;
        pendingActionTicket = "";
        pendingActionCallback = callback;
        batchActionResult = null;

        // A per-mailbox action annotates no batch row. Leaving a previous batch preview up would
        // mark rows "will run" for an action that is no longer the one staged.
        ClearStagedPreview();
    }

    private void ClearStagedPreview()
    {
        pendingBatchAction = null;
        pendingActionPlan = null;
        pendingUserAction = null;
        pendingUserActionPlan = null;
    }

    // S4, R12. What the preview answers for one row, so the markup asks rather than recomputes.
    // Only rows in the staged plan are annotated: an unticked row is not part of this action and
    // saying nothing about it is the honest answer.
    private string? StagedOutcomeFor(string batchName)
    {
        if (pendingActionPlan == null)
            return null;

        if (pendingActionPlan.Eligible.Contains(batchName, StringComparer.OrdinalIgnoreCase))
            return "Will run";

        var skip = pendingActionPlan.Skipped
            .FirstOrDefault(s => string.Equals(s.BatchName, batchName, StringComparison.OrdinalIgnoreCase));

        // The status is the whole point: "Skipped" alone tells the operator nothing they can act
        // on, and the status is what they would have to go and look up.
        return skip == null ? null : $"Skipped ({skip.Status})";
    }

    private bool StagedOutcomeIsGo(string batchName) =>
        pendingActionPlan?.Eligible.Contains(batchName, StringComparer.OrdinalIgnoreCase) == true;

    // R12: the picked action is highlighted. Filled while it is the staged one, outline otherwise,
    // so the bar shows which of five buttons the ticket field belongs to - the confirm bar can sit
    // several rows away once a skipped row is annotated between them.
    private string BatchActionButtonClass(MigrationBatchAction action, string tone) =>
        pendingBatchAction == action ? $"btn btn-sm btn-{tone}" : $"btn btn-sm btn-outline-{tone}";

    private async Task HandleConfirmKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(pendingActionTicket))
            await ConfirmPendingAction();
    }

    private void CancelPendingAction()
    {
        pendingActionLabel = null;
        pendingActionTarget = null;
        pendingActionTicket = "";
        pendingActionCallback = null;

        // The row annotations go with it. ConfirmPendingAction calls this BEFORE awaiting the
        // staged callback, so the preview is cleared the moment the action starts rather than
        // lingering over rows the operation is already changing.
        ClearStagedPreview();
    }

    private async Task ConfirmPendingAction()
    {
        if (pendingActionCallback == null || string.IsNullOrWhiteSpace(pendingActionTicket)) return;

        var callback = pendingActionCallback;
        var ticket = pendingActionTicket.Trim();
        CancelPendingAction();
        await callback(ticket);
    }

    private async Task ExecuteBatchAction(Func<Task<PermissionResult>> action, string auditAction, string target, string ticket)
    {
        // Set before the first await - see CreateSingleMigrationBatch for why.
        actionInProgress = target;
        batchActionResult = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (!(await AuthorizationService.AuthorizeAsync(authState.User, "MigrationManage")).Succeeded)
                return;

            var result = await action();
            batchActionResult = result;

            try
            {
                Audit.LogMigrationAction(currentUser, clientIpAddress, auditAction, target, result.Success, ticket, result.Success ? null : result.Message);
            }
            catch (Exception ex)
            {
                batchActionResult = new PermissionResult
                {
                    Success = result.Success,
                    Message = result.Message,
                    Detail = $"Audit logging failed: {ex.Message}"
                };
            }

            try
            {
                await Email.SendAdminNotificationAsync(
                    currentUser, clientIpAddress, $"Migration_{auditAction}", target, "N/A",
                    "Migration", result.Success, ticket, result.Success ? null : result.Message);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to send admin notification for Migration_{Action} on {Target}", auditAction, target);
            }

            if (result.Success)
            {
                var savedResult = batchActionResult;
                await LoadMigrationStatus();
                batchActionResult = batchActionResult ?? savedResult;
            }
        }
        catch (Exception ex)
        {
            batchActionResult = PermissionResult.Fail(ex.Message);
        }
        finally
        {
            actionInProgress = null;
        }
    }

    private async Task ExecuteUserAction(Func<Task<PermissionResult>> action, string auditAction, string target, string ticket)
    {
        // Set before the first await - see CreateSingleMigrationBatch for why.
        actionInProgress = target;
        batchActionResult = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (!(await AuthorizationService.AuthorizeAsync(authState.User, "MigrationManage")).Succeeded)
                return;

            var result = await action();
            batchActionResult = result;

            try
            {
                Audit.LogMigrationAction(currentUser, clientIpAddress, auditAction, target, result.Success, ticket, result.Success ? null : result.Message);
            }
            catch (Exception ex)
            {
                batchActionResult = new PermissionResult
                {
                    Success = result.Success,
                    Message = result.Message,
                    Detail = $"Audit logging failed: {ex.Message}"
                };
            }

            try
            {
                await Email.SendAdminNotificationAsync(
                    currentUser, clientIpAddress, $"Migration_{auditAction}", target, "N/A",
                    "Migration", result.Success, ticket, result.Success ? null : result.Message);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to send admin notification for Migration_{Action} on {Target}", auditAction, target);
            }

            if (result.Success && expandedBatch != null)
            {
                InvalidateStoredReports();
                var generation = batchUsersGeneration;
                ReplaceBatchUsers(generation, await MigrationSvc.GetMigrationBatchUsersAsync(expandedBatch));
            }
        }
        catch (Exception ex)
        {
            batchActionResult = PermissionResult.Fail(ex.Message);
        }
        finally
        {
            actionInProgress = null;
        }
    }

    // The verbs say QUEUED, not done. Remove-MigrationBatch and Start-MigrationBatch return when
    // Exchange ACCEPTS the request; the batch then sits at status Removing or Starting for a while.
    // Saying "Removed 1 batch(es)" over a row that is visibly still there reads as a broken app.
    private Task DeleteSelectedBatches(MigrationBatchActionPlan plan, string ticket) =>
        ExecuteBulkBatchAction(
            plan.Eligible,
            plan.Skipped,
            name => MigrationSvc.RemoveMigrationBatchAsync(name),
            "RemoveMigrationBatch",
            "Migration_DeleteSelected",
            "Queued removal of",
            ticket);

    // S3. Same executor, so per-item failures aggregate and skipped rows are named, exactly as
    // they do for the other three. The verbs say QUEUED for the same reason the others do:
    // Exchange returns when it ACCEPTS the request, and the batch then sits at Completing or
    // Stopping for a while.
    private Task CompleteSelectedBatches(MigrationBatchActionPlan plan, string ticket) =>
        ExecuteBulkBatchAction(
            plan.Eligible,
            plan.Skipped,
            name => MigrationSvc.CompleteMigrationBatchAsync(name),
            "CompleteMigrationBatch",
            "Migration_CompleteSelected",
            "Queued completion of",
            ticket);


    // The verbs say QUEUED, not done. Remove-MigrationBatch and Start-MigrationBatch return when
    // Exchange ACCEPTS the request; the batch then sits at status Removing or Starting for a while.
    // Saying "Removed 1 batch(es)" over a row that is visibly still there reads as a broken app.
    private Task DeleteSelectedBatches(MigrationBatchActionPlan plan, string ticket) =>
        ExecuteBulkBatchAction(
            plan.Eligible,
            plan.Skipped,
            name => MigrationSvc.RemoveMigrationBatchAsync(name),
            "RemoveMigrationBatch",
            "Migration_DeleteSelected",
            "Queued removal of",
            ticket);

    private Task RemoveCompletedSelectedBatches(MigrationBatchActionPlan plan, string ticket) =>
        ExecuteBulkBatchAction(
            plan.Eligible,
            plan.Skipped,
            name => MigrationSvc.RemoveMigrationBatchAsync(name),
            "RemoveMigrationBatch",
            "Migration_RemoveCompleted",
            "Queued removal of",
            ticket);

    private Task ResumeSelectedBatches(MigrationBatchActionPlan plan, string ticket) =>
        ExecuteBulkBatchAction(
            plan.Eligible,
            plan.Skipped,
            name => MigrationSvc.StartMigrationBatchAsync(name),
            "StartMigrationBatch",
            "Migration_ResumeSelected",
            "Queued restart of",
            ticket);

    /// <summary>
    /// Runs one action over many batches, aggregating per-batch outcomes.
    /// </summary>
    /// <remarks>
    /// The single bulk executor: Clear Completed and both selection actions route through here, so
    /// the aggregation rules exist once. Extracted from ClearCompletedBatches, which already had
    /// them right.
    ///
    /// The rules, each load-bearing:
    /// - Authorization is re-checked here, once, and a denial is audited. Hiding the checkbox
    ///   column is not a security control.
    /// - ONE audit event per batch, inside the loop. A run-level event cannot answer which batch
    ///   was removed, which is the question the audit log exists to answer.
    /// - Audit-write failures are WARNINGS, never operation failures: an audit failure must not
    ///   make an already-completed removal look failed.
    /// - Per-item failures are aggregated; a loop over N items never reports blanket success.
    /// - Skipped batches (owner ruling D2(a)) are reported but are NOT failures and are NOT
    ///   audited - no write was attempted, so there is no security event to record.
    /// - ONE summary admin notification per run. Fifty emails for one operator action is a
    ///   self-inflicted denial of the mailbox.
    /// </remarks>
    private async Task ExecuteBulkBatchAction(
        IReadOnlyList<string> batchNames,
        IReadOnlyList<MigrationBatchSkip> skipped,
        Func<string, Task<PermissionResult>> action,
        string auditAction,
        string notificationAction,
        string verb,
        string ticket)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!(await AuthorizationService.AuthorizeAsync(authState.User, "MigrationManage")).Succeeded)
        {
            batchActionResult = PermissionResult.Fail("Authorization denied.");
            try
            {
                Audit.LogMigrationAction(currentUser, clientIpAddress, $"{auditAction}_Denied", notificationAction, false, ticket, errorDetail: "MigrationManage authorization denied");
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to write audit for {Action} denial", auditAction);
            }
            return;
        }

        if (migrationBatches == null) return;

        var skippedSuffix = MigrationBatchActionPlanner.DescribeSkipped(skipped);

        // Nothing eligible is "nothing to do", not an error (D2(a)). Report the skips and stop
        // without touching Exchange, writing an audit event, or notifying anyone.
        if (batchNames.Count == 0)
        {
            batchActionResult = new PermissionResult
            {
                Success = true,
                Message = $"No batches to act on.{skippedSuffix}"
            };
            return;
        }

        actionInProgress = "clearing";
        isLoadingStatus = true;
        batchActionResult = null;
        var succeeded = 0;
        // Names Exchange accepted the request for, so they can be deselected after the run.
        var accepted = new List<string>();
        var errors = new List<string>();
        // Audit-write failures are warnings, never operation failures: an audit
        // failure must not make an already-completed removal look failed.
        var auditWarnings = new List<string>();

        try
        {
            foreach (var batchName in batchNames)
            {
                var result = await action(batchName);
                try
                {
                    Audit.LogMigrationAction(currentUser, clientIpAddress, auditAction, batchName,
                        result.Success, ticket, errorDetail: result.Success ? null : result.Message);
                }
                catch (Exception ex)
                {
                    auditWarnings.Add($"{batchName}: audit logging failed: {ex.Message}");
                }

                if (result.Success)
                {
                    succeeded++;
                    accepted.Add(batchName);
                }
                else
                {
                    errors.Add($"{batchName}: {result.Message}");
                }
            }

            // Every batch Exchange ACCEPTED is deselected, whatever happens next: leaving it ticked
            // invites a second click on work already in flight, and the row stays visible for
            // several refreshes because removal is asynchronous. Batches that FAILED stay ticked -
            // nothing was queued for them, and retrying is the likely next move. Skipped rows also
            // stay ticked (D2(a)), so the operator can pick a different action for exactly them.
            foreach (var name in accepted)
                selectedBatches.Remove(name);

            var warningSuffix = auditWarnings.Count > 0
                ? $" (warning - {string.Join("; ", auditWarnings)})"
                : "";
            if (errors.Count == 0)
                batchActionResult = new PermissionResult { Success = true, Message = $"{verb} {succeeded} batch(es). Exchange processes this in the background - use Refresh to follow it.{skippedSuffix}{warningSuffix}" };
            else
                batchActionResult = PermissionResult.Fail($"{verb} {succeeded} batch(es); {errors.Count} refused: {string.Join("; ", errors)}{skippedSuffix}{warningSuffix}");

            try
            {
                await Email.SendAdminNotificationAsync(
                    currentUser, clientIpAddress, notificationAction,
                    $"{succeeded} batch(es)", "N/A", "Migration",
                    errors.Count == 0, ticket, errors.Any() ? string.Join("; ", errors) : null);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to send admin notification for {Action}", notificationAction);
            }

            var savedResult = batchActionResult;
            await LoadMigrationStatus();
            batchActionResult = batchActionResult ?? savedResult;
        }
        catch (Exception ex)
        {
            batchActionResult = PermissionResult.Fail(ex.Message);
        }
        finally
        {
            actionInProgress = null;
            isLoadingStatus = false;
        }
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(searchQuery))
            await SearchUser();
    }

    private void ClearSearch()
    {
        searchQuery = "";
        highlightedUser = null;
        batchActionResult = null;
    }

    private async Task SearchUser()
    {
        if (string.IsNullOrWhiteSpace(searchQuery) || migrationBatches == null) return;

        var query = searchQuery.Trim();
        isSearching = true;
        highlightedUser = null;
        batchActionResult = null;

        try
        {
            var matchedBatch = migrationBatches.FirstOrDefault(b =>
                b.BatchName.Contains(query, StringComparison.OrdinalIgnoreCase));

            if (matchedBatch != null)
            {
                expandedBatch = matchedBatch.BatchName;
                loadingBatchUsers = matchedBatch.BatchName;
                batchUsers = null;
                StateHasChanged();

                batchUsers = await MigrationSvc.GetMigrationBatchUsersAsync(matchedBatch.BatchName);
                loadingBatchUsers = null;
                return;
            }

            var searchResult = await MigrationSvc.FindMigrationUserBatchAsync(query);

            if (searchResult.Error != null)
            {
                batchActionResult = PermissionResult.Fail($"Search failed: {searchResult.Error}");
                return;
            }

            if (searchResult.MatchCount == 0)
            {
                batchActionResult = PermissionResult.Fail($"No batch or user found matching \"{query}\".");
                return;
            }

            if (searchResult.MatchCount > 1)
            {
                batchActionResult = PermissionResult.Fail($"Multiple users ({searchResult.MatchCount}) match \"{query}\". Use a more specific search term.");
                return;
            }

            highlightedUser = searchResult.Email;
            expandedBatch = searchResult.BatchId;
            loadingBatchUsers = searchResult.BatchId;
            batchUsers = null;
            StateHasChanged();

            batchUsers = await MigrationSvc.GetMigrationBatchUsersAsync(searchResult.BatchId!);
            loadingBatchUsers = null;
        }
        catch (Exception ex)
        {
            batchActionResult = PermissionResult.Fail($"Search failed: {ex.Message}");
        }
        finally
        {
            isSearching = false;
        }
    }

    private async Task LoadUserReport(string emailAddress)
    {
        if (reportUser == emailAddress)
        {
            reportUser = null;
            userReport = null;
            return;
        }

        loadingReport = emailAddress;
        reportUser = null;
        userReport = null;

        try
        {
            userReport = await MigrationSvc.GetMigrationUserReportAsync(emailAddress);
            reportUser = emailAddress;
        }
        catch (Exception ex)
        {
            userReport = $"Error: {ex.Message}";
            reportUser = emailAddress;
        }
        finally
        {
            loadingReport = null;
        }
    }

    private void ToggleBatchSort(string column)
    {
        if (batchSortColumn == column)
            batchSortAsc = !batchSortAsc;
        else
        {
            batchSortColumn = column;
            batchSortAsc = column is "Name" or "Status" or "Direction";
        }
    }

    private MarkupString SortIndicator(string column)
    {
        if (batchSortColumn != column)
            return new MarkupString("<span class=\"text-muted opacity-25\">↕</span>");
        return new MarkupString(batchSortAsc ? "▲" : "▼");
    }

    private IEnumerable<MigrationBatchInfo> GetSortedBatches()
    {
        if (migrationBatches == null) return Enumerable.Empty<MigrationBatchInfo>();

        IOrderedEnumerable<MigrationBatchInfo> sorted = batchSortColumn switch
        {
            "Name" => batchSortAsc ? migrationBatches.OrderBy(b => b.BatchName) : migrationBatches.OrderByDescending(b => b.BatchName),
            "Status" => batchSortAsc ? migrationBatches.OrderBy(b => b.Status) : migrationBatches.OrderByDescending(b => b.Status),
            "Direction" => batchSortAsc ? migrationBatches.OrderBy(b => b.Direction) : migrationBatches.OrderByDescending(b => b.Direction),
            "Total" => batchSortAsc ? migrationBatches.OrderBy(b => b.TotalCount) : migrationBatches.OrderByDescending(b => b.TotalCount),
            "Synced" => batchSortAsc ? migrationBatches.OrderBy(b => b.SyncedCount) : migrationBatches.OrderByDescending(b => b.SyncedCount),
            "Failed" => batchSortAsc ? migrationBatches.OrderBy(b => b.FailedCount) : migrationBatches.OrderByDescending(b => b.FailedCount),
            _ => batchSortAsc ? migrationBatches.OrderBy(b => b.CreatedDateTime) : migrationBatches.OrderByDescending(b => b.CreatedDateTime),
        };

        return sorted;
    }

    private string GetStatusColor(string status)
    {
        return status.ToLowerInvariant() switch
        {
            "completed" => "success",
            "syncing" or "synced" => "primary",
            "stopped" or "stopping" => "warning",
            "failed" => "danger",
            "corrupted" => "danger",
            "needsapproval" => "warning",
            _ => "secondary"
        };
    }

    private string GetUserStatusColor(string status)
    {
        return status.ToLowerInvariant() switch
        {
            "completed" => "success",
            "synced" => "info",
            "syncing" => "primary",
            "failed" => "danger",
            "stopped" => "warning",
            "needsapproval" => "warning",
            "queued" => "secondary",
            _ => "secondary"
        };
    }


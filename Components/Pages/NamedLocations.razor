@page "/named-locations"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "NamedLocations")]
@rendermode InteractiveServer
@inject NamedLocationsService LocationService
@inject AuditService Audit
@inject EmailService Email
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager Navigation
@inject ClientInfoService ClientInfo
@inject ILogger<NamedLocations> Logger
@inject IJSRuntime JS

<PageTitle>Named Locations</PageTitle>

@if (!authChecked)
{
    <div class="container-fluid">
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Checking authorization...</span>
            </div>
        </div>
    </div>
    return;
}

<div class="container-fluid">
    <div class="alert alert-info py-2 mb-3">
        <small>Manage Conditional Access named locations for trusted IP ranges and country/region lists.</small>
    </div>
    <h1 class="mb-4">Named Locations<ModuleVersion /></h1>

    @if (!LocationService.IsAvailable)
    {
        <div class="alert alert-danger">Named Locations module is not configured. Set Graph App Delinea Secret ID in Module Config.</div>
        return;
    }

    @if (operationResult != null)
    {
        <div class="alert @(operationResult.Success ? "alert-success" : "alert-danger") alert-dismissible">
            @operationResult.Message
            <button type="button" class="btn-close" @onclick="() => operationResult = null" disabled="@isOperating"></button>
        </div>
    }

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Named Locations</strong>
                    <div>
                        <button class="btn btn-outline-secondary btn-sm me-1" @onclick="DownloadCsvAsync" disabled="@(IsBusy || locations.Count == 0)">Download CSV</button>
                        <button class="btn btn-outline-primary btn-sm me-1" @onclick="LoadLocations" disabled="@IsBusy">
                            @if (isLoading && editingLocation == null) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Refresh
                        </button>
                        <button class="btn btn-primary btn-sm" @onclick="ShowCreateForm" disabled="@IsBusy">New Location</button>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (loadError != null)
                    {
                        <div class="alert alert-danger m-3">@loadError</div>
                    }
                    else if (locations.Count > 0)
                    {
                        <div style="max-height: calc(100vh - 260px); overflow-y: auto;">
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th style="width: 140px;">Type</th>
                                        <th style="width: 90px;">Trusted</th>
                                        <th style="width: 140px;">Details</th>
                                        <th style="width: 80px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var loc in locations)
                                    {
                                        <tr class="@(editingLocation?.Id == loc.Id ? "table-active" : "")">
                                            <td>@loc.DisplayName</td>
                                            <td>@(loc.LocationType == NamedLocationType.Ip ? "IP ranges" : "Countries")</td>
                                            <td>@(loc.IsTrusted ? "Yes" : "No")</td>
                                            <td>
                                                <small class="text-muted">
                                                    @if (loc.LocationType == NamedLocationType.Ip)
                                                    {
                                                        @($"{loc.IpRanges.Count} range(s)")
                                                    }
                                                    else
                                                    {
                                                        @($"{loc.CountryCodes.Count} country/region(s)")
                                                    }
                                                </small>
                                            </td>
                                            <td>
                                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => EditLocation(loc)" disabled="@IsBusy">Edit</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else if (!isLoading)
                    {
                        <p class="text-muted p-3 mb-0">No named locations found.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card" style="position: sticky; top: 1rem;">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>@(showForm ? (editingLocation != null ? "Edit Location" : "New Location") : "Location Details")</strong>
                    @if (showForm)
                    {
                        <button class="btn btn-outline-secondary btn-sm" @onclick="CancelForm" disabled="@IsBusy">Cancel</button>
                    }
                </div>
                <div class="card-body">
                    @if (!showForm)
                    {
                        <p class="text-muted mb-3">Select a named location to edit it, or create a new one.</p>
                        <button class="btn btn-primary btn-sm" @onclick="ShowCreateForm" disabled="@IsBusy">New Location</button>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Display Name</label>
                            <input type="text" class="form-control" @bind="formDisplayName" disabled="@IsBusy" />
                        </div>

                        @if (editingLocation == null)
                        {
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Type</label>
                                <select class="form-select" @bind="formType" disabled="@IsBusy">
                                    <option value="ip">IP Ranges</option>
                                    <option value="country">Countries/Regions</option>
                                </select>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Type</label>
                                <input type="text" class="form-control" value="@(editingLocation.LocationType == NamedLocationType.Ip ? "IP Ranges" : "Countries/Regions")" disabled />
                            </div>
                        }

                        @if (EffectiveType == "ip")
                        {
                            <div class="mb-3">
                                <label class="form-label fw-semibold">IP Ranges (CIDR, one per line)</label>
                                <textarea class="form-control" rows="5" @bind="formIpRanges" placeholder="10.0.0.0/8&#10;192.168.1.0/24&#10;2001:db8::/32" disabled="@IsBusy"></textarea>
                            </div>
                            <div class="mb-3 form-check">
                                <input type="checkbox" class="form-check-input" id="chkTrusted" @bind="formIsTrusted" disabled="@IsBusy" />
                                <label class="form-check-label" for="chkTrusted">Mark as trusted</label>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Country Codes (ISO 3166-1 alpha-2)</label>
                                <CountryCodePicker @bind-Value="formCountryCodes" Disabled="@IsBusy" />
                            </div>
                            <div class="mb-3 form-check">
                                <input type="checkbox" class="form-check-input" id="chkUnknown" @bind="formIncludeUnknown" disabled="@IsBusy" />
                                <label class="form-check-label" for="chkUnknown">Include unknown countries/regions</label>
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Ticket Number</label>
                            <input type="text" class="form-control" @bind="formTicketNumber" placeholder="INC/REQ number" disabled="@IsBusy" />
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                @if (editingLocation != null)
                                {
                                    @if (confirmDelete == editingLocation.Id)
                                    {
                                        <button class="btn btn-danger btn-sm me-1" @onclick="() => DeleteLocation(editingLocation)" disabled="@(IsBusy || string.IsNullOrWhiteSpace(formTicketNumber))">Confirm Delete</button>
                                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => confirmDelete = null" disabled="@isOperating">Cancel</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => confirmDelete = editingLocation.Id" disabled="@IsBusy">Delete</button>
                                    }
                                }
                            </div>
                            <button class="btn btn-primary" @onclick="SaveLocation"
                                    disabled="@(IsBusy || string.IsNullOrWhiteSpace(formDisplayName) || string.IsNullOrWhiteSpace(formTicketNumber))">
                                @if (isOperating) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                @(editingLocation != null ? "Update" : "Create")
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string currentUser = "";
    private string clientIpAddress = "Unknown";
    private bool authChecked;
    private bool isLoading;
    private bool isOperating;
    private bool isDownloadingCsv;
    private string? loadError;

    private List<NamedLocation> locations = new();
    private NamedLocationResult? operationResult;
    private string? confirmDelete;

    private bool showForm;
    private NamedLocation? editingLocation;
    private string formDisplayName = "";
    private string formType = "ip";
    private string formIpRanges = "";
    private string formCountryCodes = "";
    private string formTicketNumber = "";
    private bool formIsTrusted;
    private bool formIncludeUnknown;

    private string EffectiveType => editingLocation != null
        ? (editingLocation.LocationType == NamedLocationType.Ip ? "ip" : "country")
        : formType;

    // Page-wide gate, per the owner ruling of 2026-09-17: a control is clickable only when its
    // click will definitively execute. Every operation on this page either replaces the location
    // list underneath the form (LoadLocations) or writes to Graph against a form the operator can
    // still be typing into, so one predicate covers the whole page - there is no second view with
    // a disjoint flag set here. confirmDelete is deliberately NOT a member; see ClickGateRegistry.
    private bool IsBusy => isLoading || isOperating || isDownloadingCsv;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUser = user.Identity?.Name ?? "Unknown";

        var authResult = await AuthorizationService.AuthorizeAsync(user, "NamedLocations");
        if (!authResult.Succeeded)
        {
            Navigation.NavigateTo("access-denied", forceLoad: true);
            return;
        }

        clientIpAddress = ClientInfo.IpAddress != "Unknown"
            ? ClientInfo.IpAddress
            : ClientInfo.GetIpForUser(currentUser);
        authChecked = true;

        await LoadLocations();
    }

    private async Task LoadLocations()
    {
        isLoading = true;
        loadError = null;
        await Task.Yield();
        try
        {
            locations = await LocationService.GetAllAsync();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
            Logger.LogError(ex, "Failed to load named locations");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowCreateForm()
    {
        editingLocation = null;
        formDisplayName = "";
        formType = "ip";
        formIpRanges = "";
        formCountryCodes = "";
        formTicketNumber = "";
        formIsTrusted = false;
        formIncludeUnknown = false;
        showForm = true;
    }

    private void EditLocation(NamedLocation loc)
    {
        confirmDelete = null;
        editingLocation = loc;
        formDisplayName = loc.DisplayName;
        formIpRanges = string.Join("\n", loc.IpRanges);
        formCountryCodes = string.Join("\n", loc.CountryCodes);
        formTicketNumber = "";
        formIsTrusted = loc.IsTrusted;
        formIncludeUnknown = loc.IncludeUnknownCountries;
        showForm = true;
    }

    private void CancelForm()
    {
        confirmDelete = null;
        showForm = false;
        editingLocation = null;
    }

    private async Task SaveLocation()
    {
        isOperating = true;
        operationResult = null;

        // Snapshot the whole form at handler entry. Every input feeding this write carries
        // disabled="@IsBusy", but the browser's copy of that attribute is one round trip stale,
        // and EditLocation and ShowCreateForm blank formTicketNumber outright - so a field read
        // back after an await is not the value the operator clicked Save on. Reading the ticket
        // live used to put a blank ticket in the audit row. Capturing here rather than inside the
        // try is also what lets the catch audit these values at all: declared in the try they
        // would be out of scope there.
        var existing = editingLocation;
        var isIp = EffectiveType == "ip";
        var name = formDisplayName.Trim();
        var values = ParseLines(isIp ? formIpRanges : formCountryCodes);
        var trusted = formIsTrusted;
        var includeUnknown = formIncludeUnknown;
        var ticket = formTicketNumber.Trim();
        var action = existing != null ? "NamedLocations_Update" : "NamedLocations_Create";
        var auditTarget = existing != null ? $"{name} ({existing.Id})" : name;

        await Task.Yield();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authCheck = await AuthorizationService.AuthorizeAsync(authState.User, "NamedLocations");
            if (!authCheck.Succeeded)
            {
                operationResult = new NamedLocationResult { Success = false, Message = "Authorization denied." };
                try { Audit.LogModuleAction(currentUser, clientIpAddress, action, "NamedLocations", auditTarget, false, ticket, "Authorization denied"); } catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for {Action} auth denial", action); }
                return;
            }

            if (values.Count == 0)
            {
                operationResult = new NamedLocationResult
                {
                    Success = false,
                    Message = isIp ? "At least one IP range is required." : "At least one country code is required."
                };
                return;
            }

            // One await site, so the outcome lands in a local. operationResult is a rendered field
            // and the banner dismiss is deliberately left clickable while a refresh or an export
            // is running, so it can be nulled from outside; dereferencing the field after the
            // notification await below threw a NullReferenceException into this handler's own
            // catch, which then audited and emailed a Graph write that had SUCCEEDED as a failure
            // and skipped the confirming refresh.
            var result = await (existing != null
                ? (isIp
                    ? LocationService.UpdateIpLocationAsync(existing.Id, name, values, trusted)
                    : LocationService.UpdateCountryLocationAsync(existing.Id, name, values, includeUnknown))
                : (isIp
                    ? LocationService.CreateIpLocationAsync(name, values, trusted)
                    : LocationService.CreateCountryLocationAsync(name, values, includeUnknown)));
            operationResult = result;

            try { Audit.LogModuleAction(currentUser, clientIpAddress, action, "NamedLocations", auditTarget, result.Success, ticket, result.Success ? null : result.Message); }
            catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for {Action}", action); }

            try { await Email.SendAdminNotificationAsync(currentUser, clientIpAddress, action, result.Success, ticket, new Dictionary<string, string> { ["Location"] = auditTarget }, result.Success ? null : result.Message); }
            catch (Exception emailEx) { Logger.LogError(emailEx, "Email notification failed for {Action}", action); }

            if (result.Success)
            {
                showForm = false;
                editingLocation = null;
                confirmDelete = null;
                await LoadLocations();
            }
        }
        catch (Exception ex)
        {
            operationResult = new NamedLocationResult { Success = false, Message = ex.Message };
            Logger.LogError(ex, "Failed to save named location");
            try { Audit.LogModuleAction(currentUser, clientIpAddress, action, "NamedLocations", auditTarget, false, ticket, ex.Message); } catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for {Action}", action); }
            try { await Email.SendAdminNotificationAsync(currentUser, clientIpAddress, action, false, ticket, new Dictionary<string, string> { ["Location"] = auditTarget }, ex.Message); } catch { }
        }
        finally
        {
            isOperating = false;
        }
    }

    private async Task DeleteLocation(NamedLocation loc)
    {
        isOperating = true;
        operationResult = null;
        confirmDelete = null;

        // Same snapshot obligation as SaveLocation, on the destructive half. loc is a parameter
        // and so is already captured at the click; the ticket is not, and this handler audits it
        // several awaits later, including from its catch. The result goes into a local for the
        // same reason SaveLocation's does: the banner dismiss can null operationResult while this
        // handler is suspended at the notification await.
        var ticket = formTicketNumber.Trim();
        var target = $"{loc.DisplayName} ({loc.Id})";

        await Task.Yield();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authCheck = await AuthorizationService.AuthorizeAsync(authState.User, "NamedLocations");
            if (!authCheck.Succeeded)
            {
                operationResult = new NamedLocationResult { Success = false, Message = "Authorization denied." };
                try { Audit.LogModuleAction(currentUser, clientIpAddress, "NamedLocations_Delete", "NamedLocations", target, false, ticket, "Authorization denied"); } catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for NamedLocations_Delete auth denial"); }
                return;
            }

            var result = await LocationService.DeleteAsync(loc.Id, loc.DisplayName);
            operationResult = result;

            try { Audit.LogModuleAction(currentUser, clientIpAddress, "NamedLocations_Delete", "NamedLocations", target, result.Success, ticket, result.Success ? null : result.Message); }
            catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for NamedLocations delete"); }

            try { await Email.SendAdminNotificationAsync(currentUser, clientIpAddress, "NamedLocations_Delete", result.Success, ticket, new Dictionary<string, string> { ["Location"] = target }, result.Success ? null : result.Message); }
            catch (Exception emailEx) { Logger.LogError(emailEx, "Email notification failed for NamedLocations delete"); }

            if (result.Success)
            {
                showForm = false;
                editingLocation = null;
                confirmDelete = null;
                await LoadLocations();
            }
        }
        catch (Exception ex)
        {
            operationResult = new NamedLocationResult { Success = false, Message = ex.Message };
            Logger.LogError(ex, "Failed to delete named location {Id}", loc.Id);
            try { Audit.LogModuleAction(currentUser, clientIpAddress, "NamedLocations_Delete", "NamedLocations", target, false, ticket, ex.Message); } catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for NamedLocations delete"); }
            try { await Email.SendAdminNotificationAsync(currentUser, clientIpAddress, "NamedLocations_Delete", false, ticket, new Dictionary<string, string> { ["Location"] = target }, ex.Message); } catch { }
        }
        finally
        {
            isOperating = false;
        }
    }

    /// <summary>
    /// Docs/ModuleCsvExport-Plan.md AC3: Name,Type,Trusted,IpRanges,CountryCodes,
    /// IncludeUnknownCountries,Created,Modified. Type is the LocationType enum name;
    /// list-valued cells join with "; "; booleans render lowercase; Created/Modified
    /// are the raw strings (omitted on screen, kept here). Static and argument-fed
    /// so tests call it directly without a page instance.
    /// </summary>
    internal static string BuildCsv(IReadOnlyList<NamedLocation> rows)
    {
        var header = new List<string>
        {
            "Name", "Type", "Trusted", "IpRanges", "CountryCodes",
            "IncludeUnknownCountries", "Created", "Modified"
        };
        var csvRows = rows.Select(r => (IReadOnlyList<string>)new List<string>
        {
            r.DisplayName ?? "",
            r.LocationType.ToString(),
            r.IsTrusted ? "true" : "false",
            string.Join("; ", r.IpRanges ?? new List<string>()),
            string.Join("; ", r.CountryCodes ?? new List<string>()),
            r.IncludeUnknownCountries ? "true" : "false",
            r.CreatedDateTime ?? "",
            r.ModifiedDateTime ?? ""
        });
        return CsvExport.Write(header, csvRows);
    }

    private async Task DownloadCsvAsync()
    {
        // The raise MUST stay below this guard. isDownloadingCsv is a member of IsBusy, and the
        // early return leaves no finally behind it, so a raise above the guard would not grey one
        // button - it would deaden every control on the page, permanently, the first time the
        // operator hit Download CSV with nothing loaded.
        if (locations.Count == 0)
            return;

        isDownloadingCsv = true;

        // Snapshot the list being exported. LoadLocations replaces the field wholesale, so a
        // refresh landing while the JS interop is in flight would otherwise put a different row
        // count in the audit row than the file the operator actually received.
        var rows = locations;
        await Task.Yield();

        try
        {
            var csv = BuildCsv(rows);
            var bytes = System.Text.Encoding.UTF8.GetBytes(csv);
            var base64 = Convert.ToBase64String(bytes);
            var timestamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
            await JS.InvokeVoidAsync("downloadFile", $"NamedLocations_{timestamp}.csv", "text/csv", base64);

            try
            {
                Audit.LogModuleAction(currentUser, clientIpAddress, "ExportCsv", "NamedLocations",
                    $"{rows.Count} rows", true);
            }
            catch (Exception auditEx)
            {
                Logger.LogError(auditEx, "Audit failed for Named Locations CSV export");
            }
        }
        finally
        {
            isDownloadingCsv = false;
        }
    }

    private static List<string> ParseLines(string input) =>
        (input ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(l => !string.IsNullOrWhiteSpace(l))
            .ToList();
}

@page "/self-service-groups"
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using ExchangeAdminWeb.Services.SelfServiceGroups
@attribute [Authorize(Policy = "SelfServiceGroups")]
@rendermode InteractiveServer
@inject SelfServiceGroupService GroupService
@inject AuditService Audit
@inject EmailService Email
@inject ClientInfoService ClientInfo
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager Navigation
@inject ILogger<SelfServiceGroups> Logger

<PageTitle>Self-Service Groups</PageTitle>

@if (!authChecked)
{
    <div class="container-fluid">
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Checking authorization...</span>
            </div>
        </div>
    </div>
    return;
}

<div class="container-fluid">
    @if (selected == null)
    {
        <!-- Browse view: load / list / search. Once a group is selected this whole block is replaced
             by the manage view below, so the management UI sits at the top of the page instead of
             stacking under the browse controls (UX redesign 2026-07-28). -->
        <div class="alert alert-info py-2 mb-3">
            <small>View and manage membership of the on-premises Active Directory groups you own and are
            permitted to update. This page always acts as you, the signed-in user.</small>
        </div>
        <h1 class="mb-4">Self-Service Groups<ModuleVersion /></h1>

        <!-- Load the groups I can manage. Nothing loads on page open (AC2); the load runs a per-group
             ACL read, so the button is disabled and a spinner shown while it runs (plan section 6.4). -->
        <div class="card mb-3">
            <div class="card-body">
                <button class="btn btn-primary" @onclick="LoadOwnedGroups" disabled="@isLoading">
                    @if (isLoading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Load the groups I can manage
                </button>
                @if (isLoading)
                {
                    <span class="ms-2 text-muted">Reading group permissions, this can take a moment...</span>
                }
            </div>
        </div>

        @if (loadError != null)
        {
            <!-- Hard failure: show a clear error, NEVER "no groups found" on failure (AC8). -->
            <div class="alert alert-danger">@loadError</div>
        }
        else if (loaded)
        {
            @if (ownedGroups.Count == 0)
            {
                <div class="alert alert-secondary">You do not own any groups whose membership you can update.</div>
            }
            else
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <!-- In-list filter (AC9): pure client-side filtering over the already-loaded list;
                             matches a mid-name term or a description word, no directory round-trip. -->
                        <div class="input-group input-group-sm mb-3">
                            <span class="input-group-text"><i class="bi bi-funnel"></i></span>
                            <input type="text" class="form-control" @bind="filterTerm" @bind:event="oninput"
                                   placeholder="Filter loaded groups by name or description" />
                            @if (!string.IsNullOrWhiteSpace(filterTerm))
                            {
                                <button class="btn btn-outline-secondary" @onclick="() => filterTerm = string.Empty">Clear</button>
                            }
                        </div>

                        @{
                            var visibleGroups = ManageableGroupFilter.Filter(ownedGroups, filterTerm);
                        }
                        @if (visibleGroups.Count == 0)
                        {
                            <!-- Filtered to nothing: this is a filter result over a loaded list, NOT a load
                                 failure, so it is safe to say the filter matched nothing (distinct from AC8). -->
                            <div class="alert alert-secondary mb-0">No loaded groups match "@filterTerm".</div>
                        }
                        else
                        {
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Type</th>
                                        <th>Other owners</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var g in visibleGroups)
                                    {
                                        var group = g;
                                        <tr>
                                            <td>@group.Name</td>
                                            <td>@group.GroupType</td>
                                            <td>@(group.OtherOwners.Count == 0 ? "-" : string.Join(", ", group.OtherOwners))</td>
                                            <td class="text-end">
                                                <button class="btn btn-outline-primary btn-sm" @onclick="() => SelectGroup(group)">Manage members</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            }
        }

        <!-- On-demand single-group search (plan section 6.3): a user who can manage a group not in the
             list above (e.g. via a direct per-group ACE) types its name. A not-found and a
             not-manageable outcome are deliberately indistinguishable. -->
        <div class="card mb-3">
            <div class="card-header">Find a specific group by name</div>
            <div class="card-body">
                <div class="input-group">
                    <input type="text" class="form-control" @bind="searchName" @bind:event="oninput"
                           @onkeydown="OnSearchKeyDown"
                           placeholder="Exact group name or sAMAccountName" disabled="@isSearching" />
                    <button class="btn btn-outline-primary" @onclick="SearchGroup"
                            disabled="@(isSearching || string.IsNullOrWhiteSpace(searchName))">
                        @if (isSearching) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Search
                    </button>
                </div>

                @if (searchMessage != null)
                {
                    <div class="alert alert-warning mt-3 mb-0">@searchMessage</div>
                }
                else if (searchResult != null)
                {
                    <table class="table table-sm align-middle mt-3 mb-0">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Type</th>
                                <th>Other owners</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>@searchResult.Name</td>
                                <td>@searchResult.GroupType</td>
                                <td>@(searchResult.OtherOwners.Count == 0 ? "-" : string.Join(", ", searchResult.OtherOwners))</td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm" @onclick="() => SelectGroup(searchResult)">Manage members</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }
    else
    {
        <!-- Manage view (plan section 6.5): add/remove a USER member on the selected group. Shown in
             place of the browse view so it is pinned to the top of the page - no scrolling past the
             load/list/search controls to reach it. "Back to groups" returns to the browse view and
             clears the per-group state. Every change re-checks module authorization on the page
             (defense in depth) and the service re-checks group/eligibility/ownership/protection
             immediately before the write (AC5). -->
        <div class="d-flex align-items-center mb-3">
            <button class="btn btn-outline-secondary btn-sm me-3" @onclick="BackToGroups">
                <i class="bi bi-arrow-left"></i> Back to groups
            </button>
            <h1 class="h3 mb-0">Manage members of <strong>@selected.Name</strong>
                <span class="badge bg-light text-dark border ms-1">@selected.GroupType</span></h1>
        </div>

        <div class="card mb-3 border-primary">
            <div class="card-body">
                <p class="text-muted"><small>Only users can be added here, by username, email, or user principal
                name. Nesting a group inside this group requires an IT Support Desk ticket. Membership changes
                take effect in on-premises Active Directory immediately.</small></p>

                <!-- Member identity uses the shared AD user typeahead (plan
                     docs/SelfServiceGroupsMemberListingAndPicker-Plan.md, Option A). The suggestion
                     search runs under the app-pool identity (ADDirectorySearchService), NOT this
                     module's credential; that is accepted because the picker only helps type an
                     identity - the write still re-resolves the user and re-checks eligibility +
                     protection under the module credential in ChangeMemberAsync. -->
                <div class="row g-2 mb-3 align-items-start">
                    <div class="col">
                        <ADIdentityAutocomplete ObjectKind="User" ReturnValueKind="UPN"
                                                @bind-Value="memberIdentity"
                                                Placeholder="Search for a user by name, username, or email"
                                                Disabled="isChanging" />
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-success" @onclick="() => ChangeMember(MembershipOperation.Add)"
                                disabled="@(isChanging || string.IsNullOrWhiteSpace(memberIdentity))">
                            @if (isChanging && pendingOp == MembershipOperation.Add) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Add
                        </button>
                        <button class="btn btn-outline-danger" @onclick="() => ChangeMember(MembershipOperation.Remove)"
                                disabled="@(isChanging || string.IsNullOrWhiteSpace(memberIdentity))">
                            @if (isChanging && pendingOp == MembershipOperation.Remove) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Remove
                        </button>
                    </div>
                </div>

                @if (changeResult != null)
                {
                    <div class="alert @(changeResult.Success ? "alert-success" : "alert-danger") alert-dismissible py-2 mb-3">
                        <small>@changeResult.Message</small>
                        <button type="button" class="btn-close btn-close-sm" @onclick="() => changeResult = null"></button>
                    </div>
                }

                <!-- Current members (plan docs/SelfServiceGroupsMemberListingAndPicker-Plan.md). Loaded
                     on group selection, not on page open. A read failure shows a clear error, NEVER an
                     empty list presented as "no members" (AC-M3, Known Failure Class #2). -->
                <h6 class="mb-2">Current members</h6>
                @if (isLoadingMembers)
                {
                    <div class="text-muted"><span class="spinner-border spinner-border-sm me-1"></span> Loading members...</div>
                }
                else if (memberLoadError != null)
                {
                    <div class="alert alert-danger py-2 mb-0"><small>@memberLoadError</small></div>
                }
                else if (groupMembers.Count == 0)
                {
                    <div class="alert alert-secondary py-2 mb-0"><small>This group has no members.</small></div>
                }
                else
                {
                    <!-- Bulk remove (docs/GroupBulkActions-Plan.md S4): tick rows, one confirmed batch.
                         Every member still runs the SAME per-member handler as the single Remove -
                         RemoveOneAsync - so authorization, eligibility, protection, write, read-back,
                         audit and the affected-user notification are per row; one refusal never hides
                         another (Known Failure Class 2). A nested group in the batch carries the D2
                         one-way warning inside the single confirmation. -->
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => showRemoveConfirm = true"
                                disabled="@(isChanging || SelectedCount == 0)"
                                title="@(SelectedCount == 0 ? "Tick one or more members first." : null)">Remove selected (@SelectedCount)</button>
                        <small class="text-muted">Tick members below and remove them in one confirmed batch. Each member is checked and written on its own, so one refusal never hides another.</small>
                    </div>
                    @if (showRemoveConfirm && SelectedCount > 0)
                    {
                        <div class="alert alert-warning py-2">
                            <div><strong>Remove @SelectedCount member(s) from @selected.Name?</strong></div>
                            <ul class="mb-2 small">
                                @foreach (var sel in SelectedMembers())
                                {
                                    <li>
                                        @sel.DisplayName <span class="text-muted">(@sel.Kind)</span>
                                        @if (sel.Kind == "Group")
                                        {
                                            <div class="text-danger"><strong>@sel.DisplayName</strong> is a group. Removing it takes access away from its members, and re-adding it will require an IT Support Desk ticket.</div>
                                        }
                                    </li>
                                }
                            </ul>
                            <button class="btn btn-danger btn-sm me-1" @onclick="RemoveSelectedAsync" disabled="@isChanging">
                                @if (isChanging) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                Remove @SelectedCount member(s)
                            </button>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => showRemoveConfirm = false" disabled="@isChanging">Cancel</button>
                        </div>
                    }

                    @if (bulkOutcome != null)
                    {
                        <div class="card mb-3">
                            <div class="card-header d-flex justify-content-between align-items-center py-1">
                                <small><strong>@bulkOutcomeTitle</strong></small>
                                <button type="button" class="btn-close btn-close-sm" @onclick="() => bulkOutcome = null"></button>
                            </div>
                            <table class="table table-sm mb-0">
                                <thead><tr><th>Member</th><th>Outcome</th><th>Detail</th></tr></thead>
                                <tbody>
                                    @foreach (var o in bulkOutcome)
                                    {
                                        <tr class="@(o.Done ? "" : "table-danger")">
                                            <td>@o.Label</td>
                                            <td>@(o.Done ? "Done" : "Not done")</td>
                                            <td><small>@o.Message</small></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <!-- Select-all covers only rows whose single Remove renders (CanRemove). -->
                                <th style="width: 2rem;"><input type="checkbox" class="form-check-input" checked="@AllSelectableSelected"
                                                                @onchange="e => ToggleSelectAll(e.Value is true)"
                                                                disabled="@(isChanging || SelectableMembers().Count == 0)"
                                                                title="Select all removable members" /></th>
                                <th>Name</th>
                                <th>Identity</th>
                                <th>Type</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in groupMembers)
                            {
                                var member = m;
                                <tr>
                                    <td><input type="checkbox" class="form-check-input" checked="@selectedGuids.Contains(member.ObjectGuid)"
                                               @onchange="e => ToggleSelected(member, e.Value is true)"
                                               disabled="@(isChanging || !CanRemove(member))"
                                               title="@(CanRemove(member) ? null : "This member cannot be removed here.")" /></td>
                                    <td>@member.DisplayName</td>
                                    <td>@member.Identity</td>
                                    <td>@member.Kind</td>
                                    <td class="text-end">
                                        @if (member.IsRemovable)
                                        {
                                            @if (member.Kind == "Group")
                                            {
                                                <button class="btn btn-outline-danger btn-sm" @onclick="() => BeginGroupRemoval(member)"
                                                        disabled="@isChanging">
                                                    Remove
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline-danger btn-sm" @onclick="() => RemoveMember(member)"
                                                        disabled="@isChanging">
                                                    Remove
                                                </button>
                                            }
                                        }
                                    </td>
                                </tr>
                                @if (pendingGroupRemoval?.ObjectGuid == member.ObjectGuid)
                                {
                                    <!-- D2: a group removal is one-way from the owner's seat, so warn inline beneath
                                         the acting row (the reachable pattern, not a top-of-table confirm) and require
                                         a second action. User removals keep their existing no-confirm behaviour. -->
                                    <tr>
                                        <td colspan="5">
                                            <div class="alert alert-warning py-2 mb-0 d-flex align-items-center justify-content-between">
                                                <small><strong>@member.DisplayName</strong> is a group. Removing it takes access away
                                                from its members, and re-adding it will require an IT Support Desk ticket.</small>
                                                <span class="text-nowrap ms-2">
                                                    <button class="btn btn-danger btn-sm me-1" @onclick="() => ConfirmGroupRemoval(member)"
                                                            disabled="@isChanging">Remove group</button>
                                                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => pendingGroupRemoval = null"
                                                            disabled="@isChanging">Cancel</button>
                                                </span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }
</div>

@code {
    private bool authChecked;
    private string? callerSid;
    private string currentUser = "Unknown";
    private string clientIpAddress = "Unknown";

    private bool isLoading;
    private bool loaded;
    private string? loadError;
    private IReadOnlyList<ManageableGroup> ownedGroups = [];
    private string filterTerm = "";

    private string searchName = "";
    private bool isSearching;
    private string? searchMessage;
    private ManageableGroup? searchResult;

    private ManageableGroup? selected;
    private string memberIdentity = "";
    private bool isChanging;
    private MembershipOperation? pendingOp;
    private PermissionResult? changeResult;
    private GroupMember? pendingGroupRemoval;

    private IReadOnlyList<GroupMember> groupMembers = [];
    private bool isLoadingMembers;
    private string? memberLoadError;

    // Bulk remove state (docs/GroupBulkActions-Plan.md S4). Selection is keyed on the immutable
    // objectGUID, the same key the remove path acts on; it never survives a list reload or a
    // group switch (the gmn-4 shape pendingGroupRemoval already follows).
    private readonly HashSet<string> selectedGuids = new(StringComparer.OrdinalIgnoreCase);
    private bool showRemoveConfirm;
    private List<BulkRowOutcome>? bulkOutcome;
    private string bulkOutcomeTitle = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUser = user.Identity?.Name ?? "Unknown";

        var authResult = await AuthorizationService.AuthorizeAsync(user, "SelfServiceGroups");
        if (!authResult.Succeeded)
        {
            Navigation.NavigateTo("access-denied", forceLoad: true);
            return;
        }

        // The self-service owner is ALWAYS the authenticated Windows principal (AC6). Take the SID
        // from the PrimarySid claim the Negotiate scheme populates; the service re-validates it as a
        // genuine SID and rejects any alternate identity form.
        callerSid = user.FindFirst(ClaimTypes.PrimarySid)?.Value;
        clientIpAddress = ClientInfo.IpAddress != "Unknown"
            ? ClientInfo.IpAddress
            : ClientInfo.GetIpForUser(currentUser);
        authChecked = true;
    }

    private async Task SelectGroup(ManageableGroup group)
    {
        selected = group;
        memberIdentity = "";
        changeResult = null;
        ClearBulkState();
        await LoadMembers();
    }

    // Returns from the manage view to the browse view (UX redesign 2026-07-28) and clears all
    // per-group state so a later selection starts clean.
    private void BackToGroups()
    {
        selected = null;
        memberIdentity = "";
        changeResult = null;
        groupMembers = [];
        memberLoadError = null;
        ClearBulkState();
    }

    // Loads the selected group's current members (AC-M1). Fail-closed display: a read error sets
    // memberLoadError and clears the list so the UI never shows an errored read as "no members"
    // (AC-M3, Known Failure Class #2).
    private async Task LoadMembers()
    {
        if (selected == null)
            return;

        isLoadingMembers = true;
        memberLoadError = null;
        groupMembers = [];
        // gmn-4: a pending group-removal confirm never survives a list reload or a group
        // switch - a stale one would make "Remove group" the FIRST action on another group.
        pendingGroupRemoval = null;
        // Same rule for the bulk selection: a reload invalidates every GUID it held. The
        // outcome table of a batch that just ran is kept - the post-batch refresh comes here.
        selectedGuids.Clear();
        showRemoveConfirm = false;
        try
        {
            if (string.IsNullOrWhiteSpace(callerSid))
                throw new InvalidOperationException("Your Windows identity could not be determined. Sign out and back in, then try again.");

            groupMembers = await GroupService.GetGroupMembersAsync(callerSid, selected.ObjectGuid);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Self-service member load failed for {User} on {Group}", callerSid, selected.Name);
            memberLoadError = "The group's members could not be loaded right now. Please try again; if the problem persists, contact the IT Support Desk.";
        }
        finally
        {
            isLoadingMembers = false;
        }
    }

    // List Remove entry (AC-M2): user rows remove directly; group rows arrive via the inline
    // confirm (BeginGroupRemoval), per D2's one-way warning.
    private async Task RemoveMember(GroupMember member)
    {
        await RemoveListedMember(member);
    }

    // D2: first click on a group's Remove only opens the inline warning beneath the row; the
    // removal itself needs the second action in ConfirmGroupRemoval.
    private void BeginGroupRemoval(GroupMember member)
    {
        changeResult = null;
        pendingGroupRemoval = member;
    }

    private async Task ConfirmGroupRemoval(GroupMember member)
    {
        // gmn-4: the second action must confirm exactly the row the warning was opened for; a
        // stale or mismatched pending state performs no removal.
        if (pendingGroupRemoval?.ObjectGuid != member.ObjectGuid)
        {
            pendingGroupRemoval = null;
            return;
        }
        pendingGroupRemoval = null;
        await RemoveListedMember(member);
    }

    // List-driven removal, keyed on the member's immutable objectGUID (nesting plan S4): a display
    // identity can drift or collide between the list render and the write; the GUID cannot. This
    // is also the only path that can remove a nested GROUP (D2). Same audit-first, best-effort
    // notify contract as the typed path.
    private async Task RemoveListedMember(GroupMember member)
    {
        if (selected == null || isChanging)
            return;

        // Snapshot before the first await: group navigation stays live while awaits run.
        var group = selected;
        isChanging = true;
        pendingOp = MembershipOperation.Remove;
        changeResult = null;
        await Task.Yield();

        // The per-member path - authorization re-check, eligibility/protection-gated service
        // write, audit, admin email and the affected-member notification - is RemoveOneAsync,
        // shared byte-for-byte with the bulk loop (docs/GroupBulkActions-Plan.md S4, AC3). It
        // never throws.
        try
        {
            var outcome = await RemoveOneAsync(group, member, sendAdminEmail: true);
            changeResult = outcome.Done ? PermissionResult.Ok(outcome.Message) : PermissionResult.Fail(outcome.Message);
        }
        finally
        {
            isChanging = false;
            pendingOp = null;
        }

        // Reflect the change in the displayed membership (AC-M2), as on the typed path.
        if (changeResult?.Success == true && ReferenceEquals(selected, group))
            await LoadMembers();
    }

    /// <summary>
    /// The per-member remove: the ONE place the single Remove (user rows directly, group rows
    /// via the D2 inline confirm) and the bulk loop both go through
    /// (docs/GroupBulkActions-Plan.md S4, AC3). Runs the module authorization re-check
    /// immediately before THIS row's write (gba-1; Constitution: every mutating operation
    /// re-checks authorization immediately before the write - a batch must not carry a stale
    /// page-level answer across rows), then the service call (which re-checks eligibility and
    /// protection itself), then the per-member audit on every branch, then the per-member admin
    /// email when asked (the bulk loop sends one summary instead, plan D1), and ALWAYS the
    /// affected-member notification on the existing predicate - it goes to a different
    /// recipient per row. Never throws: an exception is a Not done row, audited.
    /// </summary>
    private async Task<BulkRowOutcome> RemoveOneAsync(ManageableGroup group, GroupMember member, bool sendAdminEmail)
    {
        var memberLabel = string.IsNullOrWhiteSpace(member.Identity) ? member.DistinguishedName : member.Identity;
        const string action = "SelfServiceGroups_RemoveMember";
        try
        {
            if (string.IsNullOrWhiteSpace(callerSid))
                throw new InvalidOperationException("Your Windows identity could not be determined. Sign out and back in, then try again.");

            // Defense in depth (AC5), same as the typed path: re-check module authorization on the
            // page before the write; the service re-checks group/eligibility/ownership/protection
            // immediately before writing.
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authCheck = await AuthorizationService.AuthorizeAsync(authState.User, "SelfServiceGroups");
            if (!authCheck.Succeeded)
            {
                try { Audit.LogModuleAction(currentUser, clientIpAddress, action, "SelfServiceGroups", group.Name, false, "", "Authorization denied", new Dictionary<string, object?> { ["member"] = memberLabel, ["memberObjectGuid"] = member.ObjectGuid }); } catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for {Action} auth denial", action); }
                return new BulkRowOutcome(member.DisplayName, false, "Authorization denied.");
            }

            // The row's own DN rides along with its GUID: the service resolves the member in the
            // domain that DN names, which is the only way a cross-domain nested group resolves at
            // all (2026-09-02). The GUID stays the identity that is acted on.
            var outcome = await GroupService.RemoveListedMemberAsync(callerSid, group.ObjectGuid, member.ObjectGuid, authState.User, member.DistinguishedName);

            var changeExtra = new Dictionary<string, object?> { ["member"] = memberLabel, ["memberObjectGuid"] = member.ObjectGuid };
            // A serviced override succeeded, so it cannot ride errorDetail - that field is written
            // as null on success and the record of who permitted it would vanish.
            if (!string.IsNullOrWhiteSpace(outcome.Result.ServicedNote))
                changeExtra[ProtectedPrincipalServicing.AuditKey] = outcome.Result.ServicedNote;

            // Audit-first, best-effort notify (owner decision B, 2026-07-27), as on the typed path.
            try { Audit.LogModuleAction(currentUser, clientIpAddress, action, "SelfServiceGroups", group.Name, outcome.Result.Success, "", outcome.Result.Success ? null : outcome.Result.Message, changeExtra); } catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for {Action}", action); }

            var memberDetail = string.IsNullOrWhiteSpace(outcome.AffectedMemberDisplayName) ? memberLabel : $"{outcome.AffectedMemberDisplayName} ({memberLabel})";
            if (sendAdminEmail)
            {
                try { await Email.SendAdminNotificationAsync(currentUser, clientIpAddress, action, outcome.Result.Success, "", new Dictionary<string, string> { ["Group"] = group.Name, ["Member Removed"] = memberDetail }, outcome.Result.Success ? null : outcome.Result.Message); } catch (Exception emailEx) { Logger.LogError(emailEx, "Admin notification failed for {Action}", action); }
            }

            // Affected-member notification rides the SAME predicate as a user's (D6): for a group
            // the address is the group's mail attribute; no mail, no notification. Per member in
            // a batch too - each row has its own recipient.
            if (outcome.NotifyAffectedUser)
            {
                try { await Email.SendGroupMembershipUserNotificationAsync(outcome.AffectedMemberEmail!, group.Name, currentUser, false); } catch (Exception emailEx) { Logger.LogError(emailEx, "Affected-user notification failed for {Action}", action); }
            }

            return new BulkRowOutcome(member.DisplayName, outcome.Result.Success, outcome.Result.Message);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Self-service list removal failed for {User} on {Group}", callerSid, group.Name);
            try { Audit.LogModuleAction(currentUser, clientIpAddress, action, "SelfServiceGroups", group.Name, false, "", ex.Message, new Dictionary<string, object?> { ["member"] = memberLabel, ["memberObjectGuid"] = member.ObjectGuid }); } catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for {Action}", action); }
            return new BulkRowOutcome(member.DisplayName, false, "The change could not be completed right now. Please try again; if the problem persists, contact the IT Support Desk.");
        }
    }

    // ----- Bulk remove (docs/GroupBulkActions-Plan.md S4) -----

    /// <summary>Same predicate as the single Remove button's rendering: only a removable row with an immutable id can be acted on.</summary>
    private static bool CanRemove(GroupMember m) => m.IsRemovable && !string.IsNullOrEmpty(m.ObjectGuid);

    private List<GroupMember> SelectableMembers() => groupMembers.Where(CanRemove).ToList();

    private List<GroupMember> SelectedMembers() => SelectableMembers().Where(m => selectedGuids.Contains(m.ObjectGuid)).ToList();

    private int SelectedCount => SelectedMembers().Count;

    private bool AllSelectableSelected
    {
        get
        {
            var selectable = SelectableMembers();
            return selectable.Count > 0 && selectable.All(m => selectedGuids.Contains(m.ObjectGuid));
        }
    }

    private void ToggleSelected(GroupMember m, bool on)
    {
        showRemoveConfirm = false;
        pendingGroupRemoval = null;
        if (!CanRemove(m))
            return;
        if (on) selectedGuids.Add(m.ObjectGuid); else selectedGuids.Remove(m.ObjectGuid);
    }

    // Select-all covers only the rows the single Remove could act on (AC1).
    private void ToggleSelectAll(bool on)
    {
        showRemoveConfirm = false;
        pendingGroupRemoval = null;
        selectedGuids.Clear();
        if (on)
            foreach (var m in SelectableMembers())
                selectedGuids.Add(m.ObjectGuid);
    }

    private void ClearBulkState()
    {
        selectedGuids.Clear();
        showRemoveConfirm = false;
        bulkOutcome = null;
    }

    private void AuditBatch(string action, ManageableGroup group, bool success, string? errorDetail, int requested, int done, int notDone, IReadOnlyList<string> memberLines)
    {
        try { Audit.LogModuleAction(currentUser, clientIpAddress, action, "SelfServiceGroups", group.Name, success, "", errorDetail, new Dictionary<string, object?> { ["requested"] = requested, ["done"] = done, ["notDone"] = notDone, ["members"] = memberLines }); } catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for {Action}", action); }
    }

    /// <summary>
    /// Removes every ticked member, one at a time, in list order, through RemoveOneAsync - the
    /// same handler as the single Remove - so per-row authorization, eligibility, protection,
    /// write, read-back, audit and affected-member notification are the single path's, and one
    /// refusal never hides another. After the loop: one batch summary audit whose success is
    /// true ONLY when every row is Done (Known Failure Class 2), one summary admin email (plan
    /// D1), one member-list reload. The upfront authorization check is a UX shortcut - the check
    /// that counts runs inside RemoveOneAsync per row (gba-1). Self-service has no ticket.
    /// </summary>
    private async Task RemoveSelectedAsync()
    {
        // Snapshot the group AND the rows before the first await.
        var group = selected;
        var rows = SelectedMembers();
        showRemoveConfirm = false;
        pendingGroupRemoval = null;
        if (group is null || rows.Count == 0 || isChanging)
            return;

        isChanging = true;
        pendingOp = MembershipOperation.Remove;
        changeResult = null;
        bulkOutcome = null;
        await Task.Yield();

        const string action = "SelfServiceGroups_BulkRemoveMembers";
        var notAttempted = rows.Select(r => $"{r.DisplayName}: Not attempted").ToList();
        try
        {
            if (string.IsNullOrWhiteSpace(callerSid))
            {
                changeResult = PermissionResult.Fail("Your Windows identity could not be determined. Sign out and back in, then try again.");
                AuditBatch(action, group, false, "Caller SID unavailable", rows.Count, 0, 0, notAttempted);
                return;
            }

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authCheck = await AuthorizationService.AuthorizeAsync(authState.User, "SelfServiceGroups");
            if (!authCheck.Succeeded)
            {
                changeResult = PermissionResult.Fail("Authorization denied.");
                AuditBatch(action, group, false, "Authorization denied", rows.Count, 0, 0, notAttempted);
                return;
            }

            var outcomes = new List<BulkRowOutcome>(rows.Count);
            foreach (var row in rows)
                outcomes.Add(await RemoveOneAsync(group, row, sendAdminEmail: false));

            var summary = BulkOutcomeSummary.Of(outcomes);
            AuditBatch(action, group, summary.Success, summary.ErrorDetail, summary.Requested, summary.Done, summary.NotDone, summary.MemberLines);
            try { await Email.SendAdminNotificationAsync(currentUser, clientIpAddress, action, summary.Success, "", new Dictionary<string, string> { ["Group"] = group.Name, ["Requested"] = summary.Requested.ToString(), ["Done"] = summary.Done.ToString(), ["Not done"] = summary.NotDone.ToString(), ["Members"] = string.Join("; ", summary.MemberLines) }, summary.ErrorDetail); } catch (Exception emailEx) { Logger.LogError(emailEx, "Admin notification failed for {Action}", action); }

            selectedGuids.Clear();
            bulkOutcome = outcomes;
            bulkOutcomeTitle = $"Remove selected: {summary.Done} of {summary.Requested} removed";
            changeResult = summary.Success
                ? PermissionResult.Ok($"{summary.Done} member(s) removed from {group.Name}.")
                : PermissionResult.Fail($"{summary.NotDone} of {summary.Requested} member(s) were not removed - see the outcome table.");
        }
        finally
        {
            isChanging = false;
            pendingOp = null;
        }

        // One reload for the whole batch, only if the operator is still looking at this group
        // (LoadMembers keeps the outcome table).
        if (ReferenceEquals(selected, group))
            await LoadMembers();
    }

    private async Task ChangeMember(MembershipOperation operation, string? explicitIdentity = null)
    {
        var identity = (explicitIdentity ?? memberIdentity).Trim();
        if (selected == null || isChanging || string.IsNullOrWhiteSpace(identity))
            return;

        isChanging = true;
        pendingOp = operation;
        changeResult = null;
        await Task.Yield();

        var group = selected;
        var member = identity;
        var action = operation == MembershipOperation.Add ? "SelfServiceGroups_AddMember" : "SelfServiceGroups_RemoveMember";
        try
        {
            if (string.IsNullOrWhiteSpace(callerSid))
                throw new InvalidOperationException("Your Windows identity could not be determined. Sign out and back in, then try again.");

            // Defense in depth (AC5): re-check module authorization on the page before the write; the
            // circuit principal can be stale. The service also re-checks group/eligibility/ownership/
            // protection immediately before writing.
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authCheck = await AuthorizationService.AuthorizeAsync(authState.User, "SelfServiceGroups");
            if (!authCheck.Succeeded)
            {
                changeResult = PermissionResult.Fail("Authorization denied.");
                try { Audit.LogModuleAction(currentUser, clientIpAddress, action, "SelfServiceGroups", group.Name, false, "", "Authorization denied", new Dictionary<string, object?> { ["member"] = member }); } catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for {Action} auth denial", action); }
                return;
            }

            var outcome = await GroupService.ChangeMemberAsync(callerSid, group.ObjectGuid, member, operation, authState.User);
            changeResult = outcome.Result;

            var changeExtra = new Dictionary<string, object?> { ["member"] = member };
            // A serviced override succeeded, so it cannot ride errorDetail - that field is written
            // as null on success and the record of who permitted it would vanish.
            if (!string.IsNullOrWhiteSpace(outcome.Result.ServicedNote))
                changeExtra[ProtectedPrincipalServicing.AuditKey] = outcome.Result.ServicedNote;

            // Audit-first, best-effort notify (owner decision B, 2026-07-27): the audit record is
            // written FIRST and its own failure is logged, never allowed to mask the operation; the
            // notifications are best-effort and never change the result the user sees (Constitution
            // "Notifications"). No background worker / outbox.
            try { Audit.LogModuleAction(currentUser, clientIpAddress, action, "SelfServiceGroups", group.Name, outcome.Result.Success, "", outcome.Result.Success ? null : outcome.Result.Message, changeExtra); } catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for {Action}", action); }

            var memberDetail = string.IsNullOrWhiteSpace(outcome.AffectedMemberDisplayName) ? member : $"{outcome.AffectedMemberDisplayName} ({member})";
            try { await Email.SendAdminNotificationAsync(currentUser, clientIpAddress, action, outcome.Result.Success, "", new Dictionary<string, string> { ["Group"] = group.Name, [operation == MembershipOperation.Add ? "Member Added" : "Member Removed"] = memberDetail }, outcome.Result.Success ? null : outcome.Result.Message); } catch (Exception emailEx) { Logger.LogError(emailEx, "Admin notification failed for {Action}", action); }

            // Affected-user notification only when the service confirms a real security-group change
            // with a known address (AC10; the NotifyAffectedUser gate encapsulates the rule).
            if (outcome.NotifyAffectedUser)
            {
                try { await Email.SendGroupMembershipUserNotificationAsync(outcome.AffectedMemberEmail!, group.Name, currentUser, operation == MembershipOperation.Add); } catch (Exception emailEx) { Logger.LogError(emailEx, "Affected-user notification failed for {Action}", action); }
            }

            if (outcome.Result.Success)
                memberIdentity = "";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Self-service membership change failed for {User} on {Group}", callerSid, group.Name);
            changeResult = PermissionResult.Fail("The change could not be completed right now. Please try again; if the problem persists, contact the IT Support Desk.");
            try { Audit.LogModuleAction(currentUser, clientIpAddress, action, "SelfServiceGroups", group.Name, false, "", ex.Message, new Dictionary<string, object?> { ["member"] = member }); } catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for {Action}", action); }
        }
        finally
        {
            isChanging = false;
            pendingOp = null;
        }

        // Reflect the change in the displayed membership (AC-M2): a successful add/remove refreshes the
        // list so the added member appears / the removed row disappears. A failed change leaves the list
        // as-is. Runs after isChanging is cleared so the list's Remove buttons re-enable.
        if (changeResult?.Success == true)
            await LoadMembers();
    }

    private async Task LoadOwnedGroups()
    {
        if (isLoading)
            return;

        isLoading = true;
        loadError = null;
        loaded = false;
        filterTerm = "";
        try
        {
            if (string.IsNullOrWhiteSpace(callerSid))
                throw new InvalidOperationException("Your Windows identity could not be determined. Sign out and back in, then try again.");

            ownedGroups = await GroupService.GetOwnedGroupsAsync(callerSid);
            loaded = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Self-service owned-groups load failed for {User}", callerSid);
            loadError = "The groups could not be loaded right now. Please try again; if the problem persists, contact the IT Support Desk.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnSearchKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(searchName) && !isSearching)
            await SearchGroup();
    }

    private async Task SearchGroup()
    {
        if (isSearching || string.IsNullOrWhiteSpace(searchName))
            return;

        isSearching = true;
        searchMessage = null;
        searchResult = null;
        try
        {
            if (string.IsNullOrWhiteSpace(callerSid))
                throw new InvalidOperationException("Your Windows identity could not be determined. Sign out and back in, then try again.");

            var result = await GroupService.SearchManageableGroupAsync(callerSid, searchName);
            if (result.Group != null)
                searchResult = result.Group;
            else
                searchMessage = result.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Self-service group search failed for {User}", callerSid);
            searchMessage = "The search could not be completed right now. Please try again; if the problem persists, contact the IT Support Desk.";
        }
        finally
        {
            isSearching = false;
        }
    }
}

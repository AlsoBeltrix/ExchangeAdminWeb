@page "/emergency-disable"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "EmergencyDisable")]
@rendermode InteractiveServer
@inject EmergencyDisableService DisableService
@inject IActivityProgress Progress
@inject ProtectedPrincipalService ProtectedPrincipalService
@inject ProtectedPrincipalServicerService Servicers
@inject AuditService Audit
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager Navigation
@inject ClientInfoService ClientInfo
@inject ILogger<EmergencyDisable> Logger
@inject ModuleConfigService ModuleConfig

<PageTitle>Emergency Disable</PageTitle>

@if (!authChecked)
{
    @* NO SPINNER. No module draws its own progress (owner ruling 2026-10-02,
       `.agents/decisions.md`), and nothing replaces this one: GroupAuthorizationHandler is
       synchronous end to end, so the check finishes faster than a frame and a bar line
       flickering inside a single render is noise, not information.
       The GUARD stays and must stay - it is what stops the page rendering before the check
       has passed, which is refusal, not progress. Kept at the SAME LINE COUNT as the markup
       it replaces, so not one ClickGateRegistry line key moves. *@
    return;
}

<div class="container-fluid">
    <div class="alert alert-danger py-2 mb-3">
        <small><strong>High-Impact Operation:</strong> Disabling an account revokes all sessions, resets the password, and blocks sign-in across AD and Entra ID. This action is audited and security team is notified immediately.</small>
    </div>
    <h1 class="mb-4">Emergency Disable<ModuleVersion /></h1>

    @if (operationResult != null)
    {
        <div class="alert @(operationResult.Value.success ? "alert-success" : "alert-danger") alert-dismissible">
            @operationResult.Value.message
            <button type="button" class="btn-close" @onclick="() => operationResult = null"></button>
        </div>
    }

    <div class="row g-3">
        <div class="col-lg-8">
            <!-- Search -->
            <div class="card mb-3">
                <div class="card-body">
                    <div class="input-group">
                        <input type="text" class="form-control" @bind="searchIdentity" @bind:event="oninput"
                               @onkeydown="OnSearchKeyDown"
                               placeholder="UPN or email of the account to disable" disabled="@(isLoading || isDisabling)" />
                        <button class="btn btn-danger" @onclick="PerformLookup"
                                disabled="@(isLoading || isDisabling || string.IsNullOrWhiteSpace(searchIdentity))">
                            Lookup
                        </button>
                    </div>
                </div>
            </div>

            @if (lookupError != null)
            {
                <div class="alert alert-danger">@lookupError</div>
            }

            @if (protectedBlocked)
            {
                <div class="alert alert-warning">
                    <strong>Protected Principal:</strong> This account is protected and cannot be disabled through this interface.
                </div>
            }

            <!-- Identity Summary -->
            @if (resolvedPrincipal != null && !protectedBlocked)
            {
                <div class="card mb-3 border-danger">
                    <div class="card-header bg-danger text-white"><strong>Target Account</strong></div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-6"><small class="text-muted">Display Name</small><br /><strong>@resolvedPrincipal.DisplayName</strong></div>
                            <div class="col-sm-6"><small class="text-muted">UPN</small><br />@resolvedPrincipal.UserPrincipalName</div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-sm-6"><small class="text-muted">sAMAccountName</small><br />@(resolvedPrincipal.SamAccountName ?? "—")</div>
                            <div class="col-sm-6"><small class="text-muted">DN</small><br /><small>@(resolvedPrincipal.DistinguishedName ?? "—")</small></div>
                        </div>
                    </div>
                </div>
            }

            <!-- Step Results -->
            @if (disableResult != null)
            {
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Operation Steps</strong>
                        @if (disableResult.Snapshot != null)
                        {
                            <small class="text-muted">ID: @disableResult.Snapshot.OperationId[..12]...</small>
                        }
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Step</th>
                                    <th style="width: 100px;">Status</th>
                                    <th>Detail</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var step in disableResult.Steps)
                                {
                                    var rowClass = EmergencyDisableService.RowClassFor(step.Status);
                                    <tr class="@rowClass">
                                        <td>@step.Step</td>
                                        <td><strong>@step.Status</strong></td>
                                        <td><small>@step.Detail</small></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <button class="btn btn-outline-secondary" @onclick="ResetForm">New Operation</button>
            }
        </div>

        <!-- Right Panel: Confirm -->
        <div class="col-lg-4">
            <div class="card" style="position: sticky; top: 1rem;">
                @if (resolvedPrincipal != null && !protectedBlocked && disableResult == null)
                {
                    <div class="card-header bg-danger text-white"><strong>Confirm Disable</strong></div>
                    <div class="card-body">
                        <p class="mb-2">You are about to:</p>
                        <ul class="mb-3" style="font-size: 0.9em;">
                            <li>Disable the AD account</li>
                            <li>Reset password to random value</li>
                            <li>Revoke all Entra ID sessions</li>
                            <li>Disable Entra ID sign-in</li>
                            @if (moveToLockdownOu)
                            {
                                <li>Move the account to the lockdown OU</li>
                            }
                        </ul>
                        <p class="text-danger mb-3"><strong>This is not easily reversible.</strong></p>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Ticket Number</label>
                            <input type="text" class="form-control" @bind="ticketNumber" @bind:event="oninput" placeholder="INC/REQ number" disabled="@isDisabling" />
                        </div>
                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="chkConfirm" @bind="confirmed" disabled="@isDisabling" />
                            <label class="form-check-label" for="chkConfirm">I understand this will immediately lock out <strong>@resolvedPrincipal.DisplayName</strong></label>
                        </div>
                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="chkLockdown" @bind="moveToLockdownOu"
                                   disabled="@(isDisabling || !lockdownOuConfigured)" />
                            <label class="form-check-label" for="chkLockdown">Move to the lockdown OU</label>
                            @if (!lockdownOuConfigured)
                            {
                                <div class="form-text text-muted">
                                    Unavailable: no lockdown OU is configured for this module. Set one in Admin Settings to enable this step.
                                </div>
                            }
                            else if (!moveToLockdownOu)
                            {
                                @* Muted, not danger. Since the owner's 2026-10-06 ruling this is the
                                   DEFAULT state, and a default must not be styled as an error - that
                                   was edl-1. It says what ticking buys rather than scolding the
                                   operator for a box they have not touched. *@
                                <div class="form-text text-muted">
                                    Tick this to also move the account out of reach of routine helpdesk re-enablement.
                                </div>
                            }
                        </div>
                        <button class="btn btn-danger w-100" @onclick="ExecuteDisable"
                                disabled="@(isDisabling || !confirmed || string.IsNullOrWhiteSpace(ticketNumber))">
                            Disable Account Now
                        </button>
                    </div>
                }
                else if (disableResult != null)
                {
                    <div class="card-header"><strong>Result</strong></div>
                    <div class="card-body">
                        @if (disableResult.Success)
                        {
                            <p class="text-success"><strong>Account disabled successfully.</strong></p>
                            <p class="text-muted">Security team has been notified. A snapshot has been saved for potential re-enablement.</p>
                        }
                        else
                        {
                            <p class="text-danger"><strong>Operation failed or partially completed.</strong></p>
                            <p class="text-muted">Review the step results. Manual follow-up may be required for failed steps.</p>
                        }
                    </div>
                }
                else
                {
                    <div class="card-header"><strong>Instructions</strong></div>
                    <div class="card-body">
                        <p class="text-muted mb-2">1. Enter the UPN or email of the compromised account</p>
                        <p class="text-muted mb-2">2. Verify the resolved identity</p>
                        <p class="text-muted mb-2">3. Enter a ticket number</p>
                        <p class="text-muted mb-0">4. Confirm and execute</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string currentUser = "";
    private string clientIpAddress = "Unknown";
    private bool authChecked;
    private bool isLoading;
    private bool isDisabling;

    private string searchIdentity = "";
    private string? lookupError;
    private bool protectedBlocked;

    /// <summary>Module id for the servicer grant. Must match the catalog descriptor.</summary>
    private const string ServicerModuleId = "EmergencyDisable";

    // Set when an authorised servicer overrode the protected-principal refusal at lookup, and
    // carried into the disable call so the service-side gate reaches the same decision.
    private string? servicedNote;
    private ResolvedDirectoryPrincipal? resolvedPrincipal;

    private string ticketNumber = "";
    private bool confirmed;

    // Default CHECKED: the lockdown move is the protection the step exists to provide, and the
    // owner asked for the escape hatch to be an opt-OUT (2026-10-05). The checkbox carries the
    /// <summary>
    /// Whether the lockdown step starts armed. **Owner ruling 2026-10-06: UNCHECKED**, which
    /// supersedes the 2026-10-05 ruling that made it an opt-out (default checked). The step is
    /// therefore opt-IN: an emergency disable does not move the account unless the operator
    /// says so on that run.
    ///
    /// One constant rather than a literal at each site, because the default is the thing most
    /// likely to be changed again and it has to move in all three places at once - the field
    /// initialiser, the post-auth read, and the fresh-operation reset. Getting one of those
    /// wrong is edl-3.
    /// </summary>
    private const bool LockdownDefaultArmed = false;

    // Never armed when no lockdown OU is configured, whatever the default says: the operator
    // cannot arm a step that cannot run. The service refuses independently either way, so this
    // is a courtesy to the operator and not the control.
    private bool moveToLockdownOu = LockdownDefaultArmed;
    private bool lockdownOuConfigured;
    private EmergencyDisableResult? disableResult;
    private (bool success, string message)? operationResult;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUser = user.Identity?.Name ?? "Unknown";

        var authResult = await AuthorizationService.AuthorizeAsync(user, "EmergencyDisable");
        if (!authResult.Succeeded)
        {
            Navigation.NavigateTo("access-denied", forceLoad: true);
            return;
        }

        clientIpAddress = ClientInfo.IpAddress != "Unknown"
            ? ClientInfo.IpAddress
            : ClientInfo.GetIpForUser(currentUser);

        // Read once. An unconfigured lockdown OU makes the step unavailable rather than
        // failing a checked run mid-disable; the service refuses independently, so this gate
        // is a courtesy to the operator and not the control.
        lockdownOuConfigured = !string.IsNullOrWhiteSpace(ModuleConfig.GetValue("EmergencyDisable", "LockdownOuDn"));
        moveToLockdownOu = LockdownDefaultArmed && lockdownOuConfigured;

        authChecked = true;
    }

    private async Task OnSearchKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(searchIdentity) && !isLoading && !isDisabling)
            await PerformLookup();
    }

    /// <summary>
    /// Resolves the typed identity and decides whether it may be disabled at all.
    /// </summary>
    /// <remarks>
    /// The module shipped two days before docs/ProgressCoverage-Plan.md's survey and this is its
    /// one gap: the operator's first action on the page, and the slowest thing they wait on here,
    /// ran with the frame reading Idle.
    ///
    /// TWO covered calls, which is the shape rather than belt and braces.
    /// ResolveWithExchangeFallbackAsync is three waits in a trench coat - a Delinea fetch for the
    /// directory-read credential over HTTP, a 2-permit AD throttle that can hold for 30 seconds,
    /// a DirectorySearcher, and on a cloud-only target the 10-15 second Exchange fallback - and
    /// CheckAsync below it is remote CONDITIONALLY, answering from the config store unless
    /// protected GROUP rules are configured, in which case it queries the directory. Naming only
    /// the first would leave the second held by nothing; naming only the second would prove
    /// nothing about the resolve, which is the one the operator actually waits on.
    ///
    /// ONE Complete, in the finally, reading a LOCAL set at whichever exit was reached - and the
    /// scanner forces that rather than taste. ProgressScan.ActivitiesIn takes the FIRST
    /// activity.Complete( after the Begin as the window's close, and this handler's earliest exit
    /// sits BETWEEN the two covered calls, so a Complete written there would unpin CheckAsync on
    /// every path including the one that reaches it. ADAttributeEditor.PerformSearch is the shape
    /// this copies, down to the tuple.
    ///
    /// The five outcomes are not all failures, and the distinction is the reviewer's 2026-10-08
    /// ruling - "did the work complete", not "did the operator get what they wanted". A directory
    /// that could not be reached and a protection read that failed closed are work that did NOT
    /// finish, so they are non-success. An ambiguous identity is a refusal, so it is too. But an
    /// identity that simply is not there is a lookup that RAN and found nothing, and a protected
    /// principal is a lookup that finished in a read-only state - AdminEventLog's empty date
    /// range and ADAttributeEditor's IsReadOnly path, both TRUE. An unhandled throw leaves the
    /// local null and falls to the dispose fallback, which is what that fallback is for.
    ///
    /// No snapshot: the search box at :51 is disabled="@(isLoading || isDisabling)" and the raise
    /// is above the yield, so the field is shut for the whole window. identity is hoisted for the
    /// LABEL, and the three reads below it become one.
    /// </remarks>
    private async Task PerformLookup()
    {
        isLoading = true;
        BeginNewOperation();

        var identity = searchIdentity.Trim();

        (bool Success, string? Message)? completed = null;
        using var activity = Progress.Begin(
            "Emergency Disable", $"Looking up {identity}", ActivitySize.Unknown);

        await Task.Yield();

        try
        {
            // Was ResolveDirectoryPrincipalAsync, which is a wrapper that discards the status and
            // returns a bare null. That collapsed two different answers into one: "no such user"
            // and "the directory did not answer" both rendered as a typo message, so an AD outage
            // told the operator to check their spelling. It also missed cloud-only targets
            // entirely. docs/ProtectedPrincipalGapFix-Plan.md GAP B.
            var (resolved, resolveStatus) = await ProtectedPrincipalService.ResolveWithExchangeFallbackAsync(identity);

            if (resolveStatus is ProtectedPrincipalService.ResolutionStatus.Unavailable
                              or ProtectedPrincipalService.ResolutionStatus.Ambiguous)
            {
                lookupError = resolveStatus == ProtectedPrincipalService.ResolutionStatus.Ambiguous
                    ? $"'{identity}' is ambiguous - it matches multiple directory objects. Contact your administrator."
                    : "The directory could not be reached, so protection cannot be verified. Try again shortly or contact your administrator.";

                // An ambiguous identity is a refusal and an unreachable directory is work that
                // did not finish; neither is a success.
                completed = (false, lookupError);
                return;
            }

            if (resolved == null)
            {
                lookupError = $"'{identity}' was not found in Active Directory or Exchange Online. Verify the UPN or email.";

                // TRUE: the resolve ran, reached both directories and answered. Nothing there is
                // an answer, not a failure of the lookup.
                completed = (true, $"'{identity}' was not found.");
                return;
            }

            var protectionCheck = await ProtectedPrincipalService.CheckAsync(resolved);
            if (protectionCheck.CheckFailed)
            {
                lookupError = protectionCheck.Reason;

                // Fail-closed: the protection read did not finish, so neither did this.
                completed = (false, protectionCheck.Reason);
                return;
            }
            if (protectionCheck.IsProtected)
            {
                resolvedPrincipal = resolved;

                // This gate hides the whole write UI, so it must honour servicing too - otherwise
                // an authorised servicer could never reach the button, and the service-side check
                // that also honours it would be unreachable. Both gates must agree; only the
                // service one is authoritative for the write.
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                servicedNote = ProtectedPrincipalServicing.NoteFor(
                    Servicers, authState.User, ServicerModuleId, protectionCheck.MatchedRules);

                protectedBlocked = servicedNote is null;

                // TRUE: the lookup finished, and "this account is protected" is its answer.
                // ADAttributeEditor.PerformSearch's IsReadOnly path, same ruling.
                completed = (true, protectedBlocked
                    ? $"{resolved.DisplayName} is a protected principal."
                    : $"{resolved.DisplayName} is protected; servicing applies.");
                return;
            }

            resolvedPrincipal = resolved;
            completed = (true, $"{resolved.DisplayName} resolved.");
        }
        catch (Exception ex)
        {
            lookupError = ex.Message;
            Logger.LogError(ex, "Emergency disable lookup failed for {Identity}", searchIdentity);
        }
        finally
        {
            isLoading = false;

            // Reads the LOCAL, never lookupError or resolvedPrincipal: isLoading drops on the
            // line above with no await before this, but the fields are what the banner renders
            // and a local cannot be edited by anything else. An unhandled throw leaves it null
            // and the using ends the activity with the dispose fallback.
            if (completed is { } outcome)
                activity.Complete(outcome.Success, outcome.Message);
        }
    }

    private async Task ExecuteDisable()
    {
        if (resolvedPrincipal == null || !confirmed) return;
        isDisabling = true;
        operationResult = null;
        await Task.Yield();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authCheck = await AuthorizationService.AuthorizeAsync(authState.User, "EmergencyDisable");
            if (!authCheck.Succeeded)
            {
                operationResult = (false, "Authorization denied.");
                return;
            }

            // A multi-step write across AD and the session stores, so the operator needs to see
            // it is still going rather than clicking a second time on an account disable.
            using var activity = Progress.Begin(
                "Emergency Disable", $"Disabling {resolvedPrincipal.DisplayName}", ActivitySize.Unknown);

            disableResult = await DisableService.DisableAsync(resolvedPrincipal, ticketNumber.Trim(), currentUser, clientIpAddress, authState.User, moveToLockdownOu);
            activity.Complete(disableResult.Success, disableResult.Error);

            if (disableResult.Success)
            {
                operationResult = (true, $"Account {resolvedPrincipal.DisplayName} has been disabled. Security team notified.");
            }
            else
            {
                operationResult = (false, disableResult.Error ?? "Operation failed or partially completed. Review step results.");
            }
        }
        catch (Exception ex)
        {
            operationResult = (false, ex.Message);
            Logger.LogError(ex, "Emergency disable execution failed");
        }
        finally
        {
            isDisabling = false;
        }
    }

    private void ResetForm()
    {
        searchIdentity = "";
        BeginNewOperation();
    }

    /// <summary>
    /// Clears everything that belongs to ONE disable operation. Both entry points that start a
    /// fresh one - a new lookup and the New Operation button - go through here, so the set can
    /// only be got wrong in one place.
    ///
    /// edl-3 was exactly the alternative: the two call sites each cleared their own list,
    /// PerformLookup was missed, and an operator who declined the lockdown for one account
    /// carried that decision onto the next person they looked up. The lockdown checkbox returns
    /// to its DEFAULT here - whatever that default currently is - rather than carrying the last
    /// operation.s choice forward onto a different person.
    /// </summary>
    private void BeginNewOperation()
    {
        lookupError = null;
        protectedBlocked = false;
        servicedNote = null;
        resolvedPrincipal = null;
        disableResult = null;
        operationResult = null;
        confirmed = false;
        ticketNumber = "";
        moveToLockdownOu = LockdownDefaultArmed && lockdownOuConfigured;
    }
}

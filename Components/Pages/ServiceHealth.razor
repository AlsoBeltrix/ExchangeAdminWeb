@page "/service-health"
@using Microsoft.AspNetCore.Authorization
@using System.Text.RegularExpressions
@attribute [Authorize(Policy = "ServiceHealth")]
@rendermode InteractiveServer
@inject ServiceHealthService HealthService
@inject AuditService Audit
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager Navigation
@inject ClientInfoService ClientInfo
@inject ILogger<ServiceHealth> Logger

<PageTitle>Service Health</PageTitle>

@if (!authChecked)
{
    <div class="container-fluid">
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Checking authorization...</span>
            </div>
        </div>
    </div>
    return;
}

<div class="container-fluid">
    <div class="alert alert-info py-2 mb-3">
        <small>Current Microsoft 365 service status and the tenant's open service incidents, read live from Microsoft. Read-only.</small>
    </div>
    <h1 class="mb-4">Service Health<ModuleVersion /></h1>

    @if (!HealthService.IsAvailable)
    {
        <div class="alert alert-danger">Service Health module is not configured. Set Graph App Delinea Secret ID in Module Config.</div>
        return;
    }

    <div class="d-flex align-items-center gap-3 mb-3">
        <button class="btn btn-outline-primary btn-sm" @onclick="RefreshAsync" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                <span>Refreshing...</span>
            }
            else
            {
                <span>Refresh</span>
            }
        </button>
        @if (status != null)
        {
            <small class="text-muted">Last updated @status.LastUpdatedUtc.ToLocalTime().ToString("g")</small>
        }
    </div>

    @if (loadError != null)
    {
        @* AC6: a failed fetch must never render as a healthy, empty board. *@
        <div class="alert alert-danger">
            <strong>Could not read service health.</strong>
            <div class="mt-1"><small>@loadError</small></div>
        </div>
    }
    else if (isLoading && status == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading service health...</span>
            </div>
        </div>
    }
    else if (status != null)
    {
        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="card h-100">
                    <div class="card-body py-3">
                        <div class="text-muted small">Services</div>
                        <div class="fs-3">@status.TotalServices</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card h-100">
                    <div class="card-body py-3">
                        <div class="text-muted small">Healthy</div>
                        <div class="fs-3 text-success">@status.HealthyServices</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card h-100">
                    <div class="card-body py-3">
                        <div class="text-muted small">Not healthy</div>
                        <div class="fs-3 @(status.DegradedServices > 0 ? "text-danger" : "")">@status.DegradedServices</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card h-100">
                    <div class="card-body py-3">
                        <div class="text-muted small">Open incidents</div>
                        <div class="fs-3 @(status.ActiveIssues > 0 ? "text-danger" : "")">@status.ActiveIssues</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-2 align-items-end mb-2">
            <div class="col-md-4">
                <label class="form-label mb-1" for="service-filter">Find a service</label>
                <input id="service-filter" class="form-control form-control-sm" type="search"
                       placeholder="Name, wildcards allowed (exch*)"
                       value="@nameFilter"
                       @oninput="OnNameFilterChanged" />
            </div>
            <div class="col-md-3">
                <label class="form-label mb-1" for="status-filter">Status</label>
                <select id="status-filter" class="form-select form-select-sm" value="@statusFilter"
                        @onchange="e => statusFilter = e.Value?.ToString() ?? AllFilter">
                    <option value="@AllFilter">All statuses</option>
                    <option value="@NotHealthyFilter">Anything not healthy</option>
                    <option value="@WithIssuesFilter">Has open incidents</option>
                    <option value="serviceInterruption">Interrupted</option>
                    <option value="serviceDegradation">Degraded</option>
                    <option value="serviceOperational">Healthy</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label mb-1" for="sort-order">Sort by</label>
                <select id="sort-order" class="form-select form-select-sm" value="@sortOrder"
                        @onchange="e => sortOrder = e.Value?.ToString() ?? SortByStatus">
                    <option value="@SortByStatus">Status, then name</option>
                    <option value="@SortByIssues">Open incidents</option>
                    <option value="@SortByName">Name</option>
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-secondary btn-sm w-100" @onclick="ClearFilters"
                        disabled="@(nameFilter.Length == 0 && statusFilter == AllFilter && sortOrder == SortByStatus)">
                    Reset
                </button>
            </div>
        </div>

        var visibleServices = SortServices(FilterServices(status, nameFilter, statusFilter), status, sortOrder);

        <div class="d-flex justify-content-between align-items-center mb-2">
            <small class="text-muted">
                Showing @visibleServices.Count of @status.TotalServices services. Select one to read its incidents.
            </small>
            @if (visibleServices.Count > 0)
            {
                <button class="btn btn-link btn-sm p-0" @onclick="() => ToggleAll(visibleServices)">
                    @(expandedServices.Count > 0 ? "Collapse all" : "Expand all with incidents")
                </button>
            }
        </div>

        @if (status.Services.Count == 0)
        {
            <div class="alert alert-warning">Microsoft returned no services for this tenant.</div>
        }
        else if (visibleServices.Count == 0)
        {
            <div class="alert alert-secondary">No services match the current filters.</div>
        }
        else
        {
            <div class="mb-4">
                @foreach (var service in visibleServices)
                {
                    var serviceIssues = status.IssuesFor(service.Id);
                    var isExpanded = expandedServices.Contains(service.Id);
                    <div class="card mb-2">
                        <div class="card-body py-2" role="button" @onclick="() => ToggleService(service.Id, serviceIssues)"
                             title="Show the incidents for this service">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <span>
                                    <span class="text-muted me-2">@(isExpanded ? "-" : "+")</span>
                                    <strong>@service.DisplayName</strong>
                                </span>
                                <span class="text-nowrap">
                                    @if (serviceIssues.Count > 0)
                                    {
                                        <span class="badge bg-secondary me-1">
                                            @serviceIssues.Count @(serviceIssues.Count == 1 ? "incident" : "incidents")
                                        </span>
                                    }
                                    <span class="badge @ServiceBadgeClass(service.Status)">@service.StatusText</span>
                                </span>
                            </div>
                        </div>
                        @if (isExpanded)
                        {
                            <div class="card-body border-top">
                                @if (serviceIssues.Count == 0)
                                {
                                    <div class="text-muted small">
                                        <em>Microsoft has no open incidents or advisories for this service.</em>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var issue in serviceIssues)
                                    {
                                        @IncidentCard(issue)
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private const string AllFilter = "all";
    private const string NotHealthyFilter = "notHealthy";
    private const string WithIssuesFilter = "withIssues";
    private const string SortByStatus = "status";
    private const string SortByName = "name";
    private const string SortByIssues = "issues";

    private bool authChecked;
    private bool isLoading;
    private string currentUser = "";
    private string clientIpAddress = "";
    private string? loadError;
    private ServiceHealthStatus? status;
    private string nameFilter = "";
    private string statusFilter = AllFilter;
    private string sortOrder = SortByStatus;
    private readonly HashSet<string> expandedIssues = [];
    private readonly HashSet<string> expandedServices = [];

    /// <summary>
    /// One incident, rendered under the service it belongs to. Opening the service opens these
    /// with it - the operator asked one question ("what is wrong with Exchange") and should not
    /// have to click again to get the answer. The header still collapses a long one back down.
    /// </summary>
    private RenderFragment<ServiceIncident> IncidentCard => issue =>
    @<div class="card mb-2">
        <div class="card-header py-2" role="button" @onclick="() => ToggleIssue(issue.Id)">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <div>
                    <span class="badge @ClassificationBadgeClass(issue) me-2">@(issue.IsIncident ? "Incident" : "Advisory")</span>
                    <strong>@issue.Id</strong>
                    <span class="ms-2">@issue.Title</span>
                    <div class="text-muted small mt-1">
                        @if (!string.IsNullOrEmpty(issue.StatusText))
                        {
                            <span>@issue.StatusText</span>
                        }
                        @if (issue.StartDateTime != null)
                        {
                            <span> &middot; started @issue.StartDateTime.Value.ToLocalTime().ToString("g")</span>
                        }
                        @if (!issue.IsResolved)
                        {
                            <span class="text-danger"> &middot; ongoing</span>
                        }
                    </div>
                </div>
                <span class="text-muted small text-nowrap">@(expandedIssues.Contains(issue.Id) ? "Collapse" : "Expand")</span>
            </div>
        </div>
        @if (expandedIssues.Contains(issue.Id))
        {
            <div class="card-body">
                <dl class="row mb-3 small">
                    @if (!string.IsNullOrEmpty(issue.Feature))
                    {
                        <dt class="col-sm-3">Feature</dt>
                        <dd class="col-sm-9">@issue.Feature</dd>
                    }
                    @if (!string.IsNullOrEmpty(issue.FeatureGroup))
                    {
                        <dt class="col-sm-3">Feature group</dt>
                        <dd class="col-sm-9">@issue.FeatureGroup</dd>
                    }
                    @if (!string.IsNullOrEmpty(issue.Origin))
                    {
                        <dt class="col-sm-3">Origin</dt>
                        <dd class="col-sm-9">@issue.Origin</dd>
                    }
                    @if (issue.EndDateTime != null)
                    {
                        <dt class="col-sm-3">Resolved</dt>
                        <dd class="col-sm-9">@issue.EndDateTime.Value.ToLocalTime().ToString("g")</dd>
                    }
                    @if (issue.LastModifiedDateTime != null)
                    {
                        <dt class="col-sm-3">Last modified</dt>
                        <dd class="col-sm-9">@issue.LastModifiedDateTime.Value.ToLocalTime().ToString("g")</dd>
                    }
                </dl>

                @if (!string.IsNullOrEmpty(issue.ImpactDescriptionHtml))
                {
                    <div class="mb-3">
                        <div class="text-muted small text-uppercase mb-1">User impact</div>
                        @* Sanitized in ServiceHealthService before it ever reaches this page. *@
                        <div>@((MarkupString)issue.ImpactDescriptionHtml)</div>
                    </div>
                }

                @foreach (var detail in issue.Details)
                {
                    <div class="mb-3">
                        <div class="text-muted small text-uppercase mb-1">@detail.Name</div>
                        @* Sanitized in ServiceHealthService before it ever reaches this page. *@
                        <div>@((MarkupString)detail.ValueHtml)</div>
                    </div>
                }

                <div class="text-muted small text-uppercase mb-2">Updates</div>
                @if (issue.Posts.Count == 0)
                {
                    <div class="text-muted"><em>Microsoft has not posted an update on this issue yet.</em></div>
                }
                else
                {
                    @foreach (var post in issue.Posts)
                    {
                        <div class="border-start ps-3 mb-3">
                            <div class="text-muted small">
                                @(post.CreatedDateTime?.ToLocalTime().ToString("g") ?? "Undated")
                                @if (!string.IsNullOrEmpty(post.PostType))
                                {
                                    <span> &middot; @post.PostType</span>
                                }
                            </div>
                            @* Sanitized in ServiceHealthService before it ever reaches this page. *@
                            <div>@((MarkupString)post.ContentHtml)</div>
                        </div>
                    }
                }
            </div>
        }
    </div>;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUser = user.Identity?.Name ?? "Unknown";

        var authResult = await AuthorizationService.AuthorizeAsync(user, "ServiceHealth");
        if (!authResult.Succeeded)
        {
            Navigation.NavigateTo("access-denied", forceLoad: true);
            return;
        }

        clientIpAddress = ClientInfo.IpAddress != "Unknown"
            ? ClientInfo.IpAddress
            : ClientInfo.GetIpForUser(currentUser);
        authChecked = true;

        await LoadAsync(forceRefresh: false);
    }

    private Task RefreshAsync() => LoadAsync(forceRefresh: true);

    private async Task LoadAsync(bool forceRefresh)
    {
        isLoading = true;
        loadError = null;
        await Task.Yield();
        try
        {
            status = await HealthService.GetStatusAsync(forceRefresh);
            Audit.LogLookupAction(currentUser, clientIpAddress, "ServiceHealthView",
                "Microsoft 365 service health", true,
                extra: new Dictionary<string, object?>
                {
                    ["Refresh"] = forceRefresh,
                    ["Services"] = status.TotalServices,
                    ["OpenIssues"] = status.ActiveIssues
                });
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
            Logger.LogError(ex, "Failed to load Microsoft 365 service health");
            Audit.LogLookupAction(currentUser, clientIpAddress, "ServiceHealthView",
                "Microsoft 365 service health", false, ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleIssue(string issueId)
    {
        if (!expandedIssues.Remove(issueId))
            expandedIssues.Add(issueId);
    }

    /// <summary>
    /// Opening a service opens its incidents with it, details and all. Closing it puts them back.
    /// </summary>
    private void ToggleService(string serviceId, List<ServiceIncident> serviceIssues)
    {
        if (expandedServices.Remove(serviceId))
        {
            foreach (var issue in serviceIssues) expandedIssues.Remove(issue.Id);
            return;
        }

        expandedServices.Add(serviceId);
        foreach (var issue in serviceIssues) expandedIssues.Add(issue.Id);
    }

    private void ToggleAll(List<ServiceHealthEntry> visibleServices)
    {
        if (expandedServices.Count > 0)
        {
            expandedServices.Clear();
            expandedIssues.Clear();
            return;
        }

        foreach (var service in visibleServices)
        {
            var issues = status?.IssuesFor(service.Id) ?? [];
            if (issues.Count == 0) continue;
            expandedServices.Add(service.Id);
            foreach (var issue in issues) expandedIssues.Add(issue.Id);
        }
    }

    private void OnNameFilterChanged(ChangeEventArgs e) => nameFilter = e.Value?.ToString() ?? "";

    private void ClearFilters()
    {
        nameFilter = "";
        statusFilter = AllFilter;
        sortOrder = SortByStatus;
    }

    /// <summary>
    /// Pure projector, exposed for tests. The name box is a wildcard match against the display
    /// name and the service id - "*" or empty means everything, and a pattern with no wildcard in
    /// it is treated as "contains", which is what an operator typing "exch" expects.
    /// </summary>
    internal static List<ServiceHealthEntry> FilterServices(
        ServiceHealthStatus status, string nameFilter, string statusFilter) =>
        status.Services
            .Where(s => MatchesName(s, nameFilter))
            .Where(s => statusFilter switch
            {
                AllFilter => true,
                NotHealthyFilter => !s.IsHealthy,
                WithIssuesFilter => status.IssueCountFor(s.Id) > 0,
                _ => string.Equals(s.Status, statusFilter, StringComparison.OrdinalIgnoreCase)
            })
            .ToList();

    internal static bool MatchesName(ServiceHealthEntry service, string pattern)
    {
        if (string.IsNullOrWhiteSpace(pattern)) return true;

        var trimmed = pattern.Trim();
        if (trimmed == "*") return true;

        if (!trimmed.Contains('*') && !trimmed.Contains('?'))
            return service.DisplayName.Contains(trimmed, StringComparison.OrdinalIgnoreCase)
                || service.Id.Contains(trimmed, StringComparison.OrdinalIgnoreCase);

        var regex = "^" + Regex.Escape(trimmed).Replace("\\*", ".*").Replace("\\?", ".") + "$";
        return Regex.IsMatch(service.DisplayName, regex, RegexOptions.IgnoreCase)
            || Regex.IsMatch(service.Id, regex, RegexOptions.IgnoreCase);
    }

    /// <summary>
    /// Pure projector, exposed for tests. Default is worst-first then alphabetical, so the board
    /// opens on what is broken rather than on whatever order Graph happened to return.
    /// </summary>
    internal static List<ServiceHealthEntry> SortServices(
        List<ServiceHealthEntry> services, ServiceHealthStatus status, string sortOrder) => sortOrder switch
        {
            SortByName => [.. services.OrderBy(s => s.DisplayName, StringComparer.OrdinalIgnoreCase)],
            SortByIssues =>
            [
                .. services
                    .OrderByDescending(s => status.IssueCountFor(s.Id))
                    .ThenBy(s => StatusRank(s.Status))
                    .ThenBy(s => s.DisplayName, StringComparer.OrdinalIgnoreCase)
            ],
            _ =>
            [
                .. services
                    .OrderBy(s => StatusRank(s.Status))
                    .ThenByDescending(s => status.IssueCountFor(s.Id))
                    .ThenBy(s => s.DisplayName, StringComparer.OrdinalIgnoreCase)
            ]
        };

    /// <summary>
    /// Severity order for the default sort. An unrecognised future status sorts above healthy,
    /// not below it - the same fail-loud choice ServiceHealthEntry.IsHealthy makes.
    /// </summary>
    internal static int StatusRank(string status) => status switch
    {
        "serviceInterruption" => 0,
        "serviceDegradation" => 1,
        "extendedRecovery" or "restoringService" or "restoreService" or "investigating" => 2,
        "falsePositive" => 8,
        "serviceOperational" => 9,
        _ => 5
    };

    /// <summary>Pure projector, exposed for the source-text page tests.</summary>
    internal static string StatusBadgeClass(bool isHealthy) => isHealthy ? "bg-success" : "bg-danger";

    /// <summary>
    /// Pure projector, exposed for tests. Degraded and interrupted are different severities to an
    /// operator, so they do not share one red badge.
    /// </summary>
    internal static string ServiceBadgeClass(string status) => status switch
    {
        "serviceOperational" => "bg-success",
        "serviceDegradation" => "bg-warning text-dark",
        "serviceInterruption" => "bg-danger",
        "extendedRecovery" or "restoringService" or "restoreService" or "investigating" => "bg-warning text-dark",
        "falsePositive" => "bg-secondary",
        _ => "bg-secondary"
    };

    /// <summary>Pure projector, exposed for the source-text page tests.</summary>
    internal static string ClassificationBadgeClass(ServiceIncident issue) =>
        issue.IsIncident ? "bg-danger" : "bg-warning text-dark";
}

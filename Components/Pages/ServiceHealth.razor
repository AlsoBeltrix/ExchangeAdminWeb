@page "/service-health"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "ServiceHealth")]
@rendermode InteractiveServer
@inject ServiceHealthService HealthService
@inject AuditService Audit
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager Navigation
@inject ClientInfoService ClientInfo
@inject ILogger<ServiceHealth> Logger

<PageTitle>Service Health</PageTitle>

@if (!authChecked)
{
    <div class="sh-loading">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Checking authorization...</span>
        </div>
    </div>
    return;
}

<div class="sh-page">

    <div class="sh-header">
        <h1><i class="bi bi-activity"></i> Microsoft 365 Service Health<ModuleVersion /></h1>
        <div class="sh-header-right">
            @if (status != null)
            {
                <span class="sh-updated">Last updated @status.LastUpdatedUtc.ToLocalTime().ToString("g")</span>
            }
            <button class="sh-refresh" @onclick="RefreshAsync" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                    <span>Refreshing...</span>
                }
                else
                {
                    <i class="bi bi-arrow-clockwise"></i>
                    <span>Refresh</span>
                }
            </button>
        </div>
    </div>

    @if (!HealthService.IsAvailable)
    {
        <div class="sh-error">Service Health module is not configured. Set Graph App Delinea Secret ID in Module Config.</div>
        return;
    }

    @if (loadError != null)
    {
        @* AC6: a failed fetch must never render as a healthy, empty board. *@
        <div class="sh-error">
            <strong>Could not read service health.</strong>
            <div class="mt-1"><small>@loadError</small></div>
        </div>
    }
    else if (isLoading && status == null)
    {
        <div class="sh-loading">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading service health...</span>
            </div>
        </div>
    }
    else if (status != null)
    {
        var visibleServices = SortServices(FilterServices(status, serviceFilter, statusFilter), status, sortOrder);
        var visibleIssues = IssuesFor(status, visibleServices);

        <div class="sh-summary">
            <div class="sh-card">
                <div class="sh-card-header">
                    <i class="bi bi-hdd-stack"></i>
                    <h3>Total Services</h3>
                </div>
                <div class="sh-metric">@status.TotalServices</div>
            </div>
            <div class="sh-card">
                <div class="sh-card-header">
                    <i class="bi bi-check-circle-fill"></i>
                    <h3>Healthy Services</h3>
                </div>
                <div class="sh-metric healthy">@status.HealthyServices</div>
            </div>
            <div class="sh-card">
                <div class="sh-card-header">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <h3>Active Issues</h3>
                </div>
                <div class="sh-metric warning">@ActiveIssueCount(status)</div>
            </div>
            <div class="sh-card">
                <div class="sh-card-header">
                    <i class="bi bi-x-circle-fill"></i>
                    <h3>Services Degraded</h3>
                </div>
                <div class="sh-metric error">@status.DegradedServices</div>
            </div>
        </div>

        <div class="sh-filters">
            <div class="sh-filter-group">
                <label for="service-filter">Filter by Service:</label>
                <select id="service-filter" value="@serviceFilter"
                        @onchange="e => serviceFilter = e.Value?.ToString() ?? AllFilter">
                    <option value="@AllFilter">All Services</option>
                    @foreach (var service in status.Services.OrderBy(s => s.DisplayName, StringComparer.OrdinalIgnoreCase))
                    {
                        <option value="@service.Id">@service.DisplayName</option>
                    }
                </select>
            </div>
            <div class="sh-filter-group">
                <label for="status-filter">Filter by Status:</label>
                <select id="status-filter" value="@statusFilter"
                        @onchange="e => statusFilter = e.Value?.ToString() ?? AllFilter">
                    <option value="@AllFilter">All Statuses</option>
                    <option value="serviceOperational">Healthy</option>
                    <option value="serviceDegradation">Degraded</option>
                    <option value="serviceInterruption">Interrupted</option>
                    <option value="@NotHealthyFilter">Anything not healthy</option>
                    <option value="@WithIssuesFilter">Has open incidents</option>
                </select>
            </div>
            <div class="sh-filter-group">
                <label for="sort-order">Sort by:</label>
                <select id="sort-order" value="@sortOrder"
                        @onchange="e => sortOrder = e.Value?.ToString() ?? SortByStatus">
                    <option value="@SortByStatus">Status, then name</option>
                    <option value="@SortByIssues">Open incidents</option>
                    <option value="@SortByName">Name</option>
                </select>
            </div>
            <div class="sh-filter-group">
                <label for="clear-filters">&nbsp;</label>
                <button id="clear-filters" class="btn btn-outline-secondary btn-sm" @onclick="ClearFilters"
                        disabled="@(serviceFilter == AllFilter && statusFilter == AllFilter && sortOrder == SortByStatus)">
                    Show everything
                </button>
            </div>
        </div>

        <div class="sh-services-grid">
            @if (visibleServices.Count == 0)
            {
                <div class="sh-no-results">No services match your filter criteria.</div>
            }
            else
            {
                @foreach (var service in visibleServices)
                {
                    var issueCount = status.IssueCountFor(service.Id);
                    <button type="button" class="sh-service-card @SelectedClass(service.Id)" data-status="@service.Status"
                            title="Show only this service's incidents"
                            @onclick="() => SelectService(service.Id)">
                        <div class="sh-service-header">
                            <i class="bi @StatusIcon(service.Status) @StatusIconClass(service.Status)"></i>
                            <h3>@service.DisplayName</h3>
                        </div>
                        <div class="sh-service-summary">
                            <span class="sh-status-badge status-@service.Status">@service.StatusText</span>
                            @if (issueCount > 0)
                            {
                                <span class="sh-issue-count">@issueCount @(issueCount == 1 ? "issue" : "issues")</span>
                            }
                        </div>
                    </button>
                }
            }
        </div>

        <div class="sh-issues-section">
            <h2><i class="bi bi-exclamation-circle-fill"></i> Current Issues</h2>

            @if (visibleIssues.Count == 0)
            {
                <div class="sh-no-issues">
                    <i class="bi bi-check-circle-fill"></i> No issues for selected filters
                </div>
            }
            else
            {
                @foreach (var issue in visibleIssues)
                {
                    @IncidentCard(issue)
                }
            }
        </div>
    }
</div>

@code {
    private const string AllFilter = "all";
    private const string NotHealthyFilter = "notHealthy";
    private const string WithIssuesFilter = "withIssues";
    private const string SortByStatus = "status";
    private const string SortByName = "name";
    private const string SortByIssues = "issues";

    private bool authChecked;
    private bool isLoading;
    private string currentUser = "";
    private string clientIpAddress = "";
    private string? loadError;
    private ServiceHealthStatus? status;
    private string serviceFilter = AllFilter;
    private string statusFilter = AllFilter;
    private string sortOrder = SortByStatus;
    private readonly HashSet<string> expandedIssues = [];

    /// <summary>
    /// One issue card, matching the original dashboard: a clickable header with the status icon,
    /// title and issue id, a summary line, and everything else behind the expansion.
    /// </summary>
    private RenderFragment<ServiceIncident> IncidentCard => issue =>
    @<div class="sh-issue-card @(expandedIssues.Contains(issue.Id) ? "expanded" : "")">
        <button type="button" class="sh-issue-header" @onclick="() => ToggleIssue(issue.Id)">
            <i class="bi @IssueIcon(issue) @IssueIconClass(issue)"></i>
            <h4>@issue.Title</h4>
            <span class="sh-issue-id">ID: @issue.Id</span>
            <i class="bi @(expandedIssues.Contains(issue.Id) ? "bi-chevron-up" : "bi-chevron-down")"></i>
        </button>

        <div class="sh-issue-summary">
            <div><strong>Service:</strong> @issue.ServiceName</div>
            <div><strong>Started:</strong> @Stamp(issue.StartDateTime)</div>
            @if (issue.EndDateTime != null)
            {
                <div><strong>Resolved:</strong> @Stamp(issue.EndDateTime)</div>
            }
            <div><strong>Type:</strong> @(issue.IsIncident ? "Incident" : "Advisory")</div>
        </div>

        @if (expandedIssues.Contains(issue.Id))
        {
            <div class="sh-issue-expanded-details">
                @if (!string.IsNullOrEmpty(issue.Feature) || !string.IsNullOrEmpty(issue.FeatureGroup))
                {
                    <div class="sh-issue-summary">
                        @if (!string.IsNullOrEmpty(issue.Feature))
                        {
                            <div><strong>Feature:</strong> @issue.Feature</div>
                        }
                        @if (!string.IsNullOrEmpty(issue.FeatureGroup))
                        {
                            <div><strong>Feature Group:</strong> @issue.FeatureGroup</div>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(issue.ImpactDescriptionHtml))
                {
                    <h5>User Impact:</h5>
                    @* Sanitized in ServiceHealthService before it ever reaches this page. *@
                    <div class="sh-issue-description">@((MarkupString)issue.ImpactDescriptionHtml)</div>
                }

                @if (issue.Details.Count > 0)
                {
                    <h5>Details:</h5>
                    @foreach (var detail in issue.Details)
                    {
                        <div class="sh-detail-item">
                            <h6>@Humanize(detail.Name)</h6>
                            @* Sanitized in ServiceHealthService before it ever reaches this page. *@
                            <div>@((MarkupString)detail.ValueHtml)</div>
                        </div>
                    }
                }

                <h5>Updates:</h5>
                @if (issue.Posts.Count == 0)
                {
                    <div class="sh-detail-item">Microsoft has not posted an update on this issue yet.</div>
                }
                else
                {
                    @foreach (var post in issue.Posts.OrderByDescending(p => p.CreatedDateTime ?? DateTimeOffset.MinValue))
                    {
                        <div class="sh-issue-post">
                            <div class="sh-post-header">
                                @Stamp(post.CreatedDateTime)
                                @if (!string.IsNullOrEmpty(post.PostType))
                                {
                                    <span> &middot; @post.PostType</span>
                                }
                            </div>
                            @* Sanitized in ServiceHealthService before it ever reaches this page. *@
                            <div>@((MarkupString)post.ContentHtml)</div>
                        </div>
                    }
                }

                <div class="sh-issue-metadata">
                    <div><strong>Status:</strong> @issue.StatusText</div>
                    @if (!string.IsNullOrEmpty(issue.Origin))
                    {
                        <div><strong>Origin:</strong> @issue.Origin</div>
                    }
                    <div><strong>Last Modified:</strong> @Stamp(issue.LastModifiedDateTime)</div>
                </div>
            </div>
        }

        @if (!issue.IsResolved)
        {
            <div class="sh-issue-ongoing"><i class="bi bi-exclamation-triangle-fill"></i> Ongoing Issue</div>
        }
    </div>;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUser = user.Identity?.Name ?? "Unknown";

        var authResult = await AuthorizationService.AuthorizeAsync(user, "ServiceHealth");
        if (!authResult.Succeeded)
        {
            Navigation.NavigateTo("access-denied", forceLoad: true);
            return;
        }

        clientIpAddress = ClientInfo.IpAddress != "Unknown"
            ? ClientInfo.IpAddress
            : ClientInfo.GetIpForUser(currentUser);
        authChecked = true;

        await LoadAsync(forceRefresh: false);
    }

    private Task RefreshAsync() => LoadAsync(forceRefresh: true);

    private async Task LoadAsync(bool forceRefresh)
    {
        isLoading = true;
        loadError = null;
        await Task.Yield();
        try
        {
            status = await HealthService.GetStatusAsync(forceRefresh);
            Audit.LogLookupAction(currentUser, clientIpAddress, "ServiceHealthView",
                "Microsoft 365 service health", true,
                extra: new Dictionary<string, object?>
                {
                    ["Refresh"] = forceRefresh,
                    ["Services"] = status.TotalServices,
                    ["OpenIssues"] = status.ActiveIssues
                });
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
            Logger.LogError(ex, "Failed to load Microsoft 365 service health");
            Audit.LogLookupAction(currentUser, clientIpAddress, "ServiceHealthView",
                "Microsoft 365 service health", false, ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>
    /// Clicking a service card narrows the whole board to that service, exactly as the original
    /// dashboard does. Clicking the selected card again puts everything back.
    /// </summary>
    private void SelectService(string serviceId)
    {
        serviceFilter = serviceFilter == serviceId ? AllFilter : serviceId;
    }

    private string SelectedClass(string serviceId) => serviceFilter == serviceId ? "selected" : "";

    private void ToggleIssue(string issueId)
    {
        if (!expandedIssues.Remove(issueId))
            expandedIssues.Add(issueId);
    }

    private void ClearFilters()
    {
        serviceFilter = AllFilter;
        statusFilter = AllFilter;
        sortOrder = SortByStatus;
    }

    private static string Stamp(DateTimeOffset? value) =>
        value?.ToLocalTime().ToString("g") ?? "Unknown";

    /// <summary>
    /// The original counts an issue as active when Microsoft has not stamped an end time on it,
    /// which is not the same as its isResolved flag. Kept identical so the two boards agree.
    /// </summary>
    internal static int ActiveIssueCount(ServiceHealthStatus status) =>
        status.Issues.Count(i => i.EndDateTime == null);

    /// <summary>
    /// Pure projector, exposed for tests. The service dropdown carries a service id, so it is an
    /// exact match, never a substring one - "Teams" must not also select "Microsoft Teams Live".
    /// </summary>
    internal static List<ServiceHealthEntry> FilterServices(
        ServiceHealthStatus status, string serviceFilter, string statusFilter) =>
        status.Services
            .Where(s => serviceFilter == AllFilter
                || string.IsNullOrWhiteSpace(serviceFilter)
                || string.Equals(s.Id, serviceFilter, StringComparison.OrdinalIgnoreCase))
            .Where(s => statusFilter switch
            {
                AllFilter => true,
                NotHealthyFilter => !s.IsHealthy,
                WithIssuesFilter => status.IssueCountFor(s.Id) > 0,
                _ => string.Equals(s.Status, statusFilter, StringComparison.OrdinalIgnoreCase)
            })
            .ToList();

    /// <summary>
    /// Pure projector, exposed for tests. The issues list below the grid always shows the issues
    /// belonging to the services currently on the grid, so both filters drive both halves.
    /// </summary>
    internal static List<ServiceIncident> IssuesFor(
        ServiceHealthStatus status, List<ServiceHealthEntry> visibleServices)
    {
        var ids = visibleServices.Select(s => s.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
        return status.Issues
            .Where(i => ids.Contains(i.ServiceId))
            .OrderByDescending(i => i.StartDateTime ?? DateTimeOffset.MinValue)
            .ToList();
    }

    /// <summary>
    /// Pure projector, exposed for tests. Default is worst-first then alphabetical, so the board
    /// opens on what is broken rather than on whatever order Graph happened to return.
    /// </summary>
    internal static List<ServiceHealthEntry> SortServices(
        List<ServiceHealthEntry> services, ServiceHealthStatus status, string sortOrder) => sortOrder switch
        {
            SortByName => [.. services.OrderBy(s => s.DisplayName, StringComparer.OrdinalIgnoreCase)],
            SortByIssues =>
            [
                .. services
                    .OrderByDescending(s => status.IssueCountFor(s.Id))
                    .ThenBy(s => StatusRank(s.Status))
                    .ThenBy(s => s.DisplayName, StringComparer.OrdinalIgnoreCase)
            ],
            _ =>
            [
                .. services
                    .OrderBy(s => StatusRank(s.Status))
                    .ThenByDescending(s => status.IssueCountFor(s.Id))
                    .ThenBy(s => s.DisplayName, StringComparer.OrdinalIgnoreCase)
            ]
        };

    /// <summary>
    /// Severity order for the default sort. An unrecognised future status sorts above healthy,
    /// not below it - the same fail-loud choice ServiceHealthEntry.IsHealthy makes.
    /// </summary>
    internal static int StatusRank(string status) => status switch
    {
        "serviceInterruption" => 0,
        "serviceDegradation" => 1,
        "extendedRecovery" or "restoringService" or "restoreService" or "investigating" => 2,
        "falsePositive" => 8,
        "serviceOperational" => 9,
        _ => 5
    };

    /// <summary>Pure projector, exposed for tests. Mirrors the original dashboard's getStatusIcon.</summary>
    internal static string StatusIcon(string status) => status switch
    {
        "serviceOperational" => "bi-check-circle-fill",
        "serviceDegradation" => "bi-exclamation-triangle-fill",
        "serviceInterruption" => "bi-x-circle-fill",
        "extendedRecovery" or "restoringService" or "restoreService" or "investigating" => "bi-info-circle-fill",
        _ => "bi-question-circle-fill"
    };

    /// <summary>Pure projector, exposed for tests. The icon colour classes of the original.</summary>
    internal static string StatusIconClass(string status) => status switch
    {
        "serviceOperational" => "status-healthy",
        "serviceDegradation" => "status-warning",
        "serviceInterruption" => "status-error",
        "extendedRecovery" or "restoringService" or "restoreService" or "investigating" => "status-info",
        _ => "status-unknown"
    };

    private static string IssueIcon(ServiceIncident issue) =>
        issue.IsIncident ? "bi-x-circle-fill" : "bi-exclamation-triangle-fill";

    private static string IssueIconClass(ServiceIncident issue) =>
        issue.IsIncident ? "status-error" : "status-warning";

    /// <summary>
    /// Turns a Graph detail key such as "rootCauseSummary" into "Root Cause Summary", which is
    /// what the original dashboard did before printing it.
    /// </summary>
    internal static string Humanize(string key)
    {
        if (string.IsNullOrWhiteSpace(key)) return "";

        var spaced = System.Text.RegularExpressions.Regex.Replace(key, "([a-z0-9])([A-Z])", "$1 $2");
        return char.ToUpperInvariant(spaced[0]) + spaced[1..];
    }
}

@page "/risky-users"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "RiskyUsers")]
@rendermode InteractiveServer
@inject RiskyUsersService RiskyUsersService
@inject AuditService Audit
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager Navigation
@inject ClientInfoService ClientInfo
@inject ILogger<RiskyUsers> Logger
@inject EmailService Email
@inject ServiceNowService ServiceNow
@inject ProtectedPrincipalService ProtectedPrincipalService
@inject ProtectedPrincipalServicerService Servicers

<PageTitle>Risky Users</PageTitle>

@if (!authChecked)
{
    <div class="container-fluid">
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Checking authorization...</span>
            </div>
        </div>
    </div>
    return;
}

<div class="container-fluid">
    <div class="alert alert-info py-2 mb-3">
        <small>
            Every query against Microsoft Entra ID Protection is logged for audit purposes. Queries are
            never alert-emailed; every remediation action is audited AND notified to administrators.
            Remediation requires the Remediate permission and a ticket number.
        </small>
    </div>
    <h1 class="mb-4">Risky Users<ModuleVersion /></h1>

    @if (!RiskyUsersService.IsAvailable)
    {
        <div class="alert alert-danger">Risky Users module is not configured. Set Graph App Delinea Secret ID in Module Config.</div>
        return;
    }

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label mb-1" for="riskLevelFilter">Risk level</label>
                    <select id="riskLevelFilter" class="form-select" @bind="riskLevelFilter" disabled="@isLoading">
                        <option value="">Any</option>
                        <option value="high">High</option>
                        <option value="medium">Medium</option>
                        <option value="low">Low</option>
                        <option value="hidden">Hidden</option>
                        <option value="none">None</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label mb-1" for="riskStateFilter">Risk state</label>
                    <select id="riskStateFilter" class="form-select" @bind="riskStateFilter" disabled="@isLoading">
                        <option value="">Any</option>
                        <option value="atRisk">At risk</option>
                        <option value="confirmedCompromised">Confirmed compromised</option>
                        <option value="confirmedSafe">Confirmed safe</option>
                        <option value="dismissed">Dismissed</option>
                        <option value="remediated">Remediated</option>
                        <option value="none">None</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label mb-1" for="upnContains">UPN contains</label>
                    <input id="upnContains" class="form-control" @bind="upnContains" @bind:event="oninput"
                           @onkeydown="OnFilterKeyDown" disabled="@isLoading" placeholder="Part of a user principal name" />
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" @onclick="LoadRiskyUsersAsync" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Refresh
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* An in-flight query must SAY it is in flight, in the results area, not only as a button
       spinner - a blank results area during a Graph round trip reads as a hung page (the
       BitLocker blr-4 class of defect). *@
    @if (isLoading)
    {
        <div class="alert alert-info d-flex align-items-center">
            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
            <span>Querying Microsoft Entra ID Protection...</span>
        </div>
    }

    @* hasQueried is cleared at the start of every query, not only the first, and set again only
       in `finally` once an answer (success or failure) exists - so a second query never leaves
       the first query's verdict on screen while the second is in flight (AC3). *@
    @if (hasQueried && !isLoading)
    {
        @if (errorMessage != null)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }
        else if (results.Count == 0)
        {
            <div class="alert alert-secondary">No risky users found.</div>
        }
        else
        {
            @if (truncated)
            {
                <div class="alert alert-warning py-2">
                    <small>Showing the first @requestedMax; more exist. Narrow the filter.</small>
                </div>
            }

            <div class="card">
                <div class="card-header">
                    <strong>@results.Count risky user(s)</strong>
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>UPN</th>
                                <th>Display name</th>
                                <th>Risk level</th>
                                <th>Risk state</th>
                                <th>Risk detail</th>
                                <th>Last updated</th>
                                <th>Flags</th>
                                <th></th>
                                @if (canRemediate)
                                {
                                    <th>Remediate</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in results)
                            {
                                <tr>
                                    <td>@user.UserPrincipalName</td>
                                    <td>@user.UserDisplayName</td>
                                    <td><span class="badge @RiskLevelBadgeClass(user.RiskLevel)">@user.RiskLevel</span></td>
                                    <td>@user.RiskState</td>
                                    <td><small class="text-muted">@user.RiskDetail</small></td>
                                    <td class="text-nowrap">@(user.RiskLastUpdatedDateTime?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                    <td>
                                        @if (user.IsProcessing) { <span class="badge bg-secondary me-1">Processing</span> }
                                        @if (user.IsDeleted) { <span class="badge bg-dark">Deleted</span> }
                                    </td>
                                    <td>
                                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => ToggleHistoryAsync(user)">
                                            @(expandedUserId == user.Id ? "Hide history" : "History")
                                        </button>
                                    </td>
                                    @* Action controls exist only for an operator holding the granular
                                       RiskyUsersRemediate grant (AC13). The handler re-checks the same
                                       policy before it acts, so hiding the buttons is presentation, not
                                       the authorization decision.

                                       Deliberately NOT gated on riskState or isProcessing (AC16 / S5):
                                       no client-side eligibility allowlist is derived from an enum
                                       Microsoft extends. Graph decides what it will accept, and its
                                       refusal is reported as this row's own named failure. *@
                                    @if (canRemediate)
                                    {
                                        <td class="text-nowrap">
                                            <div class="btn-group btn-group-sm" role="group" aria-label="Remediate">
                                                <button class="btn btn-outline-success" title="@ActionConsequence(RiskyUserAction.Dismiss)"
                                                        @onclick="() => BeginAction(user, RiskyUserAction.Dismiss)"
                                                        disabled="@ActionsDisabled">@ActionLabel(RiskyUserAction.Dismiss)</button>
                                                <button class="btn btn-outline-primary" title="@ActionConsequence(RiskyUserAction.ConfirmSafe)"
                                                        @onclick="() => BeginAction(user, RiskyUserAction.ConfirmSafe)"
                                                        disabled="@ActionsDisabled">@ActionLabel(RiskyUserAction.ConfirmSafe)</button>
                                                <button class="btn btn-outline-danger" title="@ActionConsequence(RiskyUserAction.ConfirmCompromised)"
                                                        @onclick="() => BeginAction(user, RiskyUserAction.ConfirmCompromised)"
                                                        disabled="@ActionsDisabled">@ActionLabel(RiskyUserAction.ConfirmCompromised)</button>
                                            </div>
                                        </td>
                                    }
                                </tr>

                                @* The confirm bar renders BENEATH the acting row, never above the table:
                                   a top-of-table confirm for row 47 puts the ticket box off-screen while
                                   that row's buttons go disabled, which reads as the buttons breaking
                                   (docs/MigrationBatchSelection-Plan.md slice 3). *@
                                @if (canRemediate && confirmUserId == user.Id && confirmAction is not null)
                                {
                                    <tr class="table-warning">
                                        <td colspan="@DetailColspan">
                                            <div class="mb-1"><strong>@ConfirmPrompt(confirmAction.Value, user.UserPrincipalName, user.RiskState)</strong></div>
                                            <div class="mb-2 text-muted">@ActionConsequence(confirmAction.Value)</div>
                                            @if (user.IsProcessing)
                                            {
                                                <div class="small text-muted mb-2">
                                                    Entra is still processing this user's risk state. The action is not blocked; it may be refused.
                                                </div>
                                            }
                                            <div class="row g-2 align-items-end">
                                                <div class="col-md-4">
                                                    <label class="form-label mb-1" for="riskyUsersTicket">Ticket number (required)</label>
                                                    <input id="riskyUsersTicket" class="form-control form-control-sm" @bind="actionTicket"
                                                           @bind:event="oninput" placeholder="INC0000000" disabled="@(actingUserId != null)" />
                                                </div>
                                                <div class="col-md-8">
                                                    <button class="btn btn-danger btn-sm me-2"
                                                            @onclick="() => ExecuteActionAsync(user, confirmAction.Value)"
                                                            disabled="@(actingUserId != null || string.IsNullOrWhiteSpace(actionTicket))">
                                                        @ActionLabel(confirmAction.Value)
                                                    </button>
                                                    <button class="btn btn-secondary btn-sm" @onclick="CancelAction"
                                                            disabled="@(actingUserId != null)">Cancel</button>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }

                                @* Per-user outcome (AC10 / Known Failure Class 2): the verdict is keyed by
                                   the user it belongs to and rendered in that user's own row, naming the
                                   UPN - so acting on three rows leaves three separately named outcomes and
                                   a refusal on one never reads as a verdict on another. *@
                                @if (actingUserId == user.Id)
                                {
                                    <tr>
                                        <td colspan="@DetailColspan">
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                            <small>Applying to @user.UserPrincipalName...</small>
                                        </td>
                                    </tr>
                                }
                                else if (OutcomeFor(user.Id) is { } outcome)
                                {
                                    <tr>
                                        <td colspan="@DetailColspan">
                                            <div class="alert @(outcome.Success ? "alert-success" : "alert-danger") mb-0 py-2">
                                                <strong>@outcome.UserPrincipalName</strong> - @outcome.Message
                                                @if (outcome.Success)
                                                {
                                                    <span class="text-muted"> Refresh to see the updated risk state.</span>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }

                                @if (expandedUserId == user.Id)
                                {
                                    <tr>
                                        <td colspan="@DetailColspan" class="bg-light">
                                            @if (historyLoading)
                                            {
                                                <span class="spinner-border spinner-border-sm me-2"></span> <small>Loading history...</small>
                                            }
                                            else if (historyError != null)
                                            {
                                                <div class="alert alert-danger mb-0 py-2">@historyError</div>
                                            }
                                            else if (historyEntries.Count == 0)
                                            {
                                                <small class="text-muted">No history entries.</small>
                                            }
                                            else
                                            {
                                                <table class="table table-sm mb-0">
                                                    <thead>
                                                        <tr>
                                                            <th>Risk level</th>
                                                            <th>Risk state</th>
                                                            <th>Risk detail</th>
                                                            <th>Updated</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var entry in historyEntries)
                                                        {
                                                            <tr>
                                                                <td><span class="badge @RiskLevelBadgeClass(entry.RiskLevel)">@entry.RiskLevel</span></td>
                                                                <td>@entry.RiskState</td>
                                                                <td><small class="text-muted">@entry.RiskDetail</small></td>
                                                                <td class="text-nowrap">@(entry.RiskLastUpdatedDateTime?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@code {
    private string currentUser = "";
    private string clientIpAddress = "Unknown";
    private bool authChecked;

    private string riskLevelFilter = "";
    private string riskStateFilter = "";
    private string upnContains = "";

    private bool isLoading;
    private bool hasQueried;
    private string? errorMessage;
    private List<RiskyUser> results = [];
    private bool truncated;
    private int requestedMax;

    private string? expandedUserId;
    private bool historyLoading;
    private string? historyError;
    private List<RiskyUserHistoryEntry> historyEntries = [];

    // ---- write path (S6) ----------------------------------------------------------------------

    /// <summary>Granular RiskyUsersRemediate grant. Controls RENDERING only; every action
    /// re-checks the same policy immediately before it acts (Spec, Page Authorization item 3).</summary>
    private bool canRemediate;

    private string? confirmUserId;
    private RiskyUserAction? confirmAction;
    private string actionTicket = "";
    private string? actingUserId;

    /// <summary>One outcome per user id, so three actions leave three separately named verdicts
    /// and no row can display another row's result (Known Failure Class 2 / AC10).</summary>
    private readonly Dictionary<string, RowOutcome> rowOutcomes = [];

    internal sealed record RowOutcome(string UserPrincipalName, bool Success, string Message);

    private RowOutcome? OutcomeFor(string userId) =>
        rowOutcomes.TryGetValue(userId, out var outcome) ? outcome : null;

    private bool ActionsDisabled => isLoading || actingUserId != null;

    /// <summary>Column count for a full-width detail row; tracks the conditional Remediate column.</summary>
    private int DetailColspan => canRemediate ? 9 : 8;

    /// <summary>Module id for the servicer grant. Must match the catalog descriptor, and must be
    /// listed in ModuleConfig.razor's ModulesWithProtectedPrincipalServicing or no group can ever
    /// be granted it.</summary>
    private const string ServicerModuleId = "RiskyUsers";

    private string? ServicerNoteFor(System.Security.Claims.ClaimsPrincipal? user, IEnumerable<string> matchedRules, string? qualifier = null) =>
        ProtectedPrincipalServicing.NoteFor(Servicers, user, ServicerModuleId, matchedRules, qualifier);

    private static Dictionary<string, object?>? ServicedExtra(string? note) =>
        ProtectedPrincipalServicing.Extra(note);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUser = user.Identity?.Name ?? "Unknown";

        var authResult = await AuthorizationService.AuthorizeAsync(user, "RiskyUsers");
        if (!authResult.Succeeded)
        {
            Navigation.NavigateTo("access-denied", forceLoad: true);
            return;
        }

        // The granular grant layers ON TOP of the main one (Spec, Authorization Layering), so this
        // is only reached once module access is established.
        canRemediate = (await AuthorizationService.AuthorizeAsync(user, "RiskyUsersRemediate")).Succeeded;

        clientIpAddress = ClientInfo.IpAddress != "Unknown"
            ? ClientInfo.IpAddress
            : ClientInfo.GetIpForUser(currentUser);
        authChecked = true;
    }

    private async Task OnFilterKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !isLoading)
            await LoadRiskyUsersAsync();
    }

    private async Task LoadRiskyUsersAsync()
    {
        isLoading = true;
        // Cleared at the start of every query, not only the first (S3 rule 1) - otherwise a
        // second query would render the first query's now-stale verdict while it is in flight.
        hasQueried = false;
        errorMessage = null;
        results = [];
        truncated = false;
        expandedUserId = null;
        historyEntries = [];
        historyError = null;
        // Write-path state is retracted with the rest of it: a per-row outcome or an open confirm
        // bar left over from the previous query would attach to whatever row happens to share that
        // position or id in the new one (the blr-3 shape - state emptied, one field left behind).
        confirmUserId = null;
        confirmAction = null;
        actionTicket = "";
        rowOutcomes.Clear();
        await Task.Yield();

        var filter = new RiskyUserFilter(
            string.IsNullOrWhiteSpace(riskLevelFilter) ? null : riskLevelFilter,
            string.IsNullOrWhiteSpace(riskStateFilter) ? null : riskStateFilter,
            string.IsNullOrWhiteSpace(upnContains) ? null : upnContains.Trim());
        var target = DescribeFilter(filter);

        try
        {
            var page = await RiskyUsersService.GetRiskyUsersAsync(filter);
            results = [.. page.Users];
            truncated = page.Truncated;
            requestedMax = page.RequestedMax;

            SafeAudit(() => Audit.LogModuleAction(currentUser, clientIpAddress, "RiskyUsers_List", "RiskyUsers", target, true));
        }
        catch (Exception ex)
        {
            // A failed request must never render as "no risky users" (S2 rule 1 / AC1) - the
            // service throws rather than returning an empty page, and that exception is surfaced
            // here as a distinct alert, never folded into the empty-results branch.
            errorMessage = ex.Message;
            Logger.LogError(ex, "Failed to load risky users.");

            SafeAudit(() => Audit.LogModuleAction(currentUser, clientIpAddress, "RiskyUsers_List", "RiskyUsers", target, false, errorDetail: ex.Message));
        }
        finally
        {
            hasQueried = true;
            isLoading = false;
        }
    }

    private async Task ToggleHistoryAsync(RiskyUser user)
    {
        if (expandedUserId == user.Id)
        {
            expandedUserId = null;
            return;
        }

        expandedUserId = user.Id;
        historyLoading = true;
        historyError = null;
        historyEntries = [];
        await Task.Yield();

        try
        {
            historyEntries = [.. await RiskyUsersService.GetHistoryAsync(user.Id)];

            SafeAudit(() => Audit.LogModuleAction(currentUser, clientIpAddress, "RiskyUsers_History", "RiskyUsers", user.UserPrincipalName, true));
        }
        catch (Exception ex)
        {
            historyError = ex.Message;
            Logger.LogError(ex, "Failed to load risky user history for {UserId}.", user.Id);

            SafeAudit(() => Audit.LogModuleAction(currentUser, clientIpAddress, "RiskyUsers_History", "RiskyUsers", user.UserPrincipalName, false, errorDetail: ex.Message));
        }
        finally
        {
            historyLoading = false;
        }
    }

    private void SafeAudit(Action write)
    {
        try
        {
            write();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to write Risky Users audit record.");
        }
    }

    private void BeginAction(RiskyUser user, RiskyUserAction action)
    {
        // Opening a confirm bar retracts the previous verdict for THAT row only - every other row
        // keeps its own outcome (AC10).
        confirmUserId = user.Id;
        confirmAction = action;
        actionTicket = "";
        rowOutcomes.Remove(user.Id);
    }

    private void CancelAction()
    {
        confirmUserId = null;
        confirmAction = null;
        actionTicket = "";
    }

    private void SetOutcome(string userId, string upn, bool success, string message) =>
        rowOutcomes[userId] = new RowOutcome(upn, success, message);

    /// <summary>
    /// Applies one remediation action to one user behind every gate S6 requires, in order: granular
    /// authorization re-check, mandatory ticket, protected-principal check, then the write. Every
    /// path - refusal, fail-closed protection outcome, exception, success - audits with the ticket,
    /// the target UPN and the action, and every real attempt notifies administrators from finally.
    /// </summary>
    /// <remarks>
    /// Fail-closed throughout (Known Failure Class 3): no gate falls through to a permissive
    /// default, and a protection check that cannot be evaluated REFUSES rather than allowing. The
    /// only way to record a failure here is Refuse, which audits as it refuses - so a refusal path
    /// added later cannot forget the audit record.
    /// </remarks>
    private async Task ExecuteActionAsync(RiskyUser user, RiskyUserAction action)
    {
        // Bound before the first await: a slow action must attach its verdict to the row it was
        // started from, not to whichever row the operator opened while it was in flight.
        var userId = user.Id;
        var upn = user.UserPrincipalName;
        var ticket = actionTicket.Trim();
        var auditAction = AuditActionFor(action);

        void Refuse(string message, string auditDetail)
        {
            SetOutcome(userId, upn, false, message);
            SafeAudit(() => Audit.LogModuleAction(currentUser, clientIpAddress, auditAction, "RiskyUsers", upn, false, ticket,
                errorDetail: auditDetail));
        }

        actingUserId = userId;
        confirmUserId = null;
        confirmAction = null;
        rowOutcomes.Remove(userId);
        await Task.Yield();

        // Set when an authorised servicer overrode a protected-principal refusal, and carried into
        // the SUCCESS audit's extra below.
        string? servicedAuditDetail = null;
        // Notify admins on any real attempt against the identity - success, protected refusal,
        // fail-closed protection outcome or exception - but not on the trivial authorization and
        // ticket pre-gates, which never reached it.
        var notifyAdmins = false;
        RiskyUserActionResult? result = null;

        try
        {
            // 1. Granular authorization, re-checked immediately before execution. The page-load
            //    check hides the buttons; it is not the decision, because a grant can be revoked
            //    while the page is open (Spec, Page Authorization item 3 / AC13).
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var remediateCheck = await AuthorizationService.AuthorizeAsync(authState.User, "RiskyUsersRemediate");
            if (!remediateCheck.Succeeded)
            {
                Refuse("Authorization denied. Remediation requires the Risky Users Remediate permission.",
                    "Authorization denied - RiskyUsersRemediate");
                return;
            }

            // 2. Ticket, mandatory. Presence is checked separately from validation because the
            //    ServiceNow client passes every ticket while the integration is dormant, so
            //    validation alone would admit a blank ticket on a deployment without it (AC14).
            if (string.IsNullOrWhiteSpace(ticket))
            {
                Refuse("A ticket number is required.", "Ticket number missing");
                return;
            }

            var ticketValidation = await ServiceNow.ValidateTicketAsync(ticket);
            if (!ticketValidation.IsValid)
            {
                Refuse($"Ticket validation failed: {ticketValidation.Message}",
                    $"Ticket validation failed: {ticketValidation.Message}");
                return;
            }

            notifyAdmins = true;

            // 4. Protected-principal check, BEFORE the write and never after it.
            //
            //    Risky users are CLOUD identities, and the group, OU and SamAccountName-pattern
            //    rules are all evaluated from an on-premises DN, so they can never match a
            //    cloud-only principal (Constitution, Protected Principals, final bullet). Such a
            //    principal is protected by the protected USER rows, by address, or not at all - so
            //    an unresolved directory lookup must NOT skip the check. That skip is the defect
            //    MfaReset shipped before 1.1.0, on a module whose normal input is a cloud identity.
            try
            {
                var (resolved, resolutionStatus) = await ProtectedPrincipalService.ResolveWithExchangeFallbackAsync(upn);
                if (resolutionStatus is ProtectedPrincipalService.ResolutionStatus.Unavailable or ProtectedPrincipalService.ResolutionStatus.Ambiguous)
                {
                    var reason = resolutionStatus == ProtectedPrincipalService.ResolutionStatus.Ambiguous
                        ? "Identity is ambiguous - it matches multiple directory users."
                        : "Protection check unavailable.";
                    Refuse(reason, $"{reason} - blocked");
                    return;
                }

                if (resolved != null)
                {
                    var protectionCheck = await ProtectedPrincipalService.CheckAsync(resolved);
                    if (protectionCheck.CheckFailed)
                    {
                        Refuse($"Protection check failed: {protectionCheck.Reason}",
                            $"Protection check failed: {protectionCheck.Reason}");
                        return;
                    }
                    if (protectionCheck.IsProtected)
                    {
                        // An authorised servicer may proceed; everyone else is refused. Protection
                        // is evaluated first and never weakened - this only decides whether THIS
                        // operator may act on a target already known to be protected.
                        servicedAuditDetail = ServicerNoteFor(authState.User, protectionCheck.MatchedRules);
                        if (servicedAuditDetail is null)
                        {
                            Refuse("This user is a protected principal. Risk remediation is not permitted.",
                                $"Protected principal - matched rules: {string.Join(", ", protectionCheck.MatchedRules)}");
                            return;
                        }
                    }
                }
                else
                {
                    // Unresolved is NOT "nothing to protect". This module mutates an Entra user
                    // that AD and Exchange may both be unaware of, so the protected USER rows are
                    // checked against the raw identity rather than skipped.
                    //
                    // The one improvement over the MfaReset shape this copies: MfaReset only ever
                    // holds a UPN, so it leaves the Entra object id unpopulated. Here riskyUser.id
                    // IS the Entra object id, and ProtectedPrincipalService.MatchesIdentity compares
                    // EntraObjectId against every protected USER row
                    // (Services/ProtectedPrincipalService.cs:693-710) - verified, not assumed - so
                    // populating it makes object-id-based protection genuinely effective here.
                    var unresolved = new ResolvedDirectoryPrincipal(
                        Source: "RiskyUsers-Unresolved",
                        DisplayName: string.IsNullOrWhiteSpace(user.UserDisplayName) ? upn : user.UserDisplayName,
                        UserPrincipalName: upn,
                        SamAccountName: null,
                        PrimarySmtpAddress: upn.Contains('@') ? upn : null,
                        DistinguishedName: null,
                        ObjectGuid: null,
                        EntraObjectId: string.IsNullOrWhiteSpace(userId) ? null : userId);

                    var unresolvedCheck = await ProtectedPrincipalService.CheckAsync(unresolved);
                    if (unresolvedCheck.CheckFailed)
                    {
                        Refuse($"Protection check failed: {unresolvedCheck.Reason}",
                            $"Protection check failed: {unresolvedCheck.Reason}");
                        return;
                    }
                    if (unresolvedCheck.IsProtected)
                    {
                        // Both branches honour the servicer grant, or a cloud-only protected
                        // identity becomes the one case a servicer cannot service - precisely this
                        // module's population.
                        servicedAuditDetail = ServicerNoteFor(authState.User, unresolvedCheck.MatchedRules, "directory-unresolved");
                        if (servicedAuditDetail is null)
                        {
                            Refuse("This user is a protected principal. Risk remediation is not permitted.",
                                $"Protected principal (directory-unresolved) - matched rules: {string.Join(", ", unresolvedCheck.MatchedRules)}");
                            return;
                        }
                    }

                    Logger.LogInformation(
                        "No such recipient in Active Directory or Exchange Online for {Upn}; protected user rows matched neither the raw identity nor its Entra object id - proceeding", upn);
                }
            }
            catch (Exception ex)
            {
                // Fail closed: an errored check says nothing about the target, so it can never be
                // read as permission (Known Failure Class 3).
                Logger.LogWarning(ex, "Protected principal check failed for {Upn} - blocking as precaution", upn);
                Refuse($"Protection check error: {ex.Message}", $"Protection check exception: {ex.Message}");
                return;
            }

            // 5. The write. Reachable only with every gate above passed, and one Graph call per
            //    user (S5) - so this outcome names exactly one user.
            var applied = await RiskyUsersService.ApplyActionAsync(userId, action);
            result = applied;
            SetOutcome(userId, upn, applied.Success, applied.Message);

            // The serviced note rides extra, never errorDetail: LogModuleAction writes
            // ["error"] = success ? null : errorDetail (Services/AuditService.cs), so the one field
            // explaining why a protected user could be acted on would be discarded on exactly the
            // success path that needs it (pps-3).
            SafeAudit(() => Audit.LogModuleAction(currentUser, clientIpAddress, auditAction, "RiskyUsers", upn, applied.Success, ticket,
                errorDetail: applied.Success ? null : applied.Message,
                extra: ServicedExtra(servicedAuditDetail)));

            Logger.LogInformation("User {Admin} applied {Action} to risky user {Target} (ticket {Ticket}): {Result}",
                currentUser, auditAction, upn, ticket, applied.Message);
        }
        catch (Exception ex)
        {
            Refuse(ex.Message, ex.Message);
            Logger.LogError(ex, "Risky user action {Action} failed for {Upn}.", auditAction, upn);
        }
        finally
        {
            actingUserId = null;
            actionTicket = "";

            // Mandatory admin notification on every real attempt (Constitution, Notifications),
            // in finally and wrapped so a send failure cannot change the reported result (AC15).
            if (notifyAdmins)
            {
                var success = result?.Success ?? false;
                var message = OutcomeFor(userId)?.Message;
                try
                {
                    await Email.SendAdminNotificationAsync(currentUser, clientIpAddress, auditAction,
                        success, ticket,
                        new Dictionary<string, string>
                        {
                            ["Target User"] = upn,
                            ["Entra Object Id"] = userId,
                            ["Action"] = ActionLabel(action)
                        },
                        success ? null : message);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Failed to send Risky Users admin notification for {Upn}", upn);
                }
            }
        }
    }

    /// <summary>
    /// Audit action name for a remediation action. Each action files under its own name so an
    /// audit query can tell a dismissal from a confirm-compromised; an unknown member throws
    /// rather than filing under a generic name that hides which action ran.
    /// </summary>
    internal static string AuditActionFor(RiskyUserAction action) => action switch
    {
        RiskyUserAction.Dismiss => "RiskyUsers_Dismiss",
        RiskyUserAction.ConfirmSafe => "RiskyUsers_ConfirmSafe",
        RiskyUserAction.ConfirmCompromised => "RiskyUsers_ConfirmCompromised",
        _ => throw new ArgumentOutOfRangeException(nameof(action), action, "Unknown risky user action.")
    };

    /// <summary>
    /// Operator-facing name for a remediation action. Owner ruling (2026-09-02): the module is
    /// headed for L2 support desk staff, so wording is plain and simpler than Microsoft's own
    /// vocabulary (Dismiss / Confirm safe / Confirm compromised) rather than reusing it verbatim.
    /// The Graph endpoint, audit action name and enum member behind each label are unchanged.
    /// </summary>
    internal static string ActionLabel(RiskyUserAction action) => action switch
    {
        RiskyUserAction.Dismiss => "Close as handled",
        RiskyUserAction.ConfirmSafe => "This was the real user",
        RiskyUserAction.ConfirmCompromised => "Account was breached",
        _ => throw new ArgumentOutOfRangeException(nameof(action), action, "Unknown risky user action.")
    };

    /// <summary>
    /// Owner-approved (2026-09-02) plain-English consequence line for a remediation action, shown
    /// as the button tooltip and verbatim in the per-row confirmation bar, so an L2 operator sees
    /// what will happen before committing rather than a Graph verb.
    /// </summary>
    internal static string ActionConsequence(RiskyUserAction action) => action switch
    {
        RiskyUserAction.Dismiss => "Clears the alert. Nothing is reported as right or wrong; it can fire again.",
        RiskyUserAction.ConfirmSafe => "Clears the alert and tells the risk engine this activity is normal for them. Only if you have verified with the user.",
        RiskyUserAction.ConfirmCompromised => "Raises the user to high risk. Their sign-in will be blocked or forced to reset their password, immediately.",
        _ => throw new ArgumentOutOfRangeException(nameof(action), action, "Unknown risky user action.")
    };

    /// <summary>
    /// Confirmation text shown beneath the acting row. Names the action AND the user, so the
    /// confirm step cannot be satisfied without seeing which user it applies to.
    /// </summary>
    internal static string ConfirmPrompt(RiskyUserAction action, string userPrincipalName, string riskState)
    {
        var state = string.IsNullOrWhiteSpace(riskState) ? "unknown" : riskState;
        return $"{ActionLabel(action)} for {userPrincipalName}? Current risk state: {state}.";
    }

    /// <summary>
    /// Human-readable audit target for a RiskyUsers_List query. Pure and static so it can be
    /// unit-tested without a page instance.
    /// </summary>
    internal static string DescribeFilter(RiskyUserFilter filter)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(filter.RiskLevel))
            parts.Add($"riskLevel={filter.RiskLevel}");
        if (!string.IsNullOrWhiteSpace(filter.RiskState))
            parts.Add($"riskState={filter.RiskState}");
        if (!string.IsNullOrWhiteSpace(filter.UpnContains))
            parts.Add($"upnContains={filter.UpnContains}");

        return parts.Count == 0 ? "(no filter)" : string.Join(";", parts);
    }

    /// <summary>
    /// Badge class for a riskLevel value. Falls through to a neutral badge for any value outside
    /// the documented set (including "unknownFutureValue") rather than dropping or miscoloring it
    /// - riskLevel/riskState are stored as plain strings and must render, not be filtered
    /// (S2 rule 4 / AC5).
    /// </summary>
    internal static string RiskLevelBadgeClass(string riskLevel) => riskLevel.ToLowerInvariant() switch
    {
        "high" => "bg-danger",
        "medium" => "bg-warning text-dark",
        "low" => "bg-info text-dark",
        "hidden" => "bg-secondary",
        "none" => "bg-success",
        _ => "bg-light text-dark border"
    };
}

@page "/intune-devices"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "IntuneDevices")]
@rendermode InteractiveServer
@inject IntuneDeviceService IntuneDeviceService
@inject AuditService Audit
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager Navigation
@inject ClientInfoService ClientInfo
@inject EmailService Email
@inject ServiceNowService ServiceNow
@inject ProtectedPrincipalService ProtectedPrincipalService
@inject ProtectedPrincipalServicerService Servicers
@inject ILogger<IntuneDevices> Logger

<PageTitle>Intune Devices</PageTitle>

@if (!authChecked)
{
    <div class="container-fluid">
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Checking authorization...</span>
            </div>
        </div>
    </div>
    return;
}

<div class="container-fluid">
    <div class="alert alert-info py-2 mb-3">
        <small>
            Every search and device lookup is logged for audit purposes, and so is every action.
            Retire and wipe are queued: the device carries them out at its next check-in, and a
            powered-off or offline device may not act for a long time.
            Deleting a device's Intune record does not remove company data from the device and
            does not remove the device's Entra ID object - both are separate actions.
            Removing the Entra ID device object is offered separately, needs its own permission,
            and is reported and audited on its own.
        </small>
    </div>
    <h1 class="mb-4">Intune Devices<ModuleVersion /></h1>

    @if (!IntuneDeviceService.IsAvailable)
    {
        <div class="alert alert-danger">Intune Devices module is not configured. Set Graph App Delinea Secret ID in Module Config.</div>
        return;
    }

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-8">
                    <label class="form-label mb-1" for="searchTerm">Start of a device name or user principal name, or an exact serial number</label>
                    <input id="searchTerm" class="form-control" @bind="searchTerm"
                           @bind:event="oninput" @onkeydown="OnSearchKeyDown" disabled="@isSearching"
                           placeholder="Start of a device name or UPN, or a full serial number" />
                    @* The label and this line say which kind of match each field gets, because the
                       three differ: Intune accepts a prefix match on the two name fields and only
                       an exact match on the serial (IntuneDeviceService.BuildFilterExpression). An
                       operator typing the middle of a device name would otherwise read the empty
                       result as "no such device". *@
                    <div class="form-text">
                        Device name and user principal name match from the START of the value - typing the middle of a
                        name finds nothing. A serial number must be exact.
                    </div>
                </div>
                <div class="col-md-4">
                    <button class="btn btn-primary w-100" @onclick="SearchAsync" disabled="@isSearching">
                        @if (isSearching)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Search
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* An in-flight search must SAY it is in flight in the results area, not only as a button
       spinner - a blank results area during a Graph round trip reads as a hung page. *@
    @if (isSearching)
    {
        <div class="alert alert-info d-flex align-items-center">
            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
            <span>Searching Intune managed devices...</span>
        </div>
    }

    @* hasSearched is cleared at the start of every search, not only the first, and set again only
       in `finally` once an answer (success or failure) exists - so a second search never leaves
       the first search's verdict on screen while the second is in flight. *@
    @if (hasSearched && !isSearching)
    {
        @if (errorMessage != null)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }
        else if (devices.Count == 0)
        {
            @if (truncated)
            {
                <div class="alert alert-warning py-2">
                    <small>No match in the first @searchedCount device(s) searched; more devices exist. Narrow the search.</small>
                </div>
            }
            else
            {
                <div class="alert alert-secondary">No matching devices found.</div>
            }
        }
        else
        {
            @if (truncated)
            {
                <div class="alert alert-warning py-2">
                    <small>Showing matches from the first @searchedCount device(s) searched; more devices exist. Narrow the search.</small>
                </div>
            }

            @* Owner ruling 2026-09-02: this module is headed for L2 support desk staff, so what
               delete, retire and wipe actually DO is stated on the page in plain words instead of
               assumed. It sits at the top of the actions area, closed by default and one click to
               open, and is drawn only for an operator who has at least one of the actions - nobody
               is asked to read about buttons they cannot see. Every line comes from ActionHelp /
               NotifyUserHelp, the same source as the button tooltips and the confirmation bar. *@
            @if (CanActAtAll || canEntraDelete)
            {
                <div class="card mb-3">
                    <div class="card-body py-2">
                        <button class="btn btn-link btn-sm p-0 text-decoration-none" type="button"
                                @onclick="() => showActionHelp = !showActionHelp"
                                aria-expanded="@(showActionHelp ? "true" : "false")" aria-controls="intuneActionHelp">
                            What do these actions do?@(showActionHelp ? " (hide)" : "")
                        </button>
                        <div id="intuneActionHelp" class="@(showActionHelp ? "collapse show" : "collapse")">
                            <dl class="row mb-0 mt-2 small">
                                <dt class="col-sm-3">@ActionLabel(IntuneDeviceAction.Delete)</dt>
                                <dd class="col-sm-9">@ActionHelp(IntuneDeviceAction.Delete)</dd>
                                <dt class="col-sm-3">@ActionLabel(IntuneDeviceAction.Retire)</dt>
                                <dd class="col-sm-9">@ActionHelp(IntuneDeviceAction.Retire)</dd>
                                <dt class="col-sm-3">@ActionLabel(IntuneDeviceAction.Wipe)</dt>
                                <dd class="col-sm-9">@ActionHelp(IntuneDeviceAction.Wipe)</dd>
                                <dt class="col-sm-3">Also remove Entra ID entry</dt>
                                <dd class="col-sm-9">@ActionHelp(IntuneDeviceAction.EntraDelete)</dd>
                                <dt class="col-sm-3">Email the user</dt>
                                <dd class="col-sm-9">@NotifyUserHelp</dd>
                            </dl>
                        </div>
                    </div>
                </div>
            }

            <div class="card">
                <div class="card-header">
                    <strong>@devices.Count device(s)</strong>
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Device name</th>
                                <th>User</th>
                                <th>OS</th>
                                <th>Compliance</th>
                                <th>Last sync</th>
                                <th></th>
                                @if (CanActAtAll)
                                {
                                    <th>Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var device in devices)
                            {
                                <tr>
                                    <td>@device.DeviceName</td>
                                    <td>@device.UserPrincipalName</td>
                                    <td>@device.OperatingSystem @device.OsVersion</td>
                                    <td><span class="badge @ComplianceBadgeClass(device.ComplianceState)">@device.ComplianceState</span></td>
                                    <td class="text-nowrap">@(device.LastSyncDateTime?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                    <td>
                                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => ToggleDetailAsync(device)">
                                            @(expandedDeviceId == device.Id ? "Hide detail" : "Detail")
                                        </button>
                                    </td>
                                    @if (CanActAtAll)
                                    {
                                        <td>
                                            @* No two action buttons share a leading verb and none is a bare
                                               "Remove" (MigrationBatchSelection-Plan.md D6). Each carries its
                                               action's first help sentence as a title tooltip, so the
                                               consequence is reachable without opening the help panel. *@
                                            <div class="btn-group btn-group-sm">
                                                @if (canDelete)
                                                {
                                                    <button class="btn btn-outline-danger"
                                                            title="@ActionHelpSummary(IntuneDeviceAction.Delete, 1)"
                                                            @onclick="() => BeginAction(device, IntuneDeviceAction.Delete)"
                                                            disabled="@ActionsDisabled">Delete record</button>
                                                }
                                                @if (canPrivileged)
                                                {
                                                    <button class="btn btn-outline-warning"
                                                            title="@ActionHelpSummary(IntuneDeviceAction.Retire, 1)"
                                                            @onclick="() => BeginAction(device, IntuneDeviceAction.Retire)"
                                                            disabled="@ActionsDisabled">Retire</button>
                                                    <button class="btn btn-danger"
                                                            title="@ActionHelpSummary(IntuneDeviceAction.Wipe, 1)"
                                                            @onclick="() => BeginAction(device, IntuneDeviceAction.Wipe)"
                                                            disabled="@ActionsDisabled">Wipe</button>
                                                }
                                            </div>
                                        </td>
                                    }
                                </tr>

                                @* The confirm bar renders BENEATH the acting row, never above the table: a
                                   top-of-table confirm for row 47 puts the ticket box off-screen while that
                                   row's button goes disabled, which reads to the operator as a dead button
                                   (docs/MigrationBatchSelection-Plan.md D1 / mbs-1). The ticket field sits
                                   adjacent to the confirming button for the same reason. *@
                                @if (confirmDeviceId == device.Id && confirmAction is not null && CanAct(confirmAction.Value))
                                {
                                    <tr class="table-warning">
                                        <td colspan="@DetailColspan">
                                            <div class="mb-2"><strong>@ConfirmPrompt(confirmAction.Value, DeviceLabel(device))</strong></div>

                                            @* The plain-English consequence again, right above the ticket and
                                               confirm controls (owner ruling 2026-09-02): the operator reads what
                                               the action does at the moment of committing to it, not only if they
                                               happened to open the help panel first. Same source text as the panel
                                               and the button tooltip, first two sentences. *@
                                            <div class="mb-2 small">@ActionHelpSummary(confirmAction.Value, 2)</div>

                                            @* Every parameter Graph's wipe action accepts is an operator control
                                               (D2), with full-reset defaults, and every non-default choice is
                                               visible here at the moment of acting. *@
                                            @if (confirmAction == IntuneDeviceAction.Wipe)
                                            {
                                                <div class="row g-2 mb-2">
                                                    <div class="col-md-6">
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="checkbox" id="wipeKeepUserData"
                                                                   @bind="wipeKeepUserData" disabled="@(actingDeviceId != null)" />
                                                            <label class="form-check-label" for="wipeKeepUserData">Keep user data</label>
                                                            <div class="form-text">
                                                                Ticking this contradicts the button's own label: the device is reset but
                                                                the user's data is kept.
                                                            </div>
                                                        </div>
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="checkbox" id="wipeKeepEnrollmentData"
                                                                   @bind="wipeKeepEnrollmentData" disabled="@(actingDeviceId != null)" />
                                                            <label class="form-check-label" for="wipeKeepEnrollmentData">Keep enrollment state</label>
                                                            <div class="form-text">The device stays enrolled after the reset.</div>
                                                        </div>
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="checkbox" id="wipePersistEsimDataPlan"
                                                                   @bind="wipePersistEsimDataPlan" disabled="@(actingDeviceId != null)" />
                                                            <label class="form-check-label" for="wipePersistEsimDataPlan">Keep eSIM data plan</label>
                                                            <div class="form-text">iOS / iPadOS eSIM only.</div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label mb-1" for="wipeMacOsUnlockCode">macOS recovery PIN (six digits)</label>
                                                        <input id="wipeMacOsUnlockCode" class="form-control form-control-sm" maxlength="6"
                                                               @bind="wipeMacOsUnlockCode" @bind:event="oninput"
                                                               disabled="@(actingDeviceId != null)" placeholder="(none)" />
                                                        <div class="form-text">
                                                            macOS only. It is shown back to you once after the wipe is queued and cannot be
                                                            retrieved afterwards - you must give it to the device owner.
                                                        </div>
                                                        <label class="form-label mb-1 mt-2" for="wipeObliterationBehavior">macOS obliteration behaviour</label>
                                                        <select id="wipeObliterationBehavior" class="form-select form-select-sm"
                                                                @bind="wipeObliterationBehavior" disabled="@(actingDeviceId != null)">
                                                            <option value="">(unset - Intune decides)</option>
                                                            <option value="default">default</option>
                                                            <option value="doNotObliterate">doNotObliterate</option>
                                                            <option value="obliterateWithWarning">obliterateWithWarning</option>
                                                            <option value="alwaysObliterate">alwaysObliterate</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            }

                                            @* S6: emailing the affected user is the acting operator's decision, made
                                               HERE at the moment of acting rather than set deployment-wide in Module
                                               Config (owner ruling 2026-09-02) - which is what the lost-or-stolen
                                               case needs. The box starts from a fixed per-action state. A deployment
                                               with user notifications switched off says so HERE, before the operator
                                               ticks a box that would do nothing, and the outcome says so afterwards
                                               (AC19). *@
                                            @if (NotificationOffered(confirmAction.Value))
                                            {
                                                <div class="mb-2">
                                                    @if (string.IsNullOrWhiteSpace(device.UserPrincipalName))
                                                    {
                                                        <div class="form-text">
                                                            No email can be sent for this device.
                                                            Intune holds no primary user address for it.
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="checkbox" id="notifyPrimaryUser"
                                                                   @bind="notifyPrimaryUser" disabled="@(actingDeviceId != null)" />
                                                            <label class="form-check-label" for="notifyPrimaryUser">
                                                                Email the device's primary user (@device.UserPrincipalName)
                                                            </label>
                                                            <div class="form-text">
                                                                The mail names the device, the action and the ticket, and nothing else -
                                                                on a lost or stolen device whoever holds it may read it.
                                                            </div>
                                                            @if (!Email.UserNotificationsEnabled)
                                                            {
                                                                <div class="form-text text-danger">
                                                                    User notifications are disabled for this whole deployment.
                                                                    Nothing will be sent even if this is ticked, and the result will say so.
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }

                                            @* S5 / D3: the Entra ID device object is a SECOND deletion, against a
                                               different object, through a directory scope - so it is its own
                                               permission, its own checkbox (always starting unticked, opted into by
                                               the acting operator), and its own reported outcome. A device
                                               that is not Entra-joined is told why instead of being offered a box
                                               that would silently skip (AC24). *@
                                            @if (confirmAction != IntuneDeviceAction.EntraDelete && canEntraDelete)
                                            {
                                                <div class="mb-2">
                                                    @if (EntraIdUsable(device))
                                                    {
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="checkbox" id="alsoRemoveEntra"
                                                                   @bind="alsoRemoveEntra" disabled="@(actingDeviceId != null)" />
                                                            <label class="form-check-label" for="alsoRemoveEntra">
                                                                Also remove this device's Entra ID device object
                                                            </label>
                                                            <div class="form-text">
                                                                A second deletion against a different object, in a directory scope. It runs
                                                                after the Intune action and is reported and audited separately, so a
                                                                half-finished result says which half failed. It changes how the device
                                                                authenticates; data on the device is unaffected.
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="form-text">
                                                            The Entra ID device object cannot be removed for this device.
                                                            Intune holds no usable Entra ID device id for it, so it is not Entra-joined.
                                                        </div>
                                                    }
                                                </div>
                                            }

                                            <div class="row g-2 align-items-end">
                                                <div class="col-md-4">
                                                    <label class="form-label mb-1" for="intuneDeviceTicket">Ticket number (required)</label>
                                                    <input id="intuneDeviceTicket" class="form-control form-control-sm" @bind="actionTicket"
                                                           @bind:event="oninput" placeholder="INC0000000" disabled="@(actingDeviceId != null)" />
                                                </div>
                                                @* Wipe alone requires typing the device name: retire is recoverable by
                                                   re-enrolling, a wipe destroys the machine's contents. *@
                                                @if (confirmAction == IntuneDeviceAction.Wipe)
                                                {
                                                    <div class="col-md-4">
                                                        <label class="form-label mb-1" for="wipeConfirmName">Type the device name to confirm</label>
                                                        <input id="wipeConfirmName" class="form-control form-control-sm" @bind="wipeConfirmName"
                                                               @bind:event="oninput" placeholder="@DeviceLabel(device)" disabled="@(actingDeviceId != null)" />
                                                    </div>
                                                }
                                                <div class="col-md-4">
                                                    <button class="btn btn-danger btn-sm me-2"
                                                            @onclick="() => ExecuteActionAsync(device, confirmAction.Value)"
                                                            disabled="@(actingDeviceId != null || string.IsNullOrWhiteSpace(actionTicket) || !WipeNameConfirmed(device, confirmAction.Value))">
                                                        @ActionLabel(confirmAction.Value)
                                                    </button>
                                                    <button class="btn btn-secondary btn-sm" @onclick="CancelAction"
                                                            disabled="@(actingDeviceId != null)">Cancel</button>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }

                                @* Per-device outcome (Known Failure Class 2): the verdict is keyed by the
                                   device it belongs to and names that device, so acting on three rows leaves
                                   three separately named outcomes. *@
                                @if (actingDeviceId == device.Id)
                                {
                                    <tr>
                                        <td colspan="@DetailColspan">
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                            <small>Acting on @DeviceLabel(device)...</small>
                                        </td>
                                    </tr>
                                }
                                else if (OutcomeFor(device.Id) is { } outcome)
                                {
                                    <tr>
                                        <td colspan="@DetailColspan">
                                            @* An override is never silent: the operator must see they acted
                                               under a servicer grant, not discover it in the audit log
                                               afterwards (T5). *@
                                            @if (outcome.ServicedNote != null)
                                            {
                                                <div class="alert alert-danger mb-2 py-2">
                                                    <strong>Protected Principal - override in effect:</strong>
                                                    This device's primary user is protected. You were permitted to act because
                                                    your group is authorised to service protected principals in this module.
                                                    <div class="small">@outcome.ServicedNote</div>
                                                </div>
                                            }
                                            <div class="alert @(outcome.Success ? "alert-success" : "alert-danger") mb-0 py-2">
                                                <strong>@outcome.DeviceName</strong> - @outcome.Message
                                            </div>
                                            @* The Entra half is its OWN verdict and is never folded into the Intune
                                               one (S5, Known Failure Class 2). The half-finished case - Intune record
                                               deleted, Entra ID object still there - is the one an operator must be
                                               able to see and retry, so it reads as two results, not one. *@
                                            @if (outcome.EntraMessage != null)
                                            {
                                                <div class="alert @(outcome.EntraSuccess == true ? "alert-success" : "alert-danger") mb-0 mt-2 py-2">
                                                    <strong>Entra ID device object</strong> - @outcome.EntraMessage
                                                </div>
                                            }
                                            @* S6 / AC19-AC20: what happened to the user notification is stated ON
                                               SCREEN, not only in the audit record. A send the operator asked for and
                                               the deployment suppressed must never look like a send. *@
                                            @if (outcome.NotificationNote != null)
                                            {
                                                <div class="alert @(outcome.NotificationSent ? "alert-secondary" : "alert-warning") mb-0 mt-2 py-2">
                                                    <small>@outcome.NotificationNote</small>
                                                </div>
                                            }
                                            @* The macOS recovery PIN is shown back exactly once, here: the operator
                                               must give it to the device owner and Intune does not return it later.
                                               It is never written to the audit record or the notification. *@
                                            @if (outcome.MacOsUnlockCodeShownOnce != null)
                                            {
                                                <div class="alert alert-warning mb-0 mt-2 py-2">
                                                    <strong>Record this macOS recovery PIN now - it cannot be retrieved afterwards:</strong>
                                                    <code>@outcome.MacOsUnlockCodeShownOnce</code>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }

                                @if (expandedDeviceId == device.Id)
                                {
                                    <tr>
                                        <td colspan="@DetailColspan" class="bg-light">
                                            @if (detailLoading)
                                            {
                                                <span class="spinner-border spinner-border-sm me-2"></span> <small>Loading detail...</small>
                                            }
                                            else if (detailError != null)
                                            {
                                                <div class="alert alert-danger mb-0 py-2">@detailError</div>
                                            }
                                            else if (detailDevice != null)
                                            {
                                                <dl class="row mb-0 small">
                                                    <dt class="col-sm-3">Managed device name</dt><dd class="col-sm-9">@detailDevice.ManagedDeviceName</dd>
                                                    <dt class="col-sm-3">User display name</dt><dd class="col-sm-9">@detailDevice.UserDisplayName</dd>
                                                    <dt class="col-sm-3">Manufacturer / model</dt><dd class="col-sm-9">@detailDevice.Manufacturer @detailDevice.Model</dd>
                                                    <dt class="col-sm-3">Serial number</dt><dd class="col-sm-9">@detailDevice.SerialNumber</dd>
                                                    <dt class="col-sm-3">IMEI / MEID</dt><dd class="col-sm-9">@detailDevice.Imei @detailDevice.Meid</dd>
                                                    <dt class="col-sm-3">Wi-Fi / Ethernet MAC</dt><dd class="col-sm-9">@detailDevice.WiFiMacAddress @detailDevice.EthernetMacAddress</dd>
                                                    <dt class="col-sm-3">Enrolled</dt><dd class="col-sm-9">@(detailDevice.EnrolledDateTime?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")</dd>
                                                    <dt class="col-sm-3">Last sync</dt><dd class="col-sm-9">@(detailDevice.LastSyncDateTime?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")</dd>
                                                    <dt class="col-sm-3">Management agent</dt><dd class="col-sm-9">@detailDevice.ManagementAgent</dd>
                                                    <dt class="col-sm-3">Owner type</dt><dd class="col-sm-9">@detailDevice.ManagedDeviceOwnerType</dd>
                                                    <dt class="col-sm-3">Enrollment type</dt><dd class="col-sm-9">@detailDevice.DeviceEnrollmentType</dd>
                                                    <dt class="col-sm-3">Registration state</dt><dd class="col-sm-9">@detailDevice.DeviceRegistrationState</dd>
                                                    <dt class="col-sm-3">Encrypted</dt><dd class="col-sm-9">@(detailDevice.IsEncrypted ? "Yes" : "No")</dd>
                                                    <dt class="col-sm-3">Supervised</dt><dd class="col-sm-9">@(detailDevice.IsSupervised ? "Yes" : "No")</dd>
                                                    <dt class="col-sm-3">Jailbroken / rooted</dt><dd class="col-sm-9">@(detailDevice.JailBroken ? "Yes" : "No")</dd>
                                                    <dt class="col-sm-3">Entra ID device id</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(detailDevice.AzureADDeviceId) ? "(none)" : detailDevice.AzureADDeviceId)</dd>
                                                    <dt class="col-sm-3">Entra ID registered</dt><dd class="col-sm-9">@(detailDevice.AzureADRegistered ? "Yes" : "No")</dd>
                                                    <dt class="col-sm-3">Storage</dt><dd class="col-sm-9">@FormatStorage(detailDevice.FreeStorageSpaceInBytes, detailDevice.TotalStorageSpaceInBytes)</dd>
                                                    <dt class="col-sm-3">Notes</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(detailDevice.Notes) ? "(none)" : detailDevice.Notes)</dd>
                                                </dl>

                                                @* S5: the Entra ID record often outlives the Intune one, so its removal
                                                   is runnable ON ITS OWN - an operator cleaning up must not have to run
                                                   a second Intune action to reach it. Same handler, same gate chain. *@
                                                @if (canEntraDelete)
                                                {
                                                    <div class="mt-3">
                                                        @if (EntraIdUsable(detailDevice))
                                                        {
                                                            <button class="btn btn-outline-danger btn-sm"
                                                                    @onclick="() => BeginAction(device, IntuneDeviceAction.EntraDelete)"
                                                                    disabled="@ActionsDisabled">Remove Entra ID object</button>
                                                            <div class="form-text">
                                                                Removes the directory record only. The Intune record and the data on the
                                                                device are unaffected.
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="form-text">
                                                                No Entra ID device object to remove for this device.
                                                                Intune holds no usable Entra ID device id for it.
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@code {
    private string currentUser = "";
    private string clientIpAddress = "Unknown";
    private bool authChecked;

    private string searchTerm = "";
    private bool isSearching;
    private bool hasSearched;

    /// <summary>
    /// Whether the "What do these actions do?" panel is open. Closed by default (owner ruling
    /// 2026-09-02) and toggled from C#, NOT by data-bs-toggle: this app ships Bootstrap's
    /// stylesheet only (Components/App.razor loads bootstrap.min.css and no bootstrap JS), so a
    /// data-bs-toggle button would render and do nothing. The markup still uses Bootstrap's
    /// .collapse / .show classes, which are pure CSS.
    /// </summary>
    private bool showActionHelp;
    private string? errorMessage;
    private List<IntuneDevice> devices = [];
    private bool truncated;
    private int searchedCount;

    private string? expandedDeviceId;
    private bool detailLoading;
    private string? detailError;
    private IntuneDevice? detailDevice;

    /// <summary>Granular IntuneDevicesDelete grant. Controls RENDERING only; the handler re-checks
    /// the same policy immediately before it writes (T6 / Spec, Page Authorization item 3).</summary>
    private bool canDelete;

    /// <summary>Granular IntuneDevicesPrivileged grant (retire and wipe, D1's second tier). Controls
    /// RENDERING only, exactly as canDelete does.</summary>
    private bool canPrivileged;

    /// <summary>Granular IntuneDevicesEntraDelete grant (S5 / D3). Its own tier because
    /// Device.ReadWrite.All is a DIRECTORY scope - the widest grant in the module - and an operator
    /// entitled to wipe a phone is not automatically entitled to remove directory records. Controls
    /// RENDERING only: the handler re-checks this same policy immediately before the Entra write,
    /// including when it runs as the second half of an Intune action (T6).</summary>
    private bool canEntraDelete;

    /// <summary>Module id for the servicer grant. Must match the catalog descriptor, and must be
    /// listed in ModuleConfig.razor's ModulesWithProtectedPrincipalServicing or no group can ever
    /// be granted it.</summary>
    private const string ServicerModuleId = "IntuneDevices";

    private string? confirmDeviceId;
    private IntuneDeviceAction? confirmAction;
    private string actionTicket = "";
    private string? actingDeviceId;

    // Wipe options (S4 / D2). Defaults are the full-reset reading of the button's own label; every
    // non-default choice is visible on screen and recorded in the audit event.
    private bool wipeKeepUserData;
    private bool wipeKeepEnrollmentData;
    private bool wipePersistEsimDataPlan;
    private string wipeMacOsUnlockCode = "";
    private string wipeObliterationBehavior = "";

    /// <summary>Typed device name confirming a wipe. Wipe alone requires it: retire is recoverable by
    /// re-enrolling, a wipe destroys the machine's contents.</summary>
    private string wipeConfirmName = "";

    /// <summary>
    /// The per-action "also remove the Entra ID device object" choice (S5 / D3), starting unticked
    /// (IntuneDeviceService.EntraRemovalStartsTicked) when the confirm bar opens and changeable
    /// before confirming. Rendering-only, like the wipe flags: the handler re-checks the Entra
    /// permission before it acts on this.
    /// </summary>
    private bool alsoRemoveEntra;

    /// <summary>
    /// The per-action "email the device's primary user" choice (S6), starting from this action's
    /// fixed state (IntuneDeviceService.NotifyUserStartsTicked) when the confirm bar opens and
    /// changeable before confirming - the lost-or-stolen case is why the operator, not a
    /// deployment-wide setting, decides it (owner ruling 2026-09-02).
    /// </summary>
    private bool notifyPrimaryUser;

    /// <summary>One outcome per device id, so acting on several rows leaves several separately named
    /// verdicts and no row can display another row's result (Known Failure Class 2).</summary>
    private readonly Dictionary<string, DeviceOutcome> deviceOutcomes = [];

    /// <summary>
    /// One device's verdict. EntraMessage and EntraSuccess are SEPARATE fields rather than text
    /// merged into Message: the Intune half and the Entra half are two acts against two objects, and
    /// collapsing them would hide the half-finished case (S5, Known Failure Class 2). Null
    /// EntraMessage means the Entra step never ran.
    /// </summary>
    internal sealed record DeviceOutcome(
        string DeviceName, bool Success, string Message, string? ServicedNote, string? MacOsUnlockCodeShownOnce = null,
        string? EntraMessage = null, bool? EntraSuccess = null,
        string? NotificationNote = null, bool NotificationSent = false);

    private DeviceOutcome? OutcomeFor(string deviceId) =>
        deviceOutcomes.TryGetValue(deviceId, out var outcome) ? outcome : null;

    private bool ActionsDisabled => isSearching || actingDeviceId != null;

    /// <summary>Column count for a full-width row; tracks the conditional Actions column.</summary>
    private int DetailColspan => CanActAtAll ? 7 : 6;

    private bool CanActAtAll => canDelete || canPrivileged;

    /// <summary>Rendering-time grant for one action. The handler re-checks the same policy before it
    /// writes (T6); this only decides whether the control is drawn.</summary>
    private bool CanAct(IntuneDeviceAction action) => action switch
    {
        IntuneDeviceAction.Delete => canDelete,
        IntuneDeviceAction.EntraDelete => canEntraDelete,
        _ => canPrivileged
    };

    /// <summary>
    /// Whether this device has an Entra ID device object the module can address at all (S5 / AC24).
    /// A device that is not Entra-joined carries azureADDeviceId absent, empty or all-zero, and the
    /// option is then not offered WITH THE REASON STATED - never offered-and-silently-skipped.
    /// </summary>
    private static bool EntraIdUsable(IntuneDevice device) =>
        IntuneDeviceService.IsUsableEntraDeviceId(device.AzureADDeviceId);

    /// <summary>
    /// True unless this is a wipe whose typed device name does not match. Any action other than wipe
    /// is unaffected, so the extra step never spreads to the recoverable ones.
    /// </summary>
    private bool WipeNameConfirmed(IntuneDevice device, IntuneDeviceAction action) =>
        action != IntuneDeviceAction.Wipe
        || string.Equals(wipeConfirmName.Trim(), DeviceLabel(device), StringComparison.OrdinalIgnoreCase);

    private IntuneWipeOptions CurrentWipeOptions() => new(
        KeepUserData: wipeKeepUserData,
        KeepEnrollmentData: wipeKeepEnrollmentData,
        MacOsUnlockCode: string.IsNullOrWhiteSpace(wipeMacOsUnlockCode) ? null : wipeMacOsUnlockCode.Trim(),
        ObliterationBehavior: string.IsNullOrWhiteSpace(wipeObliterationBehavior) ? null : wipeObliterationBehavior,
        PersistEsimDataPlan: wipePersistEsimDataPlan);

    /// <summary>
    /// Every per-confirm option back to its default: the wipe flag set and the Entra ID add-on
    /// choice. One method so no option can be left behind when the confirm bar opens, is cancelled,
    /// or finishes - the blr-3 shape (state emptied, one field forgotten).
    /// </summary>
    private void ResetActionOptions()
    {
        wipeKeepUserData = false;
        wipeKeepEnrollmentData = false;
        wipePersistEsimDataPlan = false;
        wipeMacOsUnlockCode = "";
        wipeObliterationBehavior = "";
        wipeConfirmName = "";
        alsoRemoveEntra = false;
        notifyPrimaryUser = false;
    }

    private string? ServicerNoteFor(System.Security.Claims.ClaimsPrincipal? user, IEnumerable<string> matchedRules, string? qualifier = null) =>
        ProtectedPrincipalServicing.NoteFor(Servicers, user, ServicerModuleId, matchedRules, qualifier);

    private static Dictionary<string, object?>? ServicedExtra(string? note) =>
        ProtectedPrincipalServicing.Extra(note);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUser = user.Identity?.Name ?? "Unknown";

        var authResult = await AuthorizationService.AuthorizeAsync(user, "IntuneDevices");
        if (!authResult.Succeeded)
        {
            Navigation.NavigateTo("access-denied", forceLoad: true);
            return;
        }

        // The granular grant layers ON TOP of the main one (Spec, Authorization Layering), so this
        // is only reached once module access is established.
        canDelete = (await AuthorizationService.AuthorizeAsync(user, "IntuneDevicesDelete")).Succeeded;
        canPrivileged = (await AuthorizationService.AuthorizeAsync(user, "IntuneDevicesPrivileged")).Succeeded;
        canEntraDelete = (await AuthorizationService.AuthorizeAsync(user, "IntuneDevicesEntraDelete")).Succeeded;

        clientIpAddress = ClientInfo.IpAddress != "Unknown"
            ? ClientInfo.IpAddress
            : ClientInfo.GetIpForUser(currentUser);
        authChecked = true;
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !isSearching)
            await SearchAsync();
    }

    private async Task SearchAsync()
    {
        isSearching = true;
        // Cleared at the start of every search, not only the first - otherwise a second search
        // would render the first search's now-stale verdict while it is in flight.
        hasSearched = false;
        errorMessage = null;
        devices = [];
        truncated = false;
        searchedCount = 0;
        expandedDeviceId = null;
        detailDevice = null;
        detailError = null;
        // Write-path state is retracted with the rest of it: a per-device outcome or an open confirm
        // bar left over from the previous search would attach to whatever row happens to share that
        // id in the new one (the blr-3 shape - state emptied, one field left behind).
        confirmDeviceId = null;
        confirmAction = null;
        actionTicket = "";
        ResetActionOptions();
        deviceOutcomes.Clear();
        await Task.Yield();

        var target = DescribeSearch(searchTerm);

        try
        {
            var result = await IntuneDeviceService.SearchDevicesAsync(searchTerm);
            devices = [.. result.Devices];
            truncated = result.Truncated;
            searchedCount = result.SearchedCount;

            SafeAudit(() => Audit.LogLookupAction(currentUser, clientIpAddress, "IntuneDevices_Search", target, true));
        }
        catch (Exception ex)
        {
            // A failed request must never render as "no devices found" (T7) - the service throws
            // rather than returning an empty result, and that exception is surfaced here as a
            // distinct alert, never folded into the empty-results branch.
            errorMessage = ex.Message;
            Logger.LogError(ex, "Failed to search Intune devices.");

            SafeAudit(() => Audit.LogLookupAction(currentUser, clientIpAddress, "IntuneDevices_Search", target, false, ex.Message));
        }
        finally
        {
            hasSearched = true;
            isSearching = false;
        }
    }

    private async Task ToggleDetailAsync(IntuneDevice device)
    {
        if (expandedDeviceId == device.Id)
        {
            expandedDeviceId = null;
            return;
        }

        expandedDeviceId = device.Id;
        detailLoading = true;
        detailError = null;
        detailDevice = null;
        await Task.Yield();

        var target = $"{device.DeviceName} ({device.Id})";

        try
        {
            detailDevice = await IntuneDeviceService.GetDeviceAsync(device.Id);

            SafeAudit(() => Audit.LogLookupAction(currentUser, clientIpAddress, "IntuneDevices_Detail", target, true));
        }
        catch (Exception ex)
        {
            detailError = ex.Message;
            Logger.LogError(ex, "Failed to load Intune device detail for {DeviceId}.", device.Id);

            SafeAudit(() => Audit.LogLookupAction(currentUser, clientIpAddress, "IntuneDevices_Detail", target, false, ex.Message));
        }
        finally
        {
            detailLoading = false;
        }
    }

    private void SafeAudit(Action write)
    {
        try
        {
            write();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to write Intune Devices audit record.");
        }
    }

    // ---- write path (S3) ----------------------------------------------------------------------

    private void BeginAction(IntuneDevice device, IntuneDeviceAction action)
    {
        // Opening a confirm bar retracts the previous verdict for THAT device only - every other row
        // keeps its own outcome.
        confirmDeviceId = device.Id;
        confirmAction = action;
        actionTicket = "";
        // Wipe options start from their defaults on every confirm, so a choice made for one device
        // never rides along into the next one.
        ResetActionOptions();
        // The Entra add-on starts from its fixed state - unticked - so it is always opted into by
        // the operator confirming this action (owner ruling 2026-09-02), never inherited from a
        // deployment-wide setting.
        alsoRemoveEntra = IntuneDeviceService.EntraRemovalStartsTicked;
        // Same shape for the affected-user notification (S6 / AC18): THIS action's fixed state seeds
        // the box, and the operator may change it before confirming. Null means the action offers no
        // notification at all, which reads as unticked.
        notifyPrimaryUser = IntuneDeviceService.NotifyUserStartsTicked(action) ?? false;
        deviceOutcomes.Remove(device.Id);
    }

    private void CancelAction()
    {
        confirmDeviceId = null;
        confirmAction = null;
        actionTicket = "";
        ResetActionOptions();
    }

    private void SetOutcome(string deviceId, string deviceName, bool success, string message, string? servicedNote,
        string? macOsUnlockCodeShownOnce = null, string? entraMessage = null, bool? entraSuccess = null,
        string? notificationNote = null, bool notificationSent = false) =>
        deviceOutcomes[deviceId] = new DeviceOutcome(deviceName, success, message, servicedNote, macOsUnlockCodeShownOnce,
            entraMessage, entraSuccess, notificationNote, notificationSent);

    /// <summary>
    /// Runs one destructive action against one device behind every gate S3 requires, in order:
    /// granular authorization re-check (T6), mandatory ticket, protected-principal check on the
    /// device's PRIMARY USER (T4, T5), then the write. Every path - refusal, fail-closed protection
    /// outcome, exception, success - audits with the ticket and the device, and every real attempt
    /// notifies administrators from finally.
    /// </summary>
    /// <remarks>
    /// Fail-closed throughout (Known Failure Class 3): no gate falls through to a permissive
    /// default, and a protection check that cannot be evaluated REFUSES rather than allowing. The
    /// only way to record a failure here is Refuse, which audits as it refuses - so a refusal path
    /// added later cannot forget the audit record.
    /// </remarks>
    private async Task ExecuteActionAsync(IntuneDevice device, IntuneDeviceAction action)
    {
        // Bound before the first await: a slow action must attach its verdict to the device it was
        // started from, not to whichever row the operator opened while it was in flight.
        var deviceId = device.Id;
        var deviceName = DeviceLabel(device);
        var upn = device.UserPrincipalName;
        var ticket = actionTicket.Trim();
        var auditAction = AuditActionFor(action);
        var target = $"{deviceName} ({deviceId})";
        // Bound with the rest of the request: the operator's chosen flag set is what gets sent,
        // audited and reported, even if the panel is re-rendered while the call is in flight.
        var wipeOptions = action == IntuneDeviceAction.Wipe ? CurrentWipeOptions() : null;
        // S5: azureADDeviceId is captured HERE, BEFORE any Intune action runs, and never read back
        // afterwards - a deleted Intune record cannot be read, so there would be nothing left to
        // take it from. This ordering is the slice's Known Failure Class 2 requirement and a test
        // asserts the capture precedes the write.
        var entraDeviceId = device.AzureADDeviceId;
        // The Entra add-on rides on an Intune action only; the standalone action performs the same
        // removal through PerformActionAsync instead. The permission is NOT consulted here - this is
        // the operator's request, and RemoveEntraObjectAsync re-checks the grant before it writes.
        var removeEntraObject = action != IntuneDeviceAction.EntraDelete
            && alsoRemoveEntra
            && IntuneDeviceService.IsUsableEntraDeviceId(entraDeviceId);
        // S6: the operator's notification choice and the fixed state it was seeded from are both
        // bound here, before the first await. The starting state travels so the audit record can say
        // WHICH not-sent reason applied - nobody asked, or the operator cleared a ticked box.
        var notifyRequested = notifyPrimaryUser;
        var notifyDefault = IntuneDeviceService.NotifyUserStartsTicked(action) ?? false;

        void Refuse(string message, string auditDetail)
        {
            SetOutcome(deviceId, deviceName, false, message, null);
            SafeAudit(() => Audit.LogModuleAction(currentUser, clientIpAddress, auditAction, "IntuneDevices", target, false, ticket,
                errorDetail: auditDetail));
        }

        actingDeviceId = deviceId;
        confirmDeviceId = null;
        confirmAction = null;
        deviceOutcomes.Remove(deviceId);
        await Task.Yield();

        // Set when an authorised servicer overrode a protected-principal refusal, and carried into
        // the SUCCESS audit's extra below and onto the screen.
        string? servicedAuditDetail = null;
        // Notify admins on any real attempt against the device - success, protected refusal,
        // fail-closed protection outcome or exception - but not on the trivial authorization and
        // ticket pre-gates, which never reached the device.
        var notifyAdmins = false;
        IntuneDeviceActionResult? result = null;
        // Non-null only when the Entra half actually ran, so its verdict, its audit event and its
        // admin notification exist exactly when there was a second act to report (S5).
        IntuneDeviceActionResult? entraResult = null;

        try
        {
            // 1. Granular authorization, re-checked immediately before execution (T6). The page-load
            //    check hides the buttons; it is not the decision, because a grant can be revoked
            //    while the page is open.
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var policy = PolicyFor(action);
            var actionCheck = await AuthorizationService.AuthorizeAsync(authState.User, policy);
            if (!actionCheck.Succeeded)
            {
                Refuse($"Authorization denied. {ActionLabel(action)} requires the {PermissionLabel(action)} permission.",
                    $"Authorization denied - {policy}");
                return;
            }

            // 2. Ticket, mandatory. Presence is checked separately from validation because the
            //    ServiceNow client passes every ticket while the integration is dormant, so
            //    validation alone would admit a blank ticket on a deployment without it.
            if (string.IsNullOrWhiteSpace(ticket))
            {
                Refuse("A ticket number is required.", "Ticket number missing");
                return;
            }

            var ticketValidation = await ServiceNow.ValidateTicketAsync(ticket);
            if (!ticketValidation.IsValid)
            {
                Refuse($"Ticket validation failed: {ticketValidation.Message}",
                    $"Ticket validation failed: {ticketValidation.Message}");
                return;
            }

            notifyAdmins = true;

            // 3. Protected-principal check on the device's PRIMARY USER, BEFORE the write and never
            //    after it (T4). A device is not a principal, but wiping the CEO's laptop is exactly
            //    the harm the rule exists for, and the guard binds to the target of the write.
            //
            //    Intune devices belong to CLOUD identities, so an unresolved directory lookup must
            //    NOT skip the check: the group, OU and SamAccountName-pattern rules are evaluated
            //    from an on-premises DN and can never match a cloud-only principal, which is
            //    protected by the protected USER rows or not at all (Constitution, Protected
            //    Principals, final bullet). That skip is the defect MfaReset shipped before 1.1.0.
            try
            {
                if (string.IsNullOrWhiteSpace(upn))
                {
                    // A device with no primary user (shared, kiosk, or Autopilot pre-provisioned) is
                    // a DETERMINATE answer - there is no principal to protect, so the action
                    // proceeds (T4 / AC10). This is not the failed-read case: `device` came from a
                    // successful 2xx read, because a non-success read throws in the service (T7) and
                    // never produces a row to act on.
                    Logger.LogInformation(
                        "Intune device {DeviceId} has no primary user - no principal to protect; proceeding", deviceId);
                }
                else
                {
                    var (resolved, resolutionStatus) = await ProtectedPrincipalService.ResolveWithExchangeFallbackAsync(upn);
                    if (resolutionStatus is ProtectedPrincipalService.ResolutionStatus.Unavailable or ProtectedPrincipalService.ResolutionStatus.Ambiguous)
                    {
                        var reason = resolutionStatus == ProtectedPrincipalService.ResolutionStatus.Ambiguous
                            ? "The device's primary user is ambiguous - the identity matches multiple directory users."
                            : "Protection check unavailable for the device's primary user.";
                        Refuse(reason, $"{reason} - blocked");
                        return;
                    }

                    if (resolved != null)
                    {
                        var protectionCheck = await ProtectedPrincipalService.CheckAsync(resolved);
                        if (protectionCheck.CheckFailed)
                        {
                            Refuse($"Protection check failed: {protectionCheck.Reason}",
                                $"Protection check failed: {protectionCheck.Reason}");
                            return;
                        }
                        if (protectionCheck.IsProtected)
                        {
                            // An authorised servicer may proceed; everyone else is refused.
                            // Protection is evaluated first and never weakened - this only decides
                            // whether THIS operator may act on a target already known protected.
                            servicedAuditDetail = ServicerNoteFor(authState.User, protectionCheck.MatchedRules);
                            if (servicedAuditDetail is null)
                            {
                                Refuse($"The primary user of this device is a protected principal. {ActionLabel(action)} is not permitted.",
                                    $"Protected principal - matched rules: {string.Join(", ", protectionCheck.MatchedRules)}");
                                return;
                            }
                        }
                    }
                    else
                    {
                        // Unresolved is NOT "nothing to protect". The protected USER rows are checked
                        // against the raw identity, and the one improvement over the MfaReset shape
                        // this copies: the managedDevice carries userId, the Entra object id of the
                        // primary user, and ProtectedPrincipalService.MatchesIdentity compares
                        // EntraObjectId against every protected USER row - so populating it makes
                        // object-id-based protection genuinely effective for a cloud-only user.
                        var unresolved = new ResolvedDirectoryPrincipal(
                            Source: "IntuneDevices-Unresolved",
                            DisplayName: string.IsNullOrWhiteSpace(device.UserDisplayName) ? upn : device.UserDisplayName,
                            UserPrincipalName: upn,
                            SamAccountName: null,
                            PrimarySmtpAddress: upn.Contains('@') ? upn : null,
                            DistinguishedName: null,
                            ObjectGuid: null,
                            EntraObjectId: string.IsNullOrWhiteSpace(device.UserId) ? null : device.UserId);

                        var unresolvedCheck = await ProtectedPrincipalService.CheckAsync(unresolved);
                        if (unresolvedCheck.CheckFailed)
                        {
                            Refuse($"Protection check failed: {unresolvedCheck.Reason}",
                                $"Protection check failed: {unresolvedCheck.Reason}");
                            return;
                        }
                        if (unresolvedCheck.IsProtected)
                        {
                            // Both branches honour the servicer grant, or a cloud-only protected
                            // identity becomes the one case a servicer cannot service - precisely
                            // this module's population.
                            servicedAuditDetail = ServicerNoteFor(authState.User, unresolvedCheck.MatchedRules, "directory-unresolved");
                            if (servicedAuditDetail is null)
                            {
                                Refuse($"The primary user of this device is a protected principal. {ActionLabel(action)} is not permitted.",
                                    $"Protected principal (directory-unresolved) - matched rules: {string.Join(", ", unresolvedCheck.MatchedRules)}");
                                return;
                            }
                        }

                        Logger.LogInformation(
                            "No such recipient in Active Directory or Exchange Online for {Upn}; protected user rows matched neither the raw identity nor its Entra object id - proceeding", upn);
                    }
                }
            }
            catch (Exception ex)
            {
                // Fail closed: an errored check says nothing about the target, so it can never be
                // read as permission (Known Failure Class 3).
                Logger.LogWarning(ex, "Protected principal check failed for {Upn} - blocking as precaution", upn);
                Refuse($"Protection check error: {ex.Message}", $"Protection check exception: {ex.Message}");
                return;
            }

            // 4. The write. Reachable only with every gate above passed.
            var applied = await PerformActionAsync(action, deviceId, wipeOptions, entraDeviceId);
            result = applied;

            // 5. The Entra ID device object, SECOND and only when the Intune action actually
            //    succeeded - the operator's intent was conditional on the first step, and removing
            //    the directory object after a failed retire would leave a device that cannot
            //    authenticate and still holds company data. It cannot throw (see
            //    RemoveEntraObjectAsync), so the audit writes below stay reachable.
            if (removeEntraObject && applied.Success)
                entraResult = await RemoveEntraObjectAsync(authState.User, entraDeviceId);

            // 6. The affected-user notification (S6 / D2), attempted BEFORE the audit write so the
            //    audit event records what actually happened - "was the user told?" is an audit
            //    question and a silent no is indistinguishable from a failure. It cannot throw and
            //    never changes the reported result of the device action: the device is already wiped
            //    by then (Constitution, Notifications).
            var notification = await NotifyPrimaryUserAsync(
                action, upn, deviceName, ticket, notifyRequested, notifyDefault, applied.Success);

            SetOutcome(deviceId, deviceName, applied.Success,
                // AC11's conditional half: a delete that removed the Entra ID object too must stop
                // claiming that object survives.
                IntuneMessageFor(action, applied.Message, entraResult?.Success == true),
                applied.Success ? servicedAuditDetail : null,
                // The macOS recovery PIN is shown back exactly once, and only on the path where the
                // wipe was actually queued - the operator must hand it to the device owner and Intune
                // will not return it later.
                applied.Success ? wipeOptions?.MacOsUnlockCode : null,
                // Separate fields, never text merged into the Intune message: two acts against two
                // objects report two verdicts (Known Failure Class 2).
                entraResult?.Message, entraResult?.Success,
                // AC19: a suppressed send is stated on screen, never reported as a send.
                notification.Note, notification.Sent);

            // The serviced note rides extra, never errorDetail: LogModuleAction writes
            // ["error"] = success ? null : errorDetail (Services/AuditService.cs), so the one field
            // explaining why a protected user's device could be acted on would be discarded on
            // exactly the success path that needs it (pps-3). The wipe flag set rides the same
            // channel, for the same reason: a successful wipe is exactly the event whose flags
            // anyone will ask about afterwards (AC21).
            SafeAudit(() => Audit.LogModuleAction(currentUser, clientIpAddress, auditAction, "IntuneDevices", target, applied.Success, ticket,
                errorDetail: applied.Success ? null : applied.Message,
                extra: ActionAuditExtra(action, wipeOptions, servicedAuditDetail, notification.Note)));

            // The Entra half's OWN audit event, under its own action name and against a target naming
            // the deviceId the DELETE actually used (S5 / AC23). Two events, never one merged
            // verdict: "Intune record deleted, Entra ID object not removed" must be readable from
            // the audit trail afterwards, not inferred.
            if (entraResult != null)
            {
                var entraOutcome = entraResult;
                SafeAudit(() => Audit.LogModuleAction(currentUser, clientIpAddress,
                    AuditActionFor(IntuneDeviceAction.EntraDelete), "IntuneDevices",
                    EntraAuditTarget(deviceName, entraDeviceId), entraOutcome.Success, ticket,
                    errorDetail: entraOutcome.Success ? null : entraOutcome.Message,
                    extra: ActionAuditExtra(IntuneDeviceAction.EntraDelete, null, servicedAuditDetail)));
            }

            Logger.LogInformation("User {Admin} ran {Action} against Intune device {Target} (ticket {Ticket}): {Result}",
                currentUser, auditAction, target, ticket, applied.Message);
        }
        catch (Exception ex)
        {
            Refuse(ex.Message, ex.Message);
            Logger.LogError(ex, "Intune device action {Action} failed for {DeviceId}.", auditAction, deviceId);
        }
        finally
        {
            actingDeviceId = null;
            actionTicket = "";
            // The panel's controls are retracted, but the outcome (including the one-time PIN
            // display) keeps its own copy, so this cannot erase what the operator still needs.
            ResetActionOptions();

            // Mandatory admin notification on every real attempt (Constitution, Notifications), in
            // finally and wrapped so a send failure cannot change the reported result (AC13).
            if (notifyAdmins)
            {
                var success = result?.Success ?? false;
                var message = OutcomeFor(deviceId)?.Message;
                try
                {
                    await Email.SendAdminNotificationAsync(currentUser, clientIpAddress, auditAction,
                        success, ticket,
                        NotificationDetails(device, action, deviceName, wipeOptions),
                        success ? null : message);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Failed to send Intune Devices admin notification for {DeviceId}", deviceId);
                }
            }

            // The Entra half's own admin notification, when it ran (AC13: an administrator
            // notification on every audited action). Separately wrapped, so neither send can change
            // either reported result, and neither can suppress the other.
            if (entraResult != null)
            {
                try
                {
                    await Email.SendAdminNotificationAsync(currentUser, clientIpAddress,
                        AuditActionFor(IntuneDeviceAction.EntraDelete), entraResult.Success, ticket,
                        EntraNotificationDetails(device, deviceName, entraDeviceId),
                        entraResult.Success ? null : entraResult.Message);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Failed to send Intune Devices Entra removal admin notification for {DeviceId}", deviceId);
                }
            }
        }
    }

    /// <summary>
    /// The Entra ID device object removal, run as the SECOND half of an Intune action.
    /// </summary>
    /// <remarks>
    /// T6 applies to this write on its own terms: IntuneDevicesEntraDelete is re-checked immediately
    /// before it, never inherited from the Intune action's check at step 1. Device.ReadWrite.All is a
    /// directory scope and the widest grant in the module, so an operator who may delete an Intune
    /// record must not reach this by ticking a box.
    ///
    /// Never throws. An exception escaping here would reach ExecuteActionAsync's catch, which calls
    /// Refuse and would report the WHOLE action as failed - including an Intune half that already
    /// succeeded - and would skip the Intune audit write entirely (Known Failure Class 1). It
    /// becomes this half's own failed outcome instead, which is the honest report.
    /// </remarks>
    private async Task<IntuneDeviceActionResult> RemoveEntraObjectAsync(
        System.Security.Claims.ClaimsPrincipal user, string? entraDeviceId)
    {
        try
        {
            var entraCheck = await AuthorizationService.AuthorizeAsync(user, PolicyFor(IntuneDeviceAction.EntraDelete));
            if (!entraCheck.Succeeded)
            {
                return new IntuneDeviceActionResult(false,
                    $"Authorization denied. Removing the Entra ID device object requires the "
                    + $"{PermissionLabel(IntuneDeviceAction.EntraDelete)} permission; the Intune action above was unaffected.",
                    null);
            }

            return await IntuneDeviceService.RemoveEntraDeviceAsync(entraDeviceId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to remove the Entra ID device object {EntraDeviceId}", entraDeviceId);
            return new IntuneDeviceActionResult(false,
                $"The Entra ID device object could not be removed: {ex.Message}", null);
        }
    }

    /// <summary>
    /// Decides, attempts, and REPORTS the affected-user notification for one action (S6 / D2 /
    /// AC18-AC20). Returns the sentence shown on screen and written to the audit record, and whether
    /// a mail actually went.
    /// </summary>
    /// <remarks>
    /// Never throws and never changes the device action's reported result (Constitution,
    /// Notifications; plan S6): the device is already wiped by the time this runs.
    ///
    /// The app-wide gate is read from EmailService.UserNotificationsEnabled - the same field that
    /// gates the send - so the statement and the send cannot disagree. A ticked box on a deployment
    /// with user notifications off returns the suppression reason, which the caller puts on screen
    /// AND in the audit event; without that the checkbox would be a control that silently does
    /// nothing (AC19).
    /// </remarks>
    private async Task<(string? Note, bool Sent)> NotifyPrimaryUserAsync(
        IntuneDeviceAction action, string upn, string deviceName, string ticket, bool requested, bool configuredDefault,
        bool actionSucceeded)
    {
        // The standalone Entra removal has no user notification (only the three Intune actions offer
        // one), so it reports nothing rather than an empty not-sent note.
        if (!NotificationOffered(action))
            return (null, false);

        if (!actionSucceeded)
        {
            // Silence only when nobody asked. A ticked box whose action failed still gets an answer,
            // or an operator is left assuming their user was told.
            return (requested
                ? "No email was sent to the device's primary user: the action did not succeed, so nothing changed for them."
                : null, false);
        }

        var decision = IntuneDeviceService.DecideUserNotification(
            configuredDefault, requested, Email.UserNotificationsEnabled, upn);

        if (!decision.ShouldSend)
            return (decision.Reason, false);

        try
        {
            var sent = await Email.SendDeviceActionUserNotificationAsync(
                upn.Trim(), deviceName, ActionLabel(action), ticket);

            return sent
                ? ($"Emailed the device's primary user at {upn.Trim()}.", true)
                : ("The email to the device's primary user could not be sent; the failure is logged. "
                    + "The action itself completed.", false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to notify the primary user of Intune device {DeviceName}", deviceName);
            return ($"The email to the device's primary user could not be sent: {ex.Message} "
                + "The action itself completed.", false);
        }
    }

    /// <summary>
    /// Whether this action offers the affected-user notification at all. Exactly the three Intune
    /// actions do; the standalone Entra removal has none, because removing a directory object
    /// changes nothing the user can observe on their device - which is why its starting state is
    /// null rather than false.
    /// </summary>
    internal static bool NotificationOffered(IntuneDeviceAction action) =>
        IntuneDeviceService.NotifyUserStartsTicked(action) != null;

    /// <summary>
    /// AC11's conditional half: the delete result must stop claiming the device's Entra ID object
    /// survives once the Entra removal ran alongside it and succeeded. Retire and wipe never make
    /// that claim, and the standalone Entra action reports its own message, so both pass through.
    /// </summary>
    internal static string IntuneMessageFor(IntuneDeviceAction action, string intuneMessage, bool entraRemoved) =>
        action == IntuneDeviceAction.Delete && entraRemoved
            ? IntuneDeviceService.DeleteSuccessMessageEntraRemoved
            : intuneMessage;

    /// <summary>Audit target for the Entra half: the device name plus the deviceId the DELETE
    /// actually addressed (S5), so the record names the exact alternate key used.</summary>
    internal static string EntraAuditTarget(string deviceName, string? entraDeviceId) =>
        $"{deviceName} (Entra deviceId {(string.IsNullOrWhiteSpace(entraDeviceId) ? "(none)" : entraDeviceId.Trim())})";

    /// <summary>Fields the Entra half's administrator notification carries. Its own set, because it
    /// is a different act against a different object and is reported separately.</summary>
    private static Dictionary<string, string> EntraNotificationDetails(
        IntuneDevice device, string deviceName, string? entraDeviceId) => new()
    {
        ["Device"] = deviceName,
        ["Managed Device Id"] = device.Id,
        ["Entra Device Id"] = string.IsNullOrWhiteSpace(entraDeviceId) ? "(none)" : entraDeviceId.Trim(),
        ["Primary User"] = string.IsNullOrWhiteSpace(device.UserPrincipalName) ? "(none)" : device.UserPrincipalName,
        ["Action"] = ActionLabel(IntuneDeviceAction.EntraDelete)
    };

    /// <summary>
    /// The single Graph write for this action. A switch rather than a direct call so each action
    /// keeps its own service method and no action can be run through another's endpoint.
    /// </summary>
    private Task<IntuneDeviceActionResult> PerformActionAsync(IntuneDeviceAction action, string deviceId,
        IntuneWipeOptions? wipeOptions, string? entraDeviceId) => action switch
    {
        IntuneDeviceAction.Delete => IntuneDeviceService.DeleteDeviceAsync(deviceId),
        IntuneDeviceAction.Retire => IntuneDeviceService.RetireDeviceAsync(deviceId),
        IntuneDeviceAction.Wipe => IntuneDeviceService.WipeDeviceAsync(deviceId,
            wipeOptions ?? throw new ArgumentNullException(nameof(wipeOptions), "A wipe must carry an explicit flag set.")),
        // The standalone Entra removal (S5). It reaches this only after step 1 re-checked
        // IntuneDevicesEntraDelete, which PolicyFor maps this action to.
        IntuneDeviceAction.EntraDelete => IntuneDeviceService.RemoveEntraDeviceAsync(entraDeviceId),
        _ => throw new ArgumentOutOfRangeException(nameof(action), action, "Unknown Intune device action.")
    };

    /// <summary>Fields the administrator notification carries. Never the device's
    /// activationLockBypassCode - IntuneDevice has no property holding it (T4b) - and never the
    /// operator-supplied macOS recovery PIN, which travels as (set)/(not set) inside the flag
    /// summary.</summary>
    private static Dictionary<string, string> NotificationDetails(
        IntuneDevice device, IntuneDeviceAction action, string deviceName, IntuneWipeOptions? wipeOptions)
    {
        var details = new Dictionary<string, string>
        {
            ["Device"] = deviceName,
            ["Managed Device Id"] = device.Id,
            ["Primary User"] = string.IsNullOrWhiteSpace(device.UserPrincipalName) ? "(none)" : device.UserPrincipalName,
            ["Action"] = ActionLabel(action)
        };

        if (action == IntuneDeviceAction.Wipe && wipeOptions != null)
            details["Wipe Flags"] = SummarizeWipeFlags(wipeOptions);

        return details;
    }

    /// <summary>
    /// The audit event's extra: the serviced-override note, and for a wipe the exact flag set used.
    /// </summary>
    /// <remarks>
    /// AC21: "wipe" alone cannot answer the only question anyone asks afterwards. A keepUserData wipe
    /// and a full reset are different acts, so the audit record names every flag at the value that
    /// was sent. The macOS recovery PIN is a device-unlock secret and appears as (set)/(not set) only
    /// - the T4b rule applied to an operator-supplied secret rather than a returned one.
    /// </remarks>
    internal static Dictionary<string, object?>? ActionAuditExtra(
        IntuneDeviceAction action, IntuneWipeOptions? wipeOptions, string? servicedNote,
        string? userNotificationNote = null)
    {
        var extra = ProtectedPrincipalServicing.Extra(servicedNote) ?? [];

        if (action == IntuneDeviceAction.Wipe && wipeOptions != null)
            extra["wipeFlags"] = SummarizeWipeFlags(wipeOptions);

        // S6 / AC19-AC20: notified, or not notified and why. The same sentence the operator saw, so
        // the screen and the audit trail cannot tell two different stories about whether the user
        // was told.
        if (!string.IsNullOrWhiteSpace(userNotificationNote))
            extra["userNotification"] = userNotificationNote;

        return extra.Count == 0 ? null : extra;
    }

    /// <summary>
    /// The exact flag set a wipe used, as one line for the audit record, the notification and the
    /// screen. Every parameter appears at the value that was sent, including the ones Graph was left
    /// to default, so two wipes are never indistinguishable afterwards. macOsUnlockCode is rendered
    /// (set)/(not set), never by value.
    /// </summary>
    internal static string SummarizeWipeFlags(IntuneWipeOptions options) =>
        $"keepUserData={options.KeepUserData.ToString().ToLowerInvariant()}; "
        + $"keepEnrollmentData={options.KeepEnrollmentData.ToString().ToLowerInvariant()}; "
        + $"persistEsimDataPlan={options.PersistEsimDataPlan.ToString().ToLowerInvariant()}; "
        + $"obliterationBehavior={(string.IsNullOrWhiteSpace(options.ObliterationBehavior) ? "(unset)" : options.ObliterationBehavior)}; "
        + $"macOsUnlockCode={(string.IsNullOrWhiteSpace(options.MacOsUnlockCode) ? "(not set)" : "(set)")}";

    /// <summary>
    /// Granular policy per action (D1's two tiers). Delete sits behind its own permission; an
    /// unknown member throws rather than defaulting to the lower tier.
    /// </summary>
    internal static string PolicyFor(IntuneDeviceAction action) => action switch
    {
        IntuneDeviceAction.Delete => "IntuneDevicesDelete",
        IntuneDeviceAction.Retire or IntuneDeviceAction.Wipe => "IntuneDevicesPrivileged",
        // Its OWN tier, not the privileged one (D3): a directory scope over every device object in
        // the tenant is not the same entitlement as wiping one phone.
        IntuneDeviceAction.EntraDelete => "IntuneDevicesEntraDelete",
        _ => throw new ArgumentOutOfRangeException(nameof(action), action, "Unknown Intune device action.")
    };

    /// <summary>
    /// Audit action name per action, so an audit query can tell a delete from a retire from a wipe.
    /// An unknown member throws rather than filing under a generic name that hides which ran.
    /// </summary>
    internal static string AuditActionFor(IntuneDeviceAction action) => action switch
    {
        IntuneDeviceAction.Delete => "IntuneDevices_Delete",
        IntuneDeviceAction.Retire => "IntuneDevices_Retire",
        IntuneDeviceAction.Wipe => "IntuneDevices_Wipe",
        IntuneDeviceAction.EntraDelete => "IntuneDevices_EntraDelete",
        _ => throw new ArgumentOutOfRangeException(nameof(action), action, "Unknown Intune device action.")
    };

    /// <summary>Button and prompt caption per action. No two share a leading verb and none is a bare
    /// "Remove" (docs/MigrationBatchSelection-Plan.md D6).</summary>
    internal static string ActionLabel(IntuneDeviceAction action) => action switch
    {
        IntuneDeviceAction.Delete => "Delete record",
        IntuneDeviceAction.Retire => "Retire",
        IntuneDeviceAction.Wipe => "Wipe",
        // Names the object it acts on, so it is not a bare "Remove" and shares no leading verb with
        // the other three.
        IntuneDeviceAction.EntraDelete => "Remove Entra ID object",
        _ => throw new ArgumentOutOfRangeException(nameof(action), action, "Unknown Intune device action.")
    };

    /// <summary>
    /// Plain-English explanation of what one action actually does, written for L2 support desk
    /// staff and deliberately simpler than Microsoft's own wording (owner ruling 2026-09-02).
    /// One canonical text per action: the help panel renders the whole block, each action button's
    /// title tooltip renders its first sentence, and the confirmation bar renders its first two -
    /// all three from HERE, so no wording can drift between them. The EntraDelete text serves both
    /// the standalone action and the "also remove the Entra ID object" checkbox, which do the same
    /// thing to the same object.
    /// </summary>
    internal static string ActionHelp(IntuneDeviceAction action) => action switch
    {
        IntuneDeviceAction.Delete =>
            "Removes the device from Intune only. Company data and apps stay on the device until it next checks in, "
            + "and if it never checks in, they stay forever. The device's Entra ID entry is not touched. "
            + "Use this to clean up a device that is already gone.",
        IntuneDeviceAction.Retire =>
            "Tells the device to remove company data, apps and settings, and to leave Intune management. "
            + "Personal data stays. Happens the next time the device checks in, which for a powered-off device may "
            + "be never. Use this for a device leaving the company that the person keeps.",
        IntuneDeviceAction.Wipe =>
            "Factory reset. Everything on the device is erased, personal and company, the next time it checks in. "
            + "Cannot be undone. Use this for a lost, stolen, or reassigned device.",
        IntuneDeviceAction.EntraDelete =>
            "Also deletes the device's entry in Entra ID, which is separate from Intune. Do this only when the "
            + "device is gone for good; a device still in use will lose its sign-in and may need to be re-joined.",
        _ => throw new ArgumentOutOfRangeException(nameof(action), action, "Unknown Intune device action.")
    };

    /// <summary>
    /// Same plain-English treatment for the "email the affected user" checkbox, which is an
    /// option rather than an action and so has no IntuneDeviceAction to hang off.
    /// </summary>
    internal const string NotifyUserHelp =
        "Sends the device's primary user a plain notice that the action was taken and which ticket authorized it.";

    /// <summary>
    /// The first <paramref name="sentences"/> sentences of an action's help text - one for a
    /// button tooltip, two for the confirmation bar. Derived rather than duplicated so a reworded
    /// block cannot leave a stale tooltip behind.
    /// </summary>
    internal static string ActionHelpSummary(IntuneDeviceAction action, int sentences) =>
        FirstSentences(ActionHelp(action), sentences);

    /// <summary>
    /// First N sentences of a text, splitting on ". " only - a block with fewer sentences than
    /// asked for returns whole rather than empty, and the final period is kept. None of the
    /// ActionHelp texts contains an abbreviation with a period, so this cannot cut mid-sentence.
    /// </summary>
    internal static string FirstSentences(string text, int sentences)
    {
        var end = 0;
        for (var found = 0; found < sentences; found++)
        {
            var next = text.IndexOf(". ", end, StringComparison.Ordinal);
            if (next < 0)
                return text;

            // Keep the period, drop the space that follows it.
            end = next + 1;
        }

        return text[..end];
    }

    /// <summary>Human-readable permission name for a refusal message.</summary>
    internal static string PermissionLabel(IntuneDeviceAction action) => action switch
    {
        IntuneDeviceAction.Delete => "Intune Devices Delete",
        IntuneDeviceAction.Retire or IntuneDeviceAction.Wipe => "Intune Devices Privileged",
        IntuneDeviceAction.EntraDelete => "Intune Devices Entra Delete",
        _ => throw new ArgumentOutOfRangeException(nameof(action), action, "Unknown Intune device action.")
    };

    /// <summary>
    /// Confirmation prompt per action. Delete says in words that it removes the Intune record only -
    /// company data stays on the device and the Entra ID object survives (T3 / AC11) - so the
    /// operator reads that BEFORE confirming, not only in the result.
    /// </summary>
    internal static string ConfirmPrompt(IntuneDeviceAction action, string deviceName) => action switch
    {
        IntuneDeviceAction.Delete =>
            $"Delete the Intune record for {deviceName}? This removes the Intune record only - company data stays on the device, "
            + "and the device's Entra ID object still exists.",
        IntuneDeviceAction.Retire =>
            $"Retire {deviceName}? Company data is removed at the device's next check-in; personal data is left alone, "
            + "and the device can be re-enrolled afterwards.",
        IntuneDeviceAction.Wipe =>
            $"Factory reset {deviceName}? The device is wiped at its next check-in and its contents are destroyed. "
            + "Type the device name below to confirm.",
        IntuneDeviceAction.EntraDelete =>
            $"Remove the Entra ID device object for {deviceName}? This removes the directory record only - the Intune "
            + "record and the data on the device are unaffected. It changes how the device authenticates, and "
            + "conditional access and compliance reporting notice it.",
        _ => throw new ArgumentOutOfRangeException(nameof(action), action, "Unknown Intune device action.")
    };

    /// <summary>Display name for a device, falling back to its id when Intune holds no device name,
    /// so an outcome or prompt never names an empty device.</summary>
    internal static string DeviceLabel(IntuneDevice device) =>
        string.IsNullOrWhiteSpace(device.DeviceName) ? device.Id : device.DeviceName;

    /// <summary>
    /// Human-readable audit target for an IntuneDevices_Search lookup. Pure and static so it can
    /// be unit-tested without a page instance.
    /// </summary>
    internal static string DescribeSearch(string? searchTerm) =>
        string.IsNullOrWhiteSpace(searchTerm) ? "(no search term)" : searchTerm.Trim();

    /// <summary>
    /// Badge class for a managedDevice complianceState value. Falls through to a neutral badge
    /// for any value outside the documented set (including a future Graph value) rather than
    /// dropping or miscoloring it - complianceState is stored as a plain string and must render,
    /// not be filtered.
    /// </summary>
    internal static string ComplianceBadgeClass(string complianceState) => complianceState.ToLowerInvariant() switch
    {
        "compliant" => "bg-success",
        "noncompliant" => "bg-danger",
        "conflict" => "bg-warning text-dark",
        "error" => "bg-danger",
        "ingraceperiod" => "bg-warning text-dark",
        "configmanager" => "bg-info text-dark",
        "unknown" => "bg-secondary",
        _ => "bg-light text-dark border"
    };

    /// <summary>
    /// Human-readable free/total storage for the detail panel. Pure and static so it can be
    /// unit-tested without a page instance. A device that never reported total storage (0) shows
    /// "(unknown)" rather than a misleading "0.0 GB of 0.0 GB".
    /// </summary>
    internal static string FormatStorage(long freeBytes, long totalBytes)
    {
        if (totalBytes <= 0)
            return "(unknown)";

        static double ToGb(long bytes) => bytes / 1024.0 / 1024.0 / 1024.0;
        return $"{ToGb(freeBytes):0.0} GB free of {ToGb(totalBytes):0.0} GB";
    }
}

@page "/admin-settings"
@using Microsoft.AspNetCore.Authorization
@using ExchangeAdminWeb.Modules
@attribute [Authorize(Policy = "AdminSettings")]
@rendermode InteractiveServer
@inject AuditService Audit
@inject ExtendedLogService ExtendedLog
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager Navigation
@inject ClientInfoService ClientInfo
@inject ILogger<AdminSettings> Logger
@inject ModuleCatalog Catalog
@inject ModuleEnablementService Enablement
@inject ProtectedPrincipalService ProtectedPrincipalService
@inject ModuleConfigService ModuleConfigSvc
@inject ADDirectorySearchService ADSearch

<PageTitle>Admin Settings</PageTitle>

@if (!authChecked)
{
    <div class="container-fluid">
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Checking authorization...</span>
            </div>
        </div>
    </div>
    return;
}

@* Warns before an edit is lost. Until this landed the app had no such guard anywhere, so
   changing a section and navigating away discarded it silently - on the page that decides who
   can reach every module. B2 in docs/AdminUIRedesign-Plan.md. *@
<UnsavedChangesGuard HasUnsavedChanges="@dirty.IsDirty"
                     Message="@($"{dirty.Summary()}. Leave without saving?")" />

<div class="container-fluid adm">
    <div class="adm-hd">
        <h1>Admin Settings</h1>
        <span class="adm-ver"><ModuleVersion /></span>
        <span class="adm-sub">Per-module access and configuration live on each module's own page.</span>
    </div>

    <div class="adm-tabs">
        <button class="@TabClass(SecModules)" @onclick="() => tab = SecModules">
            Modules <span class="adm-n">@moduleEnablement.Count</span>
            @if (dirty.IsSectionDirty(SecModules)) { <span class="adm-dot"></span> }
        </button>
        <button class="@TabClass(SecProtected)" @onclick="() => tab = SecProtected">
            Protected principals <span class="adm-n">@ProtectedCount()</span>
            @if (dirty.IsSectionDirty(SecProtected)) { <span class="adm-dot"></span> }
        </button>
        <button class="@TabClass(SecLogging)" @onclick="() => tab = SecLogging">Logging</button>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(statusIsError ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
        </div>
    }

    <div class="adm-pane @PaneClass(SecModules)">

            @if (enablementStoreCorrupt)
            {
                <div class="alert alert-danger mb-0">
                    <strong>Module enablement store is corrupt.</strong>
                    config\modules-enabled.json exists but cannot be read, so the real enablement
                    state cannot be shown and saving is disabled — saving now would overwrite the
                    stored state with the all-disabled fallback. Fix or restore the file (deploy
                    backups: ConfigBackups\config.&lt;timestamp&gt;.bak), then reload this page.
                </div>
            }
            else
            {
            <div class="row g-2">
                @foreach (var module in Catalog.GetOrdered().Where(m => !m.IsConfigOnly))
                {
                    var moduleId = module.Id;
                    var parentDisabled = module.DependsOn != null && !Enablement.IsModuleEnabled(module.DependsOn);
                    var parentModule = module.DependsOn != null ? Catalog.GetById(module.DependsOn) : null;
                    <div class="col-md-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="enable-@moduleId"
                                   checked="@moduleEnablement[moduleId]"
                                   disabled="@module.IsSystemModule"
                                   @onchange="(e) => ToggleModule(moduleId, (bool)(e.Value ?? false))" />
                            <label class="form-check-label" for="enable-@moduleId">
                                @module.DisplayName
                                @if (module.IsSystemModule) { <span class="text-muted">(system)</span> }
                                @if (parentDisabled && parentModule != null)
                                {
                                    <span class="text-muted">(requires @parentModule.DisplayName)</span>
                                }
                            </label>
                        </div>
                    </div>
                }
            </div>
            }
        </div>

    <!-- Protected Principals -->
    <div class="adm-pane @PaneClass(SecProtected)">

            <p class="text-muted mb-3"><small>Users, groups, OUs, and patterns listed here are blocked from modification across all modules. Changes take effect immediately.</small></p>

            @if (ppLoadError != null)
            {
                <div class="alert alert-danger py-2">@ppLoadError</div>
            }

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Protected Users</label>
                    <small class="text-muted d-block mb-1">UPN, email, sAMAccountName, or DOMAIN\username</small>
                    @* Rows, not a stack of borderless lines: at 4+ entries the old list
                       gave the eye nothing to separate one principal from the next. *@
                    <div class="adm-scroll mb-2">
                        <table class="adm-tbl">
                            <tbody>
                                @if (ppUsers.Count == 0)
                                {
                                    <tr><td colspan="2" class="adm-empty">None</td></tr>
                                }
                                @foreach (var u in ppUsers.ToList())
                                {
                                    var captured = u;
                                    <tr>
                                        <td class="adm-val">@captured @StaleBadge(captured)</td>
                                        <td class="adm-act">
                                            <button class="adm-rm" type="button" @onclick="() => RemovePp(ppUsers, captured)">Remove</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="input-group input-group-sm">
                        <ADIdentityAutocomplete ObjectKind="User" ReturnValueKind="UPN" @bind-Value="ppNewUser" Placeholder="user@contoso.com" Disabled="@ppValidating" />
                        <button class="btn btn-outline-success" @onclick="AddPpUser" disabled="@(ppValidating || string.IsNullOrWhiteSpace(ppNewUser))">@(ppValidating ? "Checking..." : "Add")</button>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Protected Groups</label>
                    <small class="text-muted d-block mb-1">DN, DOMAIN\GroupName, or CN — transitive membership</small>
                    <div class="adm-scroll mb-2">
                        <table class="adm-tbl">
                            <tbody>
                                @if (ppGroups.Count == 0)
                                {
                                    <tr><td colspan="2" class="adm-empty">None</td></tr>
                                }
                                @foreach (var g in ppGroups.ToList())
                                {
                                    var captured = g;
                                    <tr>
                                        <td class="adm-val">@captured @StaleBadge(captured)</td>
                                        <td class="adm-act">
                                            <button class="adm-rm" type="button" @onclick="() => RemovePp(ppGroups, captured)">Remove</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="input-group input-group-sm">
                        <ADIdentityAutocomplete ObjectKind="Group" ReturnValueKind="DN" @bind-Value="ppNewGroup" Placeholder="Search AD groups..." Disabled="@ppValidating" />
                        <button class="btn btn-outline-success" @onclick="AddPpGroup" disabled="@(ppValidating || string.IsNullOrWhiteSpace(ppNewGroup))">@(ppValidating ? "Checking..." : "Add")</button>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Protected OUs</label>
                    <small class="text-muted d-block mb-1">Search by OU name — all objects beneath are protected</small>
                    <div class="adm-scroll mb-2">
                        <table class="adm-tbl">
                            <tbody>
                                @if (ppOus.Count == 0)
                                {
                                    <tr><td colspan="2" class="adm-empty">None</td></tr>
                                }
                                @foreach (var o in ppOus.ToList())
                                {
                                    var captured = o;
                                    <tr>
                                        <td class="adm-val">@captured @StaleBadge(captured)</td>
                                        <td class="adm-act">
                                            <button class="adm-rm" type="button" @onclick="() => RemovePp(ppOus, captured)">Remove</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="input-group input-group-sm">
                        <ADIdentityAutocomplete ObjectKind="OU" ReturnValueKind="DN" @bind-Value="ppNewOu" Placeholder="Search AD OUs..." Disabled="@ppValidating" />
                        <button class="btn btn-outline-success" @onclick="AddPpOu" disabled="@(ppValidating || string.IsNullOrWhiteSpace(ppNewOu))">@(ppValidating ? "Checking..." : "Add")</button>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">sAMAccountName Patterns</label>
                    <small class="text-muted d-block mb-1">Wildcard patterns (e.g. adm-*, svc-*)</small>
                    <div class="adm-scroll mb-2">
                        <table class="adm-tbl">
                            <tbody>
                                @if (ppPatterns.Count == 0)
                                {
                                    <tr><td colspan="2" class="adm-empty">None</td></tr>
                                }
                                @foreach (var p in ppPatterns.ToList())
                                {
                                    var captured = p;
                                    <tr>
                                        <td class="adm-val">@captured</td>
                                        <td class="adm-act">
                                            <button class="adm-rm" type="button" @onclick="() => RemovePp(ppPatterns, captured)">Remove</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control" @bind="ppNewPattern" @bind:event="oninput" @onkeydown="OnPpPatternKey" placeholder="adm-*" />
                        <button class="btn btn-outline-success" @onclick="AddPpPattern" disabled="@string.IsNullOrWhiteSpace(ppNewPattern)">Add</button>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Protected Group Targets</label>
                    @* Deliberately captioned as protecting the GROUP, not its members - the
                       existing Protected Groups list above means "everyone inside is protected"
                       and the two must not read alike (pgwt T0). *@
                    <small class="text-muted d-block mb-1">Protects the GROUP itself as a write target: members cannot be added or removed except by an authorised servicer. Does not protect the group's members.</small>
                    <div class="adm-scroll mb-2">
                        <table class="adm-tbl">
                            <tbody>
                                @if (ppTargets.Count == 0)
                                {
                                    <tr><td colspan="2" class="adm-empty">None</td></tr>
                                }
                                @foreach (var t in ppTargets.ToList())
                                {
                                    var captured = t;
                                    <tr>
                                        <td class="adm-val">@TargetLabel(captured) @StaleBadge(captured)</td>
                                        <td class="adm-act">
                                            <button class="adm-rm" type="button" @onclick="() => RemovePp(ppTargets, captured)">Remove</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="input-group input-group-sm">
                        <ADIdentityAutocomplete ObjectKind="Group" ReturnValueKind="DN" @bind-Value="ppNewTarget" Placeholder="Search AD groups..." Disabled="@ppValidating" />
                        <button class="btn btn-outline-success" @onclick="AddPpTarget" disabled="@(ppValidating || string.IsNullOrWhiteSpace(ppNewTarget))">@(ppValidating ? "Checking..." : "Add")</button>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(ppAddError))
            {
                <div class="alert alert-warning py-2 px-3 mt-3 mb-0" role="alert">
                    <small>@ppAddError</small>
                </div>
            }

            <div class="row mt-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Directory Read Credential (Delinea Secret ID)</label>
                    <input type="text" class="form-control form-control-sm" @bind="ppDirectoryReadSecretId" @bind:event="oninput" placeholder="Required when groups or OUs are configured" />
                    <small class="text-muted">Read-only AD credential for group membership and OU checks.</small>
                </div>
            </div>
        </div>

    <div class="adm-pane @PaneClass(SecLogging)">

            <p class="text-muted mb-3"><small>Controls the detail level of extended diagnostic logs. Admin audit logging (event log) is always active regardless of this setting. Extended logs are written to a separate file and viewable from the Event Log page.</small></p>
            <div class="row align-items-center">
                <div class="col-auto">
                    <label class="form-label mb-0 fw-semibold">Log Level</label>
                </div>
                <div class="col-auto">
                    <select class="form-select form-select-sm" style="width: 150px;" @bind="selectedLogLevel">
                        <option value="None">None</option>
                        <option value="Error">Error</option>
                        <option value="Warning">Warning</option>
                        <option value="Information">Info</option>
                        <option value="Debug">Debug</option>
                    </select>
                </div>
                <div class="col-auto">
                    <small class="text-muted">Current: @ExtendedLog.CurrentLevel</small>
                </div>
            </div>
        </div>

    @* One save bar for all three panes, replacing three separate buttons that gave no sign
       another section was still unsaved. It names the dirty section: "1 unsaved change" alone
       tells an operator something is wrong but not where. *@
    <div class="adm-bar">
        @if (dirty.IsDirty)
        {
            <span class="adm-dirty">&#9679; @dirty.Summary()</span>
        }
        else
        {
            <span class="adm-clean">No unsaved changes</span>
        }
        <span class="adm-grow"></span>
        <button class="btn btn-outline-secondary btn-sm" @onclick="DiscardChanges" disabled="@(saving || !dirty.IsDirty)">Discard</button>
        <button class="btn btn-primary btn-sm" @onclick="SaveCurrentTabAsync" disabled="@(saving || ppValidating)">Save</button>
    </div>
</div>

@code {
    private string currentUser = string.Empty;
    private bool authChecked;
    private bool saving;
    private string? statusMessage;
    private bool statusIsError;

    private Dictionary<string, bool> moduleEnablement = new();
    private bool enablementStoreCorrupt;
    private string selectedLogLevel = "None";

    // Section names are the strings an operator sees in the guard prompt, so they read as the
    // headings on this page rather than as field names.
    private const string SectionModules = "Module Enablement";
    private const string SectionProtected = "Protected Principals";

    // Tab identity, kept separate from the dirty-state section names so the tab labels can be
    // short while the unsaved-changes prompt still reads as this page's headings.
    private const string SecModules = SectionModules;
    private const string SecProtected = SectionProtected;
    private const string SecLogging = "Logging";

    private readonly AdminPageDirtyState dirty = new();

    private string tab = SecModules;

    private string TabClass(string section) => tab == section ? "on" : "";

    private string PaneClass(string section) => tab == section ? "on" : "";

    /// <summary>Total protected entries across all five kinds, for the tab count.</summary>
    private int ProtectedCount() => ppUsers.Count + ppGroups.Count + ppOus.Count + ppPatterns.Count + ppTargets.Count;

    /// <summary>
    /// Saves what the visible tab owns. Deliberately not "save everything": each save has its own
    /// authorization re-check and corrupt-store refusal, so firing all three would turn one
    /// refusal into a confusing partial result.
    /// </summary>
    private async Task SaveCurrentTabAsync()
    {
        switch (tab)
        {
            case SecModules: await SaveEnablement(); break;
            case SecProtected: await SaveProtectedPrincipals(); break;
            case SecLogging: await SaveLogLevel(); break;
        }
    }

    /// <summary>
    /// Discards by reloading from the store. Clears dirty state FIRST or the guard blocks the
    /// navigation the operator just asked for.
    /// </summary>
    private void DiscardChanges()
    {
        dirty.Clear();
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    /// <summary>
    /// Toggling a module marks the section unsaved rather than writing immediately. The write
    /// still happens only in SaveEnablement, so this changes what the operator is TOLD, not when
    /// anything is persisted.
    /// </summary>
    private void ToggleModule(string moduleId, bool enabled)
    {
        moduleEnablement[moduleId] = enabled;
        dirty.Set(SectionModules, true);
    }

    /// <summary>
    /// Removes a protected-principal entry and marks the section unsaved. Routed through here
    /// rather than calling List.Remove inline so no removal can bypass the dirty flag - the
    /// entry would then be gone from the page and still stored, with no warning on exit.
    /// </summary>
    private void RemovePp(List<string> list, string value)
    {
        if (list.Remove(value))
            dirty.Set(SectionProtected, true);
    }

    private List<string> ppUsers = new();
    private List<string> ppGroups = new();
    private List<string> ppOus = new();
    private List<string> ppPatterns = new();
    private List<string> ppTargets = new();
    private string ppNewUser = "", ppNewGroup = "", ppNewOu = "", ppNewPattern = "", ppNewTarget = "";
    private string ppDirectoryReadSecretId = "";
    private string? ppLoadError;

    // Surfaced next to the add controls, not through statusMessage: a refused Add must not
    // overwrite an unrelated save result.
    private string? ppAddError;
    private bool ppValidating;

    // Entries already in the store that AD says do not exist. Populated after first render, not
    // during load - see SweepExistingEntriesAsync. Absence from this set is NOT a claim of
    // validity: an entry whose lookup failed never enters it, deliberately.
    private readonly HashSet<string> ppStaleEntries = new(StringComparer.OrdinalIgnoreCase);
    private bool ppSweepDone;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUser = user.Identity?.Name ?? "Unknown";

        var authResult = await AuthorizationService.AuthorizeAsync(user, "AdminSettings");
        if (!authResult.Succeeded)
        {
            Navigation.NavigateTo("access-denied", forceLoad: true);
            return;
        }

        enablementStoreCorrupt = Enablement.IsStoreCorrupt();
        moduleEnablement = Enablement.GetAllEnablement();
        selectedLogLevel = ExtendedLog.CurrentLevel;
        LoadProtectedPrincipals();
        authChecked = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Deferred to after first paint: the sweep serializes N directory lookups behind a lock
        // that can block 30s each, which would stall the page if run during initialization.
        // Guarded by ppSweepDone rather than firstRender alone - authChecked gates the whole
        // markup, so the first render can complete before the lists exist.
        if (ppSweepDone || !authChecked || ppLoadError != null)
            return;

        ppSweepDone = true;
        await SweepExistingEntriesAsync();
    }

    private async Task SaveEnablement()
    {
        saving = true;
        statusMessage = null;
        await Task.Yield();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authResult = await AuthorizationService.AuthorizeAsync(authState.User, "AdminSettings");
            if (!authResult.Succeeded)
            {
                statusMessage = "Authorization check failed.";
                statusIsError = true;
                return;
            }

            if (Enablement.IsStoreCorrupt())
            {
                enablementStoreCorrupt = true;
                statusMessage = "Refusing to save: the enablement store is corrupt and saving would overwrite it with fallback state. Fix or restore config\\modules-enabled.json first.";
                statusIsError = true;
                return;
            }

            var previous = Enablement.GetAllEnablement();
            Enablement.SaveEnablement(moduleEnablement);

            var ip = ClientInfo.GetIpForUser(currentUser);
            foreach (var module in Catalog.GetAll().Where(m => !m.IsSystemModule))
            {
                var prev = previous.GetValueOrDefault(module.Id, module.EnabledByDefault);
                var curr = moduleEnablement.GetValueOrDefault(module.Id, module.EnabledByDefault);
                if (prev != curr)
                {
                    try
                    {
                        Audit.LogSettingsChange(currentUser, ip, $"Module:{module.Id}",
                            prev ? new[] { "Enabled" } : Array.Empty<string>(),
                            curr ? new[] { "Enabled" } : Array.Empty<string>());
                    }
                    catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for enablement change"); }
                }
            }

            // Clear BEFORE the reload below, or the guard fires on our own navigation and asks
            // the operator to confirm leaving a page they just saved.
            dirty.ClearSection(SectionModules);
            statusMessage = "Module enablement saved. Refreshing...";
            statusIsError = false;
            await Task.Delay(500);
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        }
        catch (Exception ex)
        {
            statusMessage = $"Failed to save: {ex.Message}";
            statusIsError = true;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task SaveLogLevel()
    {
        saving = true;
        statusMessage = null;
        await Task.Yield();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authResult = await AuthorizationService.AuthorizeAsync(authState.User, "AdminSettings");
            if (!authResult.Succeeded)
            {
                statusMessage = "Authorization check failed.";
                statusIsError = true;
                return;
            }

            var previousLevel = ExtendedLog.CurrentLevel;
            ExtendedLog.SetLevel(selectedLogLevel);

            var ip = ClientInfo.GetIpForUser(currentUser);
            try { Audit.LogSettingsChange(currentUser, ip, "ExtendedLogLevel", new[] { previousLevel }, new[] { selectedLogLevel }); }
            catch { }

            statusMessage = $"Extended log level set to {ExtendedLog.CurrentLevel}.";
            statusIsError = false;
        }
        catch (Exception ex)
        {
            statusMessage = $"Failed to save log level: {ex.Message}";
            statusIsError = true;
        }
        finally
        {
            saving = false;
        }
    }

    private void LoadProtectedPrincipals()
    {
        var (cfg, _, error) = ProtectedPrincipalService.LoadEffectiveConfig();
        if (error != null) { ppLoadError = error; return; }
        if (cfg != null)
        {
            ppUsers = cfg.Users.ToList();
            ppGroups = cfg.Groups.ToList();
            ppOus = cfg.OrganizationalUnits.ToList();
            ppPatterns = cfg.SamAccountNamePatterns.ToList();
            ppTargets = cfg.GroupTargets.ToList();
        }
        ppDirectoryReadSecretId = ProtectedPrincipalService.GetDirectoryReadSecretId()?.ToString() ?? "";
    }

    // Only Patterns keeps a keydown handler. Users, Groups and OUs all use
    // ADIdentityAutocomplete, which owns its own Enter key (it selects the highlighted
    // suggestion), so page-level handlers for those fields were unreachable markup and are gone.
    private void OnPpPatternKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e) { if (e.Key == "Enter") AddPpPattern(); }

    // Users, Groups and OUs are validated against AD before they enter the list: an entry that
    // corresponds to no directory object is not inert. A bad user or OU row silently matches
    // nothing, and a bad GROUP row is worse - group expansion fails closed
    // (ProtectedPrincipalService.CheckGroupMembershipAsync), turning every subsequent check into
    // a denial that reads as a directory fault. See docs/ProtectedPrincipalInputValidation-Plan.md.
    //
    // Patterns are deliberately NOT validated - they are wildcards matched against a resolved
    // target at check time, so there is no object for them to correspond to, and one matching
    // nothing today is legitimate (it may exist to catch future accounts).
    private async Task AddPpUser() => await AddValidatedAsync(ppUsers, ppNewUser, "User", v => ppNewUser = v);
    private async Task AddPpGroup() => await AddValidatedAsync(ppGroups, ppNewGroup, "Group", v => ppNewGroup = v);
    private async Task AddPpOu() => await AddValidatedAsync(ppOus, ppNewOu, "OU", v => ppNewOu = v);

    // Protected TARGETS look up an AD Group but canonicalise as "GroupTarget": the stored value
    // is "objectGUID|DN" (pgwt T0), produced by the validator so the saved entry is exactly
    // what CheckWriteTarget later matches.
    private async Task AddPpTarget() => await AddValidatedAsync(ppTargets, ppNewTarget, "GroupTarget", v => ppNewTarget = v, lookupKind: "Group");

    /// <summary>The DN half of a stored "guid|DN" target entry, for display.</summary>
    private static string TargetLabel(string stored) => ProtectedGroupTargetEntry.Parse(stored).Label;

    private void AddPpPattern() { var v = ppNewPattern.Trim(); if (!string.IsNullOrWhiteSpace(v) && !ppPatterns.Contains(v, StringComparer.OrdinalIgnoreCase)) ppPatterns.Add(v); ppNewPattern = ""; }

    /// <summary>
    /// Marks a saved entry that Active Directory says does not exist. Renders nothing for an
    /// entry that resolves, and nothing for one whose lookup could not run.
    /// </summary>
    /// <remarks>
    /// The silence on an unreachable directory is deliberate. A warning shown during an outage
    /// would read as "your protection rules have been lost" across every row at once - alarming
    /// and false. Absence of a badge therefore means "not known to be stale", never "verified".
    /// </remarks>
    private MarkupString StaleBadge(string entry)
        => ppStaleEntries.Contains(entry)
            ? new MarkupString("<span class=\"badge bg-warning text-dark ms-1\" title=\"This entry does not resolve in Active Directory, so it protects nothing. Remove it or replace it with a current one.\">not in AD</span>")
            : new MarkupString("");

    /// <summary>
    /// Re-checks the entries already in the store and flags those that no longer resolve.
    /// Informational only: it never blocks Save and never removes a row.
    /// </summary>
    /// <remarks>
    /// Runs from OnAfterRenderAsync rather than during load. Each lookup takes a shared lock that
    /// can block for up to 30s, and the list is long enough that doing this inline would delay
    /// first paint by minutes in the worst case. The rows render immediately; badges appear when
    /// the sweep finishes.
    ///
    /// Patterns are not swept - they are wildcards with no directory object to correspond to.
    ///
    /// Not blocking Save is a requirement, not an oversight: a decommissioned group must stay
    /// removable. Blocking would make the stale row permanent.
    /// </remarks>
    private async Task SweepExistingEntriesAsync()
    {
        var targets = new List<(string Entry, string Lookup, string Kind)>();
        targets.AddRange(ppUsers.Select(u => (u, u, "User")));
        targets.AddRange(ppGroups.Select(g => (g, g, "Group")));
        targets.AddRange(ppOus.Select(o => (o, o, "OU")));
        // Group targets store "guid|DN"; the DN half is what AD can confirm exists. The badge
        // keys on the stored entry, so the row it decorates is the row that was checked.
        targets.AddRange(ppTargets.Select(t => (t, ProtectedGroupTargetEntry.Parse(t).DistinguishedName ?? t, "Group")));

        if (targets.Count == 0)
            return;

        var stale = await Task.Run(() =>
        {
            var found = new List<string>();
            foreach (var (entry, lookup, kind) in targets)
            {
                try
                {
                    // ONLY an affirmative NotFound flags a row. Unavailable is skipped so an
                    // outage cannot make every entry look broken at once.
                    if (ProtectedPrincipalEntryValidator.ShouldFlagAsStale(
                            ADSearch.ValidateExists(lookup, kind).Outcome))
                        found.Add(entry);
                }
                catch (Exception ex)
                {
                    // Same reasoning: a failed lookup is not evidence the entry is bad.
                    Logger.LogWarning(ex, "Stale-entry sweep failed for a {Kind} entry", kind);
                }
            }
            return found;
        });

        if (stale.Count == 0)
            return;

        foreach (var s in stale)
            ppStaleEntries.Add(s);

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Validates one typed entry against Active Directory and appends it only when the directory
    /// confirms it exists. A refusal leaves the input box untouched so the operator can see and
    /// correct what they typed.
    /// </summary>
    /// <remarks>
    /// The two refusal messages must stay distinct. NotFound means the directory answered and the
    /// operator should check the name; Unavailable means the lookup never ran and they should
    /// retry. Collapsing them would tell an admin their correct entry was a typo during an outage
    /// (owner ruling, .agents/decisions.md and the plan's D1).
    /// </remarks>
    private async Task AddValidatedAsync(List<string> target, string raw, string objectKind, Action<string> setInput, string? lookupKind = null)
    {
        // Blank and duplicate are settled without a directory round-trip.
        if (!ProtectedPrincipalEntryValidator.ShouldConsultDirectory(target, raw))
        {
            var quick = ProtectedPrincipalEntryValidator.Decide(
                target, raw, objectKind, new DirectoryValidationResult(DirectoryLookupOutcome.NotFound, null));
            ppAddError = quick.ErrorMessage;
            if (quick.ClearInput) setInput("");
            return;
        }

        ppValidating = true;
        ppAddError = null;
        StateHasChanged();

        DirectoryValidationResult result;
        try
        {
            // Off the render path: ValidateExists is synchronous and takes a lock that can block
            // for up to 30s, which would freeze the circuit if called inline.
            result = await Task.Run(() => ADSearch.ValidateExists(raw.Trim(), lookupKind ?? objectKind));
        }
        catch (Exception ex)
        {
            // Fail closed on an unexpected fault: refuse the entry rather than admit an
            // unvalidated one, and say the lookup failed rather than blame the input.
            Logger.LogWarning(ex, "Protected-principal validation threw for {ObjectKind}", objectKind);
            result = new DirectoryValidationResult(DirectoryLookupOutcome.Unavailable, null);
        }
        finally
        {
            ppValidating = false;
        }

        var decision = ProtectedPrincipalEntryValidator.Decide(target, raw, objectKind, result);

        if (decision.Accepted && decision.ValueToAdd is { } toAdd
            && !target.Contains(toAdd, StringComparer.OrdinalIgnoreCase))
        {
            target.Add(toAdd);
            dirty.Set(SectionProtected, true);
        }

        ppAddError = decision.ErrorMessage;
        if (decision.ClearInput) setInput("");
    }

    private async Task SaveProtectedPrincipals()
    {
        saving = true;
        statusMessage = null;
        await Task.Yield();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authResult = await AuthorizationService.AuthorizeAsync(authState.User, "AdminSettings");
            if (!authResult.Succeeded) { statusMessage = "Authorization check failed."; statusIsError = true; return; }

            // Refuse rather than snapshot a list an in-flight Add is about to mutate. Without
            // this, saving mid-validation persists the list WITHOUT the pending entry, reports
            // success, and then shows the entry in the page once validation completes - so the
            // loss is invisible until a reload. The button is also disabled while validating;
            // this is the guarantee behind that, since "UI hiding is not security" is already
            // this repo's rule for the protection path. Review finding ppv-3.
            if (ProtectedPrincipalEntryValidator.ShouldBlockSave(ppValidating))
            {
                statusMessage = ProtectedPrincipalEntryValidator.SaveBlockedMessage;
                statusIsError = true;
                return;
            }

            var newConfig = new ProtectedPrincipalConfig
            {
                Users = ppUsers.Where(s => !string.IsNullOrWhiteSpace(s)).ToArray(),
                Groups = ppGroups.Where(s => !string.IsNullOrWhiteSpace(s)).ToArray(),
                OrganizationalUnits = ppOus.Where(s => !string.IsNullOrWhiteSpace(s)).ToArray(),
                SamAccountNamePatterns = ppPatterns.Where(s => !string.IsNullOrWhiteSpace(s)).ToArray(),
                GroupTargets = ppTargets.Where(s => !string.IsNullOrWhiteSpace(s)).ToArray()
            };

            ProtectedPrincipalService.SaveConfig(newConfig);
            ProtectedPrincipalService.SaveDirectoryReadSecretId(ppDirectoryReadSecretId.Trim());

            try
            {
                var ip = ClientInfo.GetIpForUser(currentUser);
                Audit.LogSettingsChange(currentUser, ip, "ProtectedPrincipals",
                    Array.Empty<string>(),
                    new[] { $"Users:{newConfig.Users.Length},Groups:{newConfig.Groups.Length},OUs:{newConfig.OrganizationalUnits.Length},Patterns:{newConfig.SamAccountNamePatterns.Length},Targets:{newConfig.GroupTargets.Length}" });
            }
            catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for protected principals change"); }

            dirty.ClearSection(SectionProtected);
            statusMessage = "Protected principals saved. Changes are effective immediately.";
            statusIsError = false;
            ppLoadError = null;
        }
        catch (Exception ex)
        {
            statusMessage = $"Failed to save: {ex.Message}";
            statusIsError = true;
        }
        finally { saving = false; }
    }
}

@page "/admin-settings"
@using Microsoft.AspNetCore.Authorization
@using ExchangeAdminWeb.Modules
@attribute [Authorize(Policy = "AdminSettings")]
@rendermode InteractiveServer
@inject AuditService Audit
@inject ExtendedLogService ExtendedLog
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager Navigation
@inject ClientInfoService ClientInfo
@inject ILogger<AdminSettings> Logger
@inject ModuleCatalog Catalog
@inject ModuleEnablementService Enablement
@inject ProtectedPrincipalService ProtectedPrincipalService
@inject ModuleConfigService ModuleConfigSvc
@inject ADDirectorySearchService ADSearch
@inject IActivityProgress Progress

<PageTitle>Admin Settings</PageTitle>

@if (!authChecked)
{
    @* NO SPINNER. No module draws its own progress (owner ruling 2026-10-02,
       `.agents/decisions.md`), and nothing replaces this one: GroupAuthorizationHandler is
       synchronous end to end, so the check finishes faster than a frame and a bar line
       flickering inside a single render is noise, not information.
       The GUARD stays and must stay - it is what stops the page rendering before the check
       has passed, which is refusal, not progress. Kept at the SAME LINE COUNT as the markup
       it replaces, so not one ClickGateRegistry line key moves. *@
    return;
}

@* Warns before an edit is lost. Until this landed the app had no such guard anywhere, so
   changing a section and navigating away discarded it silently - on the page that decides who
   can reach every module. B2 in docs/AdminUIRedesign-Plan.md. *@
<UnsavedChangesGuard HasUnsavedChanges="@dirty.IsDirty"
                     Message="@($"{dirty.Summary()}. Leave without saving?")" />

<div class="container-fluid adm">
    <div class="adm-hd">
        <h1>Admin Settings</h1>
        <span class="adm-ver"><ModuleVersion /></span>
        <span class="adm-sub">Per-module access and configuration live on each module's own page.</span>
    </div>

    <div class="adm-tabs">
        <button class="@TabClass(SecModules)" @onclick="() => tab = SecModules">
            Modules <span class="adm-n">@moduleEnablement.Count</span>
            @if (dirty.IsSectionDirty(SecModules)) { <span class="adm-dot"></span> }
        </button>
        <button class="@TabClass(SecProtected)" @onclick="() => tab = SecProtected">
            Protected principals <span class="adm-n">@ProtectedCount()</span>
            @if (dirty.IsSectionDirty(SecProtected)) { <span class="adm-dot"></span> }
        </button>
        <button class="@TabClass(SecLogging)" @onclick="() => tab = SecLogging">Logging</button>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(statusIsError ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
        </div>
    }

    <div class="adm-pane @PaneClass(SecModules)">

            @if (enablementStoreCorrupt)
            {
                <div class="alert alert-danger mb-0">
                    <strong>Module enablement store is corrupt.</strong>
                    The real enablement state cannot be shown and saving is disabled - saving now would
                    overwrite the stored state with the all-disabled fallback.
                    @SettingsStoreText.Enablement(Enablement.LegacyImportFailed)
                </div>
            }
            else
            {
            <div class="row g-2">
                @foreach (var module in Catalog.GetOrdered().Where(m => !m.IsConfigOnly))
                {
                    var moduleId = module.Id;
                    var parentDisabled = module.DependsOn != null && !Enablement.IsModuleEnabled(module.DependsOn);
                    var parentModule = module.DependsOn != null ? Catalog.GetById(module.DependsOn) : null;
                    <div class="col-md-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="enable-@moduleId"
                                   checked="@moduleEnablement[moduleId]"
                                   disabled="@module.IsSystemModule"
                                   @onchange="(e) => ToggleModule(moduleId, (bool)(e.Value ?? false))" />
                            <label class="form-check-label" for="enable-@moduleId">
                                @module.DisplayName
                                @if (module.IsSystemModule) { <span class="text-muted">(system)</span> }
                                @if (parentDisabled && parentModule != null)
                                {
                                    <span class="text-muted">(requires @parentModule.DisplayName)</span>
                                }
                            </label>
                        </div>
                    </div>
                }
            </div>
            }
        </div>

    <!-- Protected Principals -->
    <div class="adm-pane @PaneClass(SecProtected)">

            <p class="text-muted mb-3"><small>Users, groups, OUs, and patterns listed here are blocked from modification across all modules. Changes take effect immediately.</small></p>

            @if (ppLoadError != null)
            {
                <div class="alert alert-danger py-2">@ppLoadError</div>
            }

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Protected Users</label>
                    <small class="text-muted d-block mb-1">UPN, email, sAMAccountName, or DOMAIN\username</small>
                    @* Rows, not a stack of borderless lines: at 4+ entries the old list
                       gave the eye nothing to separate one principal from the next. *@
                    <div class="adm-scroll mb-2">
                        <table class="adm-tbl">
                            <tbody>
                                @if (ppUsers.Count == 0)
                                {
                                    <tr><td colspan="2" class="adm-empty">None</td></tr>
                                }
                                @foreach (var u in ppUsers.ToList())
                                {
                                    var captured = u;
                                    <tr>
                                        <td class="adm-val">@captured @StaleBadge(captured)</td>
                                        <td class="adm-act">
                                            <button class="adm-rm" type="button" @onclick="() => RemovePp(ppUsers, captured)">Remove</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="input-group input-group-sm">
                        <ADIdentityAutocomplete ObjectKind="User" ReturnValueKind="UPN" @bind-Value="ppNewUser" Placeholder="user@contoso.com" Disabled="@ppValidating" />
                        <button class="btn btn-outline-success" @onclick="AddPpUser" disabled="@(ppValidating || string.IsNullOrWhiteSpace(ppNewUser))">@(ppValidating ? "Checking..." : "Add")</button>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Protected Groups</label>
                    <small class="text-muted d-block mb-1">DN, DOMAIN\GroupName, or CN — transitive membership</small>
                    <div class="adm-scroll mb-2">
                        <table class="adm-tbl">
                            <tbody>
                                @if (ppGroups.Count == 0)
                                {
                                    <tr><td colspan="2" class="adm-empty">None</td></tr>
                                }
                                @foreach (var g in ppGroups.ToList())
                                {
                                    var captured = g;
                                    <tr>
                                        <td class="adm-val">@captured @StaleBadge(captured)</td>
                                        <td class="adm-act">
                                            <button class="adm-rm" type="button" @onclick="() => RemovePp(ppGroups, captured)">Remove</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="input-group input-group-sm">
                        <ADIdentityAutocomplete ObjectKind="Group" ReturnValueKind="DN" @bind-Value="ppNewGroup" Placeholder="Search AD groups..." Disabled="@ppValidating" />
                        <button class="btn btn-outline-success" @onclick="AddPpGroup" disabled="@(ppValidating || string.IsNullOrWhiteSpace(ppNewGroup))">@(ppValidating ? "Checking..." : "Add")</button>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Protected OUs</label>
                    <small class="text-muted d-block mb-1">Search by OU name — all objects beneath are protected</small>
                    <div class="adm-scroll mb-2">
                        <table class="adm-tbl">
                            <tbody>
                                @if (ppOus.Count == 0)
                                {
                                    <tr><td colspan="2" class="adm-empty">None</td></tr>
                                }
                                @foreach (var o in ppOus.ToList())
                                {
                                    var captured = o;
                                    <tr>
                                        <td class="adm-val">@captured @StaleBadge(captured)</td>
                                        <td class="adm-act">
                                            <button class="adm-rm" type="button" @onclick="() => RemovePp(ppOus, captured)">Remove</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="input-group input-group-sm">
                        <ADIdentityAutocomplete ObjectKind="OU" ReturnValueKind="DN" @bind-Value="ppNewOu" Placeholder="Search AD OUs..." Disabled="@ppValidating" />
                        <button class="btn btn-outline-success" @onclick="AddPpOu" disabled="@(ppValidating || string.IsNullOrWhiteSpace(ppNewOu))">@(ppValidating ? "Checking..." : "Add")</button>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">sAMAccountName Patterns</label>
                    <small class="text-muted d-block mb-1">Wildcard patterns (e.g. adm-*, svc-*)</small>
                    <div class="adm-scroll mb-2">
                        <table class="adm-tbl">
                            <tbody>
                                @if (ppPatterns.Count == 0)
                                {
                                    <tr><td colspan="2" class="adm-empty">None</td></tr>
                                }
                                @foreach (var p in ppPatterns.ToList())
                                {
                                    var captured = p;
                                    <tr>
                                        <td class="adm-val">@captured</td>
                                        <td class="adm-act">
                                            <button class="adm-rm" type="button" @onclick="() => RemovePp(ppPatterns, captured)">Remove</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control" @bind="ppNewPattern" @bind:event="oninput" @onkeydown="OnPpPatternKey" placeholder="adm-*" />
                        <button class="btn btn-outline-success" @onclick="AddPpPattern" disabled="@string.IsNullOrWhiteSpace(ppNewPattern)">Add</button>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Protected Group Targets</label>
                    @* Deliberately captioned as protecting the GROUP, not its members - the
                       existing Protected Groups list above means "everyone inside is protected"
                       and the two must not read alike (pgwt T0). *@
                    <small class="text-muted d-block mb-1">Protects the GROUP itself as a write target: members cannot be added or removed except by an authorised servicer. Does not protect the group's members.</small>
                    <div class="adm-scroll mb-2">
                        <table class="adm-tbl">
                            <tbody>
                                @if (ppTargets.Count == 0)
                                {
                                    <tr><td colspan="2" class="adm-empty">None</td></tr>
                                }
                                @foreach (var t in ppTargets.ToList())
                                {
                                    var captured = t;
                                    <tr>
                                        <td class="adm-val">@TargetLabel(captured) @StaleBadge(captured)</td>
                                        <td class="adm-act">
                                            <button class="adm-rm" type="button" @onclick="() => RemovePp(ppTargets, captured)">Remove</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="input-group input-group-sm">
                        <ADIdentityAutocomplete ObjectKind="Group" ReturnValueKind="DN" @bind-Value="ppNewTarget" Placeholder="Search AD groups..." Disabled="@ppValidating" />
                        <button class="btn btn-outline-success" @onclick="AddPpTarget" disabled="@(ppValidating || string.IsNullOrWhiteSpace(ppNewTarget))">@(ppValidating ? "Checking..." : "Add")</button>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(ppAddError))
            {
                <div class="alert alert-warning py-2 px-3 mt-3 mb-0" role="alert">
                    <small>@ppAddError</small>
                </div>
            }

            <div class="row mt-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Directory Read Credential (Delinea Secret ID)</label>
                    @* Explicit value/@oninput rather than @bind: the edit has to reach
                       RecountProtected, and a plain @bind writes the field behind the section's
                       back, so a secret-id-only edit read as "No unsaved changes". *@
                    <input type="text" class="form-control form-control-sm"
                           value="@ppDirectoryReadSecretId"
                           disabled="@ppSecretUnreadable"
                           @oninput="(e) => SetPpDirectoryReadSecretId(e.Value?.ToString() ?? string.Empty)"
                           placeholder="Required when groups or OUs are configured" />
                    @if (ppSecretUnreadable)
                    {
                        <small class="text-danger d-block">@SecretUnreadableText</small>
                    }
                    else
                    {
                        <small class="text-muted">Read-only AD credential for group membership and OU checks.</small>
                        @if (ppSecretFallbackId is { } fallbackId)
                        {
                            <small class="text-muted d-block">@SecretFallbackText(fallbackId)</small>
                        }
                    }
                </div>
            </div>
        </div>

    <div class="adm-pane @PaneClass(SecLogging)">

            <p class="text-muted mb-3"><small>Controls the detail level of extended diagnostic logs. Admin audit logging (event log) is always active regardless of this setting. Extended logs are written to a separate file and viewable from the Event Log page.</small></p>
            <div class="row align-items-center">
                <div class="col-auto">
                    <label class="form-label mb-0 fw-semibold">Log Level</label>
                </div>
                <div class="col-auto">
                    <select class="form-select form-select-sm" style="width: 150px;" @bind="selectedLogLevel">
                        <option value="None">None</option>
                        <option value="Error">Error</option>
                        <option value="Warning">Warning</option>
                        <option value="Information">Info</option>
                        <option value="Debug">Debug</option>
                    </select>
                </div>
                <div class="col-auto">
                    <small class="text-muted">Current: @ExtendedLog.CurrentLevel</small>
                </div>
            </div>
        </div>

    @* One save bar for all three panes, replacing three separate buttons that gave no sign
       another section was still unsaved. It counts the pending edits and names the sections
       holding them: a count alone tells an operator something is wrong but not where, and a
       section name alone leaves ten edits reading as one. *@
    <div class="adm-bar">
        @if (dirty.IsDirty)
        {
            <span class="adm-dirty">&#9679; @dirty.Summary()</span>
        }
        else
        {
            <span class="adm-clean">No unsaved changes</span>
        }
        <span class="adm-grow"></span>
        <button class="btn btn-outline-secondary btn-sm" @onclick="DiscardChanges" disabled="@(saving || !dirty.IsDirty)">Discard</button>
        <button class="btn btn-primary btn-sm" @onclick="SaveCurrentTabAsync" disabled="@(saving || ppValidating || !CanSaveCurrentTab())">Save</button>
    </div>
</div>

@code {
    private string currentUser = string.Empty;
    private bool authChecked;
    private bool saving;
    private string? statusMessage;
    private bool statusIsError;

    private Dictionary<string, bool> moduleEnablement = new();

    // What the page loaded, so the save bar can count the modules ACTUALLY changed rather than
    // tallying clicks. Copied with the case-insensitive comparer named: a dictionary copy does not
    // inherit its source's comparer, and GetAllEnablement's is case-insensitive, so the copy cannot
    // meet two casings of one id (aud-a26n).
    private Dictionary<string, bool> moduleEnablementBaseline = new(StringComparer.OrdinalIgnoreCase);

    private bool enablementStoreCorrupt;
    private string selectedLogLevel = "None";

    // Section names are the strings an operator sees in the guard prompt, so they read as the
    // headings on this page rather than as field names.
    private const string SectionModules = "Module Enablement";
    private const string SectionProtected = "Protected Principals";

    // Tab identity, kept separate from the dirty-state section names so the tab labels can be
    // short while the unsaved-changes prompt still reads as this page's headings.
    private const string SecModules = SectionModules;
    private const string SecProtected = SectionProtected;
    private const string SecLogging = "Logging";

    private readonly AdminPageDirtyState dirty = new();

    private string tab = SecModules;

    private string TabClass(string section) => tab == section ? "on" : "";

    private string PaneClass(string section) => tab == section ? "on" : "";

    /// <summary>Total protected entries across all five kinds, for the tab count.</summary>
    private int ProtectedCount() => ppUsers.Count + ppGroups.Count + ppOus.Count + ppPatterns.Count + ppTargets.Count;

    /// <summary>
    /// Saves what the visible tab owns. Deliberately not "save everything": each save has its own
    /// authorization re-check and corrupt-store refusal, so firing all three would turn one
    /// refusal into a confusing partial result.
    /// </summary>
    private async Task SaveCurrentTabAsync()
    {
        switch (tab)
        {
            case SecModules: await SaveEnablement(); break;
            case SecProtected: await SaveProtectedPrincipals(); break;
            case SecLogging: await SaveLogLevel(); break;
        }
    }

    /// <summary>Whether the visible tab's store was read when the page loaded, so Save is offered.</summary>
    /// <remarks>
    /// aud-a28j. A tab whose store did not load holds the fallback, not the stored state, and has nothing
    /// to save over it. Withholding the button is the courtesy; each save refuses the same case itself.
    /// </remarks>
    private bool CanSaveCurrentTab() => tab switch
    {
        SecModules => !enablementStoreCorrupt,
        SecProtected => ppLoaded,
        _ => true,
    };

    /// <summary>
    /// Discards by reloading from the store. Clears dirty state FIRST or the guard blocks the
    /// navigation the operator just asked for.
    /// </summary>
    /// <remarks>
    /// Clearing is not enough on its own: <see cref="UnsavedChangesGuard"/> takes the flag as a
    /// parameter and arms the browser's beforeunload from it, so until a render carries the
    /// cleared value down to the browser, both the in-app confirm and the browser's "Leave site?"
    /// still fire on the navigation the operator just asked for. Hence the explicit render, and
    /// the yield that lets its batch go out ahead of the navigation on the same circuit.
    /// </remarks>
    private async Task DiscardChanges()
    {
        dirty.Clear();
        StateHasChanged();
        await Task.Yield();
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    /// <summary>
    /// Toggling a module marks the section unsaved rather than writing immediately. The write
    /// still happens only in SaveEnablement, so this changes what the operator is TOLD, not when
    /// anything is persisted.
    /// </summary>
    private void ToggleModule(string moduleId, bool enabled)
    {
        moduleEnablement[moduleId] = enabled;
        RecountModules();
    }

    /// <summary>
    /// Counts the modules whose enablement differs from what the page loaded.
    /// </summary>
    /// <remarks>
    /// Counting choice for this section: a DIFF against the load, not one edit per click. The page
    /// holds the whole enablement dictionary, so it can say exactly how many modules changed --
    /// and a module toggled on and then back off has to net to zero, which a running tally cannot
    /// do.
    /// </remarks>
    private void RecountModules()
    {
        var changes = moduleEnablement.Count(kv =>
            !moduleEnablementBaseline.TryGetValue(kv.Key, out var loaded) || loaded != kv.Value);

        dirty.SetCount(SectionModules, changes);
    }

    /// <summary>
    /// Removes a protected-principal entry and marks the section unsaved. Routed through here
    /// rather than calling List.Remove inline so no removal can bypass the dirty flag - the
    /// entry would then be gone from the page and still stored, with no warning on exit.
    /// </summary>
    private void RemovePp(List<string> list, string value)
    {
        if (list.Remove(value))
            RecountProtected();
    }

    /// <summary>
    /// Counts protected entries added and removed against what the page loaded, across all five
    /// kinds.
    /// </summary>
    /// <remarks>
    /// Counting choice for this section: a DIFF against the load, not one edit per click. The page
    /// holds the five working lists, so ten added groups read as ten changes, and an entry added
    /// and then removed before saving stops counting. Re-adding a renamed group target is two
    /// changes (its old row leaves, its new row arrives), which is what the save will actually do.
    ///
    /// The directory-read secret id counts as one change because SaveProtectedPrincipals writes it
    /// alongside the five lists. Leaving it out made a secret-id-only edit read as "No unsaved
    /// changes" and leave the page with no warning.
    /// </remarks>
    private void RecountProtected()
    {
        var changes =
            EntryDelta(ppUsers, ppUsersBaseline)
            + EntryDelta(ppGroups, ppGroupsBaseline)
            + EntryDelta(ppOus, ppOusBaseline)
            + EntryDelta(ppPatterns, ppPatternsBaseline)
            + EntryDelta(ppTargets, ppTargetsBaseline)
            + SecretIdDelta(ppDirectoryReadSecretId, ppDirectoryReadSecretIdBaseline);

        dirty.SetCount(SectionProtected, changes);
    }

    /// <summary>Additions plus removals between a working list and the one that was loaded.</summary>
    private static int EntryDelta(List<string> current, List<string> loaded) =>
        current.Except(loaded, StringComparer.Ordinal).Count()
        + loaded.Except(current, StringComparer.Ordinal).Count();

    /// <summary>
    /// One change if the directory-read secret id differs from what was loaded, otherwise none.
    /// </summary>
    /// <remarks>
    /// Trimmed on both sides because that is what SaveProtectedPrincipals persists: a stray space
    /// is not an edit, and counting it would leave the page permanently dirty after a stray
    /// keystroke that changes nothing stored. Internal so it is unit-testable - the rest of the
    /// recount reads page fields no test can reach without bUnit.
    /// </remarks>
    internal static int SecretIdDelta(string current, string loaded) =>
        string.Equals((current ?? "").Trim(), (loaded ?? "").Trim(), StringComparison.Ordinal) ? 0 : 1;

    /// <summary>Re-baselines the protected lists, after a load or a successful save.</summary>
    /// <remarks>
    /// Required after saving, not merely tidy: this save does not reload the page, so a stale
    /// baseline would count the edits just persisted all over again on the next one.
    /// </remarks>
    private void SnapshotProtectedBaseline()
    {
        SnapshotProtectedRulesBaseline();
        ppDirectoryReadSecretIdBaseline = ppDirectoryReadSecretId;
    }

    /// <summary>Re-baselines the five rule lists only, leaving the directory-read secret id pending.</summary>
    private void SnapshotProtectedRulesBaseline()
    {
        ppUsersBaseline = new List<string>(ppUsers);
        ppGroupsBaseline = new List<string>(ppGroups);
        ppOusBaseline = new List<string>(ppOus);
        ppPatternsBaseline = new List<string>(ppPatterns);
        ppTargetsBaseline = new List<string>(ppTargets);
    }

    /// <summary>How many rules of the five kinds the page last loaded or saved.</summary>
    private int LoadedRuleCount() =>
        ppUsersBaseline.Count + ppGroupsBaseline.Count + ppOusBaseline.Count + ppPatternsBaseline.Count + ppTargetsBaseline.Count;

    private List<string> ppUsers = new();
    private List<string> ppGroups = new();
    private List<string> ppOus = new();
    private List<string> ppPatterns = new();
    private List<string> ppTargets = new();
    private List<string> ppUsersBaseline = new();
    private List<string> ppGroupsBaseline = new();
    private List<string> ppOusBaseline = new();
    private List<string> ppPatternsBaseline = new();
    private List<string> ppTargetsBaseline = new();
    private string ppNewUser = "", ppNewGroup = "", ppNewOu = "", ppNewPattern = "", ppNewTarget = "";
    private string ppDirectoryReadSecretId = "";
    private string ppDirectoryReadSecretIdBaseline = "";
    private string? ppLoadError;

    // aud-a28j. True only when the protection rules were read. A load that failed leaves the five lists
    // empty, and a save from them used to replace every protection rule with nothing - so Save is not
    // offered and the save refuses on its own: the button is not the guard.
    private bool ppLoaded;

    // aud-a28n. The version of the rules this page loaded - from the same read as its lists - which the save
    // compares under the write lock. The save replaces every rule with the page's lists, so a rule added or
    // removed elsewhere since the load has to refuse it rather than be undone by it. A save that lands keeps the
    // version it returns, so a second save from the same page is not refused.
    private string ppRulesVersion = "";

    // aud-a26k. The directory-read secret could not be read when the page loaded. The fail-open read showed an
    // unreadable store as an unset id, and a changed id saved from there wrote over a value never shown. The
    // field is disabled, and a save that would change the id refuses on its own: the field is not the guard.
    private bool ppSecretUnreadable;

    private string SecretUnreadableText =>
        "The directory-read credential's setting could not be read, so it is not shown and cannot be changed here. "
        + SettingsStoreText.ModuleConfig(ProtectedPrincipalService.ProtectedPrincipalsModuleKey);

    // aud-a26n. The appsettings fallback the lookups use while the database holds no usable Secret ID, shown beside the
    // field; null when the database's own value applies, or there is no fallback.
    private int? ppSecretFallbackId;

    private string SecretFallbackText(int fallbackId) =>
        (string.IsNullOrWhiteSpace(ppDirectoryReadSecretIdBaseline) ? "Not set in the database" : "The value in the database is not a usable Secret ID")
        + $"; the configured fallback applies: Secret ID {fallbackId} (Security:ProtectedPrincipalDirectoryReadSecretId in appsettings.json).";

    // Surfaced next to the add controls, not through statusMessage: a refused Add must not
    // overwrite an unrelated save result.
    private string? ppAddError;
    private bool ppValidating;

    // Entries already in the store that AD says do not exist. Populated after first render, not
    // during load - see SweepExistingEntriesAsync. Absence from this set is NOT a claim of
    // validity: an entry whose lookup failed never enters it, deliberately.
    private readonly HashSet<string> ppStaleEntries = new(StringComparer.OrdinalIgnoreCase);
    private bool ppSweepDone;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUser = user.Identity?.Name ?? "Unknown";

        var authResult = await AuthorizationService.AuthorizeAsync(user, "AdminSettings");
        if (!authResult.Succeeded)
        {
            Navigation.NavigateTo("access-denied", forceLoad: true);
            return;
        }

        enablementStoreCorrupt = Enablement.IsStoreCorrupt();
        moduleEnablement = Enablement.GetAllEnablement();
        moduleEnablementBaseline = new Dictionary<string, bool>(moduleEnablement, StringComparer.OrdinalIgnoreCase);
        selectedLogLevel = ExtendedLog.CurrentLevel;
        LoadProtectedPrincipals();
        authChecked = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Deferred to after first paint: the sweep serializes N directory lookups behind a lock
        // that can block 30s each, which would stall the page if run during initialization.
        // Guarded by ppSweepDone rather than firstRender alone - authChecked gates the whole
        // markup, so the first render can complete before the lists exist.
        if (ppSweepDone || !authChecked || ppLoadError != null)
            return;

        ppSweepDone = true;
        await SweepExistingEntriesAsync();
    }

    private async Task SaveEnablement()
    {
        saving = true;
        statusMessage = null;
        await Task.Yield();

        // aud-a28h. Every save on this page records each refusal and its catch, not only a success:
        // a refused or failed attempt to change who can use a module, or who is protected, left no
        // trace. Read above the try, so the catch has the ip too.
        var ip = ClientInfo.GetIpForUser(currentUser);
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authResult = await AuthorizationService.AuthorizeAsync(authState.User, "AdminSettings");
            if (!authResult.Succeeded)
            {
                statusMessage = "Authorization check failed.";
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, EnablementSection, "Authorization", statusMessage, PendingEnablementSections());
                return;
            }

            if (Enablement.IsStoreCorrupt())
            {
                enablementStoreCorrupt = true;
                statusMessage = EnablementRefusal();
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, EnablementSection, "StoreCorrupt", statusMessage, PendingEnablementSections());
                return;
            }

            // aud-a28j. The check above says the store reads now; this one says the toggles came from it.
            // They are the all-disabled fallback when the page's load, or an earlier save, could not read it.
            if (enablementStoreCorrupt)
            {
                statusMessage = "Refusing to save: this page's toggles are not the stored module enablement state (the store could not be read), so saving them could switch modules off. Nothing was changed. Reload the page.";
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, EnablementSection, "StoreUnreadable", statusMessage, PendingEnablementSections());
                return;
            }

            // aud-a28k. Only the toggles the admin changed, each decided against its row under the write lock:
            // writing the whole loaded map switched back every toggle changed elsewhere since the page loaded.
            var outcome = Enablement.SetModulesEnabled(ChangedToggles());
            if (outcome.StoreCorrupt)
            {
                enablementStoreCorrupt = true;
                statusMessage = EnablementRefusal();
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, EnablementSection, "StoreCorrupt", statusMessage, PendingEnablementSections());
                return;
            }

            foreach (var change in outcome.Written)
            {
                try
                {
                    Audit.LogSettingsChange(currentUser, ip, $"Module:{change.ModuleId}",
                        change.Before ? new[] { "Enabled" } : Array.Empty<string>(),
                        change.After ? new[] { "Enabled" } : Array.Empty<string>());
                }
                catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for enablement change"); }
            }

            // Clear BEFORE the reload below, or the guard fires on our own navigation and asks
            // the operator to confirm leaving a page they just saved.
            dirty.ClearSection(SectionModules);
            moduleEnablementBaseline = new Dictionary<string, bool>(moduleEnablement, StringComparer.OrdinalIgnoreCase);
            statusMessage = "Module enablement saved. Refreshing...";
            statusIsError = false;

            // Render BEFORE the reload. Blazor renders an event handler once at its first await
            // and once when it completes - and this handler never completes, it navigates. So
            // without this the browser still holds the pre-save "unsaved changes" flag that
            // UnsavedChangesGuard armed, and the forced reload trips both the in-app confirm and
            // the browser's "Leave site?" over a change that has already been written. It also
            // makes the "Refreshing..." message above actually appear during the delay.
            StateHasChanged();
            await Task.Delay(500);
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        }
        catch (Exception ex)
        {
            statusMessage = $"Failed to save: {ex.Message}";
            statusIsError = true;
            Audit.LogSettingsSaveFailed(Logger, currentUser, ip, EnablementSection, statusMessage, PendingEnablementSections());
        }
        finally
        {
            saving = false;
        }
    }

    // A successful enablement save records one change per module it switched, so there is no one
    // section for an attempt that did not land: its one record is filed under the save as a whole and
    // lists the module sections it was changing (aud-a28h).
    private const string EnablementSection = "ModuleEnablement";

    private string EnablementRefusal() =>
        "Refusing to save: saving now would overwrite the stored module enablement with the all-disabled fallback. Nothing was changed. "
        + SettingsStoreText.Enablement(Enablement.LegacyImportFailed);

    /// <summary>The <c>Module:{id}</c> section of each toggle that differs from what the page loaded.</summary>
    private string[] PendingEnablementSections() =>
        ChangedToggles().Keys.Select(id => $"Module:{id}").ToArray();

    /// <summary>The toggles that differ from what the page loaded, and the state each was switched to.</summary>
    private Dictionary<string, bool> ChangedToggles() =>
        moduleEnablement
            .Where(kv => !moduleEnablementBaseline.TryGetValue(kv.Key, out var loaded) || loaded != kv.Value)
            .ToDictionary(kv => kv.Key, kv => kv.Value, StringComparer.OrdinalIgnoreCase);

    private async Task SaveLogLevel()
    {
        saving = true;
        statusMessage = null;
        await Task.Yield();

        const string section = "ExtendedLogLevel";
        var ip = ClientInfo.GetIpForUser(currentUser);
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authResult = await AuthorizationService.AuthorizeAsync(authState.User, "AdminSettings");
            if (!authResult.Succeeded)
            {
                statusMessage = "Authorization check failed.";
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "Authorization", statusMessage);
                return;
            }

            var previousLevel = ExtendedLog.CurrentLevel;
            ExtendedLog.SetLevel(selectedLogLevel);

            try { Audit.LogSettingsChange(currentUser, ip, section, new[] { previousLevel }, new[] { selectedLogLevel }); }
            catch { }

            statusMessage = $"Extended log level set to {ExtendedLog.CurrentLevel}.";
            statusIsError = false;
        }
        catch (Exception ex)
        {
            // aud-a28k. SetLevel throws when the store refuses the level, and leaves the level in effect
            // unchanged; this used to report and record a level the store had not kept.
            statusMessage = $"Failed to save log level: {ex.Message.TrimEnd('.')}. The extended log level is still {ExtendedLog.CurrentLevel}.";
            statusIsError = true;
            Audit.LogSettingsSaveFailed(Logger, currentUser, ip, section, statusMessage);
        }
        finally
        {
            saving = false;
        }
    }

    private void LoadProtectedPrincipals()
    {
        LoadDirectoryReadSecret();

        var (_, _, error) = ProtectedPrincipalService.LoadEffectiveConfig();
        if (error != null)
        {
            // aud-a26h. The service's error is the text a module shows an operator ("Contact your
            // administrator"); this is the administrator's page, so it names the cause and its fix.
            ppLoadError = "The protection rules could not be read, so the lists below are empty and saving is disabled. "
                + SettingsStoreText.ProtectedPrincipals(
                    ProtectedPrincipalService.LegacyImportFailed, ModuleConfigSvc.IsModuleCorrupt("MailboxPermissions"));
            ppLoaded = false;
            return;
        }

        var editing = ProtectedPrincipalService.LoadRulesForEditing();
        if (editing is null)
        {
            ppLoadError = "The protection rules could not be read, so the lists below are empty and saving is disabled. "
                + SettingsStoreText.ProtectedPrincipals(ProtectedPrincipalService.LegacyImportFailed, exclusionsUnreadable: false);
            ppLoaded = false;
            return;
        }

        ppUsers = editing.Config.Users.ToList();
        ppGroups = editing.Config.Groups.ToList();
        ppOus = editing.Config.OrganizationalUnits.ToList();
        ppPatterns = editing.Config.SamAccountNamePatterns.ToList();
        ppTargets = editing.Config.GroupTargets.ToList();
        ppRulesVersion = editing.Version;
        SnapshotProtectedRulesBaseline();
        ppLoaded = true;
    }

    /// <summary>Loads the directory-read secret id, telling an unreadable store from an unset id (aud-a26k).</summary>
    /// <remarks>
    /// Its own step, and first: the id lives in the ProtectedPrincipals module config, not with the rules, so it
    /// is shown - or shown as unreadable - whether or not the rules load.
    ///
    /// The field holds what the database holds - empty when cleared - never the appsettings fallback in its place
    /// (aud-a26n): showing the fallback's id made a clear look as though it had not taken, and the save compares
    /// this value with the row under its lock, so it has to be the stored one. The caption says when the fallback
    /// applies.
    /// </remarks>
    private void LoadDirectoryReadSecret()
    {
        ppSecretUnreadable = !ProtectedPrincipalService.TryGetDirectoryReadSecret(out var secret);
        ppDirectoryReadSecretId = secret.Stored;
        ppDirectoryReadSecretIdBaseline = ppDirectoryReadSecretId;
        ppSecretFallbackId = secret.FallbackInEffect;
    }

    // Only Patterns keeps a keydown handler. Users, Groups and OUs all use
    // ADIdentityAutocomplete, which owns its own Enter key (it selects the highlighted
    // suggestion), so page-level handlers for those fields were unreachable markup and are gone.
    private void OnPpPatternKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e) { if (e.Key == "Enter") AddPpPattern(); }

    // Users, Groups and OUs are validated against AD before they enter the list: an entry that
    // corresponds to no directory object is not inert. A bad user or OU row silently matches
    // nothing, and a bad GROUP row is worse - group expansion fails closed
    // (ProtectedPrincipalService.CheckGroupMembershipAsync), turning every subsequent check into
    // a denial that reads as a directory fault. See docs/ProtectedPrincipalInputValidation-Plan.md.
    //
    // Patterns are deliberately NOT validated - they are wildcards matched against a resolved
    // target at check time, so there is no object for them to correspond to, and one matching
    // nothing today is legitimate (it may exist to catch future accounts).
    private async Task AddPpUser() => await AddValidatedAsync(ppUsers, ppNewUser, "User", v => ppNewUser = v);
    private async Task AddPpGroup() => await AddValidatedAsync(ppGroups, ppNewGroup, "Group", v => ppNewGroup = v);
    private async Task AddPpOu() => await AddValidatedAsync(ppOus, ppNewOu, "OU", v => ppNewOu = v);

    // Protected TARGETS look up an AD Group but canonicalise as "GroupTarget": the stored value
    // is "objectGUID|DN" (pgwt T0), produced by the validator so the saved entry is exactly
    // what CheckWriteTarget later matches.
    private async Task AddPpTarget() => await AddValidatedAsync(ppTargets, ppNewTarget, "GroupTarget", v => ppNewTarget = v, lookupKind: "Group");

    /// <summary>The DN half of a stored "guid|DN" target entry, for display.</summary>
    private static string TargetLabel(string stored) => ProtectedGroupTargetEntry.Parse(stored).Label;

    /// <summary>
    /// Adds a SamAccountName pattern and recounts the section. Patterns skip the directory
    /// validation the other four kinds go through (see the note above), which is why this is the
    /// one add path that does not run through AddValidatedAsync - and why it has to recount here.
    /// </summary>
    private void AddPpPattern()
    {
        var v = ppNewPattern.Trim();
        if (!string.IsNullOrWhiteSpace(v) && !ppPatterns.Contains(v, StringComparer.OrdinalIgnoreCase))
        {
            ppPatterns.Add(v);
            RecountProtected();
        }
        ppNewPattern = "";
    }

    /// <summary>
    /// Edits the directory-read secret id and recounts the section.
    /// </summary>
    /// <remarks>
    /// Counted by DIFF against what the page loaded, not by tallying events: the field fires on
    /// every input event, so a running tally would count keystrokes, and typing an edit back to
    /// the loaded value has to net to clean. Same reasoning as ModuleConfig's RecountConfig.
    /// </remarks>
    private void SetPpDirectoryReadSecretId(string value)
    {
        ppDirectoryReadSecretId = value;
        RecountProtected();
    }

    /// <summary>
    /// Marks a saved entry that Active Directory says does not exist. Renders nothing for an
    /// entry that resolves, and nothing for one whose lookup could not run.
    /// </summary>
    /// <remarks>
    /// The silence on an unreachable directory is deliberate. A warning shown during an outage
    /// would read as "your protection rules have been lost" across every row at once - alarming
    /// and false. Absence of a badge therefore means "not known to be stale", never "verified".
    /// </remarks>
    private MarkupString StaleBadge(string entry)
        => ppStaleEntries.Contains(entry)
            ? new MarkupString("<span class=\"badge bg-warning text-dark ms-1\" title=\"This entry does not resolve in Active Directory, so it protects nothing. Remove it or replace it with a current one.\">not in AD</span>")
            : new MarkupString("");

    /// <summary>
    /// Re-checks the entries already in the store and flags those that no longer resolve.
    /// Informational only: it never blocks Save and never removes a row.
    /// </summary>
    /// <remarks>
    /// Runs from OnAfterRenderAsync rather than during load. Each lookup takes a shared lock that
    /// can block for up to 30s, and the list is long enough that doing this inline would delay
    /// first paint by minutes in the worst case. The rows render immediately; badges appear when
    /// the sweep finishes.
    ///
    /// Patterns are not swept - they are wildcards with no directory object to correspond to.
    ///
    /// Not blocking Save is a requirement, not an oversight: a decommissioned group must stay
    /// removable. Blocking would make the stale row permanent.
    /// </remarks>
    private async Task SweepExistingEntriesAsync()
    {
        var targets = new List<(string Entry, string Kind)>();
        targets.AddRange(ppUsers.Select(u => (u, "User")));
        targets.AddRange(ppGroups.Select(g => (g, "Group")));
        targets.AddRange(ppOus.Select(o => (o, "OU")));
        // Group TARGETS are deliberately not swept (pgwt-6, the patterns precedent): their
        // identity is the GUID, which keeps protecting across a rename or move - a DN lookup
        // would badge a renamed-but-still-effective row "protects nothing" and invite the
        // admin to remove real protection. A row for a genuinely deleted group protects
        // nothing and harms nothing.

        if (targets.Count == 0)
            return;

        // Opened ABOVE the Task.Run, which is the first thing here that waits on anything. The
        // lookups are serialized and each one waits up to 30 seconds on the directory service's
        // shared runspace lock, so this is the longest unattended wait anywhere on the page and
        // it used to run with the status frame reading Idle from first paint onwards.
        //
        // Items rather than Unknown, deliberately: the number of saved entries IS known here, so
        // "4 of 37" is honest and a bar that only wobbles for several minutes is not. Report is
        // raised from the worker thread on purpose - Components/Shared/GlobalProgress.razor
        // marshals every Changed through InvokeAsync, which is the contract IActivityProgress
        // documents for exactly this case.
        using var activity = Progress.Begin(
            "Admin Settings",
            "Re-checking saved protected principals against Active Directory",
            ActivitySize.Items(targets.Count));

        var stale = await Task.Run(() =>
        {
            var found = new List<string>();
            var done = 0;
            foreach (var (entry, kind) in targets)
            {
                try
                {
                    // ONLY an affirmative NotFound flags a row. Unavailable is skipped so an
                    // outage cannot make every entry look broken at once.
                    if (ProtectedPrincipalEntryValidator.ShouldFlagAsStale(
                            ADSearch.ValidateExists(entry, kind).Outcome))
                        found.Add(entry);
                }
                catch (Exception ex)
                {
                    // Same reasoning: a failed lookup is not evidence the entry is bad.
                    Logger.LogWarning(ex, "Stale-entry sweep failed for a {Kind} entry", kind);
                }

                // Counted whatever the lookup answered: the operator is waiting on the lookup,
                // not on its verdict, so a skipped-because-unavailable row still used the time.
                activity.Report(++done);
            }
            return found;
        });

        // The badge pass is a no-op on an empty list, so it runs before the outcome is reported
        // rather than behind an early return that would complete the activity twice.
        foreach (var s in stale)
            ppStaleEntries.Add(s);

        // A sweep that RAN finished, even when it flagged nothing: success is "did the work
        // complete", not "did the operator get an answer they wanted" (reviewer ruling,
        // `.agents/state.md` 2026-10-08). Said explicitly rather than left to the using, which
        // records "This did not finish." for a sweep that did.
        activity.Complete(true, stale.Count == 0
            ? "No saved entry is missing from Active Directory."
            : $"{stale.Count} saved entries no longer resolve in Active Directory.");

        if (stale.Count == 0)
            return;

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Validates one typed entry against Active Directory and appends it only when the directory
    /// confirms it exists. A refusal leaves the input box untouched so the operator can see and
    /// correct what they typed.
    /// </summary>
    /// <remarks>
    /// The two refusal messages must stay distinct. NotFound means the directory answered and the
    /// operator should check the name; Unavailable means the lookup never ran and they should
    /// retry. Collapsing them would tell an admin their correct entry was a typo during an outage
    /// (owner ruling, .agents/decisions.md and the plan's D1).
    /// </remarks>
    private async Task AddValidatedAsync(List<string> target, string raw, string objectKind, Action<string> setInput, string? lookupKind = null)
    {
        // Blank and duplicate are settled without a directory round-trip.
        if (!ProtectedPrincipalEntryValidator.ShouldConsultDirectory(target, raw))
        {
            var quick = ProtectedPrincipalEntryValidator.Decide(
                target, raw, objectKind, new DirectoryValidationResult(DirectoryLookupOutcome.NotFound, null));
            ppAddError = quick.ErrorMessage;
            if (quick.ClearInput) setInput("");
            return;
        }

        ppValidating = true;
        ppAddError = null;
        StateHasChanged();

        // Opened here and not at the top of the method: everything above this point is the
        // blank/duplicate short-circuit, which settles without touching the directory, and an
        // activity that flashes for a rejected empty box is noise rather than information. From
        // here on the operator is waiting on the same 30-second runspace lock the sweep waits on.
        using var activity = Progress.Begin(
            "Admin Settings",
            "Checking the entry against Active Directory",
            ActivitySize.Unknown);

        DirectoryValidationResult result;
        try
        {
            // Off the render path: ValidateExists is synchronous and takes a lock that can block
            // for up to 30s, which would freeze the circuit if called inline.
            result = await Task.Run(() => ADSearch.ValidateExists(raw.Trim(), lookupKind ?? objectKind));
        }
        catch (Exception ex)
        {
            // Fail closed on an unexpected fault: refuse the entry rather than admit an
            // unvalidated one, and say the lookup failed rather than blame the input.
            Logger.LogWarning(ex, "Protected-principal validation threw for {ObjectKind}", objectKind);
            result = new DirectoryValidationResult(DirectoryLookupOutcome.Unavailable, null);
        }
        finally
        {
            ppValidating = false;
        }

        var decision = ProtectedPrincipalEntryValidator.Decide(target, raw, objectKind, result);

        if (decision.Accepted && decision.ValueToAdd is { } toAdd)
        {
            // pgwt-6: a target's identity is its GUID, so re-adding a renamed group REPLACES
            // the old row (refreshing the stored DN) instead of accumulating two rows that
            // share one GUID - where removing one later would confusingly leave protection on.
            if (objectKind == "GroupTarget")
            {
                var newGuid = ProtectedGroupTargetEntry.Parse(toAdd).ObjectGuid;
                if (!string.IsNullOrEmpty(newGuid) && target.RemoveAll(x => string.Equals(
                        ProtectedGroupTargetEntry.Parse(x).ObjectGuid, newGuid,
                        StringComparison.OrdinalIgnoreCase)) > 0)
                    RecountProtected();
            }

            if (!target.Contains(toAdd, StringComparer.OrdinalIgnoreCase))
            {
                target.Add(toAdd);
                RecountProtected();
            }
        }

        ppAddError = decision.ErrorMessage;
        if (decision.ClearInput) setInput("");

        // A lookup that ANSWERED finished, whatever it answered: a NotFound is a completed check
        // that refused the entry, not a check that failed to run (reviewer ruling,
        // `.agents/state.md` 2026-10-08). Unavailable is the genuine refusal - the question never
        // reached the directory - and stays a non-success. Read from the two LOCALS rather than
        // from ppAddError, which the next Add on any of the four kinds clears while this one
        // could still be suspended on its lookup.
        activity.Complete(
            result.Outcome != DirectoryLookupOutcome.Unavailable,
            decision.ErrorMessage ?? "Active Directory confirmed the entry.");
    }

    private async Task SaveProtectedPrincipals()
    {
        saving = true;
        statusMessage = null;
        await Task.Yield();

        const string section = "ProtectedPrincipals";
        var ip = ClientInfo.GetIpForUser(currentUser);
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authResult = await AuthorizationService.AuthorizeAsync(authState.User, "AdminSettings");
            if (!authResult.Succeeded)
            {
                statusMessage = "Authorization check failed.";
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "Authorization", statusMessage);
                return;
            }

            // Refuse rather than snapshot a list an in-flight Add is about to mutate. Without
            // this, saving mid-validation persists the list WITHOUT the pending entry, reports
            // success, and then shows the entry in the page once validation completes - so the
            // loss is invisible until a reload. The button is also disabled while validating;
            // this is the guarantee behind that, since "UI hiding is not security" is already
            // this repo's rule for the protection path. Review finding ppv-3.
            if (ProtectedPrincipalEntryValidator.ShouldBlockSave(ppValidating))
            {
                statusMessage = ProtectedPrincipalEntryValidator.SaveBlockedMessage;
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "ValidationInProgress", statusMessage);
                return;
            }

            // aud-a28j. What this save writes is the page's lists, so they must be the store's: after a failed
            // load they are empty, and saving them - with an entry added, even - replaced every rule.
            if (!ppLoaded)
            {
                statusMessage = "Refusing to save: the protected principals could not be read when this page loaded, so the lists shown are not the stored rules and saving would replace every rule with them. Nothing was changed. Reload the page once the problem shown on this tab is fixed.";
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "StoreUnreadable", statusMessage);
                return;
            }

            // The directory-read secret is written only when the admin changed it. Rewriting the loaded value
            // on every save reverted a change made elsewhere, and a value the page could not load went back
            // blank. When it is changing, two checks before anything is written, as for the rules: the page's
            // own load (aud-a26k) - the store may read again by now, and the value shown is still not the one the
            // save would replace - and the store as it is now (aud-a28j).
            var secretId = ppDirectoryReadSecretId.Trim();
            var secretChanged = SecretIdDelta(ppDirectoryReadSecretId, ppDirectoryReadSecretIdBaseline) > 0;
            if (secretChanged && secretId.Length > 0 && !ProtectedPrincipalService.IsSecretId(secretId))
            {
                statusMessage = "Refusing to save: the Directory Read Credential (Delinea Secret ID) must be the ID of a secret in Secret Server - a whole number greater than zero - or empty to clear it. Nothing was changed.";
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "Validation", statusMessage);
                return;
            }

            if (secretChanged && ppSecretUnreadable)
            {
                statusMessage = "Refusing to save: the directory-read credential (Delinea Secret ID) could not be read when this page loaded, so the value it holds is not the stored one and saving it would overwrite a value never shown. Nothing was changed. Reload the page once the problem is fixed. "
                    + SettingsStoreText.ModuleConfig(ProtectedPrincipalService.ProtectedPrincipalsModuleKey);
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "StoreUnreadable", statusMessage);
                return;
            }

            if (secretChanged && ModuleConfigSvc.IsModuleCorrupt(ProtectedPrincipalService.ProtectedPrincipalsModuleKey))
            {
                statusMessage = "Refusing to save: the directory-read credential's setting cannot be read. Nothing was changed. "
                    + SettingsStoreText.ModuleConfig(ProtectedPrincipalService.ProtectedPrincipalsModuleKey);
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "StoreCorrupt", statusMessage);
                return;
            }

            if (secretChanged)
            {
                var secretCheck = ProtectedPrincipalService.CompareDirectoryReadSecretId(ppDirectoryReadSecretIdBaseline, secretId);
                if (secretCheck.Status == ModuleConfigSaveStatus.StoreCorrupt)
                {
                    statusMessage = "Refusing to save: the directory-read credential's setting could not be read as the save went to check it. Nothing was saved, the protection rules included. "
                        + SettingsStoreText.ModuleConfig(ProtectedPrincipalService.ProtectedPrincipalsModuleKey);
                    statusIsError = true;
                    Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "StoreCorrupt", statusMessage);
                    return;
                }

                if (secretCheck.Status == ModuleConfigSaveStatus.ConcurrentChange)
                {
                    statusMessage = "Refusing to save: the directory-read credential (Delinea Secret ID) was changed after this page loaded it - by another administrator, or on the other instance. Nothing was saved, the protection rules included. Reload the page and re-apply your changes.";
                    statusIsError = true;
                    Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "ConcurrentChange", statusMessage);
                    return;
                }
            }

            var newConfig = new ProtectedPrincipalConfig
            {
                Users = ppUsers.Where(s => !string.IsNullOrWhiteSpace(s)).ToArray(),
                Groups = ppGroups.Where(s => !string.IsNullOrWhiteSpace(s)).ToArray(),
                OrganizationalUnits = ppOus.Where(s => !string.IsNullOrWhiteSpace(s)).ToArray(),
                SamAccountNamePatterns = ppPatterns.Where(s => !string.IsNullOrWhiteSpace(s)).ToArray(),
                GroupTargets = ppTargets.Where(s => !string.IsNullOrWhiteSpace(s)).ToArray()
            };

            // Decided under the write lock from the rules as they are: a store that cannot be read, a save holding
            // no rules over rules this page never loaded, and rules changed since this page loaded them (its
            // version, aud-a28n) are refused there and write nothing. Rules already changed elsewhere to exactly
            // these come back as already applied, and nothing is written either.
            var outcome = ProtectedPrincipalService.ReplaceConfig(newConfig, pageLoadedRules: LoadedRuleCount() > 0, loadedVersion: ppRulesVersion);
            if (outcome.Status == ProtectedPrincipalSaveStatus.StoreCorrupt)
            {
                statusMessage = "Refusing to save: the protection rules could not be read when this save went to replace them. Nothing was changed. "
                    + SettingsStoreText.ProtectedPrincipals(ProtectedPrincipalService.LegacyImportFailed, exclusionsUnreadable: false);
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "StoreCorrupt", statusMessage);
                return;
            }

            if (outcome.Status == ProtectedPrincipalSaveStatus.EmptyOverNonEmpty)
            {
                statusMessage = $"Refusing to save: this page holds no protection rules - none were read when it loaded - but the store now holds {outcome.Before?.RuleCount ?? 0}. Saving would delete every one of them, so nothing was changed. Reload the page to see the current rules.";
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "EmptyOverNonEmpty", statusMessage);
                return;
            }

            if (outcome.Status == ProtectedPrincipalSaveStatus.ConcurrentChange)
            {
                statusMessage = "Refusing to save: the protection rules were changed after this page loaded them - by another administrator, or on the other instance. Nothing was saved. Reload the page and re-apply your changes.";
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "ConcurrentChange", statusMessage);
                return;
            }

            // The rules are saved and in effect from here, so their record is written now - with the rows the
            // write replaced as its before-state (aud-a28k), not an empty one - and before the secret, whose
            // failure must not hide that they landed (aud-a28j's folded-in partial save). Already applied is
            // recorded the same way, nothing added or removed and the admin's own entries named, so the attempt
            // leaves its trace.
            var alreadyApplied = outcome.Status == ProtectedPrincipalSaveStatus.AlreadyApplied;
            try
            {
                var extra = new Dictionary<string, object?> { ["counts"] = RuleCounts(outcome.After) };
                if (alreadyApplied)
                    extra["alreadyApplied"] = ChangedRuleEntries();
                Audit.LogSettingsChange(currentUser, ip, section, RuleEntries(outcome.Before), RuleEntries(outcome.After), extra);
            }
            catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for protected principals change"); }

            // aud-a26n. Already applied means the stored rules match these lists ignoring case, not that they are these
            // lists: another save may have changed only an entry's casing. The lists become the rows under the lock -
            // the rows the version below is of - so the page shows them, and a later save, which passes the version
            // check, writes them rather than this page's stale casing.
            if (alreadyApplied && outcome.After is { } held)
            {
                ppUsers = held.Users.ToList();
                ppGroups = held.Groups.ToList();
                ppOus = held.OrganizationalUnits.ToList();
                ppPatterns = held.SamAccountNamePatterns.ToList();
                ppTargets = held.GroupTargets.ToList();
            }

            ppRulesVersion = outcome.Version ?? "";
            var secretFailure = secretChanged ? SaveDirectoryReadSecret(secretId, ip) : null;
            if (secretFailure is null)
            {
                dirty.ClearSection(SectionProtected);
                SnapshotProtectedBaseline();
                statusMessage = alreadyApplied
                    ? "Protected principals saved: the rules already held these changes - made the same way elsewhere after this page loaded - so they were not written again. They are in effect."
                    : "Protected principals saved. Changes are effective immediately.";
                statusIsError = false;
            }
            else
            {
                SnapshotProtectedRulesBaseline();
                RecountProtected();
                statusMessage = secretFailure;
                statusIsError = true;
            }
            ppLoadError = null;
        }
        catch (Exception ex)
        {
            statusMessage = $"Failed to save: {ex.Message}";
            statusIsError = true;
            Audit.LogSettingsSaveFailed(Logger, currentUser, ip, section, statusMessage);
        }
        finally { saving = false; }
    }

    private const string SecretSection = "ProtectedPrincipals:DirectoryReadSecretId";

    /// <summary>
    /// Writes the directory-read secret id after the rules have been saved and records it. Null when it
    /// was saved; otherwise what the admin is told.
    /// </summary>
    /// <remarks>
    /// Its own records, under its own section, because it is a second store: the rules are in
    /// protected_principal and the secret in module_config. A secret that failed after the rules saved used
    /// to reach the save's catch, so the page said "Failed to save" over rules already in effect and the one
    /// record said nothing of what had landed.
    /// </remarks>
    private string? SaveDirectoryReadSecret(string secretId, string ip)
    {
        try
        {
            // aud-a26n. Decided under the write lock against the value this page loaded (its baseline): written only
            // while the row still holds what the field showed, so a change made elsewhere since is refused rather than
            // overwritten, and one made the same way is already applied. The rules were written first (aud-a28j), so a
            // refusal here is the secret's alone: recorded under its own section, the message saying the rules saved.
            var outcome = ProtectedPrincipalService.SaveDirectoryReadSecretId(ppDirectoryReadSecretIdBaseline, secretId);
            if (outcome.Status is ModuleConfigSaveStatus.StoreCorrupt or ModuleConfigSaveStatus.ConcurrentChange)
            {
                var concurrent = outcome.Status == ModuleConfigSaveStatus.ConcurrentChange;
                var refusal = "The protection rules were saved and are in effect, but the directory-read credential (Delinea Secret ID) was not saved: "
                    + (concurrent
                        ? "it was changed after this page loaded it - by another administrator, or on the other instance. Reload the page and re-apply your change."
                        : "its setting could not be read as the save went to change it. " + SettingsStoreText.ModuleConfig(ProtectedPrincipalService.ProtectedPrincipalsModuleKey));
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, SecretSection, concurrent ? "ConcurrentChange" : "StoreCorrupt", refusal);
                return refusal;
            }

            try
            {
                Audit.LogSettingsChange(currentUser, ip, SecretSection, SecretValue(outcome.Before), SecretValue(outcome.After),
                    outcome.AlreadyApplied.Count > 0
                        ? new Dictionary<string, object?> { ["alreadyApplied"] = outcome.AlreadyApplied.ToArray() }
                        : null);
            }
            catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for the directory-read secret id change"); }

            var stored = outcome.After.GetValueOrDefault(ProtectedPrincipalService.DirectoryReadSecretConfigKey) ?? "";
            ppDirectoryReadSecretId = stored;
            ppSecretFallbackId = ProtectedPrincipalService.DescribeDirectoryReadSecret(stored).FallbackInEffect;
            return null;
        }
        catch (Exception secretEx)
        {
            Logger.LogError(secretEx, "The directory-read secret id was not saved; the protection rules were");
            var message = $"The protection rules were saved and are in effect, but the directory-read credential (Delinea Secret ID) was not saved: {secretEx.Message} Save again to retry it.";
            Audit.LogSettingsSaveFailed(Logger, currentUser, ip, SecretSection, message);
            return message;
        }
    }

    private static string[] SecretValue(IReadOnlyDictionary<string, string> values) =>
        values.TryGetValue(ProtectedPrincipalService.DirectoryReadSecretConfigKey, out var value) && !string.IsNullOrWhiteSpace(value)
            ? [value.Trim()]
            : [];

    /// <summary>Every rule as <c>Kind:value</c>, so a settings-change record lists what was added and removed.</summary>
    private static string[] RuleEntries(ExchangeAdminWeb.Services.Storage.ProtectedPrincipalData? rules) =>
        rules is null
            ? []
            : rules.Users.Select(v => "Users:" + v)
                .Concat(rules.Groups.Select(v => "Groups:" + v))
                .Concat(rules.OrganizationalUnits.Select(v => "OUs:" + v))
                .Concat(rules.SamAccountNamePatterns.Select(v => "Patterns:" + v))
                .Concat(rules.GroupTargets.Select(v => "Targets:" + v))
                .ToArray();

    /// <summary>The entries the admin added or removed against what the page loaded, as <c>Kind:value</c>.</summary>
    private string[] ChangedRuleEntries() =>
        ChangedEntries("Users", ppUsers, ppUsersBaseline)
            .Concat(ChangedEntries("Groups", ppGroups, ppGroupsBaseline))
            .Concat(ChangedEntries("OUs", ppOus, ppOusBaseline))
            .Concat(ChangedEntries("Patterns", ppPatterns, ppPatternsBaseline))
            .Concat(ChangedEntries("Targets", ppTargets, ppTargetsBaseline))
            .ToArray();

    private static IEnumerable<string> ChangedEntries(string kind, List<string> current, List<string> loaded) =>
        current.Except(loaded, StringComparer.OrdinalIgnoreCase)
            .Concat(loaded.Except(current, StringComparer.OrdinalIgnoreCase))
            .Select(v => kind + ":" + v);

    private static string RuleCounts(ExchangeAdminWeb.Services.Storage.ProtectedPrincipalData? rules) =>
        rules is null
            ? ""
            : $"Users:{rules.Users.Length},Groups:{rules.Groups.Length},OUs:{rules.OrganizationalUnits.Length},Patterns:{rules.SamAccountNamePatterns.Length},Targets:{rules.GroupTargets.Length}";
}

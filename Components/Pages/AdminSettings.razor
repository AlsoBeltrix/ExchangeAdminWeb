    /// <summary>Whether the five lists still hold exactly <paramref name="config"/>'s entries, in order and casing.</summary>
    private bool ListsHold(ProtectedPrincipalConfig config) =>
        ppUsers.SequenceEqual(config.Users, StringComparer.Ordinal)
        && ppGroups.SequenceEqual(config.Groups, StringComparer.Ordinal)
        && ppOus.SequenceEqual(config.OrganizationalUnits, StringComparer.Ordinal)
        && ppPatterns.SequenceEqual(config.SamAccountNamePatterns, StringComparer.Ordinal)
        && ppTargets.SequenceEqual(config.GroupTargets, StringComparer.Ordinal)
        && ppUserIds.SequenceEqual(config.UserIds, StringComparer.Ordinal)
        && ppGroupIds.SequenceEqual(config.GroupIds, StringComparer.Ordinal)
        && ppOuIds.SequenceEqual(config.OuIds, StringComparer.Ordinal);

    private static ExchangeAdminWeb.Services.Storage.ProtectedPrincipalData RulesOf(ProtectedPrincipalConfig config) =>
        config.ToData();


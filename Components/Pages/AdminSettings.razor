            string.Equals(r.Item.RowKey, kind, StringComparison.Ordinal) && string.Equals(r.Item.StoredValue, storedValue, StringComparison.Ordinal));

    /// <summary>The finding's badge beside an entry; nothing before a press, or for an entry the press did not read.</summary>
    private MarkupString VerifyBadge(string kind, string storedValue)
    {
        if (VerifyResultFor(kind, storedValue) is not { } r)
            return new MarkupString("");

        var (text, css, tip) = VerifyBadgeParts(r, VerifiedAt());
        return new MarkupString($"<span class=\"badge {css} ms-1\" title=\"{System.Net.WebUtility.HtmlEncode(tip)}\">{System.Net.WebUtility.HtmlEncode(text)}</span>");
    }

    private bool CanVerify() => ppLoaded && !saving && !ppValidating && !ppVerifying && !ppActing && !dirty.IsSectionDirty(SecProtected);

    private string VerifySummaryText()
    {
        if (ppVerifying)
            return "Asking Active Directory about every stored entry...";
        if (dirty.IsSectionDirty(SecProtected))
            return "Save or discard this pane's changes to verify.";
        if (ppVerifyReport is { } report)
            return report.Summary(VerifiedAt())
                + (report.StaleIgnores.Count > 0 ? $" {report.StaleIgnores.Count} recorded ignore(s) no longer match what Verify sees." : "");
        if (ppVerifyLast is { } last)
            return $"Last verified {LocalTime(last.At)} by {last.By}: {last.Total} entries, {last.Findings} findings, {last.Ignored} ignored, "
                + $"{last.Unreadable} could not be verified.";
        return "Not verified yet.";
    }

    private static string LocalTime(string at) =>
        DateTimeOffset.TryParse(at, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.RoundtripKind, out var t)
            ? t.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
            : at;

    /// <summary>The finding under an entry, for the markup's verifyRow template; null for a verified entry or before a press.</summary>
    private VerifyItemResult? VerifyRowFor(string kind, string storedValue) =>
        VerifyResultFor(kind, storedValue) is { } r && r.Finding.Kind != VerifyFindingKind.Verified ? r : null;

    private IReadOnlyList<VerifyAction> VerifyActionsOf(VerifyItemResult r) => Verifier.AdapterFor(r.Item.Store).ActionsFor(r.Item, r.Finding);


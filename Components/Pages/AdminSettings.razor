    private static string PickerValueKind(VerifyObjectKind kind) => kind == VerifyObjectKind.User ? "UPN" : "DN";

    // The validator's kind for a replacement: a target canonicalises as GroupTarget over a Group lookup, as its Add does.
    private static string ValidatorKind(VerifyObjectKind kind) => kind switch
    {
        VerifyObjectKind.User => "User",
        VerifyObjectKind.OrganizationalUnit => "OU",
        VerifyObjectKind.GroupTarget => "GroupTarget",
        _ => "Group",
    };

    private ProtectedPrincipalVerifyActions VerifyActions() => new(ProtectedPrincipalService, AuthorizationService, Audit, Logger);

    /// <summary>
    /// The Verify press (plan C.1): the admin re-authorized, the rules, their version and the ignore list read in one read
    /// transaction and shown, every entry looked up in one directory session, the report shown, one audit row with the counts,
    /// and the last-verified line stored.
    /// </summary>
    private async Task VerifyProtectedAsync()
    {
        if (!CanVerify())
        {
            ppVerifyMessage = dirty.IsSectionDirty(SecProtected)
                ? "Save or discard this pane's changes before verifying: Verify shows the stored rules."
                : null;
            ppVerifyIsError = true;
            return;
        }

        ppVerifying = true;
        ppVerifyMessage = null;
        ppReplaceTarget = null;
        await Task.Yield();

        var ip = ClientInfo.GetIpForUser(currentUser);
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var actions = VerifyActions();
            if (!await actions.AuthorizePressAsync(authState.User, currentUser, ip))
            {
                ppVerifyMessage = "Authorization check failed. Nothing was verified.";
                ppVerifyIsError = true;
                return;
            }

            var workset = await Task.Run(() => ProtectedPrincipalService.ReadForVerify());
            if (workset is null)
            {
                ppVerifyMessage = "The protection rules could not be read, so nothing was verified. "
                    + SettingsStoreText.ProtectedPrincipals(ProtectedPrincipalService.LegacyImportFailed, exclusionsUnreadable: false);
                ppVerifyIsError = true;
                return;
            }

            var items = workset.Items;
            using var activity = Progress.Begin(
                "Admin Settings",
                "Verifying the stored protected principals against Active Directory",
                ActivitySize.Items(items.Count));
            var report = await Verifier.VerifyAsync(items, workset.Ignores(Logger), CancellationToken.None);
            activity.Report(items.Count);
            activity.Complete(true, report.Summary(report.At.ToLocalTime().ToString("yyyy-MM-dd HH:mm")));

            // The rows shown are the rows verified: the pane holds no unsaved edit, so showing the snapshot loses nothing.
            ShowRules(workset.Rules);
            SetRulesBaseline(workset.Rules);
            ppRulesVersion = workset.Version;
            RecountProtected();
            ppVerifyReport = report;
            ppVerifyIgnoresRaw = workset.IgnoresRaw;
            await Task.Run(() => actions.RecordPress(currentUser, ip, report));
            ppVerifyLast = null;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Verify of the protected principals failed");
            ppVerifyMessage = $"Verify did not finish: {ex.Message}";
            ppVerifyIsError = true;
        }
        finally
        {
            ppVerifying = false;
        }
    }

    /// <summary>One action button: Replace opens its picker; every other action writes at once.</summary>
    private async Task OnVerifyActionAsync(VerifyAction action, VerifyItemResult r)
    {
        switch (action)
        {
            case VerifyAction.Replace:
                StartReplace(r);
                break;
            case VerifyAction.Rename:
                await RunVerifyActionAsync(r, (a, user, ip) => a.RenameAsync(user, currentUser, ip, r.Item, r.Finding));
                break;
            case VerifyAction.Convert:
                await RunVerifyActionAsync(r, (a, user, ip) => a.ConvertAsync(user, currentUser, ip, r.Item, r.Finding));
                break;
            case VerifyAction.Remove:
                await RunVerifyActionAsync(r, (a, user, ip) => a.RemoveAsync(user, currentUser, ip, r.Item, r.Finding, ppVerifyIgnoresRaw));
                break;
            case VerifyAction.Ignore:
                await RunVerifyActionAsync(r, (a, user, ip) => a.IgnoreAsync(user, currentUser, ip, r.Item, r.Finding, ppVerifyIgnoresRaw));
                break;
        }
    }

    private void StartReplace(VerifyItemResult r)
    {
        ppReplaceTarget = r;
        ppReplaceValue = "";
    }

    private void CancelReplace()
    {
        ppReplaceTarget = null;
        ppReplaceValue = "";
    }

    /// <summary>
    /// Replace (plan C.2): the picked object is checked against Active Directory exactly as an Add is, and replaces the entry
    /// in place through the direct primitive.
    /// </summary>
    private async Task ReplaceVerifiedAsync()
    {
        if (ppReplaceTarget is not { } r || string.IsNullOrWhiteSpace(ppReplaceValue) || !CanVerify())
            return;

        var raw = ppReplaceValue.Trim();
        var objectKind = ValidatorKind(r.Item.Kind);
        ppActing = true;
        ppVerifyMessage = null;

        EntryValidationDecision decision;
        try
        {
            using var activity = Progress.Begin("Admin Settings", "Checking the replacement against Active Directory", ActivitySize.Unknown);
            DirectoryValidationResult result;
            try
            {
                result = await Task.Run(() => ADSearch.ValidateExists(raw, objectKind == "GroupTarget" ? "Group" : objectKind));
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Validation of a Verify replacement threw for {ObjectKind}", objectKind);
                result = new DirectoryValidationResult(DirectoryLookupOutcome.Unavailable, null);
            }

            decision = ProtectedPrincipalEntryValidator.Decide(ExistingLabelsBesides(r.Item), raw, objectKind, result);
            activity.Complete(result.Outcome != DirectoryLookupOutcome.Unavailable, decision.ErrorMessage ?? "Active Directory confirmed the replacement.");
        }
        finally
        {
            ppActing = false;
        }

        if (!decision.Accepted || decision.ValueToAdd is not { } newRow)
        {
            ppVerifyMessage = decision.ErrorMessage ?? "The replacement was not accepted. Nothing was changed.";
            ppVerifyIsError = true;
            return;
        }

        await RunVerifyActionAsync(r, (a, user, ip) =>
            a.ReplaceAsync(user, currentUser, ip, r.Item, r.Finding, newRow, decision.CompanionValue, ppVerifyIgnoresRaw));
    }

    // The entries a replacement must not duplicate: the other rows of the list it lands in, by the label an Add compares.
    private IReadOnlyCollection<string> ExistingLabelsBesides(VerifyItem item) => item.Kind switch
    {
        VerifyObjectKind.User => ppUserIds.Where(v => v != item.StoredValue).Select(IdLabel).ToList(),
        VerifyObjectKind.Group => ppGroupIds.Where(v => v != item.StoredValue).Select(IdLabel).ToList(),
        VerifyObjectKind.OrganizationalUnit => ppOuIds.Where(v => v != item.StoredValue).Select(IdLabel).ToList(),
        _ => ppTargets.Where(v => v != item.StoredValue).ToList(),
    };

    /// <summary>
    /// Runs one direct action: refused while this pane holds unsaved edits or another action runs; otherwise the admin's
    /// current principal is handed to the action, which re-authorizes, writes and audits. A landed action shows the rows it
    /// left and rebases the other findings on them (<see cref="ProtectedPrincipalVerifyActions.Rebase"/>).
    /// </summary>
    private async Task RunVerifyActionAsync(
        VerifyItemResult r, Func<ProtectedPrincipalVerifyActions, System.Security.Claims.ClaimsPrincipal, string, Task<VerifyActionResult>> act)
    {
        if (!CanVerify() || ppVerifyReport is null)
        {
            ppVerifyMessage = "Not done: save or discard this pane's changes first, and wait for any other action to finish.";
            ppVerifyIsError = true;
            return;
        }

        ppActing = true;
        ppVerifyMessage = null;
        await Task.Yield();
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var ip = ClientInfo.GetIpForUser(currentUser);
            var result = await act(VerifyActions(), authState.User, ip);
            ppVerifyMessage = result.Message;
            ppVerifyIsError = !result.Succeeded;
            if (result.Succeeded && result.Outcome is { } outcome)
            {
                if (outcome.After is { } after)
                {
                    ShowRules(after);
                    SetRulesBaseline(after);
                    RecountProtected();
                }
                if (outcome.AfterVersion is { } version)
                    ppRulesVersion = version;
                ppVerifyIgnoresRaw = outcome.AfterIgnores;
                ppVerifyReport = ProtectedPrincipalVerifyActions.Rebase(ppVerifyReport, r, outcome);
                ppReplaceTarget = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "A Verify action on the protected principals failed");
            ppVerifyMessage = $"Not done: {ex.Message}";
            ppVerifyIsError = true;
        }
        finally
        {
            ppActing = false;
        }
    }

    /// <summary>
    /// Validates one typed entry against Active Directory and appends it only when the directory
    /// confirms it exists. A refusal leaves the input box untouched so the operator can see and
    /// correct what they typed.
    /// </summary>
    /// <remarks>
    /// The two refusal messages must stay distinct. NotFound means the directory answered and the
    /// operator should check the name; Unavailable means the lookup never ran and they should
    /// retry. Collapsing them would tell an admin their correct entry was a typo during an outage
    /// (owner ruling, .agents/decisions.md and the plan's D1).
    /// </remarks>
    private async Task AddValidatedAsync(
        List<string> target, string raw, string objectKind, Action<string> setInput, string? lookupKind = null, List<string>? ids = null)
    {
        // An entry already stored by identifier is a duplicate by its label. A legacy row with no identifier is not: adding
        // it again stores its identifier row, and the legacy row becomes that row's companion.
        IReadOnlyCollection<string> existing = ids is null ? target : ids.Select(IdLabel).ToList();

        // Blank and duplicate are settled without a directory round-trip.
        if (!ProtectedPrincipalEntryValidator.ShouldConsultDirectory(existing, raw))
        {
            var quick = ProtectedPrincipalEntryValidator.Decide(
                existing, raw, objectKind, new DirectoryValidationResult(DirectoryLookupOutcome.NotFound, null));
            ppAddError = quick.ErrorMessage;
            if (quick.ClearInput) setInput("");
            return;
        }

        ppValidating = true;
        ppAddError = null;
        StateHasChanged();

        // Opened here and not at the top of the method: everything above this point is the
        // blank/duplicate short-circuit, which settles without touching the directory, and an
        // activity that flashes for a rejected empty box is noise rather than information. From
        // here on the operator is waiting on the same 30-second runspace lock the sweep waits on.
        using var activity = Progress.Begin(
            "Admin Settings",
            "Checking the entry against Active Directory",
            ActivitySize.Unknown);

        DirectoryValidationResult result;
        try
        {
            // Off the render path: ValidateExists is synchronous and takes a lock that can block
            // for up to 30s, which would freeze the circuit if called inline.
            result = await Task.Run(() => ADSearch.ValidateExists(raw.Trim(), lookupKind ?? objectKind));
        }
        catch (Exception ex)
        {
            // Fail closed on an unexpected fault: refuse the entry rather than admit an
            // unvalidated one, and say the lookup failed rather than blame the input.
            Logger.LogWarning(ex, "Protected-principal validation threw for {ObjectKind}", objectKind);
            result = new DirectoryValidationResult(DirectoryLookupOutcome.Unavailable, null);
        }
        finally
        {
            ppValidating = false;
        }

        var decision = ProtectedPrincipalEntryValidator.Decide(existing, raw, objectKind, result);

        if (decision.Accepted && decision.ValueToAdd is { } idRow && ids is not null)
        {
            AddIdentifierRow(ids, target, idRow, decision.CompanionValue);
        }
        else if (decision.Accepted && decision.ValueToAdd is { } toAdd)
        {
            // pgwt-6: a target's identity is its GUID, so re-adding a renamed group REPLACES
            // the old row (refreshing the stored DN) instead of accumulating two rows that
            // share one GUID - where removing one later would confusingly leave protection on.
            if (objectKind == "GroupTarget")
            {
                var newGuid = ProtectedGroupTargetEntry.Parse(toAdd).ObjectGuid;
                if (!string.IsNullOrEmpty(newGuid) && target.RemoveAll(x => string.Equals(
                        ProtectedGroupTargetEntry.Parse(x).ObjectGuid, newGuid,
                        StringComparison.OrdinalIgnoreCase)) > 0)
                    RecountProtected();
            }

            if (!target.Contains(toAdd, StringComparer.OrdinalIgnoreCase))
            {
                target.Add(toAdd);
                RecountProtected();
            }
        }

        ppAddError = decision.ErrorMessage;
        if (decision.ClearInput) setInput("");

        // A lookup that ANSWERED finished, whatever it answered: a NotFound is a completed check
        // that refused the entry, not a check that failed to run (reviewer ruling,
        // `.agents/state.md` 2026-10-08). Unavailable is the genuine refusal - the question never
        // reached the directory - and stays a non-success. Read from the two LOCALS rather than
        // from ppAddError, which the next Add on any of the four kinds clears while this one
        // could still be suspended on its lookup.
        activity.Complete(
            result.Outcome != DirectoryLookupOutcome.Unavailable,
            decision.ErrorMessage ?? "Active Directory confirmed the entry.");
    }

    /// <summary>
    /// Stores a validated user, group or OU as its identifier row and its companion legacy row
    /// (docs/ProtectedPrincipalIdentifiers-Plan.md A.2, B.1). The same object added again - under another name, or after a
    /// rename - replaces its identifier row, refreshing the label, rather than accumulating two rows for one object (the
    /// pgwt-6 rule for targets); the old label's companion goes with it unless another row still pairs with it.
    /// </summary>
    private void AddIdentifierRow(List<string> ids, List<string> legacy, string idRow, string? companion)
    {
        if (ProtectedPrincipalIdEntry.AddWithCompanion(ids, legacy, idRow, companion))
            RecountProtected();
    }

    private async Task SaveProtectedPrincipals()
    {
        // kd-72. The directory-read secret ID this save validates and writes, read here, above the yield. Its box is
        // bound by hand on input and not disabled while a save runs, so a keystroke landing in the yield or the
        // authorization re-check was the ID validated and saved. The lists are built by the Add and Remove clicks,
        // and their snapshot stays below the in-flight-Add refusal (ppv-3), where it was.
        var submittedSecretId = ppDirectoryReadSecretId;
        var submittedGraphSecretId = ppGraphReadSecretId;

        saving = true;
        statusMessage = null;
        await Task.Yield();

        const string section = "ProtectedPrincipals";
        var ip = ClientInfo.GetIpForUser(currentUser);
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authResult = await AuthorizationService.AuthorizeAsync(authState.User, "AdminSettings");
            if (!authResult.Succeeded)
            {
                statusMessage = "Authorization check failed.";
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "Authorization", statusMessage);
                return;
            }

            // Refuse rather than snapshot a list an in-flight Add is about to mutate. Without
            // this, saving mid-validation persists the list WITHOUT the pending entry, reports
            // success, and then shows the entry in the page once validation completes - so the
            // loss is invisible until a reload. The button is also disabled while validating;
            // this is the guarantee behind that, since "UI hiding is not security" is already
            // this repo's rule for the protection path. Review finding ppv-3.
            if (ProtectedPrincipalEntryValidator.ShouldBlockSave(ppValidating))
            {
                statusMessage = ProtectedPrincipalEntryValidator.SaveBlockedMessage;
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "ValidationInProgress", statusMessage);
                return;
            }

            // aud-a28j. What this save writes is the page's lists, so they must be the store's: after a failed
            // load they are empty, and saving them - with an entry added, even - replaced every rule.
            if (!ppLoaded)
            {
                statusMessage = "Refusing to save: the protected principals could not be read when this page loaded, so the lists shown are not the stored rules and saving would replace every rule with them. Nothing was changed. Reload the page once the problem shown on this tab is fixed.";
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "StoreUnreadable", statusMessage);
                return;
            }

            // The directory-read secret is written only when the admin changed it. Rewriting the loaded value
            // on every save reverted a change made elsewhere, and a value the page could not load went back
            // blank. When it is changing, two checks before anything is written, as for the rules: the page's
            // own load (aud-a26k) - the store may read again by now, and the value shown is still not the one the
            // save would replace - and the store as it is now (aud-a28j).
            var secretId = submittedSecretId.Trim();
            var secretChanged = SecretIdDelta(submittedSecretId, ppDirectoryReadSecretIdBaseline) > 0;

            // aud-a26p. A changed Secret ID the lookups would not read is refused before anything is written: stored, it
            // sent every lookup to the appsettings fallback or to no credential, and the typo showed only as a lookup
            // failing later. The rule (IsSecretId) takes digits only, with no sign or leading zero (aud-a26s): stricter than the
            // lookups' read, so nothing is stored that they would not use and nothing is stored that differs from what was meant.
            // Blank stays allowed - it clears the stored id. The message names the field and never repeats its text: a field
            // that takes an ID is where a pasted password lands, and the refusal is recorded.
            if (secretChanged && secretId.Length > 0 && !ProtectedPrincipalService.IsSecretId(secretId))
            {
                statusMessage = "Refusing to save: the Directory Read Credential (Delinea Secret ID) must be the ID of a secret in Secret Server - a whole number greater than zero, in digits only, with no sign or leading zero - or empty to clear it. Nothing was changed.";
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "Validation", statusMessage);
                return;
            }

            if (secretChanged && ppSecretUnreadable)
            {
                statusMessage = "Refusing to save: the directory-read credential (Delinea Secret ID) could not be read when this page loaded, so the value it holds is not the stored one and saving it would overwrite a value never shown. Nothing was changed. Reload the page once the problem is fixed. "
                    + SettingsStoreText.ModuleConfig(ProtectedPrincipalService.ProtectedPrincipalsModuleKey);
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "StoreUnreadable", statusMessage);
                return;
            }

            if (secretChanged && ModuleConfigSvc.IsModuleCorrupt(ProtectedPrincipalService.ProtectedPrincipalsModuleKey))
            {
                statusMessage = "Refusing to save: the directory-read credential's setting cannot be read. Nothing was changed. "
                    + SettingsStoreText.ModuleConfig(ProtectedPrincipalService.ProtectedPrincipalsModuleKey);
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "StoreCorrupt", statusMessage);
                return;
            }

            // docs/ProtectedPrincipalIdentifiers-Plan.md C.2. The Graph Directory Read Credential's Secret ID, by the same rules.
            var graphSecretId = submittedGraphSecretId.Trim();
            var graphSecretChanged = SecretIdDelta(submittedGraphSecretId, ppGraphReadSecretIdBaseline) > 0;
            if (graphSecretChanged && graphSecretId.Length > 0 && !ProtectedPrincipalService.IsSecretId(graphSecretId))
            {
                statusMessage = "Refusing to save: the Graph Directory Read Credential (Delinea Secret ID) must be the ID of a secret in Secret Server - a whole number greater than zero, in digits only, with no sign or leading zero - or empty to clear it. Nothing was changed.";
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "Validation", statusMessage);
                return;
            }

            if (graphSecretChanged && (ppSecretUnreadable || ModuleConfigSvc.IsModuleCorrupt(ProtectedPrincipalService.ProtectedPrincipalsModuleKey)))
            {
                statusMessage = "Refusing to save: the Graph Directory Read Credential's setting could not be read, so the value shown is not the stored one and saving it could overwrite a value never shown. Nothing was changed. "
                    + SettingsStoreText.ModuleConfig(ProtectedPrincipalService.ProtectedPrincipalsModuleKey);
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, ppSecretUnreadable ? "StoreUnreadable" : "StoreCorrupt", statusMessage);
                return;
            }

            // aud-a41. What this save writes, taken before its first store call. Each of its three calls runs off the circuit - a
            // call can wait up to the store's busy timeout for a lock held elsewhere, and on the circuit that wait froze the page -
            // so the admin can edit while it runs, and an edit made then is not part of this save.
            var loadedSecretId = ppDirectoryReadSecretIdBaseline;
            var loadedGraphSecretId = ppGraphReadSecretIdBaseline;
            var newConfig = new ProtectedPrincipalConfig
            {
                Users = ppUsers.Where(s => !string.IsNullOrWhiteSpace(s)).ToArray(),
                Groups = ppGroups.Where(s => !string.IsNullOrWhiteSpace(s)).ToArray(),
                OrganizationalUnits = ppOus.Where(s => !string.IsNullOrWhiteSpace(s)).ToArray(),
                SamAccountNamePatterns = ppPatterns.Where(s => !string.IsNullOrWhiteSpace(s)).ToArray(),
                GroupTargets = ppTargets.Where(s => !string.IsNullOrWhiteSpace(s)).ToArray(),
                UserIds = ppUserIds.Where(s => !string.IsNullOrWhiteSpace(s)).ToArray(),
                GroupIds = ppGroupIds.Where(s => !string.IsNullOrWhiteSpace(s)).ToArray(),
                OuIds = ppOuIds.Where(s => !string.IsNullOrWhiteSpace(s)).ToArray()
            };
            var pageLoadedRules = LoadedRuleCount() > 0;
            var loadedVersion = ppRulesVersion;

            // aud-a28r. The secret's compare runs here, before the rules are written, and a conflict refuses the whole save.
            // It used to run only inside the secret's own write, after the rules had landed, so a secret changed elsewhere
            // left half of the one change the admin confirmed saved. Not one write for both: the rules and the secret are
            // two repositories, each opening its own transaction, and neither can join the other's. This compare holds the
            // secret's write lock and writes nothing. The secret's write below compares again, so a change landing between
            // the two - during this save's rules write - is still refused rather than overwritten; the rules are then saved
            // and both halves are recorded.
            if (secretChanged)
            {
                // aud-a28v, aud-a40. The compare holds the settings store's write lock, so a lock held elsewhere for longer than
                // the store waits fails it, and with it the whole save, before anything is written: the save's catch records
                // that as a busy store, a refusal.
                var secretCheck = await Task.Run(() => ProtectedPrincipalService.CompareDirectoryReadSecretId(loadedSecretId, secretId));

                if (secretCheck.Status == ModuleConfigSaveStatus.StoreCorrupt)
                {
                    statusMessage = "Refusing to save: the directory-read credential's setting could not be read as the save went to check it. Nothing was saved, the protection rules included. "
                        + SettingsStoreText.ModuleConfig(ProtectedPrincipalService.ProtectedPrincipalsModuleKey);
                    statusIsError = true;
                    Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "StoreCorrupt", statusMessage);
                    return;
                }

                if (secretCheck.Status == ModuleConfigSaveStatus.ConcurrentChange)
                {
                    statusMessage = "Refusing to save: the directory-read credential (Delinea Secret ID) was changed after this page loaded it - by another administrator, or on the other instance. Nothing was saved, the protection rules included. Reload the page and re-apply your changes.";
                    statusIsError = true;
                    Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "ConcurrentChange", statusMessage);
                    return;
                }
            }

            // aud-a28r, for the Graph Directory Read Credential: compared before the rules are written, so a value changed
            // elsewhere refuses the whole save rather than half of it.
            if (graphSecretChanged)
            {
                var graphCheck = await Task.Run(() => ProtectedPrincipalService.CompareGraphDirectoryReadSecretId(loadedGraphSecretId, graphSecretId));
                if (graphCheck.Status is ModuleConfigSaveStatus.StoreCorrupt or ModuleConfigSaveStatus.ConcurrentChange)
                {
                    var concurrent = graphCheck.Status == ModuleConfigSaveStatus.ConcurrentChange;
                    statusMessage = concurrent
                        ? "Refusing to save: the Graph Directory Read Credential (Delinea Secret ID) was changed after this page loaded it - by another administrator, or on the other instance. Nothing was saved, the protection rules included. Reload the page and re-apply your changes."
                        : "Refusing to save: the Graph Directory Read Credential's setting could not be read as the save went to check it. Nothing was saved, the protection rules included. "
                            + SettingsStoreText.ModuleConfig(ProtectedPrincipalService.ProtectedPrincipalsModuleKey);
                    statusIsError = true;
                    Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, concurrent ? "ConcurrentChange" : "StoreCorrupt", statusMessage);
                    return;
                }
            }

            // Decided under the write lock from the rules as they are: a store that cannot be read, a save holding
            // no rules over rules this page never loaded, and rules changed since this page loaded them (its
            // version, aud-a28n) are refused there and write nothing. Rules already changed elsewhere to exactly
            // these come back as already applied, and nothing is written either.
            var outcome = await Task.Run(() => ProtectedPrincipalService.ReplaceConfig(newConfig, pageLoadedRules, loadedVersion));
            if (outcome.Status == ProtectedPrincipalSaveStatus.StoreCorrupt)
            {
                statusMessage = "Refusing to save: the protection rules could not be read when this save went to replace them. Nothing was changed. "
                    + SettingsStoreText.ProtectedPrincipals(ProtectedPrincipalService.LegacyImportFailed, exclusionsUnreadable: false);
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "StoreCorrupt", statusMessage);
                return;
            }

            if (outcome.Status == ProtectedPrincipalSaveStatus.EmptyOverNonEmpty)
            {
                statusMessage = $"Refusing to save: this page holds no protection rules - none were read when it loaded - but the store now holds {outcome.Before?.RuleCount ?? 0}. Saving would delete every one of them, so nothing was changed. Reload the page to see the current rules.";
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "EmptyOverNonEmpty", statusMessage);
                return;
            }

            if (outcome.Status == ProtectedPrincipalSaveStatus.ConcurrentChange)
            {
                statusMessage = "Refusing to save: the protection rules were changed after this page loaded them - by another administrator, or on the other instance. Nothing was saved. Reload the page and re-apply your changes.";
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "ConcurrentChange", statusMessage);
                return;
            }

            // The rules are saved and in effect from here, so their record is written now - with the rows the
            // write replaced as its before-state (aud-a28k), not an empty one - and before the secret, whose
            // failure must not hide that they landed (aud-a28j's folded-in partial save). Already applied is
            // recorded the same way, nothing added or removed and the admin's own entries named, so the attempt
            // leaves its trace.
            var alreadyApplied = outcome.Status == ProtectedPrincipalSaveStatus.AlreadyApplied;
            try
            {
                var extra = new Dictionary<string, object?> { ["counts"] = RuleCounts(outcome.After) };
                if (alreadyApplied)
                    extra["alreadyApplied"] = ChangedRuleEntries(newConfig);
                Audit.LogSettingsChange(currentUser, ip, section, RuleEntries(outcome.Before), RuleEntries(outcome.After), extra);
            }
            catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for protected principals change"); }

            // aud-a26n. Already applied means the stored rules match these lists ignoring case, not that they are these
            // lists: another save may have changed only an entry's casing. The lists become the rows under the lock -
            // the rows the version below is of - so the page shows them, and a later save, which passes the version
            // check, writes them rather than this page's stale casing.
            // aud-a41. The lists take those rows only while they still hold what this save wrote: an edit made while it waited
            // stays on the page. The baseline becomes what the store now holds, so the recount below still counts that edit.
            var rulesNow = alreadyApplied && outcome.After is { } held ? held : RulesOf(newConfig);
            if (ListsHold(newConfig))
                ShowRules(rulesNow);

            ppRulesVersion = outcome.Version ?? "";
            SetRulesBaseline(rulesNow);
            var secretFailure = secretChanged ? await SaveDirectoryReadSecretAsync(loadedSecretId, secretId, ip) : null;
            var graphFailure = graphSecretChanged ? await SaveGraphReadSecretAsync(loadedGraphSecretId, graphSecretId, ip) : null;
            if (graphFailure is not null)
                secretFailure = secretFailure is null ? graphFailure : secretFailure + " " + graphFailure;
            RecountProtected();
            if (secretFailure is null)
            {
                statusMessage = alreadyApplied
                    ? "Protected principals saved: the rules already held these changes - made the same way elsewhere after this page loaded - so they were not written again. They are in effect."
                    : "Protected principals saved. Changes are effective immediately.";
                statusIsError = false;
            }
            else
            {
                statusMessage = secretFailure;
                statusIsError = true;
            }
            ppLoadError = null;
        }
        catch (Exception ex)
        {
            // aud-a40. Every store call this reaches is its own transaction, rolled back when it throws, and the secret's write -
            // the one after the rules - catches its own; so a busy store here wrote nothing, the rules included.
            statusMessage = Audit.LogSettingsSaveException(Logger, currentUser, ip, section, ex, $"Failed to save: {ex.Message}",
                busy: SettingsSaveAudit.StoreBusyMessage("Nothing was written, the protection rules and the directory-read credential (Delinea Secret ID) included."));
            statusIsError = true;
        }
        finally { saving = false; }
    }

    private const string SecretSection = "ProtectedPrincipals:DirectoryReadSecretId";

    /// <summary>
    /// Writes the directory-read secret id after the rules have been saved and records it. Null when it
    /// was saved; otherwise what the admin is told.
    /// </summary>
    /// <remarks>
    /// Its own records, under its own section, because it is a second store: the rules are in
    /// protected_principal and the secret in module_config. A secret that failed after the rules saved used
    /// to reach the save's catch, so the page said "Failed to save" over rules already in effect and the one
    /// record said nothing of what had landed.
    /// </remarks>
    private async Task<string?> SaveDirectoryReadSecretAsync(string loadedSecretId, string secretId, string ip)
    {
        try
        {
            // aud-a26n. Decided under the write lock against the value this page loaded (its baseline): written only
            // while the row still holds what the field showed, so a change made elsewhere since is refused rather than
            // overwritten, and one made the same way is already applied. The rules were written first (aud-a28j), so a
            // refusal here is the secret's alone: recorded under its own section, the message saying the rules saved. Since
            // aud-a28r a change made before the save is refused, whole, by the compare ahead of the rules; one refused here
            // landed during this save.
            var outcome = await Task.Run(() => ProtectedPrincipalService.SaveDirectoryReadSecretId(loadedSecretId, secretId));
            if (outcome.Status is ModuleConfigSaveStatus.StoreCorrupt or ModuleConfigSaveStatus.ConcurrentChange)
            {
                var concurrent = outcome.Status == ModuleConfigSaveStatus.ConcurrentChange;
                var refusal = "The protection rules were saved and are in effect, but the directory-read credential (Delinea Secret ID) was not saved: "
                    + (concurrent
                        ? "it was changed after this page loaded it - by another administrator, or on the other instance. Reload the page and re-apply your change."
                        : "its setting could not be read as the save went to change it. " + SettingsStoreText.ModuleConfig(ProtectedPrincipalService.ProtectedPrincipalsModuleKey));
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, SecretSection, concurrent ? "ConcurrentChange" : "StoreCorrupt", refusal);
                return refusal;
            }

            try
            {
                Audit.LogSettingsChange(currentUser, ip, SecretSection, SecretValue(outcome.Before), SecretValue(outcome.After),
                    outcome.AlreadyApplied.Count > 0
                        ? new Dictionary<string, object?> { ["alreadyApplied"] = outcome.AlreadyApplied.ToArray() }
                        : null);
            }
            catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for the directory-read secret id change"); }

            var stored = outcome.After.GetValueOrDefault(ProtectedPrincipalService.DirectoryReadSecretConfigKey) ?? "";
            // aud-a41. The field takes the stored value only while it still holds what this save wrote; a value typed while the
            // write waited stays, counted unsaved against the new baseline.
            ppDirectoryReadSecretIdBaseline = stored;
            if (string.Equals(ppDirectoryReadSecretId.Trim(), secretId, StringComparison.Ordinal))
                ppDirectoryReadSecretId = stored;
            ppSecretFallbackId = ProtectedPrincipalService.DescribeDirectoryReadSecret(stored).FallbackInEffect;
            return null;
        }
        catch (Exception secretEx)
        {
            // aud-a40. A busy store is the secret's refusal - its write was not made - and the message says what landed.
            if (!ExchangeAdminWeb.Services.Storage.ConfigStoreBusy.IsBusy(secretEx))
                Logger.LogError(secretEx, "The directory-read secret id was not saved; the protection rules were");
            return Audit.LogSettingsSaveException(Logger, currentUser, ip, SecretSection, secretEx,
                $"The protection rules were saved and are in effect, but the directory-read credential (Delinea Secret ID) was not saved: {secretEx.Message} Save again to retry it.",
                busy: $"The protection rules were saved and are in effect, but the directory-read credential (Delinea Secret ID) was not saved: {SettingsSaveAudit.StoreBusyCause}. Save again to retry it.");
        }
    }

    private static string[] SecretValue(IReadOnlyDictionary<string, string> values) =>
        SecretValueOf(values, ProtectedPrincipalService.DirectoryReadSecretConfigKey);

    private static string[] SecretValueOf(IReadOnlyDictionary<string, string> values, string key) =>
        values.TryGetValue(key, out var value) && !string.IsNullOrWhiteSpace(value)
            ? [value.Trim()]
            : [];

    private const string GraphSecretSection = "ProtectedPrincipals:GraphDirectoryReadSecretId";

    /// <summary>
    /// Writes the Graph Directory Read Credential's Secret ID after the rules have been saved and records it under its own
    /// section, as <see cref="SaveDirectoryReadSecretAsync"/> does for the directory-read one. Null when it was saved;
    /// otherwise what the admin is told.
    /// </summary>
    private async Task<string?> SaveGraphReadSecretAsync(string loadedSecretId, string secretId, string ip)
    {
        try
        {
            var outcome = await Task.Run(() => ProtectedPrincipalService.SaveGraphDirectoryReadSecretId(loadedSecretId, secretId));
            if (outcome.Status is ModuleConfigSaveStatus.StoreCorrupt or ModuleConfigSaveStatus.ConcurrentChange)
            {
                var concurrent = outcome.Status == ModuleConfigSaveStatus.ConcurrentChange;
                var refusal = "The protection rules were saved and are in effect, but the Graph Directory Read Credential (Delinea Secret ID) was not saved: "
                    + (concurrent
                        ? "it was changed after this page loaded it - by another administrator, or on the other instance. Reload the page and re-apply your change."
                        : "its setting could not be read as the save went to change it. " + SettingsStoreText.ModuleConfig(ProtectedPrincipalService.ProtectedPrincipalsModuleKey));
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, GraphSecretSection, concurrent ? "ConcurrentChange" : "StoreCorrupt", refusal);
                return refusal;
            }

            try
            {
                Audit.LogSettingsChange(currentUser, ip, GraphSecretSection,
                    SecretValueOf(outcome.Before, ProtectedPrincipalService.GraphDirectoryReadSecretConfigKey),
                    SecretValueOf(outcome.After, ProtectedPrincipalService.GraphDirectoryReadSecretConfigKey),
                    outcome.AlreadyApplied.Count > 0
                        ? new Dictionary<string, object?> { ["alreadyApplied"] = outcome.AlreadyApplied.ToArray() }
                        : null);
            }
            catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for the Graph directory-read secret id change"); }

            var stored = outcome.After.GetValueOrDefault(ProtectedPrincipalService.GraphDirectoryReadSecretConfigKey) ?? "";
            // aud-a41: the field takes the stored value only while it still holds what this save wrote.
            ppGraphReadSecretIdBaseline = stored;
            if (string.Equals(ppGraphReadSecretId.Trim(), secretId, StringComparison.Ordinal))
                ppGraphReadSecretId = stored;
            return null;
        }
        catch (Exception secretEx)
        {
            if (!ExchangeAdminWeb.Services.Storage.ConfigStoreBusy.IsBusy(secretEx))
                Logger.LogError(secretEx, "The Graph directory-read secret id was not saved; the protection rules were");
            return Audit.LogSettingsSaveException(Logger, currentUser, ip, GraphSecretSection, secretEx,
                $"The protection rules were saved and are in effect, but the Graph Directory Read Credential (Delinea Secret ID) was not saved: {secretEx.Message} Save again to retry it.",
                busy: $"The protection rules were saved and are in effect, but the Graph Directory Read Credential (Delinea Secret ID) was not saved: {SettingsSaveAudit.StoreBusyCause}. Save again to retry it.");
        }
    }

    /// <summary>Every rule as <c>Kind:value</c>, so a settings-change record lists what was added and removed.</summary>
    private static string[] RuleEntries(ExchangeAdminWeb.Services.Storage.ProtectedPrincipalData? rules) =>
        rules is null
            ? []
            : rules.Users.Select(v => "Users:" + v)
                .Concat(rules.Groups.Select(v => "Groups:" + v))
                .Concat(rules.OrganizationalUnits.Select(v => "OUs:" + v))
                .Concat(rules.SamAccountNamePatterns.Select(v => "Patterns:" + v))
                .Concat(rules.GroupTargets.Select(v => "Targets:" + v))
                .Concat(rules.UserIds.Select(v => "UserIds:" + v))
                .Concat(rules.GroupIds.Select(v => "GroupIds:" + v))
                .Concat(rules.OuIds.Select(v => "OuIds:" + v))
                .ToArray();

    /// <summary>The entries a save of <paramref name="saved"/> added or removed against what the page loaded, as <c>Kind:value</c>.</summary>
    private string[] ChangedRuleEntries(ProtectedPrincipalConfig saved) =>
        ChangedEntries("Users", saved.Users, ppUsersBaseline)
            .Concat(ChangedEntries("Groups", saved.Groups, ppGroupsBaseline))
            .Concat(ChangedEntries("OUs", saved.OrganizationalUnits, ppOusBaseline))
            .Concat(ChangedEntries("Patterns", saved.SamAccountNamePatterns, ppPatternsBaseline))
            .Concat(ChangedEntries("Targets", saved.GroupTargets, ppTargetsBaseline))
            .Concat(ChangedEntries("UserIds", saved.UserIds, ppUserIdsBaseline))
            .Concat(ChangedEntries("GroupIds", saved.GroupIds, ppGroupIdsBaseline))
            .Concat(ChangedEntries("OuIds", saved.OuIds, ppOuIdsBaseline))
            .ToArray();

    // aud-a26s. Ordinal, as EntryDelta counts: an entry removed and added back in other casing, which the count shows as two
    // changes, is named as those two entries in an already-applied record, where it was named as nothing.
    private static IEnumerable<string> ChangedEntries(string kind, IEnumerable<string> current, IEnumerable<string> loaded) =>
        current.Except(loaded, StringComparer.Ordinal)
            .Concat(loaded.Except(current, StringComparer.Ordinal))
            .Select(v => kind + ":" + v);

    private static string RuleCounts(ExchangeAdminWeb.Services.Storage.ProtectedPrincipalData? rules) =>
        rules is null
            ? ""
            : $"Users:{rules.Users.Length},Groups:{rules.Groups.Length},OUs:{rules.OrganizationalUnits.Length},Patterns:{rules.SamAccountNamePatterns.Length},Targets:{rules.GroupTargets.Length},UserIds:{rules.UserIds.Length},GroupIds:{rules.GroupIds.Length},OuIds:{rules.OuIds.Length}";
}

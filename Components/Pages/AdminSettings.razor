    // Known Failure Class 5: what the button does and what it does not.
    internal const string VerifyButtonTip =
        "Ask Active Directory about every user, group, OU and group target stored here, read with the Directory Read Credential, "
        + "and mark each entry with what it found. Reads only: nothing is changed until you press an action beside an entry. "
        + "Patterns are not objects and are not verified. Not offered while this pane has unsaved changes.";

    internal const string VerifyPaneNote =
        "Verify marks each entry: verified; missing (the directory holds no such object); name changed (the object's current name "
        + "is not the one stored); not converted (stored by name only); several objects; wrong type; could not verify (the "
        + "directory could not be asked - never a sign the object is gone); or ignored. Beside each finding are its actions: "
        + "Rename, Convert or Replace to fix it, Remove now to delete the entry, and Ignore to keep it and stop the finding being "
        + "reported until what Verify sees changes. Each action is written at once, without Save, and audited. Verify proves the "
        + "object exists and is the right kind as read with the Directory Read Credential. An entry not converted, or one that "
        + "could not be verified, cannot be ignored. One ignore changes a protection check: a protected group the directory "
        + "confirms is gone stops refusing writes once it is ignored as missing. The check still looks the group up every time, "
        + "so a restored group protects again at once and a lookup that fails still refuses. Every other ignore changes only what "
        + "Verify reports.";

    /// <summary>The badge's text, Bootstrap class and hover for one finding (help: Known Failure Class 5).</summary>
    internal static (string Text, string Css, string Tip) VerifyBadgeParts(VerifyItemResult r, string verifiedAt)
    {
        var f = r.Finding;
        return f.Kind switch
        {
            VerifyFindingKind.Verified => ("verified", "text-bg-light text-muted border",
                $"Verified at {verifiedAt}: the object exists, is the right kind, and its name is the one stored."),
            VerifyFindingKind.Missing => ("missing", "bg-danger",
                "Active Directory answered and holds no object with this entry's identifier. The entry protects nothing. "
                + (r.Item.RowKey == KindGroupSid
                    ? "A missing protected group also refuses every write whose check finds no other match, naming it. "
                    : "")
                + "Replace it with the object it should name, Remove it, or Ignore it if you know why."),
            VerifyFindingKind.LabelDrift => ("name changed", "bg-warning text-dark",
                $"Stored as '{r.Item.Label}'; the object's current name is '{f.Detail}'. It still protects by its identifier. "
                + "Rename stores the current name, which is also what an older build sharing the database matches; "
                + "this build never compares names."),
            VerifyFindingKind.NotConverted => ("not converted", "bg-warning text-dark",
                "Stored by name only, so every protection check that finds no other match is refused, naming it, until it is "
                + $"converted. The directory says: {f.Resolution?.Detail ?? f.Detail}. Cannot be ignored."),
            VerifyFindingKind.Ambiguous => ("several objects", "bg-warning text-dark",
                $"More than one object answers for this entry: {f.Detail}. Replace it with the one it should name, or Remove it."),
            VerifyFindingKind.WrongClass => ("wrong type", "bg-danger",
                $"The object with this identifier is a {f.Detail}, not what this list holds. Replace it or Remove it."),
            VerifyFindingKind.Unreadable => ("could not verify", "bg-secondary",
                $"The directory could not be asked about this entry: {f.Detail}. This says nothing about the object; press Verify "
                + "again later. Cannot be ignored."),
            VerifyFindingKind.Ignored => ("ignored", "bg-secondary",
                $"{f.Underlying?.Kind} ({f.Underlying?.Observed}) ignored by {f.IgnoredBy?.By} at {f.IgnoredBy?.At}. Reported again "

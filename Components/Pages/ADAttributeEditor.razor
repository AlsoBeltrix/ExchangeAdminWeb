@page "/ad-attribute-editor"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "ADAttributeEditor")]
@rendermode InteractiveServer
@inject ADAttributeEditorService EditorService
@inject IActivityProgress Progress
@inject ProtectedPrincipalService ProtectedPrincipalService
@inject ProtectedPrincipalServicerService Servicers
@inject AuditService Audit
@inject EmailService Email
@inject OperationTraceService OperationTrace
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager Navigation
@inject ClientInfoService ClientInfo
@inject ILogger<ADAttributeEditor> Logger

<PageTitle>AD Attribute Editor</PageTitle>

@if (!authChecked)
{
    @* NO SPINNER. No module draws its own progress (owner ruling 2026-10-02,
       `.agents/decisions.md`), and nothing replaces this one: GroupAuthorizationHandler is
       synchronous end to end, so the check finishes faster than a frame and a bar line
       flickering inside a single render is noise, not information.
       The GUARD stays and must stay - it is what stops the page rendering before the check
       has passed, which is refusal, not progress. Kept at the SAME LINE COUNT as the markup
       it replaces, so not one ClickGateRegistry line key moves. *@
    return;
}

<div class="container-fluid">
    <div class="alert alert-info py-2 mb-3">
        <small>Edit allowlisted Active Directory attributes for on-premises user accounts.</small>
    </div>
    <h1 class="mb-4">AD Attribute Editor<ModuleVersion /></h1>

    @if (operationResult != null)
    {
        <div class="alert @(operationResult.Value.success ? "alert-success" : "alert-danger") alert-dismissible">
            @operationResult.Value.message
            <button type="button" class="btn-close" @onclick="() => operationResult = null"></button>
        </div>
    }

    <div class="row g-3">
        <div class="col-lg-8">
            <!-- Search -->
            <div class="card mb-3">
                <div class="card-body">
                    <div class="input-group">
                        <input type="text" class="form-control" @bind="searchIdentity" @bind:event="oninput"
                               @onkeydown="OnSearchKeyDown"
                               placeholder="UPN, email, sAMAccountName, or employee ID" disabled="@isLoading" />
                        <button class="btn btn-primary" @onclick="PerformSearch"
                                disabled="@(isLoading || string.IsNullOrWhiteSpace(searchIdentity))">
                            Search
                        </button>
                    </div>
                </div>
            </div>

            @if (searchError != null)
            {
                <div class="alert alert-danger">@searchError</div>
            }

            @if (protectedBlocked)
            {
                <div class="alert alert-warning">
                    <strong>Protected Principal:</strong> This user is protected and cannot be modified through this interface.
                </div>
            }

            @* An override is never silent: the operator must see they are acting under a grant,
               not discover it in the audit log afterwards. *@
            @if (protectedServiced)
            {
                <div class="alert alert-danger">
                    <strong>Protected Principal - override in effect:</strong> This user is protected.
                    You may edit them because your group is authorised to service protected principals
                    in this module. Every change you make here is recorded against that authorisation.
                </div>
            }

            @if (isReadOnly && lookupResult?.Principal != null)
            {
                <div class="alert alert-info">
                    <strong>Read-Only:</strong> @(lookupResult.ReadOnlyReason ?? "Cloud-only users cannot be edited in v1. Only on-premises AD users are supported.")
                </div>
            }

            <!-- Identity Summary -->
            @if (lookupResult?.Principal != null && !protectedBlocked)
            {
                <div class="card mb-3">
                    <div class="card-header"><strong>Identity</strong></div>
                    <div class="card-body py-2">
                        <div class="row">
                            <div class="col-sm-6"><small class="text-muted">Display Name</small><br />@lookupResult.Principal.DisplayName</div>
                            <div class="col-sm-6"><small class="text-muted">UPN</small><br />@lookupResult.Principal.UserPrincipalName</div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-sm-6"><small class="text-muted">sAMAccountName</small><br />@(lookupResult.Principal.SamAccountName ?? "—")</div>
                            <div class="col-sm-6"><small class="text-muted">Source</small><br />@lookupResult.SourceOfAuthority</div>
                        </div>
                    </div>
                </div>

                @if (!isReadOnly && editableAttributes.Count > 0)
                {
                    <!-- Attribute Grid -->
                    <div class="card mb-3">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <strong>Attributes</strong>
                            <small class="text-muted">@changedCount changed</small>
                        </div>
                        <div class="card-body p-0">
                            <div>
                                <table class="table table-sm mb-0">
                                    <thead>
                                        <tr>
                                            <th style="width: 200px;">Attribute</th>
                                            <th>Current</th>
                                            <th>New Value</th>
                                            <th style="width: 50px;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var attr in editableAttributes)
                                        {
                                            var isChanged = HasChanged(attr.Name);
                                            <tr class="@(isChanged ? "table-warning" : "")">
                                                <td title="@attr.Name">
                                                    @attr.Label
                                                    @if (!string.Equals(attr.Label, attr.Name, StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <br /><small class="text-muted">@attr.Name</small>
                                                    }
                                                </td>
                                                <td><small>@GetDisplayValue(attr, currentValues.GetValueOrDefault(attr.Name))</small></td>
                                                <td>
                                                    @{ var effectiveChoices = attr.Type == "Choice" ? EditorService.GetEffectiveChoices(attr) : null; }
                                                    @* aud-a26u: an attribute the editor cannot write shows why, in place of an input; SaveAsync refuses it too. *@
                                                    @if (readOnlyAttributes.TryGetValue(attr.Name, out var readOnlyReason))
                                                    {
                                                        <small class="text-muted">@readOnlyReason</small>
                                                    }
                                                    else if (effectiveChoices != null && effectiveChoices.Length > 0)
                                                    {
                                                        <select class="form-select form-select-sm"
                                                                value="@GetEditValue(attr.Name)"
                                                                @onchange="e => SetEditValue(attr.Name, e.Value?.ToString())"
                                                                disabled="@isSaving">
                                                            @if (attr.AllowClear || !attr.Required)
                                                            {
                                                                <option value="">— clear —</option>
                                                            }
                                                            @foreach (var choice in effectiveChoices)
                                                            {
                                                                <option value="@choice">@EditorService.GetChoiceDisplayText(attr.Name, choice)</option>
                                                            }
                                                        </select>
                                                    }
                                                    else
                                                    {
                                                        <input type="text" class="form-control form-control-sm"
                                                               value="@GetEditValue(attr.Name)"
                                                               @onchange="e => SetEditValue(attr.Name, e.Value?.ToString())"
                                                               maxlength="@(attr.MaxLength ?? 2048)"
                                                               disabled="@isSaving" />
                                                    }
                                                </td>
                                                <td>
                                                    @if (isChanged)
                                                    {
                                                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => ResetAttribute(attr.Name)" disabled="@isSaving" title="Reset">↺</button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Right Panel: Diff Preview / Save -->
        <div class="col-lg-4">
            <div class="card" style="position: sticky; top: 1rem;">
                @if (showDiffPreview && pendingChanges.Count > 0)
                {
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Confirm Changes</strong>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="CancelSave" disabled="@isSaving">Cancel</button>
                    </div>
                    <div class="card-body">
                        <div class="mb-3" style="max-height: 250px; overflow-y: auto;">
                            @foreach (var change in pendingChanges)
                            {
                                <div class="border-bottom pb-2 mb-2">
                                    <strong>@change.Label</strong> <small class="text-muted">(@change.Name)</small>
                                    <div><small class="text-danger">− @(change.OldValue ?? "<em>empty</em>")</small></div>
                                    <div><small class="text-success">+ @(change.NewValue ?? "<em>empty</em>")</small></div>
                                </div>
                            }
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Ticket Number</label>
                            <input type="text" class="form-control" @bind="ticketNumber" @bind:event="oninput" placeholder="INC/REQ number" disabled="@isSaving" />
                        </div>
                        <button class="btn btn-primary w-100" @onclick="ConfirmSave"
                                disabled="@(isSaving || string.IsNullOrWhiteSpace(ticketNumber))">
                            Save @pendingChanges.Count attribute(s)
                        </button>
                    </div>
                }
                else if (lookupResult?.Principal != null && !protectedBlocked && !isReadOnly && changedCount > 0)
                {
                    <div class="card-header"><strong>Review Changes</strong></div>
                    <div class="card-body">
                        <p class="text-muted mb-3">@changedCount attribute(s) modified. Review and save when ready.</p>
                        <button class="btn btn-primary w-100" @onclick="ShowPreview">Preview Changes</button>
                    </div>
                }
                else
                {
                    <div class="card-header"><strong>Actions</strong></div>
                    <div class="card-body">
                        <p class="text-muted mb-0">Search for a user, edit attributes, then save changes.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string currentUser = "";
    private string clientIpAddress = "Unknown";
    private bool authChecked;
    private bool isLoading;
    private bool isSaving;

    private string searchIdentity = "";
    private string? searchError;
    private bool protectedBlocked;

    /// <summary>Target is protected AND this operator holds the servicer grant for this module.</summary>
    private bool protectedServiced;

    /// <summary>Module id for the servicer grant. Must match the catalog descriptor and the service.</summary>
    private const string ServicerModuleId = "ADAttributeEditor";
    private bool isReadOnly;

    private AttributeLookupResult? lookupResult;
    private List<EditableAttribute> editableAttributes = new();
    private Dictionary<string, string?> currentValues = new();
    private Dictionary<string, string?> editValues = new();
    // aud-a26u. The lookup's read-only marks - an attribute holding several values or a binary value, by name, with the
    // reason shown in place of its input. Its edit value stays the lookup's, so it is never a change to save.
    private IReadOnlyDictionary<string, string> readOnlyAttributes = new Dictionary<string, string>();

    private bool showDiffPreview;
    private List<AttributeChange> pendingChanges = new();
    private string ticketNumber = "";
    private (bool success, string message)? operationResult;

    private int changedCount => editableAttributes.Count(a => HasChanged(a.Name));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUser = user.Identity?.Name ?? "Unknown";

        var authResult = await AuthorizationService.AuthorizeAsync(user, "ADAttributeEditor");
        if (!authResult.Succeeded)
        {
            Navigation.NavigateTo("access-denied", forceLoad: true);
            return;
        }

        clientIpAddress = ClientInfo.IpAddress != "Unknown"
            ? ClientInfo.IpAddress
            : ClientInfo.GetIpForUser(currentUser);
        authChecked = true;
    }

    private async Task OnSearchKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(searchIdentity) && !isLoading)
            await PerformSearch();
    }

    private async Task PerformSearch()
    {
        // kd-72. A second submit while a lookup runs is ignored, not run beside it: Enter checks isLoading and
        // the button is disabled on it, but the browser's copy of that is one round trip stale.
        if (isLoading) return;

        // kd-72. The identity this lookup is for, read once, above the yield below. The box binds on input,
        // so a keystroke landing in the yield changed the identity looked up and labelled.
        var identity = searchIdentity.Trim();

        isLoading = true;
        searchError = null;
        protectedBlocked = false;
        protectedServiced = false;
        isReadOnly = false;
        lookupResult = null;
        editableAttributes = new();
        currentValues = new();
        editValues = new();
        readOnlyAttributes = new Dictionary<string, string>();
        showDiffPreview = false;
        pendingChanges = new();
        operationResult = null;
        await Task.Yield();

        // Opened HERE, above the try, and completed in the finally. It used to open inside the
        // try and complete on the line after the lookup, which put the protected-principal check
        // below it outside the window: the frame read finished while the operator was still
        // waiting on that check (docs/ProgressCoverage-Plan.md S3, the eighth of the nine
        // partials). ConfirmSave on this page is the shape this copies.
        //
        // Completed from a LOCAL for a reason that is structural rather than a race: `result` is
        // declared inside the try and is out of scope in the finally. The race question was asked
        // anyway and the answer is no - searchError has no dismiss control in this page's markup
        // (the only btn-close nulls operationResult), this handler is its only writer, and both
        // entry points to it are gated on isLoading, which the finally drops with no await before
        // the Complete. A refusal that leaves `completed` null ends the activity as a non-success
        // with no message and the banner carries the reason, as ConfirmSave records.
        (bool success, string? message)? completed = null;
        using var activity = Progress.Begin(
            "AD Attribute Editor", $"Looking up {identity}", ActivitySize.Unknown);

        try
        {
            var result = await EditorService.LookupAsync(identity);

            if (!result.Success)
            {
                searchError = result.Error;
                completed = (false, result.Error);
                return;
            }

            lookupResult = result;

            if (result.IsReadOnly)
            {
                isReadOnly = true;
                // A successful lookup that lands on a read-only view, not a refusal: the frame
                // must not read "This did not finish." for an operation that did.
                completed = (true, null);
                return;
            }

            var protectionCheck = await ProtectedPrincipalService.CheckAsync(result.Principal!);
            if (protectionCheck.CheckFailed)
            {
                searchError = protectionCheck.Reason;
                completed = (false, protectionCheck.Reason);
                return;
            }

            // This gate HIDES the edit UI, so it is part of the authorization decision, not a
            // display detail: if it blocks where the service would allow, the servicer capability
            // is unreachable and the service-side grant silently does nothing (pps-2). It must
            // therefore ask the same question ADAttributeEditorService.SaveAsync asks, with the
            // same module id, and reach the same answer.
            //
            // Protection is evaluated first and never weakened. A null principal refuses, and the
            // service re-decides independently before the write - this does not authorise anything
            // on its own.
            if (protectionCheck.IsProtected)
            {
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var servicedNote = ProtectedPrincipalServicing.NoteFor(
                    Servicers, authState.User, ServicerModuleId, protectionCheck.MatchedRules);

                if (servicedNote is null)
                {
                    protectedBlocked = true;
                    return;
                }

                protectedServiced = true;
            }

            var maxLevel = await DetermineMaxLevelAsync();
            var allowlist = EditorService.GetAllowlistForLevel(maxLevel);
            if (allowlist == null)
            {
                searchError = "Attribute allowlist is corrupt. Contact your administrator.";
                completed = (false, searchError);
                return;
            }
            if (allowlist.Count == 0 && maxLevel == 0)
            {
                searchError = "You do not have permission to edit any attributes. Contact your administrator.";
                completed = (false, searchError);
                return;
            }

            editableAttributes = allowlist;
            currentValues = result.CurrentValues ?? new();
            editValues = new Dictionary<string, string?>(currentValues, StringComparer.OrdinalIgnoreCase);
            readOnlyAttributes = result.ReadOnlyAttributes ?? new Dictionary<string, string>();
            completed = (true, null);
        }
        catch (Exception ex)
        {
            searchError = ex.Message;
            completed = (false, ex.Message);
            Logger.LogError(ex, "AD attribute lookup failed for {Identity}", identity);
        }
        finally
        {
            isLoading = false;
            // Below everything, because the protected-principal check the old Complete sat above
            // is the last call in this handler that can leave the machine: it reads the config
            // store, and when protected GROUP rules are configured it resolves group membership
            // against the directory. DetermineMaxLevelAsync and GetAllowlistForLevel below it
            // were read and are local.
            activity.Complete(completed?.success ?? false, completed?.message);
        }
    }

    private bool HasChanged(string name)
    {
        var current = currentValues.GetValueOrDefault(name);
        var edit = editValues.GetValueOrDefault(name);
        var currentNorm = string.IsNullOrEmpty(current) ? null : current;
        var editNorm = string.IsNullOrEmpty(edit) ? null : edit;
        return !string.Equals(currentNorm, editNorm, StringComparison.Ordinal);
    }

    private string GetEditValue(string name) => editValues.GetValueOrDefault(name) ?? "";

    private void SetEditValue(string name, string? value)
    {
        editValues[name] = string.IsNullOrEmpty(value) ? null : value;
    }

    private async Task<int> DetermineMaxLevelAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        int maxLevel = 0;
        if ((await AuthorizationService.AuthorizeAsync(user, "ADAttributeEditorLevel3")).Succeeded) maxLevel = 3;
        else if ((await AuthorizationService.AuthorizeAsync(user, "ADAttributeEditorLevel2")).Succeeded) maxLevel = 2;
        else if ((await AuthorizationService.AuthorizeAsync(user, "ADAttributeEditorLevel1")).Succeeded) maxLevel = 1;
        return maxLevel;
    }

    private string GetDisplayValue(EditableAttribute attr, string? value)
    {
        if (string.IsNullOrEmpty(value)) return "(empty)";
        if (attr.Type == "Choice")
            return EditorService.GetChoiceDisplayText(attr.Name, value);
        return value;
    }

    private void ResetAttribute(string name)
    {
        editValues[name] = currentValues.GetValueOrDefault(name);
    }

    private void ShowPreview()
    {
        pendingChanges = editableAttributes
            .Where(a => HasChanged(a.Name))
            .Select(a => new AttributeChange(a.Name, a.Label, currentValues.GetValueOrDefault(a.Name), editValues.GetValueOrDefault(a.Name)))
            .ToList();
        showDiffPreview = true;
    }

    private void CancelSave()
    {
        showDiffPreview = false;
        pendingChanges = new();
    }

    private async Task ConfirmSave()
    {
        // kd-72. A second confirm while a save runs is ignored, not run beside it: the button is disabled while
        // isSaving, but the browser's copy of that is one round trip stale.
        if (isSaving) return;

        isSaving = true;

        // Read before the first await, because the success branch below empties pendingChanges
        // while this handler is still running and the label must not change under the operator.
        var saveTarget = lookupResult?.Principal?.UserPrincipalName ?? searchIdentity.Trim();
        var changeCount = pendingChanges.Count;

        // kd-72. The ticket too: the box binds on input, and it was read after the yield - into both refusal
        // records, SaveAsync's audit row and notice, and the catch's record and email.
        var ticket = ticketNumber.Trim();

        // Audit finding A14. The PRINCIPAL too, not just its label. A search running
        // concurrently nulls lookupResult and then replaces it with a different user, and
        // every use below sat after an await - so the write itself could be aimed at B while
        // the operator was reviewing A, and the message and the admin email would name B.
        var target = lookupResult?.Principal;

        // Review of A14: the CHANGES too. A concurrent search clears pendingChanges, and
        // proposedValues was built from the live collection after the yield - so a search
        // landing in that window turned a real save into "successfully updated 0 attributes",
        // and emptied the list the notification then named (SaveAsync names its own: aud-a26b).
        var changes = pendingChanges.ToList();
        if (target is null)
        {
            isSaving = false;
            operationResult = (false, "Look the user up again before saving.");
            // aud-a28g. A refused attempt like any other, and one SaveAsync - which records every
            // result it returns - never sees, so the page records it. There is no principal to name,
            // hence "(none)", as aud-a28d's undo refusals without a target record it.
            EditorService.LogSaveRefused(null, currentUser, clientIpAddress, ticket, "Lookup", operationResult.Value.message);
            return;
        }

        await Task.Yield();

        // Opened HERE, above the try, so the authorization refusal inside it is covered too, and
        // completed in the finally, after SaveAsync - which sends the
        // notification email itself (aud-a26b) - so the bar does not read Idle while an email is
        // still in flight. NamedLocations.SaveLocation is the shape this copies.
        //
        // Completed from a LOCAL, never from operationResult. That field has a dismiss control
        // in this page's own banner markup (a bare @onclick that nulls it), and it stays
        // clickable while this handler is suspended at the write or at an email await, so
        // reading the field down in the finally is the post-await live-read trap
        // ClickGateRegistry records against NamedLocations - with a live control here to spring
        // it. OutOfOffice.SetOof completes from its field instead, and says in place that this
        // is why: that page renders no dismiss.
        //
        // Two steps, because the sequence is fixed once the operation proceeds: permission, then
        // the AD write with the notification SaveAsync sends for it. A refusal completes early at
        // the step it reached, which is what happened, not a lie about size.
        (bool success, string message)? completed = null;
        using var activity = Progress.Begin(
            "AD Attribute Editor",
            $"Saving {changeCount} attribute change(s) for {saveTarget}",
            ActivitySize.Steps(2));

        try
        {
            activity.Step("checking your permission");
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authCheck = await AuthorizationService.AuthorizeAsync(authState.User, "ADAttributeEditor");
            if (!authCheck.Succeeded)
            {
                operationResult = (false, "Authorization denied.");
                // aud-a28g. The re-check stays here because the page holds the principal, so the
                // page records its refusal: SaveAsync is never reached.
                EditorService.LogSaveRefused(target, currentUser, clientIpAddress, ticket, "Authorization", operationResult.Value.message);
                return;
            }

            // The level is worked out here and enforced by SaveAsync. The corrupt-allowlist and
            // above-level refusals the page used to make itself, with no record, are SaveAsync's
            // (aud-a28g): it sees the same allowlist and level, records the refusal and announces it.
            var saveMaxLevel = await DetermineMaxLevelAsync();

            var proposedValues = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
            foreach (var change in changes)
                proposedValues[change.Name] = change.NewValue;

            // aud-a26b: SaveAsync announces its own result - a write, a refusal or a failed write -
            // so neither branch below sends a notice. Only the catch does, for an exception
            // SaveAsync never returns.
            activity.Step("writing the attributes to Active Directory and notifying administrators");
            var result = await EditorService.SaveAsync(target, proposedValues, currentUser, clientIpAddress, ticket, actingUser: authState.User, maxLevel: saveMaxLevel);

            if (result.Success)
            {
                operationResult = completed = (true, $"Successfully updated {result.AppliedChanges?.Count ?? 0} attribute(s) for {target.DisplayName}.");

                showDiffPreview = false;
                pendingChanges = new();
                ticketNumber = "";

                // A14: only write the applied values back if the panel is still showing the user
                // they were applied to. A search that landed during the save has already
                // replaced it, and populating B's form with A's new values is the half of this
                // finding an operator would act on without noticing.
                // Compared by immutable id, not by reference. Review of A14 caught the first
                // version using ReferenceEquals: every successful lookup builds a NEW principal
                // instance, and search stays enabled during a save, so re-searching the SAME
                // account made this false and the page kept showing the old values while
                // reporting success. The question is "is the panel showing this account", and
                // only the GUID answers it.
                var shown = lookupResult?.Principal;
                var stillShowingTarget =
                    shown is not null
                    && !string.IsNullOrWhiteSpace(shown.ObjectGuid)
                    && !string.IsNullOrWhiteSpace(target.ObjectGuid)
                    && string.Equals(shown.ObjectGuid, target.ObjectGuid, StringComparison.OrdinalIgnoreCase);

                if (result.AppliedChanges != null && stillShowingTarget)
                {
                    foreach (var change in result.AppliedChanges)
                        currentValues[change.Name] = change.NewValue;
                    editValues = new Dictionary<string, string?>(currentValues, StringComparer.OrdinalIgnoreCase);
                }
            }
            else
            {
                operationResult = completed = (false, result.Error ?? "Save failed.");
            }
        }
        catch (Exception ex)
        {
            operationResult = completed = (false, ex.Message);
            Logger.LogError(ex, "AD attribute save failed");
            // aud-a28g. The record for an exception SaveAsync did not return - it records every result
            // it does return, so this is never a second record for one attempt. Not a refusal: the
            // write may have been reached.
            EditorService.LogSaveFailed(target, currentUser, clientIpAddress, ticket, ex.Message);
            // The page's one remaining notice: an exception, which SaveAsync never returns.
            try { await Email.SendAdminNotificationAsync(currentUser, clientIpAddress, "ADAttributeEditor_Update", false, ticket, new Dictionary<string, string> { ["Target"] = target.UserPrincipalName }, ex.Message); } catch { }
        }
        finally
        {
            isSaving = false;
            activity.Complete(completed?.success ?? false, completed?.message);
        }
    }
}

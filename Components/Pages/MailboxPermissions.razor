@page "/mailbox-permissions"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "MailboxPermissions")]
@rendermode InteractiveServer
@inject MailboxPermissionService MailboxService
@inject AuditService Audit
@inject EmailService Email
@inject PermissionValidator Validator
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager Navigation
@inject ClientInfoService ClientInfo
@inject IJSRuntime JS
@inject IConfiguration Config
@inject ServiceNowService ServiceNow
@inject ILogger<ExchangeAdminWeb.Components.Pages.MailboxPermissions> Logger

<PageTitle>Mailbox Permissions</PageTitle>

<div class="container-fluid">
    <div class="alert alert-info py-2 mb-3">
        <small>All permission changes are logged for audit purposes.@if (bool.Parse(Config["Email:NotifyUsersOnPermissionGrant"] ?? "false")){<text> Affected users will receive email notifications when permissions are granted or removed.</text>}</small>
    </div>
    <h1 class="mb-4">Mailbox Permissions<ModuleVersion /></h1>

    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <button class="nav-link @(tabIndex == 0 ? "active" : "")" @onclick="() => SetTab(0)" disabled="@IsBusy">Add</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(tabIndex == 1 ? "active" : "")" @onclick="() => SetTab(1)" disabled="@IsBusy">Remove</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(tabIndex == 2 ? "active" : "")" @onclick="() => SetTab(2)" disabled="@IsBusy">Bulk Upload</button>
        </li>
    </ul>

    @if (tabIndex < 2)
    {
        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Permissions</label>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkFullAccess" @bind="grantFullAccess" disabled="@IsBusy" />
                                <label class="form-check-label" for="chkFullAccess">Full Access</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkSendAs" @bind="grantSendAs" disabled="@IsBusy" />
                                <label class="form-check-label" for="chkSendAs">Send As</label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Target Mailbox</label>
                            <RecipientAutocomplete @bind-Value="targetMailbox"
                                                   Placeholder="mailbox@domain.com or SamAccountName"
                                                   Disabled="@IsBusy" />
                            <div class="form-text">SMTP, UPN, or SamAccountName accepted</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">User</label>
                            <RecipientAutocomplete @bind-Value="affectedUser"
                                                   Placeholder="user@domain.com or SamAccountName"
                                                   Disabled="@IsBusy" />
                            <div class="form-text">SMTP, UPN, or SamAccountName accepted</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold" for="ticketNumber">Ticket Number <span class="text-danger">*</span></label>
                            <input id="ticketNumber" class="form-control" type="text"
                                   placeholder="INC0001234 or REQ0005678"
                                   @bind="ticketNumber" @bind:event="oninput" disabled="@IsBusy" />
                            <div class="form-text">Service request or incident ticket number</div>
                        </div>

                        @if (tabIndex == 0 && grantFullAccess)
                        {
                            <div class="mb-3 form-check">
                                <input class="form-check-input" type="checkbox" id="chkAutoMap" @bind="autoMapping" disabled="@IsBusy" />
                                <label class="form-check-label" for="chkAutoMap">
                                    AutoMapping <span class="text-muted">(auto-add to Outlook)</span>
                                </label>
                            </div>
                        }

                        <button class="btn btn-primary" @onclick="SubmitSingle" disabled="@(IsBusy || !IsFormValid)">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            }
                            @(tabIndex == 0 ? "Add Permissions" : "Remove Permissions")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Bulk @(bulkIsAdd ? "Add" : "Remove") Permissions</h5>
                        <p class="text-muted">Upload a CSV file with the following columns:</p>
                        <ul class="small text-muted">
                            <li><code>Target</code> - Mailbox (SMTP, UPN, or SamAccountName)</li>
                            <li><code>User</code> - User to grant/revoke access (SMTP, UPN, or SamAccountName)</li>
                            <li><code>FullAccess</code> - True/False</li>
                            <li><code>SendAs</code> - True/False</li>
                            <li><code>AutoMapping</code> - (optional) True/False (defaults to True)</li>
                        </ul>

                        <div class="mb-3 btn-group" role="group">
                            <input type="radio" class="btn-check" name="bulkAction" id="radioAdd" checked="@bulkIsAdd" @onchange="() => bulkIsAdd = true" disabled="@IsBusy" />
                            <label class="btn btn-outline-primary" for="radioAdd">Add</label>
                            <input type="radio" class="btn-check" name="bulkAction" id="radioRemove" checked="@(!bulkIsAdd)" @onchange="() => bulkIsAdd = false" disabled="@IsBusy" />
                            <label class="btn btn-outline-primary" for="radioRemove">Remove</label>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold" for="bulkTicket">Ticket Number (applies to all rows) <span class="text-danger">*</span></label>
                            <input id="bulkTicket" class="form-control" type="text"
                                   placeholder="INC0001234 or REQ0005678"
                                   @bind="bulkTicketNumber" @bind:event="oninput" disabled="@IsBusy" />
                        </div>

                        <div class="mb-3">
                            <label for="csvFile" class="form-label fw-semibold">CSV File</label>
                            <InputFile id="csvFile" class="form-control" OnChange="HandleCsvUpload" accept=".csv" disabled="@IsBusy" />
                            <button type="button" class="btn btn-outline-secondary btn-sm mt-1" @onclick="DownloadSampleCsv">Sample CSV</button>
                        </div>

                        <button class="btn btn-primary" @onclick="ProcessBulk" disabled="@(IsBusy || csvFile is null || string.IsNullOrWhiteSpace(bulkTicketNumber))">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            }
                            Process CSV
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (onPremConfirmPending)
    {
        <div class="row mt-3">
            <div class="col-md-8">
                <div class="alert alert-warning" role="alert">
                    <strong>@onPremTarget</strong> is an on-premises mailbox. This will execute against the on-prem Exchange server.
                    <div class="mt-2">
                        <button class="btn btn-warning btn-sm me-2" @onclick="ConfirmOnPrem" disabled="@IsBusy">
                            @if (isLoading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Continue
                        </button>
                        <button class="btn btn-secondary btn-sm" @onclick="CancelOnPrem">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (result is not null)
    {
        <div class="row mt-3">
            <div class="col-md-8">
                <div class="alert @(result.Success ? "alert-success" : "alert-danger") alert-dismissible" role="alert">
                    <strong>@(result.Success ? "Success" : "Error"):</strong> @result.Message
                    @if (!string.IsNullOrEmpty(result.Detail))
                    {
                        <div class="mt-1"><small>@result.Detail</small></div>
                    }
                    <button type="button" class="btn-close" @onclick="() => result = null" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    @if (bulkResult is not null)
    {
        <div class="row mt-3">
            <div class="col-md-8">
                <div class="alert @(bulkResult.FailedCount == 0 ? "alert-success" : "alert-warning") alert-dismissible">
                    <h5 class="alert-heading">Bulk Operation Complete</h5>
                    <p><strong>@bulkResult.Summary</strong></p>
                    <div class="mb-2">
                        <button class="btn btn-sm btn-primary" @onclick="DownloadCsvReport" disabled="@IsBusy">
                            Download Full Report (CSV)
                        </button>
                    </div>
                    @if (bulkResult.Errors.Any())
                    {
                        <hr />
                        <p class="mb-1"><strong>Errors:</strong></p>
                        <ul class="mb-0 small">
                            @foreach (var err in bulkResult.Errors.Take(20))
                            {
                                <li>@err</li>
                            }
                            @if (bulkResult.Errors.Count > 20)
                            {
                                <li class="text-muted">... and @(bulkResult.Errors.Count - 20) more</li>
                            }
                        </ul>
                    }
                    <button type="button" class="btn-close" @onclick="() => bulkResult = null" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private int tabIndex = 0;
    private bool grantFullAccess = true;
    private bool grantSendAs = false;
    private string targetMailbox = string.Empty;
    private string affectedUser = string.Empty;
    private string ticketNumber = string.Empty;
    private bool autoMapping = true;
    private bool isLoading = false;
    private PermissionResult? result;
    private string currentUser = string.Empty;
    private string clientIpAddress = "Unknown";

    private bool bulkIsAdd = true;
    private string bulkTicketNumber = string.Empty;
    private IBrowserFile? csvFile;
    private BulkOperationResult? bulkResult;

    // The page-wide busy predicate (owner ruling 2026-09-17; docs/ClickGatingAudit-Plan.md
    // Revision 1). One flag is all this page owns, and one predicate is right for it: the tab
    // strip, the single-mailbox form, the bulk form and the on-prem confirmation all render off
    // the same state at the same time, and every write handler replaces part of that state. There
    // is no view here that is safe to leave live while another is working, which is what made a
    // single predicate wrong on SelfServiceGroups and ConferenceRooms and right here.
    //
    // Every control reads IsBusy rather than isLoading so that a second flag - a future lookup, a
    // background refresh - reaches every control by editing one line. The per-button spinners
    // deliberately keep reading isLoading; see the SpinnerExpressions note on this page's
    // ClickGateRegistry entry.
    private bool IsBusy => isLoading;

    private bool IsFormValid =>
        !string.IsNullOrWhiteSpace(targetMailbox) &&
        !string.IsNullOrWhiteSpace(affectedUser) &&
        !string.IsNullOrWhiteSpace(ticketNumber) &&
        (grantFullAccess || grantSendAs);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUser = user.Identity?.Name ?? "Unknown";

        // CRITICAL: Explicitly check authorization - [Authorize] attribute is not reliably enforced
        var authResult = await AuthorizationService.AuthorizeAsync(user, "MailboxPermissions");
        if (!authResult.Succeeded)
        {
            Navigation.NavigateTo("access-denied", forceLoad: true);
            return;
        }

        // Try scoped instance first, then fall back to cached value
        clientIpAddress = ClientInfo.IpAddress != "Unknown"
            ? ClientInfo.IpAddress
            : ClientInfo.GetIpForUser(currentUser);
    }

    private bool onPremConfirmPending;
    private string? onPremTarget;
    private string? onPremUser;
    private string? onPremTicket;
    private bool onPremFullAccess;
    private bool onPremSendAs;

    private void SetTab(int index)
    {
        tabIndex = index;
        result = null;
        bulkResult = null;
        onPremConfirmPending = false;
    }

    private async Task ConfirmOnPrem()
    {
        // This method owns the on-prem refusal, and ExecuteOnPrem - the worker it calls - must
        // never grow one of its own. Exactly one guard, here, for the reason recorded on this
        // page's ClickGateRegistry entry: a second guard in ExecuteOnPrem is redundant today and
        // becomes a silent no-op the moment this method raises the flag before calling, which is
        // the obvious next "improvement". The on-prem write would simply not happen and nothing -
        // banner, audit row, admin email - would say so.
        //
        // Two conditions, refusing two different things.
        //   IsBusy is the click gate. The Continue button carries disabled="@IsBusy", but the
        //   browser's copy of that attribute is one round trip stale, so a second Continue can
        //   still be dispatched while the first on-prem write is in flight - and that runs the
        //   destructive write twice.
        //   !onPremConfirmPending is the staleness gate. SetTab and CancelOnPrem both clear it, so
        //   a Continue that left the browser before the confirmation panel unrendered is refused
        //   rather than executing a staged Add against a tab the operator has since flipped to
        //   Remove. ExecuteOnPrem reads tabIndex at its own entry, so without this the direction
        //   could differ from the one the operator confirmed.
        if (IsBusy || !onPremConfirmPending)
            return;

        onPremConfirmPending = false;
        await ExecuteOnPrem();
    }

    private void CancelOnPrem()
    {
        onPremConfirmPending = false;
        onPremTarget = null;
    }

    private async Task<bool> ReauthorizeAsync()
    {
        // Re-check authorization immediately before the write: a user removed
        // from the section group (or whose module was disabled) mid-session
        // must not keep mutating over the live circuit.
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var authCheck = await AuthorizationService.AuthorizeAsync(authState.User, "MailboxPermissions");
        if (!authCheck.Succeeded)
        {
            result = PermissionResult.Fail("Authorization denied.");
            return false;
        }
        return true;
    }

    /// <summary>Module id for the servicer grant. Must match the catalog descriptor.</summary>
    private const string ServicerModuleId = "MailboxPermissions";

    // Set when an authorised servicer overrode a protected-principal refusal, and carried into the
    // SUCCESS audit. Assigned on every validation so one serviced action cannot label the next.
    private string? servicedNote;

    private async Task SubmitSingle()
    {
        // Captured above the first await, and above the try, because every one of these fields has
        // a live control behind it. The controls now carry disabled on IsBusy, but the browser's
        // copy of that attribute is one round trip stale, and on the two autocompletes it does not
        // reach the suggestion rows at all - see this page's ClickGateRegistry entry.
        //
        // tabIndex is the sharp one, and the reason falsification 6 names this page. It chose
        // between Add and Remove AFTER the awaits, so a tab click landing mid-write revoked the
        // permission the operator had asked to grant, and mislabelled the audit row and both
        // notification emails on the way past.
        var isAdd = tabIndex == 0;
        var target = targetMailbox.Trim();
        var user = affectedUser.Trim();
        var ticket = ticketNumber.Trim();
        var fullAccess = grantFullAccess;
        var sendAs = grantSendAs;
        var autoMap = autoMapping;

        isLoading = true;
        result = null;
        await Task.Yield();

        // The try opens here, immediately below the raise, rather than below the preflight. An
        // await between a raise and its try has no finally behind it: a throw or an unbounded stall
        // in the re-authorization, the ticket validation or the protected-principal check used to
        // leave isLoading true, and under a page-wide predicate that is a dead page rather than one
        // dead button. The early returns below therefore no longer clear the flag themselves.
        try
        {
            if (!await ReauthorizeAsync())
                return;

            var ticketValidation = await ServiceNow.ValidateTicketAsync(ticket);
            if (!ticketValidation.IsValid)
            {
                result = PermissionResult.Fail($"Ticket validation failed: {ticketValidation.Message}");
                return;
            }

            // ServicerModuleId is passed explicitly. This validator also serves Calendar and Out of
            // Office, so a shared or borrowed id would let a grant in one module authorise the others.
            // Read here: this check runs before the authorization re-check that creates `authState`,
            // and the servicer decision must be made against the current token wherever it is asked.
            var validationAuthState = await AuthStateProvider.GetAuthenticationStateAsync();
            var validation = await Validator.ValidateTargetMailboxAsync(target, validationAuthState.User, ServicerModuleId);
            servicedNote = validation.ServicedNote;
            var validationError = validation.Error;
            if (validationError is not null)
            {
                result = PermissionResult.Fail(validationError);
                try
                {
                    var perms = new List<string>();
                    if (fullAccess) perms.Add("FullAccess");
                    if (sendAs) perms.Add("SendAs");
                    Audit.LogMailboxPermission(
                        currentUser, clientIpAddress, $"{(isAdd ? "Add" : "Remove")}_Denied", target, user,
                        string.Join("+", perms), false, ticket, errorDetail: validationError);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to write audit for protected-target denial on {Target}", target);
                }
                return;
            }

            // Validate self-grant (only for Add operations)
            if (isAdd)
            {
                var selfGrantError = await Validator.ValidateSelfGrantAsync(currentUser, user);
                if (selfGrantError is not null)
                {
                    // Log self-grant attempt to audit log
                    var perms = new List<string>();
                    if (fullAccess) perms.Add("FullAccess");
                    if (sendAs) perms.Add("SendAs");
                    var permType = string.Join("+", perms);
                    var ipAddress = clientIpAddress;

                    try
                    {
                        Audit.LogMailboxPermission(
                            currentUser, ipAddress, $"Add{permType}_SelfGrantAttempt", target, user, permType,
                            false, ticket, autoMap,
                            errorDetail: "Self-grant blocked: User attempted to grant permissions to themselves");
                    }
                    catch (Exception ex)
                    {
                        result = PermissionResult.Fail($"Self-grant blocked, but audit logging failed: {ex.Message}");
                        return;
                    }

                    result = PermissionResult.Fail(selfGrantError);
                    return;
                }
            }

            try
            {
                var location = await MailboxService.GetMailboxLocationAsync(target);
                if (location == "Unknown")
                {
                    result = PermissionResult.Fail($"Could not determine mailbox location for {target}. No cloud mailbox, on-prem mailbox, or on-prem remote mailbox was found.");
                    return;
                }

                if (location == "OnPrem")
                {
                    var onPremAuth = await AuthorizationService.AuthorizeAsync(
                        (await AuthStateProvider.GetAuthenticationStateAsync()).User, "MailboxPermissionsOnPrem");
                    if (!onPremAuth.Succeeded)
                    {
                        result = PermissionResult.Fail($"{target} is an on-premises mailbox. Please escalate this ticket to the Exchange team.");
                        return;
                    }

                    onPremTarget = target;
                    onPremUser = user;
                    onPremTicket = ticket;
                    onPremFullAccess = fullAccess;
                    onPremSendAs = sendAs;
                    onPremConfirmPending = true;
                    return;
                }

                var opResult = isAdd
                    ? await MailboxService.AddMailboxPermissionsAsync(target, user, fullAccess, sendAs, autoMap)
                    : await MailboxService.RemoveMailboxPermissionsAsync(target, user, fullAccess, sendAs);

                var perms = new List<string>();
                if (fullAccess) perms.Add("FullAccess");
                if (sendAs) perms.Add("SendAs");
                var permType = string.Join("+", perms);
                var action = $"{(isAdd ? "Add" : "Remove")}{permType}";
                var ipAddress = clientIpAddress;

                // The serviced note rides `extra`: this is the SUCCESS path, and LogMailboxPermission
                // drops errorDetail on success, so the field explaining why a protected mailbox could
                // be modified would vanish exactly when it matters.
                Audit.LogMailboxPermission(
                    currentUser, ipAddress, action, target, user, permType,
                    opResult.Success, ticket,
                    autoMapping: isAdd && fullAccess ? autoMap : null,
                    errorDetail: opResult.Success ? null : opResult.Message,
                    extra: ProtectedPrincipalServicing.Extra(servicedNote));

                // Send admin notification
                await Email.SendAdminNotificationAsync(
                    currentUser, ipAddress, action, target, user, permType,
                    opResult.Success, ticket, opResult.Success ? null : opResult.Message);

                // Send notifications to both the user being granted access and the mailbox owner
                if (opResult.Success)
                {
                    var isGrant = isAdd;
                    // Notify the user being granted/removed access
                    await Email.SendUserNotificationAsync(user, target, currentUser, permType, isGrant);
                    // Notify the mailbox owner
                    await Email.SendOwnerNotificationAsync(target, user, currentUser, permType, isGrant);
                }

                result = opResult;
            }
            catch (Exception ex)
            {
                result = PermissionResult.Fail($"Operation may have succeeded but audit logging failed: {ex.Message}");
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task HandleCsvUpload(InputFileChangeEventArgs e)
    {
        csvFile = e.File;
        bulkResult = null;
        return Task.CompletedTask;
    }

    private async Task ProcessBulk()
    {
        // Two separate reasons for the shape of this opening, and they pull in opposite directions.
        //
        // The captures: csvFile, bulkIsAdd and bulkTicketNumber each have a live control behind them
        // - the file picker, the two radios and the ticket box - and each was read back after the
        // awaits. A file picked mid-run put the NEW file's name in the audit row and the admin email
        // against the OLD file's results; a radio flipped mid-run sent the CSV through the opposite
        // operation entirely.
        //
        // The ordering: the raise must stay BELOW the empty-file return. isLoading is a member of a
        // page-wide predicate, so a raise above that guard is never lowered and would deaden every
        // control on the page, permanently, rather than greying one button.
        var file = csvFile;
        if (file is null) return;

        var isAdd = bulkIsAdd;
        var ticket = bulkTicketNumber.Trim();
        var ipAddress = clientIpAddress;

        isLoading = true;
        bulkResult = null;
        await Task.Yield();

        // The try opens above the re-authorization for the reason given on SubmitSingle: an await
        // between the raise and the try has no finally behind it.
        try
        {
            if (!await ReauthorizeAsync())
                return;

            var ticketValidation = await ServiceNow.ValidateTicketAsync(ticket);
            if (!ticketValidation.IsValid)
            {
                result = PermissionResult.Fail($"Ticket validation failed: {ticketValidation.Message}");
                return;
            }

            await using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            // The re-authorised principal, so a servicer's CSV row is serviced exactly as their
            // single-target submit would be (pps-1).
            var bulkAuthState = await AuthStateProvider.GetAuthenticationStateAsync();
            // Held in a local and published to the field, never read back off it: the banner dismiss
            // is exempt from the gate and can null bulkResult while this handler is suspended, and
            // every read below would then throw into the catch and report a bulk run that succeeded
            // as a failure.
            var bulk = await MailboxService.ProcessMailboxPermissionsCsvAsync(stream, isAdd, Validator, currentUser, Audit, ipAddress, ticket, bulkAuthState.User);
            bulkResult = bulk;

            var action = isAdd ? "BulkAdd" : "BulkRemove";

            try
            {
                Audit.LogMailboxPermission(
                    currentUser, ipAddress, action, "Bulk", file.Name,
                    "Multiple", bulk.FailedCount == 0, ticket,
                    errorDetail: bulk.FailedCount > 0 ? $"{bulk.FailedCount} failures" : null);
            }
            catch (Exception ex)
            {
                result = PermissionResult.Fail($"Bulk operations completed ({bulk.Summary}) but summary audit logging failed: {ex.Message}");
            }

            await Email.SendAdminNotificationAsync(
                currentUser, ipAddress, action, "Bulk Operation", file.Name,
                $"{bulk.TotalRows} rows", bulk.FailedCount == 0, ticket,
                bulk.FailedCount > 0 ? $"{bulk.FailedCount} failures" : null);
        }
        catch (Exception ex)
        {
            result = PermissionResult.Fail(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ExecuteOnPrem()
    {
        // No busy guard here, and there must never be one. ConfirmOnPrem owns the refusal for this
        // pair and is the only caller; a second guard here is redundant today and becomes a silent
        // no-op the moment ConfirmOnPrem raises the flag before calling. Registered as a
        // ForbiddenGuardSite on this page's ClickGateRegistry entry.
        isLoading = true;
        result = null;

        var target = onPremTarget!;
        var user = onPremUser!;
        var ticket = onPremTicket!;
        var fullAccess = onPremFullAccess;
        var sendAs = onPremSendAs;

        // tabIndex captured once rather than read at each use. It was read three more times below,
        // all after awaits, and it chooses between Add and Remove: a tab click landing mid-write
        // reversed the on-prem operation and desynced the audit rows from the action string
        // computed here at entry. target is the other half of the same problem - Cancel nulls
        // onPremTarget while this handler is suspended, and the catch below audits it.
        var isAdd = tabIndex == 0;

        var perms = new List<string>();
        if (fullAccess) perms.Add("FullAccess");
        if (sendAs) perms.Add("SendAs");
        var permType = string.Join("+", perms);
        var action = $"OnPrem_{(isAdd ? "Add" : "Remove")}{permType}";
        await Task.Yield();

        try
        {
            var authCheck = await AuthorizationService.AuthorizeAsync(
                (await AuthStateProvider.GetAuthenticationStateAsync()).User, "MailboxPermissionsOnPrem");
            if (!authCheck.Succeeded)
            {
                result = PermissionResult.Fail("Authorization denied for on-prem operations.");
                return;
            }

            // Re-validate IMMEDIATELY BEFORE the write, not once before the confirmation prompt.
            // This handler re-enters after the operator confirms a dialog, which is an unbounded
            // pause: the earlier verdict may be arbitrarily stale, and the Constitution requires
            // the protection check immediately before the write regardless (pps-1). It also
            // produces the serviced note this path had no way to audit.
            var onPremAuthState = await AuthStateProvider.GetAuthenticationStateAsync();
            var onPremValidation = await Validator.ValidateTargetMailboxAsync(
                target, onPremAuthState.User, ServicerModuleId);
            if (onPremValidation.Error is not null)
            {
                result = PermissionResult.Fail(onPremValidation.Error);
                Audit.LogMailboxPermission(
                    currentUser, clientIpAddress, action, target, user, permType,
                    false, ticket, errorDetail: onPremValidation.Error);
                return;
            }

            var onPremExtra = ProtectedPrincipalServicing.Extra(onPremValidation.ServicedNote);

            var opResult = isAdd
                ? await MailboxService.AddMailboxPermissionsOnPremAsync(target, user, fullAccess, sendAs)
                : await MailboxService.RemoveMailboxPermissionsOnPremAsync(target, user, fullAccess, sendAs);

            var actionVerb = isAdd ? "Add" : "Remove";
            var succeeded = opResult.Detail?.Split(',', StringSplitOptions.TrimEntries) ?? Array.Empty<string>();

            if (fullAccess)
            {
                var faSuccess = opResult.Success || succeeded.Contains("FullAccess");
                Audit.LogMailboxPermission(currentUser, clientIpAddress, $"OnPrem_{actionVerb}FullAccess", target, user, "FullAccess",
                    faSuccess, ticket, errorDetail: faSuccess ? null : opResult.Message, extra: onPremExtra);
            }
            if (sendAs)
            {
                var saSuccess = opResult.Success || succeeded.Contains("SendAs");
                Audit.LogMailboxPermission(currentUser, clientIpAddress, $"OnPrem_{actionVerb}SendAs", target, user, "SendAs",
                    saSuccess, ticket, errorDetail: saSuccess ? null : opResult.Message, extra: onPremExtra);
            }

            var isPartial = !opResult.Success && succeeded.Length > 0;
            await Email.SendAdminNotificationAsync(
                currentUser, clientIpAddress, isPartial ? $"{action}_PARTIAL" : action, target, user, permType,
                opResult.Success, ticket, opResult.Success ? null : opResult.Message);

            if (opResult.Success || succeeded.Length > 0)
            {
                var isGrant = isAdd;
                var notifyPerm = string.Join("+", succeeded.Length > 0 ? succeeded : new[] { permType });
                await Email.SendUserNotificationAsync(user, target, currentUser, notifyPerm, isGrant);
                await Email.SendOwnerNotificationAsync(target, user, currentUser, notifyPerm, isGrant);
            }

            result = opResult;
        }
        catch (Exception ex)
        {
            Audit.LogMailboxPermission(
                currentUser, clientIpAddress, action, target, user, permType,
                false, ticket, errorDetail: ex.Message);
            result = PermissionResult.Fail(ex.Message);
        }
        finally
        {
            isLoading = false;
            onPremTarget = null;
        }
    }

    private async Task DownloadCsvReport()
    {
        if (bulkResult is null) return;

        var csvBytes = bulkResult.GenerateCsvReport();
        var base64 = Convert.ToBase64String(csvBytes);
        var timestamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
        var filename = $"mailbox_permissions_report_{timestamp}.csv";

        await JS.InvokeVoidAsync("downloadFile", filename, "text/csv", base64);
    }

    private async Task DownloadSampleCsv()
    {
        var content = "Target,User,FullAccess,SendAs,AutoMapping\nhelpdesk@company.com,john.doe@company.com,True,True,True\n";
        var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(content));
        await JS.InvokeVoidAsync("downloadFile", "mailbox_permissions_sample.csv", "text/csv", base64);
    }

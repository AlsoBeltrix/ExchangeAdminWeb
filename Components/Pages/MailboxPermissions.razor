    private async Task ProcessBulk()
    {
        // Two separate reasons for the shape of this opening, and they pull in opposite directions.
        //
        // The captures: csvFile, bulkIsAdd and bulkTicketNumber each have a live control behind them
        // - the file picker, the two radios and the ticket box - and each was read back after the
        // awaits. A file picked mid-run put the NEW file's name in the audit row and the admin email
        // against the OLD file's results; a radio flipped mid-run sent the CSV through the opposite
        // operation entirely.
        //
        // The ordering: the raise must stay BELOW the empty-file return. isLoading is a member of a
        // page-wide predicate, so a raise above that guard is never lowered and would deaden every
        // control on the page, permanently, rather than greying one button.
        var file = csvFile;
        if (file is null) return;

        var isAdd = bulkIsAdd;
        var ticket = bulkTicketNumber.Trim();
        var ipAddress = clientIpAddress;
        string RefusedAt(string refusal, string step) => SelfGrantRefusalRecord.Banner(refusal, () => Audit.LogMailboxPermission(currentUser, ipAddress, isAdd ? "BulkAdd" : "BulkRemove", "Bulk", file.Name, "Multiple", false, ticket, errorDetail: refusal, extra: SelfGrantRefusalRecord.RefusalExtra(step)), Logger, "Bulk", SelfGrantRefusalRecord.RefusedChangeRecord); // kd-40: a refusal before the file is read is the run's own Failed row, nothing attempted
        isLoading = true;
        bulkResult = null;
        await Task.Yield();

        // One activity for the whole CSV run, opened before the try so the re-authorization and
        // ticket refusals inside it are covered too.
        using var bulkActivity = Progress.Begin(
            "Mailbox Permissions", "Processing the permissions CSV", ActivitySize.Unknown);

        // Hoisted so the finally can complete the activity from the LOCAL. Completing from
        // bulkResult is a post-await live read - the dismiss control at line 212 can null it
        // while this handler is suspended - which ClickGateRegistry records for this page and
        // which failed three assertions when written that way.
        BulkOperationResult? completedBulk = null;

        // The try opens above the re-authorization for the reason given on SubmitSingle: an await
        // between the raise and the try has no finally behind it.
        try
        {
            if (await ReauthorizeAsync() is { } denied)
            { result = PermissionResult.Fail(RefusedAt(denied, SelfGrantRefusalRecord.AuthorizationRefusalStep)); return; } // kd-40: recorded

            var ticketValidation = SelfGrantRefusalRecord.MissingTicket(ticket) ?? await ServiceNow.ValidateTicketAsync(ticket); // kd-18: presence first, as SubmitSingle's
            if (!ticketValidation.IsValid)
            {
                result = PermissionResult.Fail(RefusedAt(SelfGrantRefusalRecord.TicketRefused(ticketValidation.Message), SelfGrantRefusalRecord.TicketRefusalStep)); // kd-40: recorded
                return;
            }

            await using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            // The re-authorised principal, so a servicer's CSV row is serviced exactly as their
            // single-target submit would be (pps-1).
            var bulkAuthState = await AuthStateProvider.GetAuthenticationStateAsync();
            // Held in a local and published to the field, never read back off it: the banner dismiss
            // is exempt from the gate and can null bulkResult while this handler is suspended, and
            // every read below would then throw into the catch and report a bulk run that succeeded
            // as a failure.
            var bulk = await MailboxService.ProcessMailboxPermissionsCsvAsync(stream, isAdd, Validator, currentUser, Audit, Email, ipAddress, ticket, bulkAuthState.User);
            bulkResult = bulk;
            completedBulk = bulk;

            var action = isAdd ? "BulkAdd" : "BulkRemove";

            try
            {
                Audit.LogMailboxPermission(
                    currentUser, ipAddress, action, "Bulk", file.Name,
                    "Multiple", bulk.FailedCount == 0, ticket,
                    errorDetail: bulk.FailedCount > 0 ? $"{bulk.FailedCount} failures" : null);
            }
            catch (Exception ex)
            {
                result = PermissionResult.Fail($"Bulk operations completed ({bulk.Summary}) but summary audit logging failed: {ex.Message}");
            }

            await Email.SendAdminNotificationAsync(
                currentUser, ipAddress, action, "Bulk Operation", file.Name,
                $"{bulk.TotalRows} rows", bulk.FailedCount == 0, ticket,
                bulk.FailedCount > 0 ? $"{bulk.FailedCount} failures" : null);
        }
        catch (Exception ex)
        {
            result = PermissionResult.Fail(ex.Message);
        }
        finally
        {
            isLoading = false;
            bulkActivity.Complete(completedBulk != null, completedBulk == null ? "The CSV run did not complete." : null);
        }
    }

    private async Task ExecuteOnPrem()
    {
        // No busy guard here, and there must never be one. ConfirmOnPrem owns the refusal for this
        // pair and is the only caller; a second guard here is redundant today and becomes a silent
        // no-op the moment ConfirmOnPrem raises the flag before calling. Registered as a
        // ForbiddenGuardSite on this page's ClickGateRegistry entry.
        isLoading = true;
        result = null;

        // The on-prem write is its own operation and its own wait - SubmitSingle has already
        // returned by the time the operator confirms, so its activity is long gone.
        using var onPremActivity = Progress.Begin(
            "Mailbox Permissions", $"Updating on-premises permissions on {onPremTarget}", ActivitySize.Unknown);

        var target = onPremTarget!;
        var user = onPremUser!;
        var ticket = onPremTicket!;
        var fullAccess = onPremFullAccess;
        var sendAs = onPremSendAs;

        // tabIndex captured once rather than read at each use. It was read three more times below,
        // all after awaits, and it chooses between Add and Remove: a tab click landing mid-write
        // reversed the on-prem operation and desynced the audit rows from the action string
        // computed here at entry. target is the other half of the same problem - Cancel nulls
        // onPremTarget while this handler is suspended, and the catch below audits it.
        var isAdd = tabIndex == 0;

        var perms = new List<string>();
        if (fullAccess) perms.Add("FullAccess");
        if (sendAs) perms.Add("SendAs");
        var permType = string.Join("+", perms);
        var action = $"OnPrem_{(isAdd ? "Add" : "Remove")}{permType}";
        await Task.Yield();

        // The activity is completed from this local, never from the result field (review finding
        // prog-7). The dismiss control at :179 stays clickable while the page is busy and nulls
        // result; the exemption registered for it in ClickGateRegistry holds only while no handler
        // reads the field back, and the finally below did. A local cannot be nulled from the UI, so
        // the progress panel reports THIS operation's outcome by construction rather than because
        // no await happens to sit between the last write and the read.
        PermissionResult? outcome = null; Dictionary<string, object?>? onPremExtra = null; // aud-a70 (4): what the write is bound to and the servicer note, for the catch's row as for the success rows
        var step = PermissionChangeFailure.BeforeTheWrite; // aud-a59: the stage a throw in the try below came from
        try
        {
            var authCheck = await AuthorizationService.AuthorizeAsync(
                (await AuthStateProvider.GetAuthenticationStateAsync()).User, "MailboxPermissionsOnPrem");
            if (!authCheck.Succeeded)
            {
                result = outcome = PermissionResult.Fail(SelfGrantRefusalRecord.Banner(SelfGrantRefusalRecord.OnPremNotAuthorized, () => Audit.LogMailboxPermission(currentUser, clientIpAddress, action, target, user, permType, false, ticket, errorDetail: SelfGrantRefusalRecord.OnPremNotAuthorized), Logger, target, SelfGrantRefusalRecord.RefusedChangeRecord)); // aud-a70 (5): recorded, as SubmitSingle's refusals before the write are
                return;
            }

            // Re-validate IMMEDIATELY BEFORE the write, not once before the confirmation prompt.
            // This handler re-enters after the operator confirms a dialog, which is an unbounded
            // pause: the earlier verdict may be arbitrarily stale, and the Constitution requires
            // the protection check immediately before the write regardless (pps-1). It also
            // produces the serviced note this path had no way to audit.
            var onPremAuthState = await AuthStateProvider.GetAuthenticationStateAsync();
            var onPremValidation = await Validator.ValidateTargetMailboxAsync(
                target, onPremAuthState.User, ServicerModuleId);
            if (onPremValidation.Error is not null)
            {
                var denial = onPremValidation.Error;
                result = outcome = PermissionResult.Fail(SelfGrantRefusalRecord.Banner(denial, () => Audit.LogMailboxPermission(
                    currentUser, clientIpAddress, action, target, user, permType,
                    false, ticket, errorDetail: denial), Logger, target, SelfGrantRefusalRecord.DenialRecord));
                return;
            }
            if (isAdd && await Validator.ValidateSelfGrantAsync(onPremAuthState.User, user) is { } selfGrantError) { result = outcome = PermissionResult.Fail(SelfGrantRefusalRecord.Banner(SelfGrantRefusalRecord.AtWrite(selfGrantError), () => Audit.LogMailboxPermission(currentUser, clientIpAddress, $"Add{permType}_SelfGrantAttemptAtWrite", target, user, permType, false, ticket, errorDetail: selfGrantError), Logger, target)); return; }
            onPremExtra = ValidatedMailbox.WithWrittenIdentity(ProtectedPrincipalServicing.Extra(onPremValidation.ServicedNote), onPremValidation.Mailbox);
            step = PermissionChangeFailure.TheWrite;
            var opResult = isAdd
                ? await MailboxService.AddMailboxPermissionsOnPremAsync(target, onPremValidation.Mailbox, user, fullAccess, sendAs)
                : await MailboxService.RemoveMailboxPermissionsOnPremAsync(target, onPremValidation.Mailbox, user, fullAccess, sendAs);
            step = PermissionChangeFailure.AfterTheWrite;
            var actionVerb = isAdd ? "Add" : "Remove"; var rowsWritten = true; // aud-a70 (1): whether every row of the change was written
            // aud-a23b: rights come from AppliedRights, never from Detail (on a cloud grant, Detail is the OWA link).
            var applied = opResult.AppliedRights ?? [];
            if (fullAccess)
            {
                var faSuccess = opResult.Success || applied.Contains("FullAccess");
                rowsWritten &= SelfGrantRefusalRecord.Recorded(() => Audit.LogMailboxPermission(currentUser, clientIpAddress, $"OnPrem_{actionVerb}FullAccess", target, user, "FullAccess",
                    faSuccess, ticket, errorDetail: faSuccess ? null : opResult.Message, extra: onPremExtra, filedAs: PermissionChangeFailure.FiledAs(opResult, "FullAccess")), Logger, target, SelfGrantRefusalRecord.OnPremChangeRecord); // aud-a70 (1): in its own guard - a throw is logged and the change's result stands; (14): an unconfirmed right's row is Undetermined
            }
            if (sendAs)
            {
                var saSuccess = opResult.Success || applied.Contains("SendAs");
                rowsWritten &= SelfGrantRefusalRecord.Recorded(() => Audit.LogMailboxPermission(currentUser, clientIpAddress, $"OnPrem_{actionVerb}SendAs", target, user, "SendAs",
                    saSuccess, ticket, errorDetail: saSuccess ? null : opResult.Message, extra: onPremExtra, filedAs: PermissionChangeFailure.FiledAs(opResult, "SendAs")), Logger, target, SelfGrantRefusalRecord.OnPremChangeRecord);
            }

            var isPartial = !opResult.Success && applied.Count > 0;
            try { await Email.SendAdminNotificationAsync(
                currentUser, clientIpAddress, opResult.Unconfirmed ? action + PermissionChangeNotifier.UnconfirmedSuffix : isPartial ? $"{action}_PARTIAL" : action, target, user, permType,
                opResult.Success, ticket, opResult.Success ? null : opResult.Message); } catch (Exception notifyEx) { Logger.LogWarning(notifyEx, "The administrator notification for {Target} could not be sent; the change stands", target); }

            if (opResult.Success || applied.Count > 0)
            {
                var isGrant = isAdd;
                var notifyPerm = string.Join("+", applied.Count > 0 ? applied : new[] { permType });
                try { await Email.SendUserNotificationAsync(user, target, currentUser, notifyPerm, isGrant); } catch (Exception notifyEx) { Logger.LogWarning(notifyEx, "The notification to {User} of the change on {Target} could not be sent; the change stands", user, target); }
                try { await Email.SendOwnerNotificationAsync(target, user, currentUser, notifyPerm, isGrant); } catch (Exception notifyEx) { Logger.LogWarning(notifyEx, "The notification to the owner of {Target} could not be sent; the change stands", target); }
            }

            result = outcome = SelfGrantRefusalRecord.Said(opResult, rowsWritten);
        }
        catch (Exception ex)
        {
            step = PermissionChangeFailure.StageOf(step, ex); var failure = PermissionChangeFailure.Banner(step, ex); Logger.LogWarning(ex, "The on-premises permission change on {Target} failed at {Step}", target, step); // aud-a76: a write the service says was never sent is the connection's failure - Failed, nothing written
            result = outcome = PermissionResult.Fail(SelfGrantRefusalRecord.Banner(failure, () => Audit.LogMailboxPermission(
                currentUser, clientIpAddress, action, target, user, permType,
                false, ticket, errorDetail: failure, extra: onPremExtra, filedAs: PermissionChangeFailure.AuditResultOf(step)), Logger, target, SelfGrantRefusalRecord.FailedChangeRecord)); await PermissionChangeNotifier.NotifyAdminIfUnconfirmedAsync(PermissionChangeFailure.AuditResultOf(step), Email, currentUser, clientIpAddress, action, target, user, permType, ticket, failure, Logger); // aud-a70 (15): an Undetermined change tells the administrators; aud-a75: a write that threw is filed Undetermined, a throw before or after it Failed (aud-a73); aud-a70 (4): with the identity written and the servicer note
        }
        finally
        {
            isLoading = false;
            try { onPremActivity.Complete(outcome?.Success ?? false, outcome?.Message); } catch (Exception completeEx) { Logger.LogWarning(completeEx, "The progress of the on-premises change on {Target} could not be completed; the result stands", target); } // aud-a70 (9): nor here, ahead of the staged target's reset
            onPremTarget = null;
        }
    }

    /// <summary>
    /// Exports the bulk run's per-row outcomes as a CSV.
    /// </summary>
    /// <remarks>
    /// The NINTH copy of the silent CSV-export shape and the twin of
    /// CalendarPermissions.DownloadCsvReport, which landed one commit ago. The two handlers are
    /// the same method with a different filename, and so are the two fixes; everything the twin's
    /// comment says applies here unchanged. With this one the shape really is closed.
    ///
    /// The settled two-pin form: GenerateCsvReport( opens, JS.InvokeVoidAsync( closes, the
    /// Complete sits below the transfer, ActivitySize.Unknown with the row count in the LABEL,
    /// and an await Task.Yield() because the projection, the per-field sanitiser and both encodes
    /// are synchronous and the only await was the transfer AFTER all of them.
    ///
    /// THE SNAPSHOT IS FORCED BY THE YIELD and forced twice over, exactly as on the twin: this
    /// handler never raises isLoading, so IsBusy is false for the whole export, and the result
    /// banner's dismiss at :212 is @onclick="() => bulkResult = null" with no disabled attribute.
    /// A dismiss queued while the bar paints would otherwise make the export throw on a null -
    /// review finding prog-9.
    /// </remarks>
    private async Task DownloadCsvReport()
    {
        if (bulkResult is null) return;

        var report = bulkResult;

        using var activity = Progress.Begin(
            "Mailbox Permissions",
            $"Exporting {report.Entries.Count:N0} result row(s) to CSV",
            ActivitySize.Unknown);

        await Task.Yield();

        var csvBytes = report.GenerateCsvReport();
        var base64 = Convert.ToBase64String(csvBytes);
        var timestamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
        var filename = $"mailbox_permissions_report_{timestamp}.csv";

        await JS.InvokeVoidAsync("downloadFile", filename, "text/csv", base64);

        // Below the transfer, the settled order. The transfer MECHANISM is deliberately
        // untouched - docs/DownloadMemoryRetention-Plan.md is a DRAFT. Reads the captured local.
        activity.Complete(true, $"{report.Entries.Count:N0} result row(s) exported.");
    }

    private async Task DownloadSampleCsv()
    {
        var content = "Target,User,FullAccess,SendAs,AutoMapping\nhelpdesk@company.com,john.doe@company.com,True,True,True\n";
        var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(content));
        await JS.InvokeVoidAsync("downloadFile", "mailbox_permissions_sample.csv", "text/csv", base64);
    }

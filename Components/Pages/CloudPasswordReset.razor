@page "/cloud-password-reset"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "CloudPasswordReset")]
@rendermode InteractiveServer
@inject CloudPasswordResetService ResetService
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager Navigation
@inject ClientInfoService ClientInfo
@inject ILogger<CloudPasswordReset> Logger

<PageTitle>Cloud Password Reset</PageTitle>

@if (!authChecked)
{
    <div class="container-fluid">
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Checking authorization...</span>
            </div>
        </div>
    </div>
    return;
}

<div class="container-fluid">
    <div class="alert alert-info py-2 mb-3">
        <small>All password resets are logged for audit purposes. The new password is emailed to the account's owner and is not shown here.</small>
    </div>
    <h1 class="mb-4">Cloud Password Reset<ModuleVersion /></h1>

    @if (!ResetService.IsAvailable)
    {
        <div class="alert alert-danger">Microsoft Graph is not configured for this module. Contact your administrator.</div>
        return;
    }

    <div class="border rounded p-3 mb-3">
        <div class="row g-3 align-items-end">
            <div class="col-lg-6">
                <label class="form-label">Cloud account (UPN)</label>
                <input class="form-control" @bind="upnInput" @bind:event="oninput"
                       placeholder="user@tenant.onmicrosoft.com" disabled="@isBusy" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" @onclick="LookupAsync"
                        disabled="@(isBusy || string.IsNullOrWhiteSpace(upnInput))">
                    @(isBusy ? "Checking..." : "Check account")
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (target is not null)
    {
        <div class="border rounded p-3 mb-3">
            <h5 class="mb-3">Preflight</h5>
            <table class="adm-tbl mb-3">
                <tbody>
                    <tr><td><strong>Account</strong></td><td>@target.UserPrincipalName</td></tr>
                    <tr><td><strong>Display name</strong></td><td>@target.DisplayName</td></tr>
                    <tr><td><strong>Enabled</strong></td><td>@(target.AccountEnabled ? "Yes" : "No")</td></tr>
                    <tr><td><strong>Cloud-only</strong></td><td>Yes</td></tr>
                    <tr>
                        <td><strong>Directory roles</strong></td>
                        <td>@(target.DirectoryRoles.Count == 0 ? "None active" : string.Join(", ", target.DirectoryRoles))</td>
                    </tr>
                    <tr><td><strong>Employee ID</strong></td><td>@(string.IsNullOrWhiteSpace(target.EmployeeId) ? "Not set" : target.EmployeeId)</td></tr>
                    <tr>
                        <td><strong>Password goes to</strong></td>
                        <td>
                            @if (destination is not null && destination.Resolved)
                            {
                                <span>@destination.Address</span>
                                @if (!string.IsNullOrWhiteSpace(destination.OwnerDisplayName))
                                {
                                    <span class="text-muted"> (@destination.OwnerDisplayName)</span>
                                }
                            }
                            else
                            {
                                <span class="text-danger">@DestinationRefusalText(destination?.Refusal)</span>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>

            @* No destination control of any kind. The recipient is derived from the account's
               employee ID and the operator cannot influence it (plan AC3). A text box here, even
               a read-only one, is the defect this design exists to remove. *@

            <div class="row g-3 align-items-end">
                <div class="col-lg-4">
                    <label class="form-label">Ticket number</label>
                    <input class="form-control" @bind="ticketInput" @bind:event="oninput" disabled="@isBusy" />
                </div>
                <div class="col-lg-8">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="forceChange"
                               @bind="forceChangeAtNextSignIn" disabled="@isBusy" />
                        <label class="form-check-label" for="forceChange">
                            Force password change at next sign-in
                        </label>
                    </div>
                    @if (!forceChangeAtNextSignIn)
                    {
                        <div class="form-text text-danger">
                            This is a security risk. You MUST walk the user through a manual reset and confirm it's been reset before closing the ticket.
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool authChecked;
    private bool isBusy;
    private string upnInput = "";
    private string ticketInput = "";
    private string errorMessage = "";

    // Checked by default, owner ruling 2026-09-23. The password travels by email, so forcing a
    // change makes it a one-time handover rather than a standing credential sitting in a mailbox.
    private bool forceChangeAtNextSignIn = true;

    private CloudPasswordTarget? target;
    private CloudPasswordDestination? destination;

    private string currentUser = "";
    private string clientIpAddress = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUser = user.Identity?.Name ?? "Unknown";
        clientIpAddress = ClientInfo.IpAddress != "Unknown"
            ? ClientInfo.IpAddress
            : ClientInfo.GetIpForUser(currentUser);

        var authResult = await AuthorizationService.AuthorizeAsync(user, "CloudPasswordReset");
        if (!authResult.Succeeded)
        {
            Navigation.NavigateTo("access-denied", forceLoad: true);
            return;
        }

        authChecked = true;
    }

    private async Task LookupAsync()
    {
        if (isBusy || string.IsNullOrWhiteSpace(upnInput)) return;

        isBusy = true;
        errorMessage = "";
        target = null;
        destination = null;

        try
        {
            var (resolved, refusal, message) = await ResetService.ResolveTargetAsync(upnInput.Trim());

            if (resolved is null)
            {
                errorMessage = message;
                Logger.LogWarning("Cloud password reset preflight refused for {Operator}: {Refusal}", currentUser, refusal);
                return;
            }

            target = resolved;
            destination = ResetService.DeriveDestination(resolved);
        }
        catch (Exception ex)
        {
            // Sanitized: the UI never shows raw exception detail (Developer Guide, UI Standards).
            Logger.LogError(ex, "Cloud password reset preflight failed for {Operator}", currentUser);
            errorMessage = "The account could not be checked. See the event log for detail.";
        }
        finally
        {
            isBusy = false;
        }
    }

    /// <summary>
    /// The operator-facing sentence for a destination that did not resolve.
    /// </summary>
    /// <remarks>
    /// Each one says what is wrong with the ACCOUNT rather than what the module did, because the
    /// operator's next step differs per case: an unset employee ID is a directory fix, two matches
    /// is a data-quality escalation, and an unreachable directory is wait-and-retry.
    /// </remarks>
    private static string DestinationRefusalText(CloudPasswordResetRefusal? refusal) => refusal switch
    {
        CloudPasswordResetRefusal.DestinationNoEmployeeId =>
            "No employee ID is set on this account, so its owner cannot be identified.",
        CloudPasswordResetRefusal.DestinationNoMatch =>
            "No directory account carries this employee ID.",
        CloudPasswordResetRefusal.DestinationAmbiguous =>
            "More than one directory account carries this employee ID, so the owner is not certain.",
        CloudPasswordResetRefusal.DestinationNoMailbox =>
            "The owner was found but has no mailbox to send to.",
        CloudPasswordResetRefusal.DestinationLookupFailed =>
            "The directory could not be searched, so the owner is unknown. Try again shortly.",
        _ => "The owner could not be determined.",
    };
}

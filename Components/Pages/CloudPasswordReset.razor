@page "/cloud-password-reset"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "CloudPasswordReset")]
@rendermode InteractiveServer
@inject CloudPasswordResetService ResetService
@inject AuditService Audit
@inject EmailService Email
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager Navigation
@inject ClientInfoService ClientInfo
@inject ILogger<CloudPasswordReset> Logger
@inject ProtectedPrincipalService ProtectedPrincipalService
@inject ProtectedPrincipalServicerService Servicers

<PageTitle>Cloud Password Reset</PageTitle>

@if (!authChecked)
{
    <div class="container-fluid">
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Checking authorization...</span>
            </div>
        </div>
    </div>
    return;
}

<div class="container-fluid">
    <div class="alert alert-info py-2 mb-3">
        <small>All password resets are logged for audit purposes. The new password is emailed to the account's owner and is not shown here.</small>
    </div>
    <h1 class="mb-4">Cloud Password Reset<ModuleVersion /></h1>

    @if (!ResetService.IsAvailable)
    {
        <div class="alert alert-danger">Microsoft Graph is not configured for this module. Contact your administrator.</div>
        return;
    }

    <div class="border rounded p-3 mb-3">
        <div class="row g-3 align-items-end">
            <div class="col-lg-6">
                <label class="form-label">Cloud account (UPN)</label>
                <input class="form-control" @bind="upnInput" @bind:event="oninput"
                       placeholder="user@tenant.onmicrosoft.com" disabled="@isBusy" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" @onclick="LookupAsync"
                        disabled="@(isBusy || string.IsNullOrWhiteSpace(upnInput))">
                    @(isBusy ? "Checking..." : "Check account")
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (target is not null)
    {
        <div class="border rounded p-3 mb-3">
            <h5 class="mb-3">Preflight</h5>
            <table class="adm-tbl mb-3">
                <tbody>
                    <tr><td><strong>Account</strong></td><td>@target.UserPrincipalName</td></tr>
                    <tr><td><strong>Display name</strong></td><td>@target.DisplayName</td></tr>
                    <tr><td><strong>Enabled</strong></td><td>@(target.AccountEnabled ? "Yes" : "No")</td></tr>
                    <tr><td><strong>Cloud-only</strong></td><td>Yes</td></tr>
                    <tr>
                        <td><strong>Directory roles</strong></td>
                        <td>
                            @if (target.DirectoryRolesReadFailed)
                            {
                                @* Not "None active". The read failed, so the role state was never
                                   established, and this panel is what an operator looks at before
                                   resetting what may be a Global Administrator. *@
                                <span class="text-warning">Could not be read</span>
                            }
                            else if (target.DirectoryRoles.Count == 0)
                            {
                                <span>None active</span>
                            }
                            else
                            {
                                <span>@string.Join(", ", target.DirectoryRoles)</span>
                            }
                        </td>
                    </tr>
                    <tr><td><strong>Employee ID</strong></td><td>@(string.IsNullOrWhiteSpace(target.EmployeeId) ? "Not set" : target.EmployeeId)</td></tr>
                    <tr>
                        <td><strong>Password goes to</strong></td>
                        <td>
                            @if (destination is not null && destination.Resolved)
                            {
                                <span>@destination.Address</span>
                                @if (!string.IsNullOrWhiteSpace(destination.OwnerDisplayName))
                                {
                                    <span class="text-muted"> (@destination.OwnerDisplayName)</span>
                                }
                            }
                            else
                            {
                                <span class="text-danger">@DestinationRefusalText(destination?.Refusal)</span>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>

            @* No destination control of any kind. The recipient is derived from the account's
               employee ID and the operator cannot influence it (plan AC3). A text box here, even
               a read-only one, is the defect this design exists to remove. *@

            <div class="row g-3 align-items-end">
                <div class="col-lg-4">
                    <label class="form-label">Ticket number</label>
                    <input class="form-control" @bind="ticketInput" @bind:event="oninput" disabled="@isBusy" />
                </div>
                <div class="col-lg-8">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="forceChange"
                               @bind="forceChangeAtNextSignIn" disabled="@isBusy" />
                        <label class="form-check-label" for="forceChange">
                            Force password change at next sign-in
                        </label>
                    </div>
                    @if (!forceChangeAtNextSignIn)
                    {
                        <div class="form-text text-danger">
                            This is a security risk. You MUST walk the user through a manual reset and confirm it's been reset before closing the ticket.
                        </div>
                    }
                </div>
            </div>

            <div class="mt-3">
                @if (!resetConfirmPending)
                {
                    <button class="btn btn-danger" @onclick="() => resetConfirmPending = true"
                            disabled="@(isBusy || !CanReset)">
                        Reset password
                    </button>
                    @if (!CanReset && !isBusy)
                    {
                        <div class="form-text text-muted">@WhyResetUnavailable()</div>
                    }
                }
                else
                {
                    <div class="alert alert-warning py-2">
                        <div class="mb-2">
                            Reset the password for <strong>@target.UserPrincipalName</strong>?
                            @if (destination is not null && destination.Resolved)
                            {
                                <span>The new password will be emailed to <strong>@destination.Address</strong>.</span>
                            }
                            else
                            {
                                <span>The new password will be shown on screen once and not emailed.</span>
                            }
                        </div>
                        <button class="btn btn-danger me-2" @onclick="ExecuteResetAsync" disabled="@(isBusy || !CanReset)">Confirm reset</button>
                        <button class="btn btn-secondary" @onclick="() => resetConfirmPending = false" disabled="@isBusy">Cancel</button>
                    </div>
                }
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(resultMessage))
    {
        <div class="alert @(resultSuccess ? "alert-success" : "alert-danger")">@resultMessage</div>
    }

    @if (revealedPassword is not null)
    {
        @* The reveal path. Shown once, never re-rendered from stored state, and only when the
           operator holds CloudPasswordResetReveal and the destination could not be derived. *@
        <div class="alert alert-warning">
            <div class="mb-2"><strong>This password is shown once. It has not been emailed to anyone.</strong></div>
            <code>@revealedPassword</code>
        </div>
    }
</div>

@code {
    private bool authChecked;
    private bool isBusy;
    private string upnInput = "";
    private string ticketInput = "";
    private string errorMessage = "";

    // Checked by default, owner ruling 2026-09-23. The password travels by email, so forcing a
    // change makes it a one-time handover rather than a standing credential sitting in a mailbox.
    private bool forceChangeAtNextSignIn = true;

    private CloudPasswordTarget? target;
    private CloudPasswordDestination? destination;

    private bool resetConfirmPending;
    private bool canReveal;
    private string? revealedPassword;
    private string resultMessage = "";
    private bool resultSuccess;

    private string currentUser = "";
    private string clientIpAddress = "";

    private const string AuditCategory = "CloudPasswordReset";
    private const string ServicerModuleId = "CloudPasswordReset";

    /// <summary>
    /// Whether a reset can proceed at all: either the destination resolved, or the operator holds
    /// the reveal permission and can take the password on screen.
    /// </summary>
    /// <remarks>
    /// UI state only. Every one of these conditions is re-checked server-side in
    /// <see cref="ExecuteResetAsync"/> before anything is written, because a disabled button is
    /// not a control (Constitution: UI hiding is not security).
    /// </remarks>
    private bool CanReset =>
        target is not null && (destination?.Resolved == true || canReveal);

    private string WhyResetUnavailable() =>
        canReveal
            ? "No owner mailbox could be determined."
            : "The password cannot be delivered, and you do not hold the permission to see it on screen.";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUser = user.Identity?.Name ?? "Unknown";
        clientIpAddress = ClientInfo.IpAddress != "Unknown"
            ? ClientInfo.IpAddress
            : ClientInfo.GetIpForUser(currentUser);

        var authResult = await AuthorizationService.AuthorizeAsync(user, "CloudPasswordReset");
        if (!authResult.Succeeded)
        {
            Navigation.NavigateTo("access-denied", forceLoad: true);
            return;
        }

        canReveal = (await AuthorizationService.AuthorizeAsync(user, "CloudPasswordResetReveal")).Succeeded;

        authChecked = true;
    }

    private async Task LookupAsync()
    {
        if (isBusy || string.IsNullOrWhiteSpace(upnInput)) return;

        isBusy = true;
        errorMessage = "";
        target = null;
        destination = null;

        // Clear EVERY per-attempt field, not just the ones this method sets. A revealed password
        // for the previous account would otherwise stay on screen under the new one's preflight -
        // "shown once" is not true if it survives the next search - and an armed confirmation
        // would carry over to a target the operator never armed it for (review finding cpr-10).
        revealedPassword = null;
        resultMessage = "";
        resultSuccess = false;
        resetConfirmPending = false;

        try
        {
            var (resolved, refusal, message) = await ResetService.ResolveTargetAsync(upnInput.Trim());

            if (resolved is null)
            {
                errorMessage = message;
                Logger.LogWarning("Cloud password reset preflight refused for {Operator}: {Refusal}", currentUser, refusal);
                return;
            }

            target = resolved;
            destination = ResetService.DeriveDestination(resolved);
        }
        catch (Exception ex)
        {
            // Sanitized: the UI never shows raw exception detail (Developer Guide, UI Standards).
            Logger.LogError(ex, "Cloud password reset preflight failed for {Operator}", currentUser);
            errorMessage = "The account could not be checked. See the event log for detail.";
        }
        finally
        {
            isBusy = false;
        }
    }

    private string? ServicerNoteFor(System.Security.Claims.ClaimsPrincipal? user, IEnumerable<string> matchedRules, string? qualifier = null) =>
        ProtectedPrincipalServicing.NoteFor(Servicers, user, ServicerModuleId, matchedRules, qualifier);

    /// <summary>
    /// Reset the password, deliver it, and record what happened.
    /// </summary>
    /// <remarks>
    /// **The ordering is the design and is not rearrangeable.** Every gate that can refuse runs
    /// BEFORE the PATCH, because the write cannot be undone: once the password has changed, a
    /// later refusal leaves an account whose password nobody knows. The one thing that can still
    /// fail after the write is the send, and that has its own outcome.
    /// </remarks>
    private async Task ExecuteResetAsync()
    {
        if (isBusy || target is null) return;

        isBusy = true;
        resetConfirmPending = false;
        revealedPassword = null;
        resultMessage = "";
        await Task.Yield();

        var upn = target.UserPrincipalName;
        var ticket = ticketInput.Trim();
        string? servicedNote = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();

            // 1. Authorization, re-checked immediately before the write. The page attribute and
            //    the OnInitializedAsync check are navigation control; neither survives a direct
            //    event invocation over the circuit.
            if (!(await AuthorizationService.AuthorizeAsync(authState.User, "CloudPasswordReset")).Succeeded)
            {
                await RefuseAsync(upn, ticket, CloudPasswordResetRefusal.PermissionDenied,
                    "You are not authorized to reset cloud passwords.");
                return;
            }

            // 2. Ticket policy. Both Rejected and Unavailable refuse, before any Graph call.
            var (ticketOk, ticketRefusal, ticketMessage) = await ResetService.ValidateTicketAsync(ticket);
            if (!ticketOk)
            {
                await RefuseAsync(upn, ticket, ticketRefusal, ticketMessage);
                return;
            }

            // 3. Protected principals.
            var (protectionOk, protectionRefusal, protectionMessage, note) =
                await CheckProtectionAsync(authState.User, upn, target.ObjectId);
            servicedNote = note;
            if (!protectionOk)
            {
                await RefuseAsync(upn, ticket, protectionRefusal, protectionMessage);
                return;
            }

            // 4. Re-read the ACCOUNT, then re-derive from it. Deriving from the cached preflight
            //    target only refreshed the directory half: the employeeId came from a read that
            //    could be minutes old, so a password could be mailed to the owner of an id the
            //    account no longer carries (review finding cpr-9). The scope checks run again
            //    with it, because an account can be synced or converted in that window too.
            var confirmedAddress = destination?.Address;
            var confirmedRevealing = destination?.Resolved != true;

            var (fresh, freshRefusal, freshMessage) = await ResetService.ResolveTargetAsync(upn);
            if (fresh is null)
            {
                await RefuseAsync(upn, ticket, freshRefusal, freshMessage);
                return;
            }

            target = fresh;
            destination = ResetService.DeriveDestination(fresh);
            var revealing = !destination.Resolved;

            // 4a. If what the operator confirmed is not what would now happen, STOP and make them
            //     look again. Silently switching the recipient - or switching from "email it to
            //     Jo" to "show it on screen" - would complete an operation nobody approved.
            if (revealing != confirmedRevealing || !string.Equals(destination.Address, confirmedAddress, StringComparison.OrdinalIgnoreCase))
            {
                resultSuccess = false;
                resultMessage = "The account changed while you were confirming, so the reset was stopped. "
                    + "Check the account below and confirm again if it is still what you want.";

                Logger.LogWarning("Cloud password reset for {Upn} aborted: the destination changed between preflight and confirmation", upn);

                AuditReset(upn, ticket, "CloudPasswordReset_Execute", success: false,
                    delivery: "NotAttempted", refusal: CloudPasswordResetRefusal.None, servicedNote: servicedNote,
                    errorDetail: "The derived destination changed between preflight and confirmation; no write was attempted.");
                return;
            }

            if (revealing && !(await AuthorizationService.AuthorizeAsync(authState.User, "CloudPasswordResetReveal")).Succeeded)
            {
                await RefuseAsync(upn, ticket, destination.Refusal,
                    "The password could not be delivered to an owner, and you do not hold the permission to see it on screen.");
                return;
            }

            if (!revealing && !Email.UserNotificationsEnabled)
            {
                // Worse than decorative: a silent suppression would lock the owner out.
                await RefuseAsync(upn, ticket, CloudPasswordResetRefusal.NotificationsDisabled,
                    "User notifications are disabled for this deployment, so the password cannot be delivered. No change was made.");
                return;
            }

            // 5. The write.
            var outcome = await ResetService.ResetPasswordAsync(target.ObjectId, forceChangeAtNextSignIn);

            if (outcome.Refusal == CloudPasswordResetRefusal.WriteIndeterminate)
            {
                // NOT a refusal, and must not be recorded as one. The request was issued and may
                // have applied; saying "no change was made" would be a claim nothing supports
                // (review finding cpr-8).
                resultSuccess = false;
                resultMessage = outcome.Message;

                AuditReset(upn, ticket, "CloudPasswordReset_Execute", success: false,
                    delivery: "Indeterminate", refusal: outcome.Refusal, servicedNote: servicedNote,
                    errorDetail: "The PATCH was issued and no response was observed; the password may have changed.");
                await NotifyAdminsAsync(upn, ticket, success: false, delivery: "Indeterminate", refusal: outcome.Refusal);
                return;
            }

            if (!outcome.Success || outcome.Password is null)
            {
                await RefuseAsync(upn, ticket, outcome.Refusal, outcome.Message);
                return;
            }

            // 6. Delivery. The password exists now and cannot be un-set.
            if (revealing)
            {
                revealedPassword = outcome.Password;
                resultSuccess = true;
                resultMessage = $"The password for {upn} was reset and is shown below. It has not been emailed.";

                Logger.LogWarning("Cloud password for {Upn} was REVEALED to {Operator}, overriding {Refusal}",
                    upn, currentUser, destination.Refusal);

                AuditReset(upn, ticket, "CloudPasswordReset_Revealed", success: true,
                    delivery: "Revealed", refusal: destination.Refusal, servicedNote: servicedNote);
                await NotifyAdminsAsync(upn, ticket, success: true, delivery: "Revealed");
                return;
            }

            var sent = await Email.SendCloudPasswordResetAsync(
                destination.Address!, upn, outcome.Password, ticket, forceChangeAtNextSignIn);

            if (!sent)
            {
                // Fail closed: the password is discarded, not displayed, to any tier. Running the
                // reset again generates a new one - showing it here would hand every operator a
                // way to see a password by provoking a send failure.
                resultSuccess = false;
                resultMessage = $"The password for {upn} was changed but could not be delivered. It has been discarded. Run the reset again.";

                Logger.LogCritical("Cloud password for {Upn} was changed but NOT delivered; the password is discarded and nobody knows it", upn);

                AuditReset(upn, ticket, "CloudPasswordReset_DeliveryFailed", success: false,
                    delivery: "SendFailed", refusal: CloudPasswordResetRefusal.None, servicedNote: servicedNote);
                await NotifyAdminsAsync(upn, ticket, success: false, delivery: "SendFailed");
                return;
            }

            resultSuccess = true;
            resultMessage = $"The password for {upn} was reset and emailed to {destination.Address}.";

            AuditReset(upn, ticket, "CloudPasswordReset_Execute", success: true,
                delivery: "Sent", refusal: CloudPasswordResetRefusal.None, servicedNote: servicedNote);
            await NotifyAdminsAsync(upn, ticket, success: true, delivery: "Sent");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Cloud password reset for {Upn} failed unexpectedly", upn);
            resultSuccess = false;
            resultMessage = "The reset failed. See the event log for detail.";
            AuditReset(upn, ticket, "CloudPasswordReset_Execute", success: false,
                delivery: "NotAttempted", refusal: CloudPasswordResetRefusal.GraphReadFailed, servicedNote: servicedNote,
                errorDetail: ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    /// <summary>Record a refusal and tell the operator, without writing anything.</summary>
    private async Task RefuseAsync(string upn, string ticket, CloudPasswordResetRefusal refusal, string message)
    {
        resultSuccess = false;
        resultMessage = message;

        AuditReset(upn, ticket, "CloudPasswordReset_Execute", success: false,
            delivery: "NotAttempted", refusal: refusal, servicedNote: null, errorDetail: message);

        await NotifyAdminsAsync(upn, ticket, success: false, delivery: "NotAttempted", refusal: refusal);
    }

    /// <summary>
    /// The protected-principal flow, both branches.
    /// </summary>
    /// <remarks>
    /// Uses the Exchange fallback resolve, not the AD-only one: an AD-only lookup reports every
    /// cloud-only object as NotFound, and this module's entire population is cloud-only, so the
    /// check would be inert (docs/ProtectedPrincipalGapFix-Plan.md GAP B).
    ///
    /// The unresolved branch passes the REAL Entra object id, which MfaReset cannot because it has
    /// not resolved the target through Graph by that point. This module has. Do not copy the null.
    /// </remarks>
    private async Task<(bool Ok, CloudPasswordResetRefusal Refusal, string Message, string? ServicedNote)>
        CheckProtectionAsync(System.Security.Claims.ClaimsPrincipal user, string upn, string entraObjectId)
    {
        try
        {
            var (resolved, status) = await ProtectedPrincipalService.ResolveWithExchangeFallbackAsync(upn);

            if (status is ProtectedPrincipalService.ResolutionStatus.Unavailable
                       or ProtectedPrincipalService.ResolutionStatus.Ambiguous)
            {
                var reason = status == ProtectedPrincipalService.ResolutionStatus.Ambiguous
                    ? "The identity is ambiguous - it matches more than one directory user."
                    : "The protection check could not be completed.";
                return (false, CloudPasswordResetRefusal.ProtectionCheckFailed, reason, null);
            }

            var principal = resolved ?? new ResolvedDirectoryPrincipal(
                Source: "CloudPasswordReset-Unresolved",
                DisplayName: upn,
                UserPrincipalName: upn,
                SamAccountName: null,
                PrimarySmtpAddress: upn.Contains('@') ? upn : null,
                DistinguishedName: null,
                ObjectGuid: null,
                EntraObjectId: entraObjectId);

            var qualifier = resolved is null ? "directory-unresolved" : null;
            var check = await ProtectedPrincipalService.CheckAsync(principal);

            if (check.CheckFailed)
                return (false, CloudPasswordResetRefusal.ProtectionCheckFailed, $"Protection check failed: {check.Reason}", null);

            if (check.IsProtected)
            {
                var note = ServicerNoteFor(user, check.MatchedRules, qualifier);
                if (note is null)
                {
                    return (false, CloudPasswordResetRefusal.ProtectedPrincipal,
                        "This account is a protected principal. Resetting its password is not permitted.", null);
                }
                return (true, CloudPasswordResetRefusal.None, "", note);
            }

            return (true, CloudPasswordResetRefusal.None, "", null);
        }
        catch (Exception ex)
        {
            // Block as a precaution. An exception is not evidence the target is unprotected.
            Logger.LogWarning(ex, "Protection check threw for {Upn}; blocking", upn);
            return (false, CloudPasswordResetRefusal.ProtectionCheckFailed,
                "The protection check could not be completed.", null);
        }
    }

    /// <summary>
    /// Write the audit event, with the full field set on every path.
    /// </summary>
    /// <remarks>
    /// Successes and refusals carry the SAME keys, with explicit nulls, so one search over
    /// category=CloudPasswordReset returns uniform records and a missing field always means a bug
    /// rather than a branch that did not bother (plan AC18).
    ///
    /// **The password appears nowhere here and must not** (AC7). The serviced note rides `extra`,
    /// never errorDetail, because LogModuleAction discards errorDetail on a success.
    /// </remarks>
    private void AuditReset(
        string upn,
        string ticket,
        string action,
        bool success,
        string delivery,
        CloudPasswordResetRefusal refusal,
        string? servicedNote,
        string? errorDetail = null)
    {
        // THE SENTINEL, NOT NULL. The plan asks for explicit nulls so every event carries an
        // identical key set - but the writer drops them twice over: JsonlLogService filters
        // null-valued keys before serializing and its options ignore nulls as well. An explicit
        // null therefore reaches Splunk as an ABSENT field, which is the one thing AC18 exists to
        // prevent, because a missing key and a null key are different answers to a search.
        //
        // The plan anticipated this and pre-authorised the fix: "S6 confirms the JSON writer
        // emits nulls rather than dropping them; if it drops them, the sentinel is the string
        // n/a". It drops them (review finding cpr-11). Using the sentinel here rather than
        // changing the shared writer, which every other module's logs would inherit.
        const string NotApplicable = "n/a";

        var extra = new Dictionary<string, object?>
        {
            ["targetObjectId"] = target?.ObjectId ?? NotApplicable,
            ["targetCloudOnly"] = target?.CloudOnly ?? false,
            ["targetDirectoryRoles"] = target?.DirectoryRoles?.ToArray() ?? [],
            ["destinationAddress"] = destination?.Resolved == true ? destination.Address : NotApplicable,
            ["destinationEmployeeId"] = destination?.EmployeeId ?? target?.EmployeeId ?? NotApplicable,
            ["forceChangePasswordNextSignIn"] = forceChangeAtNextSignIn,
            ["passwordDelivery"] = delivery,
            ["revealUsed"] = delivery == "Revealed",
            ["refusalReason"] = refusal == CloudPasswordResetRefusal.None ? NotApplicable : refusal.ToString(),
            ["protectedPrincipalServiced"] = servicedNote ?? NotApplicable,
        };

        try
        {
            Audit.LogModuleAction(currentUser, clientIpAddress, action, AuditCategory, upn, success, ticket,
                errorDetail, extra);
        }
        catch (Exception ex)
        {
            // An audit write failure must not change the result of a completed operation.
            Logger.LogError(ex, "Failed to write the audit event for a cloud password reset of {Upn}", upn);
        }
    }

    /// <summary>
    /// The administrator alert. Names the destination and the change choice; never the password.
    /// </summary>
    private async Task NotifyAdminsAsync(
        string upn,
        string ticket,
        bool success,
        string delivery,
        CloudPasswordResetRefusal refusal = CloudPasswordResetRefusal.None)
    {
        var details = new Dictionary<string, string>
        {
            ["Target account"] = upn,
            ["Performed by"] = currentUser,
            ["Destination"] = destination?.Resolved == true ? destination.Address! : "(none - not delivered)",
            ["Employee ID used"] = destination?.EmployeeId ?? target?.EmployeeId ?? "(none)",
            ["Force change at next sign-in"] = forceChangeAtNextSignIn ? "Yes" : "No",
            ["Delivery"] = delivery,
            ["Password revealed to operator"] = delivery == "Revealed" ? "Yes" : "No",
        };

        if (refusal != CloudPasswordResetRefusal.None)
            details["Refused because"] = refusal.ToString();

        try
        {
            await Email.SendAdminNotificationAsync(currentUser, clientIpAddress, "Cloud password reset",
                success, ticket, details);
        }
        catch (Exception ex)
        {
            // Notification failure must not change or mask the backend result.
            Logger.LogError(ex, "Failed to send the administrator notification for a cloud password reset of {Upn}", upn);
        }
    }

    /// <summary>
    /// The operator-facing sentence for a destination that did not resolve.
    /// </summary>
    /// <remarks>
    /// Each one says what is wrong with the ACCOUNT rather than what the module did, because the
    /// operator's next step differs per case: an unset employee ID is a directory fix, two matches
    /// is a data-quality escalation, and an unreachable directory is wait-and-retry.
    /// </remarks>
    private static string DestinationRefusalText(CloudPasswordResetRefusal? refusal) => refusal switch
    {
        CloudPasswordResetRefusal.DestinationNoEmployeeId =>
            "No employee ID is set on this account, so its owner cannot be identified.",
        CloudPasswordResetRefusal.DestinationNoMatch =>
            "No directory account carries this employee ID.",
        CloudPasswordResetRefusal.DestinationAmbiguous =>
            "More than one directory account carries this employee ID, so the owner is not certain.",
        CloudPasswordResetRefusal.DestinationNoMailbox =>
            "The owner was found but has no mailbox to send to.",
        CloudPasswordResetRefusal.DestinationLookupFailed =>
            "The directory could not be searched, so the owner is unknown. Try again shortly.",
        _ => "The owner could not be determined.",
    };
}

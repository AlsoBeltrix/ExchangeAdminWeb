@page "/module-config/{ModuleId}"
@using Microsoft.AspNetCore.Authorization
@using ExchangeAdminWeb.Modules
@attribute [Authorize]
@rendermode InteractiveServer
@inject ModuleConfigService ModuleConfigSvc
@inject ModuleAdminService ModuleAdmin
@inject ModuleEnablementService Enablement
@inject SectionAccessService SectionAccess
@inject ExchangeAdminWeb.Services.IGroupGrantDirectory ADSearch
@inject ModuleCatalog Catalog
@inject AuditService Audit
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager Navigation
@inject ClientInfoService ClientInfo
@inject ADAttributeEditorService AttrEditorService
@inject ADOrganizationalUnitService OUService
@inject ILogger<ModuleConfig> Logger
@inject IActivityProgress Progress

<PageTitle>Module Config — @(module?.DisplayName ?? ModuleId)</PageTitle>

@if (!authChecked)
{
    @* NO SPINNER. No module draws its own progress (owner ruling 2026-10-02,
       `.agents/decisions.md`), and nothing replaces this one: GroupAuthorizationHandler is
       synchronous end to end, so the check finishes faster than a frame and a bar line
       flickering inside a single render is noise, not information.
       The GUARD stays and must stay - it is what stops the page rendering before the check
       has passed, which is refusal, not progress. Kept at the SAME LINE COUNT as the markup
       it replaces, so not one ClickGateRegistry line key moves. *@
    return;
}

@if (module == null)
{
    <div class="container-fluid">
        <div class="alert alert-danger">Module not found: @ModuleId</div>
    </div>
    return;
}

@* Five sections, five Save buttons, and until now nothing warned that another section was still
   unsaved. B2 in docs/AdminUIRedesign-Plan.md. *@
<UnsavedChangesGuard HasUnsavedChanges="@dirty.IsDirty"
                     Message="@($"{dirty.Summary()}. Leave without saving?")" />

<div class="container-fluid adm">
    <div class="adm-hd">
        <h1>@module.DisplayName</h1>
        <span class="adm-ver">v@(module.Version)</span>
        <span class="adm-sub">@module.Description</span>
    </div>

    @* Tabs, not stacked cards. Each pane scrolls independently so the page never grows with the
       number of groups - the failure the owner reported at 10-20 groups per module. Counts sit on
       the tab so an operator knows what is behind it without opening it, and a dot marks a
       background tab holding unsaved edits. *@
    <div class="adm-tabs">
        @if (!module.IsSystemModule)
        {
            <button class="@TabClass(SecStatus)" @onclick="() => tab = SecStatus">
                Status @if (dirty.IsSectionDirty(SecStatus)) { <span class="adm-dot"></span> }
            </button>
        }
        @if (isGlobalAdmin)
        {
            <button class="@TabClass(SecAccess)" @onclick="() => tab = SecAccess">
                Access <span class="adm-n">@AccessGroupCount()</span>
                @if (dirty.IsSectionDirty(SecAccess)) { <span class="adm-dot"></span> }
            </button>
        }
        @if (module.ConfigFields.Count > 0)
        {
            <button class="@TabClass(SecConfig)" @onclick="() => tab = SecConfig">
                Configuration <span class="adm-n">@module.ConfigFields.Count</span>
                @if (dirty.IsSectionDirty(SecConfig)) { <span class="adm-dot"></span> }
            </button>
        }
        @if (module.Id == "ADAttributeEditor")
        {
            <button class="@TabClass(SecAttrs)" @onclick="() => tab = SecAttrs">
                Attributes <span class="adm-n">@allowlistAttributes.Count</span>
                @if (dirty.IsSectionDirty(SecAttrs)) { <span class="adm-dot"></span> }
            </button>
        }
        @if (isGlobalAdmin)
        {
            <button class="@TabClass(SecAdmins)" @onclick="() => tab = SecAdmins">
                Module admins <span class="adm-n">@moduleAdminGroups.Count</span>
                @if (dirty.IsSectionDirty(SecAdmins)) { <span class="adm-dot"></span> }
            </button>
        }
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(statusIsError ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
        </div>
    }

    @if (!module.IsSystemModule)
    {
        <div class="adm-pane @PaneClass(SecStatus)">
                @if (enablementStoreCorrupt)
                {
                    <div class="alert alert-danger py-2 mb-2">
                        <small><strong>Module enablement store is corrupt.</strong> The state shown below is the fallback, not the stored state, and saving is disabled. @SettingsStoreText.Enablement(Enablement.LegacyImportFailed)</small>
                    </div>
                }
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" id="module-enabled"
                           checked="@moduleEnabled"
                           disabled="@(!isGlobalAdmin || saving)"
                           @onchange="(e) => ToggleModuleEnabled((bool)(e.Value ?? false))" />
                    <label class="form-check-label fw-semibold" for="module-enabled">
                        @(moduleEnabled ? "Enabled" : "Disabled")
                    </label>
                </div>
                @{
                    var effectiveEnabled = Enablement.IsModuleEnabled(module.Id);
                    var parentModule = module.DependsOn != null ? Catalog.GetById(module.DependsOn) : null;
                }
                @if (moduleEnabled && !effectiveEnabled && parentModule != null)
                {
                    <div class="alert alert-warning py-2 mb-2">
                        <small>Enabled but inactive -- @parentModule.DisplayName is disabled.</small>
                    </div>
                }
                <small class="text-muted">
                    Disabled modules are hidden from the sidebar and denied by authorization, even when section access and configuration are set.
                    @if (!isGlobalAdmin)
                    {
                        <span> Only global admins can change module status.</span>
                    }
                </small>
            </div>
    }

    @* Section Access *@
    @if (isGlobalAdmin)
    {
        <div class="adm-pane @PaneClass(SecAccess)">
                @if (sectionAccessCorrupt)
                {
                    <div class="alert alert-danger mb-0">
                        <strong>Section access store is corrupt.</strong>
                        The group lists cannot be shown and saving is disabled - saving now would replace
                        groups this page cannot see.
                        @SettingsStoreText.SectionAccess(SectionAccess.LegacyImportFailed)
                    </div>
                }
                else
                {
                @if (sectionAccessUnconfigured)
                {
                    <div class="alert alert-info py-2 mb-2">
                        <small>Section access has never been configured on this server (none is stored in the config database, and appsettings.json holds no legacy Security:SectionAccess block). Saving here stores it and starts enforcing these lists for all fail-closed modules.</small>
                    </div>
                }

                <p class="text-muted mb-2"><small>Groups allowed to use this module, stored as SIDs. Search covers every domain in the forest.</small></p>

                @* One row per grant, not chips. Chips wrap, so the block changed height per module
                   and nothing lined up; a row shows the domain, the group and the SID it actually
                   stores, aligned. Domain is its OWN column rather than a DOMAIN\ prefix, because
                   a prefix pushes every group name to a different x-position. Owner rejected every
                   chip variant (2026-08-04). *@
                @* Skips the servicer alias, which policyAliases carries so it shares the load and
                   save path but which renders in its own section below, with its own warning. *@
                @foreach (var alias in policyAliases.Where(a => a != ServicerAlias))
                {
                    var capturedAlias = alias;
                    var aliasGroups = accessState.TryGetValue(capturedAlias, out var ag) ? ag : new List<string>();
                    @* A module may name its permissions for the administrator granting them; most
                       do not, and those still head their row with the alias exactly as before. *@
                    var aliasLabel = PermissionLabelFor(capturedAlias);
                    var aliasLabelDiffers = !string.Equals(aliasLabel, capturedAlias, StringComparison.Ordinal);

                    <div class="mb-3">
                        <div class="d-flex align-items-baseline gap-2 mb-1">
                            <strong style="font-size: 0.8rem;">@aliasLabel</strong>
                            @* The alias stays visible whenever a label replaces it as the heading:
                               it is the section-access storage key, and it is what the denial log
                               line and any support conversation will name. Dropping it would leave
                               an administrator unable to connect this row to either. *@
                            @if (aliasLabelDiffers)
                            {
                                <code class="text-muted" style="font-size: 0.68rem;">@capturedAlias</code>
                            }
                            <span class="text-muted" style="font-size: 0.72rem;">@aliasGroups.Count group(s)</span>
                        </div>
                        @* The alias alone told an admin nothing about what they were approving
                           (owner ruling 2026-09-02). The descriptor sentence says what a member of
                           the groups below can DO, on the row where the grant is made. *@
                        <div class="text-muted mb-1" style="font-size: 0.72rem;">@PermissionDescriptionFor(capturedAlias)</div>
                        <table class="adm-tbl">
                            <thead>
                                <tr>
                                    <th style="width: 5.5rem;">Domain</th>
                                    <th style="width: 16rem;">Group</th>
                                    <th>Security identifier</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (aliasGroups.Count == 0)
                                {
                                    <tr><td colspan="4" class="adm-empty">No groups - access is denied for this permission.</td></tr>
                                }
                                @foreach (var group in aliasGroups.ToList())
                                {
                                    var cg = group;
                                    <tr>
                                        <td class="adm-dom">@DomainOf(cg)</td>
                                        <td class="adm-grp">@BareNameOf(cg)</td>
                                        <td class="adm-sid">@cg</td>
                                        <td class="adm-act">
                                            <button class="adm-rm" type="button" @onclick="() => RemoveAccessGroup(capturedAlias, cg)">Remove</button>
                                        </td>
                                    </tr>
                                }
                                <tr>
                                    <td colspan="4">
                                        <div class="input-group input-group-sm" style="max-width: 30rem;">
                                            <ADIdentityAutocomplete ObjectKind="Group" ReturnValueKind="SID" @bind-Value="accessInputs[capturedAlias]"
                                                                    OnResultSelected="RememberGroupDisplayName" Placeholder="Search groups in any domain..." />
                                            <button class="btn btn-outline-secondary" type="button" @onclick="() => AddAccessGroup(capturedAlias)">Add</button>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                }

                @* Protected-principal servicing. Rendered ONLY for modules whose gate actually
                   consults ProtectedPrincipalServicerService: a group configured against a module
                   that never asks would grant nothing while appearing to grant something, which is
                   worse than offering no editor at all.

                   Deliberately below, and visually separated from, the ordinary access grants.
                   Being able to USE a module must never read as being able to act on protected
                   principals within it - that separation is the whole reason this is its own
                   section-access key rather than a granular permission. *@
                @if (ServicerAlias is { Length: > 0 } servicerAlias)
                {
                    var servicerGroups = accessState.TryGetValue(servicerAlias, out var sg) ? sg : new List<string>();

                    <div class="mb-3 mt-4 pt-3 border-top">
                        <div class="d-flex align-items-baseline gap-2 mb-1">
                            <strong style="font-size: 0.8rem;">Protected principal servicing</strong>
                            <span class="text-muted" style="font-size: 0.72rem;">@servicerGroups.Count group(s)</span>
                        </div>
                        @* A standing sentence, not a confirmation dialog. The owner ruled 2026-08-06
                           that servicing is routine authorised work with no per-operation ceremony;
                           this warns the ADMIN making a rare, deliberate grant, which is a different
                           audience and a different moment. *@
                        <div class="alert alert-warning py-2 mb-2">
                            <small>
                                <strong>Members may act on protected principals in this module.</strong>
                                Protected principals are otherwise refused to everyone. This is separate
                                from module access above - it grants nothing else, and confers nothing in
                                any other module. Actions are audited normally, and record which group
                                authorised them. With no group listed, no one can service protected
                                principals here.
                                <strong>It does not grant access to the module.</strong> A group listed
                                only here still cannot open @module.DisplayName, so the grant never comes
                                into play - it needs @module.MainPermission.PolicyAlias above as well.
                            </small>
                        </div>

                        @* Names the gap on the row it applies to rather than leaving the sentence above
                           to be applied by the reader. The check is deliberately about the DIRECT grant:
                           membership is nested, so a group absent from the list above may still reach the
                           module through one that is present. Hence "not granted directly" and a warning
                           tone, not an assertion that the grant is dead - overclaiming here would train
                           admins to dismiss it. *@
                        @if (servicerGroups.Any(ServicerGroupLacksDirectModuleAccess))
                        {
                            <div class="alert alert-danger py-2 mb-2">
                                <small>
                                    <strong>Marked groups below have no direct @module.MainPermission.PolicyAlias grant.</strong>
                                    Unless their members reach @module.DisplayName through another group
                                    listed above, they cannot open it, and this servicing grant does
                                    nothing for them. Add them above, or remove them here.
                                </small>
                            </div>
                        }
                        <table class="adm-tbl">
                            <thead>
                                <tr>
                                    <th style="width: 5.5rem;">Domain</th>
                                    <th style="width: 16rem;">Group</th>
                                    <th>Security identifier</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (servicerGroups.Count == 0)
                                {
                                    <tr><td colspan="4" class="adm-empty">No groups - no one may service protected principals in this module.</td></tr>
                                }
                                @foreach (var group in servicerGroups.ToList())
                                {
                                    var sgc = group;
                                    <tr>
                                        <td class="adm-dom">@DomainOf(sgc)</td>
                                        <td class="adm-grp">
                                            @BareNameOf(sgc)
                                            @if (ServicerGroupLacksDirectModuleAccess(sgc))
                                            {
                                                <span class="badge bg-danger ms-1" style="font-size: 0.62rem;"
                                                      title="This group has no direct @module.MainPermission.PolicyAlias grant, so unless its members reach the module through another group they cannot open it and this servicing grant does nothing.">no module access</span>
                                            }
                                        </td>
                                        <td class="adm-sid">@sgc</td>
                                        <td class="adm-act">
                                            <button class="adm-rm" type="button" @onclick="() => RemoveAccessGroup(servicerAlias, sgc)">Remove</button>
                                        </td>
                                    </tr>
                                }
                                <tr>
                                    <td colspan="4">
                                        <div class="input-group input-group-sm" style="max-width: 30rem;">
                                            <ADIdentityAutocomplete ObjectKind="Group" ReturnValueKind="SID" @bind-Value="accessInputs[servicerAlias]"
                                                                    OnResultSelected="RememberGroupDisplayName" Placeholder="Search groups in any domain..." />
                                            <button class="btn btn-outline-secondary" type="button" @onclick="() => AddAccessGroup(servicerAlias)">Add</button>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                }
                }
            </div>
    }

    @* Module Configuration *@
    @if (module.ConfigFields.Count > 0)
    {
        <div class="adm-pane @PaneClass(SecConfig)">

                @if (moduleConfigCorrupt)
                {
                    <div class="alert alert-danger mb-0">
                        <strong>Module configuration is corrupt.</strong>
                        The stored values cannot be shown and saving is disabled - saving now would
                        overwrite them with blank fields.
                        @SettingsStoreText.ModuleConfig(module.Id)
                    </div>
                }
                else
                {
                @if (!ModuleConfigSvc.IsModuleConfigured(module.Id))
                {
                    <div class="alert alert-warning py-2 mb-3">
                        <small>This module has required fields that are not yet configured.</small>
                    </div>
                }
                @if (module.ConfigFields.Any(f => f.Key.Contains("DelineaSecretId")))
                {
                    <div class="alert alert-secondary py-2 mb-3">
                        <small><strong>Delinea Secret Server:</strong> Enter the Secret ID for this module's credentials. For Graph modules, use the "ADI - Azure App Registration" template (fields: Tenant ID, Application ID, Client Secret). For AD modules, use a template with Username, Password, and Domain fields.</small>
                    </div>
                }
                <div class="row g-3">
                    @foreach (var field in module.ConfigFields)
                    {
                        var capturedKey = field.Key;
                        <div class="col-md-6">
                            <label class="form-label">
                                @field.Label
                                @if (field.Required) { <span class="text-danger">*</span> }
                            </label>
                            @if (capturedKey == "DefaultSearchBase" && module.Id == "ADAttributeEditor")
                            {
                                <div class="input-group">
                                    <input type="text"
                                           class="form-control"
                                           placeholder="@field.Description"
                                           value="@GetConfigValue(field.Key, field.DefaultValue)"
                                           @oninput="(e) => SetConfigValue(capturedKey, e.Value?.ToString() ?? string.Empty)" />
                                    @if (ouBrowseAvailable)
                                    {
                                        <button class="btn btn-outline-secondary" type="button"
                                                @onclick="ToggleOUBrowser" disabled="@ouLoading">
                                            @* No spinner: the OU load reports to the status bar. *@
                                            @(showOUBrowser ? "Close" : "Browse OUs")
                                        </button>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(field.Description) && !field.IsSecret)
                                {
                                    <div class="form-text">@field.Description</div>
                                }

                                @if (showOUBrowser)
                                {
                                    <div class="card mt-2 border-secondary">
                                        <div class="card-header py-2 d-flex justify-content-between align-items-center">
                                            <small class="fw-semibold">Select Organizational Units</small>
                                            <div>
                                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="RefreshOUs" disabled="@ouLoading">
                                                    Refresh
                                                </button>
                                                <button class="btn btn-sm btn-primary" @onclick="ApplySelectedOUs">
                                                    Apply Selected
                                                </button>
                                            </div>
                                        </div>
                                        <div class="card-body p-2">
                                            @if (ouFilteredEntries.Count == 0)
                                            {
                                                <p class="text-muted fst-italic mb-0">No organizational units found.</p>
                                            }
                                            else
                                            {
                                                <div class="mb-2">
                                                    <input type="text" class="form-control form-control-sm"
                                                           placeholder="Filter OUs..."
                                                           value="@ouFilterText"
                                                           @oninput="OnOUFilterChanged" />
                                                </div>
                                                <div style="max-height: 350px; overflow-y: auto; font-size: 0.875em;">
                                                    @foreach (var ou in ouFilteredEntries)
                                                    {
                                                        var capturedDn = ou.DistinguishedName;
                                                        var isChecked = ouSelectedDNs.Contains(capturedDn);
                                                        var indent = Math.Max(0, ou.Depth - ouMinDepth);
                                                        <div class="form-check py-0" style="padding-left: @(1.5 + indent * 1.25)rem;">
                                                            <input class="form-check-input" type="checkbox" id="ou-@capturedDn.GetHashCode()"
                                                                   checked="@isChecked"
                                                                   @onchange="(e) => ToggleOU(capturedDn, (bool)(e.Value ?? false))" />
                                                            <label class="form-check-label" for="ou-@capturedDn.GetHashCode()"
                                                                   title="@capturedDn">
                                                                @ou.Name
                                                                <small class="text-muted ms-1">@capturedDn</small>
                                                            </label>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            else if (field.FieldType == ConfigFieldType.AdGroup)
                            {
                                <ADGroupAutocomplete Value="@GetConfigValue(field.Key, field.DefaultValue)"
                                                     ValueChanged="(v) => SetConfigValue(capturedKey, v)"
                                                     Placeholder="@field.Description"
                                                     Disabled="@saving" />
                                @if (!string.IsNullOrEmpty(field.Description) && !field.IsSecret)
                                {
                                    <div class="form-text">@field.Description</div>
                                }
                            }
                            else if (field.FieldType == ConfigFieldType.Boolean)
                            {
                                @* A boolean setting must be impossible to mistype: the checkbox
                                   writes exactly "true"/"false". Consumers keep their own parse
                                   guards for values corrupted outside this page. *@
                                var boolChecked = bool.TryParse(GetConfigValue(field.Key, field.DefaultValue), out var parsedBool) && parsedBool;
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="cfg-bool-@capturedKey"
                                           checked="@boolChecked"
                                           @onchange="(e) => SetBooleanConfigValue(capturedKey, e)" />
                                    <label class="form-check-label" for="cfg-bool-@capturedKey">Enabled</label>
                                </div>
                                @if (!string.IsNullOrEmpty(field.Description) && !field.IsSecret)
                                {
                                    <div class="form-text">@field.Description</div>
                                }
                            }
                            else
                            {
                                <input type="text"
                                       class="form-control"
                                       placeholder="@field.Description"
                                       value="@GetConfigValue(field.Key, field.DefaultValue)"
                                       @oninput="(e) => SetConfigValue(capturedKey, e.Value?.ToString() ?? string.Empty)" />
                                @if (!string.IsNullOrEmpty(field.Description) && !field.IsSecret)
                                {
                                    <div class="form-text">@field.Description</div>
                                }
                            }
                        </div>
                    }
                </div>
                }
            </div>
    }

    @* AD Attribute Editor — Editable Attributes *@
    @if (module.Id == "ADAttributeEditor")
    {
        <div class="adm-pane @PaneClass(SecAttrs)">
            <div class="mb-2">
                <button class="btn btn-outline-secondary btn-sm" @onclick="AddAttribute" disabled="@(saving || allowlistCorrupt)">Add attribute</button>
            </div>
                <p class="text-muted mb-3"><small>Configure which AD attributes users can edit. Attributes on the hard denylist (security-sensitive attributes like userAccountControl, memberOf, etc.) are automatically blocked.</small></p>

                @* aud-a26f. Two causes, two fixes, and the banner names the right one: the legacy import
                   refused its file - the one case where the file is the thing to fix, shown with the
                   import's reason, which used to reach only the log - or the table in the config
                   database cannot be read, fixed as the operations doc says. It used to name the file in
                   both, and an admin following it edited a file nothing reads. *@
                @if (allowlistCorrupt)
                {
                    <div class="alert alert-danger mb-3">
                        <strong>Attribute allowlist store is corrupt.</strong>
                        @if (allowlistImportRefusal is not null)
                        {
                            <span>
                                The legacy file config\ad-editable-attributes.json was not imported: @allowlistImportRefusal
                                It is left in place, and the attribute list cannot be shown and saving is
                                disabled until it imports: correct the file, then reload this page.
                            </span>
                        }
                        else
                        {
                            <span>
                                The allowlist in the config database (the editable_attribute table) cannot be
                                read or fails validation, so the attribute list cannot be shown and saving is
                                disabled - saving now would replace every configured attribute. An administrator
                                must correct the table as docs/ConfigDbOperations.md describes, with
                                both application pools stopped, then reload this page.
                            </span>
                        }
                    </div>
                }
                @if (allowlistError != null)
                {
                    <div class="alert alert-danger py-2">@allowlistError</div>
                }
                @if (allowlistSaved)
                {
                    <div class="alert alert-success py-2 alert-dismissible">
                        Allowlist saved successfully.
                        <button type="button" class="btn-close" @onclick="() => allowlistSaved = false"></button>
                    </div>
                }

                @if (allowlistAttributes.Count == 0)
                {
                    <p class="text-muted fst-italic">No editable attributes configured. Users will see an empty editor.</p>
                }
                else
                {
                    <div style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>LDAP Name</th>
                                    <th>Label</th>
                                    <th style="width: 100px;">Type</th>
                                    <th style="width: 80px;">Required</th>
                                    <th style="width: 90px;">Allow Clear</th>
                                    <th style="width: 80px;">Max Len</th>
                                    <th>Pattern</th>
                                    <th style="width: 60px;">Level</th>
                                    <th style="width: 50px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < allowlistAttributes.Count; i++)
                                {
                                    var idx = i;
                                    var attr = allowlistAttributes[idx];
                                    <tr>
                                        <td><input type="text" class="form-control form-control-sm" value="@attr.Name" @onchange="e => UpdateAttrName(idx, e)" placeholder="extensionAttribute1" /></td>
                                        <td><input type="text" class="form-control form-control-sm" value="@attr.Label" @onchange="e => UpdateAttrLabel(idx, e)" placeholder="Display Label" /></td>
                                        <td>
                                            <select class="form-select form-select-sm" value="@attr.Type" @onchange="e => UpdateAttrType(idx, e)">
                                                <option value="String">String</option>
                                                <option value="Choice">Choice</option>
                                            </select>
                                        </td>
                                        <td class="text-center"><input type="checkbox" class="form-check-input" checked="@attr.Required" @onchange="e => UpdateAttrRequired(idx, e)" /></td>
                                        <td class="text-center"><input type="checkbox" class="form-check-input" checked="@attr.AllowClear" @onchange="e => UpdateAttrAllowClear(idx, e)" /></td>
                                        <td><input type="number" class="form-control form-control-sm" value="@attr.MaxLength" @onchange="e => UpdateAttrMaxLength(idx, e)" placeholder="—" /></td>
                                        <td><input type="text" class="form-control form-control-sm" value="@attr.Pattern" @onchange="e => UpdateAttrPattern(idx, e)" placeholder="none" title="Optional regular expression a saved value must match; add ^ and $ to match the whole value." /></td>
                                        <td>
                                            <select class="form-select form-select-sm" value="@attr.Level" @onchange="e => UpdateAttrLevel(idx, e)">
                                                <option value="1">1</option>
                                                <option value="2">2</option>
                                                <option value="3">3</option>
                                            </select>
                                        </td>
                                        <td><button class="btn btn-outline-danger btn-sm" @onclick="() => RemoveAttribute(idx)">×</button></td>
                                    </tr>
                                    @if (attr.Type == "Choice")
                                    {
                                        <tr>
                                            <td colspan="8" class="ps-4 pt-0">
                                                <small class="text-muted">Choices (comma-separated):</small>
                                                <input type="text" class="form-control form-control-sm" value="@string.Join(", ", attr.Choices ?? [])" @onchange="e => UpdateAttrChoices(idx, e)" placeholder="Option1, Option2, Option3" />
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
    }

    @* Module Admins (global admin only) *@
    @if (isGlobalAdmin)
    {
        <div class="adm-pane @PaneClass(SecAdmins)">

                <p class="text-muted mb-2"><small>Groups that can manage this module's configuration without global admin access.</small></p>

                @if (moduleAdminsUnreadable)
                {
                    <div class="alert alert-danger py-2 mb-2">
                        <small><strong>Module admin groups cannot be read.</strong> The list below is not the stored groups, and saving is disabled. @SettingsStoreText.ModuleAdmins()</small>
                    </div>
                }

                @* Rows, not chips - same reasoning as the Access pane, and this is a list the
                   owner expects to reach 10-20 entries. *@
                <table class="adm-tbl">
                    <thead><tr><th>Group</th><th></th></tr></thead>
                    <tbody>
                        @if (moduleAdminGroups.Count == 0)
                        {
                            <tr><td colspan="2" class="adm-empty">None - only global admins can change this module.</td></tr>
                        }
                        @foreach (var group in moduleAdminGroups.ToList())
                        {
                            var capturedGroup = group;
                            <tr>
                                <td class="adm-grp" title="@capturedGroup">@DisplayNameFor(capturedGroup)</td>
                                <td class="adm-act">
                                    <button class="adm-rm" type="button" @onclick="() => RemoveModuleAdmin(capturedGroup)">Remove</button>
                                </td>
                            </tr>
                        }
                        <tr>
                            <td colspan="2">
                                <div class="input-group input-group-sm" style="max-width: 30rem;">
                                    <ADIdentityAutocomplete ObjectKind="Group" ReturnValueKind="SID" @bind-Value="newAdminGroup" OnResultSelected="RememberGroupDisplayName" Placeholder="Search groups in any domain..." />
                                    <button class="btn btn-outline-secondary" type="button" @onclick="AddModuleAdmin">Add</button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
        </div>
    }

    @* One save bar for all five panes, replacing five separate buttons that gave no sign another
       section was still unsaved. It counts the pending edits and names the sections holding them:
       a count alone tells an operator something is wrong but not where, and a section name alone
       leaves ten edits reading as one. *@
    <div class="adm-bar">
        @if (dirty.IsDirty)
        {
            <span class="adm-dirty">&#9679; @dirty.Summary()</span>
        }
        else
        {
            <span class="adm-clean">No unsaved changes</span>
        }
        <span class="adm-grow"></span>
        <button class="btn btn-outline-secondary btn-sm" @onclick="ReloadAsync" disabled="@(saving || !dirty.IsDirty)">Discard</button>
        <button class="btn btn-primary btn-sm" @onclick="SaveCurrentTabAsync" disabled="@(saving || !CanSaveCurrentTab())">Save</button>
    </div>
</div>

@code {
    [Parameter] public string ModuleId { get; set; } = "";

    private string currentUser = string.Empty;
    private bool authChecked;
    private bool isGlobalAdmin;
    private bool saving;
    private string? statusMessage;
    private bool statusIsError;

    private AdminModuleDescriptor? module;
    private Dictionary<string, string> currentConfigState = new();
    private List<string> moduleAdminGroups = new();
    private string newAdminGroup = string.Empty;

    // What the page loaded. The save bar counts ACTUAL pending edits, so every section holding a
    // working copy of stored state counts its own diff against these rather than tallying events.
    // The config baseline is copied with the case-insensitive comparer named: a dictionary copy does
    // not inherit its source's comparer, and the store's is case-insensitive, so the copy cannot meet
    // two casings of one key. The access baseline is keyed by the catalog's policy aliases, as
    // accessState is (aud-a26n).
    private Dictionary<string, string> configBaseline = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, List<string>> accessBaseline = new();
    private List<string> moduleAdminGroupsBaseline = new();
    private bool moduleEnabledBaseline;

    private List<string> policyAliases = new();

    /// <summary>
    /// Modules whose protection gate actually consults <see cref="ProtectedPrincipalServicerService"/>.
    /// </summary>
    /// <remarks>
    /// An explicit list, not a descriptor flag. A servicer grant does something only where a gate
    /// calls <c>Evaluate</c>, and that is gate CODE, not metadata - a descriptor field would let a
    /// module advertise the capability by declaration and silently grant nothing. Every entry below
    /// is verified against a real <c>Evaluate</c> caller in that module's gate.
    ///
    /// Add a module here in the same commit that adds its <c>Evaluate</c> call, never before.
    ///
    /// The broadcast-list module is deliberately absent, and its absence is the rule working, not
    /// an omission: it runs no principal-protection check of either kind (owner ruling
    /// 2026-09-30, <c>.agents/decisions.md</c>), so there is no gate for a servicer grant to
    /// override and an entry here would advertise a capability that does nothing.
    /// </remarks>
    private static readonly HashSet<string> ModulesWithProtectedPrincipalServicing =
        new(StringComparer.OrdinalIgnoreCase)
        {
            "BlockedSenders", "ConferenceRooms", "MfaReset", "EmergencyDisable",
            "ADAttributeEditor", "MailboxPermissions", "CalendarPermissions", "OutOfOffice",
            "GroupManagement", "M365GroupManagement", "SelfServiceGroups", "Migration",
            "AccountLockoutRemediation", "LicensingUpdates", "RiskyUsers", "IntuneDevices",
            "CloudPasswordReset",
        };

    /// <summary>The servicer section-access key for this module, or null where it has not opted in.</summary>
    private string? ServicerAlias;
    private Dictionary<string, List<string>> accessState = new();
    private Dictionary<string, string> accessInputs = new();

    // Section names appear verbatim in the unsaved-changes prompt, so they read as this page's
    // headings rather than as field names.
    //
    // Prefixed "Sec" rather than "Section" deliberately: "SectionAccess" collides with the
    // injected SectionAccessService of the same name and fails to compile.
    private const string SecStatus = "Module Status";
    private const string SecAccess = "Section Access";
    private const string SecConfig = "Configuration";
    private const string SecAttrs = "Editable Attributes";
    private const string SecAdmins = "Module Admins";

    private readonly AdminPageDirtyState dirty = new();

    /// <summary>Which tab is showing. Set in OnParametersSetAsync to the first one available.</summary>
    private string tab = SecStatus;

    private string TabClass(string section) => tab == section ? "on" : "";

    private string PaneClass(string section) => tab == section ? "on" : "";

    /// <summary>Total groups granted across every permission of this module, for the tab count.</summary>
    private int AccessGroupCount() => accessState.Values.Sum(v => v.Count);

    /// <summary>
    /// The NetBIOS domain column for a stored group value, or "-" when unknown.
    /// </summary>
    /// <remarks>
    /// Split into its own column rather than prefixed onto the name so the rows align: with
    /// DOMAIN\Name in one cell, a long domain pushes every name to a different x-position.
    /// </remarks>
    private string DomainOf(string groupValue)
    {
        var shown = DisplayNameFor(groupValue);
        var slash = shown.IndexOf('\\');
        return slash > 0 ? shown[..slash] : "-";
    }

    /// <summary>
    /// True when a servicer group holds no DIRECT grant on the module's main permission.
    /// </summary>
    /// <remarks>
    /// The servicer key is a separate section-access key, so granting it conveys no module access:
    /// a group listed only under servicing is stopped by the page's own [Authorize] policy before
    /// any protection gate consults the grant. Found live on 2026-08-11, where
    /// ANALOG\ExchangeWebAdminsExecSupport held ProtectedServicer:CalendarPermissions with no
    /// CalendarPermissions grant.
    ///
    /// DIRECT is the whole caveat. Group membership nests, and this page compares stored SIDs
    /// without expanding either list, so a group missing from the main permission may still reach
    /// the module through one that is present. That makes a false positive possible and a false
    /// negative not: every genuinely stranded grant is flagged. The wording it drives must stay
    /// conditional for that reason - an admin who finds the warning wrong once will ignore it after.
    /// </remarks>
    private bool ServicerGroupLacksDirectModuleAccess(string groupValue)
    {
        if (module == null) return false;

        return !accessState.TryGetValue(module.MainPermission.PolicyAlias, out var moduleGroups)
            || !moduleGroups.Contains(groupValue, StringComparer.OrdinalIgnoreCase);
    }

    /// <summary>
    /// The operator-facing sentence for one policy alias on the Access tab.
    /// </summary>
    /// <remarks>
    /// Looked up from the descriptor rather than stored alongside policyAliases, so the sentence
    /// shown here is the same one the catalog declares and cannot drift from it. Every alias in
    /// policyAliases except the servicer key resolves; the servicer key never reaches this method
    /// (it renders in its own section, with its own warning), so an empty string is the correct
    /// answer for an alias with no descriptor rather than a placeholder that reads as a permission.
    /// </remarks>
    /// <summary>
    /// The heading for one policy alias on the Access tab: the descriptor's display name when it
    /// declares one, otherwise the alias itself.
    /// </summary>
    /// <remarks>
    /// Same lookup shape and same fallback reasoning as <see cref="PermissionDescriptionFor"/>:
    /// read from the descriptor so the heading cannot drift from the catalog, and answer with the
    /// alias for anything that does not resolve. The servicer key never reaches this method - it
    /// renders in its own section below - and returning the alias for it would be correct anyway,
    /// which is why this cannot produce a blank heading.
    /// </remarks>
    private string PermissionLabelFor(string alias)
    {
        if (module == null) return alias;

        if (string.Equals(module.MainPermission.PolicyAlias, alias, StringComparison.OrdinalIgnoreCase))
            return module.MainPermission.DisplayName ?? alias;

        foreach (var gp in module.GranularPermissions)
        {
            if (string.Equals(gp.PolicyAlias, alias, StringComparison.OrdinalIgnoreCase))
                return gp.DisplayName ?? alias;
        }

        return alias;
    }

    private string PermissionDescriptionFor(string alias)
    {
        if (module == null) return string.Empty;

        if (string.Equals(module.MainPermission.PolicyAlias, alias, StringComparison.OrdinalIgnoreCase))
            return module.MainPermission.Description;

        foreach (var gp in module.GranularPermissions)
        {
            if (string.Equals(gp.PolicyAlias, alias, StringComparison.OrdinalIgnoreCase))
                return gp.Description;
        }

        return string.Empty;
    }

    /// <summary>The group name without its domain prefix, for the Group column.</summary>
    private string BareNameOf(string groupValue)
    {
        var shown = DisplayNameFor(groupValue);
        var slash = shown.IndexOf('\\');
        return slash >= 0 && slash < shown.Length - 1 ? shown[(slash + 1)..] : shown;
    }

    /// <summary>
    /// Saves whatever the visible tab owns. One button replaces five, but it must not save
    /// sections the operator is not looking at: each save has its own authorization re-check and
    /// its own corrupt-store refusal, and firing all five would turn one refusal into a confusing
    /// partial result.
    /// </summary>
    private async Task SaveCurrentTabAsync()
    {
        // aud-a67. One save at a time from this button. The button is disabled while `saving`, but a click the browser sent
        // before that render arrived - a double click - ran a second save beside the first, and whichever finished first
        // cleared `saving` in its finally, so the button came back while the other was still running. Each save sets
        // `saving` before its first await, so the second click reads it here (the aud-a28o shape, at the event).
        //
        // The guard is here and not in StartSaveAsync: it closes the way a second save is STARTED, and aud-a66's defence
        // against one that is already in flight stays exactly as it was. That defence is still reachable - a route change
        // that outlasts its bound loads the next module and LoadState clears `saving`, so a new save can begin while the
        // old one is still running - and it is what makes a late save harmless whatever started it.
        if (saving)
            return;

        await StartSaveAsync();
    }

    /// <summary>
    /// Runs the visible tab's save, registered in <see cref="savesInFlight"/> for the load it began on until it completes
    /// (aud-a66). Internal so a test can start a save the way one that is already in flight behaves, past the button's
    /// one-at-a-time guard (aud-a67).
    /// </summary>
    internal async Task StartSaveAsync()
    {
        // aud-a66. The load and the module the save is for, taken before it starts: a route change waits only for the saves
        // of the load it replaces, and its notice names the module of any save it stops waiting for.
        var started = load;
        var name = module?.DisplayName ?? ModuleId;
        var save = tab switch
        {
            SecStatus => SaveModuleEnablementAsync(),
            SecAccess => SaveSectionAccessAsync(),
            SecConfig => SaveConfigAsync(),
            SecAttrs => SaveAllowlistAsync(),
            SecAdmins => SaveModuleAdminsAsync(),
            _ => Task.CompletedTask,
        };
        var entry = (Save: save, Load: started, Module: name);
        savesInFlight.Add(entry);
        try
        {
            await save;
        }
        finally
        {
            savesInFlight.Remove(entry);
        }
    }

    // aud-a41, aud-a66. The saves the Save button started, until each completes, with the load each began on and its module's
    // name. The page is reused when its route moves to another module, and a save's directory confirmation and store write run
    // off the circuit, so another module can be opened while saves wait; the parameter load waits for these first, so a save's
    // bookkeeping lands on the state of the module it saved and not on the next one's. A list, not one field: a double click
    // before the disabled Save renders, or a direct event, starts a second save before the first ends, and a field holding
    // only the latest let the route change load another module under the first, which then wrote to it (aud-a66).
    private readonly List<(Task Save, int Load, string Module)> savesInFlight = new();

    // aud-a66 (codex settings-batch-6). The longest a route change waits for those saves: the store's one busy wait (aud-a41;
    // measured up to 5.97 s) with 5 s for the rest of a save. Unbounded, a store that never answered held every later move of
    // this page instance until a new circuit. A directory confirmation can take longer (up to 30 s per new grant on the
    // runspace lock); past the bound the next module loads anyway, and the save's captured state keeps it off that module:
    // Shows refuses its write, Holds its page state. An instance field, so a test can shorten it.
    private TimeSpan saveWaitBound = ExchangeAdminWeb.Services.Storage.SqliteConnectionFactory.BusyTimeout + TimeSpan.FromSeconds(5);

    // aud-a66. The page's loads, counted by LoadState - the one place the page's module and its state are replaced.
    private int load;

    /// <summary>
    /// aud-a66. Whether the page still shows the module a save took before its first await: the test before its write. On
    /// the module id, not the load - the write is the save's own captured diff, decided row by row under the write lock, so
    /// whether it may go ahead depends on its target, not on whether the page read that module again.
    /// </summary>
    private bool Shows(string moduleId) => string.Equals(module?.Id, moduleId, StringComparison.Ordinal);

    /// <summary>
    /// aud-a66. Whether the page still holds the load a save began on: the test before the save changes any page state. A
    /// later load, of this module or another, is not the state the save diffed against.
    /// </summary>
    private bool Holds(int started) => module is not null && load == started;

    // aud-a66. What a save says, and records, when its page moved to another module while it waited - for the directory, or
    // for its authorization re-check - before it wrote anything.
    private const string PageMovedRefusal =
        "Not saved: the page moved to another module while this save waited, so nothing was written. Open the module again and save.";

    // aud-a66. A save's message on a load other than the one it began on: named for its module, so it cannot be read as being
    // about the module shown.
    private static string? OnAnotherModule(AdminModuleDescriptor saved, string? message) =>
        message is null ? null : $"{saved.DisplayName}: {message}";

    /// <summary>
    /// aud-a41, aud-a66. Waits for every unfinished save of the current load - looking again after each one ends, so a save
    /// started meanwhile is waited for too - for at most <see cref="saveWaitBound"/> in all.
    /// </summary>
    /// <returns>The names of the modules whose saves were still running when the bound ran out; null when none was.</returns>
    /// <remarks>
    /// A save of an earlier load is not waited for: the route change that stopped waiting for it has loaded since, and the
    /// save can no longer touch the page (Shows, Holds), so a save that never ends costs one bounded wait, not every move
    /// after it. Task.WhenAny, as aud-a41's wait was: a save that faulted is finished, and its fault is its own handler's.
    /// </remarks>
    private async Task<List<string>?> WaitForThisLoadsSavesAsync()
    {
        var waited = System.Diagnostics.Stopwatch.StartNew();
        while (savesInFlight.FirstOrDefault(s => s.Load == load && !s.Save.IsCompleted) is { Save: not null } inFlight)
        {
            var left = saveWaitBound - waited.Elapsed;
            if (left <= TimeSpan.Zero)
            {
                return savesInFlight
                    .Where(s => s.Load == load && !s.Save.IsCompleted)
                    .Select(s => s.Module)
                    .Distinct(StringComparer.Ordinal)
                    .ToList();
            }

            using var timer = new CancellationTokenSource();
            await Task.WhenAny(inFlight.Save, Task.Delay(left, timer.Token));
            timer.Cancel();
        }

        return null;
    }

    // aud-a66 (codex settings-batch-6). What a route change shows when it stopped waiting for a save: which module's save is
    // still running, and that it cannot change the module now shown. Seconds in the invariant culture, as the bound is fixed.
    private string UnfinishedSaveNotice(List<string> unfinished, AdminModuleDescriptor next)
    {
        var modules = string.Join(", ", unfinished);
        var seconds = saveWaitBound.TotalSeconds.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
        return $"A save on {modules} had not finished after {seconds} seconds, so this page opened {next.DisplayName} without waiting for it any longer. "
            + $"That save can change only {modules}, never {next.DisplayName}: if it had not written yet it refuses, and when it ends its outcome is recorded in the audit log. Open {modules} again to see what is stored.";
    }

    /// <summary>Whether the visible tab's store was read when the page loaded, so Save is offered.</summary>
    /// <remarks>
    /// aud-a28j. A tab whose store did not load holds the fallback, not the stored state, and has nothing
    /// to save over it. Withholding the button is the courtesy; each save refuses the same case itself.
    /// </remarks>
    private bool CanSaveCurrentTab() => tab switch
    {
        SecStatus => !enablementStoreCorrupt,
        SecAccess => !sectionAccessCorrupt,
        SecConfig => !moduleConfigCorrupt,
        SecAttrs => !allowlistCorrupt,
        SecAdmins => !moduleAdminsUnreadable,
        _ => true,
    };

    /// <summary>
    /// Discards edits by reloading the page from the store. Clears dirty state FIRST, or the
    /// unsaved-changes guard blocks the very navigation the operator asked for.
    /// </summary>
    /// <remarks>
    /// Clearing is not enough on its own: <see cref="UnsavedChangesGuard"/> receives the flag as a
    /// parameter and arms the browser's beforeunload from it, so until a render carries the
    /// cleared value down, both the in-app confirm and the browser's "Leave site?" still fire on
    /// the navigation the operator just asked for. Hence the explicit render and the yield that
    /// lets its batch go out ahead of the navigation on the same circuit.
    /// </remarks>
    private async Task ReloadAsync()
    {
        dirty.Clear();
        StateHasChanged();
        await Task.Yield();
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    /// <summary>The first tab this operator can actually see, so the page never opens on a hidden one.</summary>
    private string FirstVisibleTab()
    {
        if (module is null) return SecStatus;
        if (!module.IsSystemModule) return SecStatus;
        if (isGlobalAdmin) return SecAccess;
        if (module.ConfigFields.Count > 0) return SecConfig;
        return SecStatus;
    }

    // SID -> friendly name, for display only. Seeded from the store and topped up as groups are
    // picked, so a group added in this session shows its name before any save/reload.
    private Dictionary<string, string> accessDisplayNames = new(StringComparer.OrdinalIgnoreCase);

    // aud-a26n. The names picked from the directory on this page - the only ones an access save stores.
    private readonly Dictionary<string, string> pickedDisplayNames = new(StringComparer.OrdinalIgnoreCase);

    private string? loadedModuleId;
    private bool moduleEnabled;
    private bool enablementStoreCorrupt;
    private bool moduleConfigCorrupt;
    private bool sectionAccessCorrupt;
    private bool sectionAccessUnconfigured;

    // aud-a28j. GetModuleAdmins reads an unreadable store as no admins, with no banner, and a save from
    // that empty list replaced the module's admin groups with it.
    private bool moduleAdminsUnreadable;

    protected override async Task OnParametersSetAsync()
    {
        if (ModuleId == loadedModuleId) return;

        // aud-a67. The module this load is for, taken before its first await and used for all of it. ModuleId is a
        // parameter and the router sets it again on the next route change, so every read after an await could be a
        // different module from the one before: the descriptor was fetched with one read and the delegated-admin check
        // made with another, on either side of the authorization await, so a second route change in that window could
        // pair one module's check with another module's page. It also made this call load the newer module and the call
        // the router made for it find nothing to do - one route change's work done twice, the other's not at all.
        var requested = ModuleId;

        // aud-a41, aud-a66. The saves on the module shown finish before another module is loaded over it - for at most
        // saveWaitBound (see savesInFlight and WaitForThisLoadsSavesAsync).
        var unfinished = await WaitForThisLoadsSavesAsync();
        if (requested == loadedModuleId) return;

        loadedModuleId = requested;

        authChecked = false;
        statusMessage = null;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUser = user.Identity?.Name ?? "Unknown";

        // aud-a66. Into a local, and shown with its state after the awaits below: until then the page keeps the module it shows
        // and that module's state, so a save started while this load waits takes one module's id with that module's state.
        var next = Catalog.GetById(requested);
        if (next == null || next.IsSystemModule)
        {
            authChecked = true;
            module = null;
            return;
        }

        // Config-only modules have their own dedicated page
        if (next.IsConfigOnly)
        {
            Navigation.NavigateTo(next.Route, replace: true);
            return;
        }

        var adminResult = await AuthorizationService.AuthorizeAsync(user, "AdminSettings");
        isGlobalAdmin = adminResult.Succeeded;

        if (!isGlobalAdmin && !ModuleAdmin.IsModuleAdmin(requested, user))
        {
            Navigation.NavigateTo("access-denied", forceLoad: true);
            return;
        }

        module = next;
        LoadState();

        // After LoadState, because the visible tabs depend on isGlobalAdmin and the loaded module.
        // Opening on a tab this operator cannot see would render an empty page.
        tab = FirstVisibleTab();

        // aud-a66. Past the bound: say which module's save is still running, and that it cannot change this one.
        if (unfinished is not null)
        {
            statusMessage = UnfinishedSaveNotice(unfinished, next);
            statusIsError = true;
        }

        authChecked = true;
    }

    private void LoadState()
    {
        if (module == null) return;

        // aud-a66. A new load. A save begun on an earlier one changes none of this state (Holds) and no longer owns the Save
        // button: one that outlasted the route change's wait would otherwise keep this module's Save disabled.
        load++;
        saving = false;

        // aud-a67. And no unsaved edits: everything below is read from the store, so every baseline this load sets is the
        // state it has just read and nothing on the page differs from it yet. Only ReloadAsync and the saves cleared the
        // counts, so a move to another module on this page instance carried the previous module's: its counts in the save
        // bar, its dots on tabs whose lists had been replaced, and the unsaved-changes guard warning about edits that were
        // no longer anywhere on the page.
        dirty.Clear();

        enablementStoreCorrupt = Enablement.IsStoreCorrupt();
        moduleConfigCorrupt = ModuleConfigSvc.IsModuleCorrupt(module.Id);
        sectionAccessCorrupt = SectionAccess.IsFragmentCorrupt();
        // aud-a28j. Not asked of a store already known corrupt: that read throws, and the whole page failed
        // to load instead of showing the access tab's banner.
        sectionAccessUnconfigured = !sectionAccessCorrupt && !SectionAccess.IsSectionAccessConfigured();

        currentConfigState = ModuleConfigSvc.GetModuleConfig(module.Id);
        moduleEnabled = Enablement.IsModuleRawEnabled(module.Id);
        moduleAdminsUnreadable = !ModuleAdmin.TryGetAllGrants(out var adminGrants);
        moduleAdminGroups = (adminGrants.TryGetValue(module.Id, out var admins) ? admins : Array.Empty<string>()).ToList();

        configBaseline = new Dictionary<string, string>(currentConfigState, StringComparer.OrdinalIgnoreCase);
        moduleEnabledBaseline = moduleEnabled;
        moduleAdminGroupsBaseline = new List<string>(moduleAdminGroups);

        policyAliases = new List<string> { module.MainPermission.PolicyAlias };
        foreach (var gp in module.GranularPermissions)
            policyAliases.Add(gp.PolicyAlias);

        // The servicer alias joins policyAliases so it inherits the EXISTING load and save path
        // rather than adding a second one: it is loaded, confirmed against the directory, compared
        // under the write lock with what the page loaded, and recorded exactly as the module's other
        // grants are, by the one save of this tab (SectionAccessService.SaveEditedAliases). A second
        // path would have to repeat every one of those guards to be as safe.
        ServicerAlias = ModulesWithProtectedPrincipalServicing.Contains(module.Id)
            ? ProtectedPrincipalServicerService.SectionKeyFor(module.Id)
            : null;
        if (ServicerAlias is not null)
            policyAliases.Add(ServicerAlias);

        accessState = new();
        accessInputs = new();
        foreach (var alias in policyAliases)
        {
            accessState[alias] = new List<string>(SectionAccess.GetGroupsForSection(alias));
            accessInputs[alias] = string.Empty;
        }
        SnapshotAccessBaseline();

        // Display names are cosmetic, so a store that cannot supply them must not break the page:
        // DisplayNameFor falls back to the stored value.
        try
        {
            accessDisplayNames = SectionAccess.GetGroupDisplayNames();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not read section-access display names; showing stored values");
            accessDisplayNames = new(StringComparer.OrdinalIgnoreCase);
        }

        if (module.Id == "ADAttributeEditor")
        {
            LoadAllowlist();
            InitOUBrowser();
        }
    }

    private string GetConfigValue(string key, string defaultValue) =>
        currentConfigState.TryGetValue(key, out var val) ? val : defaultValue;

    /// <summary>
    /// Every config field edit funnels through here, so this is the one place the Configuration
    /// section needs to be recounted.
    /// </summary>
    private void SetConfigValue(string key, string value)
    {
        currentConfigState[key] = value;
        RecountConfig();
    }

    /// <summary>
    /// Counts the config keys whose value differs from what the page loaded.
    /// </summary>
    /// <remarks>
    /// Counting choice for this section: a DIFF against the load, not one edit per event. It is
    /// forced, not merely preferred -- the text fields fire on every input event, so a running
    /// tally would count keystrokes. The diff is the same comparison SaveConfigAsync uses
    /// to decide what to audit, so the number in the save bar is the number of changes the audit
    /// entry will name.
    /// </remarks>
    private void RecountConfig() => dirty.SetCount(SecConfig, ChangedConfigKeys().Count);

    /// <summary>The config keys whose value differs from what the page loaded; absent reads as empty.</summary>
    private List<string> ChangedConfigKeys() =>
        configBaseline.Keys.Union(currentConfigState.Keys, StringComparer.OrdinalIgnoreCase)
            .Where(k => (configBaseline.GetValueOrDefault(k, "") ?? "") != (currentConfigState.GetValueOrDefault(k, "") ?? ""))
            .ToList();

    /// <summary>A config key as the Configuration tab heads it: its field label, with the key.</summary>
    // aud-a66. Named by the descriptor the save took, as MaskIfSecret.
    private static string ConfigKeyName(AdminModuleDescriptor saved, string key)
    {
        var field = saved.ConfigFields.FirstOrDefault(f => string.Equals(f.Key, key, StringComparison.OrdinalIgnoreCase));
        return field is null ? key : $"{field.Label} ({key})";
    }

    /// <summary>
    /// Counts section-access groups granted and revoked against what the page loaded, across
    /// every alias this module owns.
    /// </summary>
    /// <remarks>
    /// Counting choice for this section: a DIFF against the load, not one edit per click. The page
    /// holds every alias's working list, so five granted groups read as five, and a group granted
    /// and then revoked before saving stops counting.
    /// </remarks>
    private void RecountAccess()
    {
        var changes = accessState.Sum(kv =>
            GroupDelta(kv.Value, accessBaseline.GetValueOrDefault(kv.Key) ?? new List<string>()));

        dirty.SetCount(SecAccess, changes);
    }

    /// <summary>
    /// Counts module-admin groups added and removed against what the page loaded.
    /// </summary>
    /// <remarks>
    /// Counting choice for this section: a DIFF against the load, same reasoning as Section
    /// Access -- the page holds the whole working list.
    /// </remarks>
    private void RecountAdmins() =>
        dirty.SetCount(SecAdmins, GroupDelta(moduleAdminGroups, moduleAdminGroupsBaseline));

    /// <summary>Additions plus removals between a working group list and the one that was loaded.</summary>
    private static int GroupDelta(List<string> current, List<string> loaded) =>
        current.Except(loaded, StringComparer.OrdinalIgnoreCase).Count()
        + loaded.Except(current, StringComparer.OrdinalIgnoreCase).Count();

    /// <summary>Re-baselines the section-access lists, after a load or a successful save.</summary>
    /// <remarks>
    /// Required after saving, not merely tidy: the access save does not reload the page, so a
    /// stale baseline would count the grants just persisted all over again on the next edit.
    /// </remarks>
    private void SnapshotAccessBaseline() =>
        accessBaseline = accessState.ToDictionary(kv => kv.Key, kv => new List<string>(kv.Value));

    /// <summary>
    /// Toggling the module's enabled switch. The section holds one boolean, so its pending-edit
    /// count is a comparison with the loaded value -- switching it back nets to zero.
    /// </summary>
    private void ToggleModuleEnabled(bool enabled)
    {
        moduleEnabled = enabled;
        dirty.SetCount(SecStatus, moduleEnabled == moduleEnabledBaseline ? 0 : 1);
    }

    /// <summary>
    /// Boolean fields store exactly "true"/"false"; the checkbox is the only
    /// writer, so no operator-typed variant can reach the store from this page.
    /// </summary>
    private void SetBooleanConfigValue(string key, ChangeEventArgs e) =>
        SetConfigValue(key, (bool)(e.Value ?? false) ? "true" : "false");

    private async Task SaveConfigAsync()
    {
        if (module == null) return;

        // aud-a28n. Only the keys the admin changed, each decided under the write lock against its row and the
        // value this page loaded. Replacing the whole config from the page's copy wrote back every key changed
        // elsewhere since the load - keys the page does not show, such as the ExcludedUsers protection list,
        // included.
        // aud-a41. Taken before the write, which runs off the circuit - it can wait up to the store's busy timeout for a lock
        // held elsewhere - and the baseline below takes what was written, so a value typed while it waited stays unsaved.
        // aud-a66. All of it, with the module, its id, the page's load and the load's corrupt flag, before the first await:
        // the page can open another module - or this one again - while the save waits, and nothing after an await may read
        // the page for this save. The record masks secrets and names keys by this descriptor too.
        var saved = module;
        var moduleId = saved.Id;
        var started = load;
        var loadedCorrupt = moduleConfigCorrupt;
        var changed = ChangedConfigKeys();
        var loadedValues = changed.ToDictionary(k => k, k => configBaseline.GetValueOrDefault(k, "") ?? "", StringComparer.OrdinalIgnoreCase);
        var wantedValues = changed.ToDictionary(k => k, k => currentConfigState.GetValueOrDefault(k, "") ?? "", StringComparer.OrdinalIgnoreCase);
        saving = true;
        statusMessage = null;
        await Task.Yield();

        // aud-a28h. Every save on this page records each refusal and its catch under the section its
        // success files under, not only a success: a refused or failed attempt on section access or
        // module admins - who can reach and run a module - used to leave no trace. The section and ip
        // are worked out above the try so the catch has them.
        var section = $"ModuleConfig:{moduleId}";
        var ip = ClientInfo.GetIpForUser(currentUser);
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var adminResult = await AuthorizationService.AuthorizeAsync(user, "AdminSettings");
            if (!adminResult.Succeeded && !ModuleAdmin.IsModuleAdmin(moduleId, user))
            {
                statusMessage = "You are not authorized to configure this module.";
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "Authorization", statusMessage);
                return;
            }

            if (ModuleConfigSvc.IsModuleCorrupt(moduleId))
            {
                if (Holds(started)) moduleConfigCorrupt = true;
                statusMessage = "Refusing to save: saving would overwrite this module's stored configuration with the rendered fallback values. Nothing was changed. "
                    + SettingsStoreText.ModuleConfig(moduleId);
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "StoreCorrupt", statusMessage);
                return;
            }

            // aud-a28j. The check above says the store reads now; this one says the fields came from it. A
            // load that could not read it left blank fields, and the check above passes once it reads again.
            if (loadedCorrupt)
            {
                statusMessage = "Refusing to save: this page does not hold the module's stored configuration (it could not be read), so saving would overwrite it with the blank fields shown. Nothing was changed. Reload the page.";
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "StoreUnreadable", statusMessage);
                return;
            }

            // aud-a66. Immediately before the write: a page that moved to another module while this save waited gets nothing.
            if (!Shows(moduleId))
            {
                statusMessage = PageMovedRefusal;
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "PageMoved", statusMessage);
                return;
            }

            var outcome = await Task.Run(() => ModuleConfigSvc.SaveChangedValues(moduleId, loadedValues, wantedValues));
            if (outcome.Status == ModuleConfigSaveStatus.StoreCorrupt)
            {
                if (Holds(started)) moduleConfigCorrupt = true;
                statusMessage = "Refusing to save: this module's stored configuration could not be read as the save went to change it. Nothing was changed. "
                    + SettingsStoreText.ModuleConfig(moduleId);
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "StoreCorrupt", statusMessage);
                return;
            }

            if (outcome.Status == ModuleConfigSaveStatus.ConcurrentChange)
            {
                var one = outcome.ConflictingKeys.Count == 1;
                statusMessage = $"Refusing to save: the stored value of {string.Join(", ", outcome.ConflictingKeys.Select(k => ConfigKeyName(saved, k)))} {(one ? "was" : "were")} changed after this page loaded {(one ? "it" : "them")} - by another administrator, or on the other instance. Nothing was saved. Reload the page and re-apply your changes.";
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "ConcurrentChange", statusMessage);
                return;
            }

            var written = changed.Where(k => !outcome.AlreadyApplied.Contains(k, StringComparer.OrdinalIgnoreCase)).ToList();
            if (changed.Count > 0)
            {
                try
                {
                    var prevKeys = written.Select(k => $"{k}={MaskIfSecret(saved, k, outcome.Before.GetValueOrDefault(k) ?? "")}").ToArray();
                    var newKeys = written.Select(k => $"{k}={MaskIfSecret(saved, k, outcome.After.GetValueOrDefault(k) ?? "")}").ToArray();
                    var extra = new Dictionary<string, object?>();
                    if (outcome.AlreadyApplied.Count > 0)
                        extra["alreadyApplied"] = outcome.AlreadyApplied.ToArray();
                    // aud-a26n. A secret changed from one value to another masks to Key=*** on both sides, and the two
                    // cancel in added and removed, so the record showed no change at all: it names the key instead.
                    // Names only - never a value.
                    var changedSecretKeys = written
                        .Where(k => IsSecretField(saved, k)
                            && !string.Equals(outcome.Before.GetValueOrDefault(k) ?? "", outcome.After.GetValueOrDefault(k) ?? "", StringComparison.Ordinal))
                        .ToArray();
                    if (changedSecretKeys.Length > 0)
                        extra["changedSecretKeys"] = changedSecretKeys;
                    Audit.LogSettingsChange(currentUser, ip, section, prevKeys, newKeys, extra.Count > 0 ? extra : null);
                }
                catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for module config change"); }
            }

            // Re-baseline here, not merely tidy: this save does not reload the page, so a stale
            // baseline would count the values just persisted all over again on the next edit.
            // aud-a66. Only on the load this save began on: another load's state is not what it diffed against.
            if (Holds(started))
            {
                foreach (var (key, value) in wantedValues)
                    configBaseline[key] = value;
                RecountConfig();
            }
            statusMessage = changed.Count == 0
                ? "Configuration is unchanged; there was nothing to save."
                : written.Count == 0
                    ? "Configuration saved: every changed value was already stored - set the same way elsewhere after this page loaded - so nothing needed writing."
                    : "Configuration saved.";
            statusIsError = false;
        }
        catch (Exception ex)
        {
            statusMessage = Audit.LogSettingsSaveException(Logger, currentUser, ip, section, ex, $"Failed to save: {ex.Message}");
            statusIsError = true;
        }
        finally
        {
            // aud-a66. On another load the Save button belongs to that load, and this save's message names its module.
            if (Holds(started)) saving = false;
            else statusMessage = OnAnotherModule(saved, statusMessage);
        }
    }

    private async Task SaveModuleEnablementAsync()
    {
        if (module == null) return;

        // aud-a28k. This module only, and only when toggled, decided against its row under the write lock:
        // the whole-map write it replaces switched back any module changed elsewhere between its read and
        // its write.
        // aud-a41. The toggle written, and the baseline after it, are the one this save began with; the write runs off the
        // circuit, and a toggle switched while it waits stays counted for the reload's guard.
        // aud-a66. Both, with the module, its id, the page's load and the load's corrupt flag, before the first await (as
        // SaveConfigAsync).
        var saved = module;
        var moduleId = saved.Id;
        var started = load;
        var loadedCorrupt = enablementStoreCorrupt;
        var wanted = moduleEnabled;
        var baseline = moduleEnabledBaseline;
        saving = true;
        statusMessage = null;
        await Task.Yield();

        var section = $"Module:{moduleId}";
        var ip = ClientInfo.GetIpForUser(currentUser);
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authResult = await AuthorizationService.AuthorizeAsync(authState.User, "AdminSettings");
            if (!authResult.Succeeded)
            {
                statusMessage = "Only global admins can change module status.";
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "Authorization", statusMessage);
                return;
            }

            if (Enablement.IsStoreCorrupt())
            {
                if (Holds(started)) enablementStoreCorrupt = true;
                statusMessage = "Refusing to save: saving now would overwrite the stored module enablement with the all-disabled fallback. Nothing was changed. "
                    + SettingsStoreText.Enablement(Enablement.LegacyImportFailed);
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "StoreCorrupt", statusMessage);
                return;
            }

            // aud-a28j. The same for the toggle: it is the all-disabled fallback when the load could not read it.
            if (loadedCorrupt)
            {
                statusMessage = "Refusing to save: this page's toggle is not the stored module enablement state (the store could not be read), so saving it could switch the module off. Nothing was changed. Reload the page.";
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "StoreUnreadable", statusMessage);
                return;
            }

            // aud-a66. Immediately before the write, as SaveConfigAsync.
            if (!Shows(moduleId))
            {
                statusMessage = PageMovedRefusal;
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "PageMoved", statusMessage);
                return;
            }

            var changes = wanted == baseline
                ? new Dictionary<string, bool>()
                : new Dictionary<string, bool> { [moduleId] = wanted };
            var outcome = await Task.Run(() => Enablement.SetModulesEnabled(changes));
            if (outcome.StoreCorrupt)
            {
                if (Holds(started)) enablementStoreCorrupt = true;
                statusMessage = "Refusing to save: saving now would overwrite the stored module enablement with the all-disabled fallback. Nothing was changed. "
                    + SettingsStoreText.Enablement(Enablement.LegacyImportFailed);
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "StoreCorrupt", statusMessage);
                return;
            }

            foreach (var change in outcome.Written)
            {
                try
                {
                    Audit.LogSettingsChange(currentUser, ip, section,
                        change.Before ? new[] { "Enabled" } : Array.Empty<string>(),
                        change.After ? new[] { "Enabled" } : Array.Empty<string>());
                }
                catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for module status change"); }
            }

            // aud-a66. The baseline, the count, the render and the reload belong to the load this save began on; on another the
            // page is not reloaded under the module it now shows, and the message names this save's module.
            if (Holds(started))
            {
                moduleEnabledBaseline = wanted;
                dirty.SetCount(SecStatus, moduleEnabled == moduleEnabledBaseline ? 0 : 1);
                statusMessage = "Module status saved. Refreshing...";
                statusIsError = false;

                // Render BEFORE the reload. Blazor renders an event handler once at its first await
                // and once when it completes - and this handler never completes, it navigates. So
                // without this the browser still holds the pre-save "unsaved changes" flag that
                // UnsavedChangesGuard armed, and the forced reload trips both the in-app confirm and
                // the browser's "Leave site?" over a change that has already been written. It also
                // makes the "Refreshing..." message above actually appear during the delay.
                StateHasChanged();
                await Task.Delay(500);
                Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
            }
            else
            {
                statusMessage = "Module status saved.";
                statusIsError = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = Audit.LogSettingsSaveException(Logger, currentUser, ip, section, ex, $"Failed to save module status: {ex.Message}");
            statusIsError = true;
        }
        finally
        {
            // aud-a66. On another load the Save button belongs to that load, and this save's message names its module.
            if (Holds(started)) saving = false;
            else statusMessage = OnAnotherModule(saved, statusMessage);
        }
    }

    private async Task SaveSectionAccessAsync()
    {
        if (module == null) return;

        // aud-a1b. What is saved is a SNAPSHOT taken here, and every grant in it that was not
        // loaded is confirmed to be a group in the directory first. The Add buttons stay live
        // while the lookup runs, so persisting the live lists afterwards would let a row added
        // mid-lookup ride an unchecked save.
        // aud-a66. Taken before the first await, not after the authorization re-check, with what it is diffed against (the
        // baseline), the names picked on the page, the sections the records list, the module, its id and the page's load:
        // the page can open another module while the lookup runs, and the aliases and baseline read after it were that
        // module's.
        var saved = module;
        var moduleId = saved.Id;
        var started = load;
        var section = saved.MainPermission.PolicyAlias;
        var loadedCorrupt = sectionAccessCorrupt;
        var aliases = policyAliases.ToList();
        var snapshot = aliases.ToDictionary(a => a, a => accessState[a].ToArray());
        var baseline = accessBaseline.ToDictionary(kv => kv.Key, kv => kv.Value.ToList());
        var picked = new Dictionary<string, string>(pickedDisplayNames, StringComparer.OrdinalIgnoreCase);
        var pending = PendingAccessSections();
        saving = true;
        statusMessage = null;
        await Task.Yield();

        var ip = ClientInfo.GetIpForUser(currentUser);
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authResult = await AuthorizationService.AuthorizeAsync(authState.User, "AdminSettings");
            if (!authResult.Succeeded)
            {
                statusMessage = "Only global admins can change section access.";
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "Authorization", statusMessage, pending);
                return;
            }

            if (SectionAccess.IsFragmentCorrupt())
            {
                if (Holds(started)) sectionAccessCorrupt = true;
                statusMessage = "Refusing to save: saving would replace section-access groups this page cannot see. Nothing was changed. "
                    + SettingsStoreText.SectionAccess(SectionAccess.LegacyImportFailed);
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "StoreCorrupt", statusMessage, pending);
                return;
            }

            // aud-a28j. The lists are this page's load: empty when it could not read the store. Asked before
            // the directory confirmation below, which must not run for a save that cannot happen.
            if (loadedCorrupt)
            {
                statusMessage = "Refusing to save: this page does not hold the stored section access (it could not be read), so saving would replace the stored groups with the empty lists it has. Nothing was changed. Reload the page.";
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "StoreUnreadable", statusMessage, pending);
                return;
            }

            var newGrants = snapshot
                .SelectMany(kv => kv.Value.Except(baseline.GetValueOrDefault(kv.Key) ?? new List<string>(), StringComparer.OrdinalIgnoreCase))
                .ToList();
            var refused = await ConfirmNewGroupGrantsAsync(newGrants);
            if (refused is not null)
            {
                statusMessage = refused;
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "GroupGrantCheck", statusMessage, pending);
                return;
            }

            // aud-a66. After the directory confirmation and before the write: a page that moved to another module while the
            // lookup ran gets nothing - neither this module's diff nor one computed against the other's baseline.
            if (!Shows(moduleId))
            {
                statusMessage = PageMovedRefusal;
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "PageMoved", statusMessage, pending);
                return;
            }

            // aud-a28k. Only the aliases the admin edited - from the confirmed snapshot, never the live lists -
            // each compared under the write lock with what this page loaded; one changed elsewhere since
            // refuses the whole save. Overwriting every alias of the module with the page's snapshot lost
            // grants made or revoked elsewhere, edited or not.
            var edited = aliases
                .Where(a => GroupDelta(snapshot[a].ToList(), baseline.GetValueOrDefault(a) ?? new List<string>()) > 0)
                .ToDictionary(a => a, a => snapshot[a], StringComparer.OrdinalIgnoreCase);
            var loaded = edited.Keys.ToDictionary(
                a => a, a => (baseline.GetValueOrDefault(a) ?? new List<string>()).ToArray(), StringComparer.OrdinalIgnoreCase);

            // aud-a41. Off the circuit, as every write on this page: it can wait up to the store's busy timeout for a lock held
            // elsewhere. The snapshot above is what it writes.
            var outcome = await Task.Run(() => SectionAccess.SaveEditedAliases(loaded, edited));
            if (outcome.Status == SectionAccessSaveStatus.StoreCorrupt)
            {
                if (Holds(started)) sectionAccessCorrupt = true;
                statusMessage = "Refusing to save: saving would replace section-access groups this page cannot see. Nothing was changed. "
                    + SettingsStoreText.SectionAccess(SectionAccess.LegacyImportFailed);
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "StoreCorrupt", statusMessage, pending);
                return;
            }

            if (outcome.Status == SectionAccessSaveStatus.ConcurrentChange)
            {
                statusMessage = $"Refusing to save: the groups for {string.Join(", ", outcome.ChangedAliases.Select(AliasName))} were changed after this page loaded them - by another administrator, or on the other instance. Nothing was saved. Reload the page and re-apply your changes.";
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "ConcurrentChange", statusMessage, pending);
                return;
            }

            // Persisted separately from the grants, and after them: a display name is cosmetic, so
            // failing to store one must never fail the access save that already succeeded.
            //
            // aud-a26n. Only when the save wrote, and only the names picked from the directory on this page for the
            // groups it added to an alias it wrote. Every other name the page holds is the one it loaded, and writing
            // those back reverted a name changed since - on every save not refused, a no-op included. The rows written
            // carry their stored names across (SectionAccessRepository.ReplaceAliases).
            if (outcome.Status == SectionAccessSaveStatus.Saved)
            {
                var writtenAliases = edited
                    .Where(kv => !outcome.AlreadyApplied.Contains(kv.Key, StringComparer.OrdinalIgnoreCase))
                    .ToDictionary(kv => kv.Key, kv => kv.Value, StringComparer.OrdinalIgnoreCase);
                var names = DisplayNamesToStore(writtenAliases, baseline, picked);
                await Task.Run(() => SectionAccess.SaveGroupDisplayNames(names));
            }

            foreach (var (alias, curr) in edited)
            {
                var prev = outcome.Before.TryGetValue(alias, out var stored) ? stored : Array.Empty<string>();
                // aud-a26k. An alias changed elsewhere to exactly what this save wanted was not written; it is
                // recorded as already applied, so the attempt still leaves its trace.
                if (outcome.AlreadyApplied.Contains(alias, StringComparer.OrdinalIgnoreCase))
                {
                    try
                    {
                        Audit.LogSettingsChange(currentUser, ip, alias, prev, curr,
                            new Dictionary<string, object?> { ["alreadyApplied"] = new[] { alias } });
                    }
                    catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for section access change"); }
                }
                else if (!prev.SequenceEqual(curr, StringComparer.OrdinalIgnoreCase))
                {
                    try { Audit.LogSettingsChange(currentUser, ip, alias, prev, curr); }
                    catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for section access change"); }
                }
            }

            // The baseline is what was SAVED, so a row added during the lookup still counts as an
            // unsaved edit rather than vanishing from the dirty count.
            // aud-a66. Only on the load this save began on.
            if (Holds(started))
            {
                accessBaseline = snapshot.ToDictionary(kv => kv.Key, kv => kv.Value.ToList());
                RecountAccess();
            }
            statusMessage = outcome.Status != SectionAccessSaveStatus.NothingToSave
                ? "Section access saved."
                : outcome.AlreadyApplied.Count > 0
                    ? "Section access already held these changes - they were made the same way elsewhere after this page loaded - so nothing needed writing."
                    : "Section access is unchanged; there was nothing to save.";
            statusIsError = false;
        }
        catch (Exception ex)
        {
            statusMessage = Audit.LogSettingsSaveException(Logger, currentUser, ip, section, ex, $"Failed to save: {ex.Message}", pending);
            statusIsError = true;
        }
        finally
        {
            // aud-a66. On another load the Save button belongs to that load, and this save's message names its module.
            if (Holds(started)) saving = false;
            else statusMessage = OnAnotherModule(saved, statusMessage);
        }
    }

    // A successful access save records one change per alias it changed, so there is no one section
    // for an attempt that did not land: its one record is filed under the module's main grant and
    // lists the aliases whose working list differs from the one the page loaded (aud-a28h).
    private string[] PendingAccessSections() =>
        policyAliases
            .Where(a => GroupDelta(
                accessState.GetValueOrDefault(a) ?? new List<string>(),
                accessBaseline.GetValueOrDefault(a) ?? new List<string>()) > 0)
            .ToArray();

    /// <summary>An alias as the admin reads it on the Access tab: its label, with the alias when they differ.</summary>
    private string AliasName(string alias)
    {
        var label = PermissionLabelFor(alias);
        return string.Equals(label, alias, StringComparison.Ordinal) ? alias : $"{label} ({alias})";
    }

    private async Task SaveModuleAdminsAsync()
    {
        if (module == null) return;

        // aud-a1b, the same rule as the access save: confirm every grant this save adds, and
        // persist the snapshot that was confirmed, never the live list.
        // aud-a66. The snapshot, the baseline it is diffed against, the module, its id and the page's load, before the first
        // await: the page can open another module while the lookup runs, and the id and baseline read after it applied this
        // module's diff, computed against the other's baseline, to the other module.
        var saved = module;
        var moduleId = saved.Id;
        var started = load;
        var section = $"ModuleAdmins:{moduleId}";
        var loadedUnreadable = moduleAdminsUnreadable;
        var snapshot = moduleAdminGroups.ToArray();
        var baseline = moduleAdminGroupsBaseline.ToArray();
        saving = true;
        statusMessage = null;
        await Task.Yield();

        var ip = ClientInfo.GetIpForUser(currentUser);
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authResult = await AuthorizationService.AuthorizeAsync(authState.User, "AdminSettings");
            if (!authResult.Succeeded)
            {
                statusMessage = "Only global admins can assign module admins.";
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "Authorization", statusMessage);
                return;
            }

            // aud-a28j. The list is this page's load: empty, not the stored groups, when it could not be read.
            if (loadedUnreadable)
            {
                statusMessage = "Refusing to save: the module admin groups could not be read when this page loaded, so the list shown is not the stored groups and saving would replace them with it. Nothing was changed. Reload the page.";
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "StoreUnreadable", statusMessage);
                return;
            }

            var refused = await ConfirmNewGroupGrantsAsync(
                snapshot.Except(baseline, StringComparer.OrdinalIgnoreCase).ToList());
            if (refused is not null)
            {
                statusMessage = refused;
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "GroupGrantCheck", statusMessage);
                return;
            }

            // aud-a66. After the directory confirmation and before the write, as the access save.
            if (!Shows(moduleId))
            {
                statusMessage = PageMovedRefusal;
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "PageMoved", statusMessage);
                return;
            }

            // aud-a28j. Re-read after the directory confirmation, immediately before the write.
            if (!ModuleAdmin.TryGetAllGrants(out _))
            {
                if (Holds(started)) moduleAdminsUnreadable = true;
                statusMessage = "Refusing to save: the module admin groups cannot be read, so this save cannot be checked against them. Nothing was changed. "
                    + SettingsStoreText.ModuleAdmins();
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "StoreCorrupt", statusMessage);
                return;
            }

            // aud-a28n. Only the groups the admin added and removed - from the confirmed snapshot, never the live
            // list - each decided under the write lock against its row. Replacing the module's whole list from the
            // snapshot dropped a group added elsewhere since the load and restored one removed elsewhere.
            var added = snapshot.Except(baseline, StringComparer.OrdinalIgnoreCase).ToArray();
            var removed = baseline.Except(snapshot, StringComparer.OrdinalIgnoreCase).ToArray();
            var outcome = added.Length + removed.Length == 0 ? null : await Task.Run(() => ModuleAdmin.ApplyAdminChanges(moduleId, added, removed));
            if (outcome is { Readable: false })
            {
                if (Holds(started)) moduleAdminsUnreadable = true;
                statusMessage = "Refusing to save: the module admin groups cannot be read, so this save cannot be checked against them. Nothing was changed. "
                    + SettingsStoreText.ModuleAdmins();
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "StoreCorrupt", statusMessage);
                return;
            }

            if (outcome is not null)
            {
                try
                {
                    Audit.LogSettingsChange(currentUser, ip, section, outcome.Before, outcome.After,
                        outcome.AlreadyApplied.Count > 0
                            ? new Dictionary<string, object?> { ["alreadyApplied"] = outcome.AlreadyApplied.ToArray() }
                            : null);
                }
                catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for module admin change"); }
            }

            // Re-baseline here, not merely tidy: this save does not reload the page, so a stale
            // baseline would count the groups just persisted all over again on the next edit. The
            // baseline is what was SAVED, so a row added during the lookup stays an unsaved edit.
            // aud-a66. Only on the load this save began on.
            if (Holds(started))
            {
                moduleAdminGroupsBaseline = new List<string>(snapshot);
                RecountAdmins();
            }
            statusMessage = outcome is null
                ? "Module admins are unchanged; there was nothing to save."
                : "Module admins saved.";
            statusIsError = false;
        }
        catch (Exception ex)
        {
            statusMessage = Audit.LogSettingsSaveException(Logger, currentUser, ip, section, ex, $"Failed to save: {ex.Message}");
            statusIsError = true;
        }
        finally
        {
            // aud-a66. On another load the Save button belongs to that load, and this save's message names its module.
            if (Holds(started)) saving = false;
            else statusMessage = OnAnotherModule(saved, statusMessage);
        }
    }

    /// <summary>
    /// Confirms that every grant a save is ADDING names a group the directory holds. Null when the
    /// save may proceed; otherwise the refusal to show. aud-a1b.
    /// </summary>
    /// <remarks>
    /// The add path tested a SID's shape only, so a pasted user SID, or one that resolves to
    /// nothing, was saved and authorized nobody. Only the new grants are asked about: rows already
    /// stored are not re-checked, so a directory outage never blocks saving a removal. One lookup
    /// per new grant, each waiting up to 30 seconds on the directory service's shared runspace
    /// lock - hence the activity, opened before the Task.Run that wraps the loop.
    /// </remarks>
    private async Task<string?> ConfirmNewGroupGrantsAsync(IReadOnlyList<string> newGrants)
    {
        if (newGrants.Count == 0)
            return null;

        using var activity = Progress.Begin(
            "Module Config", "Confirming new groups against Active Directory", ActivitySize.Items(newGrants.Count));

        var done = 0;
        var refusals = await Task.Run(() => ExchangeAdminWeb.Authorization.GroupGrantValidation.Refusals(newGrants, sid =>
        {
            var answer = ADSearch.ValidateGroupSid(sid);
            activity.Report(++done);
            return answer;
        }));

        // A refusal is a check that RAN; only a directory that could not be asked is a failure
        // (reviewer ruling, .agents/state.md 2026-10-08).
        activity.Complete(
            refusals.All(r => r.Refusal != ExchangeAdminWeb.Authorization.GroupGrantRefusal.DirectoryUnavailable),
            refusals.Count == 0 ? "Every new group was confirmed." : "Some new groups could not be confirmed.");

        return refusals.Count == 0
            ? null
            : ExchangeAdminWeb.Authorization.GroupGrantValidation.Message(refusals, DisplayNameFor);
    }

    // aud-a66. By the descriptor the save took, never the page's: after a move the page's is another module's, whose fields
    // would mask - or fail to mask - this module's keys.
    private string MaskIfSecret(AdminModuleDescriptor saved, string key, string value)
    {
        if (string.IsNullOrEmpty(value)) return "(empty)";
        if (IsSecretField(saved, key)) return "***";
        return value;
    }

    private static bool IsSecretField(AdminModuleDescriptor saved, string key) =>
        saved.ConfigFields.FirstOrDefault(f => f.Key == key)?.IsSecret == true;

    /// <remarks>
    /// Only a group SID is accepted here - a group picked from the AD suggestion list, or a group's
    /// SID pasted in. Other text is refused rather than stored: this field decides who can reach a
    /// module, and a typo would either silently grant nothing or - before SIDs - match a same-named
    /// group in another domain. The shape is all this can check; whether the SID is a GROUP the
    /// directory holds is confirmed when the section is saved (aud-a1b,
    /// <see cref="ConfirmNewGroupGrantsAsync"/>).
    /// </remarks>
    private void AddAccessGroup(string alias)
    {
        var input = accessInputs[alias]?.Trim();
        if (string.IsNullOrWhiteSpace(input)) return;

        if (!ExchangeAdminWeb.Authorization.SectionAccessGroupIdentity.IsUsableGroupSid(input))
        {
            statusMessage = ADSearch.IsAvailable
                ? NotAGroupSidMessage
                : "Active Directory is unreachable, so groups cannot be looked up. Try again later.";
            statusIsError = true;
            return;
        }

        statusMessage = null;
        if (!accessState[alias].Contains(input, StringComparer.OrdinalIgnoreCase))
        {
            accessState[alias].Add(input);
            RecountAccess();
        }
        accessInputs[alias] = string.Empty;
    }

    /// <summary>
    /// The friendly name for a stored group value, falling back to the value itself.
    /// </summary>
    /// <remarks>
    /// Display only - never consulted by an authorization path, so a stale name is cosmetic. The
    /// fallback matters during the window before the SID migration has run, and for a row whose
    /// display name was never captured: showing a raw SID is unhelpful but honest, whereas showing
    /// nothing would make the row look empty.
    /// </remarks>
    /// <summary>
    /// Records the picked group's name so the badge reads as a name straight away, before the save
    /// round-trip that persists it.
    /// </summary>
    private void RememberGroupDisplayName(ExchangeAdminWeb.Services.ADSearchResult result)
    {
        if (string.IsNullOrWhiteSpace(result.ObjectSid))
            return;

        // sAMAccountName preferred: it is the half of DOMAIN\Name that Windows uses, so the badge
        // matches what an admin sees in AD tooling. DisplayName is neither unique nor guaranteed
        // to match the logon name.
        var name = !string.IsNullOrWhiteSpace(result.SamAccountName)
            ? result.SamAccountName
            : result.DisplayName;

        if (string.IsNullOrWhiteSpace(name))
            return;

        // Qualified for the same reason the badge is qualified everywhere else: three domains can
        // authenticate here, and a bare name does not say which one a grant applies to. The domain
        // is derived from the SID, which is authoritative about that.
        var display = ExchangeAdminWeb.Authorization.SectionAccessGroupIdentity.QualifiedDisplayName(
            NetBiosDomainOf(result.ObjectSid), name);
        accessDisplayNames[result.ObjectSid] = display;
        pickedDisplayNames[result.ObjectSid] = display;
    }

    /// <summary>
    /// The display names an access save stores (aud-a26n): the name picked on this page for each group the save added
    /// to an alias it wrote, and nothing else.
    /// </summary>
    internal static Dictionary<string, string> DisplayNamesToStore(
        IReadOnlyDictionary<string, string[]> written,
        IReadOnlyDictionary<string, List<string>> loaded,
        IReadOnlyDictionary<string, string> picked) =>
        written
            .SelectMany(kv => kv.Value.Except(loaded.GetValueOrDefault(kv.Key) ?? [], StringComparer.OrdinalIgnoreCase))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Where(picked.ContainsKey)
            .ToDictionary(group => group, group => picked[group], StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// The NetBIOS domain owning a SID, or null. Fail-soft: this only decorates a badge, so a
    /// translation failure must leave a bare name rather than break the picker.
    /// </summary>
    // SID -> NetBIOS domain, memoized. A translation is ~0.6ms, but every badge asks on every
    // Blazor re-render, so an uncached lookup would put dozens of directory round-trips on each
    // keystroke elsewhere on the page. Null results are cached too - a SID that will not translate
    // now will not translate on the next render either.
    private readonly Dictionary<string, string?> _netBiosDomainCache = new(StringComparer.OrdinalIgnoreCase);

    private string? NetBiosDomainOf(string sid)
    {
        if (_netBiosDomainCache.TryGetValue(sid, out var cached))
            return cached;

        var resolved = TranslateNetBiosDomain(sid);
        _netBiosDomainCache[sid] = resolved;
        return resolved;
    }

    private string? TranslateNetBiosDomain(string sid)
    {
        try
        {
            var account = new System.Security.Principal.SecurityIdentifier(sid)
                .Translate(typeof(System.Security.Principal.NTAccount))
                .Value;

            var slash = account.IndexOf('\\');
            return slash > 0 ? account[..slash] : null;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not resolve a NetBIOS domain for a picked group; showing the bare name");
            return null;
        }
    }

    private string DisplayNameFor(string groupValue)
    {
        if (!accessDisplayNames.TryGetValue(groupValue, out var name) || string.IsNullOrWhiteSpace(name))
            return groupValue;

        // Qualify at render time as well as at write time. Rows migrated before the display names
        // were qualified hold a bare name, and re-running the migration will not revisit them - it
        // is idempotent and those rows are already SIDs. Doing it here means an existing store
        // reads correctly without a data fix-up.
        return ExchangeAdminWeb.Authorization.SectionAccessGroupIdentity.QualifiedDisplayName(
            NetBiosDomainOf(groupValue), name);
    }

    private void RemoveAccessGroup(string alias, string group)
    {
        if (accessState[alias].Remove(group))
            RecountAccess();
    }

    private void HandleAccessKeyDown(KeyboardEventArgs e, string alias)
    {
        if (e.Key == "Enter") AddAccessGroup(alias);
    }

    /// <summary>
    /// The refusal for input that is not a usable group SID. It used to say typed text is not
    /// accepted, which was false - a pasted SID is - and now says what is true (aud-a1b).
    /// </summary>
    private const string NotAGroupSidMessage =
        "That is not a group identifier. Pick a group from the suggestion list, or paste a group's "
        + "SID; it is confirmed against Active Directory when you save.";

    /// <summary>
    /// Adds a module-admin grant. The value must have the shape of a usable group SID.
    /// </summary>
    /// <remarks>
    /// Identical rule, and identical reason, to <see cref="AddAccessGroup"/> - this field decides
    /// who can change a module's configuration and its AD attribute allowlist. It stored a bare
    /// SAM name until audit finding A1 (2026-10-16), which let a grant for one domain's group be
    /// satisfied by a member of a same-named group in another domain.
    ///
    /// What this checks is the SHAPE. Whether the SID is a group the directory holds - not a
    /// user's SID, not one that resolves to nothing - is confirmed when the section is saved, for
    /// both controls together (aud-a1b, <see cref="ConfirmNewGroupGrantsAsync"/>).
    /// </remarks>
    private void AddModuleAdmin()
    {
        var input = newAdminGroup?.Trim();
        if (string.IsNullOrWhiteSpace(input)) return;

        if (!ExchangeAdminWeb.Authorization.SectionAccessGroupIdentity.IsUsableGroupSid(input))
        {
            statusMessage = ADSearch.IsAvailable
                ? NotAGroupSidMessage
                : "Active Directory is unreachable, so groups cannot be looked up. Try again later.";
            statusIsError = true;
            return;
        }

        statusMessage = null;
        if (!moduleAdminGroups.Contains(input, StringComparer.OrdinalIgnoreCase))
        {
            moduleAdminGroups.Add(input);
            RecountAdmins();
        }
        newAdminGroup = string.Empty;
    }

    private void RemoveModuleAdmin(string group)
    {
        if (moduleAdminGroups.Remove(group))
            RecountAdmins();
    }

    private void HandleAdminKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddModuleAdmin();
    }

    // --- AD Attribute Editor Allowlist ---

    private List<AllowlistRow> allowlistAttributes = new();
    private string? allowlistError;
    private bool allowlistSaved;
    private bool allowlistCorrupt;
    private string? allowlistImportRefusal;

    // What the save is checked against (aud-a28i): the version of the rows this page loaded. A save
    // made after anyone else saved the allowlist - another admin, or either instance on the shared
    // database - is refused rather than allowed to replace their change, and the admin reloads. The
    // page's own successful save replaces it with the version that save left, so saving twice from
    // one page is not a conflict.
    private string allowlistVersion = "";

    private void LoadAllowlist()
    {
        // Fresh, not the cached GetAllowlist, and one read for both the rows and their version.
        var loaded = AttrEditorService.LoadAllowlistForEditing();
        allowlistVersion = loaded.Version;
        var list = loaded.Attributes;
        if (list == null)
        {
            allowlistCorrupt = true;
            allowlistImportRefusal = AttrEditorService.LegacyAllowlistImportRefusal;
            allowlistError = allowlistImportRefusal is not null
                ? "The allowlist was not loaded: the legacy file config/ad-editable-attributes.json was not imported (the reason is above). Correct the file, then reload this page."
                : "The allowlist was not loaded: the editable_attribute table in the config database cannot be read or fails validation. Correct it as docs/ConfigDbOperations.md describes, with both application pools stopped, then reload this page.";
            allowlistAttributes = new();
            return;
        }

        allowlistCorrupt = false;
        allowlistImportRefusal = null;

        allowlistAttributes = list.Select(a => new AllowlistRow
        {
            Name = a.Name, Label = a.Label, Type = a.Type,
            Choices = a.Choices, Required = a.Required, AllowClear = a.AllowClear,
            MaxLength = a.MaxLength, Pattern = a.Pattern, Level = a.Level
        }).ToList();
        allowlistError = null;
    }

    // Counting choice for the Editable Attributes section: ONE EDIT PER ACTION, not a diff. The
    // other four sections diff a working copy against what they loaded; these rows cannot, because
    // a row has no identity to diff by -- an operator adds a blank row and types its name in, so
    // "the same row, changed" and "a different row" are indistinguishable, and a removal in the
    // middle of the table would read as a change to every row below it. A tally is safe here in
    // the way it would not be for Configuration: every field in this table commits on change
    // (blur or selection), never on input, so one counted edit is one committed edit rather than
    // one keystroke. The cost is that typing a value and then typing it back counts twice.
    private void AddAttribute()
    {
        dirty.Increment(SecAttrs);
        allowlistAttributes.Add(new AllowlistRow
        {
            Name = "", Label = "", Type = "String",
            Required = false, AllowClear = true
        });
    }

    private void RemoveAttribute(int index)
    {
        dirty.Increment(SecAttrs);
        if (index >= 0 && index < allowlistAttributes.Count)
            allowlistAttributes.RemoveAt(index);
    }

    private void UpdateAttrName(int idx, ChangeEventArgs e) { allowlistAttributes[idx].Name = e.Value?.ToString() ?? ""; dirty.Increment(SecAttrs); }
    private void UpdateAttrLabel(int idx, ChangeEventArgs e) { allowlistAttributes[idx].Label = e.Value?.ToString() ?? ""; dirty.Increment(SecAttrs); }
    private void UpdateAttrType(int idx, ChangeEventArgs e) { allowlistAttributes[idx].Type = e.Value?.ToString() ?? "String"; dirty.Increment(SecAttrs); }
    private void UpdateAttrRequired(int idx, ChangeEventArgs e) { allowlistAttributes[idx].Required = bool.TryParse(e.Value?.ToString(), out var v) && v; dirty.Increment(SecAttrs); }
    private void UpdateAttrAllowClear(int idx, ChangeEventArgs e) { allowlistAttributes[idx].AllowClear = bool.TryParse(e.Value?.ToString(), out var v) && v; dirty.Increment(SecAttrs); }
    private void UpdateAttrMaxLength(int idx, ChangeEventArgs e)
    {
        dirty.Increment(SecAttrs);
        allowlistAttributes[idx].MaxLength = int.TryParse(e.Value?.ToString(), out var v) && v > 0 ? v : null;
    }
    // aud-a26e. The pattern used to have no input at all, so an admin could neither see nor correct
    // it. Kept exactly as typed - not trimmed, because a space in a regular expression matches a
    // space - and an empty box is no pattern. Nothing here judges it: a pattern that does not compile
    // is refused when the allowlist is saved, naming the attribute, and the admin corrects it.
    private void UpdateAttrPattern(int idx, ChangeEventArgs e) { allowlistAttributes[idx].Pattern = e.Value?.ToString() is { Length: > 0 } typed ? typed : null; dirty.Increment(SecAttrs); }
    private void UpdateAttrChoices(int idx, ChangeEventArgs e)
    {
        dirty.Increment(SecAttrs);
        var raw = e.Value?.ToString() ?? "";
        var parsed = raw.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        allowlistAttributes[idx].Choices = parsed.Length > 0 ? parsed : null;
    }

    private async Task SaveAllowlistAsync()
    {
        if (module == null) return;

        // Every row, as it is in the table: a row with a blank name or label used to be filtered
        // out here and vanish without a word. The save refuses it by its position (aud-a26f).
        // aud-a41. Taken before the write, which runs off the circuit. This section's count is a tally, not a diff, so after
        // the save it keeps only the edits made while the write waited.
        // aud-a66. The rows, the version and the count, with the module, its id and the page's load, before the first await:
        // the authorization re-check is against this module's admins, not those of a module the page opened meanwhile.
        var saved = module;
        var moduleId = saved.Id;
        var started = load;
        var rows = allowlistAttributes
            .Select(a => new EditableAttribute(a.Name.Trim(), a.Label.Trim(), a.Type, a.Choices, a.Required, a.AllowClear, a.MaxLength, a.Pattern, a.Level))
            .ToList();
        var version = allowlistVersion;
        var performedBy = currentUser;
        var editsSaved = dirty.SectionCount(SecAttrs);
        saving = true;
        allowlistError = null;
        allowlistSaved = false;
        await Task.Yield();

        // aud-a28f. Every attempt leaves exactly one audit record. This page keeps only the
        // authorisation re-check - it needs the principal and the policies - and records that refusal
        // itself. Everything after it is SaveAllowlistAndAudit, which re-checks the store, records
        // each outcome and returns it without throwing, so the catch below is reached only from the
        // re-check and writes the one record for that attempt. The page writes no other record.
        var ip = ClientInfo.GetIpForUser(currentUser);
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var adminResult = await AuthorizationService.AuthorizeAsync(user, "AdminSettings");
            if (!adminResult.Succeeded && !ModuleAdmin.IsModuleAdmin(moduleId, user))
            {
                const string unauthorized = "You are not authorized to save the attribute allowlist.";
                if (Holds(started)) allowlistError = unauthorized;
                else statusMessage = OnAnotherModule(saved, unauthorized);
                AttrEditorService.LogAllowlistSaveRefused(currentUser, ip, "Authorization", unauthorized);
                return;
            }

            // aud-a66. Immediately before the write, as SaveConfigAsync; recorded through the allowlist's own refusal record, the
            // only one this page writes for it, and told in the page-wide message, since this module's banner is not shown.
            if (!Shows(moduleId))
            {
                statusMessage = OnAnotherModule(saved, PageMovedRefusal);
                statusIsError = true;
                AttrEditorService.LogAllowlistSaveRefused(currentUser, ip, "PageMoved", PageMovedRefusal);
                return;
            }

            var result = await Task.Run(() => AttrEditorService.SaveAllowlistAndAudit(rows, version, performedBy, ip));
            // aud-a66. Finished after the page moved: the outcome is told, named for its module, and the allowlist state the
            // page holds - version, banner, count - is left alone.
            if (!Holds(started))
            {
                statusMessage = OnAnotherModule(saved, result.Success ? "The attribute allowlist was saved." : result.Error);
                statusIsError = !result.Success;
            }
            else if (!result.Success)
            {
                if (result.StoreCorrupt)
                {
                    // The banner names the store at fault; refreshed here because the store can have
                    // turned corrupt after the page loaded.
                    allowlistCorrupt = true;
                    allowlistImportRefusal = AttrEditorService.LegacyAllowlistImportRefusal;
                }
                allowlistError = result.Error;
            }
            else
            {
                // The version the save left is what this page now shows; without it the page's next save
                // would be refused as someone else's change (aud-a28i).
                allowlistVersion = result.Version ?? "";
                dirty.SetCount(SecAttrs, dirty.SectionCount(SecAttrs) - editsSaved);
                allowlistSaved = true;
            }
        }
        catch (Exception ex)
        {
            var failure = $"Failed to save: {ex.Message}";
            if (Holds(started)) allowlistError = failure;
            else statusMessage = OnAnotherModule(saved, failure);
            Logger.LogError(ex, "Allowlist save failed");
            AttrEditorService.LogAllowlistSaveFailed(currentUser, ip, failure);
        }
        finally
        {
            // aud-a66. On another load the Save button belongs to that load.
            if (Holds(started)) saving = false;
        }
    }

    private void UpdateAttrLevel(int idx, ChangeEventArgs e)
    {
        dirty.Increment(SecAttrs);
        allowlistAttributes[idx].Level = int.TryParse(e.Value?.ToString(), out var v) && v >= 1 && v <= 3 ? v : 1;
    }

    private sealed class AllowlistRow
    {
        public string Name { get; set; } = "";
        public string Label { get; set; } = "";
        public string Type { get; set; } = "String";
        public string[]? Choices { get; set; }
        public bool Required { get; set; }
        public bool AllowClear { get; set; }
        public int? MaxLength { get; set; }
        public string? Pattern { get; set; }
        public int Level { get; set; } = 1;
    }

    // --- OU Browser/Picker ---

    private bool ouBrowseAvailable;
    private bool showOUBrowser;
    private bool ouLoading;
    private List<OUEntry> ouAllEntries = new();
    private List<OUEntry> ouFilteredEntries = new();
    private HashSet<string> ouSelectedDNs = new(StringComparer.OrdinalIgnoreCase);
    private string ouFilterText = string.Empty;
    private int ouMinDepth;

    private void InitOUBrowser()
    {
        // Probe availability without blocking — just check the cached flag.
        // The actual enumeration happens when the user clicks "Browse OUs".
        ouBrowseAvailable = true;
        showOUBrowser = false;
        ouLoading = false;
        ouFilterText = string.Empty;
        ouAllEntries = new();
        ouFilteredEntries = new();
        ouSelectedDNs = new(StringComparer.OrdinalIgnoreCase);
    }

    private async Task ToggleOUBrowser()
    {
        if (showOUBrowser)
        {
            showOUBrowser = false;
            return;
        }

        // Load OUs when opening the browser for the first time
        if (ouAllEntries.Count == 0)
        {
            await LoadOUsAsync();
            if (!ouBrowseAvailable) return;
        }

        // Pre-select OUs already in the config value
        SyncSelectedFromConfig();
        showOUBrowser = true;
    }

    private async Task LoadOUsAsync()
    {
        ouLoading = true;
        await Task.Yield();

        using var activity = Progress.Begin(
            "Module Config", "Loading organizational units", ActivitySize.Unknown);

        try
        {
            ouAllEntries = await Task.Run(() => OUService.GetOrganizationalUnits());
            ouBrowseAvailable = OUService.IsAvailable;
            activity.Complete(ouBrowseAvailable);

            if (!ouBrowseAvailable)
            {
                ouAllEntries = new();
                ouFilteredEntries = new();
                return;
            }

            ouMinDepth = ouAllEntries.Count > 0 ? ouAllEntries.Min(e => e.Depth) : 0;
            ApplyOUFilter();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "OU browser load failed");
            ouBrowseAvailable = false;
        }
        finally
        {
            ouLoading = false;
        }
    }

    private async Task RefreshOUs()
    {
        OUService.InvalidateCache();
        ouAllEntries = new();
        await LoadOUsAsync();
        if (ouBrowseAvailable)
        {
            SyncSelectedFromConfig();
        }
    }

    private void SyncSelectedFromConfig()
    {
        ouSelectedDNs.Clear();
        var currentValue = GetConfigValue("DefaultSearchBase", "");
        if (!string.IsNullOrWhiteSpace(currentValue))
        {
            var dns = currentValue.Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            foreach (var dn in dns)
                ouSelectedDNs.Add(dn);
        }
    }

    private void ToggleOU(string dn, bool isChecked)
    {
        // Recount rather than tally: a tick in the OU browser is not a config edit until
        // ApplySelectedOUs writes DefaultSearchBase, so this reflects committed values only -
        // closing the browser without applying now correctly leaves the section clean.
        RecountConfig();
        if (isChecked)
            ouSelectedDNs.Add(dn);
        else
            ouSelectedDNs.Remove(dn);
    }

    private void ApplySelectedOUs()
    {
        var value = string.Join(";", ouSelectedDNs.OrderBy(d => d, StringComparer.OrdinalIgnoreCase));
        SetConfigValue("DefaultSearchBase", value);
        showOUBrowser = false;
    }

    private void OnOUFilterChanged(ChangeEventArgs e)
    {
        ouFilterText = e.Value?.ToString() ?? string.Empty;
        ApplyOUFilter();
    }

    private void ApplyOUFilter()
    {
        if (string.IsNullOrWhiteSpace(ouFilterText))
        {
            ouFilteredEntries = ouAllEntries;
        }
        else
        {
            ouFilteredEntries = ouAllEntries
                .Where(ou => ou.Name.Contains(ouFilterText, StringComparison.OrdinalIgnoreCase)
                          || ou.DistinguishedName.Contains(ouFilterText, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }
}

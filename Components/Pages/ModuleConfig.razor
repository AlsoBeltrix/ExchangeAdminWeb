@page "/module-config/{ModuleId}"
@using Microsoft.AspNetCore.Authorization
@using ExchangeAdminWeb.Modules
@attribute [Authorize]
@rendermode InteractiveServer
@inject ModuleConfigService ModuleConfigSvc
@inject ModuleAdminService ModuleAdmin
@inject ModuleEnablementService Enablement
@inject SectionAccessService SectionAccess
@inject ExchangeAdminWeb.Services.ADDirectorySearchService ADSearch
@inject ModuleCatalog Catalog
@inject AuditService Audit
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager Navigation
@inject ClientInfoService ClientInfo
@inject ADAttributeEditorService AttrEditorService
@inject ADOrganizationalUnitService OUService
@inject ILogger<ModuleConfig> Logger

<PageTitle>Module Config — @(module?.DisplayName ?? ModuleId)</PageTitle>

@if (!authChecked)
{
    <div class="container-fluid">
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Checking authorization...</span>
            </div>
        </div>
    </div>
    return;
}

@if (module == null)
{
    <div class="container-fluid">
        <div class="alert alert-danger">Module not found: @ModuleId</div>
    </div>
    return;
}

@* Five sections, five Save buttons, and until now nothing warned that another section was still
   unsaved. B2 in docs/AdminUIRedesign-Plan.md. *@
<UnsavedChangesGuard HasUnsavedChanges="@dirty.IsDirty"
                     Message="@($"{dirty.Summary()}. Leave without saving?")" />

<div class="container-fluid adm">
    <div class="adm-hd">
        <h1>@module.DisplayName</h1>
        <span class="adm-ver">v@(module.Version)</span>
        <span class="adm-sub">@module.Description</span>
    </div>

    @* Tabs, not stacked cards. Each pane scrolls independently so the page never grows with the
       number of groups - the failure the owner reported at 10-20 groups per module. Counts sit on
       the tab so an operator knows what is behind it without opening it, and a dot marks a
       background tab holding unsaved edits. *@
    <div class="adm-tabs">
        @if (!module.IsSystemModule)
        {
            <button class="@TabClass(SecStatus)" @onclick="() => tab = SecStatus">
                Status @if (dirty.IsSectionDirty(SecStatus)) { <span class="adm-dot"></span> }
            </button>
        }
        @if (isGlobalAdmin)
        {
            <button class="@TabClass(SecAccess)" @onclick="() => tab = SecAccess">
                Access <span class="adm-n">@AccessGroupCount()</span>
                @if (dirty.IsSectionDirty(SecAccess)) { <span class="adm-dot"></span> }
            </button>
        }
        @if (module.ConfigFields.Count > 0)
        {
            <button class="@TabClass(SecConfig)" @onclick="() => tab = SecConfig">
                Configuration <span class="adm-n">@module.ConfigFields.Count</span>
                @if (dirty.IsSectionDirty(SecConfig)) { <span class="adm-dot"></span> }
            </button>
        }
        @if (module.Id == "ADAttributeEditor")
        {
            <button class="@TabClass(SecAttrs)" @onclick="() => tab = SecAttrs">
                Attributes <span class="adm-n">@allowlistAttributes.Count</span>
                @if (dirty.IsSectionDirty(SecAttrs)) { <span class="adm-dot"></span> }
            </button>
        }
        @if (isGlobalAdmin)
        {
            <button class="@TabClass(SecAdmins)" @onclick="() => tab = SecAdmins">
                Module admins <span class="adm-n">@moduleAdminGroups.Count</span>
                @if (dirty.IsSectionDirty(SecAdmins)) { <span class="adm-dot"></span> }
            </button>
        }
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(statusIsError ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
        </div>
    }

    @if (!module.IsSystemModule)
    {
        <div class="adm-pane @PaneClass(SecStatus)">
                @if (enablementStoreCorrupt)
                {
                    <div class="alert alert-danger py-2 mb-2">
                        <small><strong>Module enablement store is corrupt</strong> — config\modules-enabled.json cannot be read, so the state shown below is the fallback, not the stored state. Saving is disabled until the file is fixed or restored.</small>
                    </div>
                }
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" id="module-enabled"
                           checked="@moduleEnabled"
                           disabled="@(!isGlobalAdmin || saving)"
                           @onchange="(e) => { moduleEnabled = (bool)(e.Value ?? false); dirty.Set(SecStatus, true); }" />
                    <label class="form-check-label fw-semibold" for="module-enabled">
                        @(moduleEnabled ? "Enabled" : "Disabled")
                    </label>
                </div>
                @{
                    var effectiveEnabled = Enablement.IsModuleEnabled(module.Id);
                    var parentModule = module.DependsOn != null ? Catalog.GetById(module.DependsOn) : null;
                }
                @if (moduleEnabled && !effectiveEnabled && parentModule != null)
                {
                    <div class="alert alert-warning py-2 mb-2">
                        <small>Enabled but inactive -- @parentModule.DisplayName is disabled.</small>
                    </div>
                }
                <small class="text-muted">
                    Disabled modules are hidden from the sidebar and denied by authorization, even when section access and configuration are set.
                    @if (!isGlobalAdmin)
                    {
                        <span> Only global admins can change module status.</span>
                    }
                </small>
            </div>
    }

    @* Section Access *@
    @if (isGlobalAdmin)
    {
        <div class="adm-pane @PaneClass(SecAccess)">
                @if (sectionAccessCorrupt)
                {
                    <div class="alert alert-danger mb-0">
                        <strong>Section access store is corrupt.</strong>
                        config\sectionaccess.json exists but cannot be read, so the group lists cannot
                        be shown and saving is disabled — saving now would replace the whole fragment,
                        wiping every module's groups. Fix or restore the file (deploy backups:
                        ConfigBackups\config.&lt;timestamp&gt;.bak), then reload this page.
                    </div>
                }
                else
                {
                @if (sectionAccessUnconfigured)
                {
                    <div class="alert alert-info py-2 mb-2">
                        <small>Section access has never been configured on this server (no config\sectionaccess.json and no legacy appsettings block). Saving here creates the fragment and starts enforcing these lists for all fail-closed modules.</small>
                    </div>
                }

                <p class="text-muted mb-2"><small>Groups allowed to use this module, stored as SIDs. Search covers every domain in the forest.</small></p>

                @* One row per grant, not chips. Chips wrap, so the block changed height per module
                   and nothing lined up; a row shows the domain, the group and the SID it actually
                   stores, aligned. Domain is its OWN column rather than a DOMAIN\ prefix, because
                   a prefix pushes every group name to a different x-position. Owner rejected every
                   chip variant (2026-08-04). *@
                @* Skips the servicer alias, which policyAliases carries so it shares the load and
                   save path but which renders in its own section below, with its own warning. *@
                @foreach (var alias in policyAliases.Where(a => a != ServicerAlias))
                {
                    var capturedAlias = alias;
                    var aliasGroups = accessState.TryGetValue(capturedAlias, out var ag) ? ag : new List<string>();

                    <div class="mb-3">
                        <div class="d-flex align-items-baseline gap-2 mb-1">
                            <strong style="font-size: 0.8rem;">@capturedAlias</strong>
                            <span class="text-muted" style="font-size: 0.72rem;">@aliasGroups.Count group(s)</span>
                        </div>
                        <table class="adm-tbl">
                            <thead>
                                <tr>
                                    <th style="width: 5.5rem;">Domain</th>
                                    <th style="width: 16rem;">Group</th>
                                    <th>Security identifier</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (aliasGroups.Count == 0)
                                {
                                    <tr><td colspan="4" class="adm-empty">No groups - access is denied for this permission.</td></tr>
                                }
                                @foreach (var group in aliasGroups.ToList())
                                {
                                    var cg = group;
                                    <tr>
                                        <td class="adm-dom">@DomainOf(cg)</td>
                                        <td class="adm-grp">@BareNameOf(cg)</td>
                                        <td class="adm-sid">@cg</td>
                                        <td class="adm-act">
                                            <button class="adm-rm" type="button" @onclick="() => RemoveAccessGroup(capturedAlias, cg)">Remove</button>
                                        </td>
                                    </tr>
                                }
                                <tr>
                                    <td colspan="4">
                                        <div class="input-group input-group-sm" style="max-width: 30rem;">
                                            <ADIdentityAutocomplete ObjectKind="Group" ReturnValueKind="SID" @bind-Value="accessInputs[capturedAlias]"
                                                                    OnResultSelected="RememberGroupDisplayName" Placeholder="Search groups in any domain..." />
                                            <button class="btn btn-outline-secondary" type="button" @onclick="() => AddAccessGroup(capturedAlias)">Add</button>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                }

                @* Protected-principal servicing. Rendered ONLY for modules whose gate actually
                   consults ProtectedPrincipalServicerService: a group configured against a module
                   that never asks would grant nothing while appearing to grant something, which is
                   worse than offering no editor at all.

                   Deliberately below, and visually separated from, the ordinary access grants.
                   Being able to USE a module must never read as being able to act on protected
                   principals within it - that separation is the whole reason this is its own
                   section-access key rather than a granular permission. *@
                @if (ServicerAlias is { Length: > 0 } servicerAlias)
                {
                    var servicerGroups = accessState.TryGetValue(servicerAlias, out var sg) ? sg : new List<string>();

                    <div class="mb-3 mt-4 pt-3 border-top">
                        <div class="d-flex align-items-baseline gap-2 mb-1">
                            <strong style="font-size: 0.8rem;">Protected principal servicing</strong>
                            <span class="text-muted" style="font-size: 0.72rem;">@servicerGroups.Count group(s)</span>
                        </div>
                        @* A standing sentence, not a confirmation dialog. The owner ruled 2026-08-06
                           that servicing is routine authorised work with no per-operation ceremony;
                           this warns the ADMIN making a rare, deliberate grant, which is a different
                           audience and a different moment. *@
                        <div class="alert alert-warning py-2 mb-2">
                            <small>
                                <strong>Members may act on protected principals in this module.</strong>
                                Protected principals are otherwise refused to everyone. This is separate
                                from module access above - it grants nothing else, and confers nothing in
                                any other module. Actions are audited normally, and record which group
                                authorised them. With no group listed, no one can service protected
                                principals here.
                                <strong>It does not grant access to the module.</strong> A group listed
                                only here still cannot open @module.DisplayName, so the grant never comes
                                into play - it needs @module.MainPermission.PolicyAlias above as well.
                            </small>
                        </div>

                        @* Names the gap on the row it applies to rather than leaving the sentence above
                           to be applied by the reader. The check is deliberately about the DIRECT grant:
                           membership is nested, so a group absent from the list above may still reach the
                           module through one that is present. Hence "not granted directly" and a warning
                           tone, not an assertion that the grant is dead - overclaiming here would train
                           admins to dismiss it. *@
                        @if (servicerGroups.Any(ServicerGroupLacksDirectModuleAccess))
                        {
                            <div class="alert alert-danger py-2 mb-2">
                                <small>
                                    <strong>Marked groups below have no direct @module.MainPermission.PolicyAlias grant.</strong>
                                    Unless their members reach @module.DisplayName through another group
                                    listed above, they cannot open it, and this servicing grant does
                                    nothing for them. Add them above, or remove them here.
                                </small>
                            </div>
                        }
                        <table class="adm-tbl">
                            <thead>
                                <tr>
                                    <th style="width: 5.5rem;">Domain</th>
                                    <th style="width: 16rem;">Group</th>
                                    <th>Security identifier</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (servicerGroups.Count == 0)
                                {
                                    <tr><td colspan="4" class="adm-empty">No groups - no one may service protected principals in this module.</td></tr>
                                }
                                @foreach (var group in servicerGroups.ToList())
                                {
                                    var sgc = group;
                                    <tr>
                                        <td class="adm-dom">@DomainOf(sgc)</td>
                                        <td class="adm-grp">
                                            @BareNameOf(sgc)
                                            @if (ServicerGroupLacksDirectModuleAccess(sgc))
                                            {
                                                <span class="badge bg-danger ms-1" style="font-size: 0.62rem;"
                                                      title="This group has no direct @module.MainPermission.PolicyAlias grant, so unless its members reach the module through another group they cannot open it and this servicing grant does nothing.">no module access</span>
                                            }
                                        </td>
                                        <td class="adm-sid">@sgc</td>
                                        <td class="adm-act">
                                            <button class="adm-rm" type="button" @onclick="() => RemoveAccessGroup(servicerAlias, sgc)">Remove</button>
                                        </td>
                                    </tr>
                                }
                                <tr>
                                    <td colspan="4">
                                        <div class="input-group input-group-sm" style="max-width: 30rem;">
                                            <ADIdentityAutocomplete ObjectKind="Group" ReturnValueKind="SID" @bind-Value="accessInputs[servicerAlias]"
                                                                    OnResultSelected="RememberGroupDisplayName" Placeholder="Search groups in any domain..." />
                                            <button class="btn btn-outline-secondary" type="button" @onclick="() => AddAccessGroup(servicerAlias)">Add</button>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                }
                }
            </div>
    }

    @* Module Configuration *@
    @if (module.ConfigFields.Count > 0)
    {
        <div class="adm-pane @PaneClass(SecConfig)">

                @if (moduleConfigCorrupt)
                {
                    <div class="alert alert-danger mb-0">
                        <strong>Module configuration is corrupt.</strong>
                        config\module-config-@(module.Id).json exists but cannot be read, so the stored
                        values cannot be shown and saving is disabled — saving now would overwrite them
                        with the blank fields below. Fix or restore the file (deploy backups:
                        ConfigBackups\config.&lt;timestamp&gt;.bak), then reload this page.
                    </div>
                }
                else
                {
                @if (!ModuleConfigSvc.IsModuleConfigured(module.Id))
                {
                    <div class="alert alert-warning py-2 mb-3">
                        <small>This module has required fields that are not yet configured.</small>
                    </div>
                }
                @if (module.ConfigFields.Any(f => f.Key.Contains("DelineaSecretId")))
                {
                    <div class="alert alert-secondary py-2 mb-3">
                        <small><strong>Delinea Secret Server:</strong> Enter the Secret ID for this module's credentials. For Graph modules, use the "ADI - Azure App Registration" template (fields: Tenant ID, Application ID, Client Secret). For AD modules, use a template with Username, Password, and Domain fields.</small>
                    </div>
                }
                <div class="row g-3">
                    @foreach (var field in module.ConfigFields)
                    {
                        var capturedKey = field.Key;
                        <div class="col-md-6">
                            <label class="form-label">
                                @field.Label
                                @if (field.Required) { <span class="text-danger">*</span> }
                            </label>
                            @if (capturedKey == "DefaultSearchBase" && module.Id == "ADAttributeEditor")
                            {
                                <div class="input-group">
                                    <input type="text"
                                           class="form-control"
                                           placeholder="@field.Description"
                                           value="@GetConfigValue(field.Key, field.DefaultValue)"
                                           @oninput="(e) => SetConfigValue(capturedKey, e.Value?.ToString() ?? string.Empty)" />
                                    @if (ouBrowseAvailable)
                                    {
                                        <button class="btn btn-outline-secondary" type="button"
                                                @onclick="ToggleOUBrowser" disabled="@ouLoading">
                                            @if (ouLoading)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                            }
                                            @(showOUBrowser ? "Close" : "Browse OUs")
                                        </button>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(field.Description) && !field.IsSecret)
                                {
                                    <div class="form-text">@field.Description</div>
                                }

                                @if (showOUBrowser)
                                {
                                    <div class="card mt-2 border-secondary">
                                        <div class="card-header py-2 d-flex justify-content-between align-items-center">
                                            <small class="fw-semibold">Select Organizational Units</small>
                                            <div>
                                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="RefreshOUs" disabled="@ouLoading">
                                                    Refresh
                                                </button>
                                                <button class="btn btn-sm btn-primary" @onclick="ApplySelectedOUs">
                                                    Apply Selected
                                                </button>
                                            </div>
                                        </div>
                                        <div class="card-body p-2">
                                            @if (ouFilteredEntries.Count == 0)
                                            {
                                                <p class="text-muted fst-italic mb-0">No organizational units found.</p>
                                            }
                                            else
                                            {
                                                <div class="mb-2">
                                                    <input type="text" class="form-control form-control-sm"
                                                           placeholder="Filter OUs..."
                                                           value="@ouFilterText"
                                                           @oninput="OnOUFilterChanged" />
                                                </div>
                                                <div style="max-height: 350px; overflow-y: auto; font-size: 0.875em;">
                                                    @foreach (var ou in ouFilteredEntries)
                                                    {
                                                        var capturedDn = ou.DistinguishedName;
                                                        var isChecked = ouSelectedDNs.Contains(capturedDn);
                                                        var indent = Math.Max(0, ou.Depth - ouMinDepth);
                                                        <div class="form-check py-0" style="padding-left: @(1.5 + indent * 1.25)rem;">
                                                            <input class="form-check-input" type="checkbox" id="ou-@capturedDn.GetHashCode()"
                                                                   checked="@isChecked"
                                                                   @onchange="(e) => ToggleOU(capturedDn, (bool)(e.Value ?? false))" />
                                                            <label class="form-check-label" for="ou-@capturedDn.GetHashCode()"
                                                                   title="@capturedDn">
                                                                @ou.Name
                                                                <small class="text-muted ms-1">@capturedDn</small>
                                                            </label>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            else if (field.FieldType == ConfigFieldType.AdGroup)
                            {
                                <ADGroupAutocomplete Value="@GetConfigValue(field.Key, field.DefaultValue)"
                                                     ValueChanged="(v) => SetConfigValue(capturedKey, v)"
                                                     Placeholder="@field.Description"
                                                     Disabled="@saving" />
                                @if (!string.IsNullOrEmpty(field.Description) && !field.IsSecret)
                                {
                                    <div class="form-text">@field.Description</div>
                                }
                            }
                            else if (field.FieldType == ConfigFieldType.Boolean)
                            {
                                @* A boolean setting must be impossible to mistype: the checkbox
                                   writes exactly "true"/"false". Consumers keep their own parse
                                   guards for values corrupted outside this page. *@
                                var boolChecked = bool.TryParse(GetConfigValue(field.Key, field.DefaultValue), out var parsedBool) && parsedBool;
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="cfg-bool-@capturedKey"
                                           checked="@boolChecked"
                                           @onchange="(e) => SetBooleanConfigValue(capturedKey, e)" />
                                    <label class="form-check-label" for="cfg-bool-@capturedKey">Enabled</label>
                                </div>
                                @if (!string.IsNullOrEmpty(field.Description) && !field.IsSecret)
                                {
                                    <div class="form-text">@field.Description</div>
                                }
                            }
                            else
                            {
                                <input type="text"
                                       class="form-control"
                                       placeholder="@field.Description"
                                       value="@GetConfigValue(field.Key, field.DefaultValue)"
                                       @oninput="(e) => SetConfigValue(capturedKey, e.Value?.ToString() ?? string.Empty)" />
                                @if (!string.IsNullOrEmpty(field.Description) && !field.IsSecret)
                                {
                                    <div class="form-text">@field.Description</div>
                                }
                            }
                        </div>
                    }
                </div>
                }
            </div>
    }

    @* AD Attribute Editor — Editable Attributes *@
    @if (module.Id == "ADAttributeEditor")
    {
        <div class="adm-pane @PaneClass(SecAttrs)">
            <div class="mb-2">
                <button class="btn btn-outline-secondary btn-sm" @onclick="AddAttribute" disabled="@(saving || allowlistCorrupt)">Add attribute</button>
            </div>
                <p class="text-muted mb-3"><small>Configure which AD attributes users can edit. Attributes on the hard denylist (security-sensitive attributes like userAccountControl, memberOf, etc.) are automatically blocked.</small></p>

                @if (allowlistCorrupt)
                {
                    <div class="alert alert-danger mb-3">
                        <strong>Attribute allowlist store is corrupt.</strong>
                        config\ad-editable-attributes.json exists but cannot be read, so the
                        attribute list cannot be shown and saving is disabled — saving now would
                        replace the whole file, discarding every configured attribute. Fix or
                        restore the file (deploy backups: ConfigBackups\config.&lt;timestamp&gt;.bak),
                        then reload this page.
                    </div>
                }
                @if (allowlistError != null)
                {
                    <div class="alert alert-danger py-2">@allowlistError</div>
                }
                @if (allowlistSaved)
                {
                    <div class="alert alert-success py-2 alert-dismissible">
                        Allowlist saved successfully.
                        <button type="button" class="btn-close" @onclick="() => allowlistSaved = false"></button>
                    </div>
                }

                @if (allowlistAttributes.Count == 0)
                {
                    <p class="text-muted fst-italic">No editable attributes configured. Users will see an empty editor.</p>
                }
                else
                {
                    <div style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>LDAP Name</th>
                                    <th>Label</th>
                                    <th style="width: 100px;">Type</th>
                                    <th style="width: 80px;">Required</th>
                                    <th style="width: 90px;">Allow Clear</th>
                                    <th style="width: 80px;">Max Len</th>
                                    <th style="width: 60px;">Level</th>
                                    <th style="width: 50px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < allowlistAttributes.Count; i++)
                                {
                                    var idx = i;
                                    var attr = allowlistAttributes[idx];
                                    <tr>
                                        <td><input type="text" class="form-control form-control-sm" value="@attr.Name" @onchange="e => UpdateAttrName(idx, e)" placeholder="extensionAttribute1" /></td>
                                        <td><input type="text" class="form-control form-control-sm" value="@attr.Label" @onchange="e => UpdateAttrLabel(idx, e)" placeholder="Display Label" /></td>
                                        <td>
                                            <select class="form-select form-select-sm" value="@attr.Type" @onchange="e => UpdateAttrType(idx, e)">
                                                <option value="String">String</option>
                                                <option value="Choice">Choice</option>
                                            </select>
                                        </td>
                                        <td class="text-center"><input type="checkbox" class="form-check-input" checked="@attr.Required" @onchange="e => UpdateAttrRequired(idx, e)" /></td>
                                        <td class="text-center"><input type="checkbox" class="form-check-input" checked="@attr.AllowClear" @onchange="e => UpdateAttrAllowClear(idx, e)" /></td>
                                        <td><input type="number" class="form-control form-control-sm" value="@attr.MaxLength" @onchange="e => UpdateAttrMaxLength(idx, e)" placeholder="—" /></td>
                                        <td>
                                            <select class="form-select form-select-sm" value="@attr.Level" @onchange="e => UpdateAttrLevel(idx, e)">
                                                <option value="1">1</option>
                                                <option value="2">2</option>
                                                <option value="3">3</option>
                                            </select>
                                        </td>
                                        <td><button class="btn btn-outline-danger btn-sm" @onclick="() => RemoveAttribute(idx)">×</button></td>
                                    </tr>
                                    @if (attr.Type == "Choice")
                                    {
                                        <tr>
                                            <td colspan="7" class="ps-4 pt-0">
                                                <small class="text-muted">Choices (comma-separated):</small>
                                                <input type="text" class="form-control form-control-sm" value="@string.Join(", ", attr.Choices ?? [])" @onchange="e => UpdateAttrChoices(idx, e)" placeholder="Option1, Option2, Option3" />
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
    }

    @* Module Admins (global admin only) *@
    @if (isGlobalAdmin)
    {
        <div class="adm-pane @PaneClass(SecAdmins)">

                <p class="text-muted mb-2"><small>Groups that can manage this module's configuration without global admin access.</small></p>

                @* Rows, not chips - same reasoning as the Access pane, and this is a list the
                   owner expects to reach 10-20 entries. *@
                <table class="adm-tbl">
                    <thead><tr><th>Group</th><th></th></tr></thead>
                    <tbody>
                        @if (moduleAdminGroups.Count == 0)
                        {
                            <tr><td colspan="2" class="adm-empty">None - only global admins can change this module.</td></tr>
                        }
                        @foreach (var group in moduleAdminGroups.ToList())
                        {
                            var capturedGroup = group;
                            <tr>
                                <td class="adm-grp">@capturedGroup</td>
                                <td class="adm-act">
                                    <button class="adm-rm" type="button" @onclick="() => RemoveModuleAdmin(capturedGroup)">Remove</button>
                                </td>
                            </tr>
                        }
                        <tr>
                            <td colspan="2">
                                <div class="input-group input-group-sm" style="max-width: 30rem;">
                                    <ADIdentityAutocomplete ObjectKind="Group" ReturnValueKind="SAM" @bind-Value="newAdminGroup" Placeholder="Search groups in any domain..." />
                                    <button class="btn btn-outline-secondary" type="button" @onclick="AddModuleAdmin">Add</button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
        </div>
    }

    @* One save bar for all five panes, replacing five separate buttons that gave no sign another
       section was still unsaved. It names the dirty section: "1 unsaved change" alone tells an
       operator something is wrong but not where. *@
    <div class="adm-bar">
        @if (dirty.IsDirty)
        {
            <span class="adm-dirty">&#9679; @dirty.Summary()</span>
        }
        else
        {
            <span class="adm-clean">No unsaved changes</span>
        }
        <span class="adm-grow"></span>
        <button class="btn btn-outline-secondary btn-sm" @onclick="ReloadAsync" disabled="@(saving || !dirty.IsDirty)">Discard</button>
        <button class="btn btn-primary btn-sm" @onclick="SaveCurrentTabAsync" disabled="@saving">Save</button>
    </div>
</div>

@code {
    [Parameter] public string ModuleId { get; set; } = "";

    private string currentUser = string.Empty;
    private bool authChecked;
    private bool isGlobalAdmin;
    private bool saving;
    private string? statusMessage;
    private bool statusIsError;

    private AdminModuleDescriptor? module;
    private Dictionary<string, string> currentConfigState = new();
    private List<string> moduleAdminGroups = new();
    private string newAdminGroup = string.Empty;

    private List<string> policyAliases = new();

    /// <summary>
    /// Modules whose protection gate actually consults <see cref="ProtectedPrincipalServicerService"/>.
    /// </summary>
    /// <remarks>
    /// An explicit list, not a descriptor flag. A servicer grant does something only where a gate
    /// calls <c>Evaluate</c>, and that is gate CODE, not metadata - a descriptor field would let a
    /// module advertise the capability by declaration and silently grant nothing. Every entry below
    /// is verified against a real <c>Evaluate</c> caller in that module's gate.
    ///
    /// Add a module here in the same commit that adds its <c>Evaluate</c> call, never before.
    /// </remarks>
    private static readonly HashSet<string> ModulesWithProtectedPrincipalServicing =
        new(StringComparer.OrdinalIgnoreCase)
        {
            "BlockedSenders", "ConferenceRooms", "MfaReset", "EmergencyDisable", "Comms10k",
            "ADAttributeEditor", "MailboxPermissions", "CalendarPermissions", "OutOfOffice",
            "GroupManagement", "M365GroupManagement", "SelfServiceGroups", "Migration",
            "AccountLockoutRemediation", "LicensingUpdates",
        };

    /// <summary>The servicer section-access key for this module, or null where it has not opted in.</summary>
    private string? ServicerAlias;
    private Dictionary<string, List<string>> accessState = new();
    private Dictionary<string, string> accessInputs = new();

    // Section names appear verbatim in the unsaved-changes prompt, so they read as this page's
    // headings rather than as field names.
    //
    // Prefixed "Sec" rather than "Section" deliberately: "SectionAccess" collides with the
    // injected SectionAccessService of the same name and fails to compile.
    private const string SecStatus = "Module Status";
    private const string SecAccess = "Section Access";
    private const string SecConfig = "Configuration";
    private const string SecAttrs = "Editable Attributes";
    private const string SecAdmins = "Module Admins";

    private readonly AdminPageDirtyState dirty = new();

    /// <summary>Which tab is showing. Set in OnParametersSetAsync to the first one available.</summary>
    private string tab = SecStatus;

    private string TabClass(string section) => tab == section ? "on" : "";

    private string PaneClass(string section) => tab == section ? "on" : "";

    /// <summary>Total groups granted across every permission of this module, for the tab count.</summary>
    private int AccessGroupCount() => accessState.Values.Sum(v => v.Count);

    /// <summary>
    /// The NetBIOS domain column for a stored group value, or "-" when unknown.
    /// </summary>
    /// <remarks>
    /// Split into its own column rather than prefixed onto the name so the rows align: with
    /// DOMAIN\Name in one cell, a long domain pushes every name to a different x-position.
    /// </remarks>
    private string DomainOf(string groupValue)
    {
        var shown = DisplayNameFor(groupValue);
        var slash = shown.IndexOf('\\');
        return slash > 0 ? shown[..slash] : "-";
    }

    /// <summary>
    /// True when a servicer group holds no DIRECT grant on the module's main permission.
    /// </summary>
    /// <remarks>
    /// The servicer key is a separate section-access key, so granting it conveys no module access:
    /// a group listed only under servicing is stopped by the page's own [Authorize] policy before
    /// any protection gate consults the grant. Found live on 2026-08-11, where
    /// ANALOG\ExchangeWebAdminsExecSupport held ProtectedServicer:CalendarPermissions with no
    /// CalendarPermissions grant.
    ///
    /// DIRECT is the whole caveat. Group membership nests, and this page compares stored SIDs
    /// without expanding either list, so a group missing from the main permission may still reach
    /// the module through one that is present. That makes a false positive possible and a false
    /// negative not: every genuinely stranded grant is flagged. The wording it drives must stay
    /// conditional for that reason - an admin who finds the warning wrong once will ignore it after.
    /// </remarks>
    private bool ServicerGroupLacksDirectModuleAccess(string groupValue)
    {
        if (module == null) return false;

        return !accessState.TryGetValue(module.MainPermission.PolicyAlias, out var moduleGroups)
            || !moduleGroups.Contains(groupValue, StringComparer.OrdinalIgnoreCase);
    }

    /// <summary>The group name without its domain prefix, for the Group column.</summary>
    private string BareNameOf(string groupValue)
    {
        var shown = DisplayNameFor(groupValue);
        var slash = shown.IndexOf('\\');
        return slash >= 0 && slash < shown.Length - 1 ? shown[(slash + 1)..] : shown;
    }

    /// <summary>
    /// Saves whatever the visible tab owns. One button replaces five, but it must not save
    /// sections the operator is not looking at: each save has its own authorization re-check and
    /// its own corrupt-store refusal, and firing all five would turn one refusal into a confusing
    /// partial result.
    /// </summary>
    private async Task SaveCurrentTabAsync()
    {
        switch (tab)
        {
            case SecStatus: await SaveModuleEnablementAsync(); break;
            case SecAccess: await SaveSectionAccessAsync(); break;
            case SecConfig: await SaveConfigAsync(); break;
            case SecAttrs: await SaveAllowlistAsync(); break;
            case SecAdmins: await SaveModuleAdminsAsync(); break;
        }
    }

    /// <summary>
    /// Discards edits by reloading the page from the store. Clears dirty state FIRST, or the
    /// unsaved-changes guard blocks the very navigation the operator asked for.
    /// </summary>
    private void ReloadAsync()
    {
        dirty.Clear();
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    /// <summary>The first tab this operator can actually see, so the page never opens on a hidden one.</summary>
    private string FirstVisibleTab()
    {
        if (module is null) return SecStatus;
        if (!module.IsSystemModule) return SecStatus;
        if (isGlobalAdmin) return SecAccess;
        if (module.ConfigFields.Count > 0) return SecConfig;
        return SecStatus;
    }

    // SID -> friendly name, for display only. Seeded from the store and topped up as groups are
    // picked, so a group added in this session shows its name before any save/reload.
    private Dictionary<string, string> accessDisplayNames = new(StringComparer.OrdinalIgnoreCase);

    private string? loadedModuleId;
    private bool moduleEnabled;
    private bool enablementStoreCorrupt;
    private bool moduleConfigCorrupt;
    private bool sectionAccessCorrupt;
    private bool sectionAccessUnconfigured;

    protected override async Task OnParametersSetAsync()
    {
        if (ModuleId == loadedModuleId) return;
        loadedModuleId = ModuleId;

        authChecked = false;
        statusMessage = null;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUser = user.Identity?.Name ?? "Unknown";

        module = Catalog.GetById(ModuleId);
        if (module == null || module.IsSystemModule)
        {
            authChecked = true;
            module = null;
            return;
        }

        // Config-only modules have their own dedicated page
        if (module.IsConfigOnly)
        {
            Navigation.NavigateTo(module.Route, replace: true);
            return;
        }

        var adminResult = await AuthorizationService.AuthorizeAsync(user, "AdminSettings");
        isGlobalAdmin = adminResult.Succeeded;

        if (!isGlobalAdmin && !ModuleAdmin.IsModuleAdmin(ModuleId, user))
        {
            Navigation.NavigateTo("access-denied", forceLoad: true);
            return;
        }

        LoadState();

        // After LoadState, because the visible tabs depend on isGlobalAdmin and the loaded module.
        // Opening on a tab this operator cannot see would render an empty page.
        tab = FirstVisibleTab();

        authChecked = true;
    }

    private void LoadState()
    {
        if (module == null) return;

        enablementStoreCorrupt = Enablement.IsStoreCorrupt();
        moduleConfigCorrupt = ModuleConfigSvc.IsModuleCorrupt(module.Id);
        sectionAccessCorrupt = SectionAccess.IsFragmentCorrupt();
        sectionAccessUnconfigured = !SectionAccess.IsSectionAccessConfigured();

        currentConfigState = ModuleConfigSvc.GetModuleConfig(module.Id);
        moduleEnabled = Enablement.IsModuleRawEnabled(module.Id);
        moduleAdminGroups = ModuleAdmin.GetModuleAdmins(module.Id).ToList();

        policyAliases = new List<string> { module.MainPermission.PolicyAlias };
        foreach (var gp in module.GranularPermissions)
            policyAliases.Add(gp.PolicyAlias);

        // The servicer alias joins policyAliases so it inherits the EXISTING load and save path
        // rather than adding a second one. That is not tidiness: SectionAccessService.SaveSectionAccess
        // -> SaveAll -> ClearAndInsert REPLACES the whole store, so this page is safe only because
        // it reads every alias, merges its own, and writes the lot back. A separate save for this
        // grant would silently erase the ordinary grants, or be erased by them.
        ServicerAlias = ModulesWithProtectedPrincipalServicing.Contains(module.Id)
            ? ProtectedPrincipalServicerService.SectionKeyFor(module.Id)
            : null;
        if (ServicerAlias is not null)
            policyAliases.Add(ServicerAlias);

        accessState = new();
        accessInputs = new();
        foreach (var alias in policyAliases)
        {
            accessState[alias] = new List<string>(SectionAccess.GetGroupsForSection(alias));
            accessInputs[alias] = string.Empty;
        }

        // Display names are cosmetic, so a store that cannot supply them must not break the page:
        // DisplayNameFor falls back to the stored value.
        try
        {
            accessDisplayNames = SectionAccess.GetGroupDisplayNames();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not read section-access display names; showing stored values");
            accessDisplayNames = new(StringComparer.OrdinalIgnoreCase);
        }

        if (module.Id == "ADAttributeEditor")
        {
            LoadAllowlist();
            InitOUBrowser();
        }
    }

    private string GetConfigValue(string key, string defaultValue) =>
        currentConfigState.TryGetValue(key, out var val) ? val : defaultValue;

    /// <summary>
    /// Every config field edit funnels through here, so this is the one place the Configuration
    /// section needs to be marked unsaved.
    /// </summary>
    private void SetConfigValue(string key, string value)
    {
        currentConfigState[key] = value;
        dirty.Set(SecConfig, true);
    }

    /// <summary>
    /// Boolean fields store exactly "true"/"false"; the checkbox is the only
    /// writer, so no operator-typed variant can reach the store from this page.
    /// </summary>
    private void SetBooleanConfigValue(string key, ChangeEventArgs e) =>
        SetConfigValue(key, (bool)(e.Value ?? false) ? "true" : "false");

    private async Task SaveConfigAsync()
    {
        if (module == null) return;
        saving = true;
        statusMessage = null;
        await Task.Yield();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var adminResult = await AuthorizationService.AuthorizeAsync(user, "AdminSettings");
            if (!adminResult.Succeeded && !ModuleAdmin.IsModuleAdmin(module.Id, user))
            {
                statusMessage = "You are not authorized to configure this module.";
                statusIsError = true;
                return;
            }

            if (ModuleConfigSvc.IsModuleCorrupt(module.Id))
            {
                moduleConfigCorrupt = true;
                statusMessage = "Refusing to save: this module's config file is corrupt and saving would overwrite it with the rendered fallback values. Fix or restore config\\module-config-" + module.Id + ".json first.";
                statusIsError = true;
                return;
            }

            var previous = ModuleConfigSvc.GetModuleConfig(module.Id);
            ModuleConfigSvc.SaveModuleConfig(module.Id, currentConfigState);

            var allKeys = previous.Keys.Union(currentConfigState.Keys, StringComparer.OrdinalIgnoreCase).ToList();
            var changed = allKeys.Where(k => (previous.GetValueOrDefault(k, "") ?? "") != (currentConfigState.GetValueOrDefault(k, "") ?? "")).ToList();

            if (changed.Count > 0)
            {
                try
                {
                    var ip = ClientInfo.GetIpForUser(currentUser);
                    var prevKeys = changed.Select(k => $"{k}={MaskIfSecret(k, previous.GetValueOrDefault(k) ?? "")}").ToArray();
                    var newKeys = changed.Select(k => $"{k}={MaskIfSecret(k, currentConfigState.GetValueOrDefault(k) ?? "")}").ToArray();
                    Audit.LogSettingsChange(currentUser, ip, $"ModuleConfig:{module.Id}", prevKeys, newKeys);
                }
                catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for module config change"); }
            }

            dirty.ClearSection(SecConfig);
            statusMessage = "Configuration saved.";
            statusIsError = false;
        }
        catch (Exception ex)
        {
            statusMessage = $"Failed to save: {ex.Message}";
            statusIsError = true;
        }
        finally { saving = false; }
    }

    private async Task SaveModuleEnablementAsync()
    {
        if (module == null) return;
        saving = true;
        statusMessage = null;
        await Task.Yield();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authResult = await AuthorizationService.AuthorizeAsync(authState.User, "AdminSettings");
            if (!authResult.Succeeded)
            {
                statusMessage = "Only global admins can change module status.";
                statusIsError = true;
                return;
            }

            if (Enablement.IsStoreCorrupt())
            {
                enablementStoreCorrupt = true;
                statusMessage = "Refusing to save: the enablement store is corrupt and saving would overwrite it with fallback state. Fix or restore config\\modules-enabled.json first.";
                statusIsError = true;
                return;
            }

            var enablement = Enablement.GetAllEnablement();
            var previous = enablement.GetValueOrDefault(module.Id, module.EnabledByDefault);
            enablement[module.Id] = moduleEnabled;
            Enablement.SaveEnablement(enablement);

            if (previous != moduleEnabled)
            {
                try
                {
                    var ip = ClientInfo.GetIpForUser(currentUser);
                    Audit.LogSettingsChange(currentUser, ip, $"Module:{module.Id}",
                        previous ? new[] { "Enabled" } : Array.Empty<string>(),
                        moduleEnabled ? new[] { "Enabled" } : Array.Empty<string>());
                }
                catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for module status change"); }
            }

            dirty.ClearSection(SecStatus);
            statusMessage = "Module status saved. Refreshing...";
            statusIsError = false;
            await Task.Delay(500);
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        }
        catch (Exception ex)
        {
            statusMessage = $"Failed to save module status: {ex.Message}";
            statusIsError = true;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task SaveSectionAccessAsync()
    {
        if (module == null) return;
        saving = true;
        statusMessage = null;
        await Task.Yield();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authResult = await AuthorizationService.AuthorizeAsync(authState.User, "AdminSettings");
            if (!authResult.Succeeded)
            {
                statusMessage = "Only global admins can change section access.";
                statusIsError = true;
                return;
            }

            if (SectionAccess.IsFragmentCorrupt())
            {
                sectionAccessCorrupt = true;
                statusMessage = "Refusing to save: config\\sectionaccess.json is corrupt and saving would replace it, wiping every module's groups. Fix or restore the file first.";
                statusIsError = true;
                return;
            }

            var allAccess = SectionAccess.GetSectionAccess();

            if (allAccess.Count == 0)
            {
                foreach (var alias in Catalog.GetConfigurablePolicyAliases())
                {
                    if (!allAccess.ContainsKey(alias))
                        allAccess[alias] = SectionAccess.GetGroupsForSection(alias);
                }
            }

            var previousGroups = new Dictionary<string, string[]>();
            foreach (var alias in policyAliases)
            {
                previousGroups[alias] = allAccess.TryGetValue(alias, out var prev) ? prev : Array.Empty<string>();
                allAccess[alias] = accessState[alias].ToArray();
            }
            SectionAccess.SaveSectionAccess(allAccess);
            // Persisted separately from the grants, and after them: a display name is cosmetic, so
            // failing to store one must never fail the access save that already succeeded.
            SectionAccess.SaveGroupDisplayNames(accessDisplayNames);

            var ip = ClientInfo.GetIpForUser(currentUser);
            foreach (var alias in policyAliases)
            {
                var prev = previousGroups[alias];
                var curr = accessState[alias].ToArray();
                if (!prev.SequenceEqual(curr, StringComparer.OrdinalIgnoreCase))
                {
                    try { Audit.LogSettingsChange(currentUser, ip, alias, prev, curr); }
                    catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for section access change"); }
                }
            }

            dirty.ClearSection(SecAccess);
            statusMessage = "Section access saved.";
            statusIsError = false;
        }
        catch (Exception ex)
        {
            statusMessage = $"Failed to save: {ex.Message}";
            statusIsError = true;
        }
        finally { saving = false; }
    }

    private async Task SaveModuleAdminsAsync()
    {
        if (module == null) return;
        saving = true;
        statusMessage = null;
        await Task.Yield();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authResult = await AuthorizationService.AuthorizeAsync(authState.User, "AdminSettings");
            if (!authResult.Succeeded)
            {
                statusMessage = "Only global admins can assign module admins.";
                statusIsError = true;
                return;
            }

            var previous = ModuleAdmin.GetModuleAdmins(module.Id);
            ModuleAdmin.SetModuleAdmins(module.Id, moduleAdminGroups.ToArray());

            try
            {
                var ip = ClientInfo.GetIpForUser(currentUser);
                Audit.LogSettingsChange(currentUser, ip, $"ModuleAdmins:{module.Id}", previous, moduleAdminGroups.ToArray());
            }
            catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for module admin change"); }

            dirty.ClearSection(SecAdmins);
            statusMessage = "Module admins saved.";
            statusIsError = false;
        }
        catch (Exception ex)
        {
            statusMessage = $"Failed to save: {ex.Message}";
            statusIsError = true;
        }
        finally { saving = false; }
    }

    private string MaskIfSecret(string key, string value)
    {
        if (string.IsNullOrEmpty(value)) return "(empty)";
        var field = module?.ConfigFields.FirstOrDefault(f => f.Key == key);
        if (field?.IsSecret == true) return "***";
        return value;
    }

    /// <remarks>
    /// Only a value picked from the AD suggestion list is accepted, because only that carries a
    /// SID. Free-typed text is refused rather than stored: this field decides who can reach a
    /// module, and a typo here would either silently grant nothing or - before SIDs - match a
    /// same-named group in another domain. Same rule, same reason, as the protected-principal
    /// entry validator (docs/ProtectedPrincipalInputValidation-Plan.md).
    /// </remarks>
    private void AddAccessGroup(string alias)
    {
        var input = accessInputs[alias]?.Trim();
        if (string.IsNullOrWhiteSpace(input)) return;

        if (!ExchangeAdminWeb.Authorization.SectionAccessGroupIdentity.IsUsableGroupSid(input))
        {
            statusMessage = ADSearch.IsAvailable
                ? "Pick a group from the suggestion list - typed text is not accepted here, because "
                  + "only a selected group supplies the identifier this field stores."
                : "Active Directory is unreachable, so groups cannot be looked up. Try again later.";
            statusIsError = true;
            return;
        }

        statusMessage = null;
        if (!accessState[alias].Contains(input, StringComparer.OrdinalIgnoreCase))
        {
            accessState[alias].Add(input);
            dirty.Set(SecAccess, true);
        }
        accessInputs[alias] = string.Empty;
    }

    /// <summary>
    /// The friendly name for a stored group value, falling back to the value itself.
    /// </summary>
    /// <remarks>
    /// Display only - never consulted by an authorization path, so a stale name is cosmetic. The
    /// fallback matters during the window before the SID migration has run, and for a row whose
    /// display name was never captured: showing a raw SID is unhelpful but honest, whereas showing
    /// nothing would make the row look empty.
    /// </remarks>
    /// <summary>
    /// Records the picked group's name so the badge reads as a name straight away, before the save
    /// round-trip that persists it.
    /// </summary>
    private void RememberGroupDisplayName(ExchangeAdminWeb.Services.ADSearchResult result)
    {
        if (string.IsNullOrWhiteSpace(result.ObjectSid))
            return;

        // sAMAccountName preferred: it is the half of DOMAIN\Name that Windows uses, so the badge
        // matches what an admin sees in AD tooling. DisplayName is neither unique nor guaranteed
        // to match the logon name.
        var name = !string.IsNullOrWhiteSpace(result.SamAccountName)
            ? result.SamAccountName
            : result.DisplayName;

        if (string.IsNullOrWhiteSpace(name))
            return;

        // Qualified for the same reason the badge is qualified everywhere else: three domains can
        // authenticate here, and a bare name does not say which one a grant applies to. The domain
        // is derived from the SID, which is authoritative about that.
        accessDisplayNames[result.ObjectSid] =
            ExchangeAdminWeb.Authorization.SectionAccessGroupIdentity.QualifiedDisplayName(
                NetBiosDomainOf(result.ObjectSid), name);
    }

    /// <summary>
    /// The NetBIOS domain owning a SID, or null. Fail-soft: this only decorates a badge, so a
    /// translation failure must leave a bare name rather than break the picker.
    /// </summary>
    // SID -> NetBIOS domain, memoized. A translation is ~0.6ms, but every badge asks on every
    // Blazor re-render, so an uncached lookup would put dozens of directory round-trips on each
    // keystroke elsewhere on the page. Null results are cached too - a SID that will not translate
    // now will not translate on the next render either.
    private readonly Dictionary<string, string?> _netBiosDomainCache = new(StringComparer.OrdinalIgnoreCase);

    private string? NetBiosDomainOf(string sid)
    {
        if (_netBiosDomainCache.TryGetValue(sid, out var cached))
            return cached;

        var resolved = TranslateNetBiosDomain(sid);
        _netBiosDomainCache[sid] = resolved;
        return resolved;
    }

    private string? TranslateNetBiosDomain(string sid)
    {
        try
        {
            var account = new System.Security.Principal.SecurityIdentifier(sid)
                .Translate(typeof(System.Security.Principal.NTAccount))
                .Value;

            var slash = account.IndexOf('\\');
            return slash > 0 ? account[..slash] : null;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not resolve a NetBIOS domain for a picked group; showing the bare name");
            return null;
        }
    }

    private string DisplayNameFor(string groupValue)
    {
        if (!accessDisplayNames.TryGetValue(groupValue, out var name) || string.IsNullOrWhiteSpace(name))
            return groupValue;

        // Qualify at render time as well as at write time. Rows migrated before the display names
        // were qualified hold a bare name, and re-running the migration will not revisit them - it
        // is idempotent and those rows are already SIDs. Doing it here means an existing store
        // reads correctly without a data fix-up.
        return ExchangeAdminWeb.Authorization.SectionAccessGroupIdentity.QualifiedDisplayName(
            NetBiosDomainOf(groupValue), name);
    }

    private void RemoveAccessGroup(string alias, string group)
    {
        if (accessState[alias].Remove(group))
            dirty.Set(SecAccess, true);
    }

    private void HandleAccessKeyDown(KeyboardEventArgs e, string alias)
    {
        if (e.Key == "Enter") AddAccessGroup(alias);
    }

    private void AddModuleAdmin()
    {
        var input = newAdminGroup?.Trim();
        if (string.IsNullOrWhiteSpace(input)) return;
        if (!moduleAdminGroups.Contains(input, StringComparer.OrdinalIgnoreCase))
        {
            moduleAdminGroups.Add(input);
            dirty.Set(SecAdmins, true);
        }
        newAdminGroup = string.Empty;
    }

    private void RemoveModuleAdmin(string group)
    {
        if (moduleAdminGroups.Remove(group))
            dirty.Set(SecAdmins, true);
    }

    private void HandleAdminKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddModuleAdmin();
    }

    // --- AD Attribute Editor Allowlist ---

    private List<AllowlistRow> allowlistAttributes = new();
    private string? allowlistError;
    private bool allowlistSaved;
    private bool allowlistCorrupt;

    private void LoadAllowlist()
    {
        var list = AttrEditorService.GetAllowlist();
        if (list == null)
        {
            allowlistCorrupt = true;
            allowlistError = "Allowlist config is corrupt. Fix or delete config/ad-editable-attributes.json.";
            allowlistAttributes = new();
            return;
        }

        allowlistCorrupt = false;

        allowlistAttributes = list.Select(a => new AllowlistRow
        {
            Name = a.Name, Label = a.Label, Type = a.Type,
            Choices = a.Choices, Required = a.Required, AllowClear = a.AllowClear,
            MaxLength = a.MaxLength, Pattern = a.Pattern, Level = a.Level
        }).ToList();
        allowlistError = null;
    }

    private void AddAttribute()
    {
        dirty.Set(SecAttrs, true);
        allowlistAttributes.Add(new AllowlistRow
        {
            Name = "", Label = "", Type = "String",
            Required = false, AllowClear = true
        });
    }

    private void RemoveAttribute(int index)
    {
        dirty.Set(SecAttrs, true);
        if (index >= 0 && index < allowlistAttributes.Count)
            allowlistAttributes.RemoveAt(index);
    }

    private void UpdateAttrName(int idx, ChangeEventArgs e) { allowlistAttributes[idx].Name = e.Value?.ToString() ?? ""; dirty.Set(SecAttrs, true); }
    private void UpdateAttrLabel(int idx, ChangeEventArgs e) { allowlistAttributes[idx].Label = e.Value?.ToString() ?? ""; dirty.Set(SecAttrs, true); }
    private void UpdateAttrType(int idx, ChangeEventArgs e) { allowlistAttributes[idx].Type = e.Value?.ToString() ?? "String"; dirty.Set(SecAttrs, true); }
    private void UpdateAttrRequired(int idx, ChangeEventArgs e) { allowlistAttributes[idx].Required = bool.TryParse(e.Value?.ToString(), out var v) && v; dirty.Set(SecAttrs, true); }
    private void UpdateAttrAllowClear(int idx, ChangeEventArgs e) { allowlistAttributes[idx].AllowClear = bool.TryParse(e.Value?.ToString(), out var v) && v; dirty.Set(SecAttrs, true); }
    private void UpdateAttrMaxLength(int idx, ChangeEventArgs e)
    {
        dirty.Set(SecAttrs, true);
        allowlistAttributes[idx].MaxLength = int.TryParse(e.Value?.ToString(), out var v) && v > 0 ? v : null;
    }
    private void UpdateAttrChoices(int idx, ChangeEventArgs e)
    {
        dirty.Set(SecAttrs, true);
        var raw = e.Value?.ToString() ?? "";
        var parsed = raw.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        allowlistAttributes[idx].Choices = parsed.Length > 0 ? parsed : null;
    }

    private async Task SaveAllowlistAsync()
    {
        saving = true;
        allowlistError = null;
        allowlistSaved = false;
        await Task.Yield();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var adminResult = await AuthorizationService.AuthorizeAsync(user, "AdminSettings");
            if (!adminResult.Succeeded && !ModuleAdmin.IsModuleAdmin(module!.Id, user))
            {
                allowlistError = "You are not authorized to save the attribute allowlist.";
                return;
            }

            // Re-check corruption immediately before the write (UI hiding is not security:
            // the disabled buttons can be bypassed, and the file may have become corrupt
            // since the page loaded). Saving over a corrupt store would discard whatever
            // it currently holds — fail closed instead, matching the Section Access card.
            // Must use IsAllowlistCorrupt (reads disk fresh), NOT GetAllowlist: the latter
            // can return a stale-but-valid cached list for up to 30s after the file became
            // corrupt, which would let this gate pass and overwrite the corrupt store.
            if (AttrEditorService.IsAllowlistCorrupt())
            {
                allowlistCorrupt = true;
                allowlistError = "Allowlist store is corrupt; refusing to save over it. Fix or restore config/ad-editable-attributes.json, then reload this page.";
                return;
            }

            var valid = allowlistAttributes
                .Where(a => !string.IsNullOrWhiteSpace(a.Name) && !string.IsNullOrWhiteSpace(a.Label))
                .Select(a => new EditableAttribute(a.Name.Trim(), a.Label.Trim(), a.Type, a.Choices, a.Required, a.AllowClear, a.MaxLength, a.Pattern, a.Level))
                .ToList();

            var denied = valid.Where(a => ADAttributeEditorService.IsDenylisted(a.Name)).ToList();
            if (denied.Count > 0)
            {
                allowlistError = $"Cannot save: {string.Join(", ", denied.Select(d => d.Name))} are on the hard denylist.";
                return;
            }

            AttrEditorService.SaveAllowlist(valid);
            dirty.ClearSection(SecAttrs);
            allowlistSaved = true;

            try
            {
                var ip = ClientInfo.GetIpForUser(currentUser);
                Audit.LogSettingsChange(currentUser, ip, "ADAttributeEditor:Allowlist",
                    Array.Empty<string>(),
                    valid.Select(a => a.Name).ToArray());
            }
            catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for allowlist save"); }
        }
        catch (Exception ex)
        {
            allowlistError = $"Failed to save: {ex.Message}";
            Logger.LogError(ex, "Allowlist save failed");
        }
        finally { saving = false; }
    }

    private void UpdateAttrLevel(int idx, ChangeEventArgs e)
    {
        dirty.Set(SecAttrs, true);
        allowlistAttributes[idx].Level = int.TryParse(e.Value?.ToString(), out var v) && v >= 1 && v <= 3 ? v : 1;
    }

    private sealed class AllowlistRow
    {
        public string Name { get; set; } = "";
        public string Label { get; set; } = "";
        public string Type { get; set; } = "String";
        public string[]? Choices { get; set; }
        public bool Required { get; set; }
        public bool AllowClear { get; set; }
        public int? MaxLength { get; set; }
        public string? Pattern { get; set; }
        public int Level { get; set; } = 1;
    }

    // --- OU Browser/Picker ---

    private bool ouBrowseAvailable;
    private bool showOUBrowser;
    private bool ouLoading;
    private List<OUEntry> ouAllEntries = new();
    private List<OUEntry> ouFilteredEntries = new();
    private HashSet<string> ouSelectedDNs = new(StringComparer.OrdinalIgnoreCase);
    private string ouFilterText = string.Empty;
    private int ouMinDepth;

    private void InitOUBrowser()
    {
        // Probe availability without blocking — just check the cached flag.
        // The actual enumeration happens when the user clicks "Browse OUs".
        ouBrowseAvailable = true;
        showOUBrowser = false;
        ouLoading = false;
        ouFilterText = string.Empty;
        ouAllEntries = new();
        ouFilteredEntries = new();
        ouSelectedDNs = new(StringComparer.OrdinalIgnoreCase);
    }

    private async Task ToggleOUBrowser()
    {
        if (showOUBrowser)
        {
            showOUBrowser = false;
            return;
        }

        // Load OUs when opening the browser for the first time
        if (ouAllEntries.Count == 0)
        {
            await LoadOUsAsync();
            if (!ouBrowseAvailable) return;
        }

        // Pre-select OUs already in the config value
        SyncSelectedFromConfig();
        showOUBrowser = true;
    }

    private async Task LoadOUsAsync()
    {
        ouLoading = true;
        await Task.Yield();

        try
        {
            ouAllEntries = await Task.Run(() => OUService.GetOrganizationalUnits());
            ouBrowseAvailable = OUService.IsAvailable;

            if (!ouBrowseAvailable)
            {
                ouAllEntries = new();
                ouFilteredEntries = new();
                return;
            }

            ouMinDepth = ouAllEntries.Count > 0 ? ouAllEntries.Min(e => e.Depth) : 0;
            ApplyOUFilter();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "OU browser load failed");
            ouBrowseAvailable = false;
        }
        finally
        {
            ouLoading = false;
        }
    }

    private async Task RefreshOUs()
    {
        OUService.InvalidateCache();
        ouAllEntries = new();
        await LoadOUsAsync();
        if (ouBrowseAvailable)
        {
            SyncSelectedFromConfig();
        }
    }

    private void SyncSelectedFromConfig()
    {
        ouSelectedDNs.Clear();
        var currentValue = GetConfigValue("DefaultSearchBase", "");
        if (!string.IsNullOrWhiteSpace(currentValue))
        {
            var dns = currentValue.Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            foreach (var dn in dns)
                ouSelectedDNs.Add(dn);
        }
    }

    private void ToggleOU(string dn, bool isChecked)
    {
        dirty.Set(SecConfig, true);
        if (isChecked)
            ouSelectedDNs.Add(dn);
        else
            ouSelectedDNs.Remove(dn);
    }

    private void ApplySelectedOUs()
    {
        var value = string.Join(";", ouSelectedDNs.OrderBy(d => d, StringComparer.OrdinalIgnoreCase));
        SetConfigValue("DefaultSearchBase", value);
        showOUBrowser = false;
    }

    private void OnOUFilterChanged(ChangeEventArgs e)
    {
        ouFilterText = e.Value?.ToString() ?? string.Empty;
        ApplyOUFilter();
    }

    private void ApplyOUFilter()
    {
        if (string.IsNullOrWhiteSpace(ouFilterText))
        {
            ouFilteredEntries = ouAllEntries;
        }
        else
        {
            ouFilteredEntries = ouAllEntries
                .Where(ou => ou.Name.Contains(ouFilterText, StringComparison.OrdinalIgnoreCase)
                          || ou.DistinguishedName.Contains(ouFilterText, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }
}

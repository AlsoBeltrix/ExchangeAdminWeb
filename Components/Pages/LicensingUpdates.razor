@page "/licensing-updates"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "LicensingUpdates")]
@rendermode InteractiveServer
@inject LicensingUpdatesService LicenseService
@inject IActivityProgress Progress
@inject AuditService Audit
@inject EmailService Email
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager Navigation
@inject ClientInfoService ClientInfo
@inject ILogger<LicensingUpdates> Logger

<PageTitle>Licensing Updates</PageTitle>

@if (!authChecked)
{
    @* NO SPINNER. No module draws its own progress (owner ruling 2026-10-02,
       `.agents/decisions.md`), and nothing replaces this one: GroupAuthorizationHandler is
       synchronous end to end, so the check finishes faster than a frame and a bar line
       flickering inside a single render is noise, not information.
       The GUARD stays and must stay - it is what stops the page rendering before the check
       has passed, which is refusal, not progress. Kept at the SAME LINE COUNT as the markup
       it replaces, so not one ClickGateRegistry line key moves. *@
    return;
}

<div class="container-fluid">
    <div class="alert alert-info py-2 mb-3">
        <small>Bulk update Exchange licensing SKU assignments via CSV upload. Target attribute: <code>extensionAttribute11</code>.</small>
    </div>
    <h1 class="mb-4">Licensing Updates<ModuleVersion /></h1>

    @if (operationResult != null)
    {
        <div class="alert @(operationResult.Value.success ? "alert-success" : "alert-danger") alert-dismissible">
            @operationResult.Value.message
            <button type="button" class="btn-close" @onclick="() => operationResult = null"></button>
        </div>
    }

    <div class="row g-3">
        <div class="col-lg-8">
            <!-- Upload Card -->
            <div class="card mb-3">
                <div class="card-header"><strong>Upload CSV</strong></div>
                <div class="card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">License Type</label>
                            <select class="form-select" @bind="selectedLicenseType" disabled="@(isProcessing || previewResult != null)">
                                @foreach (var lt in allowedLicenseTypes)
                                {
                                    <option value="@lt">@lt</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-semibold">CSV File (first column = user identifier)</label>
                            <InputFile OnChange="OnFileSelected" disabled="@(isProcessing || previewResult != null)" class="form-control" accept=".csv,.txt" />
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-primary w-100" @onclick="RunPreview"
                                    disabled="@(isProcessing || selectedFile == null || previewResult != null)">
                                Preview
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            @if (previewError != null)
            {
                <div class="alert alert-danger">@previewError</div>
            }

            <!-- Preview Table -->
            @if (previewResult != null && applyResult == null)
            {
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Preview — @previewResult.Rows.Count row(s)</strong>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="ResetForm" disabled="@isProcessing">Cancel</button>
                    </div>
                    <div class="card-body p-0">
                        <div>
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>User</th>
                                        <th>Display Name</th>
                                        <th>Current</th>
                                        <th>Proposed</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in previewResult.Rows)
                                    {
                                        <tr class="@(row.Error != null ? "table-danger" : row.CurrentValue == row.ProposedValue ? "table-secondary" : "")">
                                            <td><small>@row.InputIdentity</small></td>
                                            <td><small>@(row.Principal?.DisplayName ?? "—")</small></td>
                                            <td><small>@(row.CurrentValue ?? "<em>empty</em>")</small></td>
                                            <td><small><strong>@row.ProposedValue</strong></small></td>
                                            <td>
                                                @if (row.Error != null)
                                                {
                                                    <small class="text-danger">@row.Error</small>
                                                }
                                                else if (row.CurrentValue == row.ProposedValue)
                                                {
                                                    <small class="text-muted">No change</small>
                                                }
                                                else
                                                {
                                                    <small class="text-success">Ready</small>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <!-- Apply Results -->
            @if (applyResult != null)
            {
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Results — @applyResult.TotalRows row(s)</strong>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="ResetForm">New Upload</button>
                    </div>
                    <div class="card-body p-0">
                        <div class="px-3 py-2 border-bottom bg-light">
                            <span class="badge bg-success me-1">@applyResult.Succeeded succeeded</span>
                            <span class="badge bg-secondary me-1">@applyResult.Unchanged unchanged</span>
                            <span class="badge bg-warning text-dark me-1">@applyResult.Protected protected</span>
                            <span class="badge bg-danger me-1">@applyResult.Failed failed</span>
                        </div>
                        <div>
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>User</th>
                                        <th>Status</th>
                                        <th>Previous</th>
                                        <th>New</th>
                                        <th>Error</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in applyResult.Rows)
                                    {
                                        var rowClass = row.Status switch
                                        {
                                            "Success" => "table-success",
                                            "Unchanged" => "",
                                            "Protected" => "table-warning",
                                            _ => "table-danger"
                                        };
                                        <tr class="@rowClass">
                                            <td><small>@(row.UserPrincipalName ?? row.InputIdentity)</small></td>
                                            <td><small><strong>@row.Status</strong></small></td>
                                            <td><small>@(row.PreviousValue ?? "—")</small></td>
                                            <td><small>@(row.NewValue ?? "—")</small></td>
                                            <td><small class="text-danger">@row.Error</small></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Right Panel: Apply -->
        <div class="col-lg-4">
            <div class="card" style="position: sticky; top: 1rem;">
                @if (previewResult != null && applyResult == null)
                {
                    var readyCount = previewResult.Rows.Count(r => r.Error == null && r.CurrentValue != r.ProposedValue);
                    <div class="card-header"><strong>Apply Changes</strong></div>
                    <div class="card-body">
                        <p class="mb-2">
                            <strong>@readyCount</strong> user(s) will be updated to <strong>@previewResult.LicenseType</strong>.
                        </p>
                        @if (previewResult.Rows.Any(r => r.Error != null))
                        {
                            <p class="text-warning mb-2"><small>@previewResult.Rows.Count(r => r.Error != null) row(s) have errors and will be skipped.</small></p>
                        }
                        @if (previewResult.Rows.Any(r => r.CurrentValue == r.ProposedValue && r.Error == null))
                        {
                            <p class="text-muted mb-2"><small>@previewResult.Rows.Count(r => r.CurrentValue == r.ProposedValue && r.Error == null) row(s) already have this value.</small></p>
                        }
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Ticket Number</label>
                            <input type="text" class="form-control" @bind="ticketNumber" @bind:event="oninput" placeholder="INC/REQ number" disabled="@isProcessing" />
                        </div>
                        <button class="btn btn-primary w-100" @onclick="RunApply"
                                disabled="@(isProcessing || string.IsNullOrWhiteSpace(ticketNumber) || readyCount == 0)">
                            Apply to @readyCount user(s)
                        </button>
                    </div>
                }
                else
                {
                    <div class="card-header"><strong>Instructions</strong></div>
                    <div class="card-body">
                        <p class="text-muted mb-2">1. Select a license type</p>
                        <p class="text-muted mb-2">2. Upload a CSV (first column = UPN, email, or sAMAccountName)</p>
                        <p class="text-muted mb-2">3. Preview to verify resolved users</p>
                        <p class="text-muted mb-0">4. Enter a ticket number and apply</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string currentUser = "";
    private string clientIpAddress = "Unknown";
    private bool authChecked;
    private bool isProcessing;

    private string[] allowedLicenseTypes = [];
    private string selectedLicenseType = "";
    private IBrowserFile? selectedFile;
    private string? previewError;
    private LicensePreviewResult? previewResult;
    private LicenseBulkResult? applyResult;
    private string ticketNumber = "";
    private (bool success, string message)? operationResult;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUser = user.Identity?.Name ?? "Unknown";

        var authResult = await AuthorizationService.AuthorizeAsync(user, "LicensingUpdates");
        if (!authResult.Succeeded)
        {
            Navigation.NavigateTo("access-denied", forceLoad: true);
            return;
        }

        clientIpAddress = ClientInfo.IpAddress != "Unknown"
            ? ClientInfo.IpAddress
            : ClientInfo.GetIpForUser(currentUser);

        allowedLicenseTypes = LicenseService.GetAllowedLicenseTypes();
        if (allowedLicenseTypes.Length > 0)
            selectedLicenseType = allowedLicenseTypes[0];

        authChecked = true;
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        previewError = null;
    }

    /// <summary>
    /// Resolves every row of the uploaded CSV against the directory and builds the preview.
    /// </summary>
    /// <remarks>
    /// The survey's entry for this one is accurate and worth keeping: it fetches Delinea
    /// credentials, waits out a two-minute AD throttle and resolves every row against the
    /// directory, and all of it ran with the bar idle. It is also the longest wait on the page -
    /// RunApply, which already reports, cannot start until it has finished.
    ///
    /// ONE covered call, and it is the whole operation rather than a convenient first call.
    /// Services/LicensingUpdatesService.cs PreviewCsvAsync does all four of those things inside
    /// itself: GetCredentialsAsync over HTTP, ParseCsvAsync over the uploaded stream,
    /// _adThrottle.WaitAsync(TimeSpan.FromMinutes(2)), then ResolveUsers on a thread-pool thread.
    /// selectedFile.OpenReadStream above it was read and deliberately NOT named - it hands back a
    /// stream object and pulls nothing until PreviewCsvAsync reads it - and everything below is
    /// one field assignment, so there is no tail for the window to miss.
    ///
    /// ActivitySize.Unknown is FORCED, not chosen: the row count does not exist until the call
    /// the Begin has to dominate has returned. The file name is what the operator recognises, so
    /// that is the label, and the count goes in the Complete message.
    ///
    /// TWO Completes, both BELOW the covered call, so the scanner's "first Complete after the
    /// Begin" rule is satisfied on either path and the early return did not have to become an
    /// if/else the way Migration.DownloadReportExportAsync's did. A preview that came back
    /// unsuccessful is a refusal and completes FALSE with the service's own words; an exception
    /// falls out of scope to the dispose fallback.
    ///
    /// No snapshot: the InputFile at :61 is disabled="@(isProcessing || previewResult != null)"
    /// and isProcessing is raised above the yield, so selectedFile cannot be replaced under this.
    ///
    /// The licence type IS snapshotted (kd-72). The select carries the same disabled clause, but the
    /// browser's copy of it is one round trip stale and a pick in the select lands in one event, so a
    /// pick in the yield used to preview the rows against a type the operator did not submit.
    /// </remarks>
    private async Task RunPreview()
    {
        // kd-72. A second click while a preview runs is ignored, not run beside it: Preview is disabled
        // while isProcessing, but the browser's copy of that is one round trip stale.
        if (isProcessing) return;
        if (selectedFile == null) return;
        var licenseType = selectedLicenseType;
        isProcessing = true;
        previewError = null;
        previewResult = null;

        using var activity = Progress.Begin(
            "Licensing Updates",
            $"Previewing {selectedFile.Name} against the directory",
            ActivitySize.Unknown);

        await Task.Yield();

        try
        {
            await using var stream = selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var result = await LicenseService.PreviewCsvAsync(stream, selectedFile.Name, licenseType, currentUser, clientIpAddress);

            if (!result.Success)
            {
                previewError = result.Error;
                activity.Complete(false, result.Error);
                return;
            }

            previewResult = result;

            // Reads the LOCAL result, not previewResult: the field is what the pane renders and
            // the Clear button is wired straight at it, so a read back down here would be the
            // post-await live-read trap this work stream keeps meeting.
            activity.Complete(true, $"{result.Rows.Count:N0} row(s) previewed.");
        }
        catch (Exception ex)
        {
            previewError = ex.Message;
            Logger.LogError(ex, "Licensing preview failed");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RunApply()
    {
        if (previewResult == null) return;
        isProcessing = true;
        operationResult = null;

        // Audit finding A15. Everything this run needs, captured BEFORE the first await.
        // Cancel (ResetForm) nulls previewResult and clears ticketNumber, and it was reachable
        // throughout the apply - so a click during the write made previewResult.LicenseType
        // throw INSIDE the notification try, where the catch logged an email failure and moved
        // on. The licences had already been changed and the required admin notification was
        // silently dropped. The ticket would have been empty by then too.
        var preview = previewResult;
        var ticket = ticketNumber.Trim();

        await Task.Yield();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authCheck = await AuthorizationService.AuthorizeAsync(authState.User, "LicensingUpdates");
            if (!authCheck.Succeeded)
            {
                operationResult = (false, "Authorization denied.");
                return;
            }

            // One write per CSV row, so the row count IS known and the frame can show a true
            // "x of y" rather than an undifferentiated spinner over a bulk licence change.
            using var activity = Progress.Begin(
                "Licensing Updates", "Applying licence changes",
                ActivitySize.Items(preview.Rows.Count));

            var applied = await LicenseService.ApplyCsvAsync(preview, ticket, currentUser, clientIpAddress, authState.User);
            applyResult = applied;
            activity.Report(applied.TotalRows);
            activity.Complete(applied.Success, applied.Success
                ? $"{applied.Succeeded:N0} applied, {applied.Unchanged:N0} unchanged, {applied.Failed:N0} failed"
                : applied.Error);

            if (applied.Success)
            {
                operationResult = (true, $"Completed: {applied.Succeeded} updated, {applied.Unchanged} unchanged, {applied.Protected} protected, {applied.Failed} failed.");
            }
            else
            {
                operationResult = (false, applied.Error ?? "Apply failed.");
            }

            try
            {
                await Email.SendAdminNotificationAsync(currentUser, clientIpAddress, "LicensingUpdates_BulkApply",
                    applied.Success, ticket,
                    new Dictionary<string, string>
                    {
                        ["License Type"] = preview.LicenseType,
                        ["Total"] = applied.TotalRows.ToString(),
                        ["Succeeded"] = applied.Succeeded.ToString(),
                        ["Unchanged"] = applied.Unchanged.ToString(),
                        ["Protected/Blocked"] = applied.Protected.ToString(),
                        ["Failed"] = applied.Failed.ToString()
                    }, applied.Error);
            }
            catch (Exception emailEx) { Logger.LogError(emailEx, "Email notification failed for licensing apply"); }
        }
        catch (Exception ex)
        {
            operationResult = (false, ex.Message);
            Logger.LogError(ex, "Licensing apply failed");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void ResetForm()
    {
        selectedFile = null;
        previewResult = null;
        applyResult = null;
        previewError = null;
        ticketNumber = "";
        operationResult = null;
    }
}

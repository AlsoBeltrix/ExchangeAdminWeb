@page "/out-of-office"
@using ExchangeAdminWeb.Models
@using ExchangeAdminWeb.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "OutOfOffice")]
@rendermode InteractiveServer
@inject OutOfOfficeService OofService
@inject IActivityProgress Progress
@inject AuditService Audit
@inject EmailService Email
@inject PermissionValidator Validator
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager Navigation
@inject ClientInfoService ClientInfo
@inject IJSRuntime JS
@inject ILogger<ExchangeAdminWeb.Components.Pages.OutOfOffice> Logger

<PageTitle>Out of Office</PageTitle>

<div class="container-fluid mt-4">
    <div class="alert alert-info py-2 mb-3"><small>All auto-reply changes are logged for audit purposes. The mailbox owner may be notified of modifications.</small></div>
    <h2>Out of Office / Auto-Reply<ModuleVersion /></h2>
    <p class="text-muted">Check or set auto-reply configuration for a mailbox</p>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link @(tabIndex == 0 ? "active" : "")" @onclick="() => tabIndex = 0" href="javascript:void(0)">Check Status</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(tabIndex == 1 ? "active" : "")" @onclick="() => tabIndex = 1" href="javascript:void(0)">Set / Clear</a>
        </li>
    </ul>

    @if (tabIndex == 0)
    {
        <div class="card">
            <div class="card-body">
                <div class="row g-3 mb-3">
                    <div class="col-md-5">
                        <label class="form-label">Email Address</label>
                        <RecipientAutocomplete @bind-Value="checkEmail"
                                               Placeholder="user@example.com"
                                               Disabled="@isChecking" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button class="btn btn-primary" @onclick="CheckStatus"
                                disabled="@(string.IsNullOrWhiteSpace(checkEmail) || isChecking)">
                            Check
                        </button>
                    </div>
                </div>

                @if (checkResult?.Error != null)
                {
                    <div class="alert alert-danger mt-3">@checkResult.Error</div>
                }
                else if (checkResult != null)
                {
                    <div class="card mt-3">
                        <div class="card-header">
                            <span class="badge bg-@GetStateBadge(checkResult.State) me-2">@checkResult.State</span>
                            @checkResult.EmailAddress
                        </div>
                        <div class="card-body">
                            @if (checkResult.State == "Scheduled" && checkResult.StartTime.HasValue)
                            {
                                <p><strong>Schedule:</strong> @ReadScheduleTime(checkResult.StartTime.Value) — @(checkResult.EndTime is { } end ? ReadScheduleTime(end) : "")</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(checkResult.InternalMessage))
                            {
                                <h6>Internal Message</h6>
                                <div class="border rounded p-2 mb-3 bg-light" style="max-height:200px;overflow:auto">
                                    <pre class="mb-0" style="white-space:pre-wrap;word-break:break-word">@StripHtml(checkResult.InternalMessage)</pre>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(checkResult.ExternalMessage))
                            {
                                <h6>External Message</h6>
                                <div class="border rounded p-2 bg-light" style="max-height:200px;overflow:auto">
                                    <pre class="mb-0" style="white-space:pre-wrap;word-break:break-word">@StripHtml(checkResult.ExternalMessage)</pre>
                                </div>
                            }
                            @if (checkResult.State == "Disabled")
                            {
                                <p class="text-muted mb-0">Auto-reply is currently disabled.</p>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Email Address</label>
                        <RecipientAutocomplete @bind-Value="setEmail"
                                               Placeholder="user@example.com"
                                               Disabled="@isSetting" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Ticket Number</label>
                        <input type="text" class="form-control" @bind="ticketNumber" @bind:event="oninput" placeholder="INC0000000" disabled="@isSetting" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Action</label>
                        <select class="form-select" @bind="oofState" disabled="@isSetting">
                            <option value="Enabled">Enable</option>
                            <option value="Scheduled">Schedule</option>
                            <option value="Disabled">Disable</option>
                        </select>
                    </div>
                </div>

                @if (oofState == "Scheduled")
                {
                    @* aud-a7e. The times are wall clock in the operator's browser's zone, and the zone is
                       stated beside them - the operator must know what they are entering. Until the
                       browser has said which zone it is in, or if it cannot, there is nothing to enter:
                       a time with no zone names no moment, and the page does not guess one. *@
                    if (scheduleZone is null)
                    {
                        <div class="alert alert-warning py-2 mb-3"><small>@(scheduleZoneError ?? "Reading your browser's time zone...")</small></div>
                    }
                    else
                    {
                        <div class="row g-3 mb-3">
                            <div class="col-md-3">
                                <label class="form-label">Start Date/Time</label>
                                <input type="datetime-local" class="form-control" @bind="startTime" disabled="@isSetting" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">End Date/Time</label>
                                <input type="datetime-local" class="form-control" @bind="endTime" disabled="@isSetting" />
                            </div>
                            <div class="col-md-6 d-flex align-items-end">
                                <small class="text-muted">@ScheduleZoneLabel</small>
                            </div>
                        </div>
                    }
                }

                @if (oofState != "Disabled")
                {
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Internal Message</label>
                            <textarea class="form-control" rows="4" @bind="internalMessage" placeholder="Message for internal senders" disabled="@isSetting"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">External Message</label>
                            <textarea class="form-control" rows="4" @bind="externalMessage" placeholder="Message for external senders (optional)" disabled="@isSetting"></textarea>
                        </div>
                    </div>
                }

                <button class="btn btn-primary" @onclick="SetOof"
                        disabled="@(!IsSetFormValid || isSetting)">
                    @(oofState == "Disabled" ? "Disable Auto-Reply" : "Set Auto-Reply")
                </button>

                @if (setValidationError != null)
                {
                    <div class="alert alert-danger mt-3">@setValidationError</div>
                }

                @if (setResult != null)
                {
                    <div class="alert alert-@(setResult.Success ? "success" : "danger") mt-3">
                        @setResult.Message
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private int tabIndex = 0;
    private string currentUser = "";
    private string clientIpAddress = "Unknown";

    // Check tab
    private string checkEmail = "";
    private bool isChecking = false;
    private OutOfOfficeResult? checkResult;

    // Set tab
    private string setEmail = "";
    private string ticketNumber = "";
    private string oofState = "Enabled";
    private string internalMessage = "";
    private string externalMessage = "";
    private DateTime startTime = DateTime.Now;
    private DateTime endTime = DateTime.Now.AddDays(7);

    // aud-a7e. The zone startTime and endTime are entered in: the browser's own, read once by
    // ReadScheduleZoneAsync. Null until then and null for good if it cannot be read - never a fallback
    // to the server's zone, which the operator would have no way to know. No control binds it, but it
    // is an input to SetOof's one capture like the bound fields, and read only there.
    private TimeZoneInfo? scheduleZone;
    private string? scheduleZoneError;
    private bool isSetting = false;

    /// <summary>Module id for the servicer grant. Must match the catalog descriptor.</summary>
    private const string ServicerModuleId = "OutOfOffice";

    // Set when an authorised servicer overrode a protected-principal refusal, and merged into the
    // SUCCESS audit's extra. Assigned on every validation so one serviced action cannot label the next.
    private string? servicedNote;
    private string? setValidationError;
    private PermissionResult? setResult;

    private bool IsSetFormValid =>
        !string.IsNullOrWhiteSpace(setEmail)
        && !string.IsNullOrWhiteSpace(ticketNumber)
        && (oofState == "Disabled" || !string.IsNullOrWhiteSpace(internalMessage));

    private string ScheduleZoneLabel =>
        scheduleZone is null ? "" : $"Times are in your browser's time zone, {OutOfOfficeRequest.ZoneName(scheduleZone)}.";

    // aud-a7f. A read schedule is shown in the zone the operator enters one in - the browser's, read
    // once on the first render - with the zone and offset named, as the owner's notice names them. With
    // no browser zone the instant is still known, so it is shown in UTC and labelled UTC: a stated
    // reference for a known moment, not a guessed zone.
    private string ReadScheduleTime(DateTime reported) =>
        OutOfOfficeRequest.ShowReported(reported, scheduleZone ?? TimeZoneInfo.Utc);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUser = user.Identity?.Name ?? "Unknown";

        var authResult = await AuthorizationService.AuthorizeAsync(user, "OutOfOffice");
        if (!authResult.Succeeded)
        {
            Navigation.NavigateTo("access-denied", forceLoad: true);
            return;
        }

        clientIpAddress = ClientInfo.IpAddress != "Unknown"
            ? ClientInfo.IpAddress
            : ClientInfo.GetIpForUser(currentUser);
    }

    // aud-a7e. After the first interactive render, because JS interop does not exist before it
    // (prerendering included). One read per page.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await ReadScheduleZoneAsync();
        StateHasChanged();
    }

    // Kept apart from OnAfterRenderAsync so it runs without a renderer (StateHasChanged needs one).
    // The IANA id is resolved with FindSystemTimeZoneById, which takes IANA ids through ICU: an id
    // this server cannot resolve is a failure, never a reason to pick another zone.
    //
    // aud-a7g: two failures, two messages. The browser not saying (the call fails, or answers blank)
    // may pass with a reload. An id the browser did give that this server cannot resolve will not: it is
    // the server's time-zone data, so the operator is shown the id and what an administrator must fix.
    private async Task ReadScheduleZoneAsync()
    {
        string? id;
        try
        {
            id = await JS.InvokeAsync<string?>("getBrowserTimeZone");
        }
        catch (Exception ex)
        {
            scheduleZoneError = BrowserZoneUnread;
            Logger.LogWarning(ex, "The browser did not report its time zone for the Out of Office schedule");
            return;
        }

        if (string.IsNullOrWhiteSpace(id))
        {
            scheduleZoneError = BrowserZoneUnread;
            Logger.LogWarning("The browser reported an empty time zone for the Out of Office schedule");
            return;
        }

        TimeZoneInfo zone;
        try
        {
            zone = TimeZoneInfo.FindSystemTimeZoneById(id);
        }
        catch (Exception ex)
        {
            scheduleZoneError = $"Your browser reports its time zone as '{id}', but this server cannot resolve that name, so a schedule "
                + "cannot be set here, and reloading the page will not change that. An administrator must fix the server's time-zone "
                + "data: .NET resolves these names through ICU, which must be present on the server and not switched off "
                + "(invariant-globalization or NLS mode), with this zone in its data. Enable and Disable still work.";
            Logger.LogWarning(ex, "This server cannot resolve the browser's time zone {ZoneId} for the Out of Office schedule", id);
            return;
        }

        // The defaults were DateTime.Now - the server's clock. Re-based to the browser's before the
        // fields are shown, so an untouched default is "now" in the zone the label states.
        var now = DateTime.SpecifyKind(TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, zone), DateTimeKind.Unspecified);
        startTime = now;
        endTime = now.AddDays(7);
        scheduleZone = zone;
    }

    private const string BrowserZoneUnread = "Your browser's time zone could not be read, so a schedule cannot be set here: its times "
        + "would name no moment. Enable and Disable still work; reload the page to try again.";

    private async Task HandleCheckKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(checkEmail))
            await CheckStatus();
    }

    private async Task CheckStatus()
    {
        if (string.IsNullOrWhiteSpace(checkEmail)) return;
        isChecking = true;
        checkResult = null;

        // Audit finding aud-a7c. Captured before the read: the lookup audit used to take its target
        // from the box AFTER the await, so an edit during the read recorded a lookup of a mailbox
        // that was never read. Nothing below may read checkEmail.
        var mailbox = checkEmail.Trim();

        try
        {
            using var activity = Progress.Begin(
                "Out of Office", $"Reading auto-reply for {mailbox}", ActivitySize.Unknown);

            checkResult = await OofService.GetOutOfOfficeAsync(mailbox);
            activity.Complete(checkResult.Error == null, checkResult.Error);
            Audit.LogLookupAction(currentUser, clientIpAddress, "CheckOutOfOffice", mailbox, checkResult.Error == null, checkResult.Error);
        }
        catch (Exception ex)
        {
            checkResult = new OutOfOfficeResult { EmailAddress = mailbox, State = "Unknown", Error = ex.Message };
        }
        finally
        {
            isChecking = false;
        }
    }

    public static string? ValidateOofSchedule(string state, DateTime? start, DateTime? end, TimeZoneInfo? zone)
    {
        if (state != "Scheduled") return null;
        if (!start.HasValue || !end.HasValue)
            return "Start and end times are required for scheduled auto-reply.";
        // aud-a7e. Refused here, before anything is audited, notified or written; the service refuses
        // the same request again at the write. Order is compared on the instants the write will send.
        // aud-a7g: a time the zone repeats names two instants and is refused like one it skips; the
        // refusal names the time, so the operator can see which field to move out of the hour.
        if (zone is null)
            return "The schedule's time zone is not known, so its times name no moment. Reload the page so your browser's time zone can be read.";
        var startUtc = OutOfOfficeRequest.ToUtc(start.Value, zone);
        var endUtc = OutOfOfficeRequest.ToUtc(end.Value, zone);
        if (startUtc is null || endUtc is null)
        {
            var (which, time) = startUtc is null ? ("start", start.Value) : ("end", end.Value);
            return $"The {which} time, {OutOfOfficeRequest.ClockText(time)}, {OutOfOfficeRequest.NoInstantReason(time, zone)}.";
        }
        if (endUtc.Value <= startUtc.Value)
            return "End time must be after start time.";
        return null;
    }

    private async Task SetOof()
    {
        // Audit finding A7. The mailbox box stayed editable through the awaited
        // protected-principal check - isSetting went up only afterwards - and every later step
        // re-read setEmail. So an operator could submit an unprotected mailbox, change the
        // address while resolution was in flight, and have the write land on a protected one
        // that nothing had checked. Three separate reviews reached this independently.
        //
        // Both halves are needed. The guard closes the window; the capture means that even if
        // something else re-opens it, this run acts on the address it validated. Same shape as
        // the Comms-10k C7 fix, and the first statement rather than a later one so no reset or
        // await can sit in front of it.
        if (isSetting) return;
        isSetting = true;

        // Audit finding aud-a7b. A7 captured the mailbox and nothing else: the state, both
        // messages, the schedule and the ticket were still read from the bound fields at the write
        // and again at the audit, after several awaits. An edit landing in between changed what was
        // written, and let the audit row and the notification name a state or ticket the change was
        // not made under. Every input is now captured here, once, before the first await, into one
        // immutable request - the Comms-10k C7 shape - and nothing below this line may read a bound
        // field. The service takes the request itself, so the write cannot be handed anything else.
        // aud-a7e: the schedule's zone is captured with the times it belongs to.
        var request = OutOfOfficeRequest.FromForm(
            setEmail, oofState, internalMessage, externalMessage, startTime, endTime, scheduleZone, ticketNumber);
        var target = request.Mailbox;

        setValidationError = null;
        setResult = null;

        setValidationError = ValidateOofSchedule(request.State, request.StartTime, request.EndTime, request.ScheduleZone);
        if (setValidationError != null)
        {
            isSetting = false;
            return;
        }

        var oofLabel = request.State == "Disabled"
            ? $"Disabling auto-reply for {target}"
            : $"Setting auto-reply for {target}";

        // Opened HERE, above the protected-principal resolve, and completed in the finally AFTER
        // both notification emails. NamedLocations.SaveLocation is the shape this copies.
        //
        // Above the resolve, not at the write, because ValidateTargetMailboxAsync reaches
        // ProtectedPrincipalService.ResolveWithExchangeFallbackAsync whenever a Group, OU or
        // pattern rule is configured - the Exchange round trip this codebase documents at 10-15
        // seconds. Leaving that above the Begin is exactly the PARTIAL shape
        // docs/ProgressCoverage-Plan.md records against MfaReset.ExecuteReset.
        //
        // Five steps, because the sequence is fixed once the operation proceeds. A refusal
        // completes early at the step it reached, which is what happened, not a lie about size.
        using var activity = Progress.Begin("Out of Office", oofLabel, ActivitySize.Steps(5));

        // The try starts HERE, above the target check, not below it. Review of aud-a7 found that
        // raising isSetting before the awaited protected-principal check - which is the whole
        // point of that fix - put two new ways out of this method in front of the finally: the
        // refusal's own return, and anything the resolve throws. Either left the mailbox box and
        // the submit button disabled for good, with the operator having to reload the page.
        //
        // There is still exactly one Complete in source order, in the finally, so the registry's
        // condition 3 reads what it read before. The refusal now completes the activity as the
        // non-success it is, carrying its reason, instead of being ended silently by the using.
        try
        {
            activity.Step("checking the target");

            // Own module id. This validator is shared with Mailbox Permissions and Calendar, so
            // borrowing one of theirs would let a grant there authorise Out of Office changes to
            // protected principals - the per-module boundary is the containment for this whole design.
            //
            // The principal is read here rather than reused from below: this check runs BEFORE the
            // authorization re-check that creates `authState`, and the servicer decision must be made
            // against the current token wherever it is asked.
            var oofAuthState = await AuthStateProvider.GetAuthenticationStateAsync();
            var protectedValidation = await Validator.ValidateTargetMailboxAsync(
                target, oofAuthState.User, ServicerModuleId);
            servicedNote = protectedValidation.ServicedNote;
            var protectedError = protectedValidation.Error;
            if (protectedError != null)
            {
                setResult = PermissionResult.Fail(protectedError);
                try
                {
                    Audit.LogModuleAction(currentUser, clientIpAddress,
                        "OutOfOffice_Denied", "OutOfOffice", target, false, request.Ticket, protectedError);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to write audit log for OOF protected-user denial on {Target}", target);
                }
                return;
            }

            activity.Step("checking your permission");
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authCheck = await AuthorizationService.AuthorizeAsync(authState.User, "OutOfOffice");
            if (!authCheck.Succeeded)
            {
                setResult = PermissionResult.Fail("Authorization denied.");
                try
                {
                    Audit.LogModuleAction(currentUser, clientIpAddress,
                        "OutOfOffice_Denied", "OutOfOffice", target, false, request.Ticket, "Authorization denied (re-check)");
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to write audit log for OOF auth re-check denial on {Target}", target);
                }
                return;
            }

            // Fetch current state before mutation for audit trail - of the mailbox the write is
            // bound to (aud-a2d), so the state recorded belongs to the mailbox changed.
            string previousState = "Unknown";
            try
            {
                activity.Step("reading the current auto-reply state");
                var currentOof = await OofService.GetOutOfOfficeAsync(protectedValidation.Mailbox);
                if (currentOof != null && currentOof.Error == null)
                    previousState = currentOof.State ?? "Unknown";
            }
            catch (Exception ex) { Logger.LogWarning(ex, "Could not retrieve current OOF state for {Target} before mutation", target); }

            // aud-a2d. The write takes the mailbox the check validated, never request.Mailbox: the
            // captured address is what the operator asked for, the validation's mailbox is what it is.
            activity.Step(request.State == "Disabled" ? "disabling the auto-reply" : "writing the auto-reply");
            setResult = await OofService.SetOutOfOfficeAsync(request, protectedValidation.Mailbox);

            var action = request.State == "Disabled" ? "OutOfOffice_Disable" : "OutOfOffice_Set";
            var extra = new Dictionary<string, object?>
            {
                ["previousState"] = previousState,
                ["newState"] = request.State
            };

            // MERGED into the existing extra, not replacing it: this page already records state
            // transitions there, and overwriting the dictionary would trade one audit field for
            // another. Only present when a servicer overrode a protected-principal refusal.
            if (servicedNote is not null)
                extra[ProtectedPrincipalServicing.AuditKey] = servicedNote;

            // The identity written rides beside them; `target` stays the address as typed.
            ValidatedMailbox.WithWrittenIdentity(extra, protectedValidation.Mailbox);

            try
            {
                Audit.LogModuleAction(currentUser, clientIpAddress,
                    action, "OutOfOffice", target, setResult.Success, request.Ticket,
                    setResult.Success ? null : setResult.Message, extra);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to write audit log for SetOutOfOffice on {Target}", target);
            }

            activity.Step("sending notifications");

            try
            {
                await Email.SendAdminNotificationAsync(
                    currentUser, clientIpAddress,
                    request.State == "Disabled" ? "DisableOutOfOffice" : $"SetOutOfOffice_{request.State}",
                    target, "N/A", "OutOfOffice",
                    setResult.Success, request.Ticket,
                    setResult.Success ? null : setResult.Message);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to send admin notification for SetOutOfOffice on {Target}", target);
            }

            if (setResult.Success)
            {
                try
                {
                    // aud-a7d: the captured request, not a two-way "enabled"/"disabled" word - a
                    // Scheduled write is reported to the mailbox owner as scheduled, with its window.
                    await Email.SendOofNotificationAsync(
                        target, currentUser, request);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to send OOF notification to {Target}", target);
                }
            }
        }
        catch (Exception ex)
        {
            setResult = PermissionResult.Fail(ex.Message);
            try
            {
                Audit.LogModuleAction(currentUser, clientIpAddress,
                    request.State == "Disabled" ? "OutOfOffice_Disable" : "OutOfOffice_Set",
                    "OutOfOffice", target, false, request.Ticket, ex.Message,
                    new Dictionary<string, object?> { ["newState"] = request.State });
            }
            catch (Exception auditEx)
            {
                Logger.LogError(auditEx, "Audit failed for OutOfOffice on {Target}", target);
            }
        }
        finally
        {
            isSetting = false;

            // Completed from the fields rather than a local, and that is safe HERE rather than a
            // pattern to copy: every path out of this try assigns setResult before it leaves, and
            // this page renders its result banner with no dismiss control, so there is nothing
            // that can null it while the handler is suspended at an email await - which is the
            // post-await live-read trap ClickGateRegistry records against NamedLocations.
            activity.Complete(setResult?.Success ?? false, setResult?.Message);
        }
    }

    private static string GetStateBadge(string state) => state switch
    {
        "Enabled" => "success",
        "Scheduled" => "info",
        "Disabled" => "secondary",
        _ => "warning"
    };

    private static string StripHtml(string? html)
    {
        if (string.IsNullOrEmpty(html)) return "";
        return System.Text.RegularExpressions.Regex.Replace(html, "<[^>]+>", "").Trim();
    }
}

@page "/message-analysis"
@page "/message-trace"
@using ExchangeAdminWeb.Models
@using ExchangeAdminWeb.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize(Policy = "MessageTrace")]
@rendermode InteractiveServer
@inject MessageTraceService MsgTrace
@inject HeaderAnalysisService HeaderAnalysis
@inject AuditService Audit
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager Navigation
@inject ClientInfoService ClientInfo
@inject OperatorEmailResolver OperatorEmail
@inject ExchangeAdminWeb.Services.Jobs.BulkJobService BulkJobs
@inject IJSRuntime JS

<PageTitle>Message Analysis</PageTitle>

<div class="container-fluid mt-4 message-analysis-page">
    <div class="alert alert-info py-2 mb-3"><small>Message analysis actions are logged for audit purposes. Ticket number is optional and audit-only.</small></div>
    <h2>Message Analysis<ModuleVersion /></h2>
    <p class="text-muted">Analyze message headers, then trace the same message across Exchange Online and on-premises mail flow.</p>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button type="button" class="nav-link @(activeTab == "headers" ? "active" : "")" @onclick="ShowHeadersTab">Header Analysis</button>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link @(activeTab == "trace" ? "active" : "")" @onclick="ShowTraceTab">Trace Search</button>
        </li>
    </ul>

    @if (activeTab == "headers")
    {
        <div class="border rounded p-3 mb-3">
            <div class="row g-3 align-items-end">
                <div class="col-xl-5 col-lg-6">
                    <label class="form-label">Upload .eml or .msg</label>
                    <InputFile class="form-control" OnChange="AnalyzeUploadedFile" accept=".eml,.msg" disabled="@isAnalyzing" />
                    @if (!string.IsNullOrWhiteSpace(uploadedFileName))
                    {
                        <div class="form-text">Analyzed @uploadedFileName</div>
                    }
                </div>
                <div class="col-xl-3 col-lg-3">
                    <button class="btn btn-outline-secondary w-100" type="button" @onclick="TogglePasteInput" disabled="@isAnalyzing">
                        @(showPasteInput ? "Hide pasted headers" : "Paste headers")
                    </button>
                </div>
                <div class="col-xl-4 col-lg-3 d-flex gap-2 justify-content-lg-end">
                    @if (headerAnalysis != null)
                    {
                        <button class="btn btn-outline-primary" @onclick="() => UseHeaderTraceSuggestion(false)">Fill Trace Form</button>
                        <button class="btn btn-primary" @onclick="() => UseHeaderTraceSuggestion(true)" disabled="@isLoading">Run Trace Now</button>
                    }
                    <button class="btn btn-outline-secondary" type="button" @onclick="ClearHeaderAnalysis" disabled="@isAnalyzing">Clear</button>
                </div>
            </div>

            @if (showPasteInput)
            {
                <div class="mt-3">
                    <label class="form-label">Pasted Headers</label>
                    <textarea class="form-control font-monospace" rows="8" @bind="headerText" placeholder="Paste raw message headers here" disabled="@isAnalyzing"></textarea>
                    <div class="mt-2">
                        <button class="btn btn-primary" @onclick="AnalyzePastedHeaders" disabled="@(isAnalyzing || string.IsNullOrWhiteSpace(headerText))">
                            @if (isAnalyzing)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Analyze Pasted Headers
                        </button>
                    </div>
                </div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(headerAnalysisError))
        {
            <div class="alert alert-danger">@headerAnalysisError</div>
        }

        @if (headerAnalysis == null)
        {
            <div class="alert alert-secondary">Upload a message file or paste raw headers to start analysis.</div>
        }
        else
        {
            <div class="mb-3">
                <h4 class="mb-1">@(headerAnalysis.Headers.FileName ?? "Headers")</h4>
                <div class="text-muted small">@headerAnalysis.HopCount routing hop(s), @HeaderRows().Count() header value(s)</div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-xl-8">
                    <div class="border rounded p-3 h-100">
                        <h5 class="mb-3">Summary</h5>
                        <div class="table-responsive">
                            <table class="table table-sm mb-0 align-middle">
                                <tbody>
                                    <tr><th style="width: 150px;">Subject</th><td class="text-break">@headerAnalysis.Subject</td></tr>
                                    <tr><th>Message ID</th><td class="text-break">@headerAnalysis.MessageId</td></tr>
                                    <tr><th>Date</th><td>@headerAnalysis.Date?.ToString("yyyy-MM-dd HH:mm:ss")</td></tr>
                                    <tr><th>From</th><td class="text-break">@headerAnalysis.From</td></tr>
                                    <tr><th>Reply-To</th><td class="text-break">@(headerAnalysis.ReplyTo ?? headerAnalysis.From)</td></tr>
                                    <tr><th>To</th><td class="text-break">@string.Join("; ", headerAnalysis.To)</td></tr>
                                    @if (headerAnalysis.Cc.Any())
                                    {
                                        <tr><th>Cc</th><td class="text-break">@string.Join("; ", headerAnalysis.Cc)</td></tr>
                                    }
                                    <tr><th>Return-Path</th><td class="text-break">@headerAnalysis.ReturnPath</td></tr>
                                    <tr><th>Originating IP</th><td>@headerAnalysis.OriginatingIP</td></tr>
                                    <tr><th>Delivery Time</th><td>@FormatDelay(headerAnalysis.DeliveryTime)</td></tr>
                                    <tr><th>Content-Type</th><td class="text-break">@headerAnalysis.Headers.ContentType</td></tr>
                                    <tr><th>Attachments</th><td>@(headerAnalysis.HasAttachments ? "Yes" : "No")</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-xl-4">
                    <div class="border rounded p-3 h-100">
                        <h5 class="mb-3">Authentication</h5>
                        <div class="d-flex flex-column gap-2">
                            <div><span class="badge bg-@GetAuthBadge(headerAnalysis.SpfResult)">SPF @headerAnalysis.SpfResult</span></div>
                            <div><span class="badge bg-@GetAuthBadge(headerAnalysis.DkimResult)">DKIM @headerAnalysis.DkimResult</span></div>
                            <div><span class="badge bg-@GetAuthBadge(headerAnalysis.DmarcResult)">DMARC @headerAnalysis.DmarcResult</span></div>
                        </div>
                        @if (headerAnalysis.Headers.Authentication != null)
                        {
                            <dl class="row small mt-3 mb-0">
                                <dt class="col-4">SPF domain</dt><dd class="col-8 text-break">@headerAnalysis.Headers.Authentication.SPF?.Domain</dd>
                                <dt class="col-4">SPF client IP</dt><dd class="col-8 text-break">@headerAnalysis.Headers.Authentication.SPF?.ClientIp</dd>
                                <dt class="col-4">DKIM domain</dt><dd class="col-8 text-break">@(headerAnalysis.Headers.Authentication.DKIM?.HeaderD ?? headerAnalysis.Headers.Authentication.DKIM?.Domain)</dd>
                                <dt class="col-4">DKIM selector</dt><dd class="col-8 text-break">@headerAnalysis.Headers.Authentication.DKIM?.Selector</dd>
                                <dt class="col-4">DMARC domain</dt><dd class="col-8 text-break">@headerAnalysis.Headers.Authentication.DMARC?.Domain</dd>
                                <dt class="col-4">DMARC policy</dt><dd class="col-8 text-break">@headerAnalysis.Headers.Authentication.DMARC?.Policy</dd>
                            </dl>
                        }
                    </div>
                </div>
            </div>

            @if (headerAnalysis.Findings.Any())
            {
                <div class="border rounded p-3 mb-3">
                    <h5 class="mb-3">Findings</h5>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead><tr><th>Severity</th><th>Category</th><th>Finding</th><th>Evidence</th></tr></thead>
                            <tbody>
                                @foreach (var finding in headerAnalysis.Findings)
                                {
                                    <tr>
                                        <td><span class="badge bg-@GetFindingBadge(finding.Severity)">@finding.Severity</span></td>
                                        <td>@finding.Category</td>
                                        <td>@finding.Message</td>
                                        <td class="text-break"><small>@finding.Evidence</small></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <div class="border rounded p-3 mb-3">
                <h5 class="mb-3">Routing Path</h5>
                @if (headerAnalysis.RoutingPath.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr><th>Hop</th><th>Submitting Host</th><th>Receiving Host</th><th>Protocol</th><th>Time</th><th>Delay</th><th>Raw Received Header</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var hop in headerAnalysis.RoutingPath)
                                {
                                    <tr>
                                        <td>@hop.Hop</td>
                                        <td class="text-break">@hop.From</td>
                                        <td class="text-break">@hop.By</td>
                                        <td>@hop.With</td>
                                        <td>@hop.Date?.ToString("yyyy-MM-dd HH:mm:ss zzz")</td>
                                        <td>@FormatDelay(hop.DelayFromPrevious)</td>
                                        <td class="text-break"><small>@hop.RawValue</small></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-muted">No Received headers found.</div>
                }
            </div>

            <div class="row g-3 mb-3">
                <div class="col-xl-5">
                    <div class="border rounded p-3 h-100">
                        <h5 class="mb-3">Filtering Signals</h5>
                        @if (headerAnalysis.SpamScores.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm mb-0">
                                    <tbody>
                                        @foreach (var score in headerAnalysis.SpamScores)
                                        {
                                            <tr><th>@score.Key</th><td class="text-break">@score.Value</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-muted">No spam or filtering score headers found.</div>
                        }
                    </div>
                </div>
                <div class="col-xl-7">
                    <div class="border rounded p-3 h-100">
                        <h5 class="mb-3">Uncommon / Interesting Headers</h5>
                        @if (headerAnalysis.InterestingHeaders.Any())
                        {
                            <div class="small">
                                @foreach (var header in headerAnalysis.InterestingHeaders)
                                {
                                    <div class="text-break mb-1">@header</div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-muted">No uncommon headers were flagged.</div>
                        }
                    </div>
                </div>
            </div>

            <div class="border rounded p-3 mb-3">
                <h5 class="mb-3">All Headers</h5>
                <div class="table-responsive">
                    <table class="table table-sm table-striped align-middle mb-0">
                        <thead><tr><th style="width: 260px;">Header</th><th>Value</th></tr></thead>
                        <tbody>
                            @foreach (var header in HeaderRows())
                            {
                                <tr>
                                    <td class="fw-semibold text-break">@header.Key</td>
                                    <td class="font-monospace small text-break">@header.Value</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
    else
    {
        <div class="border rounded p-3">
            <div class="row g-3 mb-3">
                <div class="col-md-3">
                    <label class="form-label">Sender</label>
                    <input type="email" class="form-control" @bind="sender" placeholder="sender@example.com" disabled="@isLoading" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Recipient</label>
                    <input type="email" class="form-control" @bind="recipient" placeholder="recipient@example.com" disabled="@isLoading" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Start Date</label>
                    <input type="date" class="form-control" @bind="startDate" disabled="@isLoading" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">End Date</label>
                    <input type="date" class="form-control" @bind="endDate" disabled="@isLoading" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Ticket Number</label>
                    <input type="text" class="form-control" @bind="ticketNumber" placeholder="optional" disabled="@isLoading" />
                </div>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label">Subject Contains</label>
                    <input type="text" class="form-control" @bind="subjectFilter" placeholder="(optional)" disabled="@isLoading" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Message ID</label>
                    <input type="text" class="form-control" @bind="messageId" placeholder="<message-id@example.com>" disabled="@isLoading" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-primary" @onclick="RunTrace" disabled="@(!IsFormValid || isLoading)">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Search
                    </button>
                </div>
            </div>

            <div class="mb-3">
                <a href="message-analysis/reports">Downloadable Reports</a>
                <span class="form-text ms-1">- detail exports produced as background jobs.</span>
            </div>

            @if (validationError != null)
            {
                <div class="alert alert-danger">@validationError</div>
            }

            @if (response?.Warnings.Any() == true)
            {
                <div class="alert alert-warning">
                    <ul class="mb-0">
                        @foreach (var warning in response.Warnings.Distinct(StringComparer.OrdinalIgnoreCase))
                        {
                            <li>@warning</li>
                        }
                    </ul>
                </div>
            }

            @if (response?.Error != null)
            {
                <div class="alert alert-danger">@response.Error</div>
            }
            else if (response != null)
            {
                @if (response.Truncated)
                {
                    <div class="alert alert-warning">
                        Results limited to @MessageTraceResponse.MaxResults entries. Narrow your search criteria for complete results.
                    </div>
                }

                @if (response.Results.Any())
                {
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <p class="text-muted mb-0">@response.Results.Count result(s)</p>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ExportCsv">Export CSV</button>
                    </div>

                    <div class="border rounded p-2 mb-2 bg-light">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="me-2"><strong>@selectedIndices.Count</strong> selected@(SelectionCappedAt50 ? " (cap 50)" : "")</span>
                            @{
                                var action = MessageTraceDetailReport.ResolveAction(selectedIndices.Count);
                            }
                            <button type="button" class="btn btn-sm btn-primary" disabled="@(action != MessageTraceDetailAction.LiveOrEmail || detailActionBusy)" @onclick="DownloadSelectedDetails">
                                @if (detailActionBusy && detailActionKind == "download")
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                Download details
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary" disabled="@(action == MessageTraceDetailAction.None || detailActionBusy)" @onclick="EmailSelectedDetails">
                                @if (detailActionBusy && detailActionKind == "email")
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                Email details
                            </button>
                            @if (selectedIndices.Count > 0)
                            {
                                <button type="button" class="btn btn-sm btn-link" @onclick="ClearSelection" disabled="@detailActionBusy">Clear</button>
                            }
                        </div>
                        @if (action == MessageTraceDetailAction.EmailOnly)
                        {
                            <div class="form-text mb-0">@MessageTraceDetailReport.LiveMax or fewer can be downloaded live; @(selectedIndices.Count) selected must be delivered by email.</div>
                        }
                        @if (selectedIndices.Count > 0)
                        {
                            <div class="mt-2">
                                <label class="form-label mb-1" for="mt-notify">Notify (optional)</label>
                                <input id="mt-notify" type="text" class="form-control form-control-sm @(recipientInputError != null ? "is-invalid" : "")"
                                       placeholder="name@example.com, another@example.com"
                                       value="@recipientInput" @oninput="OnRecipientInput" disabled="@detailActionBusy" />
                                @if (recipientInputError != null)
                                {
                                    <div class="invalid-feedback d-block">@recipientInputError</div>
                                }
                                <div class="form-text mb-0">
                                    Separate addresses with commas. The message contains a link to the
                                    <a href="message-analysis/reports">Downloadable Reports</a> page, never the report itself,
                                    so recipients must sign in and have Message Analysis access to open it.
                                    Clear the box to notify no one - the export is still produced and still listed there.
                                </div>
                            </div>
                        }
                    </div>

                    @if (detailActionError != null)
                    {
                        <div class="alert alert-danger">@detailActionError</div>
                    }
                    @if (emailJobSubmitted)
                    {
                        <div class="alert alert-success">
                            Detail export submitted as a background job - you can close this tab. When it is ready it will be
                            listed on the <a href="message-analysis/reports">Downloadable Reports</a> page.
                            @if (submittedRecipientsDisplay is { Length: > 0 })
                            {
                                <text>A link will be emailed to <strong>@submittedRecipientsDisplay</strong>.</text>
                            }
                            else
                            {
                                <text>No notification was requested, so no email will be sent.</text>
                            }
                        </div>
                    }

                    <div class="table-responsive">
                        <table class="table table-sm table-striped align-middle">
                            <thead>
                                <tr>
                                    <th style="width: 32px;">
                                        <input type="checkbox" class="form-check-input" checked="@AllSelectableChecked" @onchange="ToggleSelectAll" title="Select all (first @MessageTraceDetailReport.EmailMax)" />
                                    </th>
                                    <th>Received</th>
                                    <th>Backend</th>
                                    <th>Sender</th>
                                    <th>Recipient</th>
                                    <th>Subject</th>
                                    <th>Status/Event</th>
                                    <th>Server</th>
                                    <th>Message ID</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < response.Results.Count; i++)
                                {
                                    var index = i;
                                    var msg = response.Results[index];
                                    <tr>
                                        <td>
                                            <input type="checkbox" class="form-check-input" checked="@selectedIndices.Contains(index)" @onchange="e => ToggleRowSelection(index, e)" />
                                        </td>
                                        <td>@msg.Received.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>@msg.Backend</td>
                                        <td>@msg.SenderAddress</td>
                                        <td>@msg.RecipientAddress</td>
                                        <td>@msg.Subject</td>
                                        <td><span class="badge bg-@GetStatusBadge(msg.Status)">@msg.Status</span></td>
                                        <td>@msg.Server</td>
                                        <td class="text-break"><small>@msg.MessageId</small></td>
                                        <td class="text-nowrap">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleDetail(index, msg)" disabled="@detailLoading">
                                                @if (detailLoading && expandedIndex == index)
                                                {
                                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                                }
                                                @(expandedIndex == index ? "Hide" : "Details")
                                            </button>
                                        </td>
                                    </tr>
                                    @if (expandedIndex == index)
                                    {
                                        <tr class="table-light">
                                            <td colspan="10">
                                                @if (detailLoading)
                                                {
                                                    <div class="d-flex align-items-center gap-2 text-muted">
                                                        <span class="spinner-border spinner-border-sm"></span> Loading delivery detail...
                                                    </div>
                                                }
                                                else if (!string.IsNullOrEmpty(detail?.Error))
                                                {
                                                    <div class="alert alert-danger mb-0">@detail!.Error</div>
                                                }
                                                else if (detail != null)
                                                {
                                                    <h6 class="mb-2">Delivery trail (@detail.Events.Count event(s))</h6>
                                                    @if (detail.Events.Any())
                                                    {
                                                        <div class="table-responsive">
                                                            <table class="table table-sm mb-0 align-middle">
                                                                <thead>
                                                                    <tr><th>Date</th><th>Event</th><th>Action/Source</th><th>Detail</th></tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var ev in detail.Events)
                                                                    {
                                                                        <tr>
                                                                            <td class="text-nowrap">@ev.Date.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                                                            <td>@ev.Event</td>
                                                                            <td class="text-break">@(string.IsNullOrEmpty(ev.Action) ? ev.Source : ev.Action)</td>
                                                                            <td class="text-break"><small>@ev.Detail</small></td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="text-muted">No delivery events available for this message.</div>
                                                    }
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">No messages found matching your criteria.</div>
                }
            }
        </div>
    }
</div>
@code {
    private string activeTab = "headers";
    private string sender = "";
    private string recipient = "";
    private DateTime startDate = DateTime.Today.AddDays(-2);
    private DateTime endDate = DateTime.Today;
    private string subjectFilter = "";
    private string messageId = "";
    private string ticketNumber = "";
    private bool isLoading = false;
    private string? validationError;
    private MessageTraceResponse? response;
    private int? expandedIndex;
    private bool detailLoading;
    private MessageTraceDetail? detail;
    private int detailRequestToken;
    private readonly HashSet<int> selectedIndices = new();
    private bool detailActionBusy;
    private string? detailActionKind;
    private string? detailActionError;
    private bool emailJobSubmitted;

    // The notification recipient box (plan D4). Pre-filled with the operator's own address in
    // OnInitializedAsync as a DEFAULT, not a floor: they may edit it or clear it entirely, and a
    // cleared box is a valid submission meaning "notify nobody".
    private string recipientInput = "";
    private string? recipientInputError;
    private string? submittedRecipientsDisplay;

    private bool SelectionCappedAt50 => selectedIndices.Count >= MessageTraceDetailReport.EmailMax;
    private bool AllSelectableChecked =>
        response?.Results is { Count: > 0 } results
        && selectedIndices.Count == MessageTraceDetailReport.SelectAllCount(results.Count);
    private string currentUser = "";
    private string userEmail = "";
    private string? operatorSid;
    private bool authChecked;
    private bool emailResolveStarted;
    private Task<string>? emailResolve;
    private bool recipientTouched;
    private string clientIpAddress = "Unknown";

    private string headerText = "";
    private string? uploadedFileName;
    private bool isAnalyzing;
    private bool showPasteInput;
    private string? headerAnalysisError;
    private HeaderAnalysisResult? headerAnalysis;

    private bool IsFormValid => !string.IsNullOrWhiteSpace(sender) || !string.IsNullOrWhiteSpace(recipient) || !string.IsNullOrWhiteSpace(messageId);
    private void ShowTraceTab() => activeTab = "trace";
    private void ShowHeadersTab() => activeTab = "headers";
    private void TogglePasteInput() => showPasteInput = !showPasteInput;
    /// <summary>
    /// The realtime cloud trace reaches back 90 days, so there is no "historical" range any more.
    /// </summary>
    /// <remarks>
    /// This used to be <c>(endDate - startDate).TotalDays > 9</c>, routing anything wider to
    /// Start-HistoricalSearch, whose report only ever reached the operator as mail from Microsoft.
    /// The 10-day figure was inherited from the deprecated <c>Get-MessageTrace</c>;
    /// <c>Get-MessageTraceV2</c>, which this app actually calls, serves the full retention window.
    ///
    /// Measured against this tenant 2026-08-05, not taken from documentation: V2 returned rows at
    /// 9, 11, 20, 45, 89 and 90 days back, and refuses at 91 with "Invalid StartDate value. The
    /// StartDate can't be older than 90 days from today." The old async path was therefore
    /// unnecessary for every window it was serving.
    /// </remarks>
    public const int CloudTraceRetentionDays = 90;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUser = user.Identity?.Name ?? "Unknown";

        var authResult = await AuthorizationService.AuthorizeAsync(user, "MessageTrace");
        if (!authResult.Succeeded)
        {
            Navigation.NavigateTo("access-denied", forceLoad: true);
            return;
        }

        // The Negotiate token carries no mail, email, or UPN claim - only the account name and
        // SIDs - so the address has to be looked up. The SID is the key, never the account name:
        // see docs/OperatorEmailResolution-Plan.md ("Why the SID"). Read it the same way
        // Components/Pages/SelfServiceGroups.razor:325 does.
        operatorSid = user.FindFirst(System.Security.Claims.ClaimTypes.PrimarySid)?.Value;
        clientIpAddress = ClientInfo.IpAddress != "Unknown"
            ? ClientInfo.IpAddress
            : ClientInfo.GetIpForUser(currentUser);

        authChecked = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || emailResolveStarted || !authChecked)
            return;

        emailResolveStarted = true;

        // Deferred off the render path: the AD call sits behind a process-wide lock that can
        // wait up to 30 seconds, and this page must not stall on it to populate a text box
        // (plan "Asynchronous by construction").
        userEmail = await ResolveOperatorEmailAsync();

        // Pre-fill only, and only while the operator has not touched the box - a late-arriving
        // resolution must never overwrite something they typed (plan D4(a) + F2).
        if (!recipientTouched && !string.IsNullOrEmpty(userEmail))
            recipientInput = userEmail;

        StateHasChanged();
    }

    /// <summary>
    /// Resolve once per circuit and reuse. Returns "" when the address cannot be resolved -
    /// callers treat that as "AD could not tell us" (plan D3).
    /// </summary>
    /// <remarks>
    /// Caches the <see cref="Task{TResult}"/>, not the result: the operator can hit Search while
    /// the deferred first resolve is still in flight, and awaiting the same task makes that the
    /// same AD call rather than a second one behind the service's 30-second lock.
    /// </remarks>
    private Task<string> ResolveOperatorEmailAsync()
        => emailResolve ??= ResolveOperatorEmailCoreAsync();

    private async Task<string> ResolveOperatorEmailCoreAsync()
    {
        userEmail = await OperatorEmail.ResolveAsync(operatorSid) ?? "";
        return userEmail;
    }

    private void OnRecipientInput(ChangeEventArgs e)
    {
        // First keystroke hands the box to the operator for the rest of the circuit.
        recipientTouched = true;
        recipientInput = e.Value?.ToString() ?? "";
    }

    private static DateTime EffectiveEndDate(DateTime end)
    {
        var inclusive = end.AddDays(1);
        return inclusive > DateTime.Now ? DateTime.Now : inclusive;
    }

    public static string? ValidateDateRange(DateTime start, DateTime end) =>
        ValidateDateRange(start, end, DateTime.Today);

    /// <summary>
    /// Why a date range cannot be traced, or null when it can.
    /// </summary>
    /// <remarks>
    /// <paramref name="today"/> is injected so the retention boundary is testable without waiting
    /// for the calendar to move.
    ///
    /// The start-age check is the one that matters and it did not exist before: the old rule
    /// bounded only the WIDTH of the window, so a one-day search 180 days ago passed validation and
    /// failed at Exchange with "Invalid StartDate value. The StartDate can't be older than 90 days
    /// from today." Refusing it here names the real cause instead of surfacing a cmdlet error, and
    /// it is checked before the width so the operator is told the older of the two problems first.
    /// </remarks>
    public static string? ValidateDateRange(DateTime start, DateTime end, DateTime today)
    {
        if (end < start)
            return "End date must be after start date.";
        if (start > today)
            return "Start date cannot be in the future.";
        if (end > today)
            return "End date cannot be in the future.";
        if ((today - start).TotalDays > CloudTraceRetentionDays)
            return $"Exchange Online keeps only {CloudTraceRetentionDays} days of message trace data. Choose a start date within the last {CloudTraceRetentionDays} days.";
        if ((end - start).TotalDays > CloudTraceRetentionDays)
            return $"Date range cannot exceed {CloudTraceRetentionDays} days.";
        return null;
    }

    private async Task RunTrace()
    {
        validationError = ValidateDateRange(startDate, endDate);
        if (validationError != null) return;

        isLoading = true;
        response = null;
        expandedIndex = null;
        detail = null;
        detailLoading = false;
        // Supersede any in-flight detail fetch so its late response cannot render against new results.
        detailRequestToken++;
        selectedIndices.Clear();
        detailActionError = null;
        emailJobSubmitted = false;

        try
        {
            await RunRealtimeTrace();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RunRealtimeTrace()
    {
        try
        {
            response = await MsgTrace.GetMessageTraceAsync(
                string.IsNullOrWhiteSpace(sender) ? null : sender.Trim(),
                string.IsNullOrWhiteSpace(recipient) ? null : recipient.Trim(),
                startDate, EffectiveEndDate(endDate),
                string.IsNullOrWhiteSpace(subjectFilter) ? null : subjectFilter.Trim(),
                string.IsNullOrWhiteSpace(messageId) ? null : messageId.Trim());

            var target = TraceTarget();
            var auditDetail = response.Error ?? (response.Warnings.Any() ? string.Join(" | ", response.Warnings.Distinct(StringComparer.OrdinalIgnoreCase)) : null);
            var auditSuccess = response.Error == null && !response.Warnings.Any();
            Audit.LogLookupAction(currentUser, clientIpAddress, "MessageTrace", target, auditSuccess, auditDetail, ticketNumber.Trim());
        }
        catch (Exception ex)
        {
            response = new MessageTraceResponse { Error = ex.Message };
            Audit.LogLookupAction(currentUser, clientIpAddress, "MessageTrace", TraceTarget(), false, ex.Message, ticketNumber.Trim());
        }
    }

    private async Task AnalyzePastedHeaders()
    {
        await AnalyzeHeadersAsync(() => Task.FromResult(HeaderAnalysis.AnalyzeHeaderText(headerText)), "Pasted Headers");
    }

    private async Task AnalyzeUploadedFile(InputFileChangeEventArgs e)
    {
        var file = e.File;
        uploadedFileName = file.Name;
        await AnalyzeHeadersAsync(async () =>
        {
            await using var stream = file.OpenReadStream(50 * 1024 * 1024);
            return await HeaderAnalysis.AnalyzeFileAsync(stream, file.Name, file.Size);
        }, file.Name);
    }

    private async Task AnalyzeHeadersAsync(Func<Task<HeaderAnalysisResult>> analyze, string target)
    {
        isAnalyzing = true;
        headerAnalysisError = null;
        headerAnalysis = null;
        try
        {
            headerAnalysis = await analyze();
            Audit.LogLookupAction(currentUser, clientIpAddress, "MessageHeaderAnalysis", target, true, null, ticketNumber.Trim());
        }
        catch (Exception ex)
        {
            headerAnalysisError = ex.Message;
            Audit.LogLookupAction(currentUser, clientIpAddress, "MessageHeaderAnalysis", target, false, ex.Message, ticketNumber.Trim());
        }
        finally
        {
            isAnalyzing = false;
        }
    }

    private async Task UseHeaderTraceSuggestion(bool runNow)
    {
        if (headerAnalysis == null)
            return;

        var suggestion = headerAnalysis.TraceSuggestion;
        sender = suggestion.Sender ?? sender;
        recipient = suggestion.Recipient ?? recipient;
        subjectFilter = suggestion.Subject ?? subjectFilter;
        messageId = suggestion.MessageId ?? messageId;
        if (suggestion.StartDate.HasValue)
            startDate = suggestion.StartDate.Value;
        if (suggestion.EndDate.HasValue)
            endDate = suggestion.EndDate.Value > DateTime.Today ? DateTime.Today : suggestion.EndDate.Value;

        activeTab = "trace";
        if (runNow)
            await RunTrace();
    }

    private void ClearHeaderAnalysis()
    {
        headerText = "";
        uploadedFileName = null;
        headerAnalysisError = null;
        headerAnalysis = null;
        showPasteInput = false;
    }

    private IEnumerable<KeyValuePair<string, string>> HeaderRows()
    {
        if (headerAnalysis == null)
            yield break;

        foreach (var header in headerAnalysis.Headers.Headers.OrderBy(h => h.Key, StringComparer.OrdinalIgnoreCase))
        {
            foreach (var value in header.Value)
                yield return new KeyValuePair<string, string>(header.Key, value);
        }
    }

    private async Task ExportCsv()
    {
        if (response?.Results == null || !response.Results.Any()) return;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Origin Date-Time,Backend,Sender Address,Recipient Address,Message Subject,Status,Event ID,Server,Message ID,Message Size,Sender IP,Recipient IP,Message Trace ID");

        foreach (var msg in response.Results)
        {
            sb.Append(msg.Received.ToString("yyyy-MM-ddTHH:mm:ss.fffffffZ"));
            sb.Append(',');
            sb.Append(CsvEscape(msg.Backend));
            sb.Append(',');
            sb.Append(CsvEscape(msg.SenderAddress));
            sb.Append(',');
            sb.Append(CsvEscape(msg.RecipientAddress));
            sb.Append(',');
            sb.Append(CsvEscape(msg.Subject));
            sb.Append(',');
            sb.Append(CsvEscape(msg.Status));
            sb.Append(',');
            sb.Append(CsvEscape(msg.EventId));
            sb.Append(',');
            sb.Append(CsvEscape(msg.Server));
            sb.Append(',');
            sb.Append(CsvEscape(msg.MessageId));
            sb.Append(',');
            sb.Append(msg.Size);
            sb.Append(',');
            sb.Append(CsvEscape(msg.FromIP));
            sb.Append(',');
            sb.Append(CsvEscape(msg.ToIP));
            sb.Append(',');
            sb.Append(CsvEscape(msg.MessageTraceId));
            sb.AppendLine();
        }

        var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
        var base64 = Convert.ToBase64String(bytes);
        var filename = $"MessageTrace_{startDate:yyyyMMdd}-{endDate:yyyyMMdd}.csv";
        await JS.InvokeVoidAsync("downloadFile", filename, "text/csv", base64);
    }

    private async Task ToggleDetail(int index, MessageTraceResult msg)
    {
        // One open at a time (plan decision): clicking the open row collapses it.
        if (expandedIndex == index)
        {
            expandedIndex = null;
            detail = null;
            return;
        }

        // A monotonic token identifies this request; a later click supersedes it. The button is
        // disabled while any fetch is in flight (disabled="@detailLoading"), but a stale in-flight
        // response could still land after the row was superseded - the token guard discards it so a
        // late reply never writes the wrong message's trail or clears the newer request's spinner.
        var token = ++detailRequestToken;
        expandedIndex = index;
        detail = null;
        detailLoading = true;
        var target = string.IsNullOrWhiteSpace(msg.MessageId) ? msg.MessageTraceId : msg.MessageId;
        try
        {
            // Fail-soft: the seam sets Error rather than throwing; render it inline, never blank the list.
            var fetched = await MsgTrace.GetMessageDetailAsync(msg);
            var success = string.IsNullOrEmpty(fetched.Error);
            Audit.LogLookupAction(currentUser, clientIpAddress, "MessageTrace_Detail", target, success, fetched.Error, ticketNumber.Trim());
            if (token == detailRequestToken)
            {
                detail = fetched;
                detailLoading = false;
            }
        }
        catch (Exception ex)
        {
            Audit.LogLookupAction(currentUser, clientIpAddress, "MessageTrace_Detail", target, false, ex.Message, ticketNumber.Trim());
            if (token == detailRequestToken)
            {
                detail = new MessageTraceDetail { Summary = msg, Error = ex.Message };
                detailLoading = false;
            }
        }
    }

    private void ToggleRowSelection(int index, ChangeEventArgs e)
    {
        var check = e.Value is bool b && b;
        if (check)
        {
            // Never exceed the hard cap (decision 3/5): a tick beyond 50 is ignored.
            if (selectedIndices.Count >= MessageTraceDetailReport.EmailMax && !selectedIndices.Contains(index))
                return;
            selectedIndices.Add(index);
        }
        else
        {
            selectedIndices.Remove(index);
        }
        detailActionError = null;
        emailJobSubmitted = false;
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        selectedIndices.Clear();
        var check = e.Value is bool b && b;
        if (check && response?.Results is { Count: > 0 } results)
        {
            // Select-all ticks at most the first EmailMax rows (decision 3).
            var take = MessageTraceDetailReport.SelectAllCount(results.Count);
            for (var i = 0; i < take; i++)
                selectedIndices.Add(i);
        }
        detailActionError = null;
        emailJobSubmitted = false;
    }

    private void ClearSelection()
    {
        selectedIndices.Clear();
        detailActionError = null;
        emailJobSubmitted = false;
    }

    // The selected summary rows, in result order (never operator-reordered).
    private List<MessageTraceResult> SelectedMessages() =>
        response?.Results is { } results
            ? selectedIndices.OrderBy(i => i).Where(i => i >= 0 && i < results.Count).Select(i => results[i]).ToList()
            : new List<MessageTraceResult>();

    private async Task DownloadSelectedDetails()
    {
        var messages = SelectedMessages();
        // Guard the threshold at the action too (UI hiding is not the gate): only <=LiveMax downloads live.
        if (MessageTraceDetailReport.ResolveAction(messages.Count) != MessageTraceDetailAction.LiveOrEmail)
        {
            detailActionError = $"Live download is available for {MessageTraceDetailReport.LiveMax} or fewer messages. Use Email details instead.";
            return;
        }

        detailActionError = null;
        emailJobSubmitted = false;
        detailActionBusy = true;
        detailActionKind = "download";
        var target = string.Join(",", messages.Select(m => string.IsNullOrWhiteSpace(m.MessageId) ? m.MessageTraceId : m.MessageId));
        try
        {
            // Fetch each selected message's detail (one cloud call each; on-prem free), then build the
            // same CSV the email path produces. Fail-soft: a per-message error is carried into the export.
            var details = new List<MessageTraceDetail>(messages.Count);
            foreach (var m in messages)
                details.Add(await MsgTrace.GetMessageDetailAsync(m));

            var csv = MessageTraceDetailReport.BuildCsv(details);
            var bytes = System.Text.Encoding.UTF8.GetBytes(csv);
            var base64 = Convert.ToBase64String(bytes);
            var filename = $"MessageTraceDetail_{DateTime.Now:yyyyMMdd-HHmmss}.csv";
            await JS.InvokeVoidAsync("downloadFile", filename, "text/csv", base64);

            Audit.LogLookupAction(currentUser, clientIpAddress, "MessageTrace_DetailDownload", target, true, null, ticketNumber.Trim());
        }
        catch (Exception ex)
        {
            detailActionError = ex.Message;
            Audit.LogLookupAction(currentUser, clientIpAddress, "MessageTrace_DetailDownload", target, false, ex.Message, ticketNumber.Trim());
        }
        finally
        {
            detailActionBusy = false;
            detailActionKind = null;
        }
    }

    private Task EmailSelectedDetails()
    {
        var messages = SelectedMessages();
        if (messages.Count == 0)
            return Task.CompletedTask;
        if (messages.Count > MessageTraceDetailReport.EmailMax)
        {
            detailActionError = $"Selection is capped at {MessageTraceDetailReport.EmailMax} messages.";
            return Task.CompletedTask;
        }

        // Format check only, and a cleared box stays valid (plan D4). No domain allow-listing: the
        // mail carries a login-gated link, not the data.
        var recipients = ExchangeAdminWeb.Services.EmailService.ParseRecipientInput(recipientInput, out var invalid);
        if (invalid.Count > 0)
        {
            recipientInputError = $"Not a valid email address: {string.Join(", ", invalid)}";
            return Task.CompletedTask;
        }
        recipientInputError = null;

        detailActionError = null;
        emailJobSubmitted = false;
        detailActionBusy = true;
        detailActionKind = "email";
        var target = string.Join(",", messages.Select(m => string.IsNullOrWhiteSpace(m.MessageId) ? m.MessageTraceId : m.MessageId));
        try
        {
            // Off-circuit bulk job (decision 5). The processor mails a LINK to the reports page to
            // whatever the operator left in the box - an empty set means notify nobody, and the
            // export is still produced (docs/MessageTraceDownloadLink-Plan.md D4).
            var payload = new ExchangeAdminWeb.Services.Jobs.MessageTraceDetailJobPayload
            {
                Messages = messages,
                UserEmail = userEmail?.Trim(),
                Recipients = recipients.ToList(),
            };
            var job = new ExchangeAdminWeb.Services.Jobs.BulkJob
            {
                Id = Guid.NewGuid().ToString("N"),
                ModuleId = ExchangeAdminWeb.Services.Jobs.MessageTraceDetailJobProcessor.ModuleName,
                JobType = ExchangeAdminWeb.Services.Jobs.MessageTraceDetailJobPayload.JobType,
                Status = ExchangeAdminWeb.Services.Jobs.BulkJobStatus.Queued,
                SubmittedBy = currentUser,
                SubmittedByDisplay = currentUser,
                SubmittedIp = clientIpAddress,
                Ticket = ticketNumber.Trim(),
                PayloadJson = System.Text.Json.JsonSerializer.Serialize(payload),
                SubmittedAtUtc = DateTime.UtcNow,
            };
            BulkJobs.Enqueue(job);
            emailJobSubmitted = true;
            submittedRecipientsDisplay = string.Join(", ", recipients);
            var notified = recipients.Count == 0 ? "no notification" : string.Join(", ", recipients);
            Audit.LogLookupAction(currentUser, clientIpAddress, "MessageTrace_DetailEmailJob", target, true, $"{messages.Count} message(s); job {job.Id}; notify: {notified}", ticketNumber.Trim());
        }
        catch (Exception ex)
        {
            detailActionError = ex.Message;
            Audit.LogLookupAction(currentUser, clientIpAddress, "MessageTrace_DetailEmailJob", target, false, ex.Message, ticketNumber.Trim());
        }
        finally
        {
            detailActionBusy = false;
            detailActionKind = null;
        }
        return Task.CompletedTask;
    }

    private string TraceTarget()
    {
        var from = string.IsNullOrWhiteSpace(sender) ? "*" : sender.Trim();
        var to = string.IsNullOrWhiteSpace(recipient) ? "*" : recipient.Trim();
        var id = string.IsNullOrWhiteSpace(messageId) ? "" : $" MessageId={messageId.Trim()}";
        return $"{from}->{to}{id}";
    }

    private static string CsvEscape(string value)
    {
        if (string.IsNullOrEmpty(value)) return "";
        if (value.Length > 0 && value[0] is '=' or '+' or '-' or '@' or '\t' or '\r' or '\n')
            value = "'" + value;
        if (value.Contains(',') || value.Contains('"') || value.Contains('\n') || value.Contains('\r'))
            return "\"" + value.Replace("\"", "\"\"") + "\"";
        return value;
    }

    private static string GetStatusBadge(string status) => status switch
    {
        "Delivered" => "success",
        "Expanded" => "success",
        "Deliver" => "success",
        "Failed" => "danger",
        "Fail" => "danger",
        "Pending" => "warning",
        "Deferred" => "warning",
        "FilteredAsSpam" => "secondary",
        _ => "info"
    };

    private static string GetAuthBadge(string result) => result switch
    {
        "PASS" => "success",
        "FAIL" => "danger",
        "PERMERROR" => "danger",
        "TEMPERROR" => "warning",
        "SOFTFAIL" => "warning",
        _ => "secondary"
    };

    private static string GetFindingBadge(string severity) => severity switch
    {
        "High" => "danger",
        "Warning" => "warning",
        "Info" => "info",
        _ => "secondary"
    };

    private static string FormatDelay(TimeSpan? delay)
    {
        if (!delay.HasValue)
            return "";
        if (delay.Value.TotalHours >= 1)
            return $"{delay.Value.TotalHours:F1}h";
        if (delay.Value.TotalMinutes >= 1)
            return $"{delay.Value.TotalMinutes:F1}m";
        return $"{delay.Value.TotalSeconds:F0}s";
    }
}

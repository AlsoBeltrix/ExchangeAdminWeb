@page "/dhcp-authorization"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "DhcpAuthorization")]
@rendermode InteractiveServer
@inject DhcpAuthorizationService DhcpService
@inject AuditService Audit
@inject ServiceNowService ServiceNow
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager Navigation
@inject ClientInfoService ClientInfo
@inject EmailService Email
@inject ILogger<DhcpAuthorization> Logger
@inject IJSRuntime JS

<PageTitle>DHCP Authorization</PageTitle>

@if (!authChecked)
{
    <div class="container-fluid">
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Checking authorization...</span>
            </div>
        </div>
    </div>
    return;
}

<div class="container-fluid">
    <div class="alert alert-danger py-2 mb-3">
        <small><strong>High Privilege Operation:</strong> Authorizing or deauthorizing DHCP servers modifies Active Directory at the forest level. All operations require Enterprise Admin credentials and are logged with admin notification.</small>
    </div>
    <h1 class="mb-4">DHCP Authorization<ModuleVersion /></h1>

    @if (operationResult != null)
    {
        <div class="alert @(operationResult.Success ? "alert-success" : "alert-danger") alert-dismissible">
            @operationResult.Message
            <button type="button" class="btn-close" @onclick="() => operationResult = null" disabled="@isOperating"></button>
        </div>
    }

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Authorized DHCP Servers</strong>
                    <div>
                        <button class="btn btn-outline-secondary btn-sm me-2" @onclick="DownloadCsvAsync" disabled="@(IsBusy || servers.Count == 0)">Download CSV</button>
                        <button class="btn btn-outline-primary btn-sm" @onclick="LoadServers" disabled="@IsBusy">
                            @if (isLoading && !isOperating) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Refresh
                        </button>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (loadError != null)
                    {
                        <div class="alert alert-danger m-3">@loadError</div>
                    }
                    else if (servers.Count > 0)
                    {
                        <div style="max-height: calc(100vh - 260px); overflow-y: auto;">
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>DNS Name</th>
                                        <th>IP Address</th>
                                        <th style="width: 120px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var server in servers)
                                    {
                                        <tr>
                                            <td>@server.DnsName</td>
                                            <td>@server.IpAddress</td>
                                            <td>
                                                @if (confirmRemove == server)
                                                {
                                                    <button class="btn btn-danger btn-sm me-1" @onclick="() => RemoveServer(server)" disabled="@(IsBusy || string.IsNullOrWhiteSpace(ticketNumber))">Yes</button>
                                                    <button class="btn btn-secondary btn-sm" @onclick="() => confirmRemove = null">No</button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => confirmRemove = server" disabled="@IsBusy">Remove</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else if (!isLoading)
                    {
                        <p class="text-muted p-3 mb-0">No authorized DHCP servers found.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card" style="position: sticky; top: 1rem;">
                <div class="card-header"><strong>DHCP Operation Details</strong></div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">DNS Name</label>
                        <input type="text" class="form-control" @bind="newDnsName" @bind:event="oninput" placeholder="dhcp01.contoso.com" disabled="@IsBusy" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">IP Address</label>
                        <input type="text" class="form-control" @bind="newIpAddress" @bind:event="oninput" placeholder="10.0.0.1" disabled="@IsBusy" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ticket Number</label>
                        <input type="text" class="form-control" @bind="ticketNumber" @bind:event="oninput" placeholder="INC/REQ number" disabled="@IsBusy" />
                        <small class="text-muted">Required for both authorize and deauthorize operations.</small>
                    </div>
                    <button class="btn btn-primary" @onclick="AuthorizeServer"
                            disabled="@(IsBusy || string.IsNullOrWhiteSpace(newDnsName) || string.IsNullOrWhiteSpace(newIpAddress) || string.IsNullOrWhiteSpace(ticketNumber))">
                        @if (isOperating) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Authorize
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string currentUser = "";
    private string clientIpAddress = "Unknown";
    private bool authChecked;
    private bool isLoading;
    private bool isOperating;
    private bool isDownloadingCsv;
    private string? loadError;

    private List<DhcpServerEntry> servers = new();
    private DhcpServerEntry? confirmRemove;

    private string newDnsName = "";
    private string newIpAddress = "";
    private string ticketNumber = "";

    private DhcpOperationResult? operationResult;

    /// <summary>
    /// True while any operation on this page is in flight. Every control consults this rather than
    /// the single flag its own handler owns: the circuit stays interactive across every await, so a
    /// control left live during someone else's operation can be clicked, accepted, and then applied
    /// to state that has been replaced underneath it. Owner ruling 2026-09-17, .agents/decisions.md;
    /// docs/ClickGatingAudit-Plan.md tier 1, page 1.
    ///
    /// confirmRemove is deliberately NOT here. It stages the Yes/No pair, which is rendered only
    /// while it is set, so folding it in would disable Yes at the only moment it exists.
    /// </summary>
    private bool IsBusy => isLoading || isOperating || isDownloadingCsv;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUser = user.Identity?.Name ?? "Unknown";

        var authResult = await AuthorizationService.AuthorizeAsync(user, "DhcpAuthorization");
        if (!authResult.Succeeded)
        {
            Navigation.NavigateTo("access-denied", forceLoad: true);
            return;
        }

        clientIpAddress = ClientInfo.IpAddress != "Unknown"
            ? ClientInfo.IpAddress
            : ClientInfo.GetIpForUser(currentUser);
        authChecked = true;

        await LoadServers();
    }

    /// <summary>
    /// Docs/ModuleCsvExport-Plan.md AC3: DnsName,IpAddress, verbatim, in that order.
    /// Static and argument-fed so tests call it directly without a page instance.
    /// </summary>
    internal static string BuildCsv(IReadOnlyList<DhcpServerEntry> rows)
    {
        var header = new List<string> { "DnsName", "IpAddress" };
        var csvRows = rows.Select(r => (IReadOnlyList<string>)new List<string> { r.DnsName, r.IpAddress });
        return CsvExport.Write(header, csvRows);
    }

    private async Task DownloadCsvAsync()
    {
        // Take the empty-list exit first, then snapshot, and only then raise the flag. Order is
        // load-bearing twice over. A raise above the guard is never lowered, and this flag sits in
        // IsBusy, so it would deaden the whole page rather than one button. And LoadServers replaces
        // the servers reference rather than mutating it, so holding a reference here keeps the
        // audited row count matched to the bytes actually served across the interop await.
        if (servers.Count == 0)
            return;

        var rows = servers;
        isDownloadingCsv = true;
        await Task.Yield();

        try
        {
            var csv = BuildCsv(rows);
            var bytes = System.Text.Encoding.UTF8.GetBytes(csv);
            var base64 = Convert.ToBase64String(bytes);
            var timestamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
            await JS.InvokeVoidAsync("downloadFile", $"DhcpAuthorization_{timestamp}.csv", "text/csv", base64);

            try
            {
                Audit.LogModuleAction(currentUser, clientIpAddress, "ExportCsv", "DhcpAuthorization",
                    $"{rows.Count} rows", true);
            }
            catch (Exception auditEx)
            {
                Logger.LogError(auditEx, "Audit failed for DHCP Authorization CSV export");
            }
        }
        finally
        {
            isDownloadingCsv = false;
        }
    }

    private async Task LoadServers()
    {
        isLoading = true;
        loadError = null;
        await Task.Yield();
        try
        {
            servers = await DhcpService.GetAuthorizedServersAsync();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
            Logger.LogError(ex, "Failed to load DHCP servers");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AuthorizeServer()
    {
        // Snapshot at handler entry, above the raise and above every await. The gate narrows the
        // window in which the form can change under this handler; it cannot close it, because the
        // browser's copy of a disabled attribute is one round trip stale. Only the capture closes
        // it - and the catch below audits these same three values, which it could not do while they
        // were locals inside the try.
        var ticket = ticketNumber.Trim();
        var dns = newDnsName.Trim();
        var ip = newIpAddress.Trim();

        isOperating = true;
        operationResult = null;
        await Task.Yield();

        try
        {
            var ticketValidation = await ServiceNow.ValidateTicketAsync(ticket);
            if (!ticketValidation.IsValid)
            {
                operationResult = new DhcpOperationResult { Success = false, Message = $"Ticket validation failed: {ticketValidation.Message}" };
                try { Audit.LogModuleAction(currentUser, clientIpAddress, "DHCP_Authorize", "DhcpAuthorization", $"{dns} ({ip})", false, ticket, $"Ticket validation failed: {ticketValidation.Message}"); } catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for DHCP authorize ticket validation"); }
                return;
            }

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authCheck = await AuthorizationService.AuthorizeAsync(authState.User, "DhcpAuthorization");
            if (!authCheck.Succeeded)
            {
                operationResult = new DhcpOperationResult { Success = false, Message = "Authorization denied." };
                try { Audit.LogModuleAction(currentUser, clientIpAddress, "DHCP_Authorize", "DhcpAuthorization", $"{dns} ({ip})", false, ticket, "Authorization denied"); } catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for DHCP authorize auth denial"); }
                return;
            }

            // The forest-level write. Held in a local as well as published to the banner: the
            // dismiss control nulls operationResult, and the reads below all sit after an await, so
            // reading the field there could throw a NullReferenceException into this method's own
            // catch - which would audit and email a write that SUCCEEDED as a failure, and skip the
            // confirming refresh. The local cannot be nulled from outside.
            var result = await DhcpService.AuthorizeServerAsync(dns, ip);
            operationResult = result;

            try
            {
                Audit.LogModuleAction(currentUser, clientIpAddress, "DHCP_Authorize",
                    "DhcpAuthorization", $"{dns} ({ip})", result.Success, ticket,
                    result.Success ? null : result.Message);
            }
            catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for DHCP authorize"); }

            try
            {
                await Email.SendAdminNotificationAsync(currentUser, clientIpAddress, "DHCP_Authorize",
                    result.Success, ticket, new Dictionary<string, string>
                    {
                        ["DNS Name"] = dns,
                        ["IP Address"] = ip
                    }, result.Success ? null : result.Message);
            }
            catch (Exception emailEx) { Logger.LogError(emailEx, "Email notification failed for DHCP authorize"); }

            if (result.Success)
            {
                newDnsName = "";
                newIpAddress = "";
                ticketNumber = "";
                await LoadServers();
            }
        }
        catch (Exception ex)
        {
            operationResult = new DhcpOperationResult { Success = false, Message = ex.Message };
            try { Audit.LogModuleAction(currentUser, clientIpAddress, "DHCP_Authorize", "DhcpAuthorization", $"{dns} ({ip})", false, ticket, ex.Message); } catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for DHCP authorize"); }
            try { await Email.SendAdminNotificationAsync(currentUser, clientIpAddress, "DHCP_Authorize", false, ticket, new Dictionary<string, string> { ["DNS Name"] = dns, ["IP Address"] = ip }, ex.Message); } catch { }
        }
        finally
        {
            isOperating = false;
        }
    }

    private async Task RemoveServer(DhcpServerEntry server)
    {
        // Snapshot at handler entry, for the same reason as AuthorizeServer: the ticket input is
        // gated but the browser's copy of that attribute is a round trip stale, and the catch below
        // audits this value after several awaits. The server being deauthorized is already a
        // snapshot - it arrives as a parameter captured when the row was clicked.
        var ticket = ticketNumber.Trim();

        isOperating = true;
        operationResult = null;
        confirmRemove = null;
        await Task.Yield();

        try
        {
            if (string.IsNullOrWhiteSpace(ticket))
            {
                operationResult = new DhcpOperationResult { Success = false, Message = "A ticket number is required for deauthorization. Enter one in the Authorize form." };
                try { Audit.LogModuleAction(currentUser, clientIpAddress, "DHCP_Deauthorize", "DhcpAuthorization", $"{server.DnsName} ({server.IpAddress})", false, "", "Ticket number not provided"); } catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for DHCP deauthorize missing ticket"); }
                return;
            }

            var ticketValidation = await ServiceNow.ValidateTicketAsync(ticket);
            if (!ticketValidation.IsValid)
            {
                operationResult = new DhcpOperationResult { Success = false, Message = $"Ticket validation failed: {ticketValidation.Message}" };
                try { Audit.LogModuleAction(currentUser, clientIpAddress, "DHCP_Deauthorize", "DhcpAuthorization", $"{server.DnsName} ({server.IpAddress})", false, ticket, $"Ticket validation failed: {ticketValidation.Message}"); } catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for DHCP deauthorize ticket validation"); }
                return;
            }

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authCheck = await AuthorizationService.AuthorizeAsync(authState.User, "DhcpAuthorization");
            if (!authCheck.Succeeded)
            {
                operationResult = new DhcpOperationResult { Success = false, Message = "Authorization denied." };
                try { Audit.LogModuleAction(currentUser, clientIpAddress, "DHCP_Deauthorize", "DhcpAuthorization", $"{server.DnsName} ({server.IpAddress})", false, ticket, "Authorization denied"); } catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for DHCP deauthorize auth denial"); }
                return;
            }

            // Held in a local as well as published to the banner. See AuthorizeServer: the dismiss
            // control nulls operationResult, and a null read after the email await would audit and
            // email a deauthorization that SUCCEEDED as a failure and skip the confirming refresh.
            var result = await DhcpService.DeauthorizeServerAsync(server.DnsName, server.IpAddress);
            operationResult = result;

            try
            {
                Audit.LogModuleAction(currentUser, clientIpAddress, "DHCP_Deauthorize",
                    "DhcpAuthorization", $"{server.DnsName} ({server.IpAddress})", result.Success, ticket,
                    result.Success ? null : result.Message);
            }
            catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for DHCP deauthorize"); }

            try
            {
                await Email.SendAdminNotificationAsync(currentUser, clientIpAddress, "DHCP_Deauthorize",
                    result.Success, ticket, new Dictionary<string, string>
                    {
                        ["DNS Name"] = server.DnsName,
                        ["IP Address"] = server.IpAddress
                    }, result.Success ? null : result.Message);
            }
            catch (Exception emailEx) { Logger.LogError(emailEx, "Email notification failed for DHCP deauthorize"); }

            if (result.Success)
                await LoadServers();
        }
        catch (Exception ex)
        {
            operationResult = new DhcpOperationResult { Success = false, Message = ex.Message };
            try { Audit.LogModuleAction(currentUser, clientIpAddress, "DHCP_Deauthorize", "DhcpAuthorization", $"{server.DnsName} ({server.IpAddress})", false, ticket, ex.Message); } catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for DHCP deauthorize"); }
            try { await Email.SendAdminNotificationAsync(currentUser, clientIpAddress, "DHCP_Deauthorize", false, ticket, new Dictionary<string, string> { ["DNS Name"] = server.DnsName, ["IP Address"] = server.IpAddress }, ex.Message); } catch { }
        }
        finally
        {
            isOperating = false;
        }
    }
}

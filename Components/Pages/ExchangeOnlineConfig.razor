@page "/exchange-online-config"
@using Microsoft.AspNetCore.Authorization
@using ExchangeAdminWeb.Modules
@attribute [Authorize(Policy = "AdminSettings")]
@rendermode InteractiveServer
@inject AuditService Audit
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager Navigation
@inject ClientInfoService ClientInfo
@inject ILogger<ExchangeOnlineConfig> Logger
@inject ModuleCatalog Catalog
@inject ModuleEnablementService Enablement
@inject ModuleConfigService ModuleConfigSvc
@inject ExoConnectionPool ExoPool
@* This page injected nothing here until docs/ProgressCoverage-Plan.md S2, and no test noticed:
   GlobalProgressWiringTests' adopted list is hand-maintained and this page is absent from it,
   which is the second of the two holes that plan exists to close. *@
@inject IActivityProgress Progress
@inject IConfiguration Config

<PageTitle>Exchange Online Configuration</PageTitle>

@if (!authChecked)
{
    @* NO SPINNER. No module draws its own progress (owner ruling 2026-10-02,
       `.agents/decisions.md`), and nothing replaces this one: GroupAuthorizationHandler is
       synchronous end to end, so the check finishes faster than a frame and a bar line
       flickering inside a single render is noise, not information.
       The GUARD stays and must stay - it is what stops the page rendering before the check
       has passed, which is refusal, not progress. Kept at the SAME LINE COUNT as the markup
       it replaces, so not one ClickGateRegistry line key moves. *@
    return;
}

<div class="container-fluid">
    <h1 class="mb-4">Exchange Online<ModuleVersion /> <small class="text-muted fs-6">— Connection Configuration</small></h1>
    <p class="text-muted mb-4">Certificate-based authentication for Exchange Online PowerShell. Required by all Exchange-dependent modules.</p>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(statusIsError ? "alert-danger" : statusIsWarning ? "alert-warning" : "alert-success") alert-dismissible fade show">
            @statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
        </div>
    }

    @if (configCorrupt)
    {
        <div class="alert alert-danger">
            <strong>Connection settings are corrupt.</strong> Values shown below are NOT active - the runtime refuses Exchange Online connections until the settings can be read - and saving is disabled. @SettingsStoreText.ModuleConfig(ExoConnectionPool.ConfigModuleKey)
        </div>
    }
    else if (!exoConfigLoaded)
    {
        <div class="alert alert-danger">
            <strong>Connection settings could not be read.</strong> The fields below are blank rather than the stored values, and saving them is disabled. Reload this page; if this persists: @SettingsStoreText.ModuleConfig(ExoConnectionPool.ConfigModuleKey)
        </div>
    }

    @if (enablementStoreCorrupt)
    {
        <div class="alert alert-danger">
            <strong>Module enablement cannot be read.</strong> The status shown is the all-disabled fallback, not the stored state, and saving it is disabled. @SettingsStoreText.Enablement(Enablement.LegacyImportFailed)
        </div>
    }

    <!-- Module Status -->
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Module Status</strong>
            <button class="btn btn-primary btn-sm" @onclick="SaveModuleStatus" disabled="@(saving || enablementStoreCorrupt)">Save Status</button>
        </div>
        <div class="card-body">
            <div class="form-check form-switch mb-2">
                <input class="form-check-input" type="checkbox" id="exo-enabled"
                       checked="@moduleEnabled"
                       disabled="@(saving || enablementStoreCorrupt)"
                       @onchange="(e) => moduleEnabled = (bool)(e.Value ?? false)" />
                <label class="form-check-label fw-semibold" for="exo-enabled">
                    @(moduleEnabled ? "Enabled" : "Disabled")
                </label>
            </div>
            <small class="text-muted">
                When disabled, all Exchange-dependent modules become inactive regardless of their individual toggle state.
            </small>
        </div>
    </div>

    <!-- Connection Configuration -->
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Exchange Online Connection</strong>
            <button class="btn btn-primary btn-sm" @onclick="SaveExoConfig" disabled="@(saving || !exoConfigLoaded)">Save Connection</button>
        </div>
        <div class="card-body">
            <p class="text-muted mb-3"><small>The certificate must be installed in the server's LocalMachine certificate store with the private key accessible to the app pool identity. <a href="https://learn.microsoft.com/en-us/powershell/exchange/app-only-auth-powershell-v2" target="_blank">Setup guide</a></small></p>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">App Registration ID (GUID)</label>
                    <input type="text" class="form-control form-control-sm" @bind="exoAppId" @bind:event="oninput" placeholder="00000000-0000-0000-0000-000000000000" />
                    @if (exoFallback.GetValueOrDefault(ExoConnectionPool.ConfigAppIdKey) is { } appIdFallback)
                    {
                        <small class="text-muted d-block">@appIdFallback</small>
                    }
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Organization</label>
                    <input type="text" class="form-control form-control-sm" @bind="exoOrganization" @bind:event="oninput" placeholder="contoso.onmicrosoft.com" />
                    @if (exoFallback.GetValueOrDefault(ExoConnectionPool.ConfigOrganizationKey) is { } organizationFallback)
                    {
                        <small class="text-muted d-block">@organizationFallback</small>
                    }
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Certificate Subject</label>
                    <CertificatePicker @bind-Value="exoCertSubject" />
                    <small class="text-muted">DN of the certificate in the local machine store.</small>
                    @if (exoFallback.GetValueOrDefault(ExoConnectionPool.ConfigCertSubjectKey) is { } certificateFallback)
                    {
                        <small class="text-muted d-block">@certificateFallback</small>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Dependent Modules -->
    <div class="card mb-4">
        <div class="card-header">
            <strong>Dependent Modules</strong>
        </div>
        <div class="card-body">
            <p class="text-muted mb-3"><small>Modules that require this Exchange Online connection. Their effective status depends on both their own toggle and this parent module.</small></p>
            <div class="row g-2">
                @foreach (var dep in dependentModules)
                {
                    var rawEnabled = Enablement.IsModuleRawEnabled(dep.Id);
                    var effectiveEnabled = Enablement.IsModuleEnabled(dep.Id);
                    <div class="col-md-4">
                        <div class="d-flex align-items-center">
                            <span class="badge @(effectiveEnabled ? "bg-success" : "bg-secondary") me-2" style="width: 70px; text-align: center;">
                                @(effectiveEnabled ? "Active" : "Inactive")
                            </span>
                            <span>@dep.DisplayName</span>
                            @if (rawEnabled && !effectiveEnabled)
                            {
                                <small class="text-muted ms-2">(enabled but parent disabled)</small>
                            }
                            else if (!rawEnabled)
                            {
                                <small class="text-muted ms-2">(disabled)</small>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string currentUser = string.Empty;
    private bool authChecked;
    private bool saving;
    private string? statusMessage;
    private bool statusIsError;

    // aud-a26h. A saved connection whose pool drain failed is neither a success nor a failed save.
    private bool statusIsWarning;

    private bool moduleEnabled;

    // aud-a28k. What the page loaded, so Save Status writes only a toggle the admin changed.
    private bool moduleEnabledBaseline;
    private bool configCorrupt;

    // aud-a28j. True only when LoadExoConfig read the connection. A load that threw left blank fields with
    // configCorrupt false and Save offered, and saving blanks clears the connection.
    private bool exoConfigLoaded;

    // aud-a28j. The status shown is the all-disabled fallback when this is set, and saving it wrote that
    // fallback back for every module.
    private bool enablementStoreCorrupt;
    private string exoAppId = "";
    private string exoOrganization = "";
    private string exoCertSubject = "";

    // aud-a26n. What the three fields showed when the page loaded, and what the store held for each key then (an
    // absent key as empty), from the one read that filled the fields.
    private Dictionary<string, string> exoShown = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, string> exoStored = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, string> exoFallback = new(StringComparer.OrdinalIgnoreCase);
    private List<AdminModuleDescriptor> dependentModules = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUser = user.Identity?.Name ?? "Unknown";

        var authResult = await AuthorizationService.AuthorizeAsync(user, "AdminSettings");
        if (!authResult.Succeeded)
        {
            Navigation.NavigateTo("access-denied", forceLoad: true);
            return;
        }

        enablementStoreCorrupt = Enablement.IsStoreCorrupt();
        moduleEnabled = Enablement.IsModuleRawEnabled("ExchangeOnline");
        moduleEnabledBaseline = moduleEnabled;
        LoadExoConfig();
        dependentModules = Catalog.GetOrdered()
            .Where(m => string.Equals(m.DependsOn, "ExchangeOnline", StringComparison.OrdinalIgnoreCase))
            .ToList();
        authChecked = true;
    }

    private void LoadExoConfig()
    {
        try
        {
            // aud-a26n. One read is what the fields show and what the save compares under its lock: a value shown
            // from one read and compared from another would let a change landing between the two be overwritten
            // unseen. Rows that cannot be read are not a load. With the module marked present the corrupt banner
            // says so, as before; without, the page used to show the appsettings fallbacks as if they were the
            // stored values, and now withholds Save as for any load that failed.
            var readable = ModuleConfigSvc.TryGetModuleConfig(ExoConnectionPool.ConfigModuleKey, out var stored);

            if (ModuleConfigSvc.HasModuleConfigFile(ExoConnectionPool.ConfigModuleKey) && !readable)
            {
                configCorrupt = true;
                exoAppId = "";
                exoOrganization = "";
                exoCertSubject = "";
                return;
            }

            if (!readable)
            {
                Logger.LogWarning("Failed to load EXO config: the connection settings could not be read");
                return;
            }

            var appId = stored.GetValueOrDefault(ExoConnectionPool.ConfigAppIdKey);
            var org = stored.GetValueOrDefault(ExoConnectionPool.ConfigOrganizationKey);
            var cert = stored.GetValueOrDefault(ExoConnectionPool.ConfigCertSubjectKey);
            exoAppId = appId ?? Config[AppIdSetting] ?? "";
            exoOrganization = org ?? Config[OrganizationSetting] ?? "";
            exoCertSubject = cert ?? Config[CertificateSubjectSetting] ?? BuiltInCertificateSubject;
            exoShown = ConnectionFields(exoAppId, exoOrganization, exoCertSubject);
            exoStored = ConnectionFields(appId ?? "", org ?? "", cert ?? "");
            exoFallback = FallbackCaptions(appId, org, cert);
            exoConfigLoaded = true;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load EXO config");
        }
    }

    private async Task SaveModuleStatus()
    {
        saving = true;
        statusMessage = null;
        statusIsWarning = false;
        await Task.Yield();

        // aud-a28h. Both saves on this page record each refusal and their catch under the section
        // their success files under, not only a success. Read above the try, so the catch has the ip.
        const string section = "Module:ExchangeOnline";
        var ip = ClientInfo.GetIpForUser(currentUser);
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authResult = await AuthorizationService.AuthorizeAsync(authState.User, "AdminSettings");
            if (!authResult.Succeeded)
            {
                statusMessage = "Authorization check failed.";
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "Authorization", statusMessage);
                return;
            }

            // aud-a28j. This save had no corrupt-store refusal: over a store that read as corrupt it wrote the
            // all-disabled fallback back for every module. The second check says the toggle came from the store.
            if (Enablement.IsStoreCorrupt())
            {
                enablementStoreCorrupt = true;
                statusMessage = EnablementRefusal();
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "StoreCorrupt", statusMessage);
                return;
            }

            if (enablementStoreCorrupt)
            {
                statusMessage = "Refusing to save: this page's status is not the stored module enablement state (the store could not be read), so saving it could switch Exchange Online off. Nothing was changed. Reload the page.";
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "StoreUnreadable", statusMessage);
                return;
            }

            // aud-a28k. Nothing toggled, nothing written: writing the loaded toggle back reverted a change made
            // elsewhere since the page loaded. A toggle is written alone, decided against its row under the lock.
            if (moduleEnabled == moduleEnabledBaseline)
            {
                statusMessage = "The Exchange Online module status is unchanged; nothing was saved.";
                statusIsError = false;
            }
            else
            {
                var outcome = Enablement.SetModulesEnabled(new Dictionary<string, bool> { ["ExchangeOnline"] = moduleEnabled });
                if (outcome.StoreCorrupt)
                {
                    enablementStoreCorrupt = true;
                    statusMessage = EnablementRefusal();
                    statusIsError = true;
                    Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "StoreCorrupt", statusMessage);
                    return;
                }

                foreach (var change in outcome.Written)
                {
                    try
                    {
                        Audit.LogSettingsChange(currentUser, ip, section,
                            change.Before ? new[] { "Enabled" } : Array.Empty<string>(),
                            change.After ? new[] { "Enabled" } : Array.Empty<string>());
                    }
                    catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for ExchangeOnline status change"); }
                }

                moduleEnabledBaseline = moduleEnabled;
                statusMessage = moduleEnabled
                    ? "Exchange Online module enabled. Dependent modules with their own toggles on are now active."
                    : "Exchange Online module disabled. All dependent modules are now inactive.";
                statusIsError = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Failed to save: {ex.Message}";
            statusIsError = true;
            Audit.LogSettingsSaveFailed(Logger, currentUser, ip, section, statusMessage);
        }
        finally { saving = false; }
    }

    private async Task SaveExoConfig()
    {
        saving = true;
        statusMessage = null;
        statusIsWarning = false;

        // Opened HERE, above the try, so the validation refusals inside it are covered too, and
        // completed in the finally so the bar does not read Idle while the pool teardown is
        // still running. NamedLocations.SaveLocation is the shape this copies.
        //
        // ABOVE the Task.Yield as well, which the other fixes in this work stream did not need.
        // Their first covered call was genuinely async, so the renderer was freed and the bar
        // painted. Everything after the Begin on THIS page is synchronous - the auth state and
        // AuthorizeAsync both complete without yielding, the config write is SQLite and the
        // drain is a blocking call - so the Yield is the handler's only guaranteed flush point
        // and the activity has to be open on the near side of it. An activity opened after it
        // would be a guard that passes while the operator still sees nothing.
        //
        // INDETERMINATE, and that is a measurement rather than a default. The survey called
        // DrainPool the slow part without measuring it. Reading ExoConnectionPool: DrainPoolCore
        // empties the bag one runspace at a time and DestroyRunspace runs a synchronous
        // Disconnect-ExchangeOnline against the service for each one, after which DrainPool
        // re-reads the three connection values from the shared config database, uncached. So the
        // cost is exactly the pool depth - zero to five Exchange Online round trips, the cap
        // being the pool's five slots - and which it is depends on how many runspaces happen to
        // be pooled when Save is pressed, which this page cannot know or count. Steps(2) would
        // tell the operator the local SQLite write is half the wait, and it is not.
        //
        // Completed from a LOCAL, never from statusMessage: the banner above renders a dismiss
        // button wired straight at () => statusMessage = null, so the field can be nulled while
        // this handler is still running, and reading it back in the finally is the post-await
        // live-read trap BlockedSenders.ConfirmUnblock and ADAttributeEditor.ConfirmSave both
        // record. The validation refusals deliberately leave the local null and end the activity
        // as a non-success with no message; the banner carries the reason, as it does on
        // ConferenceRooms.
        (bool success, string? message)? completed = null;
        using var activity = Progress.Begin(
            "Exchange Online",
            "Saving the connection settings and draining pooled connections",
            ActivitySize.Unknown);

        await Task.Yield();

        const string section = "ExchangeOnlineConfig";
        var ip = ClientInfo.GetIpForUser(currentUser);
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authResult = await AuthorizationService.AuthorizeAsync(authState.User, "AdminSettings");
            if (!authResult.Succeeded)
            {
                statusMessage = "Authorization check failed.";
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "Authorization", statusMessage);
                return;
            }

            // aud-a28j. The fields are this page's load: blank when it could not read the connection, and three
            // blank fields pass validation as "clear the configuration". The disabled button was the only guard.
            if (!exoConfigLoaded)
            {
                statusMessage = "Refusing to save: the Exchange Online connection settings could not be read when this page loaded, so the fields shown are not the stored values. Nothing was changed. Reload the page.";
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "StoreUnreadable", statusMessage);
                return;
            }

            var trimmedAppId = exoAppId.Trim();
            var trimmedOrg = exoOrganization.Trim();
            var trimmedCert = exoCertSubject.Trim();

            bool allEmpty = string.IsNullOrWhiteSpace(trimmedAppId)
                         && string.IsNullOrWhiteSpace(trimmedOrg)
                         && string.IsNullOrWhiteSpace(trimmedCert);

            if (!allEmpty)
            {
                bool anyEmpty = string.IsNullOrWhiteSpace(trimmedAppId)
                             || string.IsNullOrWhiteSpace(trimmedOrg)
                             || string.IsNullOrWhiteSpace(trimmedCert);
                if (anyEmpty)
                {
                    statusMessage = "All three fields (App ID, Organization, Certificate Subject) must be filled, or all three must be empty to disable EXO.";
                    statusIsError = true;
                    Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "Validation", statusMessage);
                    return;
                }

                if (!Guid.TryParse(trimmedAppId, out _))
                {
                    statusMessage = "App Registration ID must be a valid GUID (e.g. 00000000-0000-0000-0000-000000000000) or empty to clear.";
                    statusIsError = true;
                    Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "Validation", statusMessage);
                    return;
                }

                if (!trimmedOrg.Contains('.'))
                {
                    statusMessage = "Organization must contain a dot (e.g. contoso.onmicrosoft.com) or be empty to clear.";
                    statusIsError = true;
                    Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "Validation", statusMessage);
                    return;
                }

                if (!trimmedCert.StartsWith("CN=", StringComparison.OrdinalIgnoreCase))
                {
                    statusMessage = "Certificate Subject must start with \"CN=\" (e.g. CN=EXO-Automation) or be empty to clear.";
                    statusIsError = true;
                    Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "Validation", statusMessage);
                    return;
                }
            }

            // aud-a28j. Re-checked immediately before the write, as the Module Configuration saves do.
            if (ModuleConfigSvc.IsModuleCorrupt(ExoConnectionPool.ConfigModuleKey))
            {
                configCorrupt = true;
                exoConfigLoaded = false;
                statusMessage = "Refusing to save: the Exchange Online connection settings cannot be read, and saving would overwrite them. Nothing was changed. "
                    + SettingsStoreText.ModuleConfig(ExoConnectionPool.ConfigModuleKey);
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "StoreCorrupt", statusMessage);
                return;
            }

            // aud-a26n. Only the keys whose field the admin changed, each decided inside one write against what the
            // store held for it when the page loaded; the write returns the values as they were under its lock - the
            // record's before-state (aud-a28k). Writing all three wrote back any key changed elsewhere since the load.
            // A key not edited is never written, so one shown from the appsettings fallback stays the fallback the
            // runtime reads; one changed elsewhere to exactly this save's value is already applied, not a conflict
            // (the aud-a26k rule); one changed to anything else refuses the save, naming it - nothing is merged.
            var wanted = ConnectionFields(trimmedAppId, trimmedOrg, trimmedCert);
            var changed = wanted.Keys
                .Where(k => !string.Equals(wanted[k], (exoShown.GetValueOrDefault(k) ?? "").Trim(), StringComparison.Ordinal))
                .ToList();
            var outcome = ModuleConfigSvc.SaveChangedValues(
                ExoConnectionPool.ConfigModuleKey,
                changed.ToDictionary(k => k, k => exoStored.GetValueOrDefault(k) ?? "", StringComparer.OrdinalIgnoreCase),
                changed.ToDictionary(k => k, k => wanted[k], StringComparer.OrdinalIgnoreCase));
            if (outcome.Status == ModuleConfigSaveStatus.StoreCorrupt)
            {
                configCorrupt = true;
                exoConfigLoaded = false;
                statusMessage = "Refusing to save: the Exchange Online connection settings could not be read as the save went to change them. Nothing was changed. "
                    + SettingsStoreText.ModuleConfig(ExoConnectionPool.ConfigModuleKey);
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "StoreCorrupt", statusMessage);
                return;
            }

            if (outcome.Status == ModuleConfigSaveStatus.ConcurrentChange)
            {
                var one = outcome.ConflictingKeys.Count == 1;
                statusMessage = $"Refusing to save: the stored {string.Join(", ", outcome.ConflictingKeys.Select(ConnectionFieldName))} {(one ? "was" : "were")} changed after this page loaded {(one ? "it" : "them")} - by another administrator, or on the other instance. Nothing was saved. Reload the page and re-apply your changes.";
                statusIsError = true;
                Audit.LogSettingsSaveRefused(Logger, currentUser, ip, section, "ConcurrentChange", statusMessage);
                return;
            }

            var written = changed.Where(k => !outcome.AlreadyApplied.Contains(k, StringComparer.OrdinalIgnoreCase)).ToList();
            if (changed.Count > 0)
            {
                try
                {
                    Audit.LogSettingsChange(currentUser, ip, section, ConnectionEntries(outcome.Before), ConnectionEntries(outcome.After),
                        outcome.AlreadyApplied.Count > 0
                            ? new Dictionary<string, object?> { ["alreadyApplied"] = outcome.AlreadyApplied.ToArray() }
                            : null);
                }
                catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for EXO config change"); }

                foreach (var key in changed)
                {
                    exoShown[key] = wanted[key];
                    exoStored[key] = wanted[key];
                    exoFallback.Remove(key);
                }
            }

            var saved = changed.Count == 0
                ? "The Exchange Online connection settings are unchanged; nothing was written."
                : written.Count == 0
                    ? "The Exchange Online connection settings already held these values - set the same way elsewhere after this page loaded - so nothing needed writing."
                    : allEmpty
                        ? "Exchange Online configuration cleared. EXO features are disabled until reconfigured."
                        : "Exchange Online configuration saved.";
            statusMessage = saved;
            statusIsError = false;
            completed = (true, statusMessage);

            // aud-a26h. The configuration is saved and live once the write returns, so its record and message
            // come first and the drain is its own step. A drain that failed used to land in the save's catch,
            // telling the admin, and the audit, that a saved configuration had not saved.
            //
            // aud-a26n. Every save that passes the refusals drains, one that wrote nothing too, as before: the drain
            // writes nothing, and it is what makes the stored settings live on this instance, whose pool may still
            // hold connections opened before a change saved on the other instance.
            try
            {
                ExoPool.DrainPool();
                if (!allEmpty)
                {
                    statusMessage = written.Count > 0
                        ? "Exchange Online configuration saved. Existing pooled connections have been drained; new connections will use the updated config."
                        : $"{saved} Existing pooled connections have been drained; new connections will use the stored config.";
                    completed = (true, statusMessage);
                }
            }
            catch (Exception drainEx)
            {
                Logger.LogWarning(drainEx, "The Exchange Online connection settings were saved; draining the connection pool failed");
                statusMessage = $"{saved} The Exchange Online connection pool could not be drained: {drainEx.Message.TrimEnd('.')}. Connections opened before the save may still use the previous settings - recycle the application pool to close them.";
                statusIsWarning = true;
                completed = (false, statusMessage);
                // aud-a26k. Its own audit action: under the settings-change action a failed drain read as a failed save.
                try { Audit.LogConnectionPoolDrainFailed(currentUser, ip, PoolSection, statusMessage); }
                catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for the connection pool drain"); }
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Failed to save: {ex.Message}";
            statusIsError = true;
            completed = (false, statusMessage);
            Audit.LogSettingsSaveFailed(Logger, currentUser, ip, section, statusMessage);
        }
        finally
        {
            saving = false;
            activity.Complete(completed?.success ?? false, completed?.message);
        }
    }

    private const string PoolSection = "ExchangeOnlineConfig:ConnectionPool";

    private string EnablementRefusal() =>
        "Refusing to save: saving now would overwrite the stored module enablement with the all-disabled fallback. Nothing was changed. "
        + SettingsStoreText.Enablement(Enablement.LegacyImportFailed);

    private const string AppIdSetting = "ExchangeOnline:AppId";
    private const string OrganizationSetting = "ExchangeOnline:Organization";
    private const string CertificateSubjectSetting = "ExchangeOnline:CertificateSubject";
    private const string BuiltInCertificateSubject = "CN=EXO-Automation";

    private Dictionary<string, string> FallbackCaptions(string? appId, string? organization, string? certificateSubject)
    {
        var captions = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        AddFallbackCaption(captions, ExoConnectionPool.ConfigAppIdKey, appId, AppIdSetting, builtIn: null);
        AddFallbackCaption(captions, ExoConnectionPool.ConfigOrganizationKey, organization, OrganizationSetting, builtIn: null);
        AddFallbackCaption(captions, ExoConnectionPool.ConfigCertSubjectKey, certificateSubject, CertificateSubjectSetting, BuiltInCertificateSubject);
        return captions;
    }

    private void AddFallbackCaption(Dictionary<string, string> captions, string key, string? stored, string setting, string? builtIn)
    {
        if (stored is not null)
            return;

        var configured = Config[setting];
        if (!string.IsNullOrWhiteSpace(configured))
            captions[key] = $"Not set in the database; the configured fallback applies: {configured} ({setting} in appsettings.json).";
        else if (configured is null && builtIn is not null)
            captions[key] = $"Not set in the database; the built-in default applies: {builtIn}.";
    }

    /// <summary>The three connection values keyed by their config keys.</summary>
    private static Dictionary<string, string> ConnectionFields(string appId, string organization, string certificateSubject) =>
        new(StringComparer.OrdinalIgnoreCase)
        {
            [ExoConnectionPool.ConfigAppIdKey] = appId,
            [ExoConnectionPool.ConfigOrganizationKey] = organization,
            [ExoConnectionPool.ConfigCertSubjectKey] = certificateSubject,
        };

    /// <summary>A connection key as the page labels its field.</summary>
    private static string ConnectionFieldName(string key) => key switch
    {
        ExoConnectionPool.ConfigAppIdKey => "App Registration ID",
        ExoConnectionPool.ConfigOrganizationKey => "Organization",
        ExoConnectionPool.ConfigCertSubjectKey => "Certificate Subject",
        _ => key,
    };

    /// <summary>The three connection values as <c>AppId=</c>, <c>Org=</c> and <c>Cert=</c> entries, an empty one left out.</summary>
    private static string[] ConnectionEntries(IReadOnlyDictionary<string, string> values) =>
        new[]
        {
            (Label: "AppId", Key: ExoConnectionPool.ConfigAppIdKey),
            (Label: "Org", Key: ExoConnectionPool.ConfigOrganizationKey),
            (Label: "Cert", Key: ExoConnectionPool.ConfigCertSubjectKey),
        }
        .Where(field => values.TryGetValue(field.Key, out var value) && !string.IsNullOrWhiteSpace(value))
        .Select(field => $"{field.Label}={values[field.Key]}")
        .ToArray();
}

@page "/comms-10k"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "Comms10k")]
@rendermode InteractiveServer
@inject Comms10kService Comms10kService
@inject ExchangeAdminWeb.Services.Jobs.BulkJobService BulkJobs
@inject IActivityProgress Progress
@inject AuditService Audit
@inject ServiceNowService ServiceNow
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager Navigation
@inject ClientInfoService ClientInfo
@inject EmailService Email
@inject IJSRuntime JS
@inject ILogger<ExchangeAdminWeb.Components.Pages.Comms10k> Logger
@using CsvHelper
@using CsvHelper.Configuration
@using System.Globalization

<PageTitle>Comms-10k</PageTitle>

@if (!authChecked)
{
    @* NO SPINNER. No module draws its own progress (owner ruling 2026-10-02,
       `.agents/decisions.md`), and nothing replaces this one: GroupAuthorizationHandler is
       synchronous end to end, so the check finishes faster than a frame and a bar line
       flickering inside a single render is noise, not information.
       The GUARD stays and must stay - it is what stops the page rendering before the check
       has passed, which is refusal, not progress. Kept at the SAME LINE COUNT as the markup
       it replaces, so not one ClickGateRegistry line key moves. *@
    return;
}

<div class="container-fluid">
    <div class="alert alert-warning py-2 mb-3">
        <small><strong>Caution:</strong> Uploading a CSV will replace ALL members of the broadcast distribution list. This action is logged and admin-notified.</small>
    </div>
    <h1 class="mb-4">Comms-10k Broadcast List<ModuleVersion /></h1>

    @if (!Comms10kService.IsConfigured)
    {
        <div class="alert alert-danger">Module not configured. Set TargetGroupName in Admin Settings.</div>
        return;
    }

    <div class="row">
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Current Members</strong>
                    <div>
                        <button class="btn btn-outline-primary btn-sm me-2" @onclick="LoadPreview" disabled="@isLoading">Preview</button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="DownloadFull" disabled="@isLoading">Download CSV</button>
                    </div>
                </div>
                <div class="card-body">
                    @if (preview != null)
                    {
                        <p class="text-muted mb-2"><small>Showing @preview.Members.Count of @preview.TotalCount total members</small></p>
                        <div style="max-height: 300px; overflow-y: auto;">
                            <table class="table table-sm">
                                <thead><tr><th>Name</th><th>Email</th></tr></thead>
                                <tbody>
                                    @foreach (var m in preview.Members)
                                    {
                                        <tr><td>@m.DisplayName</td><td><small>@m.Email</small></td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Click Preview to load current members.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header"><strong>Replace Members</strong></div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Ticket Number <span class="text-muted">(optional)</span></label>
                        <input type="text" class="form-control" @bind="ticketNumber" @bind:event="oninput" placeholder="INC/REQ number, if you have one" disabled="@isLoading" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">CSV File (Email column required)</label>
                        <InputFile OnChange="HandleFileUpload" accept=".csv" disabled="@isLoading" />
                        <button type="button" class="btn btn-outline-secondary btn-sm mt-1" @onclick="DownloadSampleCsv">Sample CSV</button>
                    </div>
                    @if (parsedEmails.Count > 0 && resolveResult == null)
                    {
                        <p class="text-info">@parsedEmails.Count email(s) parsed. Click Validate to check against AD.</p>
                        <button class="btn btn-primary btn-sm" @onclick="ValidateEmails" disabled="@isLoading">
                                                        Validate
                        </button>
                    }

                    @if (resolveResult != null && resolveResult.Success)
                    {
                        <div class="alert alert-info mt-2">
                            <strong>Validated &mdash; not applied yet.</strong>
                            <strong>@resolveResult.ResolvedDns.Count</strong> of @parsedEmails.Count email(s) matched in AD.
                            The distribution list has <strong>not</strong> changed.
                            @if (resolveResult.SkippedEmails.Count > 0)
                            {
                                <br /><span class="text-danger"><strong>@resolveResult.SkippedEmails.Count not found:</strong> @string.Join(", ", resolveResult.SkippedEmails.Take(10))@(resolveResult.SkippedEmails.Count > 10 ? "..." : "")</span>
                            }
                        </div>

                        @if (confirmPending)
                        {
                            <div class="alert alert-danger">
                                <p><strong>Confirm: Replace all members with @resolveResult.ResolvedDns.Count users?</strong>
                                @if (resolveResult.SkippedEmails.Count > 0)
                                {
                                    <br /><small>@resolveResult.SkippedEmails.Count email(s) will be excluded (not found in AD).</small>
                                }
                                </p>
                                <button class="btn btn-danger btn-sm me-2" @onclick="ExecuteReplace" disabled="@isLoading">
                                                                        Confirm Replace
                                </button>
                                <button class="btn btn-secondary btn-sm" @onclick="() => confirmPending = false">Cancel</button>
                            </div>
                        }
                        else if (resolveResult.ResolvedDns.Count > 0)
                        {
                            <span class="badge bg-warning text-dark mb-2">Pending apply &mdash; list unchanged</span>
                            <p class="text-muted mb-2"><small>This is the step that actually changes the list.</small></p>
                            <button class="btn btn-warning btn-lg" @onclick="() => confirmPending = true">
                                Replace All Members (@resolveResult.ResolvedDns.Count users)
                            </button>
                        }
                        else
                        {
                            <div class="alert alert-danger mt-2">No valid users resolved. Cannot proceed.</div>
                        }
                    }
                </div>
            </div>

            @if (result != null)
            {
                @* Five outcomes, five distinct presentations. "Partly applied" and "could not
                   confirm" both have Success false and mean entirely different things to the
                   operator, so the banner is keyed on the OUTCOME, never on the bool. *@
                <div class="alert @AlertClassFor(result.Outcome) mt-3 alert-dismissible">
                    <strong>@HeadlineFor(result.Outcome)</strong>
                    <br />@result.Message
                    @if (result.Outcome is Comms10kOutcome.Succeeded or Comms10kOutcome.SucceededWithExceptions)
                    {
                        <br />

                        <small>The Entra/Outlook member count updates on the next directory sync (typically within ~30 minutes), not immediately.</small>
                    }
                    <button type="button" class="btn-close" @onclick="() => result = null"></button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string currentUser = "";
    private string clientIpAddress = "Unknown";
    private bool authChecked;
    private bool isLoading;
    private string ticketNumber = "";
    private string validatedTicket = "";
    private bool confirmPending;

    /// <summary>Upload ceiling for the CSV. A malformed-upload guard; see HandleFileUpload.</summary>
    private const long UploadSizeLimitBytes = 16 * 1024 * 1024;

    private Comms10kMemberList? preview;
    private List<string> parsedEmails = new();
    private Comms10kResolveResult? resolveResult;
    private Comms10kUpdateResult? result;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUser = user.Identity?.Name ?? "Unknown";

        var authResult = await AuthorizationService.AuthorizeAsync(user, "Comms10k");
        if (!authResult.Succeeded)
        {
            Navigation.NavigateTo("access-denied", forceLoad: true);
            return;
        }

        clientIpAddress = ClientInfo.IpAddress != "Unknown"
            ? ClientInfo.IpAddress
            : ClientInfo.GetIpForUser(currentUser);
        authChecked = true;
    }

    /// <summary>
    /// Loads the first 25 current members for the preview panel.
    /// </summary>
    /// <remarks>
    /// The Begin sits ABOVE the existing isLoading raise so the one yield already on this page
    /// flushes both - the bar and the disabled buttons arrive in the same frame, and no second
    /// flush point is needed. GetMembersAsync is not a cheap read: it fetches the module's AD
    /// credential from Delinea over HTTP before it queries the group.
    ///
    /// Completed on the straight-line path, not in the finally, which closes with isLoading.
    /// A thrown read is a genuine failure and falls out of scope to the dispose fallback, which
    /// is the BlockedSenders.ConfirmUnblock shape and the same choice ValidateEmails made on
    /// this page.
    /// </remarks>
    private async Task LoadPreview()
    {
        using var activity = Progress.Begin(
            "Comms-10k", "Loading the current member list", ActivitySize.Unknown);

        isLoading = true;
        await Task.Yield();
        try
        {
            var loaded = await Comms10kService.GetMembersAsync(limit: 25);
            preview = loaded;

            // Reads the local rather than the preview field, which costs one line and removes
            // the post-await live-read question entirely instead of answering it.
            activity.Complete(true, $"{loaded.TotalCount:N0} member(s) in the list.");
        }
        catch (Exception ex) { result = new Comms10kUpdateResult { Success = false, Message = ex.Message }; }
        finally { isLoading = false; }
    }

    /// <summary>
    /// Exports the WHOLE membership, roughly ten thousand people, as a CSV download.
    /// </summary>
    /// <remarks>
    /// The page's slowest read and the one most worth a bar: an unlimited GetMembersAsync
    /// resolves every member of the broadcast group out of AD, the CSV is then built from all of
    /// them in memory, and the whole file is base64-encoded and pushed to the browser over the
    /// SignalR circuit.
    ///
    /// Completed BELOW the transfer rather than after the read, which is
    /// MessageTraceReports.Download's settled order - the transfer is the last thing the
    /// operator waits on. The audit beneath it is a local JSONL write. The transfer MECHANISM is
    /// deliberately untouched: docs/DownloadMemoryRetention-Plan.md proposes replacing it with
    /// streaming and is a DRAFT, not approved.
    /// </remarks>
    private async Task DownloadFull()
    {
        using var activity = Progress.Begin(
            "Comms-10k", "Exporting the full member list", ActivitySize.Unknown);

        isLoading = true;
        await Task.Yield();
        try
        {
            var full = await Comms10kService.GetMembersAsync();
            using var writer = new System.IO.StringWriter();
            using var csvWriter = new CsvWriter(writer, CultureInfo.InvariantCulture);
            csvWriter.WriteRecords(full.Members);
            var bytes = System.Text.Encoding.UTF8.GetBytes(writer.ToString());
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("downloadFile", $"comms10k_members_{DateTime.Now:yyyyMMdd}.csv", "text/csv", base64);
            Audit.LogLookupAction(currentUser, clientIpAddress, "Comms10k_Export", full.GroupName, true);

            // Reads full, a local, so nothing another handler owns is read after an await.
            activity.Complete(true, $"{full.Members.Count:N0} member(s) exported.");
        }
        catch (Exception ex) { result = new Comms10kUpdateResult { Success = false, Message = ex.Message }; }
        finally { isLoading = false; }
    }

    // Recorded so the job's durable record says WHICH list was applied. Without it a finished
    // job reads "the membership was replaced" with no way to tell with what.
    private string? uploadedFileName;

    /// <summary>
    /// Parses the uploaded CSV into the address list the Validate step then resolves.
    /// </summary>
    /// <remarks>
    /// Reported because the cost is the FILE, not a round trip: the upload guard admits roughly
    /// half a million rows, and every one of them is read off the browser stream over the
    /// circuit, parsed, trimmed and de-duplicated here on the server before anything is shown.
    /// That is operation-scale work under the rule the S3 reviewer settled on 2026-10-08, the
    /// same ground AdminBulkJobs.ToggleDetails and MessageTraceReports.Download stand on.
    ///
    /// NO await Task.Yield() HERE, and that is a decision rather than an omission. The three
    /// handlers fixed on AdminEventLog needed one because they were synchronous end to end;
    /// this one's first read genuinely goes async - InputFile's stream is pulled from the
    /// browser over the circuit, so the renderer is free the moment csv.ReadAsync is awaited and
    /// the bar paints without help.
    ///
    /// The Begin sits below the field resets, which are instant local assignments, so the frame
    /// the first await buys shows the cleared panel the new file deserves rather than the
    /// previous upload's banner.
    /// </remarks>
    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        uploadedFileName = e.File?.Name;
        parsedEmails = new();
        resolveResult = null;
        confirmPending = false;
        result = null;

        using var activity = Progress.Begin(
            "Comms-10k", "Reading the uploaded address list", ActivitySize.Unknown);

        try
        {
            // A MALFORMED-UPLOAD guard, not a membership cap. At the measured average address
            // length this is roughly half a million rows, fifty times the size this module is
            // built for; nothing downstream imposes an upper bound on how many people are
            // handled.
            await using var stream = e.File.OpenReadStream(maxAllowedSize: UploadSizeLimitBytes);
            using var reader = new System.IO.StreamReader(stream);
            var csvConfig = new CsvConfiguration(CultureInfo.InvariantCulture)
            {
                HeaderValidated = null,
                MissingFieldFound = null
            };
            using var csv = new CsvReader(reader, csvConfig);
            await csv.ReadAsync();
            csv.ReadHeader();

            var matchedHeader = csv.HeaderRecord?.FirstOrDefault(h => h.Trim().Equals("Email", StringComparison.OrdinalIgnoreCase))
                ?? csv.HeaderRecord?.FirstOrDefault(h => h.Trim().Equals("UserPrincipalName", StringComparison.OrdinalIgnoreCase));

            if (matchedHeader == null)
            {
                result = new Comms10kUpdateResult { Success = false, Message = "CSV must have an 'Email' or 'UserPrincipalName' column." };
                return;
            }

            var fieldName = matchedHeader;
            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            while (await csv.ReadAsync())
            {
                var val = csv.GetField(fieldName)?.Trim();
                if (!string.IsNullOrWhiteSpace(val) && val.Contains('@') && seen.Add(val))
                    parsedEmails.Add(val);
            }

            // Reads parsedEmails, a field, and that IS safe here rather than assumed to be: the
            // resets at the top of this handler run before the first await and they un-render
            // both controls that could touch it - Validate needs parsedEmails.Count > 0 and
            // Replace needs confirmPending - so no other handler can reach it while this one is
            // suspended on the stream. A missing header column and both catches are refusals
            // and fall out of scope to the dispose fallback.
            activity.Complete(true, $"{parsedEmails.Count:N0} address(es) parsed.");
        }
        catch (IOException ex) when (ex.Message.Contains("exceeds the maximum", StringComparison.OrdinalIgnoreCase))
        {
            // Caught ahead of the generic parse handler below, which reported an oversized upload
            // as a raw stream error that named no limit and read as a corrupt file.
            result = new Comms10kUpdateResult
            {
                Success = false,
                Message = $"That file is larger than the {UploadSizeLimitBytes / (1024 * 1024)} MB upload limit. "
                    + "The limit guards against a malformed upload, not against a large membership - "
                    + "a list of this module's intended size is far below it, so check the file is a "
                    + "plain CSV of addresses."
            };
        }
        catch (Exception ex)
        {
            result = new Comms10kUpdateResult { Success = false, Message = $"Failed to parse CSV: {ex.Message}" };
        }
    }

    private async Task ValidateEmails()
    {
        isLoading = true;
        await Task.Yield();

        // Items, not indeterminate: the uploaded address count IS known here, so the frame can
        // show a true "x of y" while the batched directory lookups run. The Validate button only
        // renders when parsedEmails.Count > 0, so the count is never zero on this path.
        //
        // Opened ABOVE the try rather than below the ticket check (docs/ProgressCoverage-Plan.md
        // S3, the sixth of the nine partials). The optional ticket call ran outside the window,
        // and so did the refusal return under it. Both are now inside it; a refusal ends the
        // activity by disposing the using, which records "This did not finish." - true of a
        // refusal - the same shape BlockedSenders.ConfirmUnblock and MailboxPermissions
        // .SubmitSingle settled on for the same preamble.
        using var resolving = Progress.Begin(
            "Comms-10k", "Resolving addresses in AD", ActivitySize.Items(parsedEmails.Count));

        try
        {
            // Ticket is optional (comms team won't always have one). Only validate a
            // ticket that was actually entered; an entered ticket is still enforced where
            // ServiceNow validation is configured. See docs/ProjectConstitution.md:104.
            var trimmedTicket = ticketNumber.Trim();
            if (!string.IsNullOrEmpty(trimmedTicket))
            {
                var ticketValidation = await ServiceNow.ValidateTicketAsync(trimmedTicket);
                if (!ticketValidation.IsValid)
                {
                    result = new Comms10kUpdateResult { Success = false, Message = $"Ticket validation failed: {ticketValidation.Message}" };
                    return;
                }
            }
            validatedTicket = trimmedTicket;

            // The closing end needed nothing: ResolveEmailsAsync is the LAST remote call this
            // handler makes - there is no notification tail here - and the Complete already sat
            // below it, with no await between the assignment above and the read below, so the
            // outcome it reports cannot be raced by another handler.
            resolveResult = await Comms10kService.ResolveEmailsAsync(parsedEmails);
            resolving.Report(resolveResult.ResolvedDns.Count);
            resolving.Complete(resolveResult.Success, resolveResult.Success
                ? $"{resolveResult.ResolvedDns.Count:N0} of {parsedEmails.Count:N0} matched"
                : resolveResult.Message);

            if (!resolveResult.Success)
                result = new Comms10kUpdateResult { Success = false, Message = resolveResult.Message };
        }
        catch (Exception ex) { result = new Comms10kUpdateResult { Success = false, Message = ex.Message }; }
        finally { isLoading = false; }
    }

    private async Task ExecuteReplace()
    {
        isLoading = true;
        confirmPending = false;
        var ticket = validatedTicket;
        await Task.Yield();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authCheck = await AuthorizationService.AuthorizeAsync(authState.User, "Comms10k");
            if (!authCheck.Succeeded)
            {
                result = new Comms10kUpdateResult { Success = false, Message = "Authorization denied." };
                return;
            }

            // This module deliberately runs NO principal-protection check of either kind - not on
            // the members it writes, and not on its write target. Owner ruling 2026-09-30, in
            // .agents/decisions.md and carried by docs/ProjectConstitution.md as a named scoped
            // exception. The module has exactly one job: replace the membership of one broadcast
            // list that exists to carry recipient counts past Microsoft's per-message limits.
            // Membership of it grants access to nothing, so the member check produced only false
            // positives while costing a runspace and an AD-module import per member - at ten
            // thousand members the module's dominant cost, and enough to block its intended use.
            // This is the app's broadest exemption and it is scoped to this one module: it is
            // BROADER than the Self-Service Groups exception, which drops the target check only
            // and keeps its member check. No other module may read itself into it.
            // The write is NOT atomic: it clears the member attribute and refills in batches,
            // ENQUEUED, NOT EXECUTED HERE. The write clears the member attribute and refills in
            // batches, so for several seconds the list is empty and then partial. Run from this
            // page, an operator who navigated away mid-write would have the result land nowhere -
            // and a progress bar over work whose answer gets discarded is, in the owner's words,
            // "just protracted doom". On the runner the result is durable and leaving is safe.
            //
            // The audit and the admin notification that used to sit here are GONE ON PURPOSE:
            // Comms10kReplaceProcessor performs both, because it performs the mutation. Putting
            // them back would double-file every replace.
            var jobId = BulkJobs.Enqueue(new ExchangeAdminWeb.Services.Jobs.BulkJob
            {
                Id = Guid.NewGuid().ToString("N"),
                ModuleId = ExchangeAdminWeb.Services.Jobs.Comms10kReplaceProcessor.ModuleName,
                JobType = ExchangeAdminWeb.Services.Jobs.Comms10kReplaceJobPayload.JobType,
                Status = ExchangeAdminWeb.Services.Jobs.BulkJobStatus.Queued,
                SubmittedBy = currentUser,
                SubmittedByDisplay = currentUser,
                SubmittedIp = clientIpAddress,
                Ticket = ticket,
                PayloadJson = System.Text.Json.JsonSerializer.Serialize(
                    new ExchangeAdminWeb.Services.Jobs.Comms10kReplaceJobPayload
                    {
                        // The UPLOADED addresses, not the resolved ones: a resolved set is only
                        // valid at the moment it was read, and the job resolves as its first
                        // stage anyway.
                        Emails = parsedEmails,
                        SourceFileName = uploadedFileName,
                    }),
                SubmittedAtUtc = DateTime.UtcNow
            });

            Logger.LogInformation("Comms-10k replace submitted as job {JobId} by {User}", jobId, currentUser);

            // Submitted, not finished - and the message says so rather than implying the list
            // has changed. RefusedBeforeAnyChange is the honest outcome for a submission:
            // nothing has been written yet, and the five real outcomes belong to the job.
            result = new Comms10kUpdateResult
            {
                Success = true,
                Outcome = Comms10kOutcome.RefusedBeforeAnyChange,
                Message = $"Submitted as a background job. It keeps running if you close this tab - "
                    + $"watch the status bar, and collect the result from Bulk Jobs."
            };

            parsedEmails = new();
            resolveResult = null;
            preview = null;
        }
        catch (Exception ex)
        {
            result = new Comms10kUpdateResult { Success = false, Message = ex.Message };
            // SUBMISSION failure, not a write failure - no job exists, so nothing downstream will
            // ever audit this. The processor owns both channels for a replace that actually ran.
            try { Audit.LogModuleAction(currentUser, clientIpAddress, "Comms10k_Replace", "Comms10k", "submission failed", false, ticket, ex.Message); } catch { }
            try { await Email.SendAdminNotificationAsync(currentUser, clientIpAddress, "Comms10k_Replace", false, ticket, new Dictionary<string, string> { ["Target Group"] = "Comms-10k", ["Stage"] = "submission" }, ex.Message); } catch { }
        }
        finally { isLoading = false; }
    }

    /// <summary>Bootstrap alert class per outcome. Green only where the membership is confirmed.</summary>
    private static string AlertClassFor(Comms10kOutcome outcome) => outcome switch
    {
        Comms10kOutcome.Succeeded => "alert-success",
        Comms10kOutcome.SucceededWithExceptions => "alert-warning",
        Comms10kOutcome.PartlyApplied => "alert-danger",
        Comms10kOutcome.CouldNotConfirm => "alert-danger",
        _ => "alert-secondary"
    };

    /// <summary>
    /// The one-line headline. Deliberately blunt on the two outcomes that need the operator to
    /// do something: a half-written broadcast list looks identical to a working one from here.
    /// </summary>
    private static string HeadlineFor(Comms10kOutcome outcome) => outcome switch
    {
        Comms10kOutcome.Succeeded => "Replaced.",
        Comms10kOutcome.SucceededWithExceptions => "Replaced, with members that could not be removed.",
        Comms10kOutcome.PartlyApplied => "The list is INCOMPLETE - re-run the same file.",
        Comms10kOutcome.CouldNotConfirm => "The result could not be confirmed - check the group.",
        _ => "Nothing was changed."
    };

    private async Task DownloadSampleCsv()
    {
        var content = "Email\nuser@company.com\n";
        var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(content));
        await JS.InvokeVoidAsync("downloadFile", "comms10k_sample.csv", "text/csv", base64);
    }
}

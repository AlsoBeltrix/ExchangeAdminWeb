    {
        var content = "Email\nuser@company.com\n";
        var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(content));
        await JS.InvokeVoidAsync("downloadFile", "comms10k_sample.csv", "text/csv", base64);
    }

    private const int HistoryPageSize = 10;
    private const string JobRefusal = "Job unavailable or this action is no longer allowed.";
    private bool _disposed;
    private bool jobsBusy;
    private bool jobsAllowed;
    private string? jobsActor;
    private int jobsGeneration;
    private int historyPage;
    private bool hasMoreHistory;
    private string? jobsLoadError;
    private string? jobsActionMessage;
    private bool jobsActionSucceeded;
    private IReadOnlyList<BulkJob> activeOwnedJobs = [];
    private IReadOnlyList<BulkJob> finishedOwnedJobs = [];
    private BulkJob? detailsJob;
    private IReadOnlyList<BulkJobRow> detailsRows = [];
    private sealed record JobsAccess(string Actor, bool Allowed, int Generation);

    // The policy includes live enablement and section access. Identity.Name is the ownership
    // identity; display names, stripped SAMs and an Unknown fallback cannot identify an owner.
    private async Task<JobsAccess> AuthorizeJobsAsync(int generation)
    {
        var actor = "";
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            if (!CurrentJobsLoad(generation)) return new(actor, false, generation);
            actor = state.User.Identity?.Name ?? "";
            var authorization = await AuthorizationService.AuthorizeAsync(state.User, "Comms10k");
            if (!CurrentJobsLoad(generation)) return new(actor, false, generation);
            if (authorization.Succeeded && state.User.Identity?.IsAuthenticated == true && !string.IsNullOrWhiteSpace(actor))
            {
                BindJobsActor(actor);
                return new(actor, true, jobsGeneration);
            }
        }
        catch (Exception ex) { Logger.LogWarning(ex, "Comms-10k jobs authorization failed"); }

        if (!CurrentJobsLoad(generation)) return new(actor, false, generation);
        DenyOwnedJobs();
        return new(actor, false, jobsGeneration);
    }

    private void BindJobsActor(string actor)
    {
        if (string.Equals(jobsActor, actor, StringComparison.OrdinalIgnoreCase)) return;
        ClearOwnedJobScope();
        jobsActor = actor;
    }

    private void DenyOwnedJobs()
    {
        ClearOwnedJobScope();
        jobsLoadError = "Access to your Comms-10k jobs was denied.";
    }

    private void ClearOwnedJobScope()
    {
        // An authorized actor can still differ from the owner of rendered data. Invalidate
        // pending continuations as well as every cached surface before accepting that actor.
        ClearOwnedJobs();
        jobsActor = null;
        jobsAllowed = false;
        submittedNotice = null;
        historyPage = 0;
        jobsActionMessage = null;
        jobsActionSucceeded = false;
        jobsLoadError = null;
    }

    private void ClearOwnedJobs()
    {
        ++jobsGeneration;
        activeOwnedJobs = [];
        finishedOwnedJobs = [];
        detailsJob = null;
        detailsRows = [];
        hasMoreHistory = false;
    }

    private bool CurrentJobsLoad(int generation) => !_disposed && generation == jobsGeneration;

    // Automatic events call this silent path. Each continuation must still own its generation;
    // a later detail/load/denial or Dispose invalidates it before it can publish cached data.
    private async Task<bool> LoadOwnedJobsAsync()
    {
        var generation = ++jobsGeneration;
        var access = await AuthorizeJobsAsync(generation);
        if (!access.Allowed || !CurrentJobsLoad(access.Generation)) return false;
        try
        {
            var active = BulkJobs.GetActiveOwnedJobs(Comms10kReplaceProcessor.ModuleName,
                Comms10kReplaceJobPayload.JobType, access.Actor);
            var finished = BulkJobs.GetFinishedOwnedJobs(Comms10kReplaceProcessor.ModuleName,
                Comms10kReplaceJobPayload.JobType, access.Actor, HistoryPageSize + 1, historyPage * HistoryPageSize);
            var selected = detailsJob is null ? null : BulkJobs.GetOwnedJob(Comms10kReplaceProcessor.ModuleName,
                Comms10kReplaceJobPayload.JobType, access.Actor, detailsJob.Id);
            var rows = selected is null ? [] : BulkJobs.GetOwnedRows(Comms10kReplaceProcessor.ModuleName,
                Comms10kReplaceJobPayload.JobType, access.Actor, selected.Id);
            activeOwnedJobs = active;
            finishedOwnedJobs = finished.Take(HistoryPageSize).ToArray();
            hasMoreHistory = finished.Count > HistoryPageSize;
            detailsJob = selected;
            detailsRows = rows;
            jobsAllowed = true;
            jobsLoadError = null;
            return true;
        }
        catch (Exception ex)
        {
            ClearOwnedJobs();
            jobsLoadError = "Could not load your jobs. Refresh to try again.";
            Logger.LogWarning(ex, "Comms-10k jobs load failed");
            return false;
        }
    }

    private async Task RefreshOwnedJobs()
    {
        if (_disposed || jobsBusy) return;
        jobsBusy = true;
        ++jobsGeneration;
        using var activity = Progress.Begin("Comms-10k", "Loading your jobs", ActivitySize.Unknown);
        try
        {
            await Task.Yield();
            if (_disposed) return;
            var loaded = await LoadOwnedJobsAsync();
            if (_disposed) return;
            activity.Complete(loaded, loaded ? "Your job list is up to date." : jobsLoadError);
        }
        finally { jobsBusy = false; }
    }

    private async Task PreviousJobsPage()
    {
        if (_disposed || jobsBusy || historyPage == 0) return;
        --historyPage;
        await RefreshOwnedJobs();
    }

    private async Task NextJobsPage()
    {
        if (_disposed || jobsBusy || !hasMoreHistory) return;
        ++historyPage;
        await RefreshOwnedJobs();
    }

    private async Task ToggleJobDetails(string jobId)
    {
        if (_disposed || jobsBusy) return;
        jobsBusy = true;
        var generation = ++jobsGeneration;
        using var activity = Progress.Begin("Comms-10k", "Loading this job's stages", ActivitySize.Unknown);
        try
        {
            await Task.Yield();
            if (_disposed) return;
            var access = await AuthorizeJobsAsync(generation);
            if (!access.Allowed || !CurrentJobsLoad(access.Generation)) return;
            var hiding = detailsJob?.Id == jobId;
            var selected = hiding ? null : BulkJobs.GetOwnedJob(Comms10kReplaceProcessor.ModuleName, Comms10kReplaceJobPayload.JobType, access.Actor, jobId);
            var rows = selected is null ? [] : BulkJobs.GetOwnedRows(Comms10kReplaceProcessor.ModuleName,
                Comms10kReplaceJobPayload.JobType, access.Actor, jobId);
            detailsJob = selected;
            detailsRows = rows;
            jobsActionSucceeded = hiding || selected is not null;
            jobsActionMessage = jobsActionSucceeded ? null : JobRefusal;
            activity.Complete(jobsActionSucceeded, jobsActionSucceeded ? "The job's recorded stages are up to date." : JobRefusal);
        }
        catch (Exception ex)
        {
            detailsJob = null;
            detailsRows = [];
            jobsLoadError = "Could not load this job's stages. Refresh to try again.";
            Logger.LogWarning(ex, "Comms-10k job details load failed");
            activity.Complete(false, jobsLoadError);
        }
        finally { jobsBusy = false; }
    }

    private Task CancelOwnedJob(string jobId) => ChangeOwnedJob(jobId, delete: false);
    private Task RemoveOwnedJob(string jobId) => ChangeOwnedJob(jobId, delete: true);

    private async Task ChangeOwnedJob(string jobId, bool delete)
    {
        if (_disposed || jobsBusy) return;
        jobsBusy = true;
        var generation = ++jobsGeneration;
        var actor = "";
        BulkJob? job = null;
        var succeeded = false;
        using var activity = Progress.Begin("Comms-10k", delete ? "Deleting the job record" : "Requesting job cancellation", ActivitySize.Unknown);
        try
        {
            await Task.Yield();
            if (_disposed) return;
            var access = await AuthorizeJobsAsync(generation);
            actor = access.Actor;
            if (!CurrentJobsLoad(access.Generation) && access.Allowed) return;
            if (_disposed) return;
            // No await between the live policy/identity check and the persisted scope/CAS.
            if (access.Allowed)
                succeeded = delete
                    ? BulkJobs.DeleteOwnedJob(Comms10kReplaceProcessor.ModuleName, Comms10kReplaceJobPayload.JobType, actor, jobId, out job)
                    : BulkJobs.CancelOwnedJob(Comms10kReplaceProcessor.ModuleName, Comms10kReplaceJobPayload.JobType, actor, jobId, out job);
            jobsActionSucceeded = succeeded;
            jobsActionMessage = !succeeded ? JobRefusal : delete ? "Job record deleted. The audit record is kept."
                : "Cancellation requested. It cannot undo or abort an in-flight membership clear/refill.";
            if (succeeded && delete && detailsJob?.Id == jobId)
            {
                detailsJob = null;
                detailsRows = [];
            }
            activity.Complete(succeeded, jobsActionMessage);
        }
        catch (Exception ex)
        {
            jobsActionSucceeded = false;
            jobsActionMessage = "The job action failed. Refresh to check its current state.";
            Logger.LogWarning(ex, "Comms-10k job control failed");
            activity.Complete(false, jobsActionMessage);
        }
        finally
        {
            if (!_disposed)
                WriteJobControlAudit(delete, jobId, actor, job, succeeded);
            jobsBusy = false;
        }
        if (!_disposed) await LoadOwnedJobsAsync();
    }

    private void WriteJobControlAudit(bool delete, string jobId, string actor, BulkJob? job, bool success)
    {
        try
        {
            Audit.LogModuleAction(actor, clientIpAddress, delete ? "Comms10k_DeleteJob" : "Comms10k_CancelJob",
                "Comms10k", jobId, success, job?.Ticket ?? "", success ? null : JobRefusal,
                extra: new Dictionary<string, object?>
                {
                    ["Actor"] = actor, ["RequestedJobId"] = jobId, ["ControlResult"] = success ? "Accepted" : "RefusedOrFailed",
                    ["ModuleId"] = job?.ModuleId, ["JobType"] = job?.JobType,
                    ["JobStatus"] = job?.Status.ToString(), ["SubmittedBy"] = job?.SubmittedBy,
                    ["SubmittedAtUtc"] = job?.SubmittedAtUtc, ["JobMessage"] = job?.Message,
                });
        }
        catch (Exception ex) { Logger.LogError(ex, "Comms-10k job control audit failed"); }
    }

    // The id is only a refresh hint: every reload reauthorizes and queries persisted scope.
    private async void OnOwnedJobChanged(string jobId)
    {
        try
        {
            await InvokeAsync(async () =>
            {
                if (_disposed || jobsBusy) return;
                await LoadOwnedJobsAsync();
                if (!_disposed) StateHasChanged();
            });
        }
        catch (Exception ex) { Logger.LogWarning(ex, "Comms-10k jobs callback failed"); }
    }

    public void Dispose()
    {
        _disposed = true;
        ++jobsGeneration;
        BulkJobs.JobChanged -= OnOwnedJobChanged;
    }

    private static string JobTime(DateTime? utc) => utc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "";
    private static string JobStageName(int rowIndex) => rowIndex switch { 0 => "Resolve", 1 => "Replace", _ => $"Stage {rowIndex}" };
    private static string JobOutcomeSummary(BulkJob job) => job.Status switch
    {

@page "/comms-10k"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "Comms10k")]
@rendermode InteractiveServer
@implements IDisposable
@using ExchangeAdminWeb.Services.Jobs
@inject Comms10kService Comms10kService
@inject ExchangeAdminWeb.Services.Jobs.BulkJobService BulkJobs
@inject IActivityProgress Progress
@inject AuditService Audit
@inject ServiceNowService ServiceNow
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationService AuthorizationService
@inject SectionAccessService SectionAccess
@inject ModuleEnablementService Enablement
@inject NavigationManager Navigation
@inject ClientInfoService ClientInfo
@inject EmailService Email
@inject IJSRuntime JS
@inject ILogger<ExchangeAdminWeb.Components.Pages.Comms10k> Logger
@using CsvHelper
@using CsvHelper.Configuration
@using System.Globalization

<PageTitle>Comms-10k</PageTitle>

@if (!authChecked)
{
    @* NO SPINNER. No module draws its own progress (owner ruling 2026-10-02,
       `.agents/decisions.md`), and nothing replaces this one: GroupAuthorizationHandler is
       synchronous end to end, so the check finishes faster than a frame and a bar line
       flickering inside a single render is noise, not information.
       The GUARD stays and must stay - it is what stops the page rendering before the check
       has passed, which is refusal, not progress. Kept at the SAME LINE COUNT as the markup
       it replaces, so not one ClickGateRegistry line key moves. *@
    return;
}

<div class="container-fluid">
    <div class="alert alert-warning py-2 mb-3">
        <small><strong>Caution:</strong> Uploading a CSV will replace ALL members of the fixed Comms-10k broadcast list. The target cannot be changed in Admin Settings. This action is logged and admin-notified.</small>
    </div>
    <h1 class="mb-4">Comms-10k Broadcast List<ModuleVersion /></h1>

    @if (submittedNotice is not null)
    {
        <div class="alert alert-info py-2"><strong>Submitted.</strong> @submittedNotice</div>
    }
    <section class="card mb-3" aria-label="Your jobs">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Your jobs</strong>
            <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshOwnedJobs" disabled="@jobsBusy">Refresh</button>
        </div>
        <div class="card-body">
            <p class="text-muted"><small>Your Comms-10k replacements. Finished jobs are retained for @BulkJobs.RetentionDays days.
                Completed is a job state; read the recorded stages for the directory outcome.</small></p>
            @if (jobsActionMessage is not null)
            {
                <div class="alert @(jobsActionSucceeded ? "alert-info" : "alert-danger") py-2">@jobsActionMessage</div>
            }
            @if (jobsLoadError is not null)
            {
                <div class="alert alert-danger py-2">@jobsLoadError</div>
            }
            @if (jobsAllowed)
            {
                <div style="overflow-x:auto">
                    <table class="table table-sm align-middle">
                        <thead><tr><th>Job</th><th>Ticket</th><th>Status</th><th>Submitted</th><th>Started</th><th>Finished</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var job in activeOwnedJobs.Concat(finishedOwnedJobs))
                            {
                                <tr>
                                    <td><small>@job.Id</small></td>
                                    <td>@job.Ticket</td>
                                    <td>@BulkJobs.DisplayStatus(job, DateTime.UtcNow)</td>
                                    <td class="text-nowrap"><small>@JobTime(job.SubmittedAtUtc)</small></td>
                                    <td class="text-nowrap"><small>@JobTime(job.StartedAtUtc)</small></td>
                                    <td class="text-nowrap"><small>@JobTime(job.FinishedAtUtc)</small></td>
                                    <td class="text-nowrap">
                                        <button class="btn btn-outline-secondary btn-sm me-1" @onclick="() => ToggleJobDetails(job.Id)" disabled="@jobsBusy">@(detailsJob?.Id == job.Id ? "Hide" : "Details")</button>
                                        @if (!job.IsTerminal)
                                        {
                                            <button class="btn btn-outline-danger btn-sm" @onclick="() => CancelOwnedJob(job.Id)" disabled="@jobsBusy">Request cancellation</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => RemoveOwnedJob(job.Id)" disabled="@jobsBusy" title="Delete this retained job and its stage rows. The audit record is kept.">Delete record</button>
                                        }
                                    </td>
                                </tr>
                                <tr><td colspan="7">
                                    <small>@JobOutcomeSummary(job)</small>
                                    @if (!string.IsNullOrWhiteSpace(job.Message)) { <div><small>@job.Message</small></div> }
                                </td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (activeOwnedJobs.Count == 0 && finishedOwnedJobs.Count == 0)
                {
                    <p class="text-muted">No jobs on this page.</p>
                }
                <div class="d-flex gap-2 align-items-center">
                    <span><small>Finished history, page @(historyPage + 1). All active jobs are shown above.</small></span>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="PreviousJobsPage" disabled="@(jobsBusy || historyPage == 0)">Newer</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="NextJobsPage" disabled="@(jobsBusy || !hasMoreHistory)">Older</button>
                </div>
                <p class="text-muted mt-2 mb-0"><small>Cancellation stops before a later stage. It cannot undo or abort an in-flight membership clear/refill.</small></p>
                @if (detailsJob is not null)
                {
                    <div class="border-top mt-3 pt-2">
                        <strong>Job @detailsJob.Id: @BulkJobs.DisplayStatus(detailsJob, DateTime.UtcNow)</strong>
                        <p class="mb-1">@JobOutcomeSummary(detailsJob)</p>
                        <p class="mb-1">@detailsJob.Message</p>
                        <p class="text-muted"><small>Ticket @detailsJob.Ticket; submitted @JobTime(detailsJob.SubmittedAtUtc);
                            started @JobTime(detailsJob.StartedAtUtc); finished @JobTime(detailsJob.FinishedAtUtc).</small></p>
                        @if (detailsRows.Count == 0)
                        {
                            <p>No stages recorded. This does not establish that the replace succeeded.</p>
                        }
                        else
                        {
                            <table class="table table-sm">
                                <thead><tr><th>Stage</th><th>Source</th><th>Status</th><th>Message</th><th>Recorded</th></tr></thead>
                                <tbody>
                                    @foreach (var row in detailsRows)
                                    {
                                        <tr class="@(row.Status == BulkJobRowStatus.Success ? "" : row.Status == BulkJobRowStatus.Partial ? "table-warning" : "table-danger")">
                                            <td>@JobStageName(row.RowIndex)</td><td>@row.Target</td><td>@row.Status</td><td>@row.Message</td><td>@JobTime(row.RecordedAtUtc)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                }
            }
        </div>
    </section>

    @if (!Comms10kService.IsConfigured)
    {
        <div class="alert alert-danger">Module not configured. Set the Comms-10k AD credential in Admin Settings.</div>
        return;
    }

    <div class="row">
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Current Members</strong>
                    <div>
                        <button class="btn btn-outline-primary btn-sm me-2" @onclick="LoadPreview" disabled="@isLoading">Preview</button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="DownloadFull" disabled="@isLoading">Download CSV</button>
                    </div>
                </div>
                <div class="card-body">
                    @if (preview != null)
                    {
                        <p class="text-muted mb-2"><small>Showing @preview.Members.Count of @preview.TotalCount total members</small></p>
                        <div style="max-height: 300px; overflow-y: auto;">
                            <table class="table table-sm">
                                <thead><tr><th>Name</th><th>Email</th></tr></thead>
                                <tbody>
                                    @foreach (var m in preview.Members)
                                    {
                                        <tr><td>@m.DisplayName</td><td><small>@m.Email</small></td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Click Preview to load current members.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header"><strong>Replace Members</strong></div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Ticket Number <span class="text-muted">(optional)</span></label>
                        <input type="text" class="form-control" @bind="TicketInput" @bind:event="oninput" placeholder="INC/REQ number, if you have one" disabled="@TicketLocked" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">CSV File (Email column required)</label>
                        <InputFile OnChange="HandleFileUpload" accept=".csv" disabled="@isLoading" />
                        <button type="button" class="btn btn-outline-secondary btn-sm mt-1" @onclick="DownloadSampleCsv">Sample CSV</button>
                    </div>
                    @if (parsedEmails.Count > 0 && resolveResult == null)
                    {
                        <p class="text-info">@parsedEmails.Count email(s) parsed. Click Validate to check against AD.</p>
                        <button class="btn btn-primary btn-sm" @onclick="ValidateEmails" disabled="@isLoading">
                                                        Validate
                        </button>
                    }

                    @* THE ERRORS REPORT IS REACHABLE FROM EVERY STATE THAT HAS SOMETHING TO
                       REPORT. Round 2 fixed the all-invalid file by adding a download here, and
                       round 3 found two more states it did not cover: a MIXED file before
                       Validate is pressed (one good row and one bad one, so the Validate path
                       renders and this one did not), and a validation that FAILED (the other
                       download lives inside resolveResult.Success). Both were "recorded but
                       unreachable" again, which is the third time in this stream that a fix was
                       written for the state in front of it and not the one beside it. So the
                       condition is no longer a state at all - it is "are there rejections, and
                       is the success panel not already offering them". *@
                    @if (AllRejections.Count > 0 && (resolveResult == null || !resolveResult.Success))
                    {
                        <div class="alert alert-danger mt-2">
                            @if (resolveResult != null)
                            {
                                <strong>File cannot be applied.</strong>
                                <text> @AllRejections.Count row(s) were rejected. Fix the file and re-upload.</text>
                            }
                            else if (parsedEmails.Count == 0)
                            {
                                <strong>No usable addresses in that file.</strong>
                                <text> @AllRejections.Count row(s) were rejected and there is nothing to validate.</text>
                            }
                            else
                            {
                                <strong>@AllRejections.Count row(s) rejected while reading the file.</strong>
                                <text> Fix the file and re-upload before applying it.</text>
                            }
                            <br /><button class="btn btn-outline-danger btn-sm mt-2" @onclick="DownloadRejections" disabled="@isLoading">Download errors CSV</button>
                        </div>
                    }

                    @if (resolveResult != null && resolveResult.Success)
                    {
                        <div class="alert alert-info mt-2">
                            <strong>@(CanReplace ? "Validated; not applied yet." : "File cannot be applied.")</strong>
                            <strong>@resolveResult.ResolvedDns.Count</strong> of @parsedEmails.Count email(s) matched in AD.
                            The distribution list has <strong>not</strong> changed.
                            @if (AllRejections.Count > 0)
                            {
                                <br /><span class="text-danger"><strong>@AllRejections.Count rejected:</strong> @string.Join(", ", AllRejections.Take(10).Select(r => r.Address))@(AllRejections.Count > 10 ? "..." : "")</span>
                                <br /><button class="btn btn-outline-danger btn-sm mt-2" @onclick="DownloadRejections" disabled="@isLoading">Download errors CSV</button>
                            }
                        </div>

                        @if (CanReplace && confirmPending)
                        {
                            <div class="alert alert-danger">
                                <p><strong>Confirm: Replace all members with @resolveResult.ResolvedDns.Count users?</strong>
                                </p>
                                <button class="btn btn-danger btn-sm me-2" @onclick="ExecuteReplace" disabled="@isLoading">
                                                                        Confirm Replace
                                </button>
                                <button class="btn btn-secondary btn-sm" @onclick="() => confirmPending = false">Cancel</button>
                            </div>
                        }
                        else if (CanReplace)
                        {
                            <span class="badge bg-warning text-dark mb-2">Pending apply &mdash; list unchanged</span>
                            <p class="text-muted mb-2"><small>This is the step that actually changes the list.</small></p>
                            <button class="btn btn-warning btn-lg" @onclick="() => confirmPending = true">
                                Replace All Members (@resolveResult.ResolvedDns.Count users)
                            </button>
                        }
                        else
                        {
                            <div class="alert alert-danger mt-2">A nonempty, fully resolved file with no rejected rows is required. Fix the file and re-upload.</div>
                        }
                    }
                </div>
            </div>

            @if (result != null)
            {
                @* Five outcomes, five distinct presentations. "Partly applied" and "could not
                   confirm" both have Success false and mean entirely different things to the
                   operator, so the banner is keyed on the OUTCOME, never on the bool. *@
                <div class="alert @AlertClassFor(result.Outcome) mt-3 alert-dismissible">
                    <strong>@HeadlineFor(result.Outcome)</strong>
                    <br />@result.Message
                    @if (result.Outcome is Comms10kOutcome.Succeeded or Comms10kOutcome.SucceededWithExceptions)
                    {
                        <br />

                        <small>The Entra/Outlook member count updates on the next directory sync (typically within ~30 minutes), not immediately.</small>
                    }
                    <button type="button" class="btn-close" @onclick="() => result = null"></button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string currentUser = "";
    private string clientIpAddress = "Unknown";
    private bool authChecked;
    private bool isLoading;
    private string ticketNumber = "";
    private string validatedTicket = "";
    private bool confirmPending;

    /// <summary>Upload ceiling for the CSV. A malformed-upload guard; see HandleFileUpload.</summary>
    private const long UploadSizeLimitBytes = 16 * 1024 * 1024;

    private Comms10kMemberList? preview;
    private List<string> parsedEmails = new();
    // Query addresses stay trimmed; rejected rows retain the first occurrence's original text.
    private Dictionary<string, string> originalEmailRows = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Rows rejected by the upload parse, before any directory lookup.
    /// </summary>
    /// <remarks>
    /// The owner's ruling is that EVERY non-matching address is reported with its reason.
    /// These rows never reach the resolver, so without carrying them separately they could
    /// never reach the errors CSV - the page silently decided they did not count.
    /// </remarks>
    private List<Comms10kAddressResolver.Rejection> rejectedBeforeLookup = new();

    /// <summary>
    /// Rows the parse dropped as duplicates, kept with the RAW text so they can be reported if
    /// the address they duplicate turns out not to resolve (mde-9).
    /// </summary>
    private List<(string Raw, string Address)> duplicateRows = new();

    /// <summary>Why a row that is not an address at all was rejected.</summary>
    private const string NotAnAddressReason = "Not an email address";
    private Comms10kResolveResult? resolveResult;
    private Comms10kUpdateResult? result;
    private Comms10kConfirmation? confirmation;
    private string? submittedNotice;

    // Keep the visible ticket tied to approval; delayed input events cannot edit a locked field.
    private bool TicketLocked => isLoading || confirmation is not null;
    private string TicketInput
    {
        get => confirmation?.Ticket ?? ticketNumber;
        set { if (!TicketLocked) ticketNumber = value; }
    }

    private bool CanReplace => confirmation is not null && resolveResult is { Success: true }
        && resolveResult.ResolvedMembers.Count > 0 && AllRejections.Count == 0;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (_disposed) return;
        var user = authState.User;
        currentUser = user.Identity?.Name ?? "";

        var authResult = await AuthorizationService.AuthorizeAsync(user, "Comms10k");
        if (_disposed) return;
        if (!authResult.Succeeded || user.Identity?.IsAuthenticated != true || string.IsNullOrWhiteSpace(currentUser))
        {
            Navigation.NavigateTo("access-denied", forceLoad: true);
            return;
        }

        clientIpAddress = ClientInfo.IpAddress != "Unknown"
            ? ClientInfo.IpAddress
            : ClientInfo.GetIpForUser(currentUser);
        authChecked = true;
        BulkJobs.JobChanged += OnOwnedJobChanged;
        await RefreshOwnedJobs();
    }

    /// <summary>
    /// Loads the first 25 current members for the preview panel.
    /// </summary>
    /// <remarks>
    /// The Begin sits ABOVE the existing isLoading raise so the one yield already on this page
    /// flushes both - the bar and the disabled buttons arrive in the same frame, and no second
    /// flush point is needed. GetMembersAsync is not a cheap read: it fetches the module's AD
    /// credential from Delinea over HTTP before it queries the group.
    ///
    /// Completed on the straight-line path, not in the finally, which closes with isLoading.
    /// A thrown read is a genuine failure and falls out of scope to the dispose fallback, which
    /// is the BlockedSenders.ConfirmUnblock shape and the same choice ValidateEmails made on
    /// this page.
    /// </remarks>
    private async Task LoadPreview()
    {
        if (isLoading) return;

        using var activity = Progress.Begin(
            "Comms-10k", "Loading the current member list", ActivitySize.Unknown);

        isLoading = true;
        await Task.Yield();
        try
        {
            var loaded = await Comms10kService.GetMembersAsync(limit: 25);
            preview = loaded;

            // Reads the local rather than the preview field, which costs one line and removes
            // the post-await live-read question entirely instead of answering it.
            activity.Complete(true, $"{loaded.TotalCount:N0} member(s) in the list.");
        }
        catch (Exception ex) { result = new Comms10kUpdateResult { Success = false, Message = ex.Message }; }
        finally { isLoading = false; }
    }

    /// <summary>
    /// Exports the WHOLE membership, roughly ten thousand people, as a CSV download.
    /// </summary>
    /// <remarks>
    /// The page's slowest read and the one most worth a bar: an unlimited GetMembersAsync
    /// resolves every member of the broadcast group out of AD, the CSV is then built from all of
    /// them in memory, and the whole file is base64-encoded and pushed to the browser over the
    /// SignalR circuit.
    ///
    /// Completed BELOW the transfer rather than after the read, which is
    /// MessageTraceReports.Download's settled order - the transfer is the last thing the
    /// operator waits on. SafeAudit logs a local audit failure separately after delivery. The transfer MECHANISM is
    /// deliberately untouched: docs/DownloadMemoryRetention-Plan.md proposes replacing it with
    /// streaming and is a DRAFT, not approved.
    /// </remarks>
    private async Task DownloadFull()
    {
        if (isLoading) return;

        using var activity = Progress.Begin(
            "Comms-10k", "Exporting the full member list", ActivitySize.Unknown);

        isLoading = true;
        await Task.Yield();
        try
        {
            var full = await Comms10kService.GetMembersAsync();
            var csv = CsvExport.Write(["Email", "SamAccountName", "DisplayName"],
                full.Members.Select(member => new[] { member.Email, member.SamAccountName, member.DisplayName }));
            var bytes = System.Text.Encoding.UTF8.GetBytes(csv);
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("downloadFile", $"comms10k_members_{DateTime.Now:yyyyMMdd}.csv", "text/csv", base64);
            SafeAudit(() => Audit.LogLookupAction(currentUser, clientIpAddress, "Comms10k_Export", full.GroupName, true));

            // Reads full, a local, so nothing another handler owns is read after an await.
            activity.Complete(true, $"{full.Members.Count:N0} member(s) exported.");
        }
        catch (Exception ex) { result = new Comms10kUpdateResult { Success = false, Message = ex.Message }; }
        finally { isLoading = false; }
    }

    /// <summary>
    /// Exports EVERY rejected address with the reason it was rejected, as a CSV download.
    /// </summary>
    /// <remarks>
    /// Owner ruling 2026-10-12 (`.agents/decisions.md`): an address with no exact match is not a
    /// match, and all of the non-matching addresses are reported to the operator with the reason.
    /// This is that report.
    ///
    /// <b>It writes the whole list, never the ten the banner previews.</b> The preview exists so
    /// the operator can see the shape of the problem without leaving the page; this file exists
    /// so they can find the rows in the workbook they uploaded. Truncating here would re-create
    /// the exact complaint the control was built for - "requiring us to manually identify the
    /// affected users".
    ///
    /// Reads <c>resolveResult</c> into a local BEFORE the first await, because the field is
    /// replaced wholesale by Validate and the navigation guard's OK path does not stop the work.
    /// Transfer mechanism copied from DownloadFull deliberately - same base64-over-the-circuit
    /// path, same recorded limitation in docs/DownloadMemoryRetention-Plan.md, which is a DRAFT.
    /// </remarks>
    /// <summary>Every rejected row, from the upload parse and from the directory lookup.</summary>
    /// <remarks>
    /// <para>
    /// The owner's ruling is that EVERY non-matching address is reported. The parse rejects
    /// blanks and non-addresses before the resolver ever sees them, so a report built only
    /// from the resolver silently omitted them - found at review.
    /// </para>
    /// <para>
    /// <b>Duplicates are reported only when the address they duplicate did NOT resolve</b>
    /// (mde-9, review round 4). The recorded decision - a duplicate is not an error - rests on
    /// a condition the parse was applying unconditionally: "the address resolves on its first
    /// appearance, so the person is on the list." When it does NOT resolve, nobody was
    /// included, and two non-matching rows were being reported as one. That undercounts against
    /// the same ruling this property exists to satisfy. So the decision is kept exactly where
    /// its reasoning holds and dropped where it does not: a duplicate of a RESOLVED address is
    /// still silent, and a test pins that.
    /// </para>
    /// </remarks>
    private List<Comms10kAddressResolver.Rejection> AllRejections
    {
        get
        {
            var fromResolver = resolveResult?.Rejections ?? [];
            List<Comms10kAddressResolver.Rejection> all = [.. rejectedBeforeLookup,
                .. fromResolver.Select(rejection => originalEmailRows.TryGetValue(rejection.Address, out var raw)
                    ? rejection with { Address = raw } : rejection)];

            foreach (var (raw, address) in duplicateRows)
            {
                var match = fromResolver.FirstOrDefault(
                    r => string.Equals(r.Address, address, StringComparison.OrdinalIgnoreCase));

                // The RAW text, like every other rejection here, because the operator has to
                // find that row in the file they uploaded. Same reason as the first occurrence.
                if (match != null)
                    all.Add(new Comms10kAddressResolver.Rejection(raw, match.Reason));
            }

            return all;
        }
    }

    private async Task DownloadRejections()
    {
        if (isLoading) return;

        // Captured before any await: nothing below may re-read the field.
        // Both sources: rows the parse rejected before any lookup, then rows the directory
        // rejected. The parse ones come FIRST so they sit together at the top of the file -
        // they are the ones the operator fixes in the workbook rather than chases in AD.
        var rejections = AllRejections;
        if (rejections is null || rejections.Count == 0)
            return;

        using var activity = Progress.Begin(
            "Comms-10k", "Exporting the rejected addresses", ActivitySize.Items(rejections.Count));

        isLoading = true;
        await Task.Yield();
        try
        {
            var csv = CsvExport.Write(["Address", "Reason"],
                rejections.Select(rejection => new[] { rejection.Address, rejection.Reason }));
            var bytes = System.Text.Encoding.UTF8.GetBytes(csv);
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync(
                "downloadFile",
                $"comms10k_rejected_{DateTime.Now:yyyyMMdd_HHmmss}.csv",
                "text/csv",
                base64);
            SafeAudit(() => Audit.LogLookupAction(
                currentUser, clientIpAddress, "Comms10k_ExportRejected", $"{rejections.Count} address(es)", true));

            activity.Complete(true, $"{rejections.Count:N0} rejected address(es) exported.");
        }
        catch (Exception ex)
        {
            result = new Comms10kUpdateResult { Success = false, Message = ex.Message };
            activity.Complete(false, ex.Message);
        }
        finally { isLoading = false; }
    }

    private void SafeAudit(Action write)
    {
        try
        {
            write();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to write Comms-10k audit record.");
        }
    }

    // Recorded so the job's durable record says WHICH list was applied. Without it a finished
    // job reads "the membership was replaced" with no way to tell with what.
    private string? uploadedFileName;

    /// <summary>
    /// Parses the uploaded CSV into the address list the Validate step then resolves.
    /// </summary>
    /// <remarks>
    /// Reported because the cost is the FILE, not a round trip: the upload guard admits roughly
    /// half a million rows, and every one of them is read off the browser stream over the
    /// circuit, parsed, trimmed and de-duplicated here on the server before anything is shown.
    /// That is operation-scale work under the rule the S3 reviewer settled on 2026-10-08, the
    /// same ground AdminBulkJobs.ToggleDetails and MessageTraceReports.Download stand on.
    ///
    /// NO await Task.Yield() HERE, and that is a decision rather than an omission. The three
    /// handlers fixed on AdminEventLog needed one because they were synchronous end to end;
    /// this one's first read genuinely goes async - InputFile's stream is pulled from the
    /// browser over the circuit, so the renderer is free the moment csv.ReadAsync is awaited and
    /// the bar paints without help.
    ///
    /// The Begin sits below the field resets, which are instant local assignments, so the frame
    /// the first await buys shows the cleared panel the new file deserves rather than the
    /// previous upload's banner.
    /// </remarks>
    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        if (isLoading) return;

        isLoading = true;
        uploadedFileName = null;
        parsedEmails = new();
        originalEmailRows = new(StringComparer.OrdinalIgnoreCase);
        rejectedBeforeLookup = new();
        duplicateRows = new();
        resolveResult = null;
        confirmation = null;
        confirmPending = false;
        result = null;

        using var activity = Progress.Begin(
            "Comms-10k", "Reading the uploaded address list", ActivitySize.Unknown);

        try
        {
            var file = e.File;
            var emails = new List<string>();
            var parseRejections = new List<Comms10kAddressResolver.Rejection>();
            var duplicates = new List<(string Raw, string Address)>();
            var originals = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

            // A MALFORMED-UPLOAD guard, not a membership cap. At the measured average address
            // length this is roughly half a million rows, fifty times the size this module is
            // built for; nothing downstream imposes an upper bound on how many people are
            // handled.
            await using var stream = file.OpenReadStream(maxAllowedSize: UploadSizeLimitBytes);
            using var reader = new System.IO.StreamReader(stream);
            var csvConfig = new CsvConfiguration(CultureInfo.InvariantCulture)
            {
                HeaderValidated = null,
                MissingFieldFound = null
            };
            using var csv = new CsvReader(reader, csvConfig);
            await csv.ReadAsync();
            csv.ReadHeader();

            var matchedHeader = csv.HeaderRecord?.FirstOrDefault(h => h.Trim().Equals("Email", StringComparison.OrdinalIgnoreCase))
                ?? csv.HeaderRecord?.FirstOrDefault(h => h.Trim().Equals("UserPrincipalName", StringComparison.OrdinalIgnoreCase));

            if (matchedHeader == null)
            {
                result = new Comms10kUpdateResult { Success = false, Message = "CSV must have an 'Email' or 'UserPrincipalName' column." };
                return;
            }

            var fieldName = matchedHeader;
            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            while (await csv.ReadAsync())
            {
                // The RAW field, untrimmed. What the operator typed is what has to appear in
                // the errors report, because they have to find that row in the workbook they
                // uploaded - and a trailing space may be the whole reason it failed.
                var raw = csv.GetField(fieldName);
                var val = raw?.Trim();

                if (string.IsNullOrWhiteSpace(val))
                {
                    // Dropped rows used to vanish here, which quietly contradicted the ruling
                    // that EVERY non-matching address is reported: a blank row, a row with no
                    // "@", and a duplicate of an already-rejected address never reached the
                    // resolver, so they could never reach the errors CSV either. Found at
                    // review. They are now rejections with a reason, exactly like a lookup
                    // miss, and only the lookup itself is skipped.
                    parseRejections.Add(new Comms10kAddressResolver.Rejection(
                        raw ?? "", Comms10kAddressResolver.Reasons.Blank));
                    continue;
                }

                if (!val.Contains('@'))
                {
                    parseRejections.Add(new Comms10kAddressResolver.Rejection(
                        raw ?? "", NotAnAddressReason));
                    continue;
                }

                if (!seen.Add(val))
                {
                    // Not an error WHEN THE ADDRESS RESOLVES: the person is on the list from its
                    // first appearance, and a row in the errors CSV for somebody who was included
                    // sends the operator chasing a non-problem. That is the recorded decision and
                    // it still holds - but only under its own condition. Round 4 (mde-9) found the
                    // parse applying it unconditionally, so two rows of the same NON-matching
                    // address were reported as one. Kept here with the raw text; AllRejections
                    // emits it only if the resolver rejects the address it duplicates.
                    duplicates.Add((raw ?? "", val));
                    continue;
                }

                emails.Add(val);
                originals.Add(val, raw ?? "");
            }

            // Publish only a complete parse, with no await between the assignments. A stream or
            // CSV failure cannot leave a usable prefix, even for a direct Validate invocation.
            (parsedEmails, rejectedBeforeLookup, duplicateRows, originalEmailRows, uploadedFileName)
                = (emails, parseRejections, duplicates, originals, file.Name);
            activity.Complete(true, $"{emails.Count:N0} address(es) parsed.");
        }
        catch (IOException ex) when (ex.Message.Contains("exceeds the maximum", StringComparison.OrdinalIgnoreCase))
        {
            // Caught ahead of the generic parse handler below, which reported an oversized upload
            // as a raw stream error that named no limit and read as a corrupt file.
            result = new Comms10kUpdateResult
            {
                Success = false,
                Message = $"That file is larger than the {UploadSizeLimitBytes / (1024 * 1024)} MB upload limit. "
                    + "The limit guards against a malformed upload, not against a large membership - "
                    + "a list of this module's intended size is far below it, so check the file is a "
                    + "plain CSV of addresses."
            };
        }
        catch (Exception ex)
        {
            result = new Comms10kUpdateResult { Success = false, Message = $"Failed to parse CSV: {ex.Message}" };
        }
        finally { isLoading = false; }
    }

    private async Task ValidateEmails()
    {
        if (isLoading) return;

        confirmation = null;
        var sourceEmails = parsedEmails;
        var emails = sourceEmails.ToArray();
        var sourceFileName = uploadedFileName;
        var trimmedTicket = ticketNumber.Trim();
        ticketNumber = trimmedTicket;
        var parseRejected = rejectedBeforeLookup.Count > 0;
        isLoading = true;
        await Task.Yield();

        // Items, not indeterminate: the uploaded address count IS known here, so the frame can
        // show a true "x of y" while the batched directory lookups run. The Validate button only
        // renders when parsedEmails.Count > 0, so the count is never zero on this path.
        //
        // Opened ABOVE the try rather than below the ticket check (docs/ProgressCoverage-Plan.md
        // S3, the sixth of the nine partials). The optional ticket call ran outside the window,
        // and so did the refusal return under it. Both are now inside it; a refusal ends the
        // activity by disposing the using, which records "This did not finish." - true of a
        // refusal - the same shape BlockedSenders.ConfirmUnblock and MailboxPermissions
        // .SubmitSingle settled on for the same preamble.
        using var resolving = Progress.Begin(
            "Comms-10k", "Resolving addresses in AD", ActivitySize.Items(emails.Length));

        try
        {
            // Ticket is optional (comms team won't always have one). Only validate a
            // ticket that was actually entered; an entered ticket is still enforced where
            // ServiceNow validation is configured. See docs/ProjectConstitution.md:104.
            if (!string.IsNullOrEmpty(trimmedTicket))
            {
                var ticketValidation = await ServiceNow.ValidateTicketAsync(trimmedTicket);
                if (!ticketValidation.IsValid)
                {
                    result = new Comms10kUpdateResult { Success = false, Message = $"Ticket validation failed: {ticketValidation.Message}" };
                    return;
                }
            }
            validatedTicket = trimmedTicket;

            var resolved = await Comms10kService.ResolveEmailsAsync(emails.ToList());
            // An upload that changed while validation awaited must be validated itself. The
            // confirmation always binds the copied inputs to the result of that same lookup.
            if (!ReferenceEquals(sourceEmails, parsedEmails) || !sourceEmails.SequenceEqual(emails)
                || !string.Equals(sourceFileName, uploadedFileName, StringComparison.Ordinal))
                return;
            resolveResult = resolved;
            if (!parseRejected && resolved.Success && resolved.ResolvedMembers.Count > 0 && AllRejections.Count == 0)
                confirmation = new Comms10kConfirmation(emails, sourceFileName, trimmedTicket, resolved.ResolvedMembers);
            resolving.Report(resolveResult.ResolvedDns.Count);
            resolving.Complete(resolveResult.Success, resolveResult.Success
                ? $"{resolveResult.ResolvedDns.Count:N0} of {emails.Length:N0} matched"
                : resolveResult.Message);

            if (!resolveResult.Success)
                result = new Comms10kUpdateResult { Success = false, Message = resolveResult.Message };
        }
        catch (Exception ex) { result = new Comms10kUpdateResult { Success = false, Message = ex.Message }; }
        finally { isLoading = false; }
    }

    private async Task ExecuteReplace()
    {
        if (isLoading) return;

        // Capture approval and its completeness before the first await. Later field changes
        // cannot pair an old fingerprint with another upload, filename or validated ticket.
        var approved = confirmation;
        var canReplace = CanReplace;
        isLoading = true;
        confirmPending = false;
        var ticket = approved?.Ticket ?? validatedTicket;
        var submissionActor = currentUser;
        await Task.Yield();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var submitter = authState.User.Identity?.Name;
            if (!string.IsNullOrWhiteSpace(submitter)) submissionActor = submitter;
            var authCheck = await AuthorizationService.AuthorizeAsync(authState.User, "Comms10k");
            if (_disposed) return;
            if (!authCheck.Succeeded || authState.User.Identity?.IsAuthenticated != true || string.IsNullOrWhiteSpace(submitter))
            {
                DenyOwnedJobs();
                await RefuseReplaceAsync("Authorization denied.", ticket, submissionActor);
                return;
            }

            BindJobsActor(submitter);
            if (!canReplace || approved is null)
            {
                await RefuseReplaceAsync(
                    "The file must resolve completely with no rejected rows before Replace. Fix the file and re-upload.", ticket, submissionActor);
                return;
            }

            // This module deliberately runs NO principal-protection check of either kind - not on
            // the members it writes, and not on its write target. Owner ruling 2026-09-30, in
            // .agents/decisions.md and carried by docs/ProjectConstitution.md as a named scoped
            // exception. The module has exactly one job: replace the membership of one broadcast
            // list that exists to carry recipient counts past Microsoft's per-message limits.
            // Membership of it grants access to nothing, so the member check produced only false
            // positives while costing a runspace and an AD-module import per member - at ten
            // thousand members the module's dominant cost, and enough to block its intended use.
            // This is the app's broadest exemption and it is scoped to this one module: it is
            // BROADER than the Self-Service Groups exception, which drops the target check only
            // and keeps its member check. No other module may read itself into it.
            // The write is NOT atomic: it clears the member attribute and refills in batches,
            // ENQUEUED, NOT EXECUTED HERE. The write clears the member attribute and refills in
            // batches, so for several seconds the list is empty and then partial. Run from this
            // page, an operator who navigated away mid-write would have the result land nowhere -
            // and a progress bar over work whose answer gets discarded is, in the owner's words,
            // "just protracted doom". On the runner the result is durable and leaving is safe.
            //
            // The audit and the admin notification that used to sit here are GONE ON PURPOSE:
            // Comms10kReplaceProcessor performs both, because it performs the mutation. Putting
            // them back would double-file every replace.
            JobAuthorizationSnapshot snapshot;
            try
            {
                var groups = SectionAccess.GetGroupsForSection(Comms10kReplaceProcessor.ModuleName);
                snapshot = JobAuthorizationSnapshot.Capture(authState.User, Comms10kReplaceProcessor.ModuleName, groups);
                if (!Enablement.IsModuleEnabled(Comms10kReplaceProcessor.ModuleName) || !snapshot.IsStillAuthorized(groups))
                {
                    DenyOwnedJobs();
                    await RefuseReplaceAsync("Authorization denied.", ticket, submissionActor);
                    return;
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Comms-10k submission authorization could not be captured");
                DenyOwnedJobs();
                await RefuseReplaceAsync("Authorization could not be verified.", ticket, submissionActor);
                return;
            }

            var jobId = BulkJobs.Enqueue(new ExchangeAdminWeb.Services.Jobs.BulkJob
            {
                Id = Guid.NewGuid().ToString("N"),
                ModuleId = ExchangeAdminWeb.Services.Jobs.Comms10kReplaceProcessor.ModuleName,
                JobType = ExchangeAdminWeb.Services.Jobs.Comms10kReplaceJobPayload.JobType,
                Status = ExchangeAdminWeb.Services.Jobs.BulkJobStatus.Queued,
                SubmittedBy = submitter,
                SubmittedByDisplay = submitter,
                SubmittedIp = clientIpAddress,
                AuthSnapshotJson = snapshot.ToJson(),
                Ticket = ticket,
                PayloadJson = System.Text.Json.JsonSerializer.Serialize(
                    new ExchangeAdminWeb.Services.Jobs.Comms10kReplaceJobPayload
                    {
                        // The UPLOADED addresses, not the resolved ones: a resolved set is only
                        // valid at the moment it was read, and the job resolves as its first
                        // stage anyway.
                        Emails = approved.Emails.ToList(),
                        SourceFileName = approved.SourceFileName,
                        ApprovedMemberFingerprint = approved.MemberFingerprint,
                    }),
                SubmittedAtUtc = DateTime.UtcNow
            });

            Logger.LogInformation("Comms-10k replace submitted as job {JobId} by {User}", jobId, submitter);
            result = null;
            submittedNotice = $"Job {jobId} keeps running if you close this tab. Read its durable outcome in Your jobs on this page.";

            parsedEmails = new();
            originalEmailRows = new(StringComparer.OrdinalIgnoreCase);
            confirmation = null;
            rejectedBeforeLookup = new();
            resolveResult = null;
            duplicateRows = new();
            preview = null;
            historyPage = 0;
            await LoadOwnedJobsAsync();
        }
        catch (Exception ex)
        {
            // SUBMISSION failure, not a write failure - no job exists, so nothing downstream will
            // ever audit this. The processor owns both channels for a replace that actually ran.
            await RefuseReplaceAsync(ex.Message, ticket, submissionActor);
        }
        finally { isLoading = false; }
    }

    private async Task RefuseReplaceAsync(string reason, string ticket, string actor)
    {
        result = new Comms10kUpdateResult { Success = false, Message = reason };
        try
        {
            Audit.LogModuleAction(actor, clientIpAddress, "Comms10k_Replace", "Comms10k",
                uploadedFileName ?? "uploaded list", false, ticket, reason,
                extra: new Dictionary<string, object?> { ["Outcome"] = Comms10kOutcome.RefusedBeforeAnyChange.ToString() });
        }
        catch (Exception ex) { Logger.LogError(ex, "Comms-10k refused-submission audit failed"); }
        try
        {
            await Email.SendAdminNotificationAsync(actor, clientIpAddress, "Comms10k_Replace", false, ticket,
                new Dictionary<string, string>
                {
                    ["Target Group"] = "Comms-10k",
                    ["Stage"] = "submission",
                    ["Outcome"] = Comms10kOutcome.RefusedBeforeAnyChange.ToString(),
                    ["Detail"] = reason,
                }, reason);
        }
        catch (Exception ex) { Logger.LogError(ex, "Comms-10k refused-submission notification failed"); }
    }

    /// <summary>Bootstrap alert class per outcome. Green only where the membership is confirmed.</summary>
    private static string AlertClassFor(Comms10kOutcome outcome) => outcome switch
    {
        Comms10kOutcome.Succeeded => "alert-success",
        Comms10kOutcome.SucceededWithExceptions => "alert-warning",
        Comms10kOutcome.PartlyApplied => "alert-danger",
        Comms10kOutcome.CouldNotConfirm => "alert-danger",
        _ => "alert-secondary"
    };

    /// <summary>
    /// The one-line headline. Deliberately blunt on the two outcomes that need the operator to
    /// do something: a half-written broadcast list looks identical to a working one from here.
    /// </summary>
    private static string HeadlineFor(Comms10kOutcome outcome) => outcome switch
    {
        Comms10kOutcome.Succeeded => "Replaced.",
        Comms10kOutcome.SucceededWithExceptions => "Replaced, with members that could not be removed.",
        Comms10kOutcome.PartlyApplied => "The list is INCOMPLETE - re-run the same file.",
        Comms10kOutcome.CouldNotConfirm => "The result could not be confirmed - check the group.",
        _ => "Nothing was changed."
    };


@page "/blocked-senders"
@using Microsoft.AspNetCore.Authorization
@using ExchangeAdminWeb.Models
@using ExchangeAdminWeb.Models.BlockedSenders
@attribute [Authorize(Policy = "BlockedSenders")]
@rendermode InteractiveServer
@inject BlockedSenderService BlockedSenderSvc
@inject IActivityProgress Progress
@inject BlockedSenderProtectionGate ProtectionGate
@inject AuditService Audit
@inject EmailService Email
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationService AuthorizationService
@inject OperationTraceService OperationTrace
@inject NavigationManager Navigation
@inject ClientInfoService ClientInfo
@inject IJSRuntime JS
@inject ILogger<ExchangeAdminWeb.Components.Pages.BlockedSenders> Logger

<PageTitle>Blocked Senders</PageTitle>

@if (!authChecked)
{
    @* NO SPINNER. No module draws its own progress (owner ruling 2026-10-02,
       `.agents/decisions.md`), and nothing replaces this one: GroupAuthorizationHandler is
       synchronous end to end, so the check finishes faster than a frame and a bar line
       flickering inside a single render is noise, not information.
       The GUARD stays and must stay - it is what stops the page rendering before the check
       has passed, which is refusal, not progress. Kept at the SAME LINE COUNT as the markup
       it replaces, so not one ClickGateRegistry line key moves. *@
    return;
}

<div class="container-fluid">
    <div class="alert alert-info py-2 mb-3">
        <small>Blocked senders are Microsoft 365 accounts the service has blocked from sending mail (usually after outbound spam). Unblocking is logged and notified. If the account keeps sending spam it will be re-blocked automatically.</small>
    </div>
    <h1 class="mb-4">Blocked Senders<ModuleVersion /></h1>

    @if (result is not null)
    {
        <div class="alert @(result.Success ? "alert-success" : "alert-danger") alert-dismissible" role="alert">
            <strong>@(result.Success ? "Success" : "Error"):</strong> @result.Message
            @if (!string.IsNullOrEmpty(result.Detail))
            {
                <div class="mt-1"><small>@result.Detail</small></div>
            }
            <button type="button" class="btn-close" @onclick="() => result = null" aria-label="Close"></button>
        </div>
    }

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Currently Blocked Senders</strong>
            <div>
                <button class="btn btn-outline-secondary btn-sm me-2" @onclick="DownloadCsvAsync" disabled="@(blockedSenders.Count == 0)">Download CSV</button>
                <button class="btn btn-outline-primary btn-sm" @onclick="LoadBlockedSenders" disabled="@isLoading">
                                        Refresh
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            @if (loadError is not null)
            {
                <div class="alert alert-danger m-3 mb-0">@loadError</div>
            }
            else if (blockedSenders.Count > 0)
            {
                <div>
                    <table class="table table-sm table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Sender Address</th>
                                <th>Reason</th>
                                <th style="width: 200px;">Blocked</th>
                                <th style="width: 110px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sender in blockedSenders)
                            {
                                <tr class="@(confirmAddress == sender.SenderAddress ? "table-active" : "")">
                                    <td>@sender.SenderAddress</td>
                                    <td><small class="text-muted">@(string.IsNullOrWhiteSpace(sender.Reason) ? "—" : sender.Reason)</small></td>
                                    <td><small class="text-muted">@(string.IsNullOrWhiteSpace(sender.BlockedDateRaw) ? "—" : sender.BlockedDateRaw)</small></td>
                                    <td>
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => BeginUnblock(sender)" disabled="@isLoading">Unblock</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (!isLoading)
            {
                <p class="text-muted p-3 mb-0">No blocked senders found. Click Refresh to reload.</p>
            }
        </div>
    </div>

    @if (confirmAddress is not null)
    {
        <div class="card mt-3 border-warning">
            <div class="card-header bg-warning-subtle"><strong>Confirm unblock</strong></div>
            <div class="card-body">
                <p class="mb-3">
                    Unblock <strong>@confirmAddress</strong>? This re-enables the account's ability to send mail.
                </p>
                <div class="mb-3">
                    <label class="form-label fw-semibold" for="ticketNumber">Ticket Number <span class="text-danger">*</span></label>
                    <input id="ticketNumber" class="form-control" type="text"
                           placeholder="INC0001234 or REQ0005678"
                           @bind="ticketNumber" @bind:event="oninput" />
                    <div class="form-text">Service request or incident ticket number</div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold" for="reason">Reason (optional)</label>
                    <input id="reason" class="form-control" type="text"
                           placeholder="Why this sender is being unblocked"
                           @bind="reason" />
                </div>
                <button class="btn btn-danger me-2" @onclick="ConfirmUnblock" disabled="@(isLoading || string.IsNullOrWhiteSpace(ticketNumber))">
                                        Confirm Unblock
                </button>
                <button class="btn btn-secondary" @onclick="CancelUnblock" disabled="@isLoading">Cancel</button>
            </div>
        </div>
    }
</div>

@code {
    private bool authChecked;
    private bool isLoading;
    private bool loadStarted;
    private string currentUser = string.Empty;
    private string clientIpAddress = "Unknown";

    private List<BlockedSenderInfo> blockedSenders = new();
    private string? loadError;
    private PermissionResult? result;

    private string? confirmAddress;
    private string ticketNumber = string.Empty;
    private string reason = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUser = user.Identity?.Name ?? "Unknown";

        // CRITICAL: Explicitly check authorization - [Authorize] attribute is not reliably enforced
        var authResult = await AuthorizationService.AuthorizeAsync(user, "BlockedSenders");
        if (!authResult.Succeeded)
        {
            Navigation.NavigateTo("access-denied", forceLoad: true);
            return;
        }

        clientIpAddress = ClientInfo.IpAddress != "Unknown"
            ? ClientInfo.IpAddress
            : ClientInfo.GetIpForUser(currentUser);

        // Show the page with its loading spinner immediately. The EXO list load is
        // deferred to OnAfterRenderAsync so it does not block prerender — calling it
        // here would freeze the whole page for the 10-15s EXO round-trip before any
        // HTML (and the spinner) reaches the browser.
        isLoading = true;
        authChecked = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || loadStarted || !authChecked)
            return;

        loadStarted = true;
        await LoadBlockedSenders();
    }

    private async Task LoadBlockedSenders()
    {
        isLoading = true;
        loadError = null;
        await Task.Yield();

        try
        {
            using var activity = Progress.Begin(
                "Blocked Senders", "Loading blocked senders", ActivitySize.Unknown);

            var senders = await BlockedSenderSvc.GetBlockedSendersAsync();
            blockedSenders = senders.ToList();
            activity.Complete(true, $"{blockedSenders.Count:N0} sender(s)");

            try
            {
                Audit.LogLookupAction(currentUser, clientIpAddress, "ListBlockedSenders",
                    $"{blockedSenders.Count} sender(s)", success: true);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to write audit for blocked-sender list");
            }
        }
        catch (Exception ex)
        {
            loadError = $"Could not load blocked senders: {ex.Message}";
            blockedSenders = new();
        }
        finally
        {
            isLoading = false;
            // The initial load runs from OnAfterRenderAsync, after which Blazor does NOT
            // auto-render. Without this the spinner stays up and Refresh stays disabled
            // even though the data has arrived. Harmless on the button-click path.
            StateHasChanged();
        }
    }

    /// <summary>
    /// Docs/ModuleCsvExport-Plan.md AC3: SenderAddress,Reason,Blocked, in that order.
    /// Nulls map to an empty cell (not the on-screen em-dash). Static and argument-fed
    /// so tests call it directly without a page instance.
    /// </summary>
    internal static string BuildCsv(IReadOnlyList<BlockedSenderInfo> rows)
    {
        var header = new List<string> { "SenderAddress", "Reason", "Blocked" };
        var csvRows = rows.Select(r => (IReadOnlyList<string>)new List<string>
        {
            r.SenderAddress,
            r.Reason ?? string.Empty,
            r.BlockedDateRaw ?? string.Empty,
        });
        return CsvExport.Write(header, csvRows);
    }

    private async Task DownloadCsvAsync()
    {
        if (blockedSenders.Count == 0)
            return;

        // Snapshot the list being exported. LoadBlockedSenders REPLACES this field rather than
        // mutating it, on its success path and in its catch alike, and ConfirmUnblock finishes by
        // calling it - so without the capture a refresh landing while the file is in flight over
        // the circuit would put a different row count in the audit record, and in this activity's
        // Complete, than the file the operator actually received. That is the same reason
        // DhcpAuthorization, NamedLocations and DefenderEndpointDevices snapshot theirs.
        var rows = blockedSenders;

        // Unknown rather than Items(rows.Count) although the count IS known here: nothing between
        // the Begin and the Complete can Report, so a determinate bar would sit at 0% for the
        // whole export and read as hung. The count goes in the label instead -
        // AdminEventLog.DownloadCsv's and MessageTrace.ExportCsv's settled choice.
        using var activity = Progress.Begin(
            "Blocked Senders",
            $"Exporting {rows.Count:N0} blocked sender(s) to CSV",
            ActivitySize.Unknown);

        // Load-bearing. The projection, the CSV write and both encodes are synchronous end to end
        // and the only await was the interop transfer AFTER all of them, so without a flush point
        // here the first paint would not arrive until the expensive part was over - the vacuous
        // open-and-close ExchangeOnlineConfig.SaveExoConfig recorded.
        await Task.Yield();

        var csv = BuildCsv(rows);
        var bytes = System.Text.Encoding.UTF8.GetBytes(csv);
        var base64 = Convert.ToBase64String(bytes);
        var timestamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
        await JS.InvokeVoidAsync("downloadFile", $"BlockedSenders_{timestamp}.csv", "text/csv", base64);

        try
        {
            Audit.LogModuleAction(currentUser, clientIpAddress, "ExportCsv", "BlockedSenders",
                $"{rows.Count} rows", true);
        }
        catch (Exception auditEx)
        {
            Logger.LogError(auditEx, "Audit failed for Blocked Senders CSV export");
        }

        // Completed BELOW the transfer, which is the settled order on both worked examples: the
        // base64 push over the SignalR circuit is the last thing the operator waits on. The audit
        // above sits INSIDE the window because its own catch swallows and logs, so it cannot fail
        // an export the operator already has. The transfer MECHANISM is untouched -
        // docs/DownloadMemoryRetention-Plan.md proposes replacing it and is a DRAFT. The read is
        // a local captured before the first await.
        activity.Complete(true, $"{rows.Count:N0} blocked sender(s) exported.");
    }

    private void BeginUnblock(BlockedSenderInfo sender)
    {
        confirmAddress = sender.SenderAddress;
        ticketNumber = string.Empty;
        reason = string.Empty;
        result = null;
    }

    private void CancelUnblock()
    {
        confirmAddress = null;
        ticketNumber = string.Empty;
        reason = string.Empty;
    }

    private async Task ConfirmUnblock()
    {
        if (confirmAddress is null)
            return;

        isLoading = true;
        result = null;
        await Task.Yield();

        var address = confirmAddress;
        var ticket = ticketNumber.Trim();
        var unblockReason = reason.Trim();

        // Opened HERE, above the try, so the authorization and protected-principal refusals
        // inside it are covered too, and completed AFTER the notification email - not at the
        // write - so the bar does not read Idle while an email is still in flight.
        // NamedLocations.SaveLocation is the shape this copies, and the one deviation from it is
        // forced rather than chosen: ConfirmUnblock_HasNoFinally refuses a finally on this method
        // because it would move the isLoading clear past the trailing refresh and turn that
        // refresh into a silent no-op. So the single Complete sits on the straight-line path
        // after the email, and the three early refusal returns above it end the activity by
        // disposing the using - which ActivityProgressService documents as always ending it.
        //
        // The OperationTrace scope opened further down is NOT this. The trace is the diagnostic
        // record read afterwards; the activity is the status frame watched now. Confusing the two
        // is how a live Exchange Online write shipped with the bar Idle on the one page the
        // operator reported.
        //
        // Completed from the LOCAL opResult, never from the result field. This page's banner
        // renders a dismiss button wired straight at () => result = null, and it stays clickable
        // while the handler is suspended at the write or at the email await, so reading the field
        // back down there is the post-await live-read trap ClickGateRegistry records against
        // NamedLocations - with a live control on this very page to spring it.
        //
        // Three steps, because the sequence is fixed once the operation proceeds: the permission
        // and protection checks, the Exchange Online write, the notification. A refusal ends at
        // the step it reached, which is what happened, not a lie about size.
        using var activity = Progress.Begin(
            "Blocked Senders", $"Unblocking {address}", ActivitySize.Steps(3));

        // Everything from here to the opening of the operation scope runs inside one catch. The
        // authorization round trip, the protection gate and BeginOperation can all throw, and an
        // exception escaping a Blazor Server event handler is not recoverable here: there is no
        // ErrorBoundary anywhere in this app (verified across Components/, Services/ and
        // Program.cs - docs/ClickGatingAudit-Plan.md Revision 1, falsification 1), so the throw
        // tears the circuit down and the operator loses the whole page, not just this button.
        //
        // A catch, deliberately NOT a try/finally wrapped round the method. Two reasons, and the
        // second is the load-bearing one:
        //  * a finally cannot rescue a torn-down circuit - it lowers a flag on a page that is
        //    already gone - whereas a catch keeps the circuit alive and shows the operator why
        //    nothing happened;
        //  * the isLoading = false at the end of this method must keep running BEFORE the
        //    LoadBlockedSenders refresh below. A finally moves it after, and once that refresh
        //    consults a page-level busy predicate (the click-gating sweep,
        //    docs/ClickGatingAudit-Plan.md) it would silently no-op, leaving the sender that was
        //    just unblocked still on screen. ConfirmUnblock_LowersIsLoadingBeforeTheRefresh pins
        //    that ordering.
        BlockedSenderGateDecision gate;
        OperationTraceService.OperationScope scope;
        try
        {
            activity.Step("checking whether this sender may be unblocked");

            // Re-check authorization immediately before the write: a user removed from the
            // section group (or whose module was disabled) mid-session must not keep mutating.
            // The unblock write requires the granular BlockedSendersUnblock policy; viewing
            // the list only requires the main BlockedSenders policy.
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authCheck = await AuthorizationService.AuthorizeAsync(authState.User, "BlockedSendersUnblock");
            if (!authCheck.Succeeded)
            {
                try
                {
                    Audit.LogModuleAction(currentUser, clientIpAddress, "UnblockSender_Denied",
                        "BlockedSenders", address, success: false, ticketNumber: ticket,
                        errorDetail: "Authorization denied (BlockedSendersUnblock).");
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to write audit for denied unblock of {Address}", address);
                }
                result = PermissionResult.Fail("Authorization denied. You do not have permission to unblock senders.");
                isLoading = false;
                return;
            }

            // Protected-principal gate. Unblocking changes a principal's mail-flow state, so it is a
            // mutating operation on a target and must be gated like every other one - this module was
            // missing it entirely, which the authorization re-check above does NOT cover: that checks
            // the OPERATOR, this checks the TARGET.
            //
            // A dedicated gate, NOT PermissionValidator.ValidateTargetMailboxAsync: that helper skips
            // Exchange resolution when the protection config holds only address-form user rows, which
            // would let an alias-addressed protected principal through, and it denies every
            // unresolvable address - wrong here, where external and decommissioned senders are exactly
            // what needs clearing. See BlockedSenderProtectionGate for the full reasoning.
            // authState was resolved just above for the authorization re-check; reuse it rather than
            // letting the gate reach for ambient state.
            gate = await ProtectionGate.EvaluateAsync(address, authState.User);
            if (gate.Denied)
            {
                var protectedError = gate.Reason;
                try
                {
                    Audit.LogModuleAction(currentUser, clientIpAddress, "UnblockSender_Denied",
                        "BlockedSenders", address, success: false, ticketNumber: ticket,
                        errorDetail: gate.AuditDetail ?? protectedError);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to write audit for protected-principal denied unblock of {Address}", address);
                }
                result = PermissionResult.Fail(protectedError ?? "Access denied.");
                isLoading = false;
                return;
            }

            scope = OperationTrace.BeginOperation("BlockedSenders", "UnblockSender",
                currentUser, clientIpAddress, target: address, ticket: ticket);
        }
        catch (Exception ex)
        {
            // Fail closed. Nothing has been written at this point, so a preflight that could not
            // complete refuses the unblock rather than guessing at its answer - the operator is
            // told why, and the page stays alive and usable.
            Logger.LogError(ex, "Unblock preflight failed for {Address}", address);
            try
            {
                Audit.LogModuleAction(currentUser, clientIpAddress, "UnblockSender_Denied",
                    "BlockedSenders", address, success: false, ticketNumber: ticket,
                    errorDetail: $"Preflight failed before the write: {ex.Message}");
            }
            catch (Exception auditEx)
            {
                Logger.LogWarning(auditEx, "Failed to write audit for failed unblock preflight of {Address}", address);
            }
            result = PermissionResult.Fail(
                $"Could not verify whether {address} may be unblocked, so nothing was changed: {ex.Message}");
            isLoading = false;
            return;
        }

        PermissionResult opResult;
        try
        {
            activity.Step("unblocking the sender in Exchange Online");
            OperationTrace.Step("Reauthorized");
            OperationTrace.Step("BackendWrite", backend: "ExchangeOnline", command: "Remove-BlockedSenderAddress", target: address);
            opResult = await BlockedSenderSvc.UnblockSenderAsync(address, unblockReason);
            scope.Complete(opResult.Success, opResult.Success ? null : opResult.Message);
        }
        catch (Exception ex)
        {
            OperationTrace.Step("BackendWrite", "Failed", backend: "ExchangeOnline", exception: ex);
            scope.Complete(false, "Unblock failed", ex);
            opResult = PermissionResult.Fail($"Unblock failed: {ex.Message}");
        }

        // Audit the outcome. An audit-write failure must not change the already-committed result.
        try
        {
            // gate.AuditDetail is populated on an ALLOW only when the target was a protected
            // principal serviced by an authorised operator. Recording it is the entire
            // accountability mechanism for that feature: there is no confirmation prompt and no
            // alert, by design, because servicing VIP mailboxes is the exec support team's routine
            // work. The audit must therefore carry which rules were overridden and under whose
            // authority.
            //
            // It goes in `extra`, NOT `errorDetail`: LogModuleAction writes
            // ["error"] = success ? null : errorDetail, so a detail passed there on a SUCCESSFUL
            // operation is silently discarded - which is exactly what happened in the first cut of
            // this feature. Review caught it. A serviced unblock succeeds, so the record would
            // have been lost in the one case it exists for.
            var serviced = opResult.Success && !string.IsNullOrWhiteSpace(gate.AuditDetail)
                ? new Dictionary<string, object?> { ["protectedPrincipalServiced"] = gate.AuditDetail }
                : null;

            Audit.LogModuleAction(currentUser, clientIpAddress, "UnblockSender",
                "BlockedSenders", address, opResult.Success, ticketNumber: ticket,
                errorDetail: opResult.Success ? null : opResult.Message,
                extra: serviced);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to write audit for unblock of {Address}", address);
        }

        // Admin notification (house pattern for mutating modules). A send failure must not
        // change the unblock result, so it is caught and logged separately.
        activity.Step("sending the notification");
        try
        {
            await Email.SendAdminNotificationAsync(
                currentUser, clientIpAddress, "UnblockSender", opResult.Success, ticket,
                new Dictionary<string, string>
                {
                    ["Sender Address"] = address,
                    ["Reason"] = string.IsNullOrWhiteSpace(unblockReason) ? "(none)" : unblockReason,
                },
                opResult.Success ? null : opResult.Message);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to send admin notification for unblock of {Address}", address);
        }

        // The window closes HERE, before the trailing refresh, and that is a decision rather
        // than a convenience. LoadBlockedSenders opens its OWN activity with its own honest
        // label, so spanning it would put two bars in the frame for one click, the older one
        // still claiming the unblock is running after it has already committed - the
        // MessageTraceReports.Download defect pointed the other way. The write is finished and
        // its outcome is known at this point, which is exactly when the frame should stop saying
        // it is running; the refresh that follows is reported, separately and honestly, by the
        // operation that actually does it.
        activity.Complete(opResult.Success, opResult.Message);

        result = opResult;
        isLoading = false;

        if (opResult.Success)
        {
            confirmAddress = null;
            ticketNumber = string.Empty;
            reason = string.Empty;
            await LoadBlockedSenders();
        }
    }
}

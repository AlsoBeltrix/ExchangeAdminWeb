@page "/group-management"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "GroupManagement")]
@rendermode InteractiveServer
@inject GroupManagementService GroupService
@inject AuditService Audit
@inject EmailService Email
@inject ServiceNowService ServiceNow
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager Navigation
@inject ClientInfoService ClientInfo
@inject ILogger<GroupManagement> Logger

<PageTitle>Group Management</PageTitle>

@if (!authChecked)
{
    <div class="container-fluid">
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    </div>
    return;
}

<div class="container-fluid">
    <h1 class="mb-4">Group Management<ModuleVersion /></h1>

    <div class="row mb-3">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Search groups by name or email..."
                       value="@searchTerm"
                       @oninput="(e) => searchTerm = e.Value?.ToString() ?? string.Empty"
                       @onkeydown="HandleSearchKey" disabled="@isLoading" />
                <button class="btn btn-primary" @onclick="Search" disabled="@(isLoading || string.IsNullOrWhiteSpace(searchTerm))">
                    @if (isLoading && selectedGroup == null) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Search
                </button>
            </div>
        </div>
    </div>

    @if (selectedGroup != null)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <strong>@selectedGroup.Name</strong>
                    <small class="text-muted ms-2">@selectedGroup.Email</small>
                </div>
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => { selectedGroup = null; memberList = null; targetProtection = null; ClearBulkState(); }">Close</button>
            </div>
            <div class="card-body">
                @if (!canManageOnPrem)
                {
                    <div class="alert alert-warning mb-3">
                        You do not have permission to modify on-premises AD groups. Contact the Exchange team.
                    </div>
                }

                @if (targetProtection is null)
                {
                    @* The protection answer gates the whole panel: nothing renders until it
                       arrives, and a denial replaces the panel outright (owner, 2026-08-31). *@
                    <div class="text-muted"><span class="spinner-border spinner-border-sm me-1"></span><small>Checking protection...</small></div>
                }
                else if (targetProtection.DenialMessage != null)
                {
                    <div class="alert alert-danger mb-0">@targetProtection.DenialMessage</div>
                }
                else
                {
                @if (targetProtection.IsProtected)
                {
                    <div class="alert alert-warning py-2"><small>Protected group - your servicer grant for this module authorises viewing and changes; every write is recorded with that authority.</small></div>
                }

                @if (memberList == null)
                {
                    <button class="btn btn-primary btn-sm" @onclick="LoadMembers" disabled="@isLoading">
                        @if (isLoading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Load Members
                    </button>
                }
                else if (memberList.Error != null)
                {
                    <div class="alert alert-danger">@memberList.Error</div>
                }
                else
                {
                    <p class="text-muted mb-2"><small>@memberList.Members.Count member(s)</small></p>

                    @if (canManageOnPrem)
                    {
                        <div class="row g-2 mb-3">
                            <div class="col-auto">
                                <input type="text" class="form-control form-control-sm" placeholder="Ticket #" @bind="ticketNumber" @bind:event="oninput" disabled="@isLoading" style="width: 140px;" />
                            </div>
                            <div class="col">
                                <div class="input-group input-group-sm">
                                    <div class="flex-grow-1">
                                        @* Nesting plan S5c: AD objects, not Exchange recipients - this cmdlet chain
                                           writes to on-prem AD and rejected any cloud-only recipient the old picker
                                           offered. The whole selected result is held beside the visible text (gmn-3):
                                           group search is forest-wide, so two domains can hold same-named groups and
                                           only the DN distinguishes them. *@
                                        <ADIdentityAutocomplete ObjectKind="Any"
                                                                Value="@newMember"
                                                                ValueChanged="OnNewMemberChanged"
                                                                OnResultSelected="OnNewMemberSelected"
                                                                Placeholder="Search for a user or group"
                                                                Disabled="@isLoading" />
                                    </div>
                                    <button class="btn btn-success" @onclick="AddMember" disabled="@(isLoading || string.IsNullOrWhiteSpace(newMember) || string.IsNullOrWhiteSpace(ticketNumber))">Add</button>
                                </div>
                            </div>
                        </div>
                    }

                    @if (opResult != null)
                    {
                        <div class="alert @(opResult.Success ? "alert-success" : "alert-danger") alert-dismissible py-2">
                            <small>@opResult.Message</small>
                            <button type="button" class="btn-close btn-close-sm" @onclick="() => opResult = null"></button>
                        </div>
                    }

                    @if (canManageOnPrem)
                    {
                        @* Bulk remove (docs/GroupBulkActions-Plan.md S2): tick rows, one confirmed batch.
                           Every member still runs the SAME per-member handler as the single Remove
                           button - RemoveOneAsync - so authorization, protection, write, read-back and
                           audit are per row; one refusal never hides another (Known Failure Class 2). *@
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => showRemoveConfirm = true"
                                    disabled="@(isLoading || SelectedCount == 0 || string.IsNullOrWhiteSpace(ticketNumber))"
                                    title="@(string.IsNullOrWhiteSpace(ticketNumber) ? "Enter a ticket number first." : (SelectedCount == 0 ? "Tick one or more members first." : null))">Remove selected (@SelectedCount)</button>
                            <small class="text-muted">Tick members below and remove them in one confirmed batch. Each member is checked and written on its own, so one refusal never hides another.</small>
                        </div>
                        @if (showRemoveConfirm && SelectedCount > 0)
                        {
                            <div class="alert alert-warning py-2">
                                <div><strong>Remove @SelectedCount member(s) from @selectedGroup.Name?</strong> <small>Ticket @ticketNumber.Trim() will be recorded on every removal.</small></div>
                                <ul class="mb-2 small">
                                    @foreach (var sel in SelectedMembers())
                                    {
                                        <li>@sel.DisplayName <span class="text-muted">(@sel.MemberKind)</span></li>
                                    }
                                </ul>
                                <button class="btn btn-danger btn-sm me-1" @onclick="RemoveSelectedAsync" disabled="@isLoading">
                                    @if (isLoading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                    Remove @SelectedCount member(s)
                                </button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => showRemoveConfirm = false" disabled="@isLoading">Cancel</button>
                            </div>
                        }
                    }

                    @if (bulkOutcome != null)
                    {
                        <div class="card mb-3">
                            <div class="card-header d-flex justify-content-between align-items-center py-1">
                                <small><strong>@bulkOutcomeTitle</strong></small>
                                <button type="button" class="btn-close btn-close-sm" @onclick="() => bulkOutcome = null"></button>
                            </div>
                            <table class="table table-sm mb-0">
                                <thead><tr><th>Member</th><th>Outcome</th><th>Detail</th></tr></thead>
                                <tbody>
                                    @foreach (var o in bulkOutcome)
                                    {
                                        <tr class="@(o.Done ? "" : "table-danger")">
                                            <td>@o.Label</td>
                                            <td>@(o.Done ? "Done" : "Not done")</td>
                                            <td><small>@o.Message</small></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <div style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    @if (canManageOnPrem)
                                    {
                                        @* Select-all covers only rows whose single Remove is enabled (CanRemove):
                                           a primary-group or unresolved row can never be selected. *@
                                        <th style="width: 2rem;"><input type="checkbox" class="form-check-input" checked="@AllSelectableSelected"
                                                                        @onchange="e => ToggleSelectAll(e.Value is true)"
                                                                        disabled="@(isLoading || SelectableMembers().Count == 0)"
                                                                        title="Select all removable members" /></th>
                                    }
                                    <th>Name</th><th>Email</th><th>Kind</th><th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in memberList.Members)
                                {
                                    var member = m;
                                    <tr>
                                        @if (canManageOnPrem)
                                        {
                                            <td><input type="checkbox" class="form-check-input" checked="@selectedGuids.Contains(member.ObjectGuid)"
                                                       @onchange="e => ToggleSelected(member, e.Value is true)"
                                                       disabled="@(isLoading || !CanRemove(member))"
                                                       title="@RemoveDisabledReason(member)" /></td>
                                        }
                                        <td>@member.DisplayName</td>
                                        <td><small>@member.Email</small></td>
                                        <td><small>@member.MemberKind</small></td>
                                        <td>
                                            @if (canManageOnPrem)
                                            {
                                                @* lst-1: a row with no immutable id could not be resolved in its own
                                                   domain and is INERT - the service refuses it too; this removes the
                                                   affordance so the refusal is not the operator's first hint. *@
                                                <button class="btn btn-outline-danger btn-sm" @onclick="() => RemoveMember(member)"
                                                        disabled="@(isLoading || string.IsNullOrWhiteSpace(ticketNumber) || string.IsNullOrEmpty(member.ObjectGuid) || member.IsPrimaryMember)"
                                                        title="@(member.IsPrimaryMember ? "This is the member's primary group; primary-group membership cannot be removed here." : (string.IsNullOrEmpty(member.ObjectGuid) ? "This member could not be resolved in its own domain, so it cannot be removed here." : null))">Remove</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                }
            </div>
        </div>
    }

    @if (searchResults.Count > 0)
    {
        <div class="card">
            <div class="card-header"><strong>Search Results (@searchResults.Count)</strong></div>
            <div class="card-body p-0">
                <div style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-sm table-hover mb-0">
                        <thead><tr><th>Name</th><th>Domain</th><th>Email</th><th>Type</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var group in searchResults)
                            {
                                var g = group;
                                <tr class="@(selectedGroup?.Identity == g.Identity ? "table-active" : "")">
                                    <td>@g.Name</td>
                                    <td><span class="badge bg-light text-dark border">@g.DomainLabel</span></td>
                                    <td><small>@g.Email</small></td>
                                    <td><span class="badge bg-light text-dark border">@g.GroupType</span></td>
                                    <td><button class="btn btn-outline-primary btn-sm" @onclick="() => SelectGroup(g)">Manage</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string currentUser = "";
    private string clientIpAddress = "Unknown";
    private bool authChecked;
    private bool isLoading;
    private bool canManageOnPrem;
    private string searchTerm = "";
    private string newMember = "";
    // The whole picker selection held beside the visible text (S5c, gmn-3): the DN is the only
    // identity that distinguishes same-named groups across the forest's domains.
    private ExchangeAdminWeb.Services.ADSearchResult? newMemberSelection;
    private string ticketNumber = "";
    private List<GroupInfo> searchResults = new();
    private GroupInfo? selectedGroup;
    private TargetProtectionCheck? targetProtection;
    private GroupMemberList? memberList;
    private PermissionResult? opResult;

    // Bulk remove state (docs/GroupBulkActions-Plan.md S2). Selection is keyed on the immutable
    // objectGUID, the same key the remove path acts on; it never survives a list reload or a
    // group switch (ClearBulkState - the gmn-4 shape).
    private readonly HashSet<string> selectedGuids = new(StringComparer.OrdinalIgnoreCase);
    private bool showRemoveConfirm;
    private List<BulkRowOutcome>? bulkOutcome;
    private string bulkOutcomeTitle = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUser = user.Identity?.Name ?? "Unknown";

        var authResult = await AuthorizationService.AuthorizeAsync(user, "GroupManagement");
        if (!authResult.Succeeded)
        {
            Navigation.NavigateTo("access-denied", forceLoad: true);
            return;
        }

        var onPremAuth = await AuthorizationService.AuthorizeAsync(user, "GroupManagementOnPrem");
        canManageOnPrem = onPremAuth.Succeeded;

        clientIpAddress = ClientInfo.IpAddress != "Unknown"
            ? ClientInfo.IpAddress
            : ClientInfo.GetIpForUser(currentUser);
        authChecked = true;
    }

    private async Task HandleSearchKey(KeyboardEventArgs e)
    {
        // Await (never discard) so Blazor re-renders when the search completes;
        // a discarded task left results invisible until the next UI event.
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(searchTerm))
            await Search();
    }

    private async Task Search()
    {
        isLoading = true;
        selectedGroup = null;
        memberList = null;
        opResult = null;
        ClearBulkState();
        await Task.Yield();

        try
        {
            searchResults = await GroupService.SearchGroupsAsync(searchTerm.Trim());
        }
        catch (Exception ex)
        {
            opResult = PermissionResult.Fail(ex.Message);
        }
        finally { isLoading = false; }
    }

    private async Task SelectGroup(GroupInfo group)
    {
        selectedGroup = group;
        memberList = null;
        opResult = null;
        newMember = "";
        // gmn-7: a group switch never inherits a picker selection made for another group.
        newMemberSelection = null;
        // Nor a bulk selection, pending confirmation or outcome table made for another group.
        ClearBulkState();

        // Query-time protection check (owner ruling 2026-08-31): the operator learns a group
        // is protected at selection, not after composing a write. gmn-7 shape: the result is
        // applied only if this group is still the selection when the await returns. Fail
        // closed - an errored check denies rather than rendering the normal panel.
        targetProtection = null;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var check = await GroupService.CheckTargetProtectionAsync(group.Identity, group.SamAccountName, authState.User);
            if (ReferenceEquals(selectedGroup, group))
                targetProtection = check;
        }
        catch (Exception ex)
        {
            if (ReferenceEquals(selectedGroup, group))
                targetProtection = new TargetProtectionCheck(true, ex.Message, null);
        }
    }

    private async Task LoadMembers()
    {
        isLoading = true;
        // A reload invalidates every GUID the selection held (rows may be gone).
        selectedGuids.Clear();
        showRemoveConfirm = false;
        await Task.Yield();
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            memberList = await GroupService.GetMembersAsync(selectedGroup!.Identity, authState.User, selectedGroup.SamAccountName);
        }
        catch (Exception ex)
        {
            memberList = new GroupMemberList { GroupName = selectedGroup!.Name, Error = ex.Message };
        }
        finally { isLoading = false; }
    }

    private void OnNewMemberChanged(string value)
    {
        newMember = value;
        // gmn-3: a typed value was never selected from the dropdown and has no DN. Clear the
        // held selection on every keystroke - a stale DN surviving a retype would write to
        // whatever was picked before. Typed input goes through the service's exact class-aware
        // resolver with its exactly-one refusal instead.
        newMemberSelection = null;
    }

    // Runs AFTER the control's ValueChanged (which clears the selection above), so a real
    // dropdown pick ends with both the visible text and the held result set.
    private void OnNewMemberSelected(ExchangeAdminWeb.Services.ADSearchResult result)
    {
        newMemberSelection = result;
    }

    private async Task AddMember()
    {
        // gmn-7: snapshot everything this handler acts on BEFORE the first await. Group
        // navigation stays live while awaits run, so the write must use the group and member
        // the operation was initiated with, never whatever the page points at afterwards.
        var group = selectedGroup;
        var memberLabel = newMember.Trim();
        var selection = newMemberSelection;
        if (group is null || string.IsNullOrWhiteSpace(memberLabel))
            return;

        isLoading = true;
        opResult = null;
        await Task.Yield();
        try
        {
            var ticket = ticketNumber.Trim();
            var ticketValidation = await ServiceNow.ValidateTicketAsync(ticket);
            if (!ticketValidation.IsValid)
            {
                opResult = PermissionResult.Fail($"Ticket validation failed: {ticketValidation.Message}");
                try { Audit.LogModuleAction(currentUser, clientIpAddress, "GroupManagement_AddMember", "GroupManagement", group.Name, false, ticket, $"Ticket validation failed: {ticketValidation.Message}", new Dictionary<string, object?> { ["member"] = memberLabel, ["memberDn"] = selection?.DistinguishedName }); } catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for GroupManagement_AddMember ticket denial"); }
                return;
            }

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authCheck = await AuthorizationService.AuthorizeAsync(authState.User, "GroupManagementOnPrem");
            if (!authCheck.Succeeded)
            {
                opResult = PermissionResult.Fail("Authorization denied.");
                try { Audit.LogModuleAction(currentUser, clientIpAddress, "GroupManagement_AddMember", "GroupManagement", group.Name, false, ticket, "Authorization denied", new Dictionary<string, object?> { ["member"] = memberLabel, ["memberDn"] = selection?.DistinguishedName }); } catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for GroupManagement_AddMember auth denial"); }
                return;
            }

            // Protected-principal enforcement lives in GroupManagementService.AddMemberAsync
            // (CheckProtectedAsync plus the unconditional resolved-principal gate, gmn-6): it
            // fails closed on Unavailable/Ambiguous resolution and covers non-'@' identities
            // the old page gate missed. The page no longer pre-checks - that duplicated gate
            // produced unaudited failed mutation attempts (2026-06-17 review). The single
            // audited path below records every denial.
            opResult = await GroupService.AddMemberAsync(group.Identity, memberLabel, authState.User, group.SamAccountName, selection?.DistinguishedName);

            // gmn-9: the immutable identity (the DN actually written, when one was selected)
            // travels in EVERY audit branch - two same-named objects from different domains
            // must produce distinguishable records.
            var addExtra = new Dictionary<string, object?> { ["member"] = memberLabel, ["memberDn"] = selection?.DistinguishedName };
            // A serviced override succeeded, so it cannot ride errorDetail - that field is
            // written as null on success and the record of who permitted it would vanish.
            if (!string.IsNullOrWhiteSpace(opResult.ServicedNote))
                addExtra[ProtectedPrincipalServicing.AuditKey] = opResult.ServicedNote;

            try { Audit.LogModuleAction(currentUser, clientIpAddress, "GroupManagement_AddMember", "GroupManagement", group.Name, opResult.Success, ticket, opResult.Success ? null : opResult.Message, addExtra); } catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for GroupManagement_AddMember"); }
            try { await Email.SendAdminNotificationAsync(currentUser, clientIpAddress, "GroupManagement_AddMember", opResult.Success, ticket, new Dictionary<string, string> { ["Group"] = group.Name, ["Member Added"] = memberLabel }, opResult.Success ? null : opResult.Message); } catch { }

            if (opResult.Success)
            {
                newMember = "";
                newMemberSelection = null;
                // Refresh only when the operator is still looking at the group we wrote to.
                if (ReferenceEquals(selectedGroup, group))
                    memberList = await GroupService.GetMembersAsync(group.Identity, authState.User, group.SamAccountName);
            }
        }
        catch (Exception ex)
        {
            opResult = PermissionResult.Fail(ex.Message);
            try { Audit.LogModuleAction(currentUser, clientIpAddress, "GroupManagement_AddMember", "GroupManagement", group.Name, false, ticketNumber.Trim(), ex.Message, new Dictionary<string, object?> { ["member"] = memberLabel, ["memberDn"] = selection?.DistinguishedName }); } catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for GroupManagement_AddMember"); }
            try { await Email.SendAdminNotificationAsync(currentUser, clientIpAddress, "GroupManagement_AddMember", false, ticketNumber.Trim(), new Dictionary<string, string> { ["Group"] = group.Name, ["Member"] = memberLabel }, ex.Message); } catch { }
        }
        finally { isLoading = false; }
    }

    private async Task RemoveMember(GroupMemberInfo listed)
    {
        // Key the removal on the immutable objectGUID (nesting plan S5b): a listed GROUP has an
        // empty Email, and a display identity can drift between the list render and the write.
        var member = string.IsNullOrWhiteSpace(listed.Email) ? listed.DisplayName : listed.Email;
        // gmn-7: snapshot the group BEFORE the first await - group navigation stays live while
        // awaits run, and the removal must execute against the group whose list showed the row.
        var group = selectedGroup;
        if (group is null)
            return;

        isLoading = true;
        opResult = null;
        await Task.Yield();
        try
        {
            var ticket = ticketNumber.Trim();
            var ticketValidation = await ServiceNow.ValidateTicketAsync(ticket);
            if (!ticketValidation.IsValid)
            {
                opResult = PermissionResult.Fail($"Ticket validation failed: {ticketValidation.Message}");
                try { Audit.LogModuleAction(currentUser, clientIpAddress, "GroupManagement_RemoveMember", "GroupManagement", group.Name, false, ticket, $"Ticket validation failed: {ticketValidation.Message}", new Dictionary<string, object?> { ["member"] = member, ["memberObjectGuid"] = listed.ObjectGuid, ["memberDn"] = listed.DistinguishedName }); } catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for GroupManagement_RemoveMember ticket denial"); }
                return;
            }

            // The per-member path - authorization re-check, protection-gated service write,
            // audit and admin email - is RemoveOneAsync, shared byte-for-byte with the bulk loop
            // (docs/GroupBulkActions-Plan.md S2, AC3). It never throws.
            var outcome = await RemoveOneAsync(group, listed, ticket, sendAdminEmail: true);
            opResult = outcome.Done ? PermissionResult.Ok(outcome.Message) : PermissionResult.Fail(outcome.Message);

            // Refresh only when the operator is still looking at the group we wrote to.
            if (outcome.Done && ReferenceEquals(selectedGroup, group))
                memberList = await GroupService.GetMembersAsync(group.Identity, (await AuthStateProvider.GetAuthenticationStateAsync()).User, group.SamAccountName);
        }
        catch (Exception ex)
        {
            // Only the ticket validation and the refresh can reach here; RemoveOneAsync audits
            // its own failures.
            opResult = PermissionResult.Fail(ex.Message);
        }
        finally { isLoading = false; }
    }

    /// <summary>
    /// The per-member remove: the ONE place the single Remove button and the bulk loop both
    /// go through (docs/GroupBulkActions-Plan.md S2, AC3). Runs the module authorization
    /// re-check immediately before THIS row's write (gba-1; Constitution: every mutating
    /// operation re-checks authorization immediately before the write - a batch must not
    /// carry a stale page-level answer across rows), then the protection-gated service call,
    /// then the per-member audit on every branch, then the per-member admin email when asked
    /// (the bulk loop sends one summary instead, plan D1). Never throws: an exception is a
    /// Not done row, audited.
    /// </summary>
    private async Task<BulkRowOutcome> RemoveOneAsync(GroupInfo group, GroupMemberInfo listed, string ticket, bool sendAdminEmail)
    {
        var member = string.IsNullOrWhiteSpace(listed.Email) ? listed.DisplayName : listed.Email;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authCheck = await AuthorizationService.AuthorizeAsync(authState.User, "GroupManagementOnPrem");
            if (!authCheck.Succeeded)
            {
                try { Audit.LogModuleAction(currentUser, clientIpAddress, "GroupManagement_RemoveMember", "GroupManagement", group.Name, false, ticket, "Authorization denied", new Dictionary<string, object?> { ["member"] = member, ["memberObjectGuid"] = listed.ObjectGuid, ["memberDn"] = listed.DistinguishedName }); } catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for GroupManagement_RemoveMember auth denial"); }
                return new BulkRowOutcome(listed.DisplayName, false, "Authorization denied.");
            }

            // Protected-principal enforcement lives in GroupManagementService.RemoveMemberAsync
            // (CheckProtectedAsync plus the unconditional resolved-principal gate, gmn-6); see
            // AddMember. The single audited path below records every denial.
            var result = await GroupService.RemoveMemberAsync(group.Identity, member, authState.User, group.SamAccountName, listed.ObjectGuid, listed.DistinguishedName);

            // gmn-9: GUID and DN travel in EVERY audit branch, not just this one.
            var removeExtra = new Dictionary<string, object?> { ["member"] = member, ["memberObjectGuid"] = listed.ObjectGuid, ["memberDn"] = listed.DistinguishedName };
            // See AddMember: a serviced override succeeds, so the note must travel in extra.
            if (!string.IsNullOrWhiteSpace(result.ServicedNote))
                removeExtra[ProtectedPrincipalServicing.AuditKey] = result.ServicedNote;

            try { Audit.LogModuleAction(currentUser, clientIpAddress, "GroupManagement_RemoveMember", "GroupManagement", group.Name, result.Success, ticket, result.Success ? null : result.Message, removeExtra); } catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for GroupManagement_RemoveMember"); }
            if (sendAdminEmail)
            {
                try { await Email.SendAdminNotificationAsync(currentUser, clientIpAddress, "GroupManagement_RemoveMember", result.Success, ticket, new Dictionary<string, string> { ["Group"] = group.Name, ["Member Removed"] = member }, result.Success ? null : result.Message); } catch { }
            }

            return new BulkRowOutcome(listed.DisplayName, result.Success, result.Message);
        }
        catch (Exception ex)
        {
            try { Audit.LogModuleAction(currentUser, clientIpAddress, "GroupManagement_RemoveMember", "GroupManagement", group.Name, false, ticket, ex.Message, new Dictionary<string, object?> { ["member"] = member, ["memberObjectGuid"] = listed.ObjectGuid, ["memberDn"] = listed.DistinguishedName }); } catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for GroupManagement_RemoveMember"); }
            if (sendAdminEmail)
            {
                try { await Email.SendAdminNotificationAsync(currentUser, clientIpAddress, "GroupManagement_RemoveMember", false, ticket, new Dictionary<string, string> { ["Group"] = group.Name, ["Member"] = member }, ex.Message); } catch { }
            }
            return new BulkRowOutcome(listed.DisplayName, false, ex.Message);
        }
    }

    // ----- Bulk remove (docs/GroupBulkActions-Plan.md S2) -----

    /// <summary>Same predicate as the single Remove button's enablement: only a resolved, non-primary row can be acted on.</summary>
    private static bool CanRemove(GroupMemberInfo m) => !string.IsNullOrEmpty(m.ObjectGuid) && !m.IsPrimaryMember;

    private static string? RemoveDisabledReason(GroupMemberInfo m)
        => m.IsPrimaryMember ? "This is the member's primary group; primary-group membership cannot be removed here."
         : string.IsNullOrEmpty(m.ObjectGuid) ? "This member could not be resolved in its own domain, so it cannot be removed here."
         : null;

    private List<GroupMemberInfo> SelectableMembers() => memberList?.Members.Where(CanRemove).ToList() ?? new();

    private List<GroupMemberInfo> SelectedMembers() => SelectableMembers().Where(m => selectedGuids.Contains(m.ObjectGuid)).ToList();

    private int SelectedCount => SelectedMembers().Count;

    private bool AllSelectableSelected
    {
        get
        {
            var selectable = SelectableMembers();
            return selectable.Count > 0 && selectable.All(m => selectedGuids.Contains(m.ObjectGuid));
        }
    }

    private void ToggleSelected(GroupMemberInfo m, bool on)
    {
        showRemoveConfirm = false;
        if (!CanRemove(m))
            return;
        if (on) selectedGuids.Add(m.ObjectGuid); else selectedGuids.Remove(m.ObjectGuid);
    }

    // Select-all covers only the rows the single Remove could act on (AC1).
    private void ToggleSelectAll(bool on)
    {
        showRemoveConfirm = false;
        selectedGuids.Clear();
        if (on)
            foreach (var m in SelectableMembers())
                selectedGuids.Add(m.ObjectGuid);
    }

    private void ClearBulkState()
    {
        selectedGuids.Clear();
        showRemoveConfirm = false;
        bulkOutcome = null;
    }

    private void AuditBatch(string action, GroupInfo group, string ticket, bool success, string? errorDetail, int requested, int done, int notDone, IReadOnlyList<string> memberLines)
    {
        try { Audit.LogModuleAction(currentUser, clientIpAddress, action, "GroupManagement", group.Name, success, ticket, errorDetail, new Dictionary<string, object?> { ["requested"] = requested, ["done"] = done, ["notDone"] = notDone, ["members"] = memberLines }); } catch (Exception auditEx) { Logger.LogError(auditEx, "Audit failed for {Action}", action); }
    }

    /// <summary>
    /// Removes every ticked member, one at a time, in list order, through RemoveOneAsync -
    /// the same handler as the single Remove button - so per-row authorization, protection,
    /// write, read-back and audit are the single path's, and one refusal never hides another.
    /// After the loop: one batch summary audit whose success is true ONLY when every row is
    /// Done (Known Failure Class 2), one summary admin email (plan D1), one member-list
    /// refresh. The ticket is validated once for the batch; the upfront authorization check
    /// is a UX shortcut - the check that counts runs inside RemoveOneAsync per row (gba-1).
    /// </summary>
    private async Task RemoveSelectedAsync()
    {
        // gmn-7: snapshot the group AND the rows before the first await.
        var group = selectedGroup;
        var rows = SelectedMembers();
        showRemoveConfirm = false;
        if (group is null || rows.Count == 0)
            return;

        isLoading = true;
        opResult = null;
        bulkOutcome = null;
        await Task.Yield();

        const string action = "GroupManagement_BulkRemoveMembers";
        var ticket = ticketNumber.Trim();
        var notAttempted = rows.Select(r => $"{r.DisplayName}: Not attempted").ToList();
        try
        {
            var ticketValidation = await ServiceNow.ValidateTicketAsync(ticket);
            if (!ticketValidation.IsValid)
            {
                opResult = PermissionResult.Fail($"Ticket validation failed: {ticketValidation.Message}");
                AuditBatch(action, group, ticket, false, $"Ticket validation failed: {ticketValidation.Message}", rows.Count, 0, 0, notAttempted);
                return;
            }

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authCheck = await AuthorizationService.AuthorizeAsync(authState.User, "GroupManagementOnPrem");
            if (!authCheck.Succeeded)
            {
                opResult = PermissionResult.Fail("Authorization denied.");
                AuditBatch(action, group, ticket, false, "Authorization denied", rows.Count, 0, 0, notAttempted);
                return;
            }

            var outcomes = new List<BulkRowOutcome>(rows.Count);
            foreach (var row in rows)
                outcomes.Add(await RemoveOneAsync(group, row, ticket, sendAdminEmail: false));

            var summary = BulkOutcomeSummary.Of(outcomes);
            AuditBatch(action, group, ticket, summary.Success, summary.ErrorDetail, summary.Requested, summary.Done, summary.NotDone, summary.MemberLines);
            try { await Email.SendAdminNotificationAsync(currentUser, clientIpAddress, action, summary.Success, ticket, new Dictionary<string, string> { ["Group"] = group.Name, ["Requested"] = summary.Requested.ToString(), ["Done"] = summary.Done.ToString(), ["Not done"] = summary.NotDone.ToString(), ["Members"] = string.Join("; ", summary.MemberLines) }, summary.ErrorDetail); } catch (Exception emailEx) { Logger.LogError(emailEx, "Admin notification failed for {Action}", action); }

            selectedGuids.Clear();
            bulkOutcome = outcomes;
            bulkOutcomeTitle = $"Remove selected: {summary.Done} of {summary.Requested} removed";
            opResult = summary.Success
                ? PermissionResult.Ok($"{summary.Done} member(s) removed from {group.Name}.")
                : PermissionResult.Fail($"{summary.NotDone} of {summary.Requested} member(s) were not removed - see the outcome table.");

            // One refresh for the whole batch, only if the operator is still looking at this group.
            if (ReferenceEquals(selectedGroup, group))
            {
                try { memberList = await GroupService.GetMembersAsync(group.Identity, authState.User, group.SamAccountName); }
                catch (Exception ex) { memberList = new GroupMemberList { GroupName = group.Name, Error = ex.Message }; }
            }
        }
        finally { isLoading = false; }
    }
}

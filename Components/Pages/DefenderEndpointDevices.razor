@page "/defender-endpoint-devices"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "DefenderEndpointDevices")]
@rendermode InteractiveServer
@inject DefenderEndpointDeviceService DeviceService
@inject AuditService Audit
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager Navigation
@inject ClientInfoService ClientInfo
@inject ILogger<DefenderEndpointDevices> Logger
@inject IJSRuntime JS

<PageTitle>Defender for Endpoint Devices</PageTitle>

@if (!authChecked)
{
    @* NO SPINNER. No module draws its own progress (owner ruling 2026-10-02,
       `.agents/decisions.md`), and nothing replaces this one: GroupAuthorizationHandler is
       synchronous end to end, so the check finishes faster than a frame and a bar line
       flickering inside a single render is noise, not information.
       The GUARD stays and must stay - it is what stops the page rendering before the check
       has passed, which is refusal, not progress. Kept at the SAME LINE COUNT as the markup
       it replaces, so not one ClickGateRegistry line key moves. *@
    return;
}

<div class="container-fluid">
    @* One line. What the module can do to Defender, how counts compare with the portal widget and
       why a refusal refuses are all in docs/DefenderEndpointDevices.md, which is where someone
       looking for them will look - not on screen on every load. *@
    <div class="alert alert-info py-2 mb-3">
        <small>Read-only. Every load and every export is written to the audit log.</small>
    </div>
    <h1 class="mb-4">Defender for Endpoint Devices<ModuleVersion /></h1>

    @* The unconfigured gate returns, so every control below it is unreachable while the Secret ID
       is unset. That is deliberate and is the reason this block sits above the filter card rather
       than beside the results: with no credential there must be no button that could start a call.
       DefenderEndpointDeviceService.ListDevicesAsync THROWS on an unset Secret ID rather than
       returning an empty result, so an ungated control here would render a stack-trace message as
       the answer. Opening the page never starts an inventory read. *@
    @if (!DeviceService.IsAvailable)
    {
        <div class="alert alert-danger">
            Defender for Endpoint Devices is not configured. Set Graph App Delinea Secret ID in
            Module Config.
        </div>
        return;
    }

    @* The form is grouped by the QUESTION the operator is asking, not by which API field each
       control maps to. Three groups, in the order someone actually narrows a search: what kind
       of machine, which machine, and when it was last around.

       Every control behaves identically - nothing happens until Search is pressed. That is why
       the "(after fetch)" labels and the paragraph explaining them are gone. The page used to
       have three behaviours in one grid - sent to Defender, applied here on load, applied live
       while typing - with prose at the bottom trying to explain the difference, so an empty
       result could mean "nothing matched" or "you did not press the button again". *@
    <div class="card mb-3">
        <div class="card-header py-2">
            <strong>Find devices</strong>
            <span class="text-muted ms-2"><small>Set what you are looking for, then Search.</small></span>
        </div>
        <div class="card-body">

            <div class="fw-semibold small text-uppercase text-muted mb-2">What kind of device</div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="onboardingStatus">Onboarding status</label>
                    @* The API literals, NOT the portal labels: the portal shows "Can be onboarded"
                       and the REST value is CanBeOnboarded, and sending the portal spelling matches
                       nothing. The option text is the portal's wording so an operator recognises it;
                       the value is what reaches the filter. *@
                    <select id="onboardingStatus"
                            class="form-select"
                            @bind="form.OnboardingStatus"
                            disabled="@IsBusy">
                        <option value="">Any</option>
                        <option value="@DefenderDeviceFilters.CanBeOnboarded">Can be onboarded</option>
                        <option value="onboarded">Onboarded</option>
                        <option value="Unsupported">Unsupported</option>
                        <option value="InsufficientInfo">Insufficient info</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="platform">Operating system</label>
                    <select id="platform"
                            class="form-select"
                            @bind="form.Platform"
                            disabled="@IsBusy">
                        <option value="">Any</option>
                        <option value="@AnyWindows">Any Windows</option>
                        @foreach (var platform in PlatformValues)
                        {
                            <option value="@platform">@platform</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="healthStatus">Health</label>
                    <select id="healthStatus"
                            class="form-select"
                            @bind="form.HealthStatus"
                            disabled="@IsBusy">
                        <option value="">Any</option>
                        @foreach (var health in HealthStatusValues)
                        {
                            <option value="@health">@health</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="riskScore">Risk level</label>
                    <select id="riskScore"
                            class="form-select"
                            @bind="form.RiskScore"
                            disabled="@IsBusy">
                        <option value="">Any</option>
                        @foreach (var risk in RiskScoreValues)
                        {
                            <option value="@risk">@risk</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="exposureLevel">Exposure level</label>
                    <select id="exposureLevel"
                            class="form-select"
                            @bind="form.ExposureLevel"
                            disabled="@IsBusy">
                        <option value="">Any</option>
                        @foreach (var exposure in ExposureLevelValues)
                        {
                            <option value="@exposure">@exposure</option>
                        }
                    </select>
                </div>
            </div>

            <hr class="my-4" />

            <div class="fw-semibold small text-uppercase text-muted mb-2">Which device, or where it is</div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="deviceName">Device name starts with</label>
                    <input id="deviceName"
                           class="form-control"
                           @bind="form.DeviceNameStartsWith"
                           disabled="@IsBusy"
                           placeholder="LONDON-" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="seenBy">Seen by this machine</label>
                    <input id="seenBy"
                           class="form-control"
                           @bind="form.SeenBy"
                           disabled="@IsBusy"
                           placeholder="Name of a machine that saw it" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="site">Site</label>
                    <input id="site"
                           class="form-control"
                           @bind="form.Site"
                           disabled="@IsBusy"
                           placeholder="Any part of the site name" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="machineGroup">Machine group</label>
                    <input id="machineGroup"
                           class="form-control"
                           @bind="form.MachineGroup"
                           disabled="@IsBusy"
                           placeholder="Any part of the group name" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="machineTag">Machine tag</label>
                    <input id="machineTag"
                           class="form-control"
                           @bind="form.MachineTag"
                           disabled="@IsBusy"
                           placeholder="Any part of a tag" />
                </div>
            </div>

            <hr class="my-4" />

            <div class="fw-semibold small text-uppercase text-muted mb-2">When it was seen</div>
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label" for="lastSeenFrom">Last seen on or after</label>
                    <input id="lastSeenFrom"
                           type="date"
                           class="form-control"
                           @bind="form.LastSeenFrom"
                           disabled="@IsBusy" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="lastSeenTo">Last seen before</label>
                    <input id="lastSeenTo"
                           type="date"
                           class="form-control"
                           @bind="form.LastSeenTo"
                           disabled="@IsBusy" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="firstSeenFrom">First seen on or after</label>
                    <input id="firstSeenFrom"
                           type="date"
                           class="form-control"
                           @bind="form.FirstSeenFrom"
                           disabled="@IsBusy" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="firstSeenTo">First seen before</label>
                    <input id="firstSeenTo"
                           type="date"
                           class="form-control"
                           @bind="form.FirstSeenTo"
                           disabled="@IsBusy" />
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <button class="btn btn-outline-secondary" @onclick="ClearFilters" disabled="@IsBusy">Clear</button>
                <button class="btn btn-primary" @onclick="LoadAsync" disabled="@IsBusy">
                    @* No spinner: the device list reports to the status frame. Two
                       reporters on screen disagreed with each other, which is the defect
                       this replaced rather than a tidy-up. *@

                    Search
                </button>
            </div>
        </div>
    </div>

    @if (csvExportError != null)
    {
        <div class="alert alert-danger" role="alert">@csvExportError</div>
    }

    @* Branch order is load-bearing. A failed read must never fall through to the empty-table
       branch, and a refusal must never fall through to the table branch: a refusal carries zero
       devices by construction, so rendering it as a table would show an empty list as the answer to
       a question that was never answered. *@
    @if (loadError != null)
    {
        <div class="alert alert-danger">
            <strong>Could not read the device inventory.</strong>
            <div class="mt-1"><small>@loadError</small></div>
        </div>
    }
    else if (result == null)
    {
        @* The status frame owns in-flight progress; this notice is the ready form before Search. *@
        @if (!isLoading)
        {
            <div class="alert alert-secondary">
                <strong>No search has been run.</strong>
                Set the filters you want, then Search.
            </div>
        }
    }
    else if (result.Outcome != DefenderDeviceListOutcome.Complete)
    {
        <div class="alert alert-danger">
            <strong>No device list.</strong>
            <div class="mt-1">@result.RefusalReason</div>
        </div>
    }
    else
    {
        @* Above the table and covering all five columns. An empty cell must never be how an
           operator learns that half the report did not execute (Known Failure Class 2), and a
           warning underneath a long table is read after the columns it explains, if at all. There
           is deliberately only one of these on the page. The Count guard is not cosmetic: with no
           rows the warning would name columns that are not on screen, so a run that matched nothing
           says so in the header and says nothing else. *@
        @* Two banners, not one with a conditional word in it. A whole-run failure and a partly
           failed run need the operator to do different things - re-read the report, versus re-run
           it and compare - and "every device" is simply false on a partial run, which is the
           sentence that would quietly appear if the states shared a template. *@
        @if (result.Devices.Count > 0 && result.DiscoveryEnrichment == DefenderDiscoveryEnrichmentState.PartiallySucceeded)
        {
            <div class="alert alert-warning py-2">
                <small>
                    <strong>
                        Extra details are missing for some devices
                        (@result.DiscoveryFailedBatches failed, @result.DiscoveryUnattemptedBatches not attempted
                        out of @result.DiscoveryTotalBatches posture lookups).
                        Those rows show "@DefenderEndpointDeviceService.EnrichmentUnavailable".
                    </strong>
                    @result.DiscoveryEnrichmentReason
                </small>
            </div>
        }
        else if (result.Devices.Count > 0 && result.DiscoveryEnrichment != DefenderDiscoveryEnrichmentState.Succeeded)
        {
            <div class="alert alert-warning py-2">
                <small>
                    <strong>
                        Extra details could not be loaded. Discovery sources, device type,
                        category, vendor, model and seen-by read
                        "@DefenderEndpointDeviceService.EnrichmentUnavailable" for every device.
                    </strong>
                    @result.DiscoveryEnrichmentReason
                </small>
            </div>
        }

        @if (result.Devices.Count > 0 && !result.SiteMapRead)
        {
            <div class="alert alert-warning py-2">
                <small>
                    <strong>Site details could not be completed for every device.</strong>
                    Unevaluated Site cells show "@DefenderEndpointDeviceService.EnrichmentUnavailable".
                    Completed Site details and the rest of the report are retained.
                </small>
            </div>
        }

        @* An observer lookup can fail while every posture batch succeeded - it is a separate
           request. The run is then SUCCEEDED, so none of the banners above fire, and the cells
           read "(unavailable)" with nothing saying why. Found at review: the failure count was
           being tracked and then never used. *@
        @if (result.Devices.Count > 0 && (result.ObserverFailedBatches > 0 || result.ObserverUnattemptedBatches > 0))
        {
            <div class="alert alert-warning py-2">
                <small>
                    <strong>
                        The observing machine could not be looked up for some devices
                        (@result.ObserverFailedBatches failed, @result.ObserverUnattemptedBatches not attempted
                        out of @result.DiscoveryTotalBatches observer lookups).
                    </strong>
                    Those rows show "@DefenderEndpointDeviceService.EnrichmentUnavailable" for
                    Recently seen by. Completed posture details are retained.
                    @result.ObserverEnrichmentReason
                </small>
            </div>
        }

        @if (result.Devices.Count > 0 && !string.IsNullOrEmpty(result.EnrichmentStopReason))
        {
            <div class="alert alert-warning py-2"><small>@result.EnrichmentStopReason</small></div>
        }

        @* A whole column that is empty for every row, on a run that reported success, is the
           failure mode that shipped: the observer column was blank for all 26,812 devices and
           nothing on the page said so, because the query succeeded and the join simply matched
           nothing. The page cannot tell "nothing observed these devices" from "we asked for the
           wrong thing" - nothing can, without the schema - but it can refuse to stay quiet.
           Shown only on a succeeded run: on a failed or partial one the banners above already
           explain the blanks, and two explanations of one thing is worse than none. *@
        @if (result.Devices.Count > 0
             && result.DiscoveryEnrichment == DefenderDiscoveryEnrichmentState.Succeeded
             && result.Devices.All(d => string.IsNullOrEmpty(d.RecentlySeenBy)))
        {
            <div class="alert alert-warning py-2">
                <small>
                    <strong>No observing machine was reported for any of these devices.</strong>
                    Either nothing has seen them, or this tenant names that data differently than
                    the report expects.
                </small>
            </div>
        }

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                @* Counts the FILTERED set, which is what is on screen. Showing the unfiltered
                   total beside a narrowed table was the page saying two things at once. *@
                <div>
                    @if (FilteredDevices.Count == 0)
                    {
                        <strong>No devices matched.</strong>
                        <span class="text-muted ms-2"><small>Change a filter above and Search again.</small></span>
                    }
                    else
                    {
                        <strong>@FilteredDevices.Count device(s)</strong>
                        @if (DevicePageCount > 1)
                        {
                            <span class="text-muted ms-2"><small>Showing @((devicePageIndex * DevicePageSize) + 1)-@Math.Min((devicePageIndex + 1) * DevicePageSize, FilteredDevices.Count).</small></span>
                        }
                    }
                    <span class="text-muted ms-2">
                        <small>
                            @result.DistinctCount fetched in @result.PagesFetched request(s). Ceiling @result.Ceiling.
                        </small>
                    </span>
                </div>
                @* The export button lives INSIDE the complete branch and nowhere else, which is the
                   whole of how the page keeps the promise the result type makes. A refusal carries
                   zero devices by construction, so a button rendered above this branch would offer
                   a header-only file as the answer to a question that was never answered - and a
                   CSV leaves the app, where the refusal banner that would have explained it does
                   not travel with it. The Count clause is a precondition, not a busy condition: it
                   is OR-ed in front of the predicate and must never be replaced by it. *@
                <button class="btn btn-outline-secondary btn-sm" @onclick="DownloadCsvAsync" disabled="@(IsBusy || ExportableDevices.Count == 0)">Download CSV</button>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Device name</th>
                            <th>OS</th>
                            <th>Onboarding status</th>
                            <th>Health</th>
                            <th>Risk</th>
                            <th>Exposure</th>
                            <th>Site</th>
                            <th>Machine group</th>
                            <th>Last seen</th>
                            <th>Discovery sources</th>
                            <th>Recently seen by</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var device in PagedDevices)
                        {
                            <tr>
                                <td>@Display(device.ComputerDnsName)</td>
                                <td>@device.OsPlatform @device.OsVersion</td>
                                <td>@Display(device.OnboardingStatus)</td>
                                <td>@Display(device.HealthStatus)</td>
                                <td>@Display(device.RiskScore)</td>
                                <td>@Display(device.ExposureLevel)</td>
                                <td>@Display(device.Site)</td>
                                <td>@Display(device.MachineGroup)</td>
                                <td class="text-nowrap">@FormatTime(device.LastSeen)</td>
                                <td>@EnrichmentCell(device.DiscoverySources)</td>
                                <td>@EnrichmentCell(device.RecentlySeenBy)</td>
                                <td>
                                    @* Renders the row the LIST already returned. It never calls
                                       get-machine-by-id: Learn documents only Machine.ReadWrite.All
                                       for that endpoint, and this module's registration must never
                                       hold a write scope. *@
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => ToggleDetail(device.Id)" disabled="@IsBusy">
                                        @(expandedDevices.Contains(device.Id) ? "Hide detail" : "Detail")
                                    </button>
                                </td>
                            </tr>
                            @if (expandedDevices.Contains(device.Id))
                            {
                                <tr>
                                    <td colspan="12" class="bg-light">
                                        <dl class="row mb-0 small">
                                            <dt class="col-sm-3">Device id</dt><dd class="col-sm-9">@Display(device.Id)</dd>
                                            <dt class="col-sm-3">Fully qualified name</dt><dd class="col-sm-9">@Display(device.ComputerDnsName)</dd>
                                            <dt class="col-sm-3">DNS domain (derived)</dt><dd class="col-sm-9">@Display(device.DnsDomain)</dd>
                                            <dt class="col-sm-3">OS build / architecture</dt><dd class="col-sm-9">@Display(device.OsBuild) / @Display(device.OsArchitecture)</dd>
                                            <dt class="col-sm-3">Last IP</dt><dd class="col-sm-9">@Display(device.LastIpAddress)</dd>
                                            <dt class="col-sm-3">Last external IP</dt><dd class="col-sm-9">@Display(device.LastExternalIpAddress)</dd>
                                            <dt class="col-sm-3">IP addresses</dt><dd class="col-sm-9">@Display(IpList(device))</dd>
                                            <dt class="col-sm-3">MAC addresses</dt><dd class="col-sm-9">@Display(MacList(device))</dd>
                                            <dt class="col-sm-3">First seen</dt><dd class="col-sm-9">@FormatTime(device.FirstSeen)</dd>
                                            <dt class="col-sm-3">Device value</dt><dd class="col-sm-9">@Display(device.DeviceValue)</dd>
                                            <dt class="col-sm-3">Machine tags</dt><dd class="col-sm-9">@Display(string.Join("; ", device.MachineTags))</dd>
                                            <dt class="col-sm-3">Entra ID joined</dt><dd class="col-sm-9">@(device.IsAadJoined ? "Yes" : "No")</dd>
                                            <dt class="col-sm-3">Entra ID device id</dt><dd class="col-sm-9">@Display(device.AadDeviceId)</dd>
                                            <dt class="col-sm-3">Device type</dt><dd class="col-sm-9">@EnrichmentCell(device.DeviceType)</dd>
                                            <dt class="col-sm-3">Device category</dt><dd class="col-sm-9">@EnrichmentCell(device.DeviceCategory)</dd>
                                            <dt class="col-sm-3">Vendor</dt><dd class="col-sm-9">@EnrichmentCell(device.Vendor)</dd>
                                            <dt class="col-sm-3">Model</dt><dd class="col-sm-9">@EnrichmentCell(device.Model)</dd>
                                        </dl>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            @if (DevicePageCount > 1)
            {
                <div class="card-footer d-flex justify-content-between align-items-center">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => GoToDevicePage(devicePageIndex - 1)" disabled="@(IsBusy || devicePageIndex == 0)">Previous</button>
                    <span class="small text-muted">Page @(devicePageIndex + 1) of @DevicePageCount</span>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => GoToDevicePage(devicePageIndex + 1)" disabled="@(IsBusy || devicePageIndex >= DevicePageCount - 1)">Next</button>
                </div>
            }
        </div>
    }
</div>

@code {
    // [Inject] rather than an @inject directive: this page is click-gate converted and every
    // registry entry is keyed by LINE NUMBER. A directive at the top shifts every registered
    // control down one; a property here sits below all of them and moves nothing.
    [Inject] private IActivityProgress Progress { get; set; } = default!;

    private bool authChecked;

    /// <summary>
    /// The inventory load's in-flight flag, a member of <see cref="IsBusy"/>. Raised in
    /// LoadAsync alone, immediately above the try whose finally lowers it again - deliberately NOT
    /// in OnInitializedAsync, where there is no try to protect it and a raise would be the
    /// stuck-flag shape that deadens every control on the page.
    /// </summary>
    private bool isLoading;

    /// <summary>
    /// In flight for the whole of one CSV export, and a member of <see cref="IsBusy"/> for the same
    /// reason isLoading is: a load landing while the file is being served would replace the rows
    /// under the audit record. Raised BELOW DownloadCsvAsync's empty-set return - see the comment
    /// there - because an empty export should start no work.
    /// </summary>
    private bool isDownloadingCsv;

    private string currentUser = "";
    private string clientIpAddress = "Unknown";
    private string? loadError;
    private string? csvExportError;
    private DefenderDeviceListResult? result;
    private FilterAuditSnapshot? appliedFilterAudit;

    /// <summary>
    /// Every operator-writable filter control, in one object.
    /// </summary>
    /// <remarks>
    /// One field rather than twelve, and that is a gating decision rather than a tidiness one.
    /// LoadAsync must not read any of these back after its first await - the browser's copy of a
    /// disabled attribute is one round trip stale, so a value changed in that window would let the
    /// audit record name one filter set while the service was asked for another. With twelve fields
    /// that is twelve obligations to register and twelve chances to miss one; with one field it is
    /// a single capture, <c>var filters = form.ToFilters()</c>, above the first await, and any read
    /// of any control after it fails the suite.
    /// </remarks>
    private readonly FilterForm form = new();

    /// <summary>Device ids whose detail panel is open. Cleared on every load.</summary>
    private readonly HashSet<string> expandedDevices = [];

    /// <summary>
    /// The Platform dropdown's value for "any Windows". Not an osPlatform value and deliberately
    /// not one that could ever become one - it maps to the client-side prefix rule, while every
    /// other choice maps to a server-side <c>osPlatform eq</c>.
    /// </summary>
    private const string AnyWindows = "*Windows";

    /// <summary>
    /// The osPlatform values offered as exact, server-side choices.
    /// </summary>
    /// <remarks>
    /// A list rather than a discovered set, because the module never fetches the whole inventory to
    /// find out what platforms exist - that is the request this rebuild was done to avoid. An
    /// operator whose tenant has a value not listed here uses Any, or Any Windows, and filters the
    /// result; nothing is hidden by the list being short.
    /// </remarks>
    private static readonly string[] PlatformValues =
    [
        "Windows11", "Windows10", "Windows8.1", "Windows8", "Windows7",
        "WindowsServer2025", "WindowsServer2022", "WindowsServer2019", "WindowsServer2016",
        "WindowsServer2012R2", "WindowsServer2008R2",
        "Linux", "macOS", "iOS", "Android", "Other"
    ];

    /// <summary>The healthStatus enumeration from the machine resource.</summary>
    private static readonly string[] HealthStatusValues =
    [
        "Active", "Inactive", "ImpairedCommunication", "NoSensorData",
        "NoSensorDataImpairedCommunication", "Unknown"
    ];

    /// <summary>The riskScore enumeration from the machine resource.</summary>
    private static readonly string[] RiskScoreValues = ["None", "Informational", "Low", "Medium", "High"];

    /// <summary>The exposureLevel enumeration from the machine resource.</summary>
    private static readonly string[] ExposureLevelValues = ["None", "Low", "Medium", "High"];

    /// <summary>
    /// The page-wide busy predicate. Two flags, and the second one is here rather than gating its
    /// own button for the reason the ruling gives: a control left live during someone else's
    /// operation can be clicked, accepted, and then applied to state that has been replaced
    /// underneath it. A third long-running call adds its flag HERE too.
    /// </summary>
    private bool IsBusy => isLoading || isDownloadingCsv;

    /// <summary>
    /// The rows the export may write - the complete set, or nothing at all.
    /// </summary>
    /// <remarks>
    /// Re-derived from the OUTCOME rather than taken from <c>result.Devices</c>, although the result
    /// type already guarantees a refusal carries zero devices. The guarantee lives in a factory one
    /// file away; this expression is what makes "a refusal exports nothing" true at the point of
    /// use, and it is what the button's own Count clause reads, so the control that is offered and
    /// the rows that are written cannot come apart.
    /// </remarks>
    /// <remarks>
    /// <b>Follows the FILTER and never the PAGE.</b> Once a location filter exists, "the
    /// complete matching set" includes it - an export that ignored it would answer a different
    /// question than the screen, in a file that leaves the app with no banner to explain the
    /// difference. Paging is the opposite case and is deliberately NOT honoured here: it is a
    /// property of the viewport, not of the question.
    /// </remarks>
    private IReadOnlyList<DefenderDevice> ExportableDevices =>
        result is { Outcome: DefenderDeviceListOutcome.Complete } ? FilteredDevices : [];

    /// <summary>
    /// The "Seen by this machine" value that produced the report on screen.
    /// </summary>
    /// <remarks>
    /// <para>
    /// <b>Captured at Search, not read live from the form.</b> The observer name comes from the
    /// second lookup, which runs after the device list is in hand, so this one cannot be sent to
    /// Defender with the others - but it must still BEHAVE like the others, or the page is back
    /// to two kinds of filter with nothing on screen saying which is which. Snapshotting it
    /// beside the rest of the form is what makes "nothing happens until you press Search" true
    /// of every control rather than of most of them.
    /// </para>
    /// <para>
    /// Captured beside the filter snapshot, above the first await, for the reason
    /// ClickGateRegistry's PostAwaitLiveRead entry already gives: a value changed in the stale
    /// attribute window would desync what the audit names from what the operator sees. Published
    /// with its result, so an in-flight load cannot change the previous report's question.
    /// </para>
    /// </remarks>
    private string appliedSeenBy = "";

    /// <summary>The Site value that produced the report on screen. Captured at Search, as above.</summary>
    private string appliedSite = "";

    /// <summary>
    /// The loaded devices narrowed by the two filters that can only be applied after the
    /// device list is in hand - <see cref="appliedSite"/> and <see cref="appliedSeenBy"/>.
    /// </summary>
    /// <remarks>
    /// <para>
    /// <b>Site is the one an operator will actually reach for</b>, because it is the only
    /// location signal present for essentially every device: the owner's 26,812-row export had
    /// an IP address on 26,811 of them. Seen-by is partial by nature and sits beside it.
    /// </para>
    /// <para>
    /// <b>A device the filter cannot JUDGE is kept, whatever the filter says.</b> For seen-by
    /// that is a device whose enrichment batch failed - it carries "(unavailable)", not an
    /// observer name. Dropping it would hide exactly the machines someone is hunting while
    /// looking like a clean negative result.
    /// </para>
    /// <para>
    /// <b>Site has BOTH cases and they are different.</b> A BLANK site is a real answer - no
    /// subnet in the forest contains that address - so it is filtered out like any other
    /// non-match. An "(unavailable)" site is a device the filter cannot judge, because the
    /// directory read failed, and it is kept. Those two were conflated when the fail-fast rule
    /// changed: with every cell reading "(unavailable)", filtering by site matched nothing and
    /// showed "No devices matched" over a banner saying the site was unknown.
    /// </para>
    /// <para>
    /// Both are case-insensitive substrings, matching the Machine group and Machine tag
    /// controls beside them: an operator narrowing by location knows a fragment of a naming
    /// convention, not an exact string.
    /// </para>
    /// </remarks>
    private IReadOnlyList<DefenderDevice> FilteredDevices
    {
        get
        {
            if (result is null)
                return [];

            var site = appliedSite.Trim();
            var seenBy = appliedSeenBy.Trim();

            // Round 3, mde-6. A whole-run enrichment failure returns from ApplyEnrichment BEFORE
            // it stamps anything, so RecentlySeenBy is left BLANK rather than "(unavailable)" and
            // the marker the clause below escapes on never arrives. The filter then judged a
            // column that was never evaluated and excluded EVERY device - the same conflation
            // 111bfa2 fixed for Site, reached through the state that skips the stamping instead
            // of the one that performs it. Site does not need this: ApplySites stamps the marker
            // on its own failure path, and a blank site really is "no subnet matched".
            // ExportEnrichmentCell already draws exactly this line for the CSV.
            var seenByWasEvaluated =
                result.DiscoveryEnrichment is DefenderDiscoveryEnrichmentState.Succeeded
                    or DefenderDiscoveryEnrichmentState.PartiallySucceeded;

            if (site.Length == 0 && seenBy.Length == 0)
                return result.Devices;

            return result.Devices
                .Where(d =>
                    (site.Length == 0
                        || string.Equals(
                            d.Site,
                            DefenderEndpointDeviceService.EnrichmentUnavailable,
                            StringComparison.Ordinal)
                        || d.Site.Contains(site, StringComparison.OrdinalIgnoreCase))
                    && (seenBy.Length == 0
                        || !seenByWasEvaluated
                        || string.Equals(
                            d.RecentlySeenBy,
                            DefenderEndpointDeviceService.EnrichmentUnavailable,
                            StringComparison.Ordinal)
                        || d.RecentlySeenBy.Contains(seenBy, StringComparison.OrdinalIgnoreCase)))
                .ToList();
        }
    }

    /// <summary>Devices drawn into the table at once.</summary>
    /// <remarks>
    /// <para>
    /// <b>Why the table is paged at all.</b> The page rendered every device the tenant returned,
    /// and this tenant exceeds the old 20,000 ceiling, so the browser died and nothing could be
    /// scrolled - the module shipped unusable. The owner rejected virtualised scrolling outright
    /// ("not a solution in ANY way") and the shape he approved instead is portal-style: browse a
    /// filtered page at a time, and take the complete set as a CSV.
    /// </para>
    /// <para>
    /// <b>This bounds the DOM only. It does not bound the fetch, and it must not.</b>
    /// <see cref="ExportableDevices"/> still returns every device, because the export's promise
    /// is the COMPLETE matching set and a paged export would quietly answer a different
    /// question. Changing this constant changes how much is drawn and nothing else.
    /// </para>
    /// </remarks>
    private const int DevicePageSize = 50;

    /// <summary>
    /// Zero-based index of the table page on screen.
    /// </summary>
    /// <remarks>
    /// <b>Reset to zero on every load</b>, beside the result assignment. A new result is usually
    /// a different size, so an index left over from a wider search can sit past the end of a
    /// narrower one - which renders an empty table under a header saying there are devices, and
    /// reads as "the filter matched nothing".
    /// </remarks>
    private int devicePageIndex;

    /// <summary>Total table pages for the current result; at least one, so "1 of 1" is honest.</summary>
    private int DevicePageCount
    {
        get
        {
            var count = FilteredDevices.Count;
            return count == 0 ? 1 : (count + DevicePageSize - 1) / DevicePageSize;
        }
    }

    /// <summary>
    /// The devices on the current table page.
    /// </summary>
    /// <remarks>
    /// Clamps the index rather than trusting it. The reset on load is the real guarantee; this is
    /// the belt that keeps a future caller of <see cref="devicePageIndex"/> from rendering a blank
    /// table, which is the failure mode that looks like a wrong answer rather than a bug.
    /// </remarks>
    private IReadOnlyList<DefenderDevice> PagedDevices
    {
        get
        {
            var filtered = FilteredDevices;
            if (filtered.Count == 0)
                return [];

            var index = Math.Clamp(devicePageIndex, 0, DevicePageCount - 1);
            return filtered.Skip(index * DevicePageSize).Take(DevicePageSize).ToList();
        }
    }

    /// <summary>Moves the table one page and closes any open detail panels.</summary>
    /// <remarks>
    /// The detail panels are keyed by device id and the rows they belong to are leaving the DOM,
    /// so leaving them open would carry an expanded panel onto a page whose rows do not include
    /// it. Nothing here touches the fetched set.
    /// </remarks>
    private void GoToDevicePage(int index)
    {
        devicePageIndex = Math.Clamp(index, 0, DevicePageCount - 1);
        expandedDevices.Clear();
    }

    /// <summary>
    /// The filter controls as the service's filter record.
    /// </summary>
    /// <remarks>
    /// The Platform dropdown is the one control that does not map one-to-one: its
    /// <see cref="AnyWindows"/> value becomes the CLIENT-SIDE prefix rule and every other value
    /// becomes the SERVER-SIDE exact match, and exactly one of the two is ever set. That split is
    /// here, at the single point where the form becomes a request, rather than in the service where
    /// it would have to be guessed at from a string.
    /// </remarks>
    private sealed class FilterForm
    {
        public string DeviceNameStartsWith { get; set; } = "";
        public string OnboardingStatus { get; set; } = DefenderDeviceFilters.CanBeOnboarded;
        public string Platform { get; set; } = "";
        public string HealthStatus { get; set; } = "";
        public string RiskScore { get; set; } = "";
        public string ExposureLevel { get; set; } = "";
        public string SeenBy { get; set; } = "";
        public string Site { get; set; } = "";
        public string MachineGroup { get; set; } = "";
        public string MachineTag { get; set; } = "";
        public DateTime? LastSeenFrom { get; set; }
        public DateTime? LastSeenTo { get; set; }
        public DateTime? FirstSeenFrom { get; set; }
        public DateTime? FirstSeenTo { get; set; }

        public DefenderDeviceFilters ToFilters() => new()
        {
            OnboardingStatus = OnboardingStatus,
            OsPlatform = Platform == AnyWindows ? "" : Platform,
            OsPlatformPrefix = Platform == AnyWindows ? DefenderDeviceFilters.WindowsPlatformPrefix : "",
            HealthStatus = HealthStatus,
            RiskScore = RiskScore,
            ExposureLevel = ExposureLevel,
            DeviceNameStartsWith = DeviceNameStartsWith,
            MachineTag = MachineTag,
            MachineGroup = MachineGroup,
            LastSeenFrom = AsOffset(LastSeenFrom),
            LastSeenTo = AsOffset(LastSeenTo),
            FirstSeenFrom = AsOffset(FirstSeenFrom),
            FirstSeenTo = AsOffset(FirstSeenTo)
        };

        public void Clear()
        {
            DeviceNameStartsWith = "";
            OnboardingStatus = DefenderDeviceFilters.CanBeOnboarded;
            Platform = "";
            HealthStatus = "";
            RiskScore = "";
            ExposureLevel = "";
            SeenBy = "";
            Site = "";
            MachineGroup = "";
            MachineTag = "";
            LastSeenFrom = null;
            LastSeenTo = null;
            FirstSeenFrom = null;
            FirstSeenTo = null;
        }

        /// <summary>
        /// A date the operator typed, read as local midnight. The table shows local time, so a
        /// window typed here and a timestamp read off the screen mean the same thing; the service
        /// converts to UTC when it writes the OData literal.
        /// </summary>
        private static DateTimeOffset? AsOffset(DateTime? value) =>
            value.HasValue ? new DateTimeOffset(DateTime.SpecifyKind(value.Value.Date, DateTimeKind.Unspecified)) : null;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUser = user.Identity?.Name ?? "Unknown";

        var authResult = await AuthorizationService.AuthorizeAsync(user, "DefenderEndpointDevices");
        if (!authResult.Succeeded)
        {
            Navigation.NavigateTo("access-denied", forceLoad: true);
            return;
        }

        clientIpAddress = ClientInfo.IpAddress != "Unknown"
            ? ClientInfo.IpAddress
            : ClientInfo.GetIpForUser(currentUser);

        authChecked = true;
    }

    private async Task LoadAsync()
    {
        // Every filter is operator-writable and the browser's copy of a disabled attribute is one
        // round trip stale, so the whole form is turned into a request HERE, above the try and above
        // every await. Reading any control back afterwards would let the audit record name one
        // filter set while the service was asked for another.
        var filters = form.ToFilters();

        // Snapshotted on the same breath and for the same reason. It is not part of the request -
        // the observer name does not exist until the second lookup - but it IS part of the
        // question the operator asked, so it is frozen when they asked it rather than read live
        // out of a control they may have typed into since.
        var seenBy = form.SeenBy;
        var site = form.Site;
        var requestedAudit = CreateFilterAudit(filters, site, seenBy, null);

        isLoading = true;
        loadError = null;
        csvExportError = null;
        try
        {
            await Task.Yield();

            using var activity = Progress.Begin(
                "Defender for Endpoint Devices", "Listing devices", ActivitySize.Unknown);

            var loaded = await DeviceService.ListDevicesAsync(filters);
            var filterAudit = CreateFilterAudit(filters, site, seenBy, loaded);
            result = loaded;
            appliedSeenBy = seenBy;
            appliedSite = site;
            appliedFilterAudit = filterAudit;
            // Beside the result, never after a branch: an index left from a wider search can sit
            // past the end of a narrower one and render an empty table under a non-zero count.
            devicePageIndex = 0;
            expandedDevices.Clear();

            // A refusal is audited as a FAILED lookup carrying its reason. It is not a successful
            // read of zero devices, and recording it as one would be the blanket-success shape.
            var complete = loaded.Outcome == DefenderDeviceListOutcome.Complete;
            // A refusal is a failure, not a successful read of zero devices - same rule the audit
            // below follows.
            var displayedCount = complete ? FilteredDevices.Count : 0;
            activity.Complete(complete, complete
                ? $"{displayedCount:N0} device(s)"
                : loaded.Outcome.ToString());
            var auditDetails = FilterAuditDetails(filterAudit, displayedCount);
            auditDetails["Outcome"] = loaded.Outcome.ToString();
            auditDetails["DistinctDevices"] = loaded.DistinctCount;
            auditDetails["Requests"] = loaded.PagesFetched;
            auditDetails["Ranges"] = loaded.RangesCompleted;
            auditDetails["Ceiling"] = loaded.Ceiling;
            SafeAudit(() => Audit.LogLookupAction(currentUser, clientIpAddress,
                "DefenderEndpointDevices_List", filterAudit.RequestedFilters, complete,
                complete ? null : loaded.RefusalReason,
                extra: auditDetails));
        }
        catch (Exception ex)
        {
            // The previous run's table is retracted with the error, not left on screen beside it: a
            // stale list rendered next to a failure message reads as the answer to the new request.
            result = null;
            appliedFilterAudit = null;
            devicePageIndex = 0;
            loadError = ex.Message;
            Logger.LogError(ex, "Failed to list Defender for Endpoint devices.");

            SafeAudit(() => Audit.LogLookupAction(currentUser, clientIpAddress,
                "DefenderEndpointDevices_List", requestedAudit.RequestedFilters, false, ex.Message,
                extra: FilterAuditDetails(requestedAudit, 0)));
        }
        finally
        {
            isLoading = false;
            // Publish the settled result and re-enable controls on every handled search outcome.
            StateHasChanged();
        }
    }

    /// <summary>
    /// Returns every control to its starting value. It does not load: clearing a filter set and
    /// firing a full-tenant fetch off one click is not what the button says it does.
    /// </summary>
    private void ClearFilters() => form.Clear();

    private void ToggleDetail(string deviceId)
    {
        if (!expandedDevices.Remove(deviceId))
            expandedDevices.Add(deviceId);
    }

    /// <summary>
    /// The CSV projection - the twenty-nine columns of docs/DefenderEndpointDevices-Plan.md
    /// "CSV export", in that order. Static and argument-fed so tests call it without a page
    /// instance (DhcpAuthorization.razor's BuildCsv is the pattern), and over
    /// <see cref="CsvExport.Write"/> so quoting and spreadsheet-formula neutralisation stay the
    /// shared writer's job rather than being re-implemented here.
    /// </summary>
    /// <param name="rows">
    /// The devices to write. By construction the COMPLETE matching set: the only caller is
    /// <see cref="ExportableDevices"/>, and a run that could not prove it had seen every matching
    /// device refuses and carries none. There is no truncation marker because there is no truncated
    /// state to mark.
    /// </param>
    /// <param name="enrichment">
    /// The run's enrichment state, passed in rather than read off the devices because it cannot be
    /// read off them. An empty DiscoverySources means "this device has no value" on a succeeded run
    /// and "NO device has one, the hunting query never ran or failed" on any other, and only the RUN
    /// knows which. A blank cell reporting a failed run is Known Failure Class 2 in
    /// .agents/repo-guidance.md; taking the state as an argument is what lets a test prove the two
    /// readings apart without a page.
    /// </param>
    internal static string BuildCsv(
        IReadOnlyList<DefenderDevice> rows,
        DefenderDiscoveryEnrichmentState enrichment)
    {
        var header = new List<string>
        {
            "DeviceId", "ComputerDnsName", "DnsDomain", "OnboardingStatus",
            "OsPlatform", "OsVersion", "OsBuild", "OsArchitecture", "HealthStatus",
            "LastIpAddress", "LastExternalIpAddress", "IpAddresses", "MacAddresses",
            "FirstSeenUtc", "LastSeenUtc", "RiskScore", "ExposureLevel", "DeviceValue",
            "MachineTags", "MachineGroup", "IsAadJoined", "AadDeviceId", "Site",
            "DiscoverySources", "DeviceType", "DeviceCategory", "Vendor", "Model",
            "RecentlySeenBy",
        };

        var csvRows = rows.Select(device => (IReadOnlyList<string>)new List<string>
        {
            device.Id,
            device.ComputerDnsName,
            device.DnsDomain,
            device.OnboardingStatus,
            device.OsPlatform,
            device.OsVersion,
            device.OsBuild,
            device.OsArchitecture,
            device.HealthStatus,
            device.LastIpAddress,
            device.LastExternalIpAddress,
            IpList(device),
            MacList(device),
            FormatUtc(device.FirstSeen),
            FormatUtc(device.LastSeen),
            device.RiskScore,
            device.ExposureLevel,
            device.DeviceValue,
            string.Join("; ", device.MachineTags),
            device.MachineGroup,
            device.IsAadJoined ? "true" : "false",
            device.AadDeviceId,
            device.Site,
            ExportEnrichmentCell(enrichment, device.DiscoverySources),
            ExportEnrichmentCell(enrichment, device.DeviceType),
            ExportEnrichmentCell(enrichment, device.DeviceCategory),
            ExportEnrichmentCell(enrichment, device.Vendor),
            ExportEnrichmentCell(enrichment, device.Model),
            ExportEnrichmentCell(enrichment, device.RecentlySeenBy),
        });

        return CsvExport.Write(header, csvRows);
    }

    /// <summary>
    /// Serves the rows currently on screen as a timestamped CSV and audits the export.
    /// </summary>
    private async Task DownloadCsvAsync()
    {
        var filterAudit = appliedFilterAudit;
        int? selectedCount = null;
        try
        {
            // Keep selection inside the handled scope too: filtering can fail before CSV work.
            // The empty-set guard still precedes the busy raise. A refusal exports nothing.
            var rows = ExportableDevices;
            if (rows.Count == 0)
                return;
            selectedCount = rows.Count;

            // Both locals describe the loaded inventory even if a later load replaces result.
            var enrichment = result?.DiscoveryEnrichment ?? DefenderDiscoveryEnrichmentState.NotAttempted;
            isDownloadingCsv = true;
            try
            {
                csvExportError = null;

                // Begin before yielding so controls and progress reach the operator together. The
                // synchronous projection/encoding has no reportable steps, so only its size is named.
                using var activity = Progress.Begin(
                    "Defender for Endpoint Devices",
                    $"Exporting {rows.Count:N0} device(s) to CSV",
                    ActivitySize.Unknown);

                await Task.Yield();

                var csv = BuildCsv(rows, enrichment);
                var bytes = System.Text.Encoding.UTF8.GetBytes(csv);
                var base64 = Convert.ToBase64String(bytes);
                var timestamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
                await JS.InvokeVoidAsync("downloadFile",
                    $"DefenderEndpointDevices_{timestamp}.csv", "text/csv", base64);

                // The bytes are already on their way to the browser by the time this runs, so an audit
                // failure must not be allowed to fail the export: the operator HAS the file, and
                // throwing here would report a completed disclosure as a failed one. SafeAudit logs it
                // instead, which is the same bargain the listing path makes.
                SafeAudit(() => Audit.LogModuleAction(currentUser, clientIpAddress, "ExportCsv",
                    "DefenderEndpointDevices", $"{rows.Count} rows", true,
                    extra: FilterAuditDetails(filterAudit, selectedCount)));

                // Completed BELOW the transfer, the settled order on both worked examples: the base64
                // push over the SignalR circuit is the last thing the operator waits on. The audit
                // above is inside the window because SafeAudit swallows and logs. A throw anywhere in
                // the try never reaches this line and falls to the dispose fallback instead, which is
                // what that fallback is for. The transfer MECHANISM is untouched -
                // docs/DownloadMemoryRetention-Plan.md proposes replacing it and is a DRAFT. The read
                // is `rows`, the local the method already captured before its first await.
                activity.Complete(true, $"{rows.Count:N0} device(s) exported.");
            }
            finally
            {
                isDownloadingCsv = false;
            }
        }
        catch (Exception ex)
        {
            // A delivery exception cannot prove whether the browser received any bytes. Report
            // incomplete export without claiming zero delivery or hiding the loaded inventory.
            csvExportError = "CSV export could not be completed. Try Download CSV again.";
            Logger.LogError("Failed to export Defender for Endpoint devices ({ExceptionType}).",
                ex.GetType().Name);
            // A selected count is known after filtering; a failed delivery has no confirmed
            // exported count. Keep the two facts distinct even when selection itself failed.
            var auditDetails = FilterAuditDetails(filterAudit, null);
            auditDetails["SelectedDevices"] = selectedCount.HasValue ? selectedCount.Value : "Unknown";
            SafeAudit(() => Audit.LogModuleAction(currentUser, clientIpAddress, "ExportCsv",
                "DefenderEndpointDevices", "Device inventory", false, errorDetail: csvExportError,
                extra: auditDetails));
        }
    }

    private void SafeAudit(Action write)
    {
        try
        {
            write();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to write Defender for Endpoint Devices audit record.");
        }
    }

    /// <summary>
    /// The requested filters, including the two evaluated only after enrichment. Evaluation
    /// status is recorded separately so an unavailable value cannot masquerade as a match.
    /// </summary>
    /// <remarks>
    /// Only filters that are set are listed, and each is prefixed with the API property it maps to,
    /// so an audit row can be compared against a request. Onboarding status is always listed
    /// because "(any)" is a meaningful answer for it - it is the one filter with a non-empty
    /// default.
    /// </remarks>
    private static string DescribeFilters(DefenderDeviceFilters filters, string site, string seenBy)
    {
        var parts = new List<string>
        {
            "onboardingStatus="
            + (string.IsNullOrWhiteSpace(filters.OnboardingStatus) ? "(any)" : filters.OnboardingStatus)
        };

        Add(parts, "computerDnsName^", filters.DeviceNameStartsWith);
        Add(parts, "osPlatform", filters.OsPlatform);
        Add(parts, "osPlatform^", filters.OsPlatformPrefix);
        Add(parts, "healthStatus", filters.HealthStatus);
        Add(parts, "riskScore", filters.RiskScore);
        Add(parts, "exposureLevel", filters.ExposureLevel);
        Add(parts, "machineGroup~", filters.MachineGroup);
        Add(parts, "machineTag~", filters.MachineTag);
        Add(parts, "lastSeen>=", FormatUtc(filters.LastSeenFrom));
        Add(parts, "lastSeen<", FormatUtc(filters.LastSeenTo));
        Add(parts, "firstSeen>=", FormatUtc(filters.FirstSeenFrom));
        Add(parts, "firstSeen<", FormatUtc(filters.FirstSeenTo));
        Add(parts, "site~", site);
        Add(parts, "recentlySeenBy~", seenBy);

        return string.Join(", ", parts);
    }

    private sealed record LocationFilterAudit(string Status, int EvaluatedDevices, int UnavailableDevices);

    private sealed record FilterAuditSnapshot(
        string RequestedFilters,
        string RequestFiltersEvaluation,
        LocationFilterAudit SiteFilterEvaluation,
        LocationFilterAudit SeenByFilterEvaluation,
        int? InventoryDevices);

    private static FilterAuditSnapshot CreateFilterAudit(
        DefenderDeviceFilters filters, string site, string seenBy, DefenderDeviceListResult? loaded)
    {
        var complete = loaded?.Outcome == DefenderDeviceListOutcome.Complete;
        return new(DescribeFilters(filters, site, seenBy), complete ? "Evaluated" : "Not completed",
            DescribeLocationFilter(site, loaded, d => d.Site, true),
            DescribeLocationFilter(seenBy, loaded, d => d.RecentlySeenBy,
                loaded?.DiscoveryEnrichment is DefenderDiscoveryEnrichmentState.Succeeded
                    or DefenderDiscoveryEnrichmentState.PartiallySucceeded),
            loaded?.Devices.Count);
    }

    private static LocationFilterAudit DescribeLocationFilter(
        string requested, DefenderDeviceListResult? loaded, Func<DefenderDevice, string> value, bool evaluated)
    {
        if (string.IsNullOrWhiteSpace(requested))
            return new("Not requested", 0, 0);
        if (loaded?.Outcome != DefenderDeviceListOutcome.Complete)
            return new("Not evaluated", 0, 0);

        // Each filter's availability is counted independently over the loaded candidates. A row
        // whose value is unavailable is retained only if the OTHER filter also permits it.
        var unavailable = evaluated
            ? loaded.Devices.Count(d => string.Equals(value(d),
                DefenderEndpointDeviceService.EnrichmentUnavailable, StringComparison.Ordinal))
            : loaded.Devices.Count;
        var known = loaded.Devices.Count - unavailable;
        return new(unavailable == 0 ? "Evaluated" : known == 0 ? "Unavailable" : "Degraded", known, unavailable);
    }

    private static Dictionary<string, object?> FilterAuditDetails(FilterAuditSnapshot? snapshot, int? count) => new()
    {
        ["RequestedFilters"] = snapshot?.RequestedFilters,
        ["RequestFiltersEvaluation"] = snapshot?.RequestFiltersEvaluation ?? "Unknown",
        ["SiteFilterEvaluation"] = snapshot?.SiteFilterEvaluation,
        ["SeenByFilterEvaluation"] = snapshot?.SeenByFilterEvaluation,
        ["InventoryDevices"] = snapshot?.InventoryDevices,
        ["Devices"] = count.HasValue ? count.Value : "Unknown"
    };

    private static void Add(List<string> parts, string name, string value)
    {
        if (!string.IsNullOrWhiteSpace(value))
            parts.Add($"{name}={value}");
    }

    /// <summary>A dash rather than an empty cell, so a blank never reads as a value.</summary>
    private static string Display(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;

    /// <summary>
    /// One discovery-source cell. Routed through the service rather than answered here, so the page
    /// cannot invent its own reading of a blank.
    /// </summary>
    /// <remarks>
    /// A blank on a SUCCEEDED run means this device genuinely has no value - Learn says Vendor and
    /// Model are populated only when device discovery found enough - and a blank on any other state
    /// means no device has one and the hunting query never ran or failed. Those two cannot be told
    /// apart at the cell, so the run state decides. result is null only before the first load, when
    /// no table is rendered at all; NotAttempted is the honest reading of that state either way.
    /// </remarks>
    private string EnrichmentCell(string? value) =>
        DefenderEndpointDeviceService.DescribeEnrichmentCell(
            result?.DiscoveryEnrichment ?? DefenderDiscoveryEnrichmentState.NotAttempted, value);

    /// <summary>
    /// One discovery-source cell as the CSV writes it: the same rule the page's
    /// <see cref="EnrichmentCell"/> applies - anything but a succeeded run reads "(unavailable)" -
    /// and the same constant, so the file and the screen can never say different things about the
    /// same run.
    /// </summary>
    /// <remarks>
    /// It differs from the screen's renderer in exactly one respect, deliberately: a genuinely
    /// empty value on a SUCCEEDED run is written as an empty cell rather than the screen's "-".
    /// CsvExport neutralises a leading '-' into "'-", so the screen's placeholder would reach a
    /// spreadsheet as a literal apostrophe-dash, and it would be the only column in the file
    /// carrying a placeholder at all - every other blank here is written blank. Nothing is lost by
    /// that, because once "(unavailable)" owns the failed-run meaning an empty cell can only mean
    /// the run worked and this device had no value. What must NOT happen is the other way round: a
    /// blank standing in for a run that never executed.
    /// </remarks>
    private static string ExportEnrichmentCell(DefenderDiscoveryEnrichmentState state, string value) =>
        state is DefenderDiscoveryEnrichmentState.Succeeded
            or DefenderDiscoveryEnrichmentState.PartiallySucceeded
            ? value
            : DefenderEndpointDeviceService.EnrichmentUnavailable;

    private static string FormatTime(DateTimeOffset? value) =>
        value?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-";

    /// <summary>
    /// The CSV's two timestamp columns, and the audit record's four. They are NAMED Utc, so they are
    /// written in UTC whatever the server's zone - unlike the table, which shows local time to the
    /// operator reading it. "u" is the sortable universal format and always formats with the
    /// invariant culture, so an exported file does not change shape with the host's locale.
    /// Absent is written blank rather than with the table's dash: every other blank in this file is
    /// blank, and a placeholder in a timestamp column parses as data.
    /// </summary>
    private static string FormatUtc(DateTimeOffset? value) =>
        value?.ToUniversalTime().ToString("u") ?? "";

    private static string IpList(DefenderDevice device) =>
        string.Join("; ", device.IpAddresses
            .Select(entry => entry.IpAddress)
            .Where(address => !string.IsNullOrWhiteSpace(address))
            .Distinct(StringComparer.OrdinalIgnoreCase));

    private static string MacList(DefenderDevice device) =>
        string.Join("; ", device.IpAddresses
            .Select(entry => entry.MacAddress)
            .Where(address => !string.IsNullOrWhiteSpace(address))
            .Distinct(StringComparer.OrdinalIgnoreCase));
}

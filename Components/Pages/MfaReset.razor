@page "/mfa-reset"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "MfaReset")]
@rendermode InteractiveServer
@inject MfaResetService MfaService
@inject IActivityProgress Progress
@inject AuditService Audit
@inject EmailService Email
@inject ServiceNowService ServiceNow
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager Navigation
@inject ClientInfoService ClientInfo
@inject ILogger<MfaReset> Logger
@inject ProtectedPrincipalService ProtectedPrincipalService
@inject ProtectedPrincipalServicerService Servicers

<PageTitle>MFA Reset</PageTitle>

@if (!authChecked)
{
    @* NO SPINNER HERE. The authorization check reports to the status bar like every other
       operation (owner ruling 2026-10-02, `.agents/decisions.md`) - no module draws its own
       progress, and this block was the duplication the sweep exists to remove.

       The GUARD stays and must stay: it is what stops the page rendering before the check has
       passed. That is refusal, not progress, and the bar has nothing to say about it. *@
    return;
}

<div class="container-fluid">
    <div class="alert alert-info py-2 mb-3">
        <small>All MFA reset operations are logged for audit purposes. Users will need to re-register their MFA methods at next sign-in.</small>
    </div>
    <h1 class="mb-4">MFA Reset<ModuleVersion /></h1>

    @if (!MfaService.IsAvailable)
    {
        <div class="alert alert-danger">Microsoft Graph API is not configured. Contact your administrator.</div>
        return;
    }

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">User Principal Name</label>
                        <div class="input-group">
                            <input type="email" class="form-control" @bind="userPrincipalName" placeholder="user@analog.com"
                                   disabled="@isLoading" @onkeydown="HandleKeyDown" />
                            <button class="btn btn-primary" @onclick="ListMethods" disabled="@(isLoading || string.IsNullOrWhiteSpace(userPrincipalName))">
                                List Methods
                            </button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ticket Number</label>
                        <input type="text" class="form-control" @bind="ticketNumber" @bind:event="oninput" placeholder="INC/REQ number" disabled="@isLoading" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (resetConfirmPending)
    {
        <div class="row mt-3">
            <div class="col-md-6">
                <div class="alert alert-warning">
                    <strong>Confirm MFA Reset for @userPrincipalName</strong>
                    <p class="mb-2">This will remove @methods.Count authentication method(s). The user will be required to re-register MFA at their next sign-in.</p>
                    <button class="btn btn-danger btn-sm me-2" @onclick="ExecuteReset" disabled="@isLoading">
                        Reset MFA
                    </button>
                    <button class="btn btn-secondary btn-sm" @onclick="CancelReset">Cancel</button>
                </div>
            </div>
        </div>
    }

    @if (result != null)
    {
        <div class="row mt-3">
            <div class="col-md-6">
                <div class="alert @(result.Success ? "alert-success" : "alert-danger") alert-dismissible">
                    @result.Message
                    <button type="button" class="btn-close" @onclick="() => result = null"></button>
                </div>
            </div>
        </div>
    }

    @if (methods.Count > 0)
    {
        <div class="row mt-3">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Authentication Methods for @userPrincipalName</strong>
                        <button class="btn btn-danger btn-sm" @onclick="ConfirmReset"
                                disabled="@(isLoading || string.IsNullOrWhiteSpace(ticketNumber))">
                            Reset All Methods
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Detail</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var method in methods)
                                {
                                    <tr>
                                        <td>@method.MethodType</td>
                                        <td><small class="text-muted">@method.Detail</small></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string currentUser = "";
    private string clientIpAddress = "Unknown";
    private bool authChecked;
    private bool isLoading;
    private string userPrincipalName = "";
    private string ticketNumber = "";
    private bool resetConfirmPending;
    private List<AuthMethod> methods = new();
    private MfaResetResult? result;

    protected override async Task OnInitializedAsync()
    {
        // NOT reported to the status bar, and that is deliberate. GroupAuthorizationHandler is
        // synchronous end to end - claims plus IsInRole against the local Windows token,
        // Task.CompletedTask on every path, no network and no directory round trip - so this
        // completes faster than a frame. A bar line that appears and vanishes inside one
        // render is noise, and noise in the one surface the operator is being taught to trust
        // is worse than nothing there at all.
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUser = user.Identity?.Name ?? "Unknown";

        var authResult = await AuthorizationService.AuthorizeAsync(user, "MfaReset");
        if (!authResult.Succeeded)
        {
            Navigation.NavigateTo("access-denied", forceLoad: true);
            return;
        }

        clientIpAddress = ClientInfo.IpAddress != "Unknown"
            ? ClientInfo.IpAddress
            : ClientInfo.GetIpForUser(currentUser);
        authChecked = true;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        // Await (never discard) so Blazor re-renders when the work completes;
        // a discarded task left results invisible until the next UI event.
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(userPrincipalName))
            await ListMethods();
    }

    private async Task ListMethods()
    {
        isLoading = true;
        result = null;
        methods = new();
        resetConfirmPending = false;
        await Task.Yield();

        try
        {
            var upn = userPrincipalName.Trim();
            methods = await MfaService.GetUserMethodsAsync(upn);
            if (methods.Count == 0)
                result = new MfaResetResult { Success = true, Message = "No MFA methods registered for this user." };

            Audit.LogMfaResetAction(currentUser, clientIpAddress, "MfaReset_ListMethods", upn, true,
                totalMethods: methods.Count,
                methodTypes: methods.Select(m => m.MethodType).ToArray());
        }
        catch (Exception ex)
        {
            result = new MfaResetResult { Success = false, Message = $"Error: {ex.Message}" };
            Audit.LogMfaResetAction(currentUser, clientIpAddress, "MfaReset_ListMethods", userPrincipalName.Trim(), false,
                errorDetail: ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ConfirmReset()
    {
        resetConfirmPending = true;
    }

    private void CancelReset()
    {
        resetConfirmPending = false;
    }

    /// <summary>Module id for the servicer grant. Must match the catalog descriptor.</summary>
    private const string ServicerModuleId = "MfaReset";

    private string? ServicerNoteFor(System.Security.Claims.ClaimsPrincipal? user, IEnumerable<string> matchedRules, string? qualifier = null) =>
        ProtectedPrincipalServicing.NoteFor(Servicers, user, ServicerModuleId, matchedRules, qualifier);

    private static Dictionary<string, object?>? ServicedExtra(string? note) =>
        ProtectedPrincipalServicing.Extra(note);

    private async Task ExecuteReset()
    {
        isLoading = true;
        resetConfirmPending = false;
        await Task.Yield();

        var upn = userPrincipalName.Trim();
        var ticket = ticketNumber.Trim();
        var methodTypesBeforeReset = methods.Select(m => m.MethodType).ToArray();
        // Set when an authorised servicer overrode a protected-principal refusal, and carried into
        // the SUCCESS audit below. Null on an ordinary reset.
        string? servicedAuditDetail = null;
        // Notify admins on any real attempt against the target (reset, protected block,
        // fail-closed protection outcome, or exception) — but not on the trivial
        // ticket-invalid / auth-denied pre-gates. Set once those gates pass.
        var notifyAdmins = false;

        // One Graph delete per registered method, and the method count is known from the list the
        // operator is looking at. Opened HERE, above the try, rather than at the Graph call it used
        // to sit on: the slowest thing the operator waits on is the protected-principal resolve
        // below, not the reset. That resolve is a Delinea credential fetch, then an AD search
        // behind a throttle that waits up to 30 seconds, then - on a cloud-only target, which is
        // this module's ORDINARY input - the Exchange fallback this codebase documents as 10 to 15
        // seconds. All of it used to run with the bar idle (docs/ProgressCoverage-Plan.md S3, the
        // fifth of the nine partials). Every refusal inside the try is now inside the window too.
        using var activity = Progress.Begin(
            "MFA Reset", $"Resetting MFA methods for {upn}",
            methods is null ? ActivitySize.Unknown : ActivitySize.Items(methods.Count));

        try
        {
            var ticketValidation = await ServiceNow.ValidateTicketAsync(ticket);
            if (!ticketValidation.IsValid)
            {
                result = new MfaResetResult { Success = false, Message = $"Ticket validation failed: {ticketValidation.Message}" };
                Audit.LogMfaResetAction(currentUser, clientIpAddress, "MfaReset_Execute", upn, false, ticket,
                    errorDetail: $"Ticket validation failed: {ticketValidation.Message}");
                return;
            }

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var authCheck = await AuthorizationService.AuthorizeAsync(authState.User, "MfaReset");
            if (!authCheck.Succeeded)
            {
                result = new MfaResetResult { Success = false, Message = "Authorization denied." };
                Audit.LogMfaResetAction(currentUser, clientIpAddress, "MfaReset_Execute", upn, false, ticket,
                    errorDetail: "Authorization denied");
                return;
            }

            notifyAdmins = true;

            // Protected principal check — fail closed unless AD lookup confirms no AD object (cloud-only)
            try
            {
                // Exchange fallback, NOT the AD-only resolve. This module operates on cloud
                // identities, so a cloud-only target is its NORMAL input - and an AD-only lookup
                // reports every cloud-only object as NotFound. The old code read that miss as
                // "no AD object, therefore nothing to protect" and skipped the check entirely,
                // which left protection close to inert here: a protected user row naming a
                // cloud-only mailbox was never compared against the target.
                // docs/ProtectedPrincipalGapFix-Plan.md GAP B.
                var (resolved, resolutionStatus) = await ProtectedPrincipalService.ResolveWithExchangeFallbackAsync(upn);
                if (resolutionStatus is ProtectedPrincipalService.ResolutionStatus.Unavailable or ProtectedPrincipalService.ResolutionStatus.Ambiguous)
                {
                    var reason = resolutionStatus == ProtectedPrincipalService.ResolutionStatus.Ambiguous
                        ? "Identity is ambiguous — matches multiple AD users."
                        : "Protection check unavailable.";
                    result = new MfaResetResult { Success = false, Message = reason };
                    Audit.LogMfaResetAction(currentUser, clientIpAddress, "MfaReset_Execute", upn, false, ticket,
                        errorDetail: $"{reason} — blocked",
                        methodTypes: methodTypesBeforeReset);
                    return;
                }
                if (resolved != null)
                {
                    var protectionCheck = await ProtectedPrincipalService.CheckAsync(resolved);
                    if (protectionCheck.CheckFailed)
                    {
                        result = new MfaResetResult { Success = false, Message = $"Protection check failed: {protectionCheck.Reason}" };
                        Audit.LogMfaResetAction(currentUser, clientIpAddress, "MfaReset_Execute", upn, false, ticket,
                            errorDetail: $"Protection check failed: {protectionCheck.Reason}",
                            methodTypes: methodTypesBeforeReset);
                        return;
                    }
                    if (protectionCheck.IsProtected)
                    {
                        // An authorised servicer may proceed; everyone else is refused. Protection
                        // is evaluated first and never weakened - this only decides whether THIS
                        // operator may act on a target already known to be protected.
                        servicedAuditDetail = ServicerNoteFor(authState.User, protectionCheck.MatchedRules);
                        if (servicedAuditDetail is null)
                        {
                            result = new MfaResetResult { Success = false, Message = "This user is a protected principal. MFA reset is not permitted." };
                            Audit.LogMfaResetAction(currentUser, clientIpAddress, "MfaReset_Execute", upn, false, ticket,
                                errorDetail: $"Protected principal - matched rules: {string.Join(", ", protectionCheck.MatchedRules)}",
                                methodTypes: methodTypesBeforeReset);
                            return;
                        }
                    }
                }
                else
                {
                    // Neither AD nor Exchange knows this address - but THIS MODULE MUTATES A GRAPH
                    // USER, and AD+EXO absence does not prove Entra absence. An Entra-only account
                    // with no mailbox (unlicensed, or a cloud identity that never had one) resolves
                    // NotFound here while /users/{upn}/authentication/methods still finds a real
                    // user whose MFA this page is about to reset. Proceeding on NotFound would
                    // leave exactly that population unprotected - the gap the AD-only resolve had,
                    // narrowed but not closed.
                    //
                    // So check the protected rows against the raw identity instead of skipping.
                    // Group, OU and SamAccountName-pattern rules cannot apply to an object with no
                    // on-prem DN and no SAM - they are inapplicable, not skipped - but the USER
                    // rows can and do match an address, and those are what protect a cloud
                    // identity. Same shape PermissionValidator uses when full resolution is not
                    // required.
                    var unresolved = new ResolvedDirectoryPrincipal(
                        Source: "MfaReset-Unresolved",
                        DisplayName: upn,
                        UserPrincipalName: upn,
                        SamAccountName: null,
                        PrimarySmtpAddress: upn.Contains('@') ? upn : null,
                        DistinguishedName: null,
                        ObjectGuid: null,
                        EntraObjectId: null);

                    var unresolvedCheck = await ProtectedPrincipalService.CheckAsync(unresolved);
                    if (unresolvedCheck.CheckFailed)
                    {
                        result = new MfaResetResult { Success = false, Message = $"Protection check failed: {unresolvedCheck.Reason}" };
                        Audit.LogMfaResetAction(currentUser, clientIpAddress, "MfaReset_Execute", upn, false, ticket,
                            errorDetail: $"Protection check failed: {unresolvedCheck.Reason}",
                            methodTypes: methodTypesBeforeReset);
                        return;
                    }
                    if (unresolvedCheck.IsProtected)
                    {
                        // Same servicer rule as the resolved branch. Both sites must honour it, or
                        // a cloud-only protected identity would be the one case a servicer cannot
                        // service - which is precisely the population this module exists for.
                        servicedAuditDetail = ServicerNoteFor(authState.User, unresolvedCheck.MatchedRules, "directory-unresolved");
                        if (servicedAuditDetail is null)
                        {
                            result = new MfaResetResult { Success = false, Message = "This user is a protected principal. MFA reset is not permitted." };
                            Audit.LogMfaResetAction(currentUser, clientIpAddress, "MfaReset_Execute", upn, false, ticket,
                                errorDetail: $"Protected principal (directory-unresolved) - matched rules: {string.Join(", ", unresolvedCheck.MatchedRules)}",
                                methodTypes: methodTypesBeforeReset);
                            return;
                        }
                    }

                    Logger.LogInformation(
                        "No such recipient in Active Directory or Exchange Online for {Upn}; protected user rows did not match the raw identity - proceeding", upn);
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Protected principal check failed for {Upn} — blocking as precaution", upn);
                result = new MfaResetResult { Success = false, Message = $"Protection check error: {ex.Message}" };
                Audit.LogMfaResetAction(currentUser, clientIpAddress, "MfaReset_Execute", upn, false, ticket,
                    errorDetail: $"Protection check exception: {ex.Message}",
                    methodTypes: methodTypesBeforeReset);
                return;
            }

            result = await MfaService.ResetAllMethodsAsync(upn);

            // The serviced note rides `extra`, never errorDetail: this call is the SUCCESS path,
            // and LogMfaResetAction writes ["error"] = success ? null : errorDetail - so the one
            // field explaining why a protected user's MFA could be reset would be dropped exactly
            // when it matters.
            Audit.LogMfaResetAction(currentUser, clientIpAddress, "MfaReset_Execute", upn, result.Success, ticket,
                errorDetail: result.Success ? null : result.Message,
                removedCount: result.RemovedCount,
                totalMethods: result.TotalMethods,
                methodTypes: methodTypesBeforeReset,
                extra: ServicedExtra(servicedAuditDetail));

            Logger.LogInformation("User {Admin} reset MFA for {Target} (ticket {Ticket}): {Result}", currentUser, upn, ticket, result.Message);
        }
        catch (Exception ex)
        {
            result = new MfaResetResult { Success = false, Message = ex.Message };
            Audit.LogMfaResetAction(currentUser, clientIpAddress, "MfaReset_Execute", upn, false, ticket,
                errorDetail: ex.Message,
                methodTypes: methodTypesBeforeReset);
        }
        finally
        {
            isLoading = false;
            methods = new();

            // Captured synchronously on entry to the finally, BEFORE the notification await, and
            // everything below reads the capture rather than the field. Two things can null
            // `result` while this handler is suspended at that await, and both are live the moment
            // isLoading drops two lines above: the alert's own dismiss button is
            // @onclick="() => result = null", and ListMethods - whose button ungates with
            // isLoading - sets result = null on entry. A re-read past the await would report a
            // failed reset with no message on a reset that succeeded.
            var completed = result;
            var completedOk = completed?.Success ?? false;

            // Mandatory admin notification on every real MFA reset attempt (Constitution
            // §Notifications). Fail-safe: a send failure must not change the operation result.
            if (notifyAdmins)
            {
                try
                {
                    await Email.SendAdminNotificationAsync(currentUser, clientIpAddress, "MfaReset_Execute",
                        completedOk, ticket,
                        new Dictionary<string, string> { ["Target User"] = upn },
                        completedOk ? null : completed?.Message);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Failed to send MFA reset admin notification for {Upn}", upn);
                }
            }

            // Completed LAST, below the administrator notification, so the frame does not read
            // Idle while an email is still in flight. This is the closing end of the same fix:
            // the Complete used to sit immediately after the Graph reset, which left the send -
            // the last remote call this handler makes - outside the window.
            activity.Complete(completedOk, completedOk ? null : completed?.Message);
        }
    }
}

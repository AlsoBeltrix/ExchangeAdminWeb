@using ExchangeAdminWeb.Services
@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="@((Configuration["Application:PathBase"] ?? "/ExchangeAdminWeb").TrimEnd('/'))/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="ExchangeAdminWeb.styles.css" />
    @*
        The .ico is listed FIRST and carries 16/32/48/64/256. Browsers pick a frame from it by
        size, and the small frames are a deliberately simplified glyph -- the full card turns to
        mud below ~48px. The PNG follows for anything that prefers one; apple-touch-icon is the
        180px home-screen size.

        Paths are relative so they resolve against <base>, which carries the PathBase this
        instance is deployed under (dev and prod differ).
    *@
    <link rel="icon" href="favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="favicon.png" sizes="256x256" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    @*
        Theme applied before <body> so there is no flash of the wrong palette.
        This must be inline and synchronous -- an external script or a Blazor
        component both run too late.

        The theme table is RENDERED FROM UiThemeCatalog rather than hand-copied,
        because this script cannot call into C# and a drifted copy would send
        real users to the default theme silently.
    *@
    <script>
        (function () {
            var THEMES = @((MarkupString)UiThemeJs.CatalogLiteral());
            var DEFAULT_ID = '@UiThemeCatalog.DefaultId';
            var LEGACY_DARK = '@UiThemeCatalog.LegacyDarkId';

            window.uiThemeResolve = function (stored) {
                var id = (stored || '').trim().toLowerCase();
                // Pre-picker builds stored "dark"; that is the OLED palette
                // under its old name, so the upgrade is invisible.
                if (id === LEGACY_DARK) { id = 'oled'; }
                // Membership, NOT truthiness: the value IS the isDark flag, so
                // a light theme's `false` would read as "unknown" and silently
                // fall back to the default.
                return Object.prototype.hasOwnProperty.call(THEMES, id) ? id : DEFAULT_ID;
            };

            function applyTheme() {
                var id = window.uiThemeResolve(localStorage.getItem('theme'));
                var root = document.documentElement;
                var wantsDark = THEMES[id] === true;

                // Both writes are guarded. The MutationObserver below watches
                // these same attributes, so an unconditional write would
                // re-trigger it on every mutation.
                if (root.getAttribute('data-theme') !== id) {
                    root.setAttribute('data-theme', id);
                }

                // The class does no styling. It drives color-scheme, which is
                // what colours the scrollbars, native selects and date pickers
                // the stylesheet cannot reach.
                if (root.classList.contains('dark') !== wantsDark) {
                    root.classList.toggle('dark', wantsDark);
                }
            }

            applyTheme();
            window.uiThemeApply = applyTheme;
            document.addEventListener('blazor:enhancedload', applyTheme);
            document.addEventListener('pageshow', applyTheme);

            // Blazor re-renders <html> attributes on reconnect; without this the
            // theme silently reverts mid-session.
            new MutationObserver(applyTheme).observe(document.documentElement, {
                attributes: true,
                attributeFilter: ['class', 'data-theme']
            });
        })();
    </script>
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script>
        function setTheme(id) {
            localStorage.setItem('theme', id);
            window.uiThemeApply();
            return document.documentElement.getAttribute('data-theme');
        }
        function getTheme() {
            // Resolve rather than read the attribute: this is also what the
            // picker uses on first render, before applyTheme has necessarily
            // run in a reconnected circuit.
            return window.uiThemeResolve(localStorage.getItem('theme'));
        }
    </script>
    <script>
        function downloadFile(filename, contentType, base64) {
            const byteCharacters = atob(base64);
            const byteNumbers = new Array(byteCharacters.length);
            for (let i = 0; i < byteCharacters.length; i++) {
                byteNumbers[i] = byteCharacters.charCodeAt(i);
            }
            const byteArray = new Uint8Array(byteNumbers);
            const blob = new Blob([byteArray], { type: contentType });
            const url = window.URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = filename;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            window.URL.revokeObjectURL(url);
        }
    </script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

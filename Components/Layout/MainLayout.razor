@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-end align-items-center">
            <AuthorizeView>
                <Authorized>
                    <UsageTracker />
                    <ThemePicker />
                    <small class="text-muted">
                        <span class="me-1">&#128100;</span>@context.User.Identity?.Name
                    </small>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>

        @*
            The status frame. LAST CHILD OF main, and a non-flexing row, so the height chain
            above it is unchanged: article keeps `flex: 1` and simply gets shorter. It is
            deliberately not fixed or absolute - overlaying the bottom of every page is the
            exact defect queue item 22 fixed (docs/AppLayoutAndScrolling-Plan.md).
        *@
        <AuthorizeView>
            <Authorized>
                <GlobalProgress />
            </Authorized>
        </AuthorizeView>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">&#x2715;</a>
</div>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- cdt-41. NuGet's audit as the app's project has it: every package in the graph, transitive ones
       included, from moderate severity up, each advisory an error. -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- The source-scanning guards parse C# with Roslyn instead of lexing it by hand (see
         RazorSyntax.cs). It already resolves transitively through the app's Microsoft.PowerShell.SDK
         reference, so this adds no package to the graph and nothing shipped gains a dependency;
         it is named here so a guard's correctness does not rest on another package's dependency
         list staying the way it is today. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- cdt-41. Pinned to the first version clear of its eight advisories (GHSA-cvvh-rhrc-wg4q and seven
         more): Microsoft.PowerShell.SDK, Microsoft.Windows.Compatibility and System.ServiceModel.Primitives
         resolve 10.0.6 here. Only this project's graph holds it - the app's prunes it, the ASP.NET Core
         shared framework carrying it - so the pin is here. It can go once those ask for 10.0.13 or later. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExchangeAdminWeb.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>